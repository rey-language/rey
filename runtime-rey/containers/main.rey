                var digit = byte - 48;
                if digit < thresholdDigit { comparison = -1; }
                else if digit > thresholdDigit { comparison = 1; }
            }
        }
        index = index + 1;
    }
    if comparison == 0 && remainder != 0 { return -1; }
    return comparison;
}

