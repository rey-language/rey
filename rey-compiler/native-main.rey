// Historical-seed bring-up driver for direct scalar machine-code generation.
// The generated executable contains no seed runtime. The driver itself still
// uses that runtime until the full native self-hosting gate is implemented.
import frontend;
import ir::lower::{lowerProgram};
import ir::verify::{verifyProgram};
import ir::analysis::{inferEffects};
import native::arm64::{emitArm64};
import native::image::{buildMachOArm64, buildElfArm64};
import native::bytes::{byteString};

func main(): void {
    var argv = args();
    if argv.len() == 2 && (argv[1] == "--help" || argv[1] == "-h") {
        println("Usage: rey-native build <source.rey> -o <output> --target <darwin-arm64|linux-arm64>");
        return;
    }
    if argv.len() != 7 || argv[1] != "build" || argv[3] != "-o" || argv[5] != "--target" {
        eprintln("Usage: rey-native build <source.rey> -o <output> --target <darwin-arm64|linux-arm64>");
        exit(2);
        return;
    }
    var target = argv[6];
    var os = "";
    if target == "darwin-arm64" { os = "darwin"; }
    else if target == "linux-arm64" { os = "linux"; }
    else { eprintln("unsupported native target: " + target); exit(2); return; }
    var path = argv[2];
    var output = argv[4];
    if output == path { eprintln("output must differ from the source path"); exit(2); return; }
    if !fileExists(path) { eprintln(path + ": error: source file not found"); exit(1); return; }
    var checked = frontend.checkSingleSource(readFile(path), path);
    if checked.isErr() { eprintln(checked.unwrapErr()); exit(1); return; }
    var lowered = lowerProgram(checked.unwrap());
    if lowered.isErr() { eprintln(lowered.unwrapErr()); exit(1); return; }
    var program = lowered.unwrap();
    var verified = verifyProgram(program);
    if !verified.ok { eprintln(verified.errors.join("\n")); exit(1); return; }
    program = inferEffects(program);
    var code = emitArm64(program, os);
    if code.isErr() { eprintln(code.unwrapErr()); exit(1); return; }
    var image: Result<Vec<int>, string> = Result.Err("unsupported target");
    if os == "darwin" { image = buildMachOArm64(code.unwrap()); }
    else { image = buildElfArm64(code.unwrap()); }
    if image.isErr() { eprintln(image.unwrapErr()); exit(1); return; }
    var encoded = byteString(image.unwrap());
    if encoded.isErr() { eprintln(encoded.unwrapErr()); exit(1); return; }
    var bytes = encoded.unwrap();
    writeFile(output, bytes);
    if !fileExists(output) { eprintln(output + ": error: failed to create native image"); exit(1); return; }
    if readFile(output) != bytes { eprintln(output + ": error: native image write verification failed"); exit(1); return; }
    println(output);
}
