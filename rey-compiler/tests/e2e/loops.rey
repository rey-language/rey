func main(): Void {
    var i: int = 0;
    while (i < 3) {
        println(i);
        i = i + 1;
    }

    var j: int = 0;
    loop {
        j = j + 1;
        if (j == 2) {
            continue;
        }
        println(j);
        if (j == 3) {
            break;
        }
    }

    for (x in [10, 20, 30]) {
        println(x);
    }
}
