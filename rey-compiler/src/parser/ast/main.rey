// AST Definitions for Rey Parser
import lexer::{Span};

// Literals
pub enum LiteralKind {
    String,
    Char,
    Int,
    Float,
    Bool,
    Null,
}

pub struct Literal {
    pub kind: LiteralKind,
    pub text: string,
}

// Expression Kinds
pub enum ExprKind {
    Error,
    Literal,
    Identifier,
    Binary,
    Unary,
    Update,
    Call,
    EnumVariant,
    Index,
    FieldAccess,
    Lambda,
    Match,
    If,
    Tuple,
    Array,
    Dict,
    StructLiteral,
}

pub enum TypeExprKind {
    Error,
    Named,
    Nullable,
    Union,
    Tuple,
    Function,
    Applied,
}

pub struct TypeExpr {
    pub kind: TypeExprKind,
    pub name: string,
    pub inner: TypeExpr?,
    pub members: Vec<TypeExpr>,
    pub params: Vec<TypeExpr>,
    pub result: TypeExpr?,
    pub span: Span,
}

// Expressions
pub enum Expr {
    Error(ErrorExpr),
    Literal(LiteralExpr),
    Identifier(IdentExpr),
    Binary(BinaryExpr),
    Unary(UnaryExpr),
    Update(UpdateExpr),
    Call(CallExpr),
    EnumVariant(EnumVariantExpr),
    Index(IndexExpr),
    FieldAccess(FieldAccessExpr),
    Lambda(LambdaExpr),
    Match(MatchExpr),
    If(IfExpr),
    Tuple(TupleExpr),
    Array(ArrayExpr),
    Dict(DictExpr),
    StructLiteral(StructLiteralExpr),
}

pub struct ErrorExpr {
    pub message: string,
    pub span: Span,
}

// Literal expression
pub struct LiteralExpr {
    pub kind: LiteralKind,
    pub text: string,
    pub span: Span,
}

// Identifier expression
pub struct IdentExpr {
    pub name: string,
    pub span: Span,
}

// Binary expression
pub struct BinaryExpr {
    pub left: Expr,
    pub op: string,
    pub right: Expr,
    pub span: Span,
}

// Unary expression
pub struct UnaryExpr {
    pub op: string,
    pub right: Expr,
    pub span: Span,
}

pub struct UpdateExpr {
    pub target: Expr,
    pub op: string,
    pub prefix: bool,
    pub span: Span,
}

// Call expression
pub struct CallExpr {
    pub callee: Expr,
    pub args: Vec<Expr>,
    pub span: Span,
}

pub struct EnumVariantExpr {
    pub enumName: string,
    pub variant: string,
    pub args: Vec<Expr>,
    pub span: Span,
}

// Index expression
pub struct IndexExpr {
    pub target: Expr,
    pub index: Expr,
    pub span: Span,
}

// Field access expression
pub struct FieldAccessExpr {
    pub object: Expr,
    pub name: string,
    pub span: Span,
}

// Lambda expression
pub struct LambdaExpr {
    pub params: Vec<string>,
    pub body: Vec<Stmt>,
    pub paramTypeExprs: Vec<TypeExpr?>,
    pub bodyExpr: Expr?,
    pub span: Span,
}

// Match expression
pub struct MatchExpr {
    pub expr: Expr,
    pub arms: Vec<MatchArm>,
    pub span: Span,
}

pub struct MatchArm {
    pub pattern: Pattern,
    pub guard: Expr,
    pub body: Expr,
    pub span: Span,
}

// If expression
pub struct IfExpr {
    pub condition: Expr,
    pub thenBranch: Expr,
    pub elseBranch: Expr,
    pub span: Span,
}

// Tuple expression
pub struct TupleExpr {
    pub elements: Vec<Expr>,
    pub span: Span,
}

// Array expression
pub struct ArrayExpr {
    pub elements: Vec<Expr>,
    pub span: Span,
}

// Dict expression
pub struct DictExpr {
    pub entries: Vec<DictEntry>,
    pub span: Span,
}

pub struct DictEntry {
    pub key: Expr,
    pub value: Expr,
    pub span: Span,
}

// Struct literal expression: Point { x: 1, y: 2 }
pub struct StructLiteralExpr {
    pub name: string,
    pub fields: Vec<StructInitField>,
    pub span: Span,
}

pub struct StructInitField {
    pub name: string,
    pub value: Expr,
    pub span: Span,
}

// Statement Kinds
pub enum StmtKind {
    VarDecl,
    ConstDecl,
    FuncDecl,
    StructDecl,
    EnumDecl,
    Import,
    If,
    Assign,
    Return,
    Break,
    Continue,
    While,
    For,
    Loop,
    Block,
    ExprStmt,
    Match,
}

// Statements
pub enum Stmt {
    VarDecl(VarDeclStmt),
    ConstDecl(ConstDeclStmt),
    FuncDecl(FuncDeclStmt),
    StructDecl(StructDeclStmt),
    EnumDecl(EnumDeclStmt),
    Import(ImportStmt),
    If(IfStmt),
    Assign(AssignStmt),
    Return(ReturnStmt),
    Break(BreakStmt),
    Continue(ContinueStmt),
    While(WhileStmt),
    For(ForStmt),
    Loop(LoopStmt),
    Block(BlockStmt),
    ExprStmt(ExprStmt),
    Match(MatchStmt),
}

// Variable declaration
pub struct VarDeclStmt {
    pub name: string,
    pub typeTag: string,
    pub typeExpr: TypeExpr?,
    pub value: Expr,
    pub span: Span,
}

// Constant declaration
pub struct ConstDeclStmt {
    pub name: string,
    pub typeTag: string,
    pub typeExpr: TypeExpr?,
    pub value: Expr,
    pub span: Span,
}

// Function declaration
pub struct FuncDeclStmt {
    pub name: string,
    pub params: Vec<FuncParam>,
    pub returnType: string,
    pub returnTypeExpr: TypeExpr?,
    pub isPub: bool,
    pub body: Vec<Stmt>,
    pub span: Span,
}

pub struct FuncParam {
    pub name: string,
    pub typeTag: string,
    pub typeExpr: TypeExpr?,
    pub default: Expr,
    pub hasDefault: bool,
    pub variadic: bool,
}

// Struct declaration
pub struct StructDeclStmt {
    pub name: string,
    pub fields: Vec<StructField>,
    pub methods: Vec<FuncDeclStmt>,
    pub isPub: bool,
    pub span: Span,
}

pub struct StructField {
    pub name: string,
    pub typeTag: string,
    pub typeExpr: TypeExpr?,
    pub isPub: bool,
}

// Enum declaration
pub struct EnumDeclStmt {
    pub name: string,
    pub variants: Vec<string>,
    pub variantDecls: Vec<EnumVariantDecl>,
    pub isPub: bool,
    pub span: Span,
}

pub struct EnumVariantDecl {
    pub name: string,
    pub payloadNames: Vec<string>,
    pub payloadTypes: Vec<TypeExpr>,
    pub span: Span,
}

// Import statement
pub struct ImportStmt {
    pub path: string,
    pub items: Vec<string>,
    pub sourceKind: ImportSourceKind,
    pub namespaceName: string,
    pub span: Span,
}

pub enum ImportSourceKind {
    File,
    Module,
}

// Return statement
pub struct ReturnStmt {
    pub value: Expr,
    pub span: Span,
}

// Break statement
pub struct BreakStmt {
    pub label: string,
    pub span: Span,
}

// Continue statement
pub struct ContinueStmt {
    pub label: string,
    pub span: Span,
}

// While statement
pub struct WhileStmt {
    pub condition: Expr,
    pub body: Vec<Stmt>,
    pub span: Span,
}

// For statement
pub struct ForStmt {
    pub variable: string,
    pub iterable: Expr,
    pub body: Vec<Stmt>,
    pub span: Span,
}

// Loop statement
pub struct LoopStmt {
    pub body: Vec<Stmt>,
    pub span: Span,
}

// Block statement
pub struct BlockStmt {
    pub statements: Vec<Stmt>,
    pub span: Span,
}

// Expression statement
pub struct ExprStmt {
    pub expr: Expr,
    pub span: Span,
}

// If statement
pub struct IfStmt {
    pub condition: Expr,
    pub thenBranch: BlockStmt,
    pub elseBranch: BlockStmt?,
    pub span: Span,
}

// Assignment statement
pub struct AssignStmt {
    pub target: Expr,
    pub op: string,
    pub value: Expr,
    pub span: Span,
}

pub struct MatchStmt {
    pub scrutinee: Expr,
    pub arms: Vec<MatchStmtArm>,
    pub span: Span,
}

pub struct MatchStmtArm {
    pub pattern: Pattern,
    pub body: Stmt,
    pub span: Span,
}

// Pattern kinds for match
pub enum PatternKind {
    Error,
    Wildcard,
    Literal,
    Variable,
    EnumVariant,
    Struct,
    Or,
    Range,
}

pub enum Pattern {
    Error(ErrorPattern),
    Wildcard(WildcardPattern),
    Literal(LiteralPattern),
    Variable(VariablePattern),
    EnumVariant(EnumVariantPattern),
    Struct(StructPattern),
    Or(OrPattern),
    Range(RangePattern),
}

pub struct ErrorPattern {
    pub kind: PatternKind,
    pub span: Span,
}

pub struct WildcardPattern {
    pub kind: PatternKind,
    pub span: Span,
}

pub struct LiteralPattern {
    pub kind: PatternKind,
    pub literal: Literal,
    pub span: Span,
}

pub struct VariablePattern {
    pub kind: PatternKind,
    pub name: string,
    pub span: Span,
}

pub struct EnumVariantPattern {
    pub kind: PatternKind,
    pub enumName: string,
    pub variant: string,
    pub payloads: Vec<Pattern>,
    pub span: Span,
}

pub struct RangePattern {
    pub kind: PatternKind,
    pub start: Literal,
    pub end: Literal,
    pub inclusive: bool,
    pub span: Span,
}

pub struct StructPattern {
    pub kind: PatternKind,
    pub structName: string,
    pub fields: Vec<PatternField>,
    pub span: Span,
}

pub struct PatternField {
    pub name: string,
    pub pattern: Pattern,
    pub span: Span,
}

pub struct OrPattern {
    pub kind: PatternKind,
    pub left: Pattern,
    pub right: Pattern,
    pub span: Span,
}

pub func exprSpan(expr: Expr): Span {
    match expr {
        Expr::Error(payload) => { return payload.span; },
        Expr::Literal(payload) => { return payload.span; },
        Expr::Identifier(payload) => { return payload.span; },
        Expr::Binary(payload) => { return payload.span; },
        Expr::Unary(payload) => { return payload.span; },
        Expr::Update(payload) => { return payload.span; },
        Expr::Call(payload) => { return payload.span; },
        Expr::EnumVariant(payload) => { return payload.span; },
        Expr::Index(payload) => { return payload.span; },
        Expr::FieldAccess(payload) => { return payload.span; },
        Expr::Lambda(payload) => { return payload.span; },
        Expr::Match(payload) => { return payload.span; },
        Expr::If(payload) => { return payload.span; },
        Expr::Tuple(payload) => { return payload.span; },
        Expr::Array(payload) => { return payload.span; },
        Expr::Dict(payload) => { return payload.span; },
        Expr::StructLiteral(payload) => { return payload.span; },
    }
    return Span { start: 0, end: 0, line: 1, column: 0 };
}

pub func stmtSpan(stmt: Stmt): Span {
    match stmt {
        Stmt::VarDecl(payload) => { return payload.span; },
        Stmt::ConstDecl(payload) => { return payload.span; },
        Stmt::FuncDecl(payload) => { return payload.span; },
        Stmt::StructDecl(payload) => { return payload.span; },
        Stmt::EnumDecl(payload) => { return payload.span; },
        Stmt::Import(payload) => { return payload.span; },
        Stmt::If(payload) => { return payload.span; },
        Stmt::Assign(payload) => { return payload.span; },
        Stmt::Return(payload) => { return payload.span; },
        Stmt::Break(payload) => { return payload.span; },
        Stmt::Continue(payload) => { return payload.span; },
        Stmt::While(payload) => { return payload.span; },
        Stmt::For(payload) => { return payload.span; },
        Stmt::Loop(payload) => { return payload.span; },
        Stmt::Block(payload) => { return payload.span; },
        Stmt::ExprStmt(payload) => { return payload.span; },
        Stmt::Match(payload) => { return payload.span; },
    }
    return Span { start: 0, end: 0, line: 1, column: 0 };
}

pub func patternSpan(pattern: Pattern): Span {
    match pattern {
        Pattern::Error(payload) => { return payload.span; },
        Pattern::Wildcard(payload) => { return payload.span; },
        Pattern::Literal(payload) => { return payload.span; },
        Pattern::Variable(payload) => { return payload.span; },
        Pattern::EnumVariant(payload) => { return payload.span; },
        Pattern::Struct(payload) => { return payload.span; },
        Pattern::Or(payload) => { return payload.span; },
        Pattern::Range(payload) => { return payload.span; },
    }
    return Span { start: 0, end: 0, line: 1, column: 0 };
}

// Program root
pub struct Program {
    pub statements: Vec<Stmt>,
    pub span: Span,
}

// Parser error
pub struct ParseError {
    pub message: string,
    pub span: Span,
}
