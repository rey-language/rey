// Parser Implementation for Rey

import lexer;
import ast;

struct Parser {
    pub tokens: [Token],
    pub current: int,
    pub errors: [ParseError],
}

struct ParserResult {
    pub program: Program,
    pub errors: [ParseError],
}

func isAtEnd(p: Parser): bool {
    if p.current >= p.tokens.length() {
        return true;
    }
    var curTok: Token = p.tokens[p.current];
    return curTok.kind == "Eof";
}

func peek(p: Parser): Token {
    if isAtEnd(p) {
        var lastTok: Token = p.tokens[p.tokens.length() - 1];
        return lastTok;
    }
    var curTok: Token = p.tokens[p.current];
    return curTok;
}

func peekNext(p: Parser): Token {
    if p.current + 1 >= p.tokens.length() {
        var lastTok: Token = p.tokens[p.tokens.length() - 1];
        return lastTok;
    }
    var nextTok: Token = p.tokens[p.current + 1];
    return nextTok;
}

func advance(p: Parser): Token {
    if isAtEnd(p) {
        var lastTok: Token = p.tokens[p.tokens.length() - 1];
        return lastTok;
    }
    var token: Token = p.tokens[p.current];
    p.current = p.current + 1;
    return token;
}

func check(p: Parser, kind): bool {
    if isAtEnd(p) {
        return false;
    }
    return peek(p).kind == kind;
}

func checkNext(p: Parser, kind): bool {
    if p.current + 1 >= p.tokens.length() {
        return false;
    }
    return peekNext(p).kind == kind;
}

func matchToken(p: Parser, kinds): bool {
    var i = 0;
    var kindsLen = kinds.length();
    loop {
        if i >= kindsLen {
            break;
        }
        if check(p, kinds[i]) {
            advance(p);
            return true;
        }
        i = i + 1;
    }
    return false;
}

func toSpan(s) {
    return Span { start: s.start, end: s.end, line: s.line, column: s.column };
}

// Parses a type annotation: Identifier, [Identifier], or Identifier? (nullable)
func parseTypeTag(p: Parser): String {
    if matchToken(p, ["LeftBracket"]) {
        var inner = consume(p, "Identifier", "array element type expected");
        consume(p, "RightBracket", "] expected");
        return "[" + inner.lexeme + "]";
    }
    var tok = consume(p, "Identifier", "type expected");
    var tag = tok.lexeme;
    if matchToken(p, ["Question"]) {
        tag = tag + "?";
    }
    return tag;
}

func consume(p: Parser, kind, message: String): Token {
    if check(p, kind) {
        return advance(p);
    }
    var span = toSpan(peek(p).span);
    p.errors.push(ParseError { message: message, span: span });
    var firstTok: Token = p.tokens[0];
    return firstTok;
}

func error(p: Parser, message: String) {
    var token: Token = peek(p);
    p.errors.push(ParseError { message: message, span: toSpan(token.span) });
}

func previous(p: Parser): Token {
    if p.current == 0 {
        var firstTok: Token = p.tokens[0];
        return firstTok;
    }
    var prevTok: Token = p.tokens[p.current - 1];
    return prevTok;
}

func makeSpan(p: Parser, start: int, end: int) {
    if p.tokens.length() == 0 {
        return null;
    }
    var line = 1;
    var column = 0;
    if start < p.tokens.length() {
        var startTok: Token = p.tokens[start];
        line = startTok.span.line;
        column = startTok.span.column;
    }
    return Span { start: start, end: end, line: line, column: column };
}

func parseProgram(p: Parser) {
    var statements = [];
    var dbgCount = 0;
    loop {
        if isAtEnd(p) {
            break;
        }
        var stmt = parseStatement(p);
        dbgCount = dbgCount + 1;
        statements.push(stmt);
    }
    var span = makeSpan(p, 0, p.tokens.length() - 1);
    return Program { statements: statements, span: span };
}

func parseStatement(p: Parser) {
    var token = peek(p);
    
    if token.kind == "Export" {
        advance(p);
        if check(p, "Pub") { advance(p); }
        var next = peek(p);
        if next.kind == "Func" { return parseFuncDecl(p); }
        if next.kind == "Struct" { return parseStructDecl(p); }
        if next.kind == "Enum" { return parseEnumDecl(p); }
        error(p, "declaration expected after export");
        return parseExprStmt(p);
    }
    if token.kind == "Pub" {
        advance(p);
        var next2 = peek(p);
        if next2.kind == "Func" { return parseFuncDecl(p); }
        if next2.kind == "Struct" { return parseStructDecl(p); }
        if next2.kind == "Enum" { return parseEnumDecl(p); }
        error(p, "declaration expected after pub");
        return parseExprStmt(p);
    }
    if token.kind == "Var" {
        return parseVarDecl(p);
    }
    if token.kind == "Const" {
        return parseConstDecl(p);
    }
    if token.kind == "If" {
        return parseIf(p);
    }
    if token.kind == "Func" {
        return parseFuncDecl(p);
    }
    if token.kind == "Struct" {
        return parseStructDecl(p);
    }
    if token.kind == "Enum" {
        return parseEnumDecl(p);
    }
    if token.kind == "Import" {
        return parseImport(p);
    }
    if token.kind == "Return" {
        return parseReturn(p);
    }
    if token.kind == "While" {
        return parseWhile(p);
    }
    if token.kind == "For" {
        return parseFor(p);
    }
    if token.kind == "Loop" {
        return parseLoop(p);
    }
    if token.kind == "Break" {
        return parseBreak(p);
    }
    if token.kind == "Continue" {
        return parseContinue(p);
    }
    if token.kind == "LeftBrace" {
        return parseBlock(p);
    }

    if token.kind == "Identifier" {
        if checkNext(p, "Equal") || checkNext(p, "PlusEqual") || checkNext(p, "MinusEqual") || checkNext(p, "StarEqual") || checkNext(p, "SlashEqual") || checkNext(p, "PercentEqual") {
            return parseAssign(p);
        }
    }
    
    return parseExprStmt(p);
}

func parseVarDecl(p: Parser) {
    var startToken = advance(p);
    var nameToken = consume(p, "Identifier", "var name expected");
    var name = nameToken.lexeme;
    var typeTag = "";
    if matchToken(p, ["Colon"]) {
        typeTag = parseTypeTag(p);
    }
    consume(p, "Equal", "= expected");
    var value = parseExpression(p);
    consume(p, "Semicolon", "; expected");
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return VarDeclStmt { name: name, typeTag: typeTag, value: value, span: span };
}

func parseConstDecl(p: Parser) {
    var startToken = advance(p);
    var nameToken = consume(p, "Identifier", "const name expected");
    var name = nameToken.lexeme;
    var typeTag = "";
    if matchToken(p, ["Colon"]) {
        typeTag = parseTypeTag(p);
    }
    consume(p, "Equal", "= expected");
    var value = parseExpression(p);
    consume(p, "Semicolon", "; expected");
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return ConstDeclStmt { name: name, typeTag: typeTag, value: value, span: span };
}

func parseFuncDecl(p: Parser) {
    var startToken = advance(p);
    var nameToken = consume(p, "Identifier", "func name expected");
    var name = nameToken.lexeme;
    consume(p, "LeftParen", "( expected");
    var params = parseFuncParams(p);
    consume(p, "RightParen", ") expected");
    var returnType = "";
    if matchToken(p, ["Colon"]) {
        returnType = parseTypeTag(p);
    }
    var body = parseBlock(p);
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return FuncDeclStmt { name: name, params: params, returnType: returnType, body: body, span: span };
}

func parseFuncParams(p: Parser) {
    var params = [];
    if check(p, "RightParen") {
        return params;
    }
    loop {
        var nameTok = consume(p, "Identifier", "param expected");
        var paramName = nameTok.lexeme;
        var typeTag = "";
        if matchToken(p, ["Colon"]) {
            typeTag = parseTypeTag(p);
        }
        params.push(FuncParam { name: paramName, typeTag: typeTag, default: LiteralExpr { kind: LiteralKind.Null, text: "null", span: toSpan(nameTok.span) } });
        if check(p, "Comma") {
            advance(p);
        } else {
            break;
        }
    }
    return params;
}

func parseStructDecl(p: Parser) {
    var startToken = advance(p);
    var nameToken = consume(p, "Identifier", "struct name expected");
    var name = nameToken.lexeme;
    consume(p, "LeftBrace", "{ expected");
    var fields = [];
    var methods = [];
    var loopCount = 0;
    loop {
        loopCount = loopCount + 1;
        if check(p, "RightBrace") {
            advance(p);
            break;
        }
        if matchToken(p, ["Func"]) {
            var method = parseFuncDecl(p);
            methods.push(method);
        } else {
            var isPub = matchToken(p, ["Pub"]);
            var fieldNameTok = consume(p, "Identifier", "field name expected");
            var fieldName = fieldNameTok.lexeme;
            var fieldType = "";
            if matchToken(p, ["Colon"]) {
                fieldType = parseTypeTag(p);
            }
            matchToken(p, ["Semicolon", "Comma"]);
            fields.push(StructField { name: fieldName, typeTag: fieldType, isPub: isPub });
        }
    }
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return StructDeclStmt { name: name, fields: fields, methods: methods, span: span };
}

func parseEnumDecl(p: Parser) {
    var startToken = advance(p);
    var nameToken = consume(p, "Identifier", "enum name expected");
    var name = nameToken.lexeme;
    consume(p, "LeftBrace", "{ expected");
    var variants = [];
    loop {
        if check(p, "RightBrace") {
            advance(p);
            break;
        }
        var vt = consume(p, "Identifier", "variant expected");
        variants.push(vt.lexeme);
        if check(p, "Comma") {
            advance(p);
        }
    }
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return EnumDeclStmt { name: name, variants: variants, span: span };
}

func parseImport(p: Parser) {
    var startToken = advance(p);
    var path = "";
    if check(p, "StringLiteral") {
        path = advance(p).lexeme;
    } else {
        var pathTok = consume(p, "Identifier", "path expected");
        path = pathTok.lexeme;
    }
    var items = [];
    consume(p, "Semicolon", "; expected");
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return ImportStmt { path: path, items: items, span: span };
}

func parseIf(p: Parser) {
    var startToken = advance(p);
    var hasParen = matchToken(p, ["LeftParen"]);
    var cond = parseExpression(p);
    if hasParen {
        consume(p, "RightParen", ") expected");
    }
    var thenBranch = parseBlock(p);
    var elseBranch = null;
    if matchToken(p, ["Else"]) {
        if check(p, "If") {
            elseBranch = parseIf(p);
        } else {
            elseBranch = parseBlock(p);
        }
    }
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return IfStmt { condition: cond, thenBranch: thenBranch, elseBranch: elseBranch, span: span };
}

func parseReturn(p: Parser) {
    var startToken = advance(p);
    var value = LiteralExpr { kind: LiteralKind.Null, text: "null", span: toSpan(startToken.span) };
    if !check(p, "Semicolon") {
        value = parseExpression(p);
    }
    consume(p, "Semicolon", "; expected");
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return ReturnStmt { value: value, span: span };
}

func parseAssign(p: Parser) {
    var startTok = peek(p);
    var target = parseCall(p);
    var opTok = advance(p);
    var op = opTok.lexeme;
    var value = parseExpression(p);
    consume(p, "Semicolon", "; expected");
    var span = makeSpan(p, startTok.span.start, previous(p).span.end);
    return AssignStmt { target: target, op: op, value: value, span: span };
}

func parseWhile(p: Parser) {
    var startToken = advance(p);
    consume(p, "LeftParen", "( expected");
    var cond = parseExpression(p);
    consume(p, "RightParen", ") expected");
    var body = parseBlock(p);
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return WhileStmt { condition: cond, body: body, span: span };
}

func parseFor(p: Parser) {
    var startToken = advance(p);
    consume(p, "LeftParen", "( expected");
    var varTok = consume(p, "Identifier", "var expected");
    var varName = varTok.lexeme;
    consume(p, "In", "in expected");
    var iter = parseExpression(p);
    consume(p, "RightParen", ") expected");
    var body = parseBlock(p);
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return ForStmt { variable: varName, iterable: iter, body: body, span: span };
}

func parseLoop(p: Parser) {
    var startToken = advance(p);
    var body = parseBlock(p);
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return LoopStmt { body: body, span: span };
}

func parseBreak(p: Parser) {
    var startToken = advance(p);
    consume(p, "Semicolon", "; expected");
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return BreakStmt { label: "", span: span };
}

func parseContinue(p: Parser) {
    var startToken = advance(p);
    consume(p, "Semicolon", "; expected");
    var span = makeSpan(p, startToken.span.start, previous(p).span.end);
    return ContinueStmt { label: "", span: span };
}

func parseBlock(p: Parser) {
    var startTok = consume(p, "LeftBrace", "{ expected");
    var stmts = [];
    loop {
        if check(p, "RightBrace") || isAtEnd(p) {
            break;
        }
        var stmt = parseStatement(p);
        stmts.push(stmt);
    }
    consume(p, "RightBrace", "} expected");
    var span = makeSpan(p, startTok.span.start, previous(p).span.end);
    return BlockStmt { statements: stmts, span: span };
}

func parseExprStmt(p: Parser) {
    var startTok = peek(p);
    var expr = parseExpression(p);
    if check(p, "Equal") || check(p, "PlusEqual") || check(p, "MinusEqual") || check(p, "StarEqual") || check(p, "SlashEqual") || check(p, "PercentEqual") {
        var opTok = advance(p);
        var value = parseExpression(p);
        consume(p, "Semicolon", "; expected");
        var span = makeSpan(p, startTok.span.start, previous(p).span.end);
        return AssignStmt { target: expr, op: opTok.lexeme, value: value, span: span };
    }
    consume(p, "Semicolon", "; expected");
    var span = expr.span;
    return ExprStmt { expr: expr, span: span };
}

func parseExpression(p: Parser) {
    return parseOr(p);
}

func parseOr(p: Parser) {
    var leftStart = p.current;
    var left = parseAnd(p);
    loop {
        if matchToken(p, ["OrOr"]) {
            var op = previous(p).lexeme;
            var right = parseAnd(p);
            var span = makeSpan(p, leftStart, p.current - 1);
            left = BinaryExpr { left: left, op: op, right: right, span: span };
        } else {
            break;
        }
    }
    return left;
}

func parseAnd(p: Parser) {
    var leftStart = p.current;
    var left = parseEquality(p);
    loop {
        if matchToken(p, ["AndAnd"]) {
            var op = previous(p).lexeme;
            var right = parseEquality(p);
            var span = makeSpan(p, leftStart, p.current - 1);
            left = BinaryExpr { left: left, op: op, right: right, span: span };
        } else {
            break;
        }
    }
    return left;
}

func parseEquality(p: Parser) {
    var leftStart = p.current;
    var left = parseComparison(p);
    loop {
        if matchToken(p, ["EqualEqual", "NotEqual"]) {
            var op = previous(p).lexeme;
            var right = parseComparison(p);
            var span = makeSpan(p, leftStart, p.current - 1);
            left = BinaryExpr { left: left, op: op, right: right, span: span };
        } else {
            break;
        }
    }
    return left;
}

func parseComparison(p: Parser) {
    var leftStart = p.current;
    var left = parseTerm(p);
    loop {
        if matchToken(p, ["InstanceOf"]) {
            var typeTok = consume(p, "Identifier", "type name expected after instanceof");
            var span = makeSpan(p, leftStart, p.current - 1);
            left = BinaryExpr { left: left, op: "instanceof", right: IdentExpr { name: typeTok.lexeme, span: toSpan(typeTok.span) }, span: span };
        } else if matchToken(p, ["Less", "Greater", "LessEqual", "GreaterEqual"]) {
            var op = previous(p).lexeme;
            var right = parseTerm(p);
            var span = makeSpan(p, leftStart, p.current - 1);
            left = BinaryExpr { left: left, op: op, right: right, span: span };
        } else {
            break;
        }
    }
    return left;
}

func parseTerm(p: Parser) {
    var leftStart = p.current;
    var left = parseFactor(p);
    loop {
        if matchToken(p, ["Plus", "Minus"]) {
            var op = previous(p).lexeme;
            var right = parseFactor(p);
            var span = makeSpan(p, leftStart, p.current - 1);
            left = BinaryExpr { left: left, op: op, right: right, span: span };
        } else {
            break;
        }
    }
    return left;
}

func parseFactor(p: Parser) {
    var leftStart = p.current;
    var left = parseUnary(p);
    loop {
        if matchToken(p, ["Star", "Slash", "Percent"]) {
            var op = previous(p).lexeme;
            var right = parseUnary(p);
            var span = makeSpan(p, leftStart, p.current - 1);
            left = BinaryExpr { left: left, op: op, right: right, span: span };
        } else {
            break;
        }
    }
    return left;
}

func parseUnary(p: Parser) {
    if matchToken(p, ["Not", "Minus"]) {
        var op = previous(p).lexeme;
        var unaryStart = p.current;
        var right = parseUnary(p);
        var span = makeSpan(p, unaryStart, p.current - 1);
        return UnaryExpr { op: op, right: right, span: span };
    }
    return parseCall(p);
}

func parseCall(p: Parser) {
    var exprStart = p.current;
    var expr = parsePrimary(p);
    loop {
        if check(p, "LeftParen") {
            advance(p);
            var args = parseArgs(p);
            consume(p, "RightParen", ") expected");
            var span = makeSpan(p, exprStart, previous(p).span.end);
            expr = CallExpr { callee: expr, args: args, span: span };
        } else if check(p, "LeftBrace") {
            if expr instanceof IdentExpr {
                // Only parse as struct literal if { is followed by } (empty) or Identifier : (field)
                var looksLikeStruct = false;
                if p.current + 1 < p.tokens.length() {
                    var afterBrace: Token = p.tokens[p.current + 1];
                    if afterBrace.kind == "RightBrace" {
                        looksLikeStruct = true;
                    } else if afterBrace.kind == "Identifier" {
                        if p.current + 2 < p.tokens.length() {
                            var colonTok: Token = p.tokens[p.current + 2];
                            if colonTok.kind == "Colon" {
                                looksLikeStruct = true;
                            }
                        }
                    }
                }
                if looksLikeStruct {
                    var startTok = advance(p);
                    var fields = [];
                    if !check(p, "RightBrace") {
                        loop {
                            var nameTok = consume(p, "Identifier", "field name expected");
                            consume(p, "Colon", ": expected");
                            var val = parseExpression(p);
                            fields.push(StructInitField { name: nameTok.lexeme, value: val, span: toSpan(nameTok.span) });
                            if check(p, "Comma") {
                                advance(p);
                            } else {
                                break;
                            }
                        }
                    }
                    consume(p, "RightBrace", "} expected");
                    var span2 = makeSpan(p, exprStart, previous(p).span.end);
                    expr = StructLiteralExpr { name: expr.name, fields: fields, span: span2 };
                } else {
                    break;
                }
            } else {
                break;
            }
        } else if check(p, "Dot") {
            advance(p);
            var nameTok = consume(p, "Identifier", "prop expected");
            var span = makeSpan(p, exprStart, nameTok.span.end);
            expr = FieldAccessExpr { object: expr, name: nameTok.lexeme, span: span };
        } else if check(p, "LeftBracket") {
            advance(p);
            var idx = parseExpression(p);
            consume(p, "RightBracket", "] expected");
            var span = makeSpan(p, exprStart, previous(p).span.end);
            expr = IndexExpr { target: expr, index: idx, span: span };
        } else {
            break;
        }
    }
    return expr;
}

func parseArgs(p: Parser) {
    var args = [];
    if check(p, "RightParen") {
        return args;
    }
    loop {
        var arg = parseExpression(p);
        args.push(arg);
        if check(p, "Comma") {
            advance(p);
        } else {
            break;
        }
    }
    return args;
}

func parsePrimary(p: Parser) {
    var tok = peek(p);
    if tok.kind == "True" {
        advance(p);
        return LiteralExpr { kind: LiteralKind.Bool, text: "true", span: toSpan(tok.span) };
    }
    if tok.kind == "False" {
        advance(p);
        return LiteralExpr { kind: LiteralKind.Bool, text: "false", span: toSpan(tok.span) };
    }
    if tok.kind == "Null" {
        advance(p);
        return LiteralExpr { kind: LiteralKind.Null, text: "null", span: toSpan(tok.span) };
    }
    if tok.kind == "NumberLiteral" {
        var nt = advance(p);
        if nt.lexeme.contains(".") {
            return LiteralExpr { kind: LiteralKind.Float, text: nt.lexeme, span: toSpan(nt.span) };
        }
        return LiteralExpr { kind: LiteralKind.Int, text: nt.lexeme, span: toSpan(nt.span) };
    }
    if tok.kind == "StringLiteral" {
        var st = advance(p);
        return LiteralExpr { kind: LiteralKind.String, text: st.lexeme, span: toSpan(st.span) };
    }
    if tok.kind == "Identifier" {
        var it = advance(p);
        return IdentExpr { name: it.lexeme, span: toSpan(it.span) };
    }
    if tok.kind == "LeftParen" {
        return parseGrouping(p);
    }
    if tok.kind == "LeftBracket" {
        return parseArray(p);
    }
    if tok.kind == "LeftBrace" {
        return parseDict(p);
    }
    if tok.kind == "Func" {
        return parseLambda(p);
    }
    error(p, "expression expected");
    advance(p);
    return IdentExpr { name: "", span: toSpan(tok.span) };
}

func parseGrouping(p: Parser) {
    var startTok = advance(p);
    var expr = parseExpression(p);
    consume(p, "RightParen", ") expected");
    return expr;
}

func parseArray(p: Parser) {
    var startTok = consume(p, "LeftBracket", "[ expected");
    var elems = [];
    if !check(p, "RightBracket") {
        loop {
            var e = parseExpression(p);
            elems.push(e);
            if check(p, "Comma") {
                advance(p);
            } else {
                break;
            }
        }
    }
    consume(p, "RightBracket", "] expected");
    var span = makeSpan(p, startTok.span.start, previous(p).span.end);
    return ArrayExpr { elements: elems, span: span };
}

func parseDict(p: Parser) {
    var startTok = consume(p, "LeftBrace", "{ expected");
    var entries = [];
    if !check(p, "RightBrace") {
        loop {
            var k = parseExpression(p);
            consume(p, "Colon", ": expected");
            var v = parseExpression(p);
            entries.push(DictEntry { key: k, value: v, span: k.span });
            if check(p, "Comma") {
                advance(p);
            } else {
                break;
            }
        }
    }
    consume(p, "RightBrace", "} expected");
    var span = makeSpan(p, startTok.span.start, previous(p).span.end);
    return DictExpr { entries: entries, span: span };
}

func parseLambda(p: Parser) {
    var startTok = advance(p);
    consume(p, "LeftParen", "( expected");
    var params = [];
    if !check(p, "RightParen") {
        loop {
            var pt = consume(p, "Identifier", "param expected");
            params.push(pt.lexeme);
            if check(p, "Comma") {
                advance(p);
            } else {
                break;
            }
        }
    }
    consume(p, "RightParen", ") expected");
    var body = parseBlock(p);
    var span = makeSpan(p, startTok.span.start, previous(p).span.end);
    return LambdaExpr { params: params, body: body, span: span };
}

export pub func newParser(tokens): Parser {
    return Parser { tokens: tokens, current: 0, errors: [] };
}

export pub func parse(tokens, path: String): ParserResult {
    var parser = newParser(tokens);
    var program = parseProgram(parser);
    return ParserResult { program: program, errors: parser.errors };
}
