// Direct x86-64 emission. linux-x64 keeps the SysV syscall image that the
// existing executable writer consumes. windows-x64's entry stub allocates 40
// bytes (shadow space plus alignment) and is recorded as frame id -1 so .pdata
// covers it. darwin-x64 stays a SysV direct syscall. emitProgram still accepts
// only linux-x64.
// abi linux-x64 syscall-exit 60 convention sysv shadow 0 stack-align 16 red-zone 128 loader none
// abi windows-x64 syscall-exit -1 convention win64 shadow 32 stack-align 16 red-zone 0 loader kernel32.dll symbol ExitProcess
// abi darwin-x64 syscall-exit 33554433 convention sysv shadow 0 stack-align 16 red-zone 128 loader /usr/lib/dyld symbol direct-syscall
import ir::{IRProgram, IRFunction, BasicBlock, Instruction, InstructionKind, TerminatorKind, IRTypeKind, IRValue, CompareI64Predicate};
import ir::verify::{verifyProgram};
import ir::storage::{FunctionSlots, ProgramSlots, planSlots};
import ir::storage::registers::{FunctionRegisterPlan, ProgramRegisterPlan, RegisterLocationKind, planRegistersFromSlots};
import native::packed::{PackedBuffer, packedBufferCreate, packedBufferTryAppendByte, packedBufferTryAppendU32Le, packedBufferTryLength, packedBufferTryPatchByte};

pub struct X64FunctionOffset {
    pub functionId: int,
    pub offset: int,
}

pub struct X64Code {
    pub bytes: Vec<int>,
    pub entryOffset: int,
    pub functions: Vec<X64FunctionOffset>,
}

pub struct PackedX64Code {
    pub bytes: PackedBuffer,
    pub entryOffset: int,
    pub functions: Vec<X64FunctionOffset>,
}

pub struct X64Relocation {
    pub offset: int,
    pub kind: int,
    pub symbol: string,
}

pub struct X64Import {
    pub library: string,
    pub symbol: string,
}

func windowsHostCallArgumentCount(selector: int): int {
    if selector == 7101 { return 7; }
    if selector == 7102 || selector == 7103 || selector == 7107 { return 6; }
    if selector == 7118 { return 8; }
    return 0;
}

pub struct X64Frame {
    pub functionId: int,
    pub offset: int,
    pub frameBytes: int,
}

pub struct X64Image {
    pub code: X64Code,
    pub target: string,
    pub convention: string,
    pub relocations: Vec<X64Relocation>,
    pub imports: Vec<X64Import>,
    pub frames: Vec<X64Frame>,
    pub maxFrameBytes: int,
    pub stackMetadata: string,
}

pub func relocationRipDisp32(): int { return 1; }

struct ValueSlot {
    pub valueId: int,
    pub index: int,
}

struct BlockOffset {
    pub blockId: int,
    pub offset: int,
}

struct Fixup {
    pub offset: int,
    pub kind: int,
    pub targetFunctionId: int,
    pub targetBlockId: int,
    pub targetOffset: int,
}

struct IdIndex {
    pub dense: Vec<int>,
    pub sparseKeys: Vec<int>,
    pub sparseValues: Vec<int>,
    pub isDense: bool,
    pub maximumId: int,
}

struct Emitter {
    pub bytes: Vec<int>,
    pub packedBytes: PackedBuffer?,
    pub functions: Vec<X64FunctionOffset>,
    pub fixups: Vec<Fixup>,
    pub error: string,
    pub convention: string,
    pub os: string,
    pub relocations: Vec<X64Relocation>,
    pub imports: Vec<X64Import>,
    pub frames: Vec<X64Frame>,
    pub maxFrame: int,
}

func emitterLength(emitter: Emitter): int {
    var packed = emitter.packedBytes;
    if packed != null {
        var length = packedBufferTryLength(packed);
        if length < 0 {
            emitter.error = "native x64: invalid packed byte buffer";
            return 0;
        }
        return length;
    }
    return emitter.bytes.len();
}

func emitterStoreByte(emitter: Emitter, index: int, value: int): bool {
    var packed = emitter.packedBytes;
    if packed != null { return packedBufferTryPatchByte(packed, index, value); }
    if index < 0 || index >= emitterLength(emitter) { return false; }
    emitter.bytes.set(index, value);
    return true;
}

func emitByte(emitter: Emitter, value: int): void {
    if emitter.error != "" { return; }
    if value < 0 || value > 255 {
        emitter.error = "native x64: byte does not fit unsigned byte";
        return;
    }
    var packed = emitter.packedBytes;
    if packed != null {
        if !packedBufferTryAppendByte(packed, value) { emitter.error = "native x64: packed byte append failed"; }
    } else { emitter.bytes.push(value); }
}

func emitU32(emitter: Emitter, value: int): void {
    if emitter.error != "" { return; }
    if value < 0 || value > 4294967295 {
        emitter.error = "native x64: immediate does not fit uint32";
        return;
    }
    var packed = emitter.packedBytes;
    if packed != null {
        if !packedBufferTryAppendU32Le(packed, value) { emitter.error = "native x64: packed uint32 append failed"; }
        return;
    }
    emitByte(emitter, value % 256);
    emitByte(emitter, (value / 256) % 256);
    emitByte(emitter, (value / 65536) % 256);
    emitByte(emitter, (value / 16777216) % 256);
}

func emitI32(emitter: Emitter, value: int): void {
    if value < -2147483648 || value > 2147483647 {
        emitter.error = "native x64: displacement does not fit int32";
        return;
    }
    var remaining = value;
    var i = 0;
    loop {
        if i >= 4 { break; }
        var limb = remaining % 256;
        if limb < 0 { limb = limb + 256; }
        emitByte(emitter, limb);
        remaining = (remaining - limb) / 256;
        i = i + 1;
    }
}

func emitI64(emitter: Emitter, value: int): void {
    var remaining = value;
    var i = 0;
    loop {
        if i >= 8 { break; }
        var limb = remaining % 256;
        if limb < 0 { limb = limb + 256; }
        emitByte(emitter, limb);
        remaining = (remaining - limb) / 256;
        i = i + 1;
    }
}

func emitRex(emitter: Emitter, wide: bool, reg: int, base: int): void {
    var value = 64;
    if wide { value = value + 8; }
    if reg >= 8 { value = value + 4; }
    if base >= 8 { value = value + 1; }
    emitByte(emitter, value);
}

func emitLoad(emitter: Emitter, register: int, displacement: int): void {
    if displacement > 0 || displacement < -2147483648 {
        emitter.error = "native x64: stack load offset is outside the supported frame";
        return;
    }
    emitRex(emitter, true, register, 5);
    emitByte(emitter, 139);
    emitByte(emitter, 128 + (register % 8) * 8 + 5);
    emitI32(emitter, displacement);
}

func emitStore(emitter: Emitter, register: int, displacement: int): void {
    if displacement > 0 || displacement < -2147483648 {
        emitter.error = "native x64: stack store offset is outside the supported frame";
        return;
    }
    emitRex(emitter, true, register, 5);
    emitByte(emitter, 137);
    emitByte(emitter, 128 + (register % 8) * 8 + 5);
    emitI32(emitter, displacement);
}

func emitLoadPositive(emitter: Emitter, register: int, displacement: int): void {
    if displacement < 0 || displacement > 2147483647 {
        emitter.error = "native x64: incoming argument offset is outside the supported frame";
        return;
    }
    emitRex(emitter, true, register, 5);
    emitByte(emitter, 139);
    emitByte(emitter, 128 + (register % 8) * 8 + 5);
    emitI32(emitter, displacement);
}

func emitTest(emitter: Emitter, register: int): void {
    emitRex(emitter, true, register, register);
    emitByte(emitter, 133);
    emitByte(emitter, 192 + (register % 8) * 8 + register % 8);
}

func emitAddRegs(emitter: Emitter, destination: int, source: int): void {
    emitRex(emitter, true, source, destination);
    emitByte(emitter, 1);
    emitByte(emitter, 192 + (source % 8) * 8 + destination % 8);
}

func emitMoveRegister(emitter: Emitter, destination: int, source: int): void {
    if destination == source { return; }
    emitRex(emitter, true, source, destination);
    emitByte(emitter, 137);
    emitByte(emitter, 192 + (source % 8) * 8 + destination % 8);
}

func emitTrapIfZero(emitter: Emitter, register: int, overflowOffset: int): void {
    emitTest(emitter, register);
    emitJmp(emitter, 6, -1, -1, overflowOffset);
}

func emitTrapIfSign(emitter: Emitter, register: int, overflowOffset: int): void {
    emitTest(emitter, register);
    emitJmp(emitter, 7, -1, -1, overflowOffset);
}

func emitTrapIfNonPositive(emitter: Emitter, register: int, overflowOffset: int): void {
    emitTest(emitter, register);
    emitJmp(emitter, 10, -1, -1, overflowOffset);
}

func emitAddressCheck(emitter: Emitter, register: int, aligned: bool, overflowOffset: int): void {
    emitTrapIfZero(emitter, register, overflowOffset);
    if aligned {
        emitByte(emitter, 168);
        emitByte(emitter, 7);
        emitJmp(emitter, 5, -1, -1, overflowOffset);
    }
}

func emitLoadIndirect(emitter: Emitter): void {
    emitRex(emitter, true, 0, 0);
    emitByte(emitter, 139);
    emitByte(emitter, 0);
}

func emitStoreIndirectRcx(emitter: Emitter): void {
    emitRex(emitter, true, 1, 0);
    emitByte(emitter, 137);
    emitByte(emitter, 8);
}

func emitLoadByteIndirect(emitter: Emitter): void {
    emitRex(emitter, true, 0, 0);
    emitByte(emitter, 15);
    emitByte(emitter, 182);
    emitByte(emitter, 0);
}

func emitStoreByteIndirect(emitter: Emitter): void {
    emitByte(emitter, 136);
    emitByte(emitter, 8);
}

func emitSyscallInsn(emitter: Emitter): void {
    emitByte(emitter, 15);
    emitByte(emitter, 5);
}

func functionConstantI64(function: IRFunction, valueId: int): int {
    var blockIndex = 0;
    while blockIndex < function.blocks.len() {
        var instructions = function.blocks[blockIndex].instructions;
        var instructionIndex = 0;
        while instructionIndex < instructions.len() {
            var instruction = instructions[instructionIndex];
            if instruction.resultId == valueId && instruction.kind == InstructionKind::ConstI64 { return instruction.immediate; }
            instructionIndex += 1;
        }
        blockIndex += 1;
    }
    return -1;
}

func emitterHasImportFrom(emitter: Emitter, library: string, symbol: string): bool {
    var index = 0;
    while index < emitter.imports.len() {
        if emitter.imports[index].library == library && emitter.imports[index].symbol == symbol { return true; }
        index += 1;
    }
    return false;
}

func emitterHasImport(emitter: Emitter, symbol: string): bool {
    return emitterHasImportFrom(emitter, "kernel32.dll", symbol);
}

func emitWindowsImportCallFrom(emitter: Emitter, library: string, symbol: string): void {
    if !emitterHasImportFrom(emitter, library, symbol) { emitter.imports.push(X64Import { library: library, symbol: symbol }); }
    emitByte(emitter, 255);
    emitByte(emitter, 21);
    var displacement = emitterLength(emitter);
    emitI32(emitter, 0);
    emitter.relocations.push(X64Relocation { offset: displacement, kind: relocationRipDisp32(), symbol: symbol });
}

func emitWindowsImportCall(emitter: Emitter, symbol: string): void {
    emitWindowsImportCallFrom(emitter, "kernel32.dll", symbol);
}

func emitWindowsHostCall(emitter: Emitter, instruction: Instruction, indexes: IdIndex, selector: int): void {
    if instruction.operands.len() != 7 {
        emitter.error = "native x64: windows host call requires six arguments";
        return;
    }
    if selector == 7101 {
        // CreateFileA's final template handle is always null.
        var registers: Vec<int> = [1, 2, 8, 9];
        var index = 0;
        while index < 4 {
            emitLoadValue(emitter, indexes, registers[index], instruction.operands[index + 1]);
            index += 1;
        }
        index = 4;
        while index < 6 {
            emitLoadValue(emitter, indexes, 0, instruction.operands[index + 1]);
            emitStoreRsp(emitter, 0, 32 + (index - 4) * 8);
            index += 1;
        }
        emitMovImmediate(emitter, 0, 0);
        emitStoreRsp(emitter, 0, 48);
        emitWindowsImportCall(emitter, "CreateFileA");
        return;
    }
    if selector == 7102 || selector == 7103 {
        // ReadFile and WriteFile need an output DWORD past their stack arguments.
        emitLoadValue(emitter, indexes, 1, instruction.operands[1]);
        emitLoadValue(emitter, indexes, 2, instruction.operands[2]);
        emitLoadValue(emitter, indexes, 8, instruction.operands[3]);
        emitMovImmediate(emitter, 0, 0);
        emitStoreRsp(emitter, 0, 32);
        emitStoreRsp(emitter, 0, 40);
        emitByte(emitter, 76); emitByte(emitter, 141); emitByte(emitter, 76); emitByte(emitter, 36); emitByte(emitter, 40);
        if selector == 7102 { emitWindowsImportCall(emitter, "ReadFile"); }
        else { emitWindowsImportCall(emitter, "WriteFile"); }
        emitByte(emitter, 133); emitByte(emitter, 192);
        emitByte(emitter, 139); emitByte(emitter, 68); emitByte(emitter, 36); emitByte(emitter, 40);
        emitMovImmediate(emitter, 1, -1);
        emitByte(emitter, 72); emitByte(emitter, 15); emitByte(emitter, 68); emitByte(emitter, 193);
        return;
    }
    if selector == 7104 || selector == 7108 || selector == 7112 || selector == 7113 {
        var symbol = "CloseHandle";
        if selector == 7108 { symbol = "DeleteFileA"; }
        if selector == 7112 { symbol = "FindNextFileA"; }
        if selector == 7113 { symbol = "FindClose"; }
        emitLoadValue(emitter, indexes, 1, instruction.operands[1]);
        if selector == 7112 { emitLoadValue(emitter, indexes, 2, instruction.operands[2]); }
        emitWindowsImportCall(emitter, symbol);
        if selector != 7112 {
            emitByte(emitter, 133); emitByte(emitter, 192);
            emitMovImmediate(emitter, 0, 0);
            emitMovImmediate(emitter, 1, -1);
            emitByte(emitter, 72); emitByte(emitter, 15); emitByte(emitter, 68); emitByte(emitter, 193);
        }
        return;
    }
    if selector == 7105 || selector == 7109 || selector == 7110 {
        var symbol = "GetStdHandle";
        if selector == 7109 { symbol = "GetFileAttributesA"; }
        if selector == 7110 { symbol = "GetFinalPathNameByHandleA"; }
        emitLoadValue(emitter, indexes, 1, instruction.operands[1]);
        if selector == 7110 {
            emitLoadValue(emitter, indexes, 2, instruction.operands[2]);
            emitLoadValue(emitter, indexes, 8, instruction.operands[3]);
            emitLoadValue(emitter, indexes, 9, instruction.operands[4]);
        }
        emitWindowsImportCall(emitter, symbol);
        return;
    }
    if selector == 7106 || selector == 7111 || selector == 7114 {
        var symbol = "ExitProcess";
        if selector == 7111 { symbol = "FindFirstFileA"; }
        if selector == 7114 { symbol = "GetLastError"; }
        if selector == 7106 { emitLoadValue(emitter, indexes, 1, instruction.operands[1]); }
        else if selector == 7111 {
            emitLoadValue(emitter, indexes, 1, instruction.operands[1]);
            emitLoadValue(emitter, indexes, 2, instruction.operands[2]);
        }
        emitWindowsImportCall(emitter, symbol);
        return;
    }
    if selector == 7107 {
        // SetFilePointerEx writes its 64-bit result to a frame scratch cell.
        emitLoadValue(emitter, indexes, 1, instruction.operands[1]);
        emitLoadValue(emitter, indexes, 2, instruction.operands[2]);
        emitMovImmediate(emitter, 0, 0);
        emitStoreRsp(emitter, 0, 40);
        emitByte(emitter, 76); emitByte(emitter, 141); emitByte(emitter, 68); emitByte(emitter, 36); emitByte(emitter, 40);
        emitLoadValue(emitter, indexes, 9, instruction.operands[4]);
        emitWindowsImportCall(emitter, "SetFilePointerEx");
        emitByte(emitter, 133); emitByte(emitter, 192);
        emitByte(emitter, 72); emitByte(emitter, 139); emitByte(emitter, 68); emitByte(emitter, 36); emitByte(emitter, 40);
        emitMovImmediate(emitter, 1, -1);
        emitByte(emitter, 72); emitByte(emitter, 15); emitByte(emitter, 68); emitByte(emitter, 193);
        return;
    }
    if selector == 7115 { emitWindowsImportCall(emitter, "GetCommandLineW"); return; }
    if selector == 7116 {
        emitLoadValue(emitter, indexes, 1, instruction.operands[1]);
        emitLoadValue(emitter, indexes, 2, instruction.operands[2]);
        emitWindowsImportCallFrom(emitter, "shell32.dll", "CommandLineToArgvW");
        return;
    }
    if selector == 7117 {
        emitLoadValue(emitter, indexes, 1, instruction.operands[1]);
        emitWindowsImportCall(emitter, "LocalFree");
        return;
    }
    if selector == 7118 {
        var registers: Vec<int> = [1, 2, 8, 9];
        var index = 0;
        while index < 4 {
            emitLoadValue(emitter, indexes, registers[index], instruction.operands[index + 1]);
            index += 1;
        }
        index = 4;
        while index < 6 {
            emitLoadValue(emitter, indexes, 0, instruction.operands[index + 1]);
            emitStoreRsp(emitter, 0, 32 + (index - 4) * 8);
            index += 1;
        }
        emitMovImmediate(emitter, 0, 0);
        emitStoreRsp(emitter, 0, 48);
        emitStoreRsp(emitter, 0, 56);
        emitWindowsImportCall(emitter, "WideCharToMultiByte");
        return;
    }
    if selector == 7120 {
        emitLoadValue(emitter, indexes, 1, instruction.operands[1]);
        emitMovImmediate(emitter, 2, 0);
        emitMovImmediate(emitter, 8, 32768);
        emitWindowsImportCall(emitter, "VirtualFree");
        return;
    }
    emitter.error = "native x64: unsupported windows host-call selector " + selector.toString();
}

func emitStoreRsp(emitter: Emitter, register: int, displacement: int): void {
    if displacement < 0 || displacement > 2147483647 {
        emitter.error = "native x64: outgoing argument offset is outside the supported frame";
        return;
    }
    emitRex(emitter, true, register, 4);
    emitByte(emitter, 137);
    emitByte(emitter, 132 + (register % 8) * 8);
    emitByte(emitter, 36);
    emitI32(emitter, displacement);
}

func emitMovImmediate(emitter: Emitter, register: int, value: int): void {
    emitRex(emitter, true, 0, register);
    emitByte(emitter, 184 + register % 8);
    emitI64(emitter, value);
}

func emitLoadImmediate32(emitter: Emitter, register: int, value: int): void {
    if register >= 8 {
        emitter.error = "native x64: 32-bit immediate register is unsupported";
        return;
    }
    emitByte(emitter, 184 + register);
    emitU32(emitter, value);
}

func emitJmp(emitter: Emitter, kind: int, targetFunctionId: int, targetBlockId: int, targetOffset: int): void {
    if kind == 0 || kind == 1 || kind == 3 || kind == 9 { emitByte(emitter, 233); }
    else {
        emitByte(emitter, 15);
        if kind == 2 || kind == 6 { emitByte(emitter, 132); }
        else if kind == 4 { emitByte(emitter, 128); }
        else if kind == 5 { emitByte(emitter, 133); }
        else if kind == 7 { emitByte(emitter, 136); }
        else if kind == 8 { emitByte(emitter, 135); }
        else if kind == 10 { emitByte(emitter, 142); }
        else { emitter.error = "native x64: invalid conditional branch kind"; return; }
    }
    var offset = emitterLength(emitter);
    emitI32(emitter, 0);
    emitter.fixups.push(Fixup { offset: offset, kind: kind, targetFunctionId: targetFunctionId, targetBlockId: targetBlockId, targetOffset: targetOffset });
}

func patchRelative(emitter: Emitter, fixup: Fixup, target: int): void {
    if emitter.error != "" { return; }
    var delta = target - (fixup.offset + 4);
    if delta < -2147483648 || delta > 2147483647 {
        emitter.error = "native x64: relative branch target is outside signed rel32 range";
        return;
    }
    if fixup.offset < 0 || fixup.offset > emitterLength(emitter) || emitterLength(emitter) - fixup.offset < 4 {
        emitter.error = "native x64: fixup offset is outside emitted code";
        return;
    }
    var remaining = delta;
    var i = 0;
    loop {
        if i >= 4 { break; }
        var limb = remaining % 256;
        if limb < 0 { limb = limb + 256; }
        if !emitterStoreByte(emitter, fixup.offset + i, limb) { emitter.error = "native x64: fixup patch failed"; return; }
        remaining = (remaining - limb) / 256;
        i = i + 1;
    }
}

func idIndexUseDense(maximumId: int, count: int): bool {
    return maximumId >= 0 && maximumId <= 1048575 && maximumId / 8 < count;
}

func idIndexCreate(maximumId: int, count: int): IdIndex {
    var dense: Vec<int> = [];
    var sparseKeys: Vec<int> = [];
    var sparseValues: Vec<int> = [];
    var isDense = idIndexUseDense(maximumId, count);
    if isDense {
        var i = 0;
        while i <= maximumId { dense.push(-1); i = i + 1; }
    } else {
        var sparseCapacity = 0;
        if count > 0 {
            if count > 4611686018427387903 { sparseCapacity = count; }
            else { sparseCapacity = count * 2 + 1; }
        }
        var i = 0;
        while i < sparseCapacity {
            sparseKeys.push(-1);
            sparseValues.push(-1);
            i = i + 1;
        }
    }
    return IdIndex { dense: dense, sparseKeys: sparseKeys, sparseValues: sparseValues, isDense: isDense, maximumId: maximumId };
}

func idIndexSet(index: IdIndex, id: int, value: int): void {
    if id < 0 { return; }
    if index.isDense {
        if id < index.dense.len() { index.dense.set(id, value); }
    } else {
        var capacity = index.sparseKeys.len();
        if capacity > 0 {
            var slot = id % capacity;
            var probes = 0;
            while probes < capacity {
                var key = index.sparseKeys[slot];
                if key == -1 || key == id {
                    index.sparseKeys.set(slot, id);
                    index.sparseValues.set(slot, value);
                    return;
                }
                slot = slot + 1;
                if slot == capacity { slot = 0; }
                probes = probes + 1;
            }
        }
    }
}

func idIndexGet(index: IdIndex, id: int): int {
    if id < 0 { return -1; }
    if index.isDense {
        if id >= index.dense.len() { return -1; }
        return index.dense[id];
    }
    var capacity = index.sparseKeys.len();
    if capacity > 0 {
        var slot = id % capacity;
        var probes = 0;
        while probes < capacity {
            var key = index.sparseKeys[slot];
            if key == -1 { return -1; }
            if key == id { return index.sparseValues[slot]; }
            slot = slot + 1;
            if slot == capacity { slot = 0; }
            probes = probes + 1;
        }
    }
    return -1;
}

func valueSlotIndexes(slots: Vec<ValueSlot>): IdIndex {
    var maximumId = -1;
    var i = 0;
    while i < slots.len() {
        if slots[i].valueId > maximumId { maximumId = slots[i].valueId; }
        i = i + 1;
    }
    var indexes = idIndexCreate(maximumId, slots.len());
    i = 0;
    while i < slots.len() {
        var slot = slots[i];
        idIndexSet(indexes, slot.valueId, slot.index);
        i = i + 1;
    }
    return indexes;
}

func slotOffset(indexes: IdIndex, valueId: int): int {
    var index = -1;
    if valueId >= 0 {
        if indexes.isDense {
            if valueId < indexes.dense.len() { index = indexes.dense[valueId]; }
        } else { index = idIndexGet(indexes, valueId); }
    }
    if index < 0 { return 2147483647; }
    return (index + 1) * -8;
}

func blockIndexes(blocks: Vec<BasicBlock>): IdIndex {
    var maximumId = -1;
    var i = 0;
    while i < blocks.len() {
        if blocks[i].id > maximumId { maximumId = blocks[i].id; }
        i = i + 1;
    }
    var indexes = idIndexCreate(maximumId, blocks.len());
    i = 0;
    while i < blocks.len() {
        idIndexSet(indexes, blocks[i].id, i);
        i = i + 1;
    }
    return indexes;
}

func blockIndex(indexes: IdIndex, blockId: int): int {
    return idIndexGet(indexes, blockId);
}

func blockOffset(offsets: IdIndex, blockId: int): int {
    return idIndexGet(offsets, blockId);
}

func functionOffsets(functions: Vec<X64FunctionOffset>): IdIndex {
    var maximumId = -1;
    var i = 0;
    while i < functions.len() {
        if functions[i].functionId > maximumId { maximumId = functions[i].functionId; }
        i = i + 1;
    }
    var index = idIndexCreate(maximumId, functions.len());
    i = 0;
    while i < functions.len() {
        var function = functions[i];
        idIndexSet(index, function.functionId, function.offset);
        i = i + 1;
    }
    return index;
}

func appendDefinition(slots: Vec<ValueSlot>, valueId: int): void {
    if valueId >= 0 { slots.push(ValueSlot { valueId: valueId, index: slots.len() }); }
}

func collectSlots(function: IRFunction): Vec<ValueSlot> {
    var slots: Vec<ValueSlot> = Vec.new();
    var i = 0;
    loop {
        if i >= function.parameters.len() { break; }
        appendDefinition(slots, function.parameters[i].id);
        i = i + 1;
    }
    var blockIndex = 0;
    loop {
        if blockIndex >= function.blocks.len() { break; }
        var block = function.blocks[blockIndex];
        var paramIndex = 0;
        loop {
            if paramIndex >= block.params.len() { break; }
            appendDefinition(slots, block.params[paramIndex].id);
            paramIndex = paramIndex + 1;
        }
        var instructionIndex = 0;
        loop {
            if instructionIndex >= block.instructions.len() { break; }
            appendDefinition(slots, block.instructions[instructionIndex].resultId);
            instructionIndex = instructionIndex + 1;
        }
        blockIndex = blockIndex + 1;
    }
    return slots;
}

func maxEdgeParams(function: IRFunction): int {
    var maximum = 0;
    var i = 0;
    loop {
        if i >= function.blocks.len() { break; }
        if function.blocks[i].params.len() > maximum { maximum = function.blocks[i].params.len(); }
        i = i + 1;
    }
    return maximum;
}

func maxCallArguments(function: IRFunction, windows: bool): int {
    var maximum = 0;
    var b = 0;
    loop {
        if b >= function.blocks.len() { break; }
        var n = 0;
        loop {
            if n >= function.blocks[b].instructions.len() { break; }
            var instruction = function.blocks[b].instructions[n];
            if instruction.kind == InstructionKind::Call && instruction.operands.len() > maximum { maximum = instruction.operands.len(); }
            else if windows && instruction.kind == InstructionKind::RawHostSyscall {
                var selector = functionConstantI64(function, instruction.operands[0]);
                var apiArguments = windowsHostCallArgumentCount(selector);
                if apiArguments > maximum { maximum = apiArguments; }
            }
            n = n + 1;
        }
        b = b + 1;
    }
    return maximum;
}

func emitLoadValue(emitter: Emitter, indexes: IdIndex, register: int, valueId: int): void {
    var location = -1;
    if valueId >= 0 {
        if indexes.isDense {
            if valueId < indexes.dense.len() { location = indexes.dense[valueId]; }
        } else { location = idIndexGet(indexes, valueId); }
    }
    if valueId >= 0 && location <= -2 {
        emitMoveRegister(emitter, register, -2 - location);
        return;
    }
    var offset = slotOffset(indexes, valueId);
    if offset == 2147483647 { emitter.error = "native x64: SSA value has no stack slot"; return; }
    emitLoad(emitter, register, offset);
}

func emitStoreValue(emitter: Emitter, indexes: IdIndex, register: int, valueId: int): void {
    var location = -1;
    if valueId >= 0 {
        if indexes.isDense {
            if valueId < indexes.dense.len() { location = indexes.dense[valueId]; }
        } else { location = idIndexGet(indexes, valueId); }
    }
    if valueId >= 0 && location <= -2 {
        emitMoveRegister(emitter, -2 - location, register);
        return;
    }
    var offset = slotOffset(indexes, valueId);
    if offset == 2147483647 { emitter.error = "native x64: SSA result has no stack slot"; return; }
    emitStore(emitter, register, offset);
}

func emitEdgeCopy(emitter: Emitter, indexes: IdIndex, scratchStart: int, target: BasicBlock, arguments: Vec<int>): void {
    var i = 0;
    loop {
        if i >= arguments.len() { break; }
        emitLoadValue(emitter, indexes, 0, arguments[i]);
        emitStore(emitter, 0, (scratchStart + i + 1) * -8);
        i = i + 1;
    }
    i = 0;
    loop {
        if i >= target.params.len() { break; }
        emitLoad(emitter, 0, (scratchStart + i + 1) * -8);
        emitStoreValue(emitter, indexes, 0, target.params[i].id);
        i = i + 1;
    }
}

func emitFirstOperand(emitter: Emitter, indexes: IdIndex, valueId: int, cachedValueId: int): void {
    if valueId != cachedValueId { emitLoadValue(emitter, indexes, 0, valueId); return; }
    var location = -1;
    if valueId >= 0 {
        if indexes.isDense {
            if valueId < indexes.dense.len() { location = indexes.dense[valueId]; }
        } else { location = idIndexGet(indexes, valueId); }
    }
    if location <= -2 { return; }
    if slotOffset(indexes, valueId) == 2147483647 { emitter.error = "native x64: SSA value has no stack slot"; }
}

func emitSecondOperand(emitter: Emitter, indexes: IdIndex, valueId: int, cachedValueId: int): void {
    if valueId != cachedValueId { emitLoadValue(emitter, indexes, 1, valueId); return; }
    var location = -1;
    if valueId >= 0 {
        if indexes.isDense {
            if valueId < indexes.dense.len() { location = indexes.dense[valueId]; }
        } else { location = idIndexGet(indexes, valueId); }
    }
    if location <= -2 { return; }
    if slotOffset(indexes, valueId) == 2147483647 { emitter.error = "native x64: SSA value has no stack slot"; }
}

func keepsResultInRax(instruction: Instruction): bool {
    if instruction.resultId < 0 { return false; }
    var kind = instruction.kind;
    if kind == InstructionKind::Call || kind == InstructionKind::RawNull || kind == InstructionKind::RawMap || kind == InstructionKind::RawOffset || kind == InstructionKind::RawLoadI64 || kind == InstructionKind::RawLoadByte || kind == InstructionKind::RawEqual || kind == InstructionKind::RawLoadAddress || kind == InstructionKind::RawFromInt || kind == InstructionKind::RawToInt || kind == InstructionKind::RawSyscall || kind == InstructionKind::RawHostSyscall || kind == InstructionKind::RawArgCount || kind == InstructionKind::RawArg { return true; }
    return kind == InstructionKind::ConstI64 || kind == InstructionKind::ConstBool || kind == InstructionKind::AddCheckedI64 || kind == InstructionKind::SubCheckedI64 || kind == InstructionKind::MulCheckedI64 || kind == InstructionKind::DivCheckedI64 || kind == InstructionKind::RemCheckedI64 || kind == InstructionKind::CompareI64 || kind == InstructionKind::CompareBool;
}

func instructionSetsRcx(instruction: Instruction): bool {
    var kind = instruction.kind;
    return kind == InstructionKind::AddCheckedI64 || kind == InstructionKind::SubCheckedI64 || kind == InstructionKind::MulCheckedI64 || kind == InstructionKind::DivCheckedI64 || kind == InstructionKind::RemCheckedI64 || kind == InstructionKind::CompareI64 || kind == InstructionKind::CompareBool || kind == InstructionKind::RawOffset || kind == InstructionKind::RawEqual || kind == InstructionKind::RawStoreI64 || kind == InstructionKind::RawStoreByte || kind == InstructionKind::RawStoreAddress;
}

func instructionPreservesRcx(instruction: Instruction): bool {
    var kind = instruction.kind;
    return kind == InstructionKind::ConstI64 || kind == InstructionKind::ConstBool || kind == InstructionKind::RawNull || kind == InstructionKind::RawLoadI64 || kind == InstructionKind::RawLoadByte || kind == InstructionKind::RawLoadAddress || kind == InstructionKind::RawFromInt || kind == InstructionKind::RawToInt || kind == InstructionKind::RawArgCount || kind == InstructionKind::RawArg;
}

func emitInstruction(emitter: Emitter, instruction: Instruction, indexes: IdIndex, overflowOffset: int, cachedRaxValueId: int, cachedRcxValueId: int, windowsSelector: int): void {
    if instruction.kind == InstructionKind::ConstI64 || instruction.kind == InstructionKind::ConstBool {
        var value = instruction.immediate;
        emitMovImmediate(emitter, 0, value);
        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::AddCheckedI64 || instruction.kind == InstructionKind::SubCheckedI64 {
        emitFirstOperand(emitter, indexes, instruction.operands[0], cachedRaxValueId);
        emitSecondOperand(emitter, indexes, instruction.operands[1], cachedRcxValueId);
        if instruction.kind == InstructionKind::AddCheckedI64 { emitByte(emitter, 72); emitByte(emitter, 1); emitByte(emitter, 200); }
        else { emitByte(emitter, 72); emitByte(emitter, 41); emitByte(emitter, 200); }
        emitJmp(emitter, 4, -1, -1, overflowOffset);
        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::MulCheckedI64 {
        emitFirstOperand(emitter, indexes, instruction.operands[0], cachedRaxValueId);
        emitSecondOperand(emitter, indexes, instruction.operands[1], cachedRcxValueId);
        emitByte(emitter, 72); emitByte(emitter, 247); emitByte(emitter, 233);
        emitByte(emitter, 73); emitByte(emitter, 137); emitByte(emitter, 194);
        emitByte(emitter, 73); emitByte(emitter, 193); emitByte(emitter, 250); emitByte(emitter, 63);
        emitByte(emitter, 76); emitByte(emitter, 57); emitByte(emitter, 210);
        emitJmp(emitter, 5, -1, -1, overflowOffset);
        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::DivCheckedI64 || instruction.kind == InstructionKind::RemCheckedI64 {
        emitFirstOperand(emitter, indexes, instruction.operands[0], cachedRaxValueId);
        emitSecondOperand(emitter, indexes, instruction.operands[1], cachedRcxValueId);
        emitByte(emitter, 72); emitByte(emitter, 133); emitByte(emitter, 201);
        emitJmp(emitter, 6, -1, -1, overflowOffset);
        emitMovImmediate(emitter, 10, -9223372036854775807 - 1);
        emitByte(emitter, 76); emitByte(emitter, 57); emitByte(emitter, 208);
