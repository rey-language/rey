        emitTrapIfSign(emitter, 0, overflowOffset);
        emitByte(emitter, 72); emitByte(emitter, 193); emitByte(emitter, 224); emitByte(emitter, 3);
        emitRex(emitter, true, 0, 13);
        emitByte(emitter, 3);
        emitByte(emitter, 197);
        emitLoadIndirect(emitter);
