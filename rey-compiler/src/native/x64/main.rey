        emitRex(emitter, true, 12, 0);
        emitByte(emitter, 137);
        emitByte(emitter, 224);
        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::RawArg {
        if emitter.os == "windows" {
            emitter.error = "native x64: raw.argument is unavailable on windows-x64";
            return;
        }
