    }
    if instruction.kind == InstructionKind::RawNull {
        emitMovImmediate(emitter, 0, 0);
        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::RawFromInt || instruction.kind == InstructionKind::RawToInt {
        emitFirstOperand(emitter, indexes, instruction.operands[0], cachedRaxValueId);
        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::RawEqual {
        emitFirstOperand(emitter, indexes, instruction.operands[0], cachedRaxValueId);
        emitSecondOperand(emitter, indexes, instruction.operands[1], cachedRcxValueId);
        emitByte(emitter, 72); emitByte(emitter, 57); emitByte(emitter, 200);
        emitByte(emitter, 15); emitByte(emitter, 148); emitByte(emitter, 192);
        emitByte(emitter, 15); emitByte(emitter, 182); emitByte(emitter, 192);
        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::RawOffset {
        emitFirstOperand(emitter, indexes, instruction.operands[0], cachedRaxValueId);
        emitSecondOperand(emitter, indexes, instruction.operands[1], cachedRcxValueId);
        emitTrapIfNonPositive(emitter, 0, overflowOffset);
        emitTrapIfSign(emitter, 1, overflowOffset);
        emitAddRegs(emitter, 0, 1);
        emitJmp(emitter, 4, -1, -1, overflowOffset);
        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::RawLoadI64 || instruction.kind == InstructionKind::RawLoadAddress || instruction.kind == InstructionKind::RawLoadByte {
        emitFirstOperand(emitter, indexes, instruction.operands[0], cachedRaxValueId);
        emitAddressCheck(emitter, 0, instruction.kind == InstructionKind::RawLoadI64 || instruction.kind == InstructionKind::RawLoadAddress, overflowOffset);
        if instruction.kind == InstructionKind::RawLoadByte { emitLoadByteIndirect(emitter); }
        else { emitLoadIndirect(emitter); }
        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::RawStoreI64 || instruction.kind == InstructionKind::RawStoreAddress || instruction.kind == InstructionKind::RawStoreByte {
        emitFirstOperand(emitter, indexes, instruction.operands[0], cachedRaxValueId);
        emitSecondOperand(emitter, indexes, instruction.operands[1], cachedRcxValueId);
        emitAddressCheck(emitter, 0, instruction.kind == InstructionKind::RawStoreI64 || instruction.kind == InstructionKind::RawStoreAddress, overflowOffset);
        if instruction.kind == InstructionKind::RawStoreByte {
            emitMovImmediate(emitter, 2, 255);
            emitRex(emitter, true, 2, 1);
            emitByte(emitter, 57);
            emitByte(emitter, 209);
            emitJmp(emitter, 8, -1, -1, overflowOffset);
            emitStoreByteIndirect(emitter);
        } else {
            emitStoreIndirectRcx(emitter);
        }
        return;
    }
    if instruction.kind == InstructionKind::RawMap {
        if emitter.os == "windows" {
            emitLoadValue(emitter, indexes, 2, instruction.operands[0]);
            emitTrapIfZero(emitter, 2, overflowOffset);
            emitTrapIfSign(emitter, 2, overflowOffset);
            emitMovImmediate(emitter, 1, 0);
            emitLoadValue(emitter, indexes, 2, instruction.operands[0]);
            emitMovImmediate(emitter, 8, 12288);
            emitMovImmediate(emitter, 9, 4);
            emitWindowsImportCall(emitter, "VirtualAlloc");
            emitTrapIfZero(emitter, 0, overflowOffset);
            emitTrapIfSign(emitter, 0, overflowOffset);
            emitStoreValue(emitter, indexes, 0, instruction.resultId);
            return;
        }
        emitLoadValue(emitter, indexes, 6, instruction.operands[0]);
        emitTrapIfZero(emitter, 6, overflowOffset);
        emitTrapIfSign(emitter, 6, overflowOffset);
        emitMovImmediate(emitter, 7, 0);
        emitMovImmediate(emitter, 2, 3);
        if emitter.os == "darwin" { emitMovImmediate(emitter, 10, 4098); }
        else { emitMovImmediate(emitter, 10, 34); }
        emitMovImmediate(emitter, 8, -1);
        emitMovImmediate(emitter, 9, 0);
        var mapNumber = 9;
        if emitter.os == "darwin" { mapNumber = 33554629; }
        emitMovImmediate(emitter, 0, mapNumber);
        emitSyscallInsn(emitter);
        emitTrapIfZero(emitter, 0, overflowOffset);
        emitTrapIfSign(emitter, 0, overflowOffset);
        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::RawUnmap {
        if emitter.os == "windows" {
            emitLoadValue(emitter, indexes, 1, instruction.operands[0]);
            emitLoadValue(emitter, indexes, 2, instruction.operands[1]);
            emitTrapIfZero(emitter, 1, overflowOffset);
            emitTrapIfZero(emitter, 2, overflowOffset);
            emitTrapIfSign(emitter, 2, overflowOffset);
            emitLoadValue(emitter, indexes, 1, instruction.operands[0]);
            emitMovImmediate(emitter, 2, 0);
            emitMovImmediate(emitter, 8, 32768);
            emitWindowsImportCall(emitter, "VirtualFree");
            emitByte(emitter, 133); emitByte(emitter, 192);
            emitMovImmediate(emitter, 0, 0);
            emitMovImmediate(emitter, 1, -1);
            emitByte(emitter, 72); emitByte(emitter, 15); emitByte(emitter, 68); emitByte(emitter, 193);
            emitByte(emitter, 72); emitByte(emitter, 133); emitByte(emitter, 192);
            emitJmp(emitter, 5, -1, -1, overflowOffset);
            return;
        }
        emitLoadValue(emitter, indexes, 7, instruction.operands[0]);
        emitLoadValue(emitter, indexes, 6, instruction.operands[1]);
        emitTrapIfZero(emitter, 7, overflowOffset);
        emitTrapIfZero(emitter, 6, overflowOffset);
        emitTrapIfSign(emitter, 6, overflowOffset);
        var unmapNumber = 11;
        if emitter.os == "darwin" { unmapNumber = 33554505; }
        emitMovImmediate(emitter, 0, unmapNumber);
