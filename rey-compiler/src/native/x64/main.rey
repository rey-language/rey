            if instruction.resultId >= 0 { emitStoreValue(emitter, indexes, 0, instruction.resultId); }
            return;
        }
        var syscallArgument = 1;
        var syscallRegisters: Vec<int> = [7, 6, 2, 10, 8, 9];
        loop {
            if syscallArgument >= instruction.operands.len() || syscallArgument > 6 { break; }
            emitLoadValue(emitter, indexes, syscallRegisters[syscallArgument - 1], instruction.operands[syscallArgument]);
            syscallArgument = syscallArgument + 1;
        }
        emitFirstOperand(emitter, indexes, instruction.operands[0], cachedRaxValueId);
        emitSyscallInsn(emitter);
        if instruction.kind == InstructionKind::RawHostSyscall && emitter.os == "darwin" {
