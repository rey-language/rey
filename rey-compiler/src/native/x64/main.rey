        emitStoreValue(emitter, indexes, 0, instruction.resultId);
        return;
    }
    if instruction.kind == InstructionKind::RawFail {
        emitJmp(emitter, 9, -1, -1, overflowOffset);
        return;
    }
    emitter.error = "native x64: unsupported scalar instruction";
}

func emitTerminator(emitter: Emitter, function: IRFunction, indexes: IdIndex, blocksById: IdIndex, block: BasicBlock, scratchStart: int): void {
    var terminator = block.terminator;
    if terminator.kind == TerminatorKind::Jump {
        var targetIndex = blockIndex(blocksById, terminator.targetBlockId);
        var target = function.blocks[targetIndex];
        emitEdgeCopy(emitter, indexes, scratchStart, target, terminator.targetArgs);
        emitJmp(emitter, 0, -1, terminator.targetBlockId, -1);
        return;
    }
    if terminator.kind == TerminatorKind::Branch {
        emitLoadValue(emitter, indexes, 0, terminator.conditionValueId);
        emitByte(emitter, 72); emitByte(emitter, 133); emitByte(emitter, 192);
        emitJmp(emitter, 2, -1, -1, -1);
        var conditionalFixupIndex = emitter.fixups.len() - 1;
        var trueIndex = blockIndex(blocksById, terminator.trueTargetBlockId);
        var trueBlock = function.blocks[trueIndex];
        emitEdgeCopy(emitter, indexes, scratchStart, trueBlock, terminator.trueArgs);
        emitJmp(emitter, 0, -1, terminator.trueTargetBlockId, -1);
        var falseOffset = emitterLength(emitter);
        var conditionalFixup = emitter.fixups[conditionalFixupIndex];
        conditionalFixup.targetOffset = falseOffset;
        emitter.fixups.set(conditionalFixupIndex, conditionalFixup);
        var falseIndex = blockIndex(blocksById, terminator.falseTargetBlockId);
        var falseBlock = function.blocks[falseIndex];
        emitEdgeCopy(emitter, indexes, scratchStart, falseBlock, terminator.falseArgs);
        emitJmp(emitter, 0, -1, terminator.falseTargetBlockId, -1);
        return;
    }
    if terminator.kind == TerminatorKind::Return {
        if terminator.valueId >= 0 { emitLoadValue(emitter, indexes, 0, terminator.valueId); }
        emitJmp(emitter, 1, -1, -1, -1);
        return;
    }
    emitter.error = "native x64: unsupported scalar terminator";
}

func resolveLocalFixups(emitter: Emitter, fixupStart: int, fixupFinish: int, blockOffsets: IdIndex, epilogueOffset: int): void {
    var i = fixupStart;
    loop {
        if i >= fixupFinish { break; }
        var fixup = emitter.fixups[i];
        if fixup.kind == 0 || fixup.kind == 1 || fixup.kind == 2 {
            var target = fixup.targetOffset;
            if fixup.kind == 0 { target = blockOffset(blockOffsets, fixup.targetBlockId); }
            if fixup.kind == 1 { target = epilogueOffset; }
            if target < 0 { emitter.error = "native x64: unresolved local control-flow target"; return; }
            patchRelative(emitter, fixup, target);
        }
        i = i + 1;
    }
}

func emitFunction(emitter: Emitter, function: IRFunction, overflowOffset: int, layout: FunctionSlots, reuse: bool, registers: FunctionRegisterPlan): void {
    if function.parameters.len() > 16 {
        emitter.error = "native x64: functions with more than sixteen scalar arguments are unsupported";
        return;
    }
    var slots = collectSlots(function);
    var slotCount = slots.len();
    if reuse {
        slots = [];
        var slotIndex = 0;
        while slotIndex < layout.values.len() {
            slots.push(ValueSlot { valueId: layout.values[slotIndex].valueId, index: layout.values[slotIndex].index });
            slotIndex = slotIndex + 1;
        }
        slotCount = layout.slotCount;
    }
    if registers.functionId == function.id {
        slots = [];
        var valueAt = 0;
        while valueAt < registers.locations.len() {
            var value = registers.locations[valueAt];
            var location = value.location.index;
            if value.location.kind == RegisterLocationKind::Register { location = -2 - location; }
            slots.push(ValueSlot { valueId: value.valueId, index: location });
            valueAt = valueAt + 1;
        }
        slotCount = registers.spillCount;
    }
    var slotIndexes = valueSlotIndexes(slots);
    var blocksById = blockIndexes(function.blocks);
    var blockOffsets = idIndexCreate(blocksById.maximumId, function.blocks.len());
    var fixupStart = emitter.fixups.len();
    var scratchCount = maxEdgeParams(function);
    var outgoingBytes = 16;
    var registerCount = 6;
    var incomingBase = 16;
    if emitter.convention == "win64" {
        outgoingBytes = 32;
        registerCount = 4;
        incomingBase = 48;
    }
    var requiredOutgoingBytes = (maxCallArguments(function, emitter.convention == "win64") - registerCount) * 8;
    if emitter.convention == "win64" {
        if requiredOutgoingBytes < 0 { requiredOutgoingBytes = 0; }
        requiredOutgoingBytes = requiredOutgoingBytes + 32;
    }
    if requiredOutgoingBytes > outgoingBytes { outgoingBytes = requiredOutgoingBytes; }
    var savedCount = 0;
    if registers.functionId == function.id { savedCount = registers.savedRegisters.len(); }
    var rawFrame = slotCount * 8 + scratchCount * 8 + savedCount * 8 + outgoingBytes;
    if rawFrame > 1048576 {
        emitter.error = "native x64: stack frame exceeds the supported 1048576-byte limit";
        return;
    }
    var frameSize = rawFrame;
    if frameSize % 16 != 0 { frameSize = frameSize + (16 - frameSize % 16); }
    if emitter.convention == "win64" && frameSize > 65520 {
        emitter.error = "native x64: windows frame exceeds the PE unwind limit";
        return;
    }
    var start = emitterLength(emitter);
    emitter.functions.push(X64FunctionOffset { functionId: function.id, offset: start });
    emitter.frames.push(X64Frame { functionId: function.id, offset: start, frameBytes: frameSize });
    if frameSize > emitter.maxFrame { emitter.maxFrame = frameSize; }
    emitByte(emitter, 85);
    emitByte(emitter, 72); emitByte(emitter, 137); emitByte(emitter, 229);
    emitByte(emitter, 72); emitByte(emitter, 129); emitByte(emitter, 236); emitU32(emitter, frameSize);
    var savedAt = 0;
    while savedAt < savedCount {
        emitStore(emitter, registers.savedRegisters[savedAt], (slotCount + scratchCount + savedAt + 1) * -8);
        savedAt = savedAt + 1;
    }
    var argumentRegisters: Vec<int> = [7, 6, 2, 1, 8, 9];
    if emitter.convention == "win64" { argumentRegisters = [1, 2, 8, 9]; }
    var parameterIndex = 0;
    loop {
        if parameterIndex >= function.parameters.len() { break; }
        var parameter = function.parameters[parameterIndex];
        if parameterIndex < registerCount { emitStoreValue(emitter, slotIndexes, argumentRegisters[parameterIndex], parameter.id); }
        else {
            emitLoadPositive(emitter, 0, incomingBase + (parameterIndex - registerCount) * 8);
            emitStoreValue(emitter, slotIndexes, 0, parameter.id);
        }
        parameterIndex = parameterIndex + 1;
    }
    var scratchStart = slotCount;
    var blockIndex = 0;
    loop {
        if blockIndex >= function.blocks.len() { break; }
        var block = function.blocks[blockIndex];
        idIndexSet(blockOffsets, block.id, emitterLength(emitter));
        var instructionIndex = 0;
        var cachedRaxValueId = -1;
        var cachedRcxValueId = -1;
        loop {
            if instructionIndex >= block.instructions.len() { break; }
            var instruction = block.instructions[instructionIndex];
            var windowsSelector = -1;
            if instruction.kind == InstructionKind::RawHostSyscall { windowsSelector = functionConstantI64(function, instruction.operands[0]); }
            emitInstruction(emitter, instruction, slotIndexes, overflowOffset, cachedRaxValueId, cachedRcxValueId, windowsSelector);
            cachedRaxValueId = -1;
            if keepsResultInRax(instruction) { cachedRaxValueId = instruction.resultId; }
            if instructionSetsRcx(instruction) && instruction.operands.len() > 1 { cachedRcxValueId = instruction.operands[1]; }
            else if !instructionPreservesRcx(instruction) { cachedRcxValueId = -1; }
            instructionIndex = instructionIndex + 1;
        }
        emitTerminator(emitter, function, slotIndexes, blocksById, block, scratchStart);
        blockIndex = blockIndex + 1;
    }
    var epilogueOffset = emitterLength(emitter);
    savedAt = 0;
    while savedAt < savedCount {
        emitLoad(emitter, registers.savedRegisters[savedAt], (slotCount + scratchCount + savedAt + 1) * -8);
        savedAt = savedAt + 1;
    }
    emitByte(emitter, 201);
    emitByte(emitter, 195);
    resolveLocalFixups(emitter, fixupStart, emitter.fixups.len(), blockOffsets, epilogueOffset);
}

func programUsesRawArgs(program: IRProgram): bool {
    var i = 0;
    loop {
        if i >= program.functions.len() { break; }
        var b = 0;
        loop {
            if b >= program.functions[i].blocks.len() { break; }
            var n = 0;
            loop {
                if n >= program.functions[i].blocks[b].instructions.len() { break; }
                var kind = program.functions[i].blocks[b].instructions[n].kind;
                if kind == InstructionKind::RawArg || kind == InstructionKind::RawArgCount { return true; }
                n = n + 1;
            }
            b = b + 1;
        }
        i = i + 1;
    }
    return false;
}

func appendEntryStub(emitter: Emitter, entryFunction: IRFunction, exitNumber: int, captureArgs: bool): void {
    if captureArgs && emitter.convention != "win64" {
        emitRex(emitter, true, 12, 4);
        emitByte(emitter, 139);
        emitByte(emitter, 36);
        emitByte(emitter, 36);
        emitRex(emitter, true, 13, 4);
        emitByte(emitter, 141);
        emitByte(emitter, 108);
        emitByte(emitter, 36);
        emitByte(emitter, 8);
    }
    if emitter.convention == "win64" {
        // Loader enters at 8 mod 16. 40 bytes leaves rsp 0 mod 16 and reserves the 32-byte shadow.
        emitByte(emitter, 72); emitByte(emitter, 131); emitByte(emitter, 236); emitByte(emitter, 40);
    }
    emitByte(emitter, 232);
    var callOffset = emitterLength(emitter);
    emitI32(emitter, 0);
    emitter.fixups.push(Fixup { offset: callOffset, kind: 3, targetFunctionId: entryFunction.id, targetBlockId: -1, targetOffset: -1 });
    if emitter.convention == "win64" {
        if entryFunction.signature.returnType.kind == IRTypeKind::Void {
            emitByte(emitter, 49); emitByte(emitter, 201);
        } else {
            emitByte(emitter, 137); emitByte(emitter, 193);
        }
        emitByte(emitter, 255); emitByte(emitter, 21);
        var dispAt = emitterLength(emitter);
        emitI32(emitter, 0);
        emitter.relocations.push(X64Relocation { offset: dispAt, kind: relocationRipDisp32(), symbol: "ExitProcess" });
        return;
    }
    if entryFunction.signature.returnType.kind == IRTypeKind::Void {
        emitByte(emitter, 49); emitByte(emitter, 255);
    } else {
        emitByte(emitter, 137); emitByte(emitter, 199);
    }
    emitLoadImmediate32(emitter, 0, exitNumber);
    emitByte(emitter, 15); emitByte(emitter, 5);
}

func canonicalTarget(target: string): string {
    if target == "macos-x64" { return "darwin-x64"; }
    return target;
}

func emitEmitterInternal(program: IRProgram, target: string, reuse: bool, packedOutput: bool): Result<Emitter, string> {
    var canonical = canonicalTarget(target);
    var convention = "";
    if canonical == "linux-x64" || canonical == "darwin-x64" { convention = "sysv"; }
    if canonical == "windows-x64" { convention = "win64"; }
    if convention == "" { return Result.Err("native x64: target must be linux-x64, darwin-x64, or windows-x64"); }
    if packedOutput && canonical != "linux-x64" { return Result.Err("native x64: packed emission requires linux-x64"); }
    var entryIndex = 0;
    loop {
        if entryIndex >= program.functions.len() { break; }
        if program.functions[entryIndex].id == program.entryFunctionId { break; }
        entryIndex = entryIndex + 1;
    }
    if entryIndex >= program.functions.len() { return Result.Err("native x64: entry function is missing"); }
    var entryFunction = program.functions[entryIndex];
    if entryFunction.parameters.len() != 0 { return Result.Err("native x64: program entry function must have zero scalar arguments"); }
    var i = 0;
    loop {
        if i >= program.functions.len() { break; }
        if program.functions[i].parameters.len() > 16 { return Result.Err("native x64: functions with more than sixteen scalar arguments are unsupported"); }
        var b = 0;
        loop {
            if b >= program.functions[i].blocks.len() { break; }
            var n = 0;
            loop {
                if n >= program.functions[i].blocks[b].instructions.len() { break; }
                var instruction = program.functions[i].blocks[b].instructions[n];
                if instruction.kind == InstructionKind::Call && instruction.operands.len() > 16 {
                    return Result.Err("native x64: calls with more than sixteen scalar arguments are unsupported");
                }
                n = n + 1;
            }
            b = b + 1;
        }
        i = i + 1;
    }
    var planned = ProgramSlots { functions: [] };
    var registerPlan = ProgramRegisterPlan { functions: [] };
    if reuse {
        var result = planSlots(program);
        if result.isErr() { return Result.Err("native x64: " + result.unwrapErr()); }
        planned = result.unwrap();
        if planned.functions.len() != program.functions.len() { return Result.Err("native x64: incomplete storage plan"); }
        if canonical == "linux-x64" {
            var allocated = planRegistersFromSlots(program, planned, true);
            if allocated.isOk() { registerPlan = allocated.unwrap(); }
        }
    }
    var noneRelocations: Vec<X64Relocation> = Vec.new();
    var noneImports: Vec<X64Import> = Vec.new();
    var noneFrames: Vec<X64Frame> = Vec.new();
    var os = "linux";
    if canonical == "darwin-x64" { os = "darwin"; }
    if canonical == "windows-x64" { os = "windows"; }
    var packedBytes: PackedBuffer? = null;
    if packedOutput {
        var created = packedBufferCreate(0);
        if created.isErr() { return Result.Err("native x64: " + created.unwrapErr()); }
        packedBytes = created.unwrap();
    }
    var emitter = Emitter { bytes: Vec.new(), packedBytes: packedBytes, functions: Vec.new(), fixups: Vec.new(), error: "", convention: convention, os: os, relocations: noneRelocations, imports: noneImports, frames: noneFrames, maxFrame: 0 };
    var exitNumber = 60;
    if canonical == "darwin-x64" { exitNumber = 33554433; }
    if convention == "win64" {
        emitter.frames.push(X64Frame { functionId: -1, offset: emitterLength(emitter), frameBytes: -1 });
    }
    eprintln("phase: x64 emit started functions=" + program.functions.len().toString());
    appendEntryStub(emitter, entryFunction, exitNumber, programUsesRawArgs(program));
    if emitter.error != "" { return Result.Err(emitter.error); }
    var overflowOffset = -1;
    i = 0;
    loop {
        if i >= program.functions.len() { break; }
        var layout = FunctionSlots { functionId: -1, values: [], slotCount: 0 };
        if reuse {
            layout = planned.functions[i];
            if layout.functionId != program.functions[i].id { return Result.Err("native x64: storage function order mismatch"); }
        }
        var registers = FunctionRegisterPlan { functionId: -1, locations: [], savedRegisters: [], spillCount: 0, rawArgumentsReserved: false, edges: [] };
        if registerPlan.functions.len() == program.functions.len() { registers = registerPlan.functions[i]; }
        emitFunction(emitter, program.functions[i], -1, layout, reuse, registers);
        if emitter.error != "" { return Result.Err(emitter.error); }
        i = i + 1;
    }
    eprintln("phase: x64 functions emitted bytes=" + emitterLength(emitter).toString() + " fixups=" + emitter.fixups.len().toString());
    overflowOffset = emitterLength(emitter);
    if convention == "win64" {
        emitLoadImmediate32(emitter, 1, 1);
        emitByte(emitter, 255); emitByte(emitter, 21);
        var overflowDisp = emitterLength(emitter);
        emitI32(emitter, 0);
        emitter.relocations.push(X64Relocation { offset: overflowDisp, kind: relocationRipDisp32(), symbol: "ExitProcess" });
    } else {
        emitLoadImmediate32(emitter, 7, 1);
        emitLoadImmediate32(emitter, 0, exitNumber);
        emitByte(emitter, 15); emitByte(emitter, 5);
    }
    if emitter.error != "" { return Result.Err(emitter.error); }
    eprintln("phase: x64 patching " + emitter.fixups.len().toString() + " fixups overflow=" + overflowOffset.toString());
    var offsetsByFunctionId = functionOffsets(emitter.functions);
    i = 0;
    loop {
        if i >= emitter.fixups.len() { break; }
        var fixup = emitter.fixups[i];
        if fixup.kind == 3 {
            var targetOffset = idIndexGet(offsetsByFunctionId, fixup.targetFunctionId);
            if targetOffset < 0 { return Result.Err("native x64: unresolved function call target"); }
            patchRelative(emitter, fixup, targetOffset);
        } else if fixup.kind == 2 || fixup.kind == 4 || fixup.kind == 5 || fixup.kind == 6 || fixup.kind == 7 || fixup.kind == 8 || fixup.kind == 9 || fixup.kind == 10 {
            var targetOffset = fixup.targetOffset;
            if targetOffset < 0 && (fixup.kind == 4 || fixup.kind == 5 || fixup.kind == 6 || fixup.kind == 7 || fixup.kind == 8 || fixup.kind == 9 || fixup.kind == 10) { targetOffset = overflowOffset; }
            if targetOffset < 0 { return Result.Err("native x64: unresolved overflow branch target"); }
            patchRelative(emitter, fixup, targetOffset);
        }
        if emitter.error != "" { return Result.Err(emitter.error); }
        i = i + 1;
    }
    eprintln("phase: x64 patches done");
    return Result.Ok(emitter);
}

func emitImageVerifiedInternal(program: IRProgram, target: string, reuse: bool): Result<X64Image, string> {
    var emitted = emitEmitterInternal(program, target, reuse, false);
    if emitted.isErr() { return Result.Err(emitted.unwrapErr()); }
    var emitter = emitted.unwrap();
    var canonical = canonicalTarget(target);
    var convention = "sysv";
    if canonical == "windows-x64" { convention = "win64"; }
    var imports = emitter.imports;
    var stackMetadata = "sysv;frame-pointer;red-zone-unused;exit-syscall=60";
    if canonical == "windows-x64" {
        if !emitterHasImport(emitter, "ExitProcess") { imports.push(X64Import { library: "kernel32.dll", symbol: "ExitProcess" }); }
        stackMetadata = "win64;frame-pointer;shadow=32;exit-import=kernel32.dll!ExitProcess";
    } else if canonical == "darwin-x64" {
        stackMetadata = "sysv;frame-pointer;red-zone-unused;exit-syscall=33554433;loader=dyld;dylib=libSystem";
    }
    return Result.Ok(X64Image {
        code: X64Code { bytes: emitter.bytes, entryOffset: 0, functions: emitter.functions },
        target: canonical,
        convention: convention,
        relocations: emitter.relocations,
        imports: imports,
        frames: emitter.frames,
        maxFrameBytes: emitter.maxFrame,
        stackMetadata: stackMetadata,
    });
}

func emitImageInternal(program: IRProgram, target: string, reuse: bool): Result<X64Image, string> {
    var canonical = canonicalTarget(target);
    var convention = "";
    if canonical == "linux-x64" || canonical == "darwin-x64" { convention = "sysv"; }
    if canonical == "windows-x64" { convention = "win64"; }
    if convention == "" { return Result.Err("native x64: target must be linux-x64, darwin-x64, or windows-x64"); }
    var verification = verifyProgram(program);
    if !verification.ok {
        if verification.errors.len() > 0 { return Result.Err("native x64: invalid IR: " + verification.errors[0]); }
        return Result.Err("native x64: invalid IR program");
    }
    return emitImageVerifiedInternal(program, target, reuse);
}

func emitProgramInternal(program: IRProgram, target: string, reuse: bool, verified: bool): Result<X64Code, string> {
    if target != "linux-x64" { return Result.Err("native x64: target must be linux-x64"); }
    var image: Result<X64Image, string> = Result.Err("not emitted");
    if verified { image = emitImageVerifiedInternal(program, target, reuse); }
    else { image = emitImageInternal(program, target, reuse); }
    if image.isErr() { return Result.Err(image.unwrapErr()); }
    return Result.Ok(image.unwrap().code);
}

func emitProgramPackedInternal(program: IRProgram, target: string, reuse: bool, verified: bool): Result<PackedX64Code, string> {
    if target != "linux-x64" { return Result.Err("native x64: packed emission requires linux-x64"); }
    if !verified {
        var verification = verifyProgram(program);
        if !verification.ok {
            if verification.errors.len() > 0 { return Result.Err("native x64: invalid IR: " + verification.errors[0]); }
            return Result.Err("native x64: invalid IR program");
        }
    }
    var emitted = emitEmitterInternal(program, target, reuse, true);
    if emitted.isErr() { return Result.Err(emitted.unwrapErr()); }
    var emitter = emitted.unwrap();
    var packed = emitter.packedBytes;
    if packed != null {
        var bytes: PackedBuffer = packed;
        return Result.Ok(PackedX64Code { bytes: bytes, entryOffset: 0, functions: emitter.functions });
    }
    return Result.Err("native x64: packed emitter lost its output buffer");
}

pub func emitProgram(program: IRProgram, target: string): Result<X64Code, string> {
    return emitProgramInternal(program, target, false, false);
}

pub func emitProgramWithReuse(program: IRProgram, target: string): Result<X64Code, string> {
    return emitProgramInternal(program, target, true, false);
}

pub func emitProgramVerified(program: IRProgram, target: string): Result<X64Code, string> {
    return emitProgramInternal(program, target, false, true);
}

pub func emitProgramVerifiedWithReuse(program: IRProgram, target: string): Result<X64Code, string> {
    return emitProgramInternal(program, target, true, true);
}

pub func emitProgramPacked(program: IRProgram, target: string): Result<PackedX64Code, string> {
    return emitProgramPackedInternal(program, target, false, false);
}

pub func emitProgramPackedWithReuse(program: IRProgram, target: string): Result<PackedX64Code, string> {
    return emitProgramPackedInternal(program, target, true, false);
}

pub func emitProgramPackedVerified(program: IRProgram, target: string): Result<PackedX64Code, string> {
    return emitProgramPackedInternal(program, target, false, true);
}

pub func emitProgramPackedVerifiedWithReuse(program: IRProgram, target: string): Result<PackedX64Code, string> {
    return emitProgramPackedInternal(program, target, true, true);
}

pub func emitImage(program: IRProgram, target: string): Result<X64Image, string> {
    return emitImageInternal(program, target, false);
}

pub func emitImageWithReuse(program: IRProgram, target: string): Result<X64Image, string> {
    return emitImageInternal(program, target, true);
}
