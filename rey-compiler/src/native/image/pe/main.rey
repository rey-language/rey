// PE32+ x86-64 executable image. Cross-output only: nothing in this writer
// executes the image or claims a Windows runner.
import native::x64::{X64Image, X64Import, X64Frame};
import native::bytes::{appendU32Le, appendU64Le};

struct ImportGroup {
    pub library: string,
    pub count: int,
    pub lookupOffset: int,
    pub iatOffset: int,
    pub libraryNameOffset: int,
}

func fail(message: string): Result<Vec<int>, string> { return Result.Err("pe x64: " + message); }

func appendU16(bytes: Vec<int>, value: int): bool {
    if value < 0 || value > 65535 { return false; }
    bytes.push(value % 256);
    bytes.push((value / 256) % 256);
    return true;
}

func appendU32(bytes: Vec<int>, value: int): bool { return appendU32Le(bytes, value).isOk(); }
func appendU64(bytes: Vec<int>, value: int): bool { return appendU64Le(bytes, value).isOk(); }

func appendBytes(bytes: Vec<int>, text: string): bool {
    var i = 0;
    while i < text.len() {
        var value = int(text[i]);
        if value <= 0 || value > 255 { return false; }
        bytes.push(value);
        i = i + 1;
    }
    return true;
}

func align(value: int, boundary: int): int {
    var remainder = value % boundary;
    if remainder == 0 { return value; }
    return value + boundary - remainder;
}

func writeI32(bytes: Vec<int>, offset: int, value: int): bool {
    if value < -2147483648 || value > 2147483647 { return false; }
    if offset < 0 || offset > bytes.len() - 4 { return false; }
    var remaining = value;
    var i = 0;
    while i < 4 {
        var limb = remaining % 256;
        if limb < 0 { limb = limb + 256; }
        bytes.set(offset + i, limb);
        remaining = (remaining - limb) / 256;
        i = i + 1;
    }
    return true;
}

func unwindInfo(frameBytes: int): Result<Vec<int>, string> {
    // frameBytes -1 is the windows entry stub: sub rsp, 40; call; set ecx; call ExitProcess.
    // Prolog is only the 4-byte allocation. UWOP_ALLOC_SMALL OpInfo 4 is (40/8)-1.
    if frameBytes == -1 {
        var stub: Vec<int> = Vec.new();
        stub.push(1);
        stub.push(4);
        stub.push(1);
        stub.push(0);
        stub.push(4);
        stub.push(66);
        stub.push(0);
        stub.push(0);
        return Result.Ok(stub);
    }
    if frameBytes < 0 || frameBytes > 65520 || frameBytes % 8 != 0 { return Result.Err("frame"); }
    var info: Vec<int> = Vec.new();
    info.push(1);
    info.push(10);
    if frameBytes == 0 {
        info.push(2);
        info.push(5);
        info.push(4);
        info.push(3);
        info.push(1);
        info.push(80);
        return Result.Ok(info);
    }
    var slots = frameBytes / 8;
    if slots <= 16 {
        info.push(3);
        info.push(5);
        info.push(10);
        info.push((slots - 1) * 16 + 2);
        info.push(4);
        info.push(3);
        info.push(1);
        info.push(80);
        info.push(0);
        info.push(0);
        return Result.Ok(info);
    }
    info.push(4);
    info.push(5);
    info.push(10);
    info.push(1);
    if !appendU16(info, slots) { return Result.Err("frame"); }
    info.push(4);
    info.push(3);
    info.push(1);
    info.push(80);
    return Result.Ok(info);
}

func sectionHeader(bytes: Vec<int>, name: string, virtualSize: int, rva: int, rawSize: int, rawPointer: int, characteristics: int): bool {
    if name.len() > 8 { return false; }
    if !appendBytes(bytes, name) { return false; }
    var pad = name.len();
    while pad < 8 { bytes.push(0); pad = pad + 1; }
    return appendU32(bytes, virtualSize) && appendU32(bytes, rva) && appendU32(bytes, rawSize)
        && appendU32(bytes, rawPointer) && appendU32(bytes, 0) && appendU32(bytes, 0)
        && appendU16(bytes, 0) && appendU16(bytes, 0) && appendU32(bytes, characteristics);
}

func importIndex(imports: Vec<X64Import>, symbol: string): int {
    var index = 0;
    while index < imports.len() {
        if imports[index].symbol == symbol { return index; }
        index += 1;
    }
    return -1;
}

func importGroupIndex(groups: Vec<ImportGroup>, library: string): int {
    var index = 0;
    while index < groups.len() {
        if groups[index].library == library { return index; }
        index += 1;
    }
    return -1;
}

pub func buildPeX64(image: X64Image): Result<Vec<int>, string> {
    if image.target != "windows-x64" { return fail("target must be windows-x64"); }
    if image.convention != "win64" { return fail("calling convention must be win64"); }
    if image.code.bytes.len() == 0 { return fail("instruction stream is empty"); }
    if image.code.entryOffset < 0 || image.code.entryOffset >= image.code.bytes.len() { return fail("entry offset is outside the instruction stream"); }
    var exitImport = false;
    var i = 0;
    while i < image.imports.len() {
        var item = image.imports[i];
        if item.library != "kernel32.dll" && item.library != "shell32.dll" { return fail("unsupported import library " + item.library); }
        if item.symbol == "" { return fail("empty import symbol"); }
        if item.symbol == "ExitProcess" && item.library == "kernel32.dll" { exitImport = true; }
        var prior = 0;
        while prior < i {
            if image.imports[prior].symbol == item.symbol { return fail("duplicate import symbol " + item.symbol); }
            prior += 1;
        }
        i = i + 1;
    }
    if !exitImport { return fail("ExitProcess import is required"); }
    i = 0;
    while i < image.code.bytes.len() {
        if image.code.bytes[i] < 0 || image.code.bytes[i] > 255 { return fail("invalid code byte"); }
        i = i + 1;
    }
    i = 0;
    while i < image.relocations.len() {
        var reloc = image.relocations[i];
        if reloc.kind != 1 || importIndex(image.imports, reloc.symbol) < 0 { return fail("unsupported relocation"); }
        if reloc.offset < 0 || reloc.offset > image.code.bytes.len() - 4 { return fail("relocation is outside the instruction stream"); }
        i = i + 1;
    }
    var codeSize = image.code.bytes.len();
    var textRva = 4096;
    var textRaw = 512;
    var textRawSize = align(codeSize, 512);
    var idataRva = textRva + align(codeSize, 4096);
    var importCount = image.imports.len();
    var importGroups: Vec<ImportGroup> = [];
    var importGroupIndexes: Vec<int> = [];
    var importSlotIndexes: Vec<int> = [];
    i = 0;
    while i < importCount {
        var groupIndex = importGroupIndex(importGroups, image.imports[i].library);
        if groupIndex < 0 {
            importGroups.push(ImportGroup { library: image.imports[i].library, count: 0, lookupOffset: 0, iatOffset: 0, libraryNameOffset: 0 });
            groupIndex = importGroups.len() - 1;
        }
        var group = importGroups[groupIndex];
        importGroupIndexes.push(groupIndex);
        importSlotIndexes.push(group.count);
        group.count = group.count + 1;
        importGroups.set(groupIndex, group);
        i += 1;
    }
    var importDescriptorBytes = (importGroups.len() + 1) * 20;
    var importCursor = align(importDescriptorBytes, 8);
    i = 0;
    while i < importGroups.len() {
        var group = importGroups[i];
        group.lookupOffset = importCursor;
        importCursor += (group.count + 1) * 8;
        importGroups.set(i, group);
        i += 1;
    }
    i = 0;
    while i < importGroups.len() {
        var group = importGroups[i];
        group.iatOffset = importCursor;
        importCursor += (group.count + 1) * 8;
        importGroups.set(i, group);
        i += 1;
    }
    i = 0;
    while i < importGroups.len() {
        var group = importGroups[i];
        group.libraryNameOffset = importCursor;
        importCursor = align(importCursor + group.library.len() + 1, 2);
        importGroups.set(i, group);
        i += 1;
    }
    var idataNames = importCursor;
    var importNameOffsets: Vec<int> = Vec.new();
    var importNameCursor = idataNames;
    i = 0;
    while i < importCount {
        importNameOffsets.push(importNameCursor);
        importNameCursor = align(importNameCursor + 2 + image.imports[i].symbol.len() + 1, 2);
        i += 1;
    }
    var idata: Vec<int> = Vec.new();
    i = 0;
    while i < importGroups.len() {
        var group = importGroups[i];
        if !appendU32(idata, idataRva + group.lookupOffset) || !appendU32(idata, 0) || !appendU32(idata, 0)
            || !appendU32(idata, idataRva + group.libraryNameOffset) || !appendU32(idata, idataRva + group.iatOffset) {
            return fail("import descriptor encoding failed");
        }
        i += 1;
    }
    var zero = 0;
    while zero < 20 { idata.push(0); zero += 1; }
    while idata.len() < importGroups[0].lookupOffset { idata.push(0); }
    i = 0;
    var j = 0;
    while i < importGroups.len() {
        j = 0;
        while j < importCount {
            if importGroupIndexes[j] == i && !appendU64(idata, idataRva + importNameOffsets[j]) { return fail("import lookup encoding failed"); }
            j += 1;
        }
        if !appendU64(idata, 0) { return fail("import lookup encoding failed"); }
        i += 1;
    }
    i = 0;
    while i < importGroups.len() {
        j = 0;
        while j < importCount {
            if importGroupIndexes[j] == i && !appendU64(idata, idataRva + importNameOffsets[j]) { return fail("import address encoding failed"); }
            j += 1;
        }
        if !appendU64(idata, 0) { return fail("import address encoding failed"); }
        i += 1;
    }
    i = 0;
    while i < importGroups.len() {
        var group = importGroups[i];
        while idata.len() < group.libraryNameOffset { idata.push(0); }
        if !appendBytes(idata, group.library) { return fail("import library encoding failed"); }
        idata.push(0);
        while idata.len() % 2 != 0 { idata.push(0); }
        i += 1;
    }
    if idata.len() != idataNames { return fail("import library size mismatch"); }
    i = 0;
    while i < importCount {
        if !appendU16(idata, 0) || !appendBytes(idata, image.imports[i].symbol) { return fail("import symbol encoding failed"); }
        idata.push(0);
        while idata.len() % 2 != 0 { idata.push(0); }
        i += 1;
    }
    if idata.len() != importNameCursor { return fail("import section size mismatch"); }
    var frames: Vec<X64Frame> = Vec.new();
    i = 0;
    while i < image.frames.len() {
        var frame = image.frames[i];
        if frame.functionId < -1 { return fail("frame id is outside the supported range"); }
        frames.push(frame);
        i = i + 1;
    }
    var pdataRva = idataRva + align(idata.len(), 4096);
    var unwindBlobs: Vec<int> = Vec.new();
    var blobOffsets: Vec<int> = Vec.new();
    i = 0;
    while i < frames.len() {
        var frame = frames[i];
        if frame.offset < 0 || frame.offset >= codeSize { return fail("frame offset is outside the instruction stream"); }
        if i + 1 < frames.len() && frames[i + 1].offset <= frame.offset { return fail("frame range is not ordered"); }
        blobOffsets.push(unwindBlobs.len());
        var info = unwindInfo(frame.frameBytes);
        if info.isErr() { return fail(info.unwrapErr()); }
        var blob = info.unwrap();
        var b = 0;
        while b < blob.len() { unwindBlobs.push(blob[b]); b = b + 1; }
        i = i + 1;
    }
    var functionTable = frames.len() * 12;
    var pdata: Vec<int> = Vec.new();
    i = 0;
    while i < frames.len() {
        var end = codeSize;
        if i + 1 < frames.len() { end = frames[i + 1].offset; }
        if end > codeSize { return fail("frame range is not ordered"); }
        var unwindRva = pdataRva + functionTable + blobOffsets[i];
        if !appendU32(pdata, textRva + frames[i].offset) || !appendU32(pdata, textRva + end) || !appendU32(pdata, unwindRva) {
            return fail("exception table encoding failed");
        }
        i = i + 1;
    }
    var entryRva = textRva + image.code.entryOffset;
    var entryCovered = false;
    i = 0;
    while i < frames.len() {
        var begin = textRva + frames[i].offset;
        var endRva = textRva + codeSize;
        if i + 1 < frames.len() { endRva = textRva + frames[i + 1].offset; }
        if begin <= entryRva && entryRva < endRva { entryCovered = true; }
        i = i + 1;
    }
    if !entryCovered { return fail("entry point is outside .pdata"); }
    i = 0;
    while i < unwindBlobs.len() { pdata.push(unwindBlobs[i]); i = i + 1; }
    var idataRaw = textRaw + textRawSize;
    var idataRawSize = align(idata.len(), 512);
    var pdataRaw = idataRaw + idataRawSize;
    var pdataRawSize = align(pdata.len(), 512);
    var imageSize = pdataRva + align(pdata.len(), 4096);
    var file: Vec<int> = Vec.new();
    if !appendBytes(file, "MZ") { return fail("DOS header encoding failed"); }
    while file.len() < 60 { file.push(0); }
    if !appendU32(file, 128) { return fail("DOS header encoding failed"); }
    while file.len() < 128 { file.push(0); }
    if !appendBytes(file, "PE") { return fail("PE signature encoding failed"); }
    file.push(0);
    file.push(0);
    if !appendU16(file, 34404) || !appendU16(file, 3) || !appendU32(file, 0) || !appendU32(file, 0)
        || !appendU32(file, 0) || !appendU16(file, 240) || !appendU16(file, 34) {
        return fail("COFF header encoding failed");
    }
    if !appendU16(file, 523) || !appendU16(file, 0) || !appendU32(file, textRawSize) || !appendU32(file, idataRawSize + pdataRawSize)
        || !appendU32(file, 0) || !appendU32(file, textRva + image.code.entryOffset) || !appendU32(file, textRva) {
        return fail("optional header encoding failed");
    }
    if !appendU64(file, 5368709120) || !appendU32(file, 4096) || !appendU32(file, 512) || !appendU16(file, 0)
        || !appendU16(file, 0) || !appendU16(file, 0) || !appendU16(file, 0) || !appendU16(file, 0)
        || !appendU16(file, 0)         || !appendU32(file, 0) || !appendU32(file, imageSize) || !appendU32(file, 512) || !appendU32(file, 0)
        || !appendU16(file, 3) || !appendU16(file, 352) || !appendU64(file, 1048576) || !appendU64(file, 4096)
        || !appendU64(file, 1048576) || !appendU64(file, 4096) || !appendU32(file, 0) || !appendU32(file, 16) {
        return fail("optional header encoding failed");
    }
    var directory = 0;
    while directory < 16 {
        var rva = 0;
        var size = 0;
        if directory == 1 { rva = idataRva; size = importDescriptorBytes; }
        if directory == 3 { rva = pdataRva; size = functionTable; }
        if !appendU32(file, rva) || !appendU32(file, size) { return fail("data directory encoding failed"); }
        directory = directory + 1;
    }
    if !sectionHeader(file, ".text", codeSize, textRva, textRawSize, textRaw, 1610612768) { return fail("text section encoding failed"); }
    if !sectionHeader(file, ".idata", idata.len(), idataRva, idataRawSize, idataRaw, 3221225536) { return fail("import section encoding failed"); }
    if !sectionHeader(file, ".pdata", pdata.len(), pdataRva, pdataRawSize, pdataRaw, 1073741888) { return fail("exception section encoding failed"); }
    if file.len() != 512 { return fail("header size mismatch"); }
    i = 0;
    while i < codeSize { file.push(image.code.bytes[i]); i = i + 1; }
    while file.len() < idataRaw { file.push(0); }
    i = 0;
    while i < idata.len() { file.push(idata[i]); i = i + 1; }
    while file.len() < pdataRaw { file.push(0); }
    i = 0;
    while i < pdata.len() { file.push(pdata[i]); i = i + 1; }
    while file.len() < pdataRaw + pdataRawSize { file.push(0); }
    i = 0;
    while i < image.relocations.len() {
        var reloc = image.relocations[i];
        var nextIp = textRva + reloc.offset + 4;
        var symbolIndex = importIndex(image.imports, reloc.symbol);
        if symbolIndex < 0 { return fail("relocation import is missing"); }
        var groupIndex = importGroupIndexes[symbolIndex];
        var group = importGroups[groupIndex];
        var iatRva = idataRva + group.iatOffset + importSlotIndexes[symbolIndex] * 8;
        var disp = iatRva - nextIp;
        if !writeI32(file, textRaw + reloc.offset, disp) { return fail("import displacement does not fit"); }
        i = i + 1;
    }
    return Result.Ok(file);
}
