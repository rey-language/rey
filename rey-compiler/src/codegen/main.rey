func cgCollectionKind(tag: string): string {
    if tag == "Vec" || tag.startsWith("Vec<") { return "Vec"; }
    if tag == "HashMap" || tag.startsWith("HashMap<") { return "HashMap"; }
    return "";
}

func cgVecElementType(tag: string): string {
    if !tag.startsWith("Vec<") || !tag.endsWith(">") { return ""; }
    return tag.slice(4, tag.len() - 1);
}

func cgHashMapValueType(tag: string): string {
    if !tag.startsWith("HashMap<") || !tag.endsWith(">") { return ""; }
    var inner = tag.slice(8, tag.len() - 1);
    var comma = inner.indexOf(",");
    if comma < 0 { return ""; }
    return inner.slice(comma + 1, inner.len()).trim();
}

func cgResultErrType(tag: string): string {
    if !tag.startsWith("Result<") || !tag.endsWith(">") { return ""; }
    var inner = tag.slice(7, tag.len() - 1);
    var comma = inner.indexOf(",");
    if comma < 0 { return ""; }
    return inner.slice(comma + 1, inner.len()).trim();
}

func cgResultOkType(tag: string): string {
    if !tag.startsWith("Result<") || !tag.endsWith(">") { return ""; }
    var inner = tag.slice(7, tag.len() - 1);
    var comma = inner.indexOf(",");
    if comma < 0 { return ""; }
    return inner.slice(0, comma).trim();
}

func cgIsResultType(tag: string): bool {
    return tag == "Result" || tag.startsWith("Result<");
}

func cgPanicGuard(ctx: CodegenContext, condition: string, message: string): string {
    var errorLabel = nextLabel(ctx, "runtime.error");
    var continueLabel = nextLabel(ctx, "runtime.continue");
    var stringIndex = cgInternString(ctx, message);
    var stringInfo: CStringInfo = llvmCStringInfo(message);
    var errorMessage = nextTemp(ctx);
    var code = "br i1 " + condition + ", label %" + errorLabel + ", label %" + continueLabel + "\n";
    code = code + errorLabel + ":\n";
    code = code + errorMessage + " = call i8* @rey_str_new(i8* " + llvmStrPtr(stringIndex, stringInfo.len) + ", i64 " + (stringInfo.len - 1).toString() + ")\n";
    code = code + "call void @rey_panic(i8* " + errorMessage + ")\nunreachable\n";
    code = code + continueLabel + ":\n";
    return code;
}

func cgCheckedIntBin(ctx: CodegenContext, op: string, left: string, right: string): GenExprResult {
    var intrinsic = "sadd";
    if op == "-" { intrinsic = "ssub"; }
    if op == "*" { intrinsic = "smul"; }
    var pair = nextTemp(ctx);
    var value = nextTemp(ctx);
    var overflow = nextTemp(ctx);
    var code = pair + " = call {{ i64, i1 }} @llvm." + intrinsic + ".with.overflow.i64(i64 " + left + ", i64 " + right + ")\n";
    code = code + value + " = extractvalue {{ i64, i1 }} " + pair + ", 0\n";
    code = code + overflow + " = extractvalue {{ i64, i1 }} " + pair + ", 1\n";
    code = code + cgPanicGuard(ctx, overflow, "signed 64-bit integer overflow: " + op);
    return GenExprResult { ty: "i64", val: value, code: code };
}

func cgCheckedDivRem(ctx: CodegenContext, op: string, left: string, right: string): GenExprResult {
    var isZero = nextTemp(ctx);
    var isMin = nextTemp(ctx);
    var isNegOne = nextTemp(ctx);
    var isOverflow = nextTemp(ctx);
    var invalid = nextTemp(ctx);
    var code = isZero + " = icmp eq i64 " + right + ", 0\n";
    code = code + isMin + " = icmp eq i64 " + left + ", -9223372036854775808\n";
    code = code + isNegOne + " = icmp eq i64 " + right + ", -1\n";
    code = code + isOverflow + " = and i1 " + isMin + ", " + isNegOne + "\n";
    code = code + invalid + " = or i1 " + isZero + ", " + isOverflow + "\n";
    code = code + cgPanicGuard(ctx, invalid, "invalid signed integer " + op);
    var value = nextTemp(ctx);
    var instruction = "sdiv";
    if op == "%" { instruction = "srem"; }
    code = code + value + " = " + instruction + " i64 " + left + ", " + right + "\n";
    return GenExprResult { ty: "i64", val: value, code: code };
}

func cgAsDouble(ctx: CodegenContext, expr: Expr, value: GenExprResult): GenExprResult {
    var sourceType = cgSourceType(ctx, expr);
    if sourceType == "float" && value.ty == "double" { return value; }
    if sourceType == "int" && value.ty == "i64" {
        var promoted = nextTemp(ctx);
        return GenExprResult { ty: "double", val: promoted, code: value.code + promoted + " = sitofp i64 " + value.val + " to double\n" };
    }
    return cgErrorExprAt(ctx, expr, "floating operation requires a known int or float operand");
}

func cgBoxAny(ctx: CodegenContext, source: string, value: GenExprResult): GenExprResult {
    if source == "string" {
        if value.ty != "i8*" { return cgErrorExpr(ctx, "any string payload is not i8*"); }
        var bits = nextTemp(ctx);
        var boxed = nextTemp(ctx);
        var code = value.code;
        code = code + bits + " = ptrtoint i8* " + value.val + " to i64\n";
        code = code + boxed + " = call i64 @rey_value_new(i64 4100, i64 " + bits + ")\n";
        return GenExprResult { ty: "i64", val: boxed, code: code };
    }
    if source == "null" {
        var boxedNull = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: boxedNull, code: value.code + boxedNull + " = call i64 @rey_value_new(i64 4102, i64 0)\n" };
    }
    return cgBoxScalar(ctx, source, value);
}

func cgMaybeBoxAny(ctx: CodegenContext, expr: Expr, source: string, value: GenExprResult): GenExprResult {
    if cgSourceType(ctx, expr) != "any" { return value; }
    var boxed = cgBoxAny(ctx, source, GenExprResult { ty: value.ty, val: value.val, code: "" });
    return GenExprResult { ty: boxed.ty, val: boxed.val, code: value.code + boxed.code };
}

func cgEmitMinMax(ctx: CodegenContext, expr: Expr, call: CallExpr, wantMin: bool): GenExprResult {
    if call.args.len() != 2 { return cgErrorExprAt(ctx, expr, "min/max require two arguments"); }
    var left: GenExprResult = genExprValue(ctx, call.args[0]);
    var right: GenExprResult = genExprValue(ctx, call.args[1]);
    var leftSource = cgSourceType(ctx, call.args[0]);
    var rightSource = cgSourceType(ctx, call.args[1]);
    var code = left.code + right.code;
    if leftSource == "int" && rightSource == "int" && left.ty == "i64" && right.ty == "i64" {
        var predicate = "slt";
        if !wantMin { predicate = "sgt"; }
        var compared = nextTemp(ctx);
        var selected = nextTemp(ctx);
        code = code + compared + " = icmp " + predicate + " i64 " + left.val + ", " + right.val + "\n";
        code = code + selected + " = select i1 " + compared + ", i64 " + left.val + ", i64 " + right.val + "\n";
        return cgMaybeBoxAny(ctx, expr, "int", GenExprResult { ty: "i64", val: selected, code: code });
    }
    if leftSource == "float" && rightSource == "float" && left.ty == "double" && right.ty == "double" {
        var floatPredicate = "olt";
        if !wantMin { floatPredicate = "ogt"; }
        var floatCompared = nextTemp(ctx);
        var floatSelected = nextTemp(ctx);
        code = code + floatCompared + " = fcmp " + floatPredicate + " double " + left.val + ", " + right.val + "\n";
        code = code + floatSelected + " = select i1 " + floatCompared + ", double " + left.val + ", double " + right.val + "\n";
        return cgMaybeBoxAny(ctx, expr, "float", GenExprResult { ty: "double", val: floatSelected, code: code });
    }
    return cgErrorExprAt(ctx, expr, "min/max require two ints or two floats");
}

func cgEmitAbs(ctx: CodegenContext, expr: Expr, call: CallExpr): GenExprResult {
    if call.args.len() != 1 { return cgErrorExprAt(ctx, expr, "abs requires one argument"); }
    var arg: GenExprResult = genExprValue(ctx, call.args[0]);
    var source = cgSourceType(ctx, call.args[0]);
    if source == "int" && arg.ty == "i64" {
        var absoluteInt = nextTemp(ctx);
        var code = arg.code + absoluteInt + " = call i64 @rey_abs_int(i64 " + arg.val + ")\n";
        return cgMaybeBoxAny(ctx, expr, "int", GenExprResult { ty: "i64", val: absoluteInt, code: code });
    }
    if source == "float" && arg.ty == "double" {
        var absolute = nextTemp(ctx);
        var codeF = arg.code + absolute + " = call double @llvm.fabs.f64(double " + arg.val + ")\n";
        return cgMaybeBoxAny(ctx, expr, "float", GenExprResult { ty: "double", val: absolute, code: codeF });
    }
    return cgErrorExprAt(ctx, expr, "abs requires an int or float");
}

func cgEmitFloatRounding(ctx: CodegenContext, expr: Expr, call: CallExpr, intrinsic: string): GenExprResult {
    if call.args.len() != 1 { return cgErrorExprAt(ctx, expr, intrinsic + " requires one argument"); }
    var arg: GenExprResult = genExprValue(ctx, call.args[0]);
    var asDouble: GenExprResult = cgAsDouble(ctx, call.args[0], arg);
    var rounded = nextTemp(ctx);
    var converted = nextTemp(ctx);
    var code = asDouble.code;
    code = code + rounded + " = call double @llvm." + intrinsic + ".f64(double " + asDouble.val + ")\n";
    code = code + converted + " = call i64 @rey_float_to_int(double " + rounded + ")\n";
    return GenExprResult { ty: "i64", val: converted, code: code };
}

func cgEmitPow(ctx: CodegenContext, expr: Expr, call: CallExpr): GenExprResult {
    if call.args.len() != 2 { return cgErrorExprAt(ctx, expr, "pow requires two arguments"); }
    var baseArg: GenExprResult = genExprValue(ctx, call.args[0]);
    var expArg: GenExprResult = genExprValue(ctx, call.args[1]);
    var base: GenExprResult = cgAsDouble(ctx, call.args[0], baseArg);
    var exponent: GenExprResult = cgAsDouble(ctx, call.args[1], expArg);
    var result = nextTemp(ctx);
    var code = base.code + exponent.code;
    code = code + result + " = call double @llvm.pow.f64(double " + base.val + ", double " + exponent.val + ")\n";
    return GenExprResult { ty: "double", val: result, code: code };
}

func cgEmitAssert(ctx: CodegenContext, expr: Expr, call: CallExpr): GenExprResult {
    if call.args.len() != 2 { return cgErrorExprAt(ctx, expr, "assert requires a condition and a message"); }
    var condition: GenExprResult = genExprValue(ctx, call.args[0]);
    var message: GenExprResult = genExprValue(ctx, call.args[1]);
    var rendered: GenExprResult = cgRenderToString(ctx, call.args[1], message);
    var failed = nextTemp(ctx);
    var code = condition.code + rendered.code;
    if condition.ty == "i1" {
        code = code + failed + " = icmp eq i1 " + condition.val + ", 0\n";
    } else if condition.ty == "i64" {
        code = code + failed + " = icmp eq i64 " + condition.val + ", 0\n";
    } else {
        return cgErrorExprAt(ctx, expr, "assert condition must be bool");
    }
    var errorLabel = nextLabel(ctx, "assert.fail");
    var continueLabel = nextLabel(ctx, "assert.pass");
    code = code + "br i1 " + failed + ", label %" + errorLabel + ", label %" + continueLabel + "\n";
    code = code + errorLabel + ":\n";
    code = code + "call void @rey_panic(i8* " + rendered.val + ")\nunreachable\n";
    code = code + continueLabel + ":\n";
    return GenExprResult { ty: "void", val: "0", code: code };
}

func cgEmitIntConversion(ctx: CodegenContext, expr: Expr, call: CallExpr): GenExprResult {
    if call.args.len() != 1 { return cgErrorExprAt(ctx, expr, "int conversion requires one argument"); }
    var arg: GenExprResult = genExprValue(ctx, call.args[0]);
    var source = cgSourceType(ctx, call.args[0]);
    if source == "char" && arg.ty == "i8*" {
        var byte = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: byte, code: arg.code + byte + " = call i64 @rey_int_from_char(i8* " + arg.val + ")\n" };
    }
    if source == "int" && arg.ty == "i64" { return arg; }
    if source == "bool" {
        if arg.ty == "i64" { return arg; }
        if arg.ty == "i1" {
            var extended = nextTemp(ctx);
            return GenExprResult { ty: "i64", val: extended, code: arg.code + extended + " = zext i1 " + arg.val + " to i64\n" };
        }
    }
    if source == "float" && arg.ty == "double" {
        var converted = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: converted, code: arg.code + converted + " = call i64 @rey_float_to_int(double " + arg.val + ")\n" };
    }
    if source == "string" && arg.ty == "i8*" {
        var parsed = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: parsed, code: arg.code + parsed + " = call i64 @rey_str_to_int(i8* " + arg.val + ")\n" };
    }
    return cgErrorExprAt(ctx, expr, "int conversion source is not supported: " + source);
}

func cgEmitFloatConversion(ctx: CodegenContext, expr: Expr, call: CallExpr): GenExprResult {
    if call.args.len() != 1 { return cgErrorExprAt(ctx, expr, "float conversion requires one argument"); }
    var arg: GenExprResult = genExprValue(ctx, call.args[0]);
    var source = cgSourceType(ctx, call.args[0]);
    if source == "float" && arg.ty == "double" { return arg; }
    if source == "int" && arg.ty == "i64" {
        var promoted = nextTemp(ctx);
        return GenExprResult { ty: "double", val: promoted, code: arg.code + promoted + " = sitofp i64 " + arg.val + " to double\n" };
    }
    return cgErrorExprAt(ctx, expr, "float conversion requires an int or float");
}

func cgEmitStringConversion(ctx: CodegenContext, expr: Expr, call: CallExpr): GenExprResult {
    if call.args.len() != 1 { return cgErrorExprAt(ctx, expr, "string conversion requires one argument"); }
    var arg: GenExprResult = genExprValue(ctx, call.args[0]);
    var source = cgSourceType(ctx, call.args[0]);
    if (source == "string" || source == "char") && arg.ty == "i8*" { return arg; }
    if source == "int" && arg.ty == "i64" {
        var text = nextTemp(ctx);
        return GenExprResult { ty: "i8*", val: text, code: arg.code + text + " = call i8* @rey_int_to_str(i64 " + arg.val + ")\n" };
    }
    if source == "float" && arg.ty == "double" {
        var floatText = nextTemp(ctx);
        return GenExprResult { ty: "i8*", val: floatText, code: arg.code + floatText + " = call i8* @rey_float_to_str(double " + arg.val + ")\n" };
    }
    if source == "bool" && (arg.ty == "i1" || arg.ty == "i64") {
        var payload = arg.val;
        var code = arg.code;
        if arg.ty == "i1" {
            var extended = nextTemp(ctx);
            code = code + extended + " = zext i1 " + arg.val + " to i64\n";
            payload = extended;
        }
        var boolText = nextTemp(ctx);
        return GenExprResult { ty: "i8*", val: boolText, code: code + boolText + " = call i8* @rey_bool_to_str(i64 " + payload + ")\n" };
    }
    return cgErrorExprAt(ctx, expr, "string conversion source is not supported: " + source);
}

func cgEmitPad(ctx: CodegenContext, text: string, pad: string, width: string, left: bool): GenExprResult {
    var textLen = nextTemp(ctx);
    var padLen = nextTemp(ctx);
    var negativeWidth = nextTemp(ctx);
    var emptyPad = nextTemp(ctx);
    var code = textLen + " = call i64 @rey_str_len(i8* " + text + ")\n";
    code = code + padLen + " = call i64 @rey_str_len(i8* " + pad + ")\n";
    code = code + negativeWidth + " = icmp slt i64 " + width + ", 0\n";
    code = code + cgPanicGuard(ctx, negativeWidth, "pad width must be nonnegative");
    code = code + emptyPad + " = icmp eq i64 " + padLen + ", 0\n";
    code = code + cgPanicGuard(ctx, emptyPad, "pad text must be nonempty");
    var needsPad = nextTemp(ctx);
    var readyLabel = nextLabel(ctx, "pad.ready");
    var fillLabel = nextLabel(ctx, "pad.fill");
    var endLabel = nextLabel(ctx, "pad.end");
    code = code + needsPad + " = icmp slt i64 " + textLen + ", " + width + "\n";
    code = code + "br i1 " + needsPad + ", label %" + fillLabel + ", label %" + readyLabel + "\n";
    code = code + readyLabel + ":\n";
    code = code + "br label %" + endLabel + "\n";
    code = code + fillLabel + ":\n";
    var gap = nextTemp(ctx);
    var byte = nextTemp(ctx);
    var buffer = nextTemp(ctx);
    var unit = nextTemp(ctx);
    var repeated = nextTemp(ctx);
    var padded = nextTemp(ctx);
    code = code + gap + " = sub i64 " + width + ", " + textLen + "\n";
    code = code + byte + " = load i8, i8* " + pad + "\n";
    code = code + buffer + " = alloca i8, align 1\n";
    code = code + "store i8 " + byte + ", i8* " + buffer + "\n";
    code = code + unit + " = call i8* @rey_str_new(i8* " + buffer + ", i64 1)\n";
    code = code + repeated + " = call i8* @rey_str_repeat(i8* " + unit + ", i64 " + gap + ")\n";
    if left {
        code = code + padded + " = call i8* @rey_str_concat(i8* " + repeated + ", i8* " + text + ")\n";
    } else {
        code = code + padded + " = call i8* @rey_str_concat(i8* " + text + ", i8* " + repeated + ")\n";
    }
    code = code + "br label %" + endLabel + "\n";
    code = code + endLabel + ":\n";
    var merged = nextTemp(ctx);
    code = code + merged + " = phi i8* [" + text + ", %" + readyLabel + "], [" + padded + ", %" + fillLabel + "]\n";
    return GenExprResult { ty: "i8*", val: merged, code: code };
}

func cgEmitVecIndexOf(ctx: CodegenContext, vec: string, needle: GenExprResult): GenExprResult {
    var needleVal = needle.val;
    var needleTy = needle.ty;
    var code = "";
    if needle.ty == "i1" {
        var extended = nextTemp(ctx);
        code = code + extended + " = zext i1 " + needle.val + " to i64\n";
        needleVal = extended;
        needleTy = "i64";
    }
    var length = nextTemp(ctx);
    var indexSlot = nextTemp(ctx);
    var foundSlot = nextTemp(ctx);
    code = code + length + " = call i64 @rey_vec_len(i64 " + vec + ")\n";
    ctx.funcAllocas = ctx.funcAllocas + indexSlot + " = alloca i64, align 8\n";
    ctx.funcAllocas = ctx.funcAllocas + foundSlot + " = alloca i64, align 8\n";
    code = code + "store i64 0, i64* " + indexSlot + "\n";
    code = code + "store i64 -1, i64* " + foundSlot + "\n";
    var condLabel = nextLabel(ctx, "indexof.cond");
    var bodyLabel = nextLabel(ctx, "indexof.body");
    var stepLabel = nextLabel(ctx, "indexof.step");
    var endLabel = nextLabel(ctx, "indexof.end");
    code = code + "br label %" + condLabel + "\n";
    code = code + condLabel + ":\n";
    var index = nextTemp(ctx);
    var inRange = nextTemp(ctx);
    code = code + index + " = load i64, i64* " + indexSlot + "\n";
    code = code + inRange + " = icmp slt i64 " + index + ", " + length + "\n";
    code = code + "br i1 " + inRange + ", label %" + bodyLabel + ", label %" + endLabel + "\n";
    code = code + bodyLabel + ":\n";
    var equal = nextTemp(ctx);
    if needleTy == "double" {
        var element = nextTemp(ctx);
        code = code + element + " = call double @rey_vec_get_float(i64 " + vec + ", i64 " + index + ")\n";
        code = code + equal + " = fcmp oeq double " + element + ", " + needleVal + "\n";
    } else if needleTy == "i8*" {
        var raw = nextTemp(ctx);
        var elementPtr = nextTemp(ctx);
        var same = nextTemp(ctx);
        code = code + raw + " = call i64 @rey_vec_get(i64 " + vec + ", i64 " + index + ")\n";
        code = code + elementPtr + " = inttoptr i64 " + raw + " to i8*\n";
        code = code + same + " = call i64 @rey_str_eq(i8* " + elementPtr + ", i8* " + needleVal + ")\n";
        code = code + equal + " = icmp ne i64 " + same + ", 0\n";
    } else {
        var elementInt = nextTemp(ctx);
        code = code + elementInt + " = call i64 @rey_vec_get(i64 " + vec + ", i64 " + index + ")\n";
        code = code + equal + " = icmp eq i64 " + elementInt + ", " + needleVal + "\n";
    }
    var hitLabel = nextLabel(ctx, "indexof.hit");
    code = code + "br i1 " + equal + ", label %" + hitLabel + ", label %" + stepLabel + "\n";
    code = code + hitLabel + ":\n";
    code = code + "store i64 " + index + ", i64* " + foundSlot + "\n";
    code = code + "br label %" + endLabel + "\n";
    code = code + stepLabel + ":\n";
    var nextIndex = nextTemp(ctx);
    code = code + nextIndex + " = add nsw i64 " + index + ", 1\n";
    code = code + "store i64 " + nextIndex + ", i64* " + indexSlot + "\n";
    code = code + "br label %" + condLabel + "\n";
    code = code + endLabel + ":\n";
    var found = nextTemp(ctx);
    code = code + found + " = load i64, i64* " + foundSlot + "\n";
    return GenExprResult { ty: "i64", val: found, code: code };
}

func cgEmitEnumVariantCall(ctx: CodegenContext, callExpr: CallExpr, symbol: ResolvedSymbol, info: CheckedExprInfo): GenExprResult {
    if symbol.sourceName == "Option::None" && callExpr.args.len() == 0 {
        var noneValue = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: noneValue, code: noneValue + " = call i64 @rey_none()\n" };
    }
    if callExpr.args.len() == 1 && (symbol.sourceName == "Option::Some" || symbol.sourceName == "Result::Ok" || symbol.sourceName == "Result::Err") {
        var variantArg: GenExprResult = genExprValue(ctx, callExpr.args[0]);
        var variantRaw = cgTaggedPayloadRaw(ctx, callExpr.args[0], variantArg);
        var variantKind = cgEnumPayloadKind(ctx, cgSourceType(ctx, callExpr.args[0]));
        if variantKind < 0 { return cgErrorExpr(ctx, "enum variant payload type is unsupported: " + symbol.sourceName); }
        var variantCtor = "rey_some_typed";
        if symbol.sourceName == "Result::Ok" { variantCtor = "rey_ok_typed"; }
        if symbol.sourceName == "Result::Err" { variantCtor = "rey_err_typed"; }
        var variantValue = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: variantValue, code: variantRaw.code + variantValue + " = call i64 @" + variantCtor + "(i64 " + variantRaw.val + ", i64 " + variantKind.toString() + ")\n" };
    }
    var enumTypeName = cgCheckedTypeName(ctx, info.ty);
    if !ctx.enumDefs.has(enumTypeName) { enumTypeName = cgResolveNominalKey(ctx, "Enum", info.ty.name); }
    if enumTypeName == "" || !ctx.enumDefs.has(enumTypeName) {
        return cgErrorExpr(ctx, "checked enum variant has no layout: " + symbol.sourceName);
    }
    var enumLayout: EnumDef = ctx.enumDefs.get(enumTypeName);
    var variantSlot = info.variantIndex;
    if variantSlot < 0 || variantSlot >= enumLayout.variants.len() || callExpr.args.len() != enumLayout.variants[variantSlot].payloadTypes.len() {
        return cgErrorExpr(ctx, "checked enum variant payload layout mismatch: " + symbol.sourceName);
    }
    var builtEnum = nextTemp(ctx);
    var builtCode = builtEnum + " = call i64 @rey_enum_new(i64 " + enumLayout.identity.toString() + ", i64 " + variantSlot.toString() + ", i64 " + callExpr.args.len().toString() + ")\n";
    var variantArgIndex = 0;
    loop {
        if variantArgIndex >= callExpr.args.len() { break; }
        var declaredPayload = enumLayout.variants[variantSlot].payloadTypes[variantArgIndex];
        var payloadKind = cgEnumPayloadKind(ctx, declaredPayload);
        if payloadKind < 0 { return cgErrorExpr(ctx, "enum variant payload type is unsupported: " + declaredPayload); }
        var payloadArg: GenExprResult = genExprValue(ctx, callExpr.args[variantArgIndex]);
        builtCode = builtCode + payloadArg.code;
        var rawPayload = payloadArg.val;
        if declaredPayload == "float" {
            if payloadArg.ty != "double" { return cgErrorExpr(ctx, "float enum payload has unsupported LLVM representation"); }
            var floatBits = nextTemp(ctx);
            builtCode = builtCode + floatBits + " = bitcast double " + payloadArg.val + " to i64\n";
            rawPayload = floatBits;
        } else if payloadArg.ty.endsWith("*") {
            var pointerBits = nextTemp(ctx);
            builtCode = builtCode + pointerBits + " = ptrtoint " + payloadArg.ty + " " + payloadArg.val + " to i64\n";
            rawPayload = pointerBits;
        } else if payloadArg.ty == "i1" {
            var boolBits = nextTemp(ctx);
            builtCode = builtCode + boolBits + " = zext i1 " + payloadArg.val + " to i64\n";
            rawPayload = boolBits;
        } else if payloadArg.ty != "i64" {
            return cgErrorExpr(ctx, "enum variant payload has unsupported LLVM representation: " + declaredPayload);
        }
        builtCode = builtCode + "call void @rey_enum_set(i64 " + builtEnum + ", i64 " + variantArgIndex.toString() + ", i64 " + payloadKind.toString() + ", i64 " + rawPayload + ")\n";
        variantArgIndex = variantArgIndex + 1;
    }
    return GenExprResult { ty: "i64", val: builtEnum, code: builtCode };
}

func cgCallFieldIndex(ctx: CodegenContext, name: string): int {
    if ctx.methodStructKey == "" || !ctx.structDefs.has(ctx.methodStructKey) { return -1; }
    var def: StructDef = ctx.structDefs.get(ctx.methodStructKey);
    var index = 0;
    loop {
        if index >= def.fields.len() { break; }
        var field: StructFieldDef = def.fields[index];
        if field.name == name { return index; }
        index = index + 1;
    }
    return -1;
}

func cgCallLoadField(ctx: CodegenContext, name: string): GenExprResult {
    var index = cgCallFieldIndex(ctx, name);
    if index < 0 || ctx.methodSelfPtr == "" { return cgErrorExpr(ctx, "unresolved method field: " + name); }
    var def: StructDef = ctx.structDefs.get(ctx.methodStructKey);
    var field: StructFieldDef = def.fields[index];
    var gep = nextTemp(ctx);
    var loaded = nextTemp(ctx);
    var code = gep + " = getelementptr inbounds " + def.llvmName + ", " + def.llvmName + "* " + ctx.methodSelfPtr + ", i32 0, i32 " + index.toString() + "\n";
    code = code + loaded + " = load " + field.ty + ", " + field.ty + "* " + gep + "\n";
    return GenExprResult { ty: field.ty, val: loaded, code: code };
}

func cgCallCoerceStore(ctx: CodegenContext, expectedTy: string, value: string, valueTy: string, code: string): GenExprResult {
    if expectedTy == valueTy { return GenExprResult { ty: expectedTy, val: value, code: code }; }
    if expectedTy == "i64" && valueTy.endsWith("*") {
        var pointerBits = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: pointerBits, code: code + pointerBits + " = ptrtoint " + valueTy + " " + value + " to i64\n" };
    }
    if expectedTy == "i64" && valueTy == "i1" {
        var boolBits = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: boolBits, code: code + boolBits + " = zext i1 " + value + " to i64\n" };
    }
    if expectedTy.endsWith("*") && valueTy == "i64" {
        var pointer = nextTemp(ctx);
        return GenExprResult { ty: expectedTy, val: pointer, code: code + pointer + " = inttoptr i64 " + value + " to " + expectedTy + "\n" };
    }
    if expectedTy.endsWith("*") && valueTy.endsWith("*") {
        var castPointer = nextTemp(ctx);
        return GenExprResult { ty: expectedTy, val: castPointer, code: code + castPointer + " = bitcast " + valueTy + " " + value + " to " + expectedTy + "\n" };
    }
    if expectedTy == "double" && valueTy == "i64" {
        var promoted = nextTemp(ctx);
        return GenExprResult { ty: "double", val: promoted, code: code + promoted + " = sitofp i64 " + value + " to double\n" };
    }
    cgSetError(ctx, "method field store type mismatch");
    return GenExprResult { ty: expectedTy, val: value, code: code };
}

func cgCallStoreField(ctx: CodegenContext, name: string, op: string, rhs: GenExprResult): string {
    var index = cgCallFieldIndex(ctx, name);
    if index < 0 || ctx.methodSelfPtr == "" {
        cgSetError(ctx, "unresolved method field: " + name);
        return rhs.code;
    }
    var def: StructDef = ctx.structDefs.get(ctx.methodStructKey);
    var field: StructFieldDef = def.fields[index];
    var gep = nextTemp(ctx);
    var code = rhs.code + gep + " = getelementptr inbounds " + def.llvmName + ", " + def.llvmName + "* " + ctx.methodSelfPtr + ", i32 0, i32 " + index.toString() + "\n";
    if op != "=" {
        if field.ty != "i64" || rhs.ty != "i64" {
            cgSetError(ctx, "compound field assignment requires int operands");
            return code;
        }
        var current = nextTemp(ctx);
        code = code + current + " = load i64, i64* " + gep + "\n";
        var compoundOp = "+";
        if op == "-=" { compoundOp = "-"; }
        if op == "*=" { compoundOp = "*"; }
        if op == "/=" { compoundOp = "/"; }
        if op == "%=" { compoundOp = "%"; }
        if compoundOp == "/" || compoundOp == "%" {
            var quotient: GenExprResult = cgCheckedDivRem(ctx, compoundOp, current, rhs.val);
            code = code + quotient.code + "store i64 " + quotient.val + ", i64* " + gep + "\n";
        } else {
            var updated: GenExprResult = cgCheckedIntBin(ctx, compoundOp, current, rhs.val);
            code = code + updated.code + "store i64 " + updated.val + ", i64* " + gep + "\n";
        }
        return code;
    }
    var stored: GenExprResult = cgCallCoerceStore(ctx, field.ty, rhs.val, rhs.ty, "");
    return code + stored.code + "store " + field.ty + " " + stored.val + ", " + field.ty + "* " + gep + "\n";
}

func cgCallEmitUnaryFloat(ctx: CodegenContext, expr: Expr, call: CallExpr, intrinsic: string): GenExprResult {
    if call.args.len() != 1 { return cgErrorExprAt(ctx, expr, intrinsic + " requires one argument"); }
    var arg: GenExprResult = genExprValue(ctx, call.args[0]);
    var asDouble: GenExprResult = cgAsDouble(ctx, call.args[0], arg);
    var code = asDouble.code;
    if intrinsic == "sqrt" {
        var negative = nextTemp(ctx);
        code = code + negative + " = fcmp olt double " + asDouble.val + ", 0.0\n";
        code = code + cgPanicGuard(ctx, negative, "sqrt domain error");
    }
    if intrinsic == "log" {
        var nonPositive = nextTemp(ctx);
        code = code + nonPositive + " = fcmp ole double " + asDouble.val + ", 0.0\n";
        code = code + cgPanicGuard(ctx, nonPositive, "log domain error");
    }
    var result = nextTemp(ctx);
    code = code + result + " = call double @llvm." + intrinsic + ".f64(double " + asDouble.val + ")\n";
    return GenExprResult { ty: "double", val: result, code: code };
}

func cgCallAppendMethodArg(ctx: CodegenContext, symbol: ResolvedSymbol, argExpr: Expr, arg: GenExprResult, index: int, code: string): GenExprResult {
    var argValue = arg.val;
    var argType = arg.ty;
    var nextCode = code + arg.code;
    var expectedSourceType = cgCheckedTypeName(ctx, symbol.signature.params[index]);
    var expectedType = cgCheckedLLVMType(ctx, symbol.signature.params[index]);
    var argSourceType = cgSourceType(ctx, argExpr);
    var expectedScalar = cgScalarNullableInner(expectedSourceType);
    if expectedScalar != "" && argSourceType == expectedScalar {
        var boxedArg = cgBoxScalar(ctx, expectedScalar, GenExprResult { ty: argType, val: argValue, code: "" });
        nextCode = nextCode + boxedArg.code;
        argValue = boxedArg.val;
        argType = boxedArg.ty;
    }
    if expectedType != argType {
        var coerced: GenExprResult = cgCallCoerceStore(ctx, expectedType, argValue, argType, "");
        if coerced.ty != expectedType || (coerced.val == argValue && argType != expectedType) {
            return cgErrorExpr(ctx, "call argument type mismatch for " + symbol.sourceName + " parameter " + index.toString() + " (expected " + expectedSourceType + ")");
        }
        nextCode = nextCode + coerced.code;
        argValue = coerced.val;
        argType = coerced.ty;
    }
    return GenExprResult { ty: argType, val: argValue, code: nextCode };
}

func cgCallEmitMethod(ctx: CodegenContext, call: CallExpr, receiver: Expr, symbol: ResolvedSymbol): GenExprResult {
    if symbol.llvmName == "" || symbol.signature.kind != "Function" {
        return cgErrorExpr(ctx, "checked method has no LLVM symbol: " + symbol.sourceName);
    }
    if symbol.callShape.fixedCount != call.args.len() || symbol.callShape.variadicIndex >= 0 {
        return cgErrorExpr(ctx, "call arity does not match resolved signature: " + symbol.sourceName);
    }
    var maybeReturn = symbol.signature.ret;
    if maybeReturn != null {
    var returnType: Type = maybeReturn;
    var retTy = cgCheckedLLVMType(ctx, returnType);
    var selfExpected = cgCheckedLLVMType(ctx, symbol.receiverType);
    var selfValue: GenExprResult = genExprValue(ctx, receiver);
    var selfArg = selfValue.val;
    var selfTy = selfValue.ty;
    var code = selfValue.code;
    if selfExpected.endsWith("*") && selfTy == "i64" {
        var castSelf = nextTemp(ctx);
        code = code + castSelf + " = inttoptr i64 " + selfArg + " to " + selfExpected + "\n";
        selfArg = castSelf;
        selfTy = selfExpected;
    } else if selfExpected.endsWith("*") && selfTy.endsWith("*") && selfTy != selfExpected {
        var bitcastSelf = nextTemp(ctx);
        code = code + bitcastSelf + " = bitcast " + selfTy + " " + selfArg + " to " + selfExpected + "\n";
        selfArg = bitcastSelf;
        selfTy = selfExpected;
    } else if selfTy != selfExpected {
        return cgErrorExpr(ctx, "method receiver layout mismatch: " + symbol.sourceName);
    }
    var argsOut = selfTy + " " + selfArg;
    var argIndex = 0;
    loop {
        if argIndex >= call.args.len() { break; }
        var arg: GenExprResult = genExprValue(ctx, call.args[argIndex]);
        var prepared: GenExprResult = cgCallAppendMethodArg(ctx, symbol, call.args[argIndex], arg, argIndex, "");
        code = code + prepared.code;
        argsOut = argsOut + ", " + prepared.ty + " " + prepared.val;
        argIndex = argIndex + 1;
    }
    if retTy == "void" {
        return GenExprResult { ty: "void", val: "0", code: code + "call void @" + symbol.llvmName + "(" + argsOut + ")\n" };
    }
    var result = nextTemp(ctx);
    code = code + result + " = call " + retTy + " @" + symbol.llvmName + "(" + argsOut + ")\n";
    return GenExprResult { ty: retTy, val: result, code: code };
    }
    return cgErrorExpr(ctx, "checked method has no return type: " + symbol.sourceName);
}

func cgCallFindMethodSymbol(ctx: CodegenContext, sourcePath: string, moduleId: string, structName: string, methodName: string): ResolvedSymbol? {
    var qualified = structName + "." + methodName;
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
    var checkedProgram: CheckedProgram = maybeProgram;
    var found: ResolvedSymbol? = null;
    var index = 0;
    loop {
        if index >= checkedProgram.symbols.len() { break; }
        var symbol: ResolvedSymbol = checkedProgram.symbols[index];
        if symbol.sourcePath == sourcePath && symbol.moduleId == moduleId && symbol.sourceName == qualified && symbol.kind == "Function" && symbol.receiverPassing == "HiddenFirstArg" {
            if found != null {
                cgSetError(ctx, "ambiguous resolved method identity: " + qualified);
                return null;
            }
            found = symbol;
        }
        index = index + 1;
    }
    return found;
    }
    return null;
}

func cgCheckedFloatBin(ctx: CodegenContext, op: string, leftExpr: Expr, rightExpr: Expr, leftValue: GenExprResult, rightValue: GenExprResult): GenExprResult {
    var left: GenExprResult = cgAsDouble(ctx, leftExpr, leftValue);
    var right: GenExprResult = cgAsDouble(ctx, rightExpr, rightValue);
    var code = left.code + right.code;
    if op == "/" || op == "%" {
        var isZero = nextTemp(ctx);
        code = code + isZero + " = fcmp oeq double " + right.val + ", 0.0\n";
        var message = "division by zero";
        if op == "%" { message = "remainder by zero"; }
        code = code + cgPanicGuard(ctx, isZero, message);
    }
    var instruction = "fadd";
    if op == "-" { instruction = "fsub"; }
    if op == "*" { instruction = "fmul"; }
    if op == "/" { instruction = "fdiv"; }
    if op == "%" { instruction = "frem"; }
    var result = nextTemp(ctx);
    code = code + result + " = " + instruction + " double " + left.val + ", " + right.val + "\n";
    return GenExprResult { ty: "double", val: result, code: code };
}

func cgCheckedFloatCompare(ctx: CodegenContext, op: string, leftExpr: Expr, rightExpr: Expr, leftValue: GenExprResult, rightValue: GenExprResult): GenExprResult {
    var left: GenExprResult = cgAsDouble(ctx, leftExpr, leftValue);
    var right: GenExprResult = cgAsDouble(ctx, rightExpr, rightValue);
    var predicate = "oeq";
    if op == "!=" { predicate = "une"; }
    if op == "<" { predicate = "olt"; }
    if op == ">" { predicate = "ogt"; }
    if op == "<=" { predicate = "ole"; }
    if op == ">=" { predicate = "oge"; }
    var result = nextTemp(ctx);
    var code = left.code + right.code + result + " = fcmp " + predicate + " double " + left.val + ", " + right.val + "\n";
    return GenExprResult { ty: "i1", val: result, code: code };
}

func cgRenderToString(ctx: CodegenContext, expr: Expr, value: GenExprResult): GenExprResult {
    var sourceType = cgSourceType(ctx, expr);
    // kind ids mirror REY_VALUE_*; the payload representation follows the checked source type.
    var payload = "0";
    var code = value.code;
    var kind = 0;
    if sourceType == "int" && value.ty == "i64" {
        kind = 4097;
        payload = value.val;
    } else if sourceType == "bool" && (value.ty == "i1" || value.ty == "i64") {
        kind = 4098;
        payload = value.val;
        if value.ty == "i1" {
            var extended = nextTemp(ctx);
            code = code + extended + " = zext i1 " + value.val + " to i64\n";
            payload = extended;
        }
    } else if sourceType == "float" && value.ty == "double" {
        kind = 4099;
        var bits = nextTemp(ctx);
        code = code + bits + " = bitcast double " + value.val + " to i64\n";
        payload = bits;
    } else if sourceType == "string" {
        kind = 4100;
        var stringValue = cgAsStringValue(ctx, expr, value);
        code = stringValue.code;
        var stringPayload = nextTemp(ctx);
        code = code + stringPayload + " = ptrtoint i8* " + stringValue.val + " to i64\n";
        payload = stringPayload;
    } else if sourceType == "char" {
        kind = 4101;
        var charValue = cgAsStringValue(ctx, expr, value);
        code = charValue.code;
        var byte = nextTemp(ctx);
        code = code + byte + " = load i8, i8* " + charValue.val + "\n";
        var bytePayload = nextTemp(ctx);
        code = code + bytePayload + " = zext i8 " + byte + " to i64\n";
        payload = bytePayload;
    } else if sourceType == "null" {
        kind = 4102;
    } else if sourceType == "any" && value.ty == "i64" {
        var anyText = nextTemp(ctx);
        code = code + anyText + " = call i8* @rey_value_to_str(i64 " + value.val + ")\n";
        return GenExprResult { ty: "i8*", val: anyText, code: code };
    } else if cgTupleCount(sourceType) >= 0 && value.ty == "i64" {
        var tupleText = nextTemp(ctx);
        code = code + tupleText + " = call i8* @rey_tuple_to_str(i64 " + value.val + ")\n";
        return GenExprResult { ty: "i8*", val: tupleText, code: code };
    } else if sourceType.startsWith("Vec<") && value.ty == "i64" {
        var vecText = nextTemp(ctx);
        code = code + vecText + " = call i8* @rey_vec_to_str(i64 " + value.val + ")\n";
        return GenExprResult { ty: "i8*", val: vecText, code: code };
    } else if sourceType.startsWith("HashMap<") && value.ty == "i64" {
        var mapText = nextTemp(ctx);
        code = code + mapText + " = call i8* @rey_hm_to_str(i64 " + value.val + ")\n";
        return GenExprResult { ty: "i8*", val: mapText, code: code };
    } else if sourceType.startsWith("Option<") && value.ty == "i64" {
        var optionText = nextTemp(ctx);
        code = code + optionText + " = call i8* @rey_option_to_str(i64 " + value.val + ")\n";
        return GenExprResult { ty: "i8*", val: optionText, code: code };
    } else if sourceType.startsWith("Result<") && value.ty == "i64" {
        var resultText = nextTemp(ctx);
        code = code + resultText + " = call i8* @rey_result_to_str(i64 " + value.val + ")\n";
        return GenExprResult { ty: "i8*", val: resultText, code: code };
    } else {
        var printEnumKey = sourceType;
        if !ctx.enumDefs.has(printEnumKey) { printEnumKey = cgResolveNominalKey(ctx, "Enum", sourceType); }
        if printEnumKey != "" && ctx.enumDefs.has(printEnumKey) && (value.ty == "i64" || value.ty.endsWith("*")) {
            var enumBits = value.val;
            if value.ty.endsWith("*") {
                var enumCast = nextTemp(ctx);
                code = code + enumCast + " = ptrtoint " + value.ty + " " + value.val + " to i64\n";
                enumBits = enumCast;
            }
            var enumText = nextTemp(ctx);
            code = code + enumText + " = call i8* @rey_enum_to_str(i64 " + enumBits + ")\n";
            return GenExprResult { ty: "i8*", val: enumText, code: code };
        }
        var printStructKey = sourceType;
        if !ctx.structDefs.has(printStructKey) { printStructKey = cgResolveNominalKey(ctx, "Struct", sourceType); }
        if printStructKey != "" && ctx.structDefs.has(printStructKey) && (value.ty == "i64" || value.ty.endsWith("*")) {
            var structBits = value.val;
            if value.ty.endsWith("*") {
                var structCast = nextTemp(ctx);
                code = code + structCast + " = ptrtoint " + value.ty + " " + value.val + " to i64\n";
                structBits = structCast;
            }
            var structText = nextTemp(ctx);
            code = code + structText + " = call i8* @rey_val_to_str(i64 " + structBits + ")\n";
            return GenExprResult { ty: "i8*", val: structText, code: code };
        }
        return cgErrorExprAt(ctx, expr, "unsupported value in print argument: " + sourceType);
    }
    var text = nextTemp(ctx);
    code = code + text + " = call i8* @rey_typed_val_to_str(i64 " + kind.toString() + ", i64 " + payload + ")\n";
    return GenExprResult { ty: "i8*", val: text, code: code };
}

func cgEmitText(ctx: CodegenContext, call: CallExpr, stderr: bool, newline: bool): string {
    var code = "";
    var pieces: Vec<string> = [];
    var i = 0;
    loop {
        if i >= call.args.len() { break; }
        var arg: GenExprResult = genExprValue(ctx, call.args[i]);
        var rendered: GenExprResult = cgRenderToString(ctx, call.args[i], arg);
        code = code + rendered.code;
        pieces.push(rendered.val);
        i = i + 1;
    }
    var printFn = "rey_print";
    var printlnFn = "rey_println";
    if stderr {
        printFn = "rey_eprint";
        printlnFn = "rey_eprintln";
    }
    i = 0;
    loop {
        if i >= pieces.len() { break; }
        if i > 0 {
            var separatorIndex = cgInternString(ctx, " ");
            var separatorInfo: CStringInfo = llvmCStringInfo(" ");
            var separator = nextTemp(ctx);
            code = code + separator + " = call i8* @rey_str_new(i8* " + llvmStrPtr(separatorIndex, separatorInfo.len) + ", i64 1)\n";
            code = code + "call void @" + printFn + "(i8* " + separator + ")\n";
        }
        code = code + "call void @" + printFn + "(i8* " + pieces[i] + ")\n";
        i = i + 1;
    }
    if newline {
        var empty = nextTemp(ctx);
        code = code + empty + " = call i8* @rey_str_empty()\n";
        code = code + "call void @" + printlnFn + "(i8* " + empty + ")\n";
    }
    return code;
}

func cgEmitResolvedCall(ctx: CodegenContext, call: CallExpr, symbol: ResolvedSymbol): GenExprResult {
    if symbol.kind != "Function" && symbol.kind != "StaticCreate" {
        return cgErrorExpr(ctx, "resolved call target is not a top-level function: " + symbol.sourceName);
    }
    if symbol.llvmName == "" || symbol.signature.kind != "Function" {
        return cgErrorExpr(ctx, "checked call target has no resolved signature or mangled symbol: " + symbol.sourceName);
    }
    if symbol.callShape.fixedCount != call.args.len() || symbol.callShape.variadicIndex >= 0 || symbol.callShape.requiredCount != symbol.callShape.fixedCount {
        return cgFnEmitAdaptedCall(ctx, call, symbol);
    }
    var maybeRet = symbol.signature.ret;
    if maybeRet != null {
        var retType: Type = maybeRet;
        return cgEmitResolvedCallWithReturn(ctx, call, symbol, retType);
    }
    return cgErrorExpr(ctx, "checked call has no return type: " + symbol.sourceName);
}

func cgEmitResolvedCallWithReturn(ctx: CodegenContext, call: CallExpr, symbol: ResolvedSymbol, retType: Type): GenExprResult {
    var retTy = cgCheckedLLVMType(ctx, retType);
    var code = "";
    var argsOut = "";
    var i = 0;
    loop {
        if i >= call.args.len() { break; }
        var arg: GenExprResult = genExprValue(ctx, call.args[i]);
        code = code + arg.code;
        var argValue = arg.val;
        var argType = arg.ty;
        var expectedSourceType = cgCheckedTypeName(ctx, symbol.signature.params[i]);
        var expectedType = cgCheckedLLVMType(ctx, symbol.signature.params[i]);
        var argSourceType = cgSourceType(ctx, call.args[i]);
        var expectedScalar = cgScalarNullableInner(expectedSourceType);
        if expectedScalar != "" && argSourceType == expectedScalar {
            var boxedArg = cgBoxScalar(ctx, expectedScalar, GenExprResult { ty: argType, val: argValue, code: "" });
            code = code + boxedArg.code;
            argValue = boxedArg.val;
            argType = boxedArg.ty;
        }
        if expectedType != argType {
            if expectedType == "i64" && argType.endsWith("*") {
                var pointerToInt = nextTemp(ctx);
                code = code + pointerToInt + " = ptrtoint " + argType + " " + argValue + " to i64\n";
                argValue = pointerToInt;
                argType = "i64";
            } else if expectedType == "i64" && argType == "i1" {
                var boolToInt = nextTemp(ctx);
                code = code + boolToInt + " = zext i1 " + argValue + " to i64\n";
                argValue = boolToInt;
                argType = "i64";
            } else if expectedType.endsWith("*") && argType == "i64" {
                var intToPointer = nextTemp(ctx);
                code = code + intToPointer + " = inttoptr i64 " + argValue + " to " + expectedType + "\n";
                argValue = intToPointer;
                argType = expectedType;
            } else if expectedType == "double" && argType == "i64" {
                var intToFloat = nextTemp(ctx);
                code = code + intToFloat + " = sitofp i64 " + argValue + " to double\n";
                argValue = intToFloat;
                argType = "double";
            } else {
                return cgErrorExpr(ctx, "call argument type mismatch for " + symbol.sourceName + " parameter " + i.toString() + " (expected " + expectedSourceType + ")");
            }
        }
        if i > 0 { argsOut = argsOut + ", "; }
        argsOut = argsOut + argType + " " + argValue;
        i = i + 1;
    }
    if retTy == "void" {
        return GenExprResult { ty: "void", val: "0", code: code + "call void @" + symbol.llvmName + "(" + argsOut + ")\n" };
    }
    var result = nextTemp(ctx);
    code = code + result + " = call " + retTy + " @" + symbol.llvmName + "(" + argsOut + ")\n";
    return GenExprResult { ty: retTy, val: result, code: code };
}

func cgInternString(ctx: CodegenContext, s: string): int {
    var i = 0;
    loop {
        if i >= ctx.strings.len() {
            break;
        }
        if ctx.strings[i] == s {
            return i;
        }
        i = i + 1;
    }
    ctx.strings.push(s);
    return ctx.strings.len() - 1;
}

func llvmEscapeByte(c: string): string {
    if c == "\n" { return "\\0A"; }
    if c == "\r" { return "\\0D"; }
    if c == "\t" { return "\\09"; }
    if c == "\"" { return "\\22"; }
    if c == "\\" { return "\\5C"; }
    return c;
}

func llvmCStringInfo(s: string) {
    var out = "";
    var i = 0;
    var n = 0;
    loop {
        if i >= s.len() {
            break;
        }
        var c = s.slice(i, i + 1);
        out = out + llvmEscapeByte(c);
        n = n + 1;
        i = i + 1;
    }
    // null terminator
    out = out + "\\00";
    n = n + 1;
    return CStringInfo { escaped: out, len: n };
}

func llvmStrGlobalName(idx: int): string {
    return "@.str" + idx.toString();
}

func llvmStrPtr(idx: int, len: int): string {
    return "getelementptr inbounds ([" + len.toString() + " x i8], [" + len.toString() + " x i8]* " + llvmStrGlobalName(idx) + ", i64 0, i64 0)";
}

func nextTemp(ctx: CodegenContext): string {
    var n = ctx.blockId;
    ctx.blockId = ctx.blockId + 1;
    return "%t" + n.toString();
}

func nextLabel(ctx: CodegenContext, prefix: string): string {
    var n = ctx.blockId;
    ctx.blockId = ctx.blockId + 1;
    return prefix + n.toString();
}

func llvmTypeFromTagCtx(ctx: CodegenContext, tag: string): string {
    if tag == "" { return "i64"; }
    if tag == "int" { return "i64"; }
    if tag == "float" { return "double"; }
    if tag == "bool" { return "i64"; }
    if tag == "char" { return "i8*"; }
    if tag == "string" || tag == "String" { return "i8*"; }
    if tag == "void" || tag == "Void" { return "void"; }
    if cgScalarNullableInner(tag) != "" { return "i64"; }
    if tag.indexOf(" -> ") >= 0 || tag.indexOf(" | ") >= 0 { return "i64"; }
    if tag.endsWith("?") && tag.len() > 1 {
        var nullableInnerTag = tag.slice(0, tag.len() - 1);
        var nullableInnerLlvm = llvmTypeFromTagCtx(ctx, nullableInnerTag);
        if nullableInnerLlvm.endsWith("*") { return nullableInnerLlvm; }
    }
    var structKey = tag;
    if !ctx.structDefs.has(structKey) { structKey = cgResolveNominalKey(ctx, "Struct", tag); }
    if structKey != "" && ctx.structDefs.has(structKey) {
        var def: StructDef = ctx.structDefs.get(structKey);
        return def.llvmName + "*";
    }
    var enumKey = tag;
    if !ctx.enumDefs.has(enumKey) { enumKey = cgResolveNominalKey(ctx, "Enum", tag); }
    if enumKey != "" && ctx.enumDefs.has(enumKey) { return "i64"; }
    if cgTupleCount(tag) >= 0 { return "i64"; }
    return "i64";
}
func llvmTypeFromTag(tag: string): string {
    return llvmTypeFromTagCtx(ctxNew("tmp"), tag);
}

func blockEndsWithReturn(block: BlockStmt): bool {
    if block.statements.len() == 0 { return false; }
    var last: Stmt = block.statements[block.statements.len() - 1];
    match last {
        Stmt::Return(_) => { return true; },
        Stmt::VarDecl(_) => { return false; },
        Stmt::ConstDecl(_) => { return false; },
        Stmt::FuncDecl(_) => { return false; },
        Stmt::StructDecl(_) => { return false; },
        Stmt::EnumDecl(_) => { return false; },
        Stmt::Import(_) => { return false; },
        Stmt::If(_) => { return false; },
        Stmt::Assign(_) => { return false; },
        Stmt::Break(_) => { return false; },
        Stmt::Continue(_) => { return false; },
        Stmt::While(_) => { return false; },
        Stmt::For(_) => { return false; },
        Stmt::Loop(_) => { return false; },
        Stmt::Block(_) => { return false; },
        Stmt::ExprStmt(_) => { return false; },
        Stmt::Match(_) => { return false; },
    }
    return false;
}

func stmtIsTerminator(stmt: Stmt): bool {
    match stmt {
        Stmt::Return(_) => { return true; },
        Stmt::Break(_) => { return true; },
        Stmt::Continue(_) => { return true; },
        Stmt::ExprStmt(exprStmt) => {
            var callOption = cgExprCall(exprStmt.expr);
            if callOption != null {
                var call: CallExpr = callOption;
                var identifierOption = cgExprIdentifier(call.callee);
                if identifierOption != null {
                    var ident: IdentExpr = identifierOption;
                    if ident.name == "exit" { return true; }
                }
            }
            return false;
        },
        Stmt::VarDecl(_) => { return false; },
        Stmt::ConstDecl(_) => { return false; },
        Stmt::FuncDecl(_) => { return false; },
        Stmt::StructDecl(_) => { return false; },
        Stmt::EnumDecl(_) => { return false; },
        Stmt::Import(_) => { return false; },
        Stmt::If(_) => { return false; },
        Stmt::Assign(_) => { return false; },
        Stmt::While(_) => { return false; },
        Stmt::For(_) => { return false; },
        Stmt::Loop(_) => { return false; },
        Stmt::Block(_) => { return false; },
        Stmt::Match(_) => { return false; },
    }
    return false;
}

func blockEndsWithTerminator(block: BlockStmt): bool {
    if block.statements.len() == 0 { return false; }
    var last: Stmt = block.statements[block.statements.len() - 1];
    return stmtIsTerminator(last);
}

func stmtListEndsWithTerminator(statements: Vec<Stmt>): bool {
    if statements.len() == 0 { return false; }
    var last: Stmt = statements[statements.len() - 1];
    return stmtIsTerminator(last);
}

func genStmtList(ctx: CodegenContext, statements: Vec<Stmt>): string {
    var out = "";
    var i = 0;
    loop {
        if i >= statements.len() { break; }
        var item: Stmt = statements[i];
        out = out + genStmt2(ctx, item);
        if stmtIsTerminator(item) { break; }
        i = i + 1;
    }
    return out;
}

func cgUnpackSlot(ctx: CodegenContext, sourceType: string, raw: string, code: string): GenExprResult {
    if sourceType == "float" {
        var floatValue = nextTemp(ctx);
        return GenExprResult { ty: "double", val: floatValue, code: code + floatValue + " = bitcast i64 " + raw + " to double\n" };
    }
    if sourceType == "string" {
        var stringValue = nextTemp(ctx);
        return GenExprResult { ty: "i8*", val: stringValue, code: code + stringValue + " = inttoptr i64 " + raw + " to i8*\n" };
    }
    if sourceType == "char" {
        var byte = nextTemp(ctx);
        var slot = nextTemp(ctx);
        var text = nextTemp(ctx);
        var charCode = code + byte + " = trunc i64 " + raw + " to i8\n";
        charCode = charCode + slot + " = alloca i8, align 1\n";
        charCode = charCode + "store i8 " + byte + ", i8* " + slot + "\n";
        charCode = charCode + text + " = call i8* @rey_str_new(i8* " + slot + ", i64 1)\n";
        return GenExprResult { ty: "i8*", val: text, code: charCode };
    }
    if ctx.structDefs.has(sourceType) {
        var structDef: StructDef = ctx.structDefs.get(sourceType);
        var structValue = nextTemp(ctx);
        return GenExprResult { ty: structDef.llvmName + "*", val: structValue, code: code + structValue + " = inttoptr i64 " + raw + " to " + structDef.llvmName + "*\n" };
    }
    if sourceType == "bool" {
        var boolValue = nextTemp(ctx);
        return GenExprResult { ty: "i1", val: boolValue, code: code + boolValue + " = trunc i64 " + raw + " to i1\n" };
    }
    if sourceType == "int" || sourceType == "null" || cgTupleCount(sourceType) >= 0 || ctx.enumDefs.has(sourceType) || sourceType.startsWith("Vec<") || sourceType.startsWith("HashMap<") || sourceType.startsWith("Option<") || sourceType.startsWith("Result<") {
        return GenExprResult { ty: "i64", val: raw, code: code };
    }
    return cgErrorExpr(ctx, "tuple element type is unsupported: " + sourceType);
}

func cgEmitTuple(ctx: CodegenContext, tupleExpr: TupleExpr): GenExprResult {
    var tupleValue = nextTemp(ctx);
    var code = tupleValue + " = call i64 @rey_tuple_new(i64 " + tupleExpr.elements.len().toString() + ")\n";
    var i = 0;
    loop {
        if i >= tupleExpr.elements.len() { break; }
        var element: Expr = tupleExpr.elements[i];
        var value: GenExprResult = genExprValue(ctx, element);
        code = code + value.code;
        var sourceType = cgSourceType(ctx, element);
        var kind = cgValueKind(ctx, sourceType);
        if kind < 0 { return cgErrorExpr(ctx, "tuple element type is unsupported: " + sourceType); }
        var raw = value.val;
        if sourceType == "float" {
            if value.ty != "double" { return cgErrorExpr(ctx, "float tuple element has unsupported LLVM representation"); }
            var bits = nextTemp(ctx);
            code = code + bits + " = bitcast double " + value.val + " to i64\n";
            raw = bits;
        } else if sourceType == "char" {
            if value.ty != "i8*" { return cgErrorExpr(ctx, "char tuple element has unsupported LLVM representation"); }
            var byte = nextTemp(ctx);
            var extended = nextTemp(ctx);
            code = code + byte + " = load i8, i8* " + value.val + "\n";
            code = code + extended + " = zext i8 " + byte + " to i64\n";
            raw = extended;
        } else if sourceType == "string" || ctx.structDefs.has(sourceType) {
            if !value.ty.endsWith("*") { return cgErrorExpr(ctx, "reference tuple element has unsupported LLVM representation"); }
            var bits2 = nextTemp(ctx);
            code = code + bits2 + " = ptrtoint " + value.ty + " " + value.val + " to i64\n";
            raw = bits2;
        } else if value.ty == "i1" {
            var bits3 = nextTemp(ctx);
            code = code + bits3 + " = zext i1 " + value.val + " to i64\n";
            raw = bits3;
        } else if value.ty != "i64" {
            return cgErrorExpr(ctx, "tuple element has unsupported LLVM representation: " + sourceType);
        }
        code = code + "call void @rey_tuple_set(i64 " + tupleValue + ", i64 " + i.toString() + ", i64 " + kind.toString() + ", i64 " + raw + ")\n";
        i = i + 1;
    }
    return GenExprResult { ty: "i64", val: tupleValue, code: code };
}

func cgEmitShortCircuit(ctx: CodegenContext, op: string, leftExpr: Expr, rightExpr: Expr): GenExprResult {
    if cgSourceType(ctx, leftExpr) != "bool" || cgSourceType(ctx, rightExpr) != "bool" {
        return cgErrorExpr(ctx, "logical operators require bool operands");
    }
    var left: GenExprResult = genExprValue(ctx, leftExpr);
    var code = left.code;
    var leftBool = left.val;
    if left.ty == "i64" {
        var leftCmp = nextTemp(ctx);
        code = code + leftCmp + " = icmp ne i64 " + left.val + ", 0\n";
        leftBool = leftCmp;
    } else if left.ty != "i1" {
        return cgErrorExpr(ctx, "logical operands have unsupported LLVM types");
    }
    var slot = cgFreshLocalPtr(ctx, "logic");
    ctx.funcAllocas = ctx.funcAllocas + slot + " = alloca i1, align 1\n";
    var rightLabel = nextLabel(ctx, "logic.right");
    var shortLabel = nextLabel(ctx, "logic.short");
    var endLabel = nextLabel(ctx, "logic.end");
    if op == "&&" {
        code = code + "br i1 " + leftBool + ", label %" + rightLabel + ", label %" + shortLabel + "\n";
    } else {
        code = code + "br i1 " + leftBool + ", label %" + shortLabel + ", label %" + rightLabel + "\n";
    }
    var shortValue = "false";
    if op == "||" { shortValue = "true"; }
    code = code + shortLabel + ":\n";
    code = code + "store i1 " + shortValue + ", i1* " + slot + "\n";
    code = code + "br label %" + endLabel + "\n";
    code = code + rightLabel + ":\n";
    var right: GenExprResult = genExprValue(ctx, rightExpr);
    code = code + right.code;
    var rightBool = right.val;
    if right.ty == "i64" {
        var rightCmp = nextTemp(ctx);
        code = code + rightCmp + " = icmp ne i64 " + right.val + ", 0\n";
        rightBool = rightCmp;
    } else if right.ty != "i1" {
        return cgErrorExpr(ctx, "logical operands have unsupported LLVM types");
    }
    code = code + "store i1 " + rightBool + ", i1* " + slot + "\n";
    code = code + "br label %" + endLabel + "\n";
    code = code + endLabel + ":\n";
    var result = nextTemp(ctx);
    code = code + result + " = load i1, i1* " + slot + "\n";
    return GenExprResult { ty: "i1", val: result, code: code };
}

func cgEmitOwnedString(ctx: CodegenContext, text: string): GenExprResult {
    var idx = cgInternString(ctx, text);
    var info: CStringInfo = llvmCStringInfo(text);
    var tmp = nextTemp(ctx);
    var code = tmp + " = call i8* @rey_str_new(i8* " + llvmStrPtr(idx, info.len) + ", i64 " + (info.len - 1).toString() + ")\n";
    return GenExprResult { ty: "i8*", val: tmp, code: code };
}

func cgEmitDict(ctx: CodegenContext, dict: DictExpr, sourceType: string): GenExprResult {
    if dict.entries.len() > 0 {
        var valueType = cgHashMapValueType(sourceType);
        if valueType == "any" || valueType.indexOf(" | ") >= 0 {
            return cgErrorExpr(ctx, "native dictionary literals with any or union value types are not supported");
        }
    }
    var slot = nextTemp(ctx);
    var code = slot + " = call i64 @rey_hm_new()\n";
    var i = 0;
    loop {
        if i >= dict.entries.len() { break; }
        var entry: DictEntry = dict.entries[i];
        var keyIdent = cgExprIdentifier(entry.key);
        if keyIdent != null {
            var identKey: IdentExpr = keyIdent;
            var keyString: GenExprResult = cgEmitOwnedString(ctx, identKey.name);
            code = code + keyString.code;
            var value: GenExprResult = genExprValue(ctx, entry.value);
            code = code + value.code;
            if value.ty == "double" || cgSourceType(ctx, entry.value) == "float" {
                var floatValue = value.val;
                if value.ty != "double" {
                    var widened = nextTemp(ctx);
                    code = code + widened + " = sitofp i64 " + value.val + " to double\n";
                    floatValue = widened;
                }
                code = code + "call void @rey_hm_set_float(i64 " + slot + ", i8* " + keyString.val + ", double " + floatValue + ")\n";
                i = i + 1;
                continue;
            }
            var boxed = value.val;
            if value.ty == "i1" {
                var extended = nextTemp(ctx);
                code = code + extended + " = zext i1 " + value.val + " to i64\n";
                boxed = extended;
            } else if value.ty.endsWith("*") {
                var bits = nextTemp(ctx);
                code = code + bits + " = ptrtoint " + value.ty + " " + value.val + " to i64\n";
                boxed = bits;
            } else if value.ty != "i64" {
                return cgErrorExpr(ctx, "dictionary value has no codegen representation");
            }
            code = code + "call void @rey_hm_set(i64 " + slot + ", i8* " + keyString.val + ", i64 " + boxed + ")\n";
        } else {
            var keyExpr: GenExprResult = genExprValue(ctx, entry.key);
            code = code + keyExpr.code;
            if keyExpr.ty != "i8*" {
                return cgErrorExpr(ctx, "dictionary keys must be strings");
            }
            var value2: GenExprResult = genExprValue(ctx, entry.value);
            code = code + value2.code;
            if value2.ty == "double" || cgSourceType(ctx, entry.value) == "float" {
                var floatValue2 = value2.val;
                if value2.ty != "double" {
                    var widened2 = nextTemp(ctx);
                    code = code + widened2 + " = sitofp i64 " + value2.val + " to double\n";
                    floatValue2 = widened2;
                }
                code = code + "call void @rey_hm_set_float(i64 " + slot + ", i8* " + keyExpr.val + ", double " + floatValue2 + ")\n";
                i = i + 1;
                continue;
            }
            var boxed2 = value2.val;
            if value2.ty == "i1" {
                var extended2 = nextTemp(ctx);
                code = code + extended2 + " = zext i1 " + value2.val + " to i64\n";
                boxed2 = extended2;
            } else if value2.ty.endsWith("*") {
                var bits2 = nextTemp(ctx);
                code = code + bits2 + " = ptrtoint " + value2.ty + " " + value2.val + " to i64\n";
                boxed2 = bits2;
            } else if value2.ty != "i64" {
                return cgErrorExpr(ctx, "dictionary value has no codegen representation");
            }
            code = code + "call void @rey_hm_set(i64 " + slot + ", i8* " + keyExpr.val + ", i64 " + boxed2 + ")\n";
        }
        i = i + 1;
    }
    return GenExprResult { ty: "i64", val: slot, code: code };
}

func cgFnIsUnion(source: string): bool { return source.indexOf(" | ") >= 0; }

func cgUnionNominal(ctx: CodegenContext, source: string): int {
    var structKey = source;
    if !ctx.structTags.has(structKey) { structKey = cgResolveNominalKey(ctx, "Struct", source); }
    if structKey != "" && ctx.structTags.has(structKey) { return ctx.structTags.get(structKey); }
    var enumKey = source;
    if !ctx.enumDefs.has(enumKey) { enumKey = cgResolveNominalKey(ctx, "Enum", source); }
    if enumKey != "" && ctx.enumDefs.has(enumKey) { return cgEnumIdentity(ctx, enumKey); }
    return 0;
}

func cgClosureKind(source: string, llvm: string): int {
    if source == "int" { return 4097; }
    if source == "bool" { return 4098; }
    if source == "float" { return 4099; }
    if source == "string" { return 4100; }
    if source == "char" { return 4101; }
    if source == "null" { return 4102; }
    if source == "any" || cgFnIsUnion(source) { return 4111; }
    if source.indexOf(" -> ") >= 0 { return 4110; }
    if source.indexOf("Vec<") == 0 { return 4105; }
    if source.indexOf("HashMap<") == 0 { return 4106; }
    if source.indexOf("(") == 0 { return 4107; }
    if source.indexOf("Option<") == 0 { return 4108; }
    if source.indexOf("Result<") == 0 { return 4109; }
    if source.indexOf("struct ") == 0 || source.indexOf("Struct") == 0 { return 4103; }
    if source.indexOf("enum ") == 0 || source.indexOf("Enum") == 0 { return 4104; }
    if llvm == "double" { return 4099; }
    if llvm == "i1" { return 4098; }
    if llvm == "i8*" { return 4100; }
    if llvm.endsWith("*") { return 4103; }
    return 4097;
}

func cgClosureToPayload(ctx: CodegenContext, source: string, llvm: string, val: string, valTy: string, code: string): GenExprResult {
    var kind = cgClosureKind(source, llvm);
    if kind == 4099 {
        var bits = nextTemp(ctx);
        if valTy == "double" {
            return GenExprResult { ty: "i64", val: bits, code: code + bits + " = bitcast double " + val + " to i64\n" };
        }
        var widened = nextTemp(ctx);
        var next = code + widened + " = sitofp " + valTy + " " + val + " to double\n";
        return GenExprResult { ty: "i64", val: bits, code: next + bits + " = bitcast double " + widened + " to i64\n" };
    }
    if kind == 4098 && valTy == "i1" {
        var bits = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: bits, code: code + bits + " = zext i1 " + val + " to i64\n" };
    }
    if kind == 4101 && valTy == "i8*" {
        var bytePtr = nextTemp(ctx);
        var byte = nextTemp(ctx);
        var bits = nextTemp(ctx);
        var next = code + bytePtr + " = getelementptr inbounds i8, i8* " + val + ", i64 0\n";
        next = next + byte + " = load i8, i8* " + bytePtr + "\n";
        next = next + bits + " = zext i8 " + byte + " to i64\n";
        return GenExprResult { ty: "i64", val: bits, code: next };
    }
    if valTy.endsWith("*") {
        var bits = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: bits, code: code + bits + " = ptrtoint " + valTy + " " + val + " to i64\n" };
    }
    if valTy == "i64" { return GenExprResult { ty: "i64", val: val, code: code }; }
    if valTy == "i1" {
        var bits = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: bits, code: code + bits + " = zext i1 " + val + " to i64\n" };
    }
    return cgErrorExpr(ctx, "closure payload has no codegen representation");
}

func cgClosureFromPayload(ctx: CodegenContext, source: string, value: string, code: string): GenExprResult {
    var kind = cgClosureKind(source, "");
    if kind == 4099 {
        var number = nextTemp(ctx);
        return GenExprResult { ty: "double", val: number, code: code + number + " = bitcast i64 " + value + " to double\n" };
    }
    if kind == 4100 || kind == 4103 || kind == 4104 || kind == 4105 || kind == 4106 || kind == 4107 || kind == 4108 || kind == 4109 || kind == 4110 || kind == 4111 {
        if kind == 4100 {
            var text = nextTemp(ctx);
            return GenExprResult { ty: "i8*", val: text, code: code + text + " = inttoptr i64 " + value + " to i8*\n" };
        }
    }
    if kind == 4101 {
        var slot = nextTemp(ctx);
        var byte = nextTemp(ctx);
        var text = nextTemp(ctx);
        var next = code + slot + " = alloca i8, align 1\n";
        next = next + byte + " = trunc i64 " + value + " to i8\n";
        next = next + "store i8 " + byte + ", i8* " + slot + "\n";
        next = next + text + " = call i8* @rey_str_new(i8* " + slot + ", i64 1)\n";
        return GenExprResult { ty: "i8*", val: text, code: next };
    }
    if source.indexOf("struct ") == 0 || source.indexOf("Struct") == 0 {
        var pointer = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: pointer, code: code + pointer + " = add i64 " + value + ", 0\n" };
    }
    return GenExprResult { ty: "i64", val: value, code: code };
}

func cgUnionBox(ctx: CodegenContext, memberType: string, value: GenExprResult): GenExprResult {
    if memberType == "any" {
        var inner = cgBoxAny(ctx, "any", value);
        var payload = cgClosureToPayload(ctx, "any", inner.ty, inner.val, inner.ty, inner.code);
        var boxed = nextTemp(ctx);
        return GenExprResult { ty: "i64", val: boxed, code: payload.code + boxed + " = call i64 @rey_value_new(i64 4111, i64 " + payload.val + ")\n" };
    }
    var kind = cgClosureKind(memberType, value.ty);
    var payload = cgClosureToPayload(ctx, memberType, value.ty, value.val, value.ty, value.code);
    var boxed = nextTemp(ctx);
    if kind == 4103 || kind == 4104 {
        var nominal = cgUnionNominal(ctx, memberType);
        return GenExprResult { ty: "i64", val: boxed, code: payload.code + boxed + " = call i64 @rey_value_new_nominal(i64 " + kind.toString() + ", i64 " + payload.val + ", i64 " + nominal.toString() + ")\n" };
    }
    return GenExprResult { ty: "i64", val: boxed, code: payload.code + boxed + " = call i64 @rey_value_new(i64 " + kind.toString() + ", i64 " + payload.val + ")\n" };
}

func cgUnionPrepare(ctx: CodegenContext, targetSource: string, valueSource: string, value: GenExprResult): GenExprResult {
    if !cgFnIsUnion(targetSource) || valueSource == "" || cgFnIsUnion(valueSource) || valueSource == "any" { return value; }
    return cgUnionBox(ctx, valueSource, value);
}

func cgUnionUnbox(ctx: CodegenContext, useType: string, value: string, code: string): GenExprResult {
    var raw = nextTemp(ctx);
    var kind = cgClosureKind(useType, "");
    var next = code + raw + " = call i64 @rey_value_unbox(i64 " + value + ", i64 " + kind.toString() + ")\n";
    if ctx.structDefs.has(useType) {
        var def: StructDef = ctx.structDefs.get(useType);
        var pointer = nextTemp(ctx);
        return GenExprResult { ty: def.llvmName + "*", val: pointer, code: next + pointer + " = inttoptr i64 " + raw + " to " + def.llvmName + "*\n" };
    }
    return cgClosureFromPayload(ctx, useType, raw, next);
}

func cgUnionAdjust(ctx: CodegenContext, storedSource: string, useType: string, storedTy: string, value: string, code: string): GenExprResult {
    if !cgFnIsUnion(storedSource) || useType == "" || useType == "any" || useType == "unsupported" || cgFnIsUnion(useType) {
        return GenExprResult { ty: storedTy, val: value, code: code };
    }
    return cgUnionUnbox(ctx, useType, value, code);
}

func cgFnCoerce(ctx: CodegenContext, expectedTy: string, val: string, valTy: string, code: string): GenExprResult {
    if expectedTy == valTy || expectedTy == "void" { return GenExprResult { ty: expectedTy, val: val, code: code }; }
    var cast = nextTemp(ctx);
    if expectedTy == "i64" && valTy == "i1" {
        return GenExprResult { ty: "i64", val: cast, code: code + cast + " = zext i1 " + val + " to i64\n" };
    }
    if expectedTy == "i1" && valTy == "i64" {
        return GenExprResult { ty: "i1", val: cast, code: code + cast + " = trunc i64 " + val + " to i1\n" };
    }
    if expectedTy == "i64" && valTy.endsWith("*") {
        return GenExprResult { ty: "i64", val: cast, code: code + cast + " = ptrtoint " + valTy + " " + val + " to i64\n" };
    }
    if expectedTy.endsWith("*") && valTy == "i64" {
        return GenExprResult { ty: expectedTy, val: cast, code: code + cast + " = inttoptr i64 " + val + " to " + expectedTy + "\n" };
    }
    if expectedTy == "double" && valTy == "i64" {
        return GenExprResult { ty: "double", val: cast, code: code + cast + " = sitofp i64 " + val + " to double\n" };
    }
    if expectedTy == "i64" && valTy == "double" {
        return GenExprResult { ty: "i64", val: cast, code: code + cast + " = bitcast double " + val + " to i64\n" };
    }
    return cgErrorExpr(ctx, "call argument cannot be coerced");
}

func cgFnFinishReturn(ctx: CodegenContext, retTy: string, value: GenExprResult): string {
    if retTy == "void" { return value.code + "ret void\n"; }
    var coerced = cgFnCoerce(ctx, retTy, value.val, value.ty, value.code);
    return coerced.code + "ret " + retTy + " " + coerced.val + "\n";
}

func cgFnFindDecl(ctx: CodegenContext, symbol: ResolvedSymbol): FuncDeclStmt? {
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
        if symbol.declarationIndex < 0 { return null; }
        var checkedProgram: CheckedProgram = maybeProgram;
        var unitIndex = 0;
        loop {
            if unitIndex >= checkedProgram.units.len() { break; }
            var unit: SourceUnit = checkedProgram.units[unitIndex];
            if unit.sourcePath == symbol.sourcePath && unit.moduleId == symbol.moduleId && symbol.declarationIndex < unit.program.statements.len() {
                var statement: Stmt = unit.program.statements[symbol.declarationIndex];
                match statement {
                    Stmt::FuncDecl(decl) => { return decl; },
                    Stmt::VarDecl(_) => {},
                    Stmt::ConstDecl(_) => {},
                    Stmt::StructDecl(_) => {},
                    Stmt::EnumDecl(_) => {},
                    Stmt::Import(_) => {},
                    Stmt::If(_) => {},
                    Stmt::Assign(_) => {},
                    Stmt::Return(_) => {},
                    Stmt::Break(_) => {},
                    Stmt::Continue(_) => {},
                    Stmt::While(_) => {},
                    Stmt::For(_) => {},
                    Stmt::Loop(_) => {},
                    Stmt::Block(_) => {},
                    Stmt::ExprStmt(_) => {},
                    Stmt::Match(_) => {},
                }
            }
            unitIndex = unitIndex + 1;
        }
    }
    return null;
}

func cgFnPackVariadic(ctx: CodegenContext, call: CallExpr, start: int, elementType: string): GenExprResult {
    var slot = nextTemp(ctx);
    var code = slot + " = call i64 @rey_vec_new()\n";
    var index = start;
    loop {
        if index >= call.args.len() { break; }
        var arg: GenExprResult = genExprValue(ctx, call.args[index]);
        code = code + arg.code;
        if elementType == "float" || arg.ty == "double" {
            var number = arg.val;
            if arg.ty != "double" {
                var widened = cgFnCoerce(ctx, "double", arg.val, arg.ty, "");
                code = code + widened.code;
                number = widened.val;
            }
            code = code + "call void @rey_vec_push_float(i64 " + slot + ", double " + number + ")\n";
        } else {
            var bits = cgFnCoerce(ctx, "i64", arg.val, arg.ty, "");
            code = code + bits.code;
            code = code + "call void @rey_vec_push(i64 " + slot + ", i64 " + bits.val + ")\n";
        }
        index = index + 1;
    }
    return GenExprResult { ty: "i64", val: slot, code: code };
}

func cgFnEmitAdaptedCall(ctx: CodegenContext, call: CallExpr, symbol: ResolvedSymbol): GenExprResult {
    var maybeRet = symbol.signature.ret;
    if maybeRet == null { return cgErrorExpr(ctx, "checked call target has no return type: " + symbol.sourceName); }
    var retType = cgUnwrapType(maybeRet);
    var retTy = cgCheckedLLVMType(ctx, retType);
    if call.args.len() < symbol.callShape.requiredCount || (symbol.callShape.variadicIndex < 0 && call.args.len() > symbol.callShape.fixedCount) {
        return cgErrorExpr(ctx, "call arity does not match resolved signature: " + symbol.sourceName);
    }
    var maybeDecl = cgFnFindDecl(ctx, symbol);
    var code = "";
    var argsOut = "";
    var argIndex = 0;
    var paramIndex = 0;
    loop {
        if paramIndex >= symbol.signature.params.len() { break; }
        var expectedTy = cgCheckedLLVMType(ctx, symbol.signature.params[paramIndex]);
        var expectedSource = cgCheckedTypeName(ctx, symbol.signature.params[paramIndex]);
        var produced = GenExprResult { ty: expectedTy, val: "0", code: "" };
        if symbol.callShape.variadicIndex == paramIndex {
            produced = cgFnPackVariadic(ctx, call, argIndex, cgVecElementType(expectedSource));
            argIndex = call.args.len();
        } else if argIndex < call.args.len() {
            var arg = genExprValue(ctx, call.args[argIndex]);
            produced = cgUnionPrepare(ctx, expectedSource, cgSourceType(ctx, call.args[argIndex]), arg);
            argIndex = argIndex + 1;
        } else {
            if maybeDecl != null {
                var functionDecl: FuncDeclStmt = maybeDecl;
                if paramIndex >= functionDecl.params.len() || !functionDecl.params[paramIndex].hasDefault {
                    return cgErrorExpr(ctx, "default argument is missing for " + symbol.sourceName);
                }
                var defaultValue = genExprValue(ctx, functionDecl.params[paramIndex].default);
                produced = cgUnionPrepare(ctx, expectedSource, cgSourceType(ctx, functionDecl.params[paramIndex].default), defaultValue);
            } else {
                return cgErrorExpr(ctx, "default argument is missing for " + symbol.sourceName);
            }
        }
        var coerced = cgFnCoerce(ctx, expectedTy, produced.val, produced.ty, produced.code);
        code = code + coerced.code;
        if paramIndex > 0 { argsOut = argsOut + ", "; }
        argsOut = argsOut + expectedTy + " " + coerced.val;
        paramIndex = paramIndex + 1;
    }
    var symbolName = symbol.llvmName;
    if symbol.sourceName == "main" && symbolName == "main" { symbolName = "_rey_main"; }
    if retTy == "void" { return GenExprResult { ty: "void", val: "0", code: code + "call void @" + symbolName + "(" + argsOut + ")\n" }; }
    var result = nextTemp(ctx);
    return GenExprResult { ty: retTy, val: result, code: code + result + " = call " + retTy + " @" + symbolName + "(" + argsOut + ")\n" };
}

func cgFnEmitIndirect(ctx: CodegenContext, call: CallExpr, symbol: ResolvedSymbol): GenExprResult {
    if symbol.signature.kind != "Function" || symbol.signature.params.len() != call.args.len() {
        return cgErrorExpr(ctx, "indirect call arity does not match the function type");
    }
    var maybeRet = symbol.signature.ret;
    if maybeRet == null { return cgErrorExpr(ctx, "indirect call is missing a return type"); }
    var retType = cgUnwrapType(maybeRet);
    var retTy = cgCheckedLLVMType(ctx, retType);
    var callee = genExprValue(ctx, call.callee);
    var closure = cgFnCoerce(ctx, "i64", callee.val, callee.ty, callee.code);
    var fnBits = nextTemp(ctx);
    var envBits = nextTemp(ctx);
    var code = closure.code;
    code = code + fnBits + " = call i64 @rey_closure_fn(i64 " + closure.val + ")\n";
    code = code + envBits + " = call i64 @rey_closure_env(i64 " + closure.val + ")\n";
    var fnType = retTy + " (i64";
    var argList = "i64 " + envBits;
    var index = 0;
    loop {
        if index >= call.args.len() { break; }
        var expectedTy = cgCheckedLLVMType(ctx, symbol.signature.params[index]);
        var arg = genExprValue(ctx, call.args[index]);
        var prepared = cgUnionPrepare(ctx, cgCheckedTypeName(ctx, symbol.signature.params[index]), cgSourceType(ctx, call.args[index]), arg);
        var coerced = cgFnCoerce(ctx, expectedTy, prepared.val, prepared.ty, prepared.code);
        code = code + coerced.code;
        fnType = fnType + ", " + expectedTy;
        argList = argList + ", " + expectedTy + " " + coerced.val;
        index = index + 1;
    }
    fnType = fnType + ")";
    var fnPtr = nextTemp(ctx);
    code = code + fnPtr + " = inttoptr i64 " + fnBits + " to " + fnType + "*\n";
    if retTy == "void" { return GenExprResult { ty: "void", val: "0", code: code + "call void " + fnPtr + "(" + argList + ")\n" }; }
    var result = nextTemp(ctx);
    return GenExprResult { ty: retTy, val: result, code: code + result + " = call " + retTy + " " + fnPtr + "(" + argList + ")\n" };
}

func cgFnEmitVecHo(ctx: CodegenContext, call: CallExpr, method: string, vecVal: string, code: string, argVals: Vec<GenExprResult>, elementType: string): GenExprResult {
    if argVals.len() == 0 { return cgErrorExpr(ctx, "vector higher-order method is missing its callback"); }
    var callbackInfo = cgFindExprInfo(ctx, call.args[0]);
    if callbackInfo != null {
        var checkedCallback: CheckedExprInfo = callbackInfo;
        return cgFnEmitVecHoChecked(ctx, call, method, vecVal, code, argVals, elementType, checkedCallback);
    }
    return cgErrorExpr(ctx, "vector higher-order callback type is missing");
}

func cgFnEmitVecHoChecked(ctx: CodegenContext, call: CallExpr, method: string, vecVal: string, code: string, argVals: Vec<GenExprResult>, elementType: string, checkedCallback: CheckedExprInfo): GenExprResult {
    if checkedCallback.ty.kind != "Function" || checkedCallback.ty.ret == null { return cgErrorExpr(ctx, "vector higher-order callback type is missing"); }
    var callbackRet = cgUnwrapType(checkedCallback.ty.ret);
    var callbackRetTy = cgCheckedLLVMType(ctx, callbackRet);
    var closure = cgFnCoerce(ctx, "i64", argVals[0].val, argVals[0].ty, code);
    var fnBits = nextTemp(ctx);
    var envBits = nextTemp(ctx);
    var fnType = callbackRetTy + " (i64";
    var index = 0;
    loop {
        if index >= checkedCallback.ty.params.len() { break; }
        fnType = fnType + ", " + cgCheckedLLVMType(ctx, checkedCallback.ty.params[index]);
        index = index + 1;
    }
    fnType = fnType + ")";
    var fnPtr = nextTemp(ctx);
    var body = closure.code;
    body = body + fnBits + " = call i64 @rey_closure_fn(i64 " + closure.val + ")\n";
    body = body + envBits + " = call i64 @rey_closure_env(i64 " + closure.val + ")\n";
    body = body + fnPtr + " = inttoptr i64 " + fnBits + " to " + fnType + "*\n";
    var indexPtr = cgFreshLocalPtr(ctx, "ho.index");
    var lenPtr = cgFreshLocalPtr(ctx, "ho.len");
    ctx.funcAllocas = ctx.funcAllocas + indexPtr + " = alloca i64, align 8\n";
    ctx.funcAllocas = ctx.funcAllocas + lenPtr + " = alloca i64, align 8\n";
    var length = nextTemp(ctx);
    body = body + length + " = call i64 @rey_vec_len(i64 " + vecVal + ")\n";
    body = body + "store i64 0, i64* " + indexPtr + "\n";
    body = body + "store i64 " + length + ", i64* " + lenPtr + "\n";
    var head = nextLabel(ctx, "ho.head");
    var step = nextLabel(ctx, "ho.step");
    var done = nextLabel(ctx, "ho.done");
    var out = nextTemp(ctx);
    if method == "map" || method == "filter" {
        body = body + out + " = call i64 @rey_vec_new()\n";
    }
    var accPtr = "";
    if method == "reduce" {
        if argVals.len() < 2 || checkedCallback.ty.params.len() < 2 { return cgErrorExpr(ctx, "vector reduce callback arity is invalid"); }
        var initial = cgFnCoerce(ctx, callbackRetTy, argVals[1].val, argVals[1].ty, "");
        body = body + initial.code;
        accPtr = cgFreshLocalPtr(ctx, "ho.acc");
        ctx.funcAllocas = ctx.funcAllocas + accPtr + " = alloca " + callbackRetTy + ", align 8\n";
        body = body + "store " + callbackRetTy + " " + initial.val + ", " + callbackRetTy + "* " + accPtr + "\n";
    }
    body = body + "br label %" + head + "\n" + head + ":\n";
    var cursor = nextTemp(ctx);
    var limit = nextTemp(ctx);
    var more = nextTemp(ctx);
    body = body + cursor + " = load i64, i64* " + indexPtr + "\n";
    body = body + limit + " = load i64, i64* " + lenPtr + "\n";
    body = body + more + " = icmp slt i64 " + cursor + ", " + limit + "\n";
    body = body + "br i1 " + more + ", label %" + step + ", label %" + done + "\n" + step + ":\n";
    var elementTy = "i64";
    var elementVal = nextTemp(ctx);
    if elementType == "float" {
        elementTy = "double";
        body = body + elementVal + " = call double @rey_vec_get_float(i64 " + vecVal + ", i64 " + cursor + ")\n";
    } else {
        var raw = nextTemp(ctx);
        body = body + raw + " = call i64 @rey_vec_get(i64 " + vecVal + ", i64 " + cursor + ")\n";
        var restored = cgUnboxValue(ctx, elementType, raw, "");
        body = body + restored.code;
        elementTy = restored.ty;
        elementVal = restored.val;
    }
    var callArgs = "i64 " + envBits;
    if method == "reduce" {
        var accTy = cgCheckedLLVMType(ctx, checkedCallback.ty.params[0]);
        var acc = nextTemp(ctx);
        body = body + acc + " = load " + callbackRetTy + ", " + callbackRetTy + "* " + accPtr + "\n";
        var accArg = cgFnCoerce(ctx, accTy, acc, callbackRetTy, "");
        body = body + accArg.code;
        callArgs = callArgs + ", " + accTy + " " + accArg.val;
    }
    var paramPos = 0;
    if method == "reduce" { paramPos = 1; }
    if paramPos < checkedCallback.ty.params.len() {
        var paramTy = cgCheckedLLVMType(ctx, checkedCallback.ty.params[paramPos]);
        var paramArg = cgFnCoerce(ctx, paramTy, elementVal, elementTy, "");
        body = body + paramArg.code;
        callArgs = callArgs + ", " + paramTy + " " + paramArg.val;
    }
    var called = nextTemp(ctx);
    if callbackRetTy == "void" {
        body = body + "call void " + fnPtr + "(" + callArgs + ")\n";
    } else {
        body = body + called + " = call " + callbackRetTy + " " + fnPtr + "(" + callArgs + ")\n";
    }
    if method == "map" && callbackRetTy == "double" {
        body = body + "call void @rey_vec_push_float(i64 " + out + ", double " + called + ")\n";
    } else if method == "map" {
        var mapped = cgFnCoerce(ctx, "i64", called, callbackRetTy, "");
        body = body + mapped.code;
        body = body + "call void @rey_vec_push(i64 " + out + ", i64 " + mapped.val + ")\n";
    } else if method == "filter" {
        var keep = called;
        var keepTy = callbackRetTy;
        if callbackRetTy != "i1" {
            var bit = cgFnCoerce(ctx, "i1", called, callbackRetTy, "");
            body = body + bit.code;
            keep = bit.val;
            keepTy = "i1";
        }
        var yes = nextLabel(ctx, "ho.keep");
        var no = nextLabel(ctx, "ho.skip");
        body = body + "br i1 " + keep + ", label %" + yes + ", label %" + no + "\n" + yes + ":\n";
        if elementType == "float" {
            body = body + "call void @rey_vec_push_float(i64 " + out + ", double " + elementVal + ")\n";
        } else {
            var kept = cgFnCoerce(ctx, "i64", elementVal, elementTy, "");
            body = body + kept.code;
            body = body + "call void @rey_vec_push(i64 " + out + ", i64 " + kept.val + ")\n";
        }
        body = body + "br label %" + no + "\n" + no + ":\n";
    } else if method == "reduce" && callbackRetTy != "void" {
        body = body + "store " + callbackRetTy + " " + called + ", " + callbackRetTy + "* " + accPtr + "\n";
    }
    var nextIndex = nextTemp(ctx);
    body = body + nextIndex + " = add nsw i64 " + cursor + ", 1\n";
    body = body + "store i64 " + nextIndex + ", i64* " + indexPtr + "\n";
    body = body + "br label %" + head + "\n" + done + ":\n";
    if method == "reduce" {
        var reduced = nextTemp(ctx);
        body = body + reduced + " = load " + callbackRetTy + ", " + callbackRetTy + "* " + accPtr + "\n";
        return GenExprResult { ty: callbackRetTy, val: reduced, code: body };
    }
    return GenExprResult { ty: "i64", val: out, code: body };
}

func cgClosureCopyFlags(source: HashMap<string, bool>): HashMap<string, bool> {
    var copy: HashMap<string, bool> = HashMap.new();
    var keys = source.keys();
    var index = 0;
    loop {
        if index >= keys.len() { break; }
        copy.set(keys[index], source.get(keys[index]));
        index = index + 1;
    }
    return copy;
}

func cgClosureCanCapture(ctx: CodegenContext, name: string): bool {
    if ctx.locals.has(name) || ctx.closureSlots.has(name) { return true; }
    return cgCurrentGlobal(ctx, name) != null;
}

func cgClosureNote(ctx: CodegenContext, bound: HashMap<string, bool>, names: Vec<string>, name: string) {
    if name == "" || bound.has(name) || !cgClosureCanCapture(ctx, name) { return; }
    var index = 0;
    loop {
        if index >= names.len() { break; }
        if names[index] == name { return; }
        index = index + 1;
    }
    names.push(name);
}

func cgClosureBindPattern(bound: HashMap<string, bool>, pattern: Pattern) {
    match pattern {
        Pattern::Variable(variable) => { bound.set(variable.name, true); },
        Pattern::EnumVariant(payload) => {
            var index = 0;
            loop {
                if index >= payload.payloads.len() { break; }
                cgClosureBindPattern(bound, payload.payloads[index]);
                index = index + 1;
            }
        },
        Pattern::Struct(payload) => {
            var index = 0;
            loop {
                if index >= payload.fields.len() { break; }
                cgClosureBindPattern(bound, payload.fields[index].pattern);
                index = index + 1;
            }
        },
        Pattern::Or(payload) => {
            cgClosureBindPattern(bound, payload.left);
            cgClosureBindPattern(bound, payload.right);
        },
        Pattern::Wildcard(_) => {},
        Pattern::Literal(_) => {},
        Pattern::Range(_) => {},
        Pattern::Error(_) => {},
    }
}

func cgClosureWalkExpr(ctx: CodegenContext, bound: HashMap<string, bool>, names: Vec<string>, expr: Expr) {
    match expr {
        Expr::Identifier(ident) => { cgClosureNote(ctx, bound, names, ident.name); },
        Expr::Binary(binary) => {
            cgClosureWalkExpr(ctx, bound, names, binary.left);
            if binary.op != "instanceof" { cgClosureWalkExpr(ctx, bound, names, binary.right); }
        },
        Expr::Unary(unary) => { cgClosureWalkExpr(ctx, bound, names, unary.right); },
        Expr::Update(update) => { cgClosureWalkExpr(ctx, bound, names, update.target); },
        Expr::Call(call) => {
            cgClosureWalkExpr(ctx, bound, names, call.callee);
            var index = 0;
            loop {
                if index >= call.args.len() { break; }
                cgClosureWalkExpr(ctx, bound, names, call.args[index]);
                index = index + 1;
            }
        },
        Expr::Index(indexExpr) => {
            cgClosureWalkExpr(ctx, bound, names, indexExpr.target);
            cgClosureWalkExpr(ctx, bound, names, indexExpr.index);
        },
        Expr::FieldAccess(field) => { cgClosureWalkExpr(ctx, bound, names, field.object); },
        Expr::Array(array) => {
            var index = 0;
            loop {
                if index >= array.elements.len() { break; }
                cgClosureWalkExpr(ctx, bound, names, array.elements[index]);
                index = index + 1;
            }
        },
        Expr::Tuple(tuple) => {
            var index = 0;
            loop {
                if index >= tuple.elements.len() { break; }
                cgClosureWalkExpr(ctx, bound, names, tuple.elements[index]);
                index = index + 1;
            }
        },
        Expr::Dict(dict) => {
            var index = 0;
            loop {
                if index >= dict.entries.len() { break; }
                cgClosureWalkExpr(ctx, bound, names, dict.entries[index].key);
                cgClosureWalkExpr(ctx, bound, names, dict.entries[index].value);
                index = index + 1;
            }
        },
        Expr::EnumVariant(variant) => {
            var index = 0;
            loop {
                if index >= variant.args.len() { break; }
                cgClosureWalkExpr(ctx, bound, names, variant.args[index]);
                index = index + 1;
            }
        },
        Expr::StructLiteral(literal) => {
            var index = 0;
            loop {
                if index >= literal.fields.len() { break; }
                cgClosureWalkExpr(ctx, bound, names, literal.fields[index].value);
                index = index + 1;
            }
        },
        Expr::Lambda(lambda) => {
            var nested = cgClosureCopyFlags(bound);
            var index = 0;
            loop {
                if index >= lambda.params.len() { break; }
                nested.set(lambda.params[index], true);
                index = index + 1;
            }
            cgClosureWalkStmts(ctx, nested, names, lambda.body);
            var nestedBody = lambda.bodyExpr;
            if nestedBody != null {
                var nestedExpr: Expr = nestedBody;
                cgClosureWalkExpr(ctx, nested, names, nestedExpr);
            }
        },
        Expr::If(value) => {
            cgClosureWalkExpr(ctx, bound, names, value.condition);
            cgClosureWalkExpr(ctx, bound, names, value.thenBranch);
            cgClosureWalkExpr(ctx, bound, names, value.elseBranch);
        },
        Expr::Match(value) => {
            cgClosureWalkExpr(ctx, bound, names, value.expr);
            var index = 0;
            loop {
                if index >= value.arms.len() { break; }
                var armBound = cgClosureCopyFlags(bound);
                cgClosureBindPattern(armBound, value.arms[index].pattern);
                cgClosureWalkExpr(ctx, armBound, names, value.arms[index].guard);
                cgClosureWalkExpr(ctx, armBound, names, value.arms[index].body);
                index = index + 1;
            }
        },
        Expr::Error(_) => {},
        Expr::Literal(_) => {},
    }
}

func cgClosureWalkStmt(ctx: CodegenContext, bound: HashMap<string, bool>, names: Vec<string>, stmt: Stmt) {
    match stmt {
        Stmt::VarDecl(decl) => {
            cgClosureWalkExpr(ctx, bound, names, decl.value);
            bound.set(decl.name, true);
        },
        Stmt::ConstDecl(decl) => {
            cgClosureWalkExpr(ctx, bound, names, decl.value);
            bound.set(decl.name, true);
        },
        Stmt::ExprStmt(exprStmt) => { cgClosureWalkExpr(ctx, bound, names, exprStmt.expr); },
        Stmt::Return(ret) => { cgClosureWalkExpr(ctx, bound, names, ret.value); },
        Stmt::Assign(assign) => {
            cgClosureWalkExpr(ctx, bound, names, assign.target);
            cgClosureWalkExpr(ctx, bound, names, assign.value);
        },
        Stmt::Block(block) => { cgClosureWalkStmts(ctx, cgClosureCopyFlags(bound), names, block.statements); },
        Stmt::If(value) => {
            cgClosureWalkExpr(ctx, bound, names, value.condition);
            cgClosureWalkStmts(ctx, cgClosureCopyFlags(bound), names, value.thenBranch.statements);
            var elseBranch = value.elseBranch;
            if elseBranch != null {
                var elseBlock: BlockStmt = elseBranch;
                cgClosureWalkStmts(ctx, cgClosureCopyFlags(bound), names, elseBlock.statements);
            }
        },
        Stmt::While(value) => {
            cgClosureWalkExpr(ctx, bound, names, value.condition);
            cgClosureWalkStmts(ctx, cgClosureCopyFlags(bound), names, value.body);
        },
        Stmt::Loop(value) => { cgClosureWalkStmts(ctx, cgClosureCopyFlags(bound), names, value.body); },
        Stmt::For(value) => {
            cgClosureWalkExpr(ctx, bound, names, value.iterable);
            var forBound = cgClosureCopyFlags(bound);
            forBound.set(value.variable, true);
            cgClosureWalkStmts(ctx, forBound, names, value.body);
        },
        Stmt::Match(value) => {
            cgClosureWalkExpr(ctx, bound, names, value.scrutinee);
            var index = 0;
            loop {
                if index >= value.arms.len() { break; }
                var armBound = cgClosureCopyFlags(bound);
                cgClosureBindPattern(armBound, value.arms[index].pattern);
                cgClosureWalkStmt(ctx, armBound, names, value.arms[index].body);
                index = index + 1;
            }
        },
        Stmt::Import(_) => {},
        Stmt::StructDecl(_) => {},
        Stmt::EnumDecl(_) => {},
        Stmt::FuncDecl(_) => {},
        Stmt::Break(_) => {},
        Stmt::Continue(_) => {},
    }
}

func cgClosureWalkStmts(ctx: CodegenContext, bound: HashMap<string, bool>, names: Vec<string>, statements: Vec<Stmt>) {
    var index = 0;
    loop {
        if index >= statements.len() { break; }
        cgClosureWalkStmt(ctx, bound, names, statements[index]);
        index = index + 1;
    }
}

func cgClosureEmit(ctx: CodegenContext, expr: Expr, lambda: LambdaExpr): GenExprResult {
    var checkedInfo = cgFindExprInfo(ctx, expr);
    if checkedInfo != null {
        var checked: CheckedExprInfo = checkedInfo;
        return cgClosureEmitChecked(ctx, expr, lambda, checked);
    }
    return cgErrorExprAt(ctx, expr, "lambda expression metadata is missing");
}

func cgClosureEmitChecked(ctx: CodegenContext, expr: Expr, lambda: LambdaExpr, checked: CheckedExprInfo): GenExprResult {
    if checked.ty.kind != "Function" || checked.ty.ret == null { return cgErrorExprAt(ctx, expr, "lambda expression metadata is missing"); }
    var retType = cgUnwrapType(checked.ty.ret);
    var retTy = cgCheckedLLVMType(ctx, retType);
    var names: Vec<string> = Vec.new();
    var bound: HashMap<string, bool> = HashMap.new();
    var paramIndex = 0;
    loop {
        if paramIndex >= lambda.params.len() { break; }
        bound.set(lambda.params[paramIndex], true);
        paramIndex = paramIndex + 1;
    }
    cgClosureWalkStmts(ctx, bound, names, lambda.body);
    var lambdaBody = lambda.bodyExpr;
    if lambdaBody != null {
        var lambdaExpr: Expr = lambdaBody;
        cgClosureWalkExpr(ctx, bound, names, lambdaExpr);
    }
    var captureSource: Vec<string> = Vec.new();
    var captureLlvm: Vec<string> = Vec.new();
    var capturePtr: Vec<string> = Vec.new();
    var captureGlobal: Vec<string> = Vec.new();
    var captureKind: Vec<int> = Vec.new();
    var captureIndex = 0;
    loop {
        if captureIndex >= names.len() { break; }
        var name = names[captureIndex];
        if ctx.locals.has(name) {
            var local: LocalVar = ctx.locals.get(name);
            captureSource.push(local.sourceType);
            captureLlvm.push(local.ty);
            capturePtr.push(local.ptr);
            captureGlobal.push("0");
            captureKind.push(cgClosureKind(local.sourceType, local.ty));
        } else {
            var maybeGlobal = cgCurrentGlobal(ctx, name);
            if maybeGlobal != null {
                var global: GlobalVarDef = maybeGlobal;
                captureSource.push(global.sourceType);
                captureLlvm.push(global.ty);
                capturePtr.push(global.llvmName);
                captureGlobal.push("1");
                captureKind.push(cgClosureKind(global.sourceType, global.ty));
            } else {
                return cgErrorExprAt(ctx, expr, "unresolved lambda capture: " + name);
            }
        }
        captureIndex = captureIndex + 1;
    }
    var savedLocals = ctx.locals;
    var savedLoops = ctx.loopStack;
    var savedAllocas = ctx.funcAllocas;
    var savedBlock = ctx.blockId;
    var savedFunc = ctx.currentFunc;
    var savedRet = ctx.currentRetTy;
    var savedMethodKey = ctx.methodStructKey;
    var savedMethodPtr = ctx.methodSelfPtr;
    var savedMethodTy = ctx.methodSelfTy;
    var savedInit = ctx.inGlobalInitializer;
    var savedSlots = ctx.closureSlots;
    var savedSlotTypes = ctx.closureTypes;
    ctx.locals = HashMap.new();
    ctx.loopStack = Vec.new();
    ctx.funcAllocas = "";
    ctx.blockId = 0;
    ctx.methodStructKey = "";
    ctx.methodSelfPtr = "";
    ctx.methodSelfTy = "";
    ctx.inGlobalInitializer = false;
    ctx.closureSlots = HashMap.new();
    ctx.closureTypes = HashMap.new();
    var seq = ctx.lambdaSeq;
    ctx.lambdaSeq = ctx.lambdaSeq + 1;
    var fnName = "rey_lam_" + seq.toString();
    ctx.currentFunc = fnName;
    ctx.currentRetTy = retTy;
    ctx.funcSourceRetTypes.set("@ret:" + fnName, cgCheckedTypeName(ctx, retType));
    var fnType = retTy + " (i64";
    var signature = "i64 %rey.env";
    var header = "";
    paramIndex = 0;
    loop {
        if paramIndex >= lambda.params.len() { break; }
        var paramTy = "i64";
        var paramSource = "int";
        if paramIndex < checked.ty.params.len() {
            paramTy = cgCheckedLLVMType(ctx, checked.ty.params[paramIndex]);
            paramSource = cgCheckedTypeName(ctx, checked.ty.params[paramIndex]);
        }
        var paramName = lambda.params[paramIndex];
        fnType = fnType + ", " + paramTy;
        signature = signature + ", " + paramTy + " %" + paramName;
        header = header + "%" + paramName + ".addr = alloca " + paramTy + ", align 8\n";
        header = header + "store " + paramTy + " %" + paramName + ", " + paramTy + "* %" + paramName + ".addr\n";
        ctx.locals.set(paramName, LocalVar { ptr: "%" + paramName + ".addr", ty: paramTy, sourceType: paramSource });
        paramIndex = paramIndex + 1;
    }
    fnType = fnType + ")";
    captureIndex = 0;
    loop {
        if captureIndex >= names.len() { break; }
        var name = names[captureIndex];
        var raw = nextTemp(ctx);
        var restoredTy = captureLlvm[captureIndex];
        var restoredVal = raw;
        var restoredCode = "";
        if captureKind[captureIndex] == 4101 {
            var restored = cgClosureFromPayload(ctx, captureSource[captureIndex], raw, "");
            restoredTy = restored.ty;
            restoredVal = restored.val;
            restoredCode = restored.code;
        } else if restoredTy == "double" {
            var number = nextTemp(ctx);
            restoredVal = number;
            restoredCode = number + " = bitcast i64 " + raw + " to double\n";
        } else if restoredTy == "i1" {
            var bit = nextTemp(ctx);
            restoredVal = bit;
            restoredCode = bit + " = trunc i64 " + raw + " to i1\n";
        } else if restoredTy.endsWith("*") {
            var pointer = nextTemp(ctx);
            restoredVal = pointer;
            restoredCode = pointer + " = inttoptr i64 " + raw + " to " + restoredTy + "\n";
        }
        header = header + "%" + name + ".cap = alloca " + restoredTy + ", align 8\n";
        header = header + raw + " = call i64 @rey_env_get(i64 %rey.env, i64 " + captureIndex.toString() + ")\n";
        header = header + restoredCode;
        header = header + "store " + restoredTy + " " + restoredVal + ", " + restoredTy + "* %" + name + ".cap\n";
        ctx.locals.set(name, LocalVar { ptr: "%" + name + ".cap", ty: restoredTy, sourceType: captureSource[captureIndex] });
        ctx.closureSlots.set(name, captureIndex);
        ctx.closureTypes.set(name, captureSource[captureIndex]);
        captureIndex = captureIndex + 1;
    }
    var bodyCode = "";
    var bodyExpr = lambda.bodyExpr;
    if bodyExpr != null {
        var returned: Expr = bodyExpr;
        bodyCode = cgFnFinishReturn(ctx, retTy, genExprValue(ctx, returned));
    } else {
        bodyCode = genStmtList(ctx, lambda.body);
        if !stmtListEndsWithTerminator(lambda.body) {
            if retTy == "void" { bodyCode = bodyCode + "ret void\n"; }
            else if retTy == "double" { bodyCode = bodyCode + "ret double 0.0\n"; }
            else if retTy.endsWith("*") { bodyCode = bodyCode + "ret " + retTy + " null\n"; }
            else { bodyCode = bodyCode + "ret " + retTy + " 0\n"; }
        }
    }
    var functionText = "define " + retTy + " @" + fnName + "(" + signature + ") {{\nentry:\n" + header + ctx.funcAllocas + bodyCode + "}}\n\n";
    ctx.lambdaBodies = ctx.lambdaBodies + functionText;
    ctx.locals = savedLocals;
    ctx.loopStack = savedLoops;
    ctx.funcAllocas = savedAllocas;
    ctx.blockId = savedBlock;
    ctx.currentFunc = savedFunc;
    ctx.currentRetTy = savedRet;
    ctx.methodStructKey = savedMethodKey;
    ctx.methodSelfPtr = savedMethodPtr;
    ctx.methodSelfTy = savedMethodTy;
    ctx.inGlobalInitializer = savedInit;
    ctx.closureSlots = savedSlots;
    ctx.closureTypes = savedSlotTypes;
    var code = "";
    var envVal = "0";
    if names.len() > 0 {
        var env = nextTemp(ctx);
        envVal = env;
        code = code + env + " = call i64 @rey_env_new(i64 " + names.len().toString() + ")\n";
        captureIndex = 0;
        loop {
            if captureIndex >= names.len() { break; }
            var loaded = nextTemp(ctx);
            code = code + loaded + " = load " + captureLlvm[captureIndex] + ", " + captureLlvm[captureIndex] + "* " + capturePtr[captureIndex] + "\n";
            var payload = cgClosureToPayload(ctx, captureSource[captureIndex], captureLlvm[captureIndex], loaded, captureLlvm[captureIndex], "");
            code = code + payload.code;
            code = code + "call void @rey_env_set(i64 " + env + ", i64 " + captureIndex.toString() + ", i64 " + captureKind[captureIndex].toString() + ", i64 " + payload.val + ")\n";
            captureIndex = captureIndex + 1;
        }
    }
    var fnBits = nextTemp(ctx);
    var closure = nextTemp(ctx);
    code = code + fnBits + " = ptrtoint " + fnType + "* @" + fnName + " to i64\n";
    code = code + closure + " = call i64 @rey_closure_new(i64 " + fnBits + ", i64 " + envVal + ", i64 " + lambda.params.len().toString() + ")\n";
    return GenExprResult { ty: "i64", val: closure, code: code };
}

func cgPatternFieldSource(ctx: CodegenContext, sourceType: string, fieldName: string): string {
    if !ctx.structDefs.has(sourceType) { return ""; }
    var def: StructDef = ctx.structDefs.get(sourceType);
    var index = 0;
    loop {
        if index >= def.fields.len() { break; }
        if def.fields[index].name == fieldName { return def.fields[index].sourceType; }
        index = index + 1;
    }
    return "";
}

func cgPatternLoadField(ctx: CodegenContext, sourceType: string, fieldName: string, value: GenExprResult): GenExprResult {
    if !ctx.structDefs.has(sourceType) { return cgErrorExpr(ctx, "struct match scrutinee has no layout"); }
    var def: StructDef = ctx.structDefs.get(sourceType);
    var fieldIndex = -1;
    var index = 0;
    loop {
        if index >= def.fields.len() { break; }
        if def.fields[index].name == fieldName { fieldIndex = index; }
        index = index + 1;
    }
    if fieldIndex < 0 { return cgErrorExpr(ctx, "unknown struct match field: " + fieldName); }
    var base = value.val;
    var code = value.code;
    if value.ty == "i64" {
        var cast = nextTemp(ctx);
        code = code + cast + " = inttoptr i64 " + value.val + " to " + def.llvmName + "*\n";
        base = cast;
    }
    var slot = nextTemp(ctx);
    var loaded = nextTemp(ctx);
    var fieldTy = def.fields[fieldIndex].ty;
    code = code + slot + " = getelementptr inbounds " + def.llvmName + ", " + def.llvmName + "* " + base + ", i32 0, i32 " + fieldIndex.toString() + "\n";
    code = code + loaded + " = load " + fieldTy + ", " + fieldTy + "* " + slot + "\n";
    return GenExprResult { ty: fieldTy, val: loaded, code: code };
}

func cgPatternEmitStruct(ctx: CodegenContext, pattern: StructPattern, sourceType: string, value: GenExprResult, successLabel: string, failLabel: string): string {
    if !ctx.structDefs.has(sourceType) {
        cgSetError(ctx, "struct match scrutinee has no layout");
        return value.code + "br label %" + failLabel + "\n";
    }
    var def: StructDef = ctx.structDefs.get(sourceType);
    if pattern.structName != def.sourceName && pattern.structName != sourceType {
        return value.code + "br label %" + failLabel + "\n";
    }
    var base = GenExprResult { ty: value.ty, val: value.val, code: "" };
    var code = value.code;
    if pattern.fields.len() == 0 { return code + "br label %" + successLabel + "\n"; }
    var index = 0;
    var currentLabel = "";
    loop {
        if index >= pattern.fields.len() { break; }
        if index > 0 { code = code + currentLabel + ":\n"; }
        var loaded = cgPatternLoadField(ctx, sourceType, pattern.fields[index].name, base);
        var nextOne = successLabel;
        if index + 1 < pattern.fields.len() { nextOne = nextLabel(ctx, "struct.field"); }
        code = code + cgEmitPatternTest(ctx, pattern.fields[index].pattern, cgPatternFieldSource(ctx, sourceType, pattern.fields[index].name), loaded, nextOne, failLabel);
        currentLabel = nextOne;
        index = index + 1;
    }
    return code;
}

func cgPatternEmitStructBindings(ctx: CodegenContext, pattern: StructPattern, sourceType: string, value: GenExprResult): string {
    var base = GenExprResult { ty: value.ty, val: value.val, code: "" };
    var code = value.code;
    var index = 0;
    loop {
        if index >= pattern.fields.len() { break; }
        var loaded = cgPatternLoadField(ctx, sourceType, pattern.fields[index].name, base);
        code = code + cgEmitPatternBindings(ctx, pattern.fields[index].pattern, cgPatternFieldSource(ctx, sourceType, pattern.fields[index].name), loaded);
        index = index + 1;
    }
    return code;
}

func genExprValue(ctx: CodegenContext, expr: Expr): GenExprResult {
    var literalPayload: LiteralExpr? = null;
    var identifierPayload: IdentExpr? = null;
    var fieldAccessPayload: FieldAccessExpr? = null;
    var binaryPayload: BinaryExpr? = null;
    var unaryPayload: UnaryExpr? = null;
    var updatePayload: UpdateExpr? = null;
    var callPayload: CallExpr? = null;
    var indexPayload: IndexExpr? = null;
    var arrayPayload: ArrayExpr? = null;
    var enumVariantPayload: EnumVariantExpr? = null;
    var structLiteralPayload: StructLiteralExpr? = null;
    var tuplePayload: TupleExpr? = null;
    var dictPayload: DictExpr? = null;
    var lambdaPayload: LambdaExpr? = null;
    match expr {
        Expr::Error(_) => {},
        Expr::Literal(payload) => { literalPayload = payload; },
        Expr::Identifier(payload) => { identifierPayload = payload; },
        Expr::Binary(payload) => { binaryPayload = payload; },
        Expr::Unary(payload) => { unaryPayload = payload; },
        Expr::Update(payload) => { updatePayload = payload; },
        Expr::Call(payload) => { callPayload = payload; },
        Expr::EnumVariant(payload) => { enumVariantPayload = payload; },
        Expr::Index(payload) => { indexPayload = payload; },
        Expr::FieldAccess(payload) => { fieldAccessPayload = payload; },
        Expr::Lambda(payload) => { lambdaPayload = payload; },
        Expr::Match(_) => {},
        Expr::If(_) => {},
        Expr::Tuple(payload) => { tuplePayload = payload; },
        Expr::Array(payload) => { arrayPayload = payload; },
        Expr::Dict(payload) => { dictPayload = payload; },
        Expr::StructLiteral(payload) => { structLiteralPayload = payload; },
    }
    if literalPayload != null {
        var litE: LiteralExpr = literalPayload;
        var kStr = literalKindCode(litE.kind);
        if kStr == "string" {
            // intern the raw bytes as a global constant, then wrap in a ReyStr via rey_str_new
            var idx = cgInternString(ctx, litE.text);
            var info: CStringInfo = llvmCStringInfo(litE.text);
            var rawPtr = llvmStrPtr(idx, info.len);
            var slen = info.len - 1;  // exclude null terminator from ReyStr.len
            var tmp = nextTemp(ctx);
            var code0 = tmp + " = call i8* @rey_str_new(i8* " + rawPtr + ", i64 " + slen.toString() + ")\n";
            return GenExprResult { ty: "i8*", val: tmp, code: code0 };
        }
        if kStr == "char" {
            var charIndex = cgInternString(ctx, litE.text);
            var charInfo: CStringInfo = llvmCStringInfo(litE.text);
            var charValue = nextTemp(ctx);
            var charCode = charValue + " = call i8* @rey_str_new(i8* " + llvmStrPtr(charIndex, charInfo.len) + ", i64 " + (charInfo.len - 1).toString() + ")\n";
            return GenExprResult { ty: "i8*", val: charValue, code: charCode };
        }
        if kStr == "int" {
            return GenExprResult { ty: "i64", val: litE.text, code: "" };
        }
        if kStr == "float" {
            return GenExprResult { ty: "double", val: litE.text, code: "" };
        }
        if kStr == "bool" {
            if litE.text == "true" { return GenExprResult { ty: "i1", val: "1", code: "" }; }
            return GenExprResult { ty: "i1", val: "0", code: "" };
        }
        if kStr == "null" {
            return GenExprResult { ty: "i64", val: "0", code: "" };
        }
    }
    if identifierPayload != null {
        var ident: IdentExpr = identifierPayload;
        if ctx.locals.has(ident.name) {
            var local: LocalVar = ctx.locals.get(ident.name);
            var tmp = nextTemp(ctx);
            var code = tmp + " = load " + local.ty + ", " + local.ty + "* " + local.ptr + "\n";
            var scalarInner = cgScalarNullableInner(local.sourceType);
            if scalarInner != "" && cgSourceType(ctx, expr) == scalarInner {
                return cgUnboxScalar(ctx, scalarInner, tmp, code);
            }
            return cgUnionAdjust(ctx, local.sourceType, cgSourceType(ctx, expr), local.ty, tmp, code);
        }
        if ctx.checkedProgram != null {
            var maybeGlobal = cgCurrentGlobal(ctx, ident.name);
            if maybeGlobal != null {
                var global: GlobalVarDef = maybeGlobal;
                var globalValue = nextTemp(ctx);
                var globalCode = globalValue + " = load " + global.ty + ", " + global.ty + "* " + global.llvmName + "\n";
                var globalScalar = cgScalarNullableInner(global.sourceType);
                if globalScalar != "" && cgSourceType(ctx, expr) == globalScalar {
                    return cgUnboxScalar(ctx, globalScalar, globalValue, globalCode);
                }
                return cgUnionAdjust(ctx, global.sourceType, cgSourceType(ctx, expr), global.ty, globalValue, globalCode);
            }
        }
        var enumValueKey = ident.name;
        if !ctx.enumDefs.has(enumValueKey) { enumValueKey = cgResolveNominalKey(ctx, "Enum", ident.name); }
        var enumValueKnown = false;
        if enumValueKey != "" && ctx.enumDefs.has(enumValueKey) { enumValueKnown = true; }
        if enumValueKnown || ident.name == "Vec" || ident.name == "HashMap" || ident.name == "Result" || ident.name == "Option" {
            return GenExprResult { ty: "i64", val: "0", code: "" };
        }
        if cgCallFieldIndex(ctx, ident.name) >= 0 { return cgCallLoadField(ctx, ident.name); }
        return cgErrorExpr(ctx, "unresolved identifier: " + ident.name);
    }
    if fieldAccessPayload != null {
        var fieldExpr: FieldAccessExpr = fieldAccessPayload;
        var obj: GenExprResult = genExprValue(ctx, fieldExpr.object);
        var codeF = obj.code;

        var enumObjectOption = cgExprIdentifier(fieldExpr.object);
        if enumObjectOption != null {
            var enumObject: IdentExpr = enumObjectOption;
            var enumName = enumObject.name;
            if !ctx.enumDefs.has(enumName) { enumName = cgResolveNominalKey(ctx, "Enum", enumObject.name); }
        if enumName != "" && ctx.enumDefs.has(enumName) {
                if ctx.checkedProgram != null {
                    return cgErrorExprAt(ctx, expr, "checked enum variants must use EnumVariantExpr");
                }
                var i0 = cgEnumVariantIndex(ctx, enumName, fieldExpr.name);
                if i0 >= 0 { return GenExprResult { ty: "i64", val: i0.toString(), code: codeF }; }
            }
        }

        var tupleReceiver = cgSourceType(ctx, fieldExpr.object);
        if cgTupleCount(tupleReceiver) >= 0 {
            var tupleSlot = cgTupleIndex(fieldExpr.name);
            if tupleSlot < 0 { return cgErrorExprAt(ctx, expr, "tuple access must use a numeric index"); }
            var tupleElementType = cgTupleElementAt(tupleReceiver, tupleSlot);
            if tupleElementType == "" { return cgErrorExprAt(ctx, expr, "tuple index out of bounds"); }
            if ctx.checkedProgram != null {
                var checkedElementType = cgSourceType(ctx, expr);
                if checkedElementType != "" && checkedElementType != "unsupported" {
                    if checkedElementType != tupleElementType { return cgErrorExprAt(ctx, expr, "checked tuple element type mismatch"); }
                    tupleElementType = checkedElementType;
                }
            }
            if obj.ty != "i64" { return cgErrorExprAt(ctx, expr, "tuple value has unsupported LLVM representation"); }
            var tupleRaw = nextTemp(ctx);
            codeF = codeF + tupleRaw + " = call i64 @rey_tuple_get(i64 " + obj.val + ", i64 " + tupleSlot.toString() + ")\n";
            return cgUnpackSlot(ctx, tupleElementType, tupleRaw, codeF);
        }

        var sname = cgSourceType(ctx, fieldExpr.object);
        var checkedFieldIndex = -1;
        var checkedFieldLLVMType = "";
        if ctx.checkedProgram != null {
            var checkedField = cgFindExprInfo(ctx, expr);
            if checkedField != null {
                var checkedFieldInfo: CheckedExprInfo = checkedField;
                if checkedFieldInfo.fieldIndex < 0 || checkedFieldInfo.structIndex < 0 { return cgErrorExprAt(ctx, expr, "checked field access is missing its layout index: " + fieldExpr.name); }
                sname = cgCheckedTypeName(ctx, checkedFieldInfo.receiverType);
                if cgCheckedStructName(ctx, checkedFieldInfo.receiverType.sourcePath, checkedFieldInfo.receiverType.moduleId, checkedFieldInfo.structIndex) != sname {
                    return cgErrorExpr(ctx, "checked field receiver/declaration identity mismatch: " + fieldExpr.name);
                }
                checkedFieldIndex = checkedFieldInfo.fieldIndex;
                checkedFieldLLVMType = cgCheckedLLVMType(ctx, checkedFieldInfo.ty);
            } else {
                return cgErrorExprAt(ctx, expr, "checked field access is missing its layout index: " + fieldExpr.name);
            }
        }
        if ctx.checkedProgram == null && sname == "" && obj.ty.endsWith("*") && obj.ty != "i8*" {
            var keys = ctx.structDefs.keys();
            var i = 0;
            loop {
                if i >= keys.len() { break; }
                var key = keys.get(i);
                var defByType: StructDef = ctx.structDefs.get(key);
                if obj.ty == defByType.llvmName + "*" { sname = key; break; }
                i = i + 1;
            }
        }
        if sname == "" || !ctx.structDefs.has(sname) {
            return cgErrorExpr(ctx, "unresolved field receiver: " + fieldExpr.name);
        }
        var def2: StructDef = ctx.structDefs.get(sname);
        if obj.ty == "i64" {
            var castTmp = nextTemp(ctx);
            codeF = codeF + castTmp + " = inttoptr i64 " + obj.val + " to " + def2.llvmName + "*\n";
            obj = GenExprResult { ty: def2.llvmName + "*", val: castTmp, code: codeF };
        } else if obj.ty != def2.llvmName + "*" {
            return cgErrorExpr(ctx, "field receiver layout mismatch: " + fieldExpr.name);
        }
        var fields = def2.fields;
        var idx = checkedFieldIndex;
        if ctx.checkedProgram == null {
            idx = -1;
            var i = 0;
            loop {
                if i >= fields.len() { break; }
                var fi2: StructFieldDef = fields[i];
                if fi2.name == fieldExpr.name {
                    idx = i;
                    break;
                }
                i = i + 1;
            }
        }
        if idx < 0 || idx >= fields.len() {
            return cgErrorExprAt(ctx, expr, "unknown field: " + fieldExpr.name);
        }
        var gep = nextTemp(ctx);
        var fldIdx: StructFieldDef = fields[idx];
        var fieldTy = fldIdx.ty;
        if ctx.checkedProgram != null {
            if checkedFieldLLVMType != fieldTy { return cgErrorExpr(ctx, "checked field type/layout mismatch: " + fieldExpr.name); }
            fieldTy = checkedFieldLLVMType;
        }
        codeF = codeF + gep + " = getelementptr inbounds " + def2.llvmName + ", " + def2.llvmName + "* " + obj.val + ", i32 0, i32 " + idx.toString() + "\n";
        var tmp2 = nextTemp(ctx);
        codeF = codeF + tmp2 + " = load " + fieldTy + ", " + fieldTy + "* " + gep + "\n";
        return GenExprResult { ty: fieldTy, val: tmp2, code: codeF };
    }
    if binaryPayload != null {
        var binaryExpr: BinaryExpr = binaryPayload;
        // instanceof operator — handled before evaluating operands
        if binaryExpr.op == "instanceof" {
            // left: the object; right: an IdentExpr naming the type
            var lo: GenExprResult = genExprValue(ctx, binaryExpr.left);
            var typeName = "";
            var typeNameIdent = cgExprIdentifier(binaryExpr.right);
            if typeNameIdent != null { typeName = typeNameIdent.name; }
            var code0 = lo.code;
            // coerce pointer to i64 if needed (typed vars load as %struct.X*)
            var loVal = lo.val;
            if lo.ty.endsWith("*") {
                var tpi = nextTemp(ctx);
                code0 = code0 + tpi + " = ptrtoint " + lo.ty + " " + lo.val + " to i64\n";
                loVal = tpi;
            }
            var leftType = cgSourceType(ctx, binaryExpr.left);
            if cgFnIsUnion(leftType) || leftType == "any" {
                var queryKind = -1;
                var nominal = 0;
                if typeName == "int" { queryKind = 4097; }
                if typeName == "bool" { queryKind = 4098; }
                if typeName == "float" { queryKind = 4099; }
                if typeName == "string" { queryKind = 4100; }
                if typeName == "char" { queryKind = 4101; }
                if typeName == "null" { queryKind = 4102; }
                if typeName == "Vec" { queryKind = 4105; }
                if typeName == "HashMap" { queryKind = 4106; }
                if typeName == "Option" { queryKind = 4108; }
                if typeName == "Result" { queryKind = 4109; }
                if queryKind < 0 {
                    var unionStructKey = typeName;
                    if !ctx.structTags.has(unionStructKey) { unionStructKey = cgResolveNominalKey(ctx, "Struct", typeName); }
                    if unionStructKey != "" && ctx.structTags.has(unionStructKey) {
                        queryKind = 4103;
                        nominal = ctx.structTags.get(unionStructKey);
                    }
                }
                if queryKind < 0 {
                    var unionEnumKey = typeName;
                    if !ctx.enumDefs.has(unionEnumKey) { unionEnumKey = cgResolveNominalKey(ctx, "Enum", typeName); }
                    if unionEnumKey != "" && ctx.enumDefs.has(unionEnumKey) {
                        queryKind = 4104;
                        nominal = cgEnumIdentity(ctx, unionEnumKey);
                    }
                }
                if queryKind < 0 {
                    cgSetError(ctx, "unresolved instanceof type: " + typeName);
                    return GenExprResult { ty: "i1", val: "0", code: code0 };
                }
                var checked = nextTemp(ctx);
                code0 = code0 + checked + " = call i64 @rey_instanceof(i64 " + loVal + ", i64 " + queryKind.toString() + ", i64 " + nominal.toString() + ")\n";
                var bit = nextTemp(ctx);
                code0 = code0 + bit + " = icmp ne i64 " + checked + ", 0\n";
                return GenExprResult { ty: "i1", val: bit, code: code0 };
            }
            // well-known tagged heap types via rey_instanceof_tag
            var tagId = -1;
            if typeName == "Vec"    { tagId = 2; }
            if typeName == "HashMap" { tagId = 3; }
            if typeName == "Result" { tagId = 4; }  // Ok counts; Err is 5
            if typeName == "Option" { tagId = 6; }
            // Result.Ok / Result.Err as separate enum variants
            if typeName == "Ok"     { tagId = 4; }
            if typeName == "Err"    { tagId = 5; }
            if typeName == "Some"   { tagId = 6; }
            if typeName == "None"   { tagId = 7; }
            if tagId >= 0 {
                var t0 = nextTemp(ctx);
                code0 = code0 + t0 + " = call i64 @rey_instanceof_tag(i64 " + loVal + ", i64 " + tagId.toString() + ")\n";
                var t1 = nextTemp(ctx);
                code0 = code0 + t1 + " = icmp ne i64 " + t0 + ", 0\n";
                return GenExprResult { ty: "i1", val: t1, code: code0 };
            }
            // user struct: tag is 16 bytes before data ptr, use rey_struct_instanceof
            var structTagKey = typeName;
            if !ctx.structTags.has(structTagKey) { structTagKey = cgResolveNominalKey(ctx, "Struct", typeName); }
            if structTagKey != "" && ctx.structTags.has(structTagKey) {
                var stTagId = ctx.structTags.get(structTagKey);
                var t0s = nextTemp(ctx);
                code0 = code0 + t0s + " = call i64 @rey_struct_instanceof(i64 " + loVal + ", i64 " + stTagId.toString() + ")\n";
                var t1s = nextTemp(ctx);
                code0 = code0 + t1s + " = icmp ne i64 " + t0s + ", 0\n";
                return GenExprResult { ty: "i1", val: t1s, code: code0 };
            }
            cgSetError(ctx, "unresolved instanceof type: " + typeName);
            return GenExprResult { ty: "i1", val: "0", code: code0 };
        }

        if binaryExpr.op == "&&" || binaryExpr.op == "||" {
            return cgEmitShortCircuit(ctx, binaryExpr.op, binaryExpr.left, binaryExpr.right);
        }

        var l: GenExprResult = genExprValue(ctx, binaryExpr.left);
        var r: GenExprResult = genExprValue(ctx, binaryExpr.right);
        var code = l.code + r.code;
        var isStrOp = (l.ty == "i8*" || r.ty == "i8*");
        var leftSourceType = cgSourceType(ctx, binaryExpr.left);
        var rightSourceType = cgSourceType(ctx, binaryExpr.right);
        var hasFloatOperand = leftSourceType == "float" || rightSourceType == "float";

        if binaryExpr.op == "+" {
            if isStrOp || leftSourceType == "string" || rightSourceType == "string" || leftSourceType == "char" || rightSourceType == "char" {
                var leftText = leftSourceType == "string" || leftSourceType == "char" || leftSourceType == "any" || leftSourceType == "";
                var rightText = rightSourceType == "string" || rightSourceType == "char" || rightSourceType == "any" || rightSourceType == "";
                var leftPtr = l.ty == "i8*" || l.ty == "i64" || l.ty.endsWith("*");
                var rightPtr = r.ty == "i8*" || r.ty == "i64" || r.ty.endsWith("*");
                if !leftText || !rightText || !leftPtr || !rightPtr {
                    return cgErrorExpr(ctx, "string concatenation requires two strings: " + leftSourceType + " (" + l.ty + ") vs " + rightSourceType + " (" + r.ty + ")");
                }
                var lv = l.val;
                var rv = r.val;
                if l.ty == "i64" {
                    var leftCast = nextTemp(ctx);
                    code = code + leftCast + " = inttoptr i64 " + l.val + " to i8*\n";
                    lv = leftCast;
                } else if l.ty != "i8*" {
                    var leftBitcast = nextTemp(ctx);
                    code = code + leftBitcast + " = bitcast " + l.ty + " " + l.val + " to i8*\n";
                    lv = leftBitcast;
                }
                if r.ty == "i64" {
                    var rightCast = nextTemp(ctx);
                    code = code + rightCast + " = inttoptr i64 " + r.val + " to i8*\n";
                    rv = rightCast;
                } else if r.ty != "i8*" {
                    var rightBitcast = nextTemp(ctx);
                    code = code + rightBitcast + " = bitcast " + r.ty + " " + r.val + " to i8*\n";
                    rv = rightBitcast;
                }
                var tmp = nextTemp(ctx);
                code = code + tmp + " = call i8* @rey_str_concat(i8* " + lv + ", i8* " + rv + ")\n";
                return GenExprResult { ty: "i8*", val: tmp, code: code };
            }
            if hasFloatOperand {
                return cgCheckedFloatBin(ctx, "+", binaryExpr.left, binaryExpr.right, l, r);
            }
            if l.ty != "i64" || r.ty != "i64" {
                return cgErrorExpr(ctx, "unsupported non-integer addition");
            }
            var sum: GenExprResult = cgCheckedIntBin(ctx, "+", l.val, r.val);
            sum.code = code + sum.code;
            return sum;
        }
        if binaryExpr.op == "-" || binaryExpr.op == "*" || binaryExpr.op == "/" || binaryExpr.op == "%" {
            if hasFloatOperand {
                return cgCheckedFloatBin(ctx, binaryExpr.op, binaryExpr.left, binaryExpr.right, l, r);
            }
            if l.ty != "i64" || r.ty != "i64" {
                return cgErrorExpr(ctx, "unsupported non-integer arithmetic");
            }
            if binaryExpr.op == "/" || binaryExpr.op == "%" {
                var quotient: GenExprResult = cgCheckedDivRem(ctx, binaryExpr.op, l.val, r.val);
                quotient.code = code + quotient.code;
                return quotient;
            }
            var arithmetic: GenExprResult = cgCheckedIntBin(ctx, binaryExpr.op, l.val, r.val);
            arithmetic.code = code + arithmetic.code;
            return arithmetic;
        }
        if binaryExpr.op == "==" || binaryExpr.op == "!=" {
            if hasFloatOperand {
                return cgCheckedFloatCompare(ctx, binaryExpr.op, binaryExpr.left, binaryExpr.right, l, r);
            }
            if isStrOp && leftSourceType != "null" && rightSourceType != "null" {
                var leftText = leftSourceType == "string" || leftSourceType == "char" || leftSourceType == "any" || leftSourceType == "";
                var rightText = rightSourceType == "string" || rightSourceType == "char" || rightSourceType == "any" || rightSourceType == "";
                var mixedText = (leftSourceType == "string" && rightSourceType == "char") || (leftSourceType == "char" && rightSourceType == "string");
                if !leftText || !rightText || mixedText {
                    return cgErrorExpr(ctx, "string/char equality requires matching types: " + leftSourceType + " vs " + rightSourceType);
                }
                var lv3 = l.val;
                var rv3 = r.val;
                if l.ty != "i8*" {
                    var lt3 = nextTemp(ctx);
                    if l.ty.endsWith("*") {
                        code = code + lt3 + " = bitcast " + l.ty + " " + l.val + " to i8*\n";
                    } else {
                        code = code + lt3 + " = inttoptr i64 " + l.val + " to i8*\n";
                    }
                    lv3 = lt3;
                }
                if r.ty != "i8*" {
                    var rt3 = nextTemp(ctx);
                    if r.ty.endsWith("*") {
                        code = code + rt3 + " = bitcast " + r.ty + " " + r.val + " to i8*\n";
                    } else {
                        code = code + rt3 + " = inttoptr i64 " + r.val + " to i8*\n";
                    }
                    rv3 = rt3;
                }
                var eq = nextTemp(ctx);
                code = code + eq + " = call i64 @rey_str_eq(i8* " + lv3 + ", i8* " + rv3 + ")\n";
                var b = nextTemp(ctx);
                if binaryExpr.op == "==" {
                    code = code + b + " = icmp ne i64 " + eq + ", 0\n";
                } else {
                    code = code + b + " = icmp eq i64 " + eq + ", 0\n";
                }
                return GenExprResult { ty: "i1", val: b, code: code };
            }
            var leftEnumKey = leftSourceType;
            if !ctx.enumDefs.has(leftEnumKey) { leftEnumKey = cgResolveNominalKey(ctx, "Enum", leftSourceType); }
            var rightEnumKey = rightSourceType;
            if !ctx.enumDefs.has(rightEnumKey) { rightEnumKey = cgResolveNominalKey(ctx, "Enum", rightSourceType); }
            if (leftEnumKey != "" && ctx.enumDefs.has(leftEnumKey)) || (rightEnumKey != "" && ctx.enumDefs.has(rightEnumKey)) {
                if leftEnumKey == "" || leftEnumKey != rightEnumKey || !ctx.enumDefs.has(leftEnumKey) || (l.ty != "i64" && !l.ty.endsWith("*")) || (r.ty != "i64" && !r.ty.endsWith("*")) {
                    return cgErrorExpr(ctx, "enum equality requires matching checked enum layouts: " + leftSourceType + " vs " + rightSourceType);
                }
                var leftEnumVal = l.val;
                var rightEnumVal = r.val;
                if l.ty.endsWith("*") {
                    var leftEnumCast = nextTemp(ctx);
                    code = code + leftEnumCast + " = ptrtoint " + l.ty + " " + l.val + " to i64\n";
                    leftEnumVal = leftEnumCast;
                }
                if r.ty.endsWith("*") {
                    var rightEnumCast = nextTemp(ctx);
                    code = code + rightEnumCast + " = ptrtoint " + r.ty + " " + r.val + " to i64\n";
                    rightEnumVal = rightEnumCast;
                }
                var enumDef: EnumDef = ctx.enumDefs.get(leftEnumKey);
                var equalValue = nextTemp(ctx);
                code = code + equalValue + " = call i64 @rey_enum_eq(i64 " + leftEnumVal + ", i64 " + rightEnumVal + ", i64 " + enumDef.identity.toString() + ")\n";
                var enumCondition = nextTemp(ctx);
                if binaryExpr.op == "==" {
                    code = code + enumCondition + " = icmp ne i64 " + equalValue + ", 0\n";
                } else {
                    code = code + enumCondition + " = icmp eq i64 " + equalValue + ", 0\n";
                }
                return GenExprResult { ty: "i1", val: enumCondition, code: code };
            }
            if cgTupleCount(leftSourceType) >= 0 || cgTupleCount(rightSourceType) >= 0 {
                if leftSourceType != rightSourceType || l.ty != "i64" || r.ty != "i64" {
                    return cgErrorExpr(ctx, "tuple equality requires matching tuple types");
                }
                var tupleEqual = nextTemp(ctx);
                code = code + tupleEqual + " = call i64 @rey_tuple_eq(i64 " + l.val + ", i64 " + r.val + ")\n";
                var tupleCondition = nextTemp(ctx);
                if binaryExpr.op == "==" {
                    code = code + tupleCondition + " = icmp ne i64 " + tupleEqual + ", 0\n";
                } else {
                    code = code + tupleCondition + " = icmp eq i64 " + tupleEqual + ", 0\n";
                }
                return GenExprResult { ty: "i1", val: tupleCondition, code: code };
            }
            var leftScalarNullable = cgScalarNullableInner(leftSourceType);
            if leftScalarNullable != "" && leftSourceType == rightSourceType && l.ty == "i64" && r.ty == "i64" {
