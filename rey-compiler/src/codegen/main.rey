            var returnScalar = cgScalarNullableInner(declaredReturn);
            if returnScalar != "" && cgSourceType(ctx, stmtRS.value) == returnScalar {
                var boxedReturn = cgBoxScalar(ctx, returnScalar, GenExprResult { ty: rvR.ty, val: retVal, code: "" });
                retCode = retCode + boxedReturn.code;
                retVal = boxedReturn.val;
                retValueTy = boxedReturn.ty;
            }
        }
        if ctx.currentRetTy == "i64" {
            if retValueTy == "i1" {
                var ext = nextTemp(ctx);
                retCode = retCode + ext + " = zext i1 " + retVal + " to i64\n";
                retVal = ext;
            } else if retValueTy != "i64" {
                if retValueTy.endsWith("*") {
                    var ext = nextTemp(ctx);
                    retCode = retCode + ext + " = ptrtoint " + retValueTy + " " + retVal + " to i64\n";
                    retVal = ext;
                }
            }
        } else if ctx.currentRetTy.endsWith("*") {
            if retValueTy == "i64" {
                var ext = nextTemp(ctx);
                retCode = retCode + ext + " = inttoptr i64 " + retVal + " to " + ctx.currentRetTy + "\n";
                retVal = ext;
            }
        }
        return retCode + "ret " + ctx.currentRetTy + " " + retVal + "\n";
    }
    if blockPayload != null {
        var stmtBS: BlockStmt = blockPayload;
        var savedBlock = cgCopyLocals(ctx.locals);
        var blockCode = genStmtList(ctx, stmtBS.statements);
        ctx.locals = cgCopyLocals(savedBlock);
        return blockCode;
    }
    if matchPayload != null {
        var stmtMatch: MatchStmt = matchPayload;
        return genMatchStmt(ctx, stmtMatch);
    }
    cgSetError(ctx, "unsupported statement node");
    return "";
}

func cgFindFunctionSymbol(ctx: CodegenContext, sourcePath: string, moduleId: string, name: string): ResolvedSymbol? {
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
        var checkedProgram: CheckedProgram = maybeProgram;
        var i = 0;
        var found: ResolvedSymbol? = null;
        loop {
            if i >= checkedProgram.symbols.len() { break; }
            var symbol: ResolvedSymbol = checkedProgram.symbols[i];
            if symbol.sourcePath == sourcePath && symbol.moduleId == moduleId && symbol.sourceName == name && symbol.kind == "Function" && symbol.receiverPassing == "None" {
                if found != null { cgSetError(ctx, "ambiguous resolved function identity: " + moduleId + "::" + name); return null; }
                found = symbol;
            }
            i = i + 1;
        }
        return found;
    }
    return null;
}

func genFunc2(ctx: CodegenContext, fDecl: FuncDeclStmt, resolvedSymbol: ResolvedSymbol?): string {
    ctx.blockId = 0;
    var fnName = fDecl.name;
    ctx.locals = HashMap.new();
    ctx.loopStack = Vec.new();
    ctx.funcAllocas = "";  // reset per-function alloca accumulator
    var retTy = "i64";
    if ctx.checkedProgram != null {
        if resolvedSymbol != null {
            var checkedSymbol: ResolvedSymbol = resolvedSymbol;
            if checkedSymbol.signature.kind != "Function" || checkedSymbol.llvmName == "" || checkedSymbol.signature.params.len() != fDecl.params.len() {
                cgSetError(ctx, "checked function declaration/signature mismatch: " + checkedSymbol.sourceName);
            }
            fnName = checkedSymbol.llvmName;
            var maybeReturn = checkedSymbol.signature.ret;
            if maybeReturn != null {
                var returnType: Type = maybeReturn;
                retTy = cgCheckedLLVMType(ctx, returnType);
            } else {
                cgSetError(ctx, "checked function has no return type: " + checkedSymbol.sourceName);
            }
        } else {
            cgSetError(ctx, "function declaration has no source/module resolved symbol: " + fDecl.name);
        }
    } else if ctx.funcSymbols.has(fnName) {
        fnName = ctx.funcSymbols.get(fnName);
    } else {
        cgSetError(ctx, "function declaration has no resolved symbol: " + fnName);
    }
    if ctx.checkedProgram == null && fDecl.name == "main" {
        retTy = "void";
    } else if ctx.checkedProgram == null {
        retTy = llvmTypeFromTagCtx(ctx, fDecl.returnType);
    }
    ctx.currentRetTy = retTy;
    ctx.currentFunc = fnName;
    var retSourceName = "";
    if ctx.checkedProgram != null {
        if resolvedSymbol != null {
            var checkedReturnSymbol: ResolvedSymbol = resolvedSymbol;
            var maybeCheckedReturn = checkedReturnSymbol.signature.ret;
            if maybeCheckedReturn != null {
                var checkedReturnType: Type = maybeCheckedReturn;
                retSourceName = cgCheckedTypeName(ctx, checkedReturnType);
            }
        }
    } else {
        retSourceName = cgCanonicalSourceType(fDecl.returnType);
        if fDecl.returnTypeExpr != null { retSourceName = cgSourceTypeFromTypeExpr(ctx, fDecl.returnTypeExpr); }
    }
    ctx.funcSourceRetTypes.set("@ret:" + fnName, retSourceName);

    var params = "";
    var i = 0;
    loop {
        if i >= fDecl.params.len() { break; }
        if i > 0 { params = params + ", "; }
        var p: FuncParam = fDecl.params[i];
        var pty = llvmTypeFromTagCtx(ctx, p.typeTag);
        if ctx.checkedProgram != null {
            if resolvedSymbol != null {
                var checkedParams: ResolvedSymbol = resolvedSymbol;
                pty = cgCheckedLLVMType(ctx, checkedParams.signature.params[i]);
            }
        }
        params = params + pty + " %" + p.name;
        i = i + 1;
    }
    if ctx.methodStructKey != "" && ctx.structDefs.has(ctx.methodStructKey) {
        var methodDef: StructDef = ctx.structDefs.get(ctx.methodStructKey);
        ctx.methodSelfTy = methodDef.llvmName + "*";
        ctx.methodSelfPtr = "%self";
        var selfParam = ctx.methodSelfTy + " %self";
        if params == "" { params = selfParam; }
        else { params = selfParam + ", " + params; }
    }

    // Build header with param allocas/stores
    var header = "define " + retTy + " @" + fnName + "(" + params + ") {{\n";
    header = header + "entry:\n";

    i = 0;
    loop {
        if i >= fDecl.params.len() { break; }
        var p2: FuncParam = fDecl.params[i];
        var pty2 = llvmTypeFromTagCtx(ctx, p2.typeTag);
        var sourceParamType = cgCanonicalSourceType(p2.typeTag);
        if p2.typeExpr != null { sourceParamType = cgSourceTypeFromTypeExpr(ctx, p2.typeExpr); }
        if ctx.checkedProgram != null {
            if resolvedSymbol != null {
                var checkedParams2: ResolvedSymbol = resolvedSymbol;
                pty2 = cgCheckedLLVMType(ctx, checkedParams2.signature.params[i]);
                sourceParamType = cgCheckedTypeName(ctx, checkedParams2.signature.params[i]);
            }
        }
        var ptrp = "%" + p2.name + ".addr";
        header = header + ptrp + " = alloca " + pty2 + ", align 8\n";
        header = header + "store " + pty2 + " %" + p2.name + ", " + pty2 + "* " + ptrp + "\n";
        ctx.locals.set(p2.name, LocalVar { ptr: ptrp, ty: pty2, sourceType: sourceParamType });
        i = i + 1;
    }
    if ctx.methodSelfPtr == "%self" && ctx.methodSelfTy != "" {
        var selfAddr = "%self.addr";
        header = header + selfAddr + " = alloca " + ctx.methodSelfTy + ", align 8\n";
        header = header + "store " + ctx.methodSelfTy + " %self, " + ctx.methodSelfTy + "* " + selfAddr + "\n";
        ctx.locals.set("self", LocalVar { ptr: selfAddr, ty: ctx.methodSelfTy, sourceType: ctx.methodStructKey });
    }

    // Generate body — var allocas go to ctx.funcAllocas, stores remain inline
    var bodyCode = genStmtList(ctx, fDecl.body);

    // Assemble: header + hoisted var allocas + body
    var code = header + ctx.funcAllocas + bodyCode;
    var bodyTerminates = stmtListEndsWithTerminator(fDecl.body);
    if !bodyTerminates {
        if retTy == "i32" {
            code = code + "ret i32 0\n";
        } else if retTy == "void" {
            code = code + "ret void\n";
        } else if retTy == "i8*" {
            code = code + "ret i8* null\n";
        } else if retTy.endsWith("*") {
            code = code + "ret " + retTy + " null\n";
        } else {
            code = code + "ret i64 0\n";
        }
    }
    code = code + "}}\n\n";
    return code;
}

func cgBuildCheckedNominalDefs(ctx: CodegenContext, checkedProgram: CheckedProgram) {
    if checkedProgram.nominalLayouts.len() == 0 { return; }
    var identityStride = 1;
    var unitIndex = 0;
    loop {
        if unitIndex >= checkedProgram.units.len() { break; }
        var unit: SourceUnit = checkedProgram.units[unitIndex];
        if unit.program.statements.len() >= identityStride { identityStride = unit.program.statements.len() + 1; }
        unitIndex = unitIndex + 1;
    }

    var layoutIndex = 0;
    loop {
        if layoutIndex >= checkedProgram.nominalLayouts.len() { break; }
        var layout: CheckedNominalLayout = checkedProgram.nominalLayouts[layoutIndex];
        var key = cgNominalKey(layout.kind, layout.sourcePath, layout.moduleId, layout.name, layout.declarationIndex);
        if layout.kind == "Struct" {
            if ctx.structDefs.has(key) {
                cgSetError(ctx, "duplicate checked struct layout: " + layout.moduleId + "::" + layout.name);
            } else {
                ctx.structDefs.set(key, StructDef { llvmName: "%struct.s" + layoutIndex.toString(), sourceName: layout.name, sourcePath: layout.sourcePath, moduleId: layout.moduleId, declarationIndex: layout.declarationIndex, fields: [] });
                ctx.structTags.set(key, ctx.nextStructTag);
                ctx.nextStructTag = ctx.nextStructTag + 1;
            }
        } else if layout.kind == "Enum" {
            if ctx.enumDefs.has(key) {
                cgSetError(ctx, "duplicate checked enum layout: " + layout.moduleId + "::" + layout.name);
            } else {
                var ownerUnit = cgUnitIndex(checkedProgram, layout.sourcePath, layout.moduleId);
                if ownerUnit < 0 { cgSetError(ctx, "checked enum layout has no owning source unit: " + layout.moduleId + "::" + layout.name); }
                var identity = layout.declarationIndex;
                if ownerUnit >= 0 { identity = ownerUnit * identityStride + layout.declarationIndex; }
                ctx.enumDefs.set(key, EnumDef { identity: identity, sourceName: layout.name, declarationIndex: layout.declarationIndex, sourcePath: layout.sourcePath, moduleId: layout.moduleId, variants: [] });
            }
        } else {
            cgSetError(ctx, "checked nominal layout has unknown kind: " + layout.kind);
        }
        layoutIndex = layoutIndex + 1;
    }

    layoutIndex = 0;
    loop {
        if layoutIndex >= checkedProgram.nominalLayouts.len() { break; }
        var filled: CheckedNominalLayout = checkedProgram.nominalLayouts[layoutIndex];
        var filledKey = cgNominalKey(filled.kind, filled.sourcePath, filled.moduleId, filled.name, filled.declarationIndex);
        if filled.kind == "Struct" && ctx.structDefs.has(filledKey) {
            var current: StructDef = ctx.structDefs.get(filledKey);
            var fields: Vec<StructFieldDef> = [];
            var expectedField = 0;
            loop {
                if expectedField >= filled.fields.len() { break; }
                var foundField = false;
                var fieldCursor = 0;
                loop {
                    if fieldCursor >= filled.fields.len() { break; }
                    var field: CheckedNominalField = filled.fields[fieldCursor];
                    if field.fieldIndex == expectedField {
                        var fieldSourceType = cgCheckedTypeName(ctx, field.ty);
                        var fieldLlvmType = cgCheckedLLVMType(ctx, field.ty);
                        if fieldSourceType == "" || fieldSourceType == "unsupported" || fieldLlvmType == "void" {
                            cgSetError(ctx, "checked struct field has no codegen type: " + filled.moduleId + "::" + filled.name + "." + field.name);
                        }
                        fields.push(StructFieldDef { name: field.name, ty: fieldLlvmType, sourceType: fieldSourceType });
                        foundField = true;
                        break;
                    }
                    fieldCursor = fieldCursor + 1;
                }
                if !foundField {
                    cgSetError(ctx, "checked struct field index is not dense: " + filled.moduleId + "::" + filled.name);
                    break;
                }
                expectedField = expectedField + 1;
            }
            ctx.structDefs.set(filledKey, StructDef { llvmName: current.llvmName, sourceName: current.sourceName, sourcePath: current.sourcePath, moduleId: current.moduleId, declarationIndex: current.declarationIndex, fields: fields });
        } else if filled.kind == "Enum" && ctx.enumDefs.has(filledKey) {
            var currentEnum: EnumDef = ctx.enumDefs.get(filledKey);
            var variants: Vec<EnumVariantDef> = [];
            var expectedVariant = 0;
            loop {
                if expectedVariant >= filled.variants.len() { break; }
                var foundVariant = false;
                var variantCursor = 0;
                loop {
                    if variantCursor >= filled.variants.len() { break; }
                    var variant: CheckedNominalVariant = filled.variants[variantCursor];
                    if variant.variantIndex == expectedVariant {
                        var payloadTypes: Vec<string> = [];
                        var payloadCursor = 0;
                        loop {
                            if payloadCursor >= variant.payloadTypes.len() { break; }
                            var payloadSourceType = cgCheckedTypeName(ctx, variant.payloadTypes[payloadCursor]);
                            if payloadSourceType == "" || payloadSourceType == "unsupported" {
                                cgSetError(ctx, "checked enum payload has no codegen type: " + filled.moduleId + "::" + filled.name + "::" + variant.name);
                            } else {
                                cgEnumPayloadKind(ctx, payloadSourceType);
                            }
                            payloadTypes.push(payloadSourceType);
                            payloadCursor = payloadCursor + 1;
                        }
                        variants.push(EnumVariantDef { name: variant.name, payloadTypes: payloadTypes });
                        foundVariant = true;
                        break;
                    }
                    variantCursor = variantCursor + 1;
                }
                if !foundVariant {
                    cgSetError(ctx, "checked enum variant index is not dense: " + filled.moduleId + "::" + filled.name);
                    break;
                }
                expectedVariant = expectedVariant + 1;
            }
            ctx.enumDefs.set(filledKey, EnumDef { identity: currentEnum.identity, sourceName: currentEnum.sourceName, declarationIndex: currentEnum.declarationIndex, sourcePath: currentEnum.sourcePath, moduleId: currentEnum.moduleId, variants: variants });
        }
        layoutIndex = layoutIndex + 1;
    }
}

func cgGenerateModuleInitializers(ctx: CodegenContext, checkedProgram: CheckedProgram) {
    var savedPath = ctx.currentSourcePath;
    var savedModuleId = ctx.currentModuleId;
    var savedInitializerMode = ctx.inGlobalInitializer;
    var unitIndex = 0;
    loop {
        if unitIndex >= checkedProgram.units.len() { break; }
        var unit: SourceUnit = checkedProgram.units[unitIndex];
        ctx.currentSourcePath = unit.sourcePath;
        ctx.currentModuleId = unit.moduleId;
        ctx.inGlobalInitializer = true;
        ctx.locals = HashMap.new();
        ctx.loopStack = Vec.new();
        ctx.funcAllocas = "";
        ctx.blockId = 0;
        var initCode = "";
        var terminated = false;
        var statementIndex = 0;
        loop {
            if statementIndex >= unit.program.statements.len() || terminated { break; }
            var statement: Stmt = unit.program.statements[statementIndex];
            match statement {
                Stmt::FuncDecl(_) => {},
                Stmt::StructDecl(_) => {},
                Stmt::EnumDecl(_) => {},
                Stmt::Import(_) => {},
                Stmt::VarDecl(_) => {
                    initCode = initCode + genStmt2(ctx, statement);
                    if cgStatementTerminates(statement) { terminated = true; }
                },
                Stmt::ConstDecl(_) => {
                    initCode = initCode + genStmt2(ctx, statement);
                    if cgStatementTerminates(statement) { terminated = true; }
                },
                Stmt::If(_) => {
                    initCode = initCode + genStmt2(ctx, statement);
                    if cgStatementTerminates(statement) { terminated = true; }
                },
                Stmt::Assign(_) => {
                    initCode = initCode + genStmt2(ctx, statement);
                    if cgStatementTerminates(statement) { terminated = true; }
                },
                Stmt::Return(_) => {
                    cgSetError(ctx, "return is invalid in module initialization");
                    terminated = true;
                },
                Stmt::Break(_) => {
                    cgSetError(ctx, "break is invalid in module initialization");
                    terminated = true;
                },
                Stmt::Continue(_) => {
                    cgSetError(ctx, "continue is invalid in module initialization");
                    terminated = true;
                },
                Stmt::While(_) => {
                    initCode = initCode + genStmt2(ctx, statement);
                    if cgStatementTerminates(statement) { terminated = true; }
                },
                Stmt::For(_) => {
                    initCode = initCode + genStmt2(ctx, statement);
                    if cgStatementTerminates(statement) { terminated = true; }
                },
                Stmt::Loop(_) => {
                    initCode = initCode + genStmt2(ctx, statement);
                    if cgStatementTerminates(statement) { terminated = true; }
                },
                Stmt::Block(_) => {
                    initCode = initCode + genStmt2(ctx, statement);
                    if cgStatementTerminates(statement) { terminated = true; }
                },
                Stmt::ExprStmt(_) => {
                    initCode = initCode + genStmt2(ctx, statement);
                    if cgStatementTerminates(statement) { terminated = true; }
                },
                Stmt::Match(_) => {
                    initCode = initCode + genStmt2(ctx, statement);
                    if cgStatementTerminates(statement) { terminated = true; }
                },
            }
            statementIndex = statementIndex + 1;
        }
        var initName = "__rey_init_module" + unitIndex.toString();
        var functionBody = "define void @" + initName + "() {{\nentry:\n" + ctx.funcAllocas + initCode;
        if !terminated { functionBody = functionBody + "ret void\n"; }
        functionBody = functionBody + "}}\n\n";
        ctx.moduleInitBodies = ctx.moduleInitBodies + functionBody;
        ctx.moduleInitCalls = ctx.moduleInitCalls + "  call void @" + initName + "()\n";
        unitIndex = unitIndex + 1;
    }
    ctx.currentSourcePath = savedPath;
    ctx.currentModuleId = savedModuleId;
    ctx.inGlobalInitializer = savedInitializerMode;
    ctx.locals = HashMap.new();
}

func hostTargetTriple(): string {
    var osResult: Result<string, string> = exec("uname -s");
    var archResult: Result<string, string> = exec("uname -m");
    if osResult.isErr() || archResult.isErr() {
        var windowsResult: Result<string, string> = exec("cmd /c ver");
        if windowsResult.isOk() && windowsResult.unwrap().contains("Windows") {
            return "x86_64-w64-windows-gnu";
        }
        return "unknown-unknown-unknown";
    }
    var osName = osResult.unwrap().trim();
    var archName = archResult.unwrap().trim().toLower();

    if osName == "Darwin" {
        if archName == "arm64" || archName == "aarch64" { return "aarch64-apple-darwin"; }
        if archName == "x86_64" || archName == "amd64" { return "x86_64-apple-darwin"; }
    }
    if osName == "Linux" {
        if archName == "arm64" || archName == "aarch64" { return "aarch64-unknown-linux-gnu"; }
        if archName == "x86_64" || archName == "amd64" { return "x86_64-unknown-linux-gnu"; }
    }
    if osName.startsWith("MINGW") || osName.startsWith("MSYS") || osName.startsWith("CYGWIN") {
        return "x86_64-w64-windows-gnu";
    }
    return "unknown-unknown-unknown";
}

func codegenProgramChecked(program: Program, checked: CheckedProgram?, sourcePath: string, moduleId: string): string {
    var ctx = ctxNew("rey");
    ctx.checkedProgram = checked;
    ctx.currentSourcePath = sourcePath;
    ctx.currentModuleId = moduleId;
    cgBuildCheckedIndexes(ctx);
    if checked != null {
        var checkedLayouts: CheckedProgram = checked;
        cgBuildCheckedNominalDefs(ctx, checkedLayouts);
    }
    var bodies = "";

    var i = 0;
    loop {
        if i >= program.statements.len() { break; }
        var declaration: Stmt = program.statements[i];
        match declaration {
            Stmt::StructDecl(structDecl) => {
                if checked == null && !ctx.structDefs.has(structDecl.name) {
                    ctx.structDefs.set(structDecl.name, StructDef { llvmName: "%struct." + structDecl.name, sourceName: structDecl.name, sourcePath: ctx.currentSourcePath, moduleId: ctx.currentModuleId, declarationIndex: i, fields: [] });
                    ctx.structTags.set(structDecl.name, ctx.nextStructTag);
                    ctx.nextStructTag = ctx.nextStructTag + 1;
                }
            },
            Stmt::VarDecl(_) => {},
            Stmt::ConstDecl(_) => {},
            Stmt::FuncDecl(_) => {},
        Stmt::EnumDecl(enumDecl) => {
            if checked == null {
                var variants: Vec<EnumVariantDef> = [];
                var variantIndex = 0;
                loop {
                    if variantIndex >= enumDecl.variantDecls.len() { break; }
                    var variantDecl: EnumVariantDecl = enumDecl.variantDecls[variantIndex];
                    var payloadTypes: Vec<string> = [];
                    var payloadIndex = 0;
                    loop {
                        if payloadIndex >= variantDecl.payloadTypes.len() { break; }
                        payloadTypes.push(cgSourceTypeFromTypeExpr(ctx, variantDecl.payloadTypes[payloadIndex]));
                        payloadIndex = payloadIndex + 1;
                    }
                    variants.push(EnumVariantDef { name: variantDecl.name, payloadTypes: payloadTypes });
                    variantIndex = variantIndex + 1;
                }
                ctx.enumDefs.set(enumDecl.name, EnumDef { identity: i, sourceName: enumDecl.name, declarationIndex: i, sourcePath: ctx.currentSourcePath, moduleId: ctx.currentModuleId, variants: variants });
            }
        },
            Stmt::Import(_) => {},
            Stmt::If(_) => {},
            Stmt::Assign(_) => {},
            Stmt::Return(_) => {},
            Stmt::Break(_) => {},
            Stmt::Continue(_) => {},
            Stmt::While(_) => {},
            Stmt::For(_) => {},
            Stmt::Loop(_) => {},
            Stmt::Block(_) => {},
            Stmt::ExprStmt(_) => {},
            Stmt::Match(_) => {},
        }
        i = i + 1;
    }

    i = 0;
    loop {
        if i >= program.statements.len() { break; }
        var st0: Stmt = program.statements[i];
        match st0 {
        Stmt::StructDecl(sDcl) => {
            if sDcl.methods.len() > 0 && checked == null {
                cgSetError(ctx, "struct methods require resolved method symbols");
            }
            if checked == null {
            var llvmName = "%struct." + sDcl.name;
            var fields: Vec<StructFieldDef> = [];
            var j = 0;
            loop {
                if j >= sDcl.fields.len() { break; }
                var f: StructField = sDcl.fields[j];
                if checked == null && f.typeExpr != null && f.typeTag == "" {
                    cgSetError(ctx, "struct field TypeExpr requires checker-resolved type metadata");
                }
                var fieldSourceType = cgCanonicalSourceType(f.typeTag);
                if f.typeExpr != null { fieldSourceType = cgSourceTypeFromTypeExpr(ctx, f.typeExpr); }
                var fieldLLVMType = llvmTypeFromTagCtx(ctx, fieldSourceType);
                fields.push(StructFieldDef { name: f.name, ty: fieldLLVMType, sourceType: fieldSourceType });
                j = j + 1;
            }
            ctx.structDefs.set(sDcl.name, StructDef { llvmName: llvmName, sourceName: sDcl.name, sourcePath: ctx.currentSourcePath, moduleId: ctx.currentModuleId, declarationIndex: i, fields: fields });
            if !ctx.structTags.has(sDcl.name) {
                ctx.structTags.set(sDcl.name, ctx.nextStructTag);
                ctx.nextStructTag = ctx.nextStructTag + 1;
            }
            }
        },
        Stmt::EnumDecl(eDcl) => {
            if checked == null {
            if !ctx.enumDefs.has(eDcl.name) {
                cgSetError(ctx, "checked enum declaration layout is missing: " + eDcl.name);
            } else {
                var enumDef: EnumDef = ctx.enumDefs.get(eDcl.name);
                if enumDef.declarationIndex != i || enumDef.sourcePath != ctx.currentSourcePath || enumDef.moduleId != ctx.currentModuleId || enumDef.variants.len() != eDcl.variantDecls.len() || enumDef.variants.len() != eDcl.variants.len() {
                    cgSetError(ctx, "enum declaration variant layout mismatch: " + eDcl.name);
                }
                var variantIndex = 0;
                loop {
                    if variantIndex >= eDcl.variantDecls.len() || variantIndex >= enumDef.variants.len() { break; }
                    var variantDecl: EnumVariantDecl = eDcl.variantDecls[variantIndex];
                    var variantDef: EnumVariantDef = enumDef.variants[variantIndex];
                    if variantDef.name != variantDecl.name || variantDef.payloadTypes.len() != variantDecl.payloadTypes.len() {
                        cgSetError(ctx, "enum variant payload layout mismatch: " + eDcl.name + "::" + variantDecl.name);
                    }
                    var payloadIndex = 0;
                    loop {
                        if payloadIndex >= variantDecl.payloadTypes.len() || payloadIndex >= variantDef.payloadTypes.len() { break; }
                        var sourceType = cgSourceTypeFromTypeExpr(ctx, variantDecl.payloadTypes[payloadIndex]);
                        if sourceType != variantDef.payloadTypes[payloadIndex] {
                            cgSetError(ctx, "enum payload type changed during layout collection: " + eDcl.name + "::" + variantDecl.name);
                        }
                        cgEnumPayloadKind(ctx, sourceType);
                        payloadIndex = payloadIndex + 1;
                    }
                    variantIndex = variantIndex + 1;
                }
            }
            }
        },
        Stmt::FuncDecl(_) => {},
        Stmt::VarDecl(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::ConstDecl(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::Import(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::If(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::Assign(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::Return(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::Break(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::Continue(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::While(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::For(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::Loop(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::Block(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::ExprStmt(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        Stmt::Match(_) => { if checked == null { cgSetError(ctx, "unsupported top-level statement"); } },
        }
        i = i + 1;
    }

    cgBuildGlobalDefs(ctx);
    cgRegisterCheckedFunctions(ctx);

    // pre-pass: collect function signatures for call-site coercion
    // stored as funcname:N -> paramType; funcname:ret -> returnType
    i = 0;
    loop {
        if i >= program.statements.len() { break; }
        var st: Stmt = program.statements[i];
        match st {
        Stmt::FuncDecl(fSt) => {
            if checked == null {
                if fSt.returnTypeExpr != null && fSt.returnType == "" {
                    cgSetError(ctx, "function return TypeExpr requires checker-resolved type metadata");
                }
                if ctx.funcSymbols.has(fSt.name) {
                    cgSetError(ctx, "duplicate function symbol: " + fSt.name);
                } else {
                    var llvmSymbol = fSt.name;
                    if fSt.name == "main" { llvmSymbol = "_rey_main"; }
                    ctx.funcSymbols.set(fSt.name, llvmSymbol);
                    ctx.funcArities.set(fSt.name, fSt.params.len());
                    ctx.funcSourceRetTypes.set(fSt.name, cgCanonicalSourceType(fSt.returnType));
                }
                var pi = 0;
                loop {
                    if pi >= fSt.params.len() { break; }
                    var fParam: FuncParam = fSt.params[pi];
                    if fParam.hasDefault || fParam.variadic {
                        cgSetError(ctx, "default or variadic parameter requires typed call lowering");
                    }
                    var pSourceType = cgCanonicalSourceType(fParam.typeTag);
                    if fParam.typeExpr != null { pSourceType = cgSourceTypeFromTypeExpr(ctx, fParam.typeExpr); }
                    var pTy = llvmTypeFromTagCtx(ctx, pSourceType);
                    ctx.funcSigs.set(fSt.name + ":" + pi.toString(), pTy);
                    ctx.funcParamSourceTypes.set(fSt.name + ":" + pi.toString(), pSourceType);
                    pi = pi + 1;
                }
                var retSourceType = cgCanonicalSourceType(fSt.returnType);
                if fSt.returnTypeExpr != null { retSourceType = cgSourceTypeFromTypeExpr(ctx, fSt.returnTypeExpr); }
                var retTySig = llvmTypeFromTagCtx(ctx, retSourceType);
                if fSt.name == "main" { retTySig = "void"; }
                ctx.funcSigs.set(fSt.name + ":ret", retTySig);
            } else if !ctx.funcSymbols.has(fSt.name) {
                cgSetError(ctx, "checked function symbol missing for declaration: " + fSt.name);
            }
        },
        Stmt::VarDecl(_) => {},
        Stmt::ConstDecl(_) => {},
        Stmt::StructDecl(_) => {},
        Stmt::EnumDecl(_) => {},
        Stmt::Import(_) => {},
        Stmt::If(_) => {},
        Stmt::Assign(_) => {},
        Stmt::Return(_) => {},
        Stmt::Break(_) => {},
        Stmt::Continue(_) => {},
        Stmt::While(_) => {},
        Stmt::For(_) => {},
        Stmt::Loop(_) => {},
        Stmt::Block(_) => {},
        Stmt::ExprStmt(_) => {},
        Stmt::Match(_) => {},
        }
        i = i + 1;
    }

    if checked != null {
        var checkedGraph: CheckedProgram = checked;
        var unitIndex = 0;
        loop {
            if unitIndex >= checkedGraph.units.len() { break; }
            var unit: SourceUnit = checkedGraph.units[unitIndex];
            ctx.currentSourcePath = unit.sourcePath;
            ctx.currentModuleId = unit.moduleId;
            var statementIndex = 0;
            loop {
                if statementIndex >= unit.program.statements.len() { break; }
                var statement: Stmt = unit.program.statements[statementIndex];
                match statement {
                    Stmt::FuncDecl(functionDecl) => {
                        var maybeSymbol = cgFindFunctionSymbol(ctx, unit.sourcePath, unit.moduleId, functionDecl.name);
                        if maybeSymbol != null {
                            var functionSymbol: ResolvedSymbol = maybeSymbol;
                            bodies = bodies + genFunc2(ctx, functionDecl, functionSymbol);
                        } else {
                            cgSetError(ctx, "checked function has no owner-qualified symbol: " + unit.moduleId + "::" + functionDecl.name);
                        }
                    },
                    Stmt::VarDecl(_) => {},
                    Stmt::ConstDecl(_) => {},
                    Stmt::StructDecl(structDecl) => {
                        var methodIndex = 0;
                        loop {
                            if methodIndex >= structDecl.methods.len() { break; }
                            var methodDecl: FuncDeclStmt = structDecl.methods[methodIndex];
                            var methodSymbol = cgCallFindMethodSymbol(ctx, unit.sourcePath, unit.moduleId, structDecl.name, methodDecl.name);
                            if methodSymbol != null {
                                var resolvedMethod: ResolvedSymbol = methodSymbol;
                                var structKey = cgCheckedStructName(ctx, unit.sourcePath, unit.moduleId, statementIndex);
                                if structKey == "" || !ctx.structDefs.has(structKey) {
                                    cgSetError(ctx, "struct methods require resolved method symbols");
                                } else {
                                    ctx.methodStructKey = structKey;
                                    ctx.methodSelfPtr = "";
                                    ctx.methodSelfTy = "";
                                    bodies = bodies + genFunc2(ctx, methodDecl, resolvedMethod);
                                    ctx.methodStructKey = "";
                                    ctx.methodSelfPtr = "";
                                    ctx.methodSelfTy = "";
                                }
                            } else {
                                cgSetError(ctx, "struct methods require resolved method symbols");
                            }
                            methodIndex = methodIndex + 1;
                        }
                    },
                    Stmt::EnumDecl(_) => {},
                    Stmt::Import(_) => {},
                    Stmt::If(_) => {},
                    Stmt::Assign(_) => {},
                    Stmt::Return(_) => {},
                    Stmt::Break(_) => {},
                    Stmt::Continue(_) => {},
                    Stmt::While(_) => {},
                    Stmt::For(_) => {},
                    Stmt::Loop(_) => {},
                    Stmt::Block(_) => {},
                    Stmt::ExprStmt(_) => {},
                    Stmt::Match(_) => {},
                }
                statementIndex = statementIndex + 1;
            }
            unitIndex = unitIndex + 1;
        }
        ctx.currentSourcePath = sourcePath;
        ctx.currentModuleId = moduleId;
        cgGenerateModuleInitializers(ctx, checkedGraph);
    } else {
        i = 0;
        loop {
            if i >= program.statements.len() { break; }
            var st: Stmt = program.statements[i];
            match st {
                Stmt::FuncDecl(fSt2) => { bodies = bodies + genFunc2(ctx, fSt2, null); },
                Stmt::VarDecl(_) => {},
                Stmt::ConstDecl(_) => {},
                Stmt::StructDecl(_) => {},
                Stmt::EnumDecl(_) => {},
                Stmt::Import(_) => {},
                Stmt::If(_) => {},
                Stmt::Assign(_) => {},
                Stmt::Return(_) => {},
                Stmt::Break(_) => {},
                Stmt::Continue(_) => {},
                Stmt::While(_) => {},
                Stmt::For(_) => {},
                Stmt::Loop(_) => {},
                Stmt::Block(_) => {},
                Stmt::ExprStmt(_) => {},
                Stmt::Match(_) => {},
            }
            i = i + 1;
        }
    }

    if ctx.codegenError != "" {
        return "; REY_CODEGEN_ERROR: " + ctx.codegenError + "\n";
    }

    var code = "; Module: " + ctx.moduleName + "\n";
    code = code + "target triple = \"" + hostTargetTriple() + "\"\n\n";
    code = code + "declare i32 @printf(i8*, ...)\n";
    code = code + "declare i32 @strcmp(i8*, i8*)\n";
    code = code + "declare {{ i64, i1 }} @llvm.sadd.with.overflow.i64(i64, i64)\n";
    code = code + "declare {{ i64, i1 }} @llvm.ssub.with.overflow.i64(i64, i64)\n";
    code = code + "declare {{ i64, i1 }} @llvm.smul.with.overflow.i64(i64, i64)\n";
    code = code + "declare double @llvm.floor.f64(double)\n";
    code = code + "declare double @llvm.ceil.f64(double)\n";
    code = code + "declare double @llvm.round.f64(double)\n";
    code = code + "declare double @llvm.fabs.f64(double)\n";
    code = code + "declare double @llvm.pow.f64(double, double)\n";
    code = code + "declare double @llvm.sqrt.f64(double)\n";
    code = code + "declare double @llvm.log.f64(double)\n";
    code = code + "declare double @llvm.sin.f64(double)\n";
    code = code + "declare double @llvm.cos.f64(double)\n";
    code = code + "declare double @llvm.tan.f64(double)\n";
    // --- rey runtime extern declarations (strings: i8* ABI; vec/map/result: i64 ABI) ---
    code = code + "declare i8*  @rey_str_new(i8*, i64)\n";
    code = code + "declare i8*  @rey_str_cstr(i8*)\n";
    code = code + "declare i8*  @rey_str_empty()\n";
    code = code + "declare i64  @rey_str_len(i8*)\n";
    code = code + "declare i64  @rey_str_hash(i8*)\n";
    code = code + "declare i8*  @rey_str_concat(i8*, i8*)\n";
    code = code + "declare i8*  @rey_str_slice(i8*, i64, i64)\n";
    code = code + "declare i8*  @rey_str_char_at(i8*, i64)\n";
    code = code + "declare i64  @rey_str_index_of(i8*, i8*)\n";
    code = code + "declare i64  @rey_str_starts_with(i8*, i8*)\n";
    code = code + "declare i64  @rey_str_ends_with(i8*, i8*)\n";
    code = code + "declare i8*  @rey_str_trim(i8*)\n";
    code = code + "declare i8*  @rey_str_replace(i8*, i8*, i8*)\n";
    code = code + "declare i8*  @rey_str_repeat(i8*, i64)\n";
    code = code + "declare i8*  @rey_str_to_upper(i8*)\n";
    code = code + "declare i8*  @rey_str_to_lower(i8*)\n";
    code = code + "declare i64  @rey_str_eq(i8*, i8*)\n";
    code = code + "declare i64  @rey_str_split(i8*, i8*)\n";
    code = code + "declare i8*  @rey_int_to_str(i64)\n";
    code = code + "declare i8*  @rey_val_to_str(i64)\n";
    code = code + "declare i8*  @rey_float_to_str(double)\n";
    code = code + "declare i8*  @rey_bool_to_str(i64)\n";
    code = code + "declare i8*  @rey_typed_val_to_str(i64, i64)\n";
    code = code + "declare i64  @rey_value_new(i64, i64)\n";
    code = code + "declare i64  @rey_value_new_nominal(i64, i64, i64)\n";
    code = code + "declare i64  @rey_env_new(i64)\n";
    code = code + "declare void @rey_env_set(i64, i64, i64, i64)\n";
    code = code + "declare i64  @rey_env_get(i64, i64)\n";
    code = code + "declare i64  @rey_closure_new(i64, i64, i64)\n";
    code = code + "declare i64  @rey_closure_fn(i64)\n";
    code = code + "declare i64  @rey_closure_env(i64)\n";
    code = code + "declare i64  @rey_instanceof(i64, i64, i64)\n";
    code = code + "declare i64  @rey_value_unbox(i64, i64)\n";
    code = code + "declare i64  @rey_value_eq(i64, i64)\n";
    code = code + "declare void @rey_print(i8*)\n";
    code = code + "declare void @rey_println(i8*)\n";
    code = code + "declare void @rey_eprint(i8*)\n";
    code = code + "declare void @rey_eprintln(i8*)\n";
    code = code + "declare i64  @rey_vec_new()\n";
    code = code + "declare void @rey_vec_push(i64, i64)\n";
    code = code + "declare void @rey_vec_push_float(i64, double)\n";
    code = code + "declare void @rey_vec_set_float(i64, i64, double)\n";
    code = code + "declare double @rey_vec_get_float(i64, i64)\n";
    code = code + "declare i64  @rey_vec_pop(i64)\n";
    code = code + "declare i64  @rey_vec_len(i64)\n";
    code = code + "declare i64  @rey_vec_get(i64, i64)\n";
    code = code + "declare void @rey_vec_set(i64, i64, i64)\n";
    code = code + "declare i64  @rey_vec_contains(i64, i64)\n";
    code = code + "declare i64  @rey_vec_str_contains(i64, i8*)\n";
    code = code + "declare i8*  @rey_vec_join(i64, i8*)\n";
    code = code + "declare i64  @rey_vec_slice_v(i64, i64, i64)\n";
    code = code + "declare i64  @rey_vec_reverse(i64)\n";
    code = code + "declare void @rey_vec_sort(i64)\n";
    code = code + "declare i64  @rey_vec_map(i64, i64)\n";
    code = code + "declare i64  @rey_vec_filter(i64, i64)\n";
    code = code + "declare i64  @rey_hm_new()\n";
    code = code + "declare void @rey_hm_set(i64, i8*, i64)\n";
    code = code + "declare i64  @rey_hm_get(i64, i8*)\n";
    code = code + "declare i64  @rey_hm_get_checked(i64, i8*)\n";
    code = code + "declare i64  @rey_hm_has(i64, i8*)\n";
    code = code + "declare void @rey_hm_delete(i64, i8*)\n";
    code = code + "declare i64  @rey_hm_keys(i64)\n";
    code = code + "declare i64  @rey_hm_values(i64)\n";
    code = code + "declare i64  @rey_hm_len(i64)\n";
    code = code + "declare i64  @rey_hm_entries(i64)\n";
    code = code + "declare void @rey_hm_set_float(i64, i8*, double)\n";
    code = code + "declare double @rey_hm_get_float(i64, i8*)\n";
    code = code + "declare i64  @rey_str_to_int(i8*)\n";
    code = code + "declare double @rey_str_to_float(i8*)\n";
    code = code + "declare i64  @rey_float_to_int(double)\n";
    code = code + "declare i64  @rey_abs_int(i64)\n";
    code = code + "declare i64  @rey_int_from_char(i8*)\n";
    code = code + "declare i8*  @rey_value_to_str(i64)\n";
    code = code + "declare i64  @rey_ok(i64)\n";
    code = code + "declare i64  @rey_err(i64)\n";
    code = code + "declare i64  @rey_ok_typed(i64, i64)\n";
    code = code + "declare i64  @rey_err_typed(i64, i64)\n";
    code = code + "declare i64  @rey_ok_str(i8*)\n";
    code = code + "declare i64  @rey_err_str(i8*)\n";
    code = code + "declare i64  @rey_result_is_ok(i64)\n";
    code = code + "declare i64  @rey_result_is_err(i64)\n";
    code = code + "declare i64  @rey_result_unwrap(i64)\n";
    code = code + "declare i64  @rey_result_unwrap_err(i64)\n";
    code = code + "declare i64  @rey_result_unwrap_or(i64, i64)\n";
    code = code + "declare i8*  @rey_result_unwrap_str(i64)\n";
    code = code + "declare i8*  @rey_result_unwrap_or_str(i64, i8*)\n";
    code = code + "declare i64  @rey_some(i64)\n";
    code = code + "declare i64  @rey_some_typed(i64, i64)\n";
    code = code + "declare i64  @rey_none()\n";
    code = code + "declare i64  @rey_option_eq(i64, i64)\n";
    code = code + "declare i64  @rey_result_eq(i64, i64)\n";
    code = code + "declare i64  @rey_option_is_some(i64)\n";
    code = code + "declare i64  @rey_option_unwrap(i64)\n";
    code = code + "declare i64  @rey_enum_new(i64, i64, i64)\n";
    code = code + "declare void @rey_enum_set(i64, i64, i64, i64)\n";
    code = code + "declare i64  @rey_enum_is(i64, i64, i64)\n";
    code = code + "declare i64  @rey_enum_get(i64, i64, i64, i64, i64)\n";
    code = code + "declare i64  @rey_enum_eq(i64, i64, i64)\n";
    code = code + "declare i64  @rey_tuple_new(i64)\n";
    code = code + "declare void @rey_tuple_set(i64, i64, i64, i64)\n";
    code = code + "declare i64  @rey_tuple_get(i64, i64)\n";
    code = code + "declare i64  @rey_tuple_eq(i64, i64)\n";
    code = code + "declare i8*  @rey_tuple_to_str(i64)\n";
    code = code + "declare i8*  @rey_vec_to_str(i64)\n";
    code = code + "declare i8*  @rey_hm_to_str(i64)\n";
    code = code + "declare i8*  @rey_option_to_str(i64)\n";
    code = code + "declare i8*  @rey_result_to_str(i64)\n";
    code = code + "declare i8*  @rey_enum_to_str(i64)\n";
    code = code + "declare i64  @rey_instanceof_tag(i64, i64)\n";
    code = code + "declare i64  @rey_struct_instanceof(i64, i64)\n";
    code = code + "declare i8*  @rey_read_file(i8*)\n";
    code = code + "declare void @rey_write_file(i8*, i8*)\n";
    code = code + "declare void @rey_append_file(i8*, i8*)\n";
    code = code + "declare i64  @rey_file_exists(i8*)\n";
    code = code + "declare void @rey_delete_file(i8*)\n";
    code = code + "declare void @rey_mkdir(i8*)\n";
    code = code + "declare i64  @rey_list_dir(i8*)\n";
    code = code + "declare i64  @rey_exec_cmd(i8*)\n";
    code = code + "declare void @rey_exit(i64)\n";
    code = code + "declare i8*  @rey_get_env(i8*)\n";
    code = code + "declare void @rey_init(i32, i8**)\n";
    code = code + "declare i64  @rey_args()\n";
    code = code + "declare void @rey_panic(i8*)\n";
    code = code + "declare i8*  @rey_alloc(i64)\n";
    code = code + "\n";

    var keys = ctx.structDefs.keys();
    i = 0;
    loop {
        if i >= keys.len() { break; }
        var name = keys.get(i);
        var def: StructDef = ctx.structDefs.get(name);
        var line = def.llvmName + " = type {{ ";
        var j = 0;
        loop {
            if j >= def.fields.len() { break; }
            var defFld: StructFieldDef = def.fields[j];
            if j > 0 { line = line + ", "; }
            line = line + defFld.ty;
            j = j + 1;
        }
        line = line + " }}\n";
        code = code + line;
        i = i + 1;
    }
    if keys.len() > 0 {
        code = code + "\n";
    }
    code = code + ctx.globalDeclarations;

    // string constants
    i = 0;
    loop {
        if i >= ctx.strings.len() { break; }
        var s = ctx.strings[i];
        // interpret stored strings: if they already contain \\0A, decode for length via llvmCStringInfo on decoded form
        var info: CStringInfo = llvmCStringInfo(s);
        code = code + llvmStrGlobalName(i) + " = private unnamed_addr constant [" + info.len.toString() + " x i8] c\"" + info.escaped + "\", align 1\n";
        i = i + 1;
    }
    if ctx.strings.len() > 0 {
        code = code + "\n";
    }

    code = code + bodies + ctx.lambdaBodies + ctx.moduleInitBodies;

    // C entry: runtime init, every module initializer, then entry main when defined
    code = code + "define i32 @main(i32 %argc, i8** %argv) {{\n";
    code = code + "entry:\n";
    code = code + "  call void @rey_init(i32 %argc, i8** %argv)\n";
    code = code + ctx.moduleInitCalls;
    if ctx.funcSymbols.has("main") {
        code = code + "  call void @_rey_main()\n";
    }
    code = code + "  ret i32 0\n";
    code = code + "}}\n";

    return code;
}

func codegenProgram2(program: Program): string {
    return codegenProgramChecked(program, null, "", "");
}

pub func generateIRChecked(checked: CheckedProgram): Result<string,string> {
    if checked.units.len() == 0 { return Result.Err(checked.entryPath + ": checked program contains no source units"); }
    var unit: SourceUnit = checked.units[0];
    var foundEntry = false;
    var unitIndex = 0;
    loop {
        if unitIndex >= checked.units.len() { break; }
        var candidate: SourceUnit = checked.units[unitIndex];
        if candidate.isEntry || candidate.sourcePath == checked.entryPath {
            unit = candidate;
            foundEntry = true;
            break;
        }
        unitIndex = unitIndex + 1;
    }
    if !foundEntry { return Result.Err(checked.entryPath + ": checked source graph has no entry unit"); }
    var ir = codegenProgramChecked(unit.program, checked, unit.sourcePath, unit.moduleId);
    var errorMarker = "; REY_CODEGEN_ERROR: ";
    if ir.startsWith(errorMarker) {
        var end = ir.indexOf("\n");
        if end < 0 { end = ir.len(); }
        return Result.Err(ir.slice(errorMarker.len(), end));
    }
    return Result.Ok(ir);
}

func llvmType(ty: Type): string {
    if ty.kind == "Int" {
        return "i64";
    }
    if ty.kind == "Float" {
        return "double";
    }
    if ty.kind == "Bool" {
        return "i64";
    }
    if ty.kind == "String" {
        return "i8*";
    }
    if ty.kind == "Void" {
        return "void";
    }
    if ty.kind == "Array" {
        return "i8*";
    }
    return "i8*";
}

func genLit(lit: Literal): string {
    if lit.kind == LiteralKind::Int {
        return lit.text;
    }
    if lit.kind == LiteralKind::Float {
        return lit.text;
    }
    if lit.kind == LiteralKind::Bool {
        if lit.text == "true" {
            return "1";
        }
        return "0";
    }
    if lit.kind == LiteralKind::String {
        return "\"" + lit.text + "\"";
    }
    if lit.kind == LiteralKind::Null {
        return "null";
    }
    return "undef";
}
pub func generateIR(program: Program): string {
    return codegenProgram2(program);
}

pub func compileLLVM(ir: string, outputPath: string, release: bool, rtDir: string) {
    var errorMarker = "; REY_CODEGEN_ERROR: ";
    if ir.startsWith(errorMarker) {
        var end = ir.indexOf("\n");
        if end < 0 { end = ir.len(); }
        return Result.Err(ir.slice(errorMarker.len(), end));
    }
    var llPath = outputPath + ".ll";
    var objPath = outputPath + ".o";
    // rtDir is the prebuilt archive directory, not the runtime source directory.
    var libPath = rtDir + "/librey_rt.a";
    if !fileExists(libPath) {
        return Result.Err("runtime archive not found: " + libPath + "; build it with scripts/build-runtime.sh --output-dir " + rtDir);
    }

    writeFile(llPath, ir);

    var opt = "-O0";
    var lto = "";
    if release {
        opt = "-O3";
        lto = "-flto";
    }

    if release {
        // Keep the generated module in LLVM bitcode so link-time optimization
        // can inline runtime Vec accessors and optimize loops across the ABI.
        var clangObjCmd = "clang " + opt + " " + lto + " -Wno-override-module -c -x ir \"" + llPath + "\" -o \"" + objPath + "\"";
        var clangObjResult: Result<string,string> = exec(clangObjCmd);
        if clangObjResult.isErr() {
            return Result.Err(clangObjResult.unwrapErr());
        }
    } else {
        var llcCmd = "llc " + opt + " -filetype=obj \"" + llPath + "\" -o \"" + objPath + "\"";
        var llcResult: Result<string,string> = exec(llcCmd);
        if llcResult.isErr() {
            // clang can compile LLVM IR directly when llc isn't installed.
            var clangObjCmd = "clang " + opt + " -Wno-override-module -c -x ir \"" + llPath + "\" -o \"" + objPath + "\"";
            var clangObjResult: Result<string,string> = exec(clangObjCmd);
            if clangObjResult.isErr() {
                return Result.Err(clangObjResult.unwrapErr());
            }
        }
    }

    var clangCmd = "clang";
    if release { clangCmd = clangCmd + " " + opt + " " + lto; }
    clangCmd = clangCmd + " \"" + objPath + "\" \"" + libPath + "\" -o \"" + outputPath + "\"";
    var clangResult: Result<string,string> = exec(clangCmd);
    if clangResult.isErr() {
        return Result.Err(clangResult.unwrapErr());
    }

    // best-effort cleanup (temporarily disabled for debugging)
    // deleteFile(llPath);
    // deleteFile(objPath);

    return Result.Ok(outputPath);
}
