// LLVM Codegen for Rey

struct CodegenContext {
    pub moduleName: String,
    pub functions: [String],
    pub strings: [String],
    pub currentFunc: String,
    pub blockId: int,
    pub locals: HashMap,
    pub currentRetTy: String,
    pub loopStack: Vec,
    pub structDefs: HashMap,
    pub enumDefs: HashMap,
}

func ctxNew(name: String) {
    return CodegenContext {
        moduleName: name,
        functions: [],
        strings: [],
        currentFunc: "",
        blockId: 0,
        locals: HashMap.new(),
        currentRetTy: "i32",
        loopStack: Vec.new(),
        structDefs: HashMap.new(),
        enumDefs: HashMap.new()
    };
}

func cgInternString(ctx, s: String): int {
    var i = 0;
    loop {
        if i >= ctx.strings.length() {
            break;
        }
        if ctx.strings[i] == s {
            return i;
        }
        i = i + 1;
    }
    ctx.strings.push(s);
    return ctx.strings.length() - 1;
}

func llvmEscapeByte(c: String): String {
    if c == "\n" { return "\\0A"; }
    if c == "\r" { return "\\0D"; }
    if c == "\t" { return "\\09"; }
    if c == "\"" { return "\\22"; }
    if c == "\\" { return "\\5C"; }
    return c;
}

func llvmCStringInfo(s: String) {
    var out = "";
    var i = 0;
    var n = 0;
    loop {
        if i >= s.len() {
            break;
        }
        var c = s[i];
        out = out + llvmEscapeByte(c);
        n = n + 1;
        i = i + 1;
    }
    // null terminator
    out = out + "\\00";
    n = n + 1;
    return { escaped: out, len: n };
}

func llvmStrGlobalName(idx: int): String {
    return "@.str" + idx.toString();
}

func llvmStrPtr(idx: int, len: int): String {
    return "getelementptr inbounds ([" + len.toString() + " x i8], [" + len.toString() + " x i8]* " + llvmStrGlobalName(idx) + ", i64 0, i64 0)";
}

func nextTemp(ctx): String {
    var n = ctx.blockId;
    ctx.blockId = ctx.blockId + 1;
    return "%t" + n.toString();
}

func nextLabel(ctx, prefix: String): String {
    var n = ctx.blockId;
    ctx.blockId = ctx.blockId + 1;
    return prefix + n.toString();
}

func llvmTypeFromTagCtx(ctx, tag: String): String {
    if tag == "" { return "i64"; }
    if tag == "int" { return "i64"; }
    if tag == "float" { return "double"; }
    if tag == "bool" { return "i1"; }
    if tag == "String" { return "i8*"; }
    if tag == "Void" { return "void"; }
    if ctx.structDefs.has(tag) {
        var def = ctx.structDefs.get(tag);
        return def.llvmName + "*";
    }
    if ctx.enumDefs.has(tag) {
        return "i64";
    }
    return "i64";
}

func llvmTypeFromTag(tag: String): String {
    return llvmTypeFromTagCtx(ctxNew("tmp"), tag);
}

func blockEndsWithReturn(block): bool {
    if !(block instanceof BlockStmt) { return false; }
    if block.statements.length() == 0 { return false; }
    var last = block.statements[block.statements.length() - 1];
    return last instanceof ReturnStmt;
}

func stmtIsTerminator(stmt): bool {
    if stmt instanceof ReturnStmt { return true; }
    if stmt instanceof BreakStmt { return true; }
    if stmt instanceof ContinueStmt { return true; }
    return false;
}

func blockEndsWithTerminator(block): bool {
    if !(block instanceof BlockStmt) { return false; }
    if block.statements.length() == 0 { return false; }
    var last = block.statements[block.statements.length() - 1];
    return stmtIsTerminator(last);
}

func genExprValue(ctx, expr) {
    if expr instanceof LiteralExpr {
        var k = expr.kind.toString();
        if k == "LiteralKind::String" {
            var idx = cgInternString(ctx, expr.text);
            var info = llvmCStringInfo(expr.text);
            return { ty: "i8*", val: llvmStrPtr(idx, info.len), code: "" };
        }
        if k == "LiteralKind::Int" {
            return { ty: "i64", val: expr.text, code: "" };
        }
        if k == "LiteralKind::Float" {
            return { ty: "double", val: expr.text, code: "" };
        }
        if k == "LiteralKind::Bool" {
            if expr.text == "true" { return { ty: "i1", val: "1", code: "" }; }
            return { ty: "i1", val: "0", code: "" };
        }
    }
    if expr instanceof IdentExpr {
        if ctx.locals.has(expr.name) {
            var local = ctx.locals.get(expr.name);
            var tmp = nextTemp(ctx);
            var code = tmp + " = load " + local.ty + ", " + local.ty + "* " + local.ptr + "\n";
            return { ty: local.ty, val: tmp, code: code };
        }
        return { ty: "i64", val: "%" + expr.name, code: "" };
    }
    if expr instanceof FieldAccessExpr {
        var obj = genExprValue(ctx, expr.object);
        var codeF = obj.code;

        if expr.object instanceof IdentExpr {
            var enumName = expr.object.name;
            if ctx.enumDefs.has(enumName) {
                var variants = ctx.enumDefs.get(enumName);
                var i0 = 0;
                loop {
                    if i0 >= variants.length() { break; }
                    if variants[i0] == expr.name {
                        return { ty: "i64", val: i0.toString(), code: codeF };
                    }
                    i0 = i0 + 1;
                }
            }
        }

        var keys = ctx.structDefs.keys();
        var sname = "";
        var i = 0;
        loop {
            if i >= keys.len() { break; }
            var k = keys.get(i);
            var def = ctx.structDefs.get(k);
            if obj.ty == def.llvmName + "*" {
                sname = k;
                break;
            }
            i = i + 1;
        }
        if sname == "" {
            return { ty: "i64", val: "0", code: codeF };
        }
        var def2 = ctx.structDefs.get(sname);
        var fields = def2.fields;
        var idx = -1;
        i = 0;
        loop {
            if i >= fields.length() { break; }
            if fields[i].name == expr.name {
                idx = i;
                break;
            }
            i = i + 1;
        }
        if idx < 0 {
            return { ty: "i64", val: "0", code: codeF };
        }
        var gep = nextTemp(ctx);
        var fieldTy = fields[idx].ty;
        codeF = codeF + gep + " = getelementptr inbounds " + def2.llvmName + ", " + def2.llvmName + "* " + obj.val + ", i32 0, i32 " + idx.toString() + "\n";
        var tmp2 = nextTemp(ctx);
        codeF = codeF + tmp2 + " = load " + fieldTy + ", " + fieldTy + "* " + gep + "\n";
        return { ty: fieldTy, val: tmp2, code: codeF };
    }
    if expr instanceof BinaryExpr {
        var l = genExprValue(ctx, expr.left);
        var r = genExprValue(ctx, expr.right);
        var code = l.code + r.code;
        if expr.op == "+" || expr.op == "-" || expr.op == "*" || expr.op == "/" || expr.op == "%" {
            var tmp = nextTemp(ctx);
            var inst = "add";
            if expr.op == "-" { inst = "sub"; }
            if expr.op == "*" { inst = "mul"; }
            if expr.op == "/" { inst = "sdiv"; }
            if expr.op == "%" { inst = "srem"; }
            code = code + tmp + " = " + inst + " i64 " + l.val + ", " + r.val + "\n";
            return { ty: "i64", val: tmp, code: code };
        }
        if expr.op == "==" || expr.op == "!=" || expr.op == "<" || expr.op == ">" || expr.op == "<=" || expr.op == ">=" {
            var pred = "eq";
            if expr.op == "!=" { pred = "ne"; }
            if expr.op == "<" { pred = "slt"; }
            if expr.op == ">" { pred = "sgt"; }
            if expr.op == "<=" { pred = "sle"; }
            if expr.op == ">=" { pred = "sge"; }
            var tmp2 = nextTemp(ctx);
            code = code + tmp2 + " = icmp " + pred + " i64 " + l.val + ", " + r.val + "\n";
            return { ty: "i1", val: tmp2, code: code };
        }
        if expr.op == "&&" || expr.op == "||" {
            var tmp3 = nextTemp(ctx);
            var inst2 = "and";
            if expr.op == "||" { inst2 = "or"; }
            code = code + tmp3 + " = " + inst2 + " i1 " + l.val + ", " + r.val + "\n";
            return { ty: "i1", val: tmp3, code: code };
        }
    }
    if expr instanceof UnaryExpr {
        var rv = genExprValue(ctx, expr.right);
        var code2 = rv.code;
        if expr.op == "!" {
            var tmp4 = nextTemp(ctx);
            code2 = code2 + tmp4 + " = xor i1 " + rv.val + ", true\n";
            return { ty: "i1", val: tmp4, code: code2 };
        }
        if expr.op == "-" {
            var tmp5 = nextTemp(ctx);
            code2 = code2 + tmp5 + " = sub i64 0, " + rv.val + "\n";
            return { ty: "i64", val: tmp5, code: code2 };
        }
    }
    if expr instanceof CallExpr {
        if expr.callee instanceof IdentExpr {
            var name = expr.callee.name;
            var retTy = "i64";

            var codeC = "";
            var argsOut = "";
            var i = 0;
            loop {
                if i >= expr.args.length() { break; }
                var av = genExprValue(ctx, expr.args[i]);
                codeC = codeC + av.code;
                if i > 0 { argsOut = argsOut + ", "; }
                argsOut = argsOut + av.ty + " " + av.val;
                i = i + 1;
            }

            var tmp = nextTemp(ctx);
            codeC = codeC + tmp + " = call " + retTy + " @" + name + "(" + argsOut + ")\n";
            return { ty: retTy, val: tmp, code: codeC };
        }
    }
    if expr instanceof StructLiteralExpr {
        if !ctx.structDefs.has(expr.name) {
            return { ty: "i8*", val: "null", code: "" };
        }
        var def = ctx.structDefs.get(expr.name);
        var ptr = nextTemp(ctx);
        var codeS = ptr + " = alloca " + def.llvmName + ", align 8\n";

        var fields = def.fields;
        var i = 0;
        loop {
            if i >= fields.length() { break; }
            var fty = fields[i].ty;
            var gep0 = nextTemp(ctx);
            codeS = codeS + gep0 + " = getelementptr inbounds " + def.llvmName + ", " + def.llvmName + "* " + ptr + ", i32 0, i32 " + i.toString() + "\n";
            if fty == "i64" || fty == "i32" || fty == "i1" {
                codeS = codeS + "store " + fty + " 0, " + fty + "* " + gep0 + "\n";
            }
            i = i + 1;
        }

        i = 0;
        loop {
            if i >= expr.fields.length() { break; }
            var init = expr.fields[i];
            var idx = -1;
            var j = 0;
            loop {
                if j >= fields.length() { break; }
                if fields[j].name == init.name { idx = j; break; }
                j = j + 1;
            }
            if idx >= 0 {
                var val = genExprValue(ctx, init.value);
                codeS = codeS + val.code;
                var gep = nextTemp(ctx);
                var fty2 = fields[idx].ty;
                codeS = codeS + gep + " = getelementptr inbounds " + def.llvmName + ", " + def.llvmName + "* " + ptr + ", i32 0, i32 " + idx.toString() + "\n";
                codeS = codeS + "store " + fty2 + " " + val.val + ", " + fty2 + "* " + gep + "\n";
            }
            i = i + 1;
        }
        return { ty: def.llvmName + "*", val: ptr, code: codeS };
    }
    return { ty: "i64", val: "0", code: "" };
}

func genStmt2(ctx, stmt): String {
    if stmt instanceof VarDeclStmt {
        var init = genExprValue(ctx, stmt.value);
        var ty = llvmTypeFromTagCtx(ctx, stmt.typeTag);
        if stmt.typeTag == "" {
            ty = init.ty;
        }
        var ptr = "%" + stmt.name + ".addr";
        var code0 = init.code;
        code0 = code0 + ptr + " = alloca " + ty + ", align 8\n";
        code0 = code0 + "store " + ty + " " + init.val + ", " + ty + "* " + ptr + "\n";
        ctx.locals.set(stmt.name, { ptr: ptr, ty: ty });
        return code0;
    }
    if stmt instanceof ConstDeclStmt {
        var init2 = genExprValue(ctx, stmt.value);
        var ty2 = llvmTypeFromTagCtx(ctx, stmt.typeTag);
        if stmt.typeTag == "" {
            ty2 = init2.ty;
        }
        var ptr2 = "%" + stmt.name + ".addr";
        var codeC = init2.code;
        codeC = codeC + ptr2 + " = alloca " + ty2 + ", align 8\n";
        codeC = codeC + "store " + ty2 + " " + init2.val + ", " + ty2 + "* " + ptr2 + "\n";
        ctx.locals.set(stmt.name, { ptr: ptr2, ty: ty2 });
        return codeC;
    }
    if stmt instanceof ExprStmt {
        var e = stmt.expr;
        if e instanceof CallExpr {
            var callee = e.callee;
            if callee instanceof IdentExpr && callee.name == "println" {
                if e.args.length() != 1 {
                    return "";
                }
                var arg = genExprValue(ctx, e.args[0]);
                var code = arg.code;
                // format strings
                if arg.ty == "i8*" {
                    var fmtIdx = cgInternString(ctx, "%s\n");
                    var fmtInfo = llvmCStringInfo("%s\n");
                    var fmtPtr = llvmStrPtr(fmtIdx, fmtInfo.len);
                    code = code + "call i32 (i8*, ...) @printf(i8* " + fmtPtr + ", i8* " + arg.val + ")\n";
                    return code;
                }
                if arg.ty == "i64" {
                    var fmtIdx2 = cgInternString(ctx, "%ld\n");
                    var fmtInfo2 = llvmCStringInfo("%ld\n");
                    var fmtPtr2 = llvmStrPtr(fmtIdx2, fmtInfo2.len);
                    code = code + "call i32 (i8*, ...) @printf(i8* " + fmtPtr2 + ", i64 " + arg.val + ")\n";
                    return code;
                }
            }
        }
        var ignored = genExprValue(ctx, e);
        return ignored.code;
    }
    if stmt instanceof AssignStmt {
        if stmt.target instanceof IdentExpr {
            var name = stmt.target.name;
            var rhs = genExprValue(ctx, stmt.value);
            var tyA = rhs.ty;
            if ctx.locals.has(name) {
                tyA = ctx.locals.get(name).ty;
            } else {
                var ptrNew = "%" + name + ".addr";
                var codeNew = rhs.code + ptrNew + " = alloca " + tyA + ", align 8\n";
                codeNew = codeNew + "store " + tyA + " " + rhs.val + ", " + tyA + "* " + ptrNew + "\n";
                ctx.locals.set(name, { ptr: ptrNew, ty: tyA });
                return codeNew;
            }

            var localA = ctx.locals.get(name);
            var codeA = rhs.code;
            if stmt.op == "=" {
                codeA = codeA + "store " + localA.ty + " " + rhs.val + ", " + localA.ty + "* " + localA.ptr + "\n";
                return codeA;
            }

            var cur = nextTemp(ctx);
            codeA = codeA + cur + " = load " + localA.ty + ", " + localA.ty + "* " + localA.ptr + "\n";
            var tmp = nextTemp(ctx);
            var inst = "add";
            if stmt.op == "-=" { inst = "sub"; }
            if stmt.op == "*=" { inst = "mul"; }
            if stmt.op == "/=" { inst = "sdiv"; }
            if stmt.op == "%=" { inst = "srem"; }
            codeA = codeA + tmp + " = " + inst + " " + localA.ty + " " + cur + ", " + rhs.val + "\n";
            codeA = codeA + "store " + localA.ty + " " + tmp + ", " + localA.ty + "* " + localA.ptr + "\n";
            return codeA;
        }
        return "";
    }
    if stmt instanceof IfStmt {
        var condv = genExprValue(ctx, stmt.condition);
        var codeIf = condv.code;
        var condVal = condv.val;
        if condv.ty == "i64" {
            var tmpc = nextTemp(ctx);
            codeIf = codeIf + tmpc + " = icmp ne i64 " + condv.val + ", 0\n";
            condVal = tmpc;
        }
        var thenLabel = nextLabel(ctx, "then");
        var elseLabel = nextLabel(ctx, "else");
        var endLabel = nextLabel(ctx, "endif");

        if stmt.elseBranch == null {
            codeIf = codeIf + "br i1 " + condVal + ", label %" + thenLabel + ", label %" + endLabel + "\n";
            codeIf = codeIf + thenLabel + ":\n";
            codeIf = codeIf + genStmt2(ctx, stmt.thenBranch);
            if !blockEndsWithTerminator(stmt.thenBranch) {
                codeIf = codeIf + "br label %" + endLabel + "\n";
            }
            codeIf = codeIf + endLabel + ":\n";
            return codeIf;
        }

        codeIf = codeIf + "br i1 " + condVal + ", label %" + thenLabel + ", label %" + elseLabel + "\n";
        codeIf = codeIf + thenLabel + ":\n";
        codeIf = codeIf + genStmt2(ctx, stmt.thenBranch);
        if !blockEndsWithTerminator(stmt.thenBranch) {
            codeIf = codeIf + "br label %" + endLabel + "\n";
        }
        codeIf = codeIf + elseLabel + ":\n";
        codeIf = codeIf + genStmt2(ctx, stmt.elseBranch);
        if !blockEndsWithTerminator(stmt.elseBranch) {
            codeIf = codeIf + "br label %" + endLabel + "\n";
        }
        codeIf = codeIf + endLabel + ":\n";
        return codeIf;
    }
    if stmt instanceof BreakStmt {
        if ctx.loopStack.len() == 0 { return ""; }
        var top = ctx.loopStack.get(ctx.loopStack.len() - 1);
        return "br label %" + top.breakLabel + "\n";
    }
    if stmt instanceof ContinueStmt {
        if ctx.loopStack.len() == 0 { return ""; }
        var top2 = ctx.loopStack.get(ctx.loopStack.len() - 1);
        return "br label %" + top2.continueLabel + "\n";
    }
    if stmt instanceof WhileStmt {
        var condLabel = nextLabel(ctx, "while.cond");
        var bodyLabel = nextLabel(ctx, "while.body");
        var endLabel = nextLabel(ctx, "while.end");

        var codeW = "br label %" + condLabel + "\n";
        codeW = codeW + condLabel + ":\n";
        var condv = genExprValue(ctx, stmt.condition);
        codeW = codeW + condv.code;
        var condVal = condv.val;
        if condv.ty == "i64" {
            var tmpc = nextTemp(ctx);
            codeW = codeW + tmpc + " = icmp ne i64 " + condv.val + ", 0\n";
            condVal = tmpc;
        }
        codeW = codeW + "br i1 " + condVal + ", label %" + bodyLabel + ", label %" + endLabel + "\n";
        codeW = codeW + bodyLabel + ":\n";
        ctx.loopStack.push({ breakLabel: endLabel, continueLabel: condLabel });
        codeW = codeW + genStmt2(ctx, stmt.body);
        ctx.loopStack.pop();
        if !(stmt.body instanceof BlockStmt) || !blockEndsWithTerminator(stmt.body) {
            codeW = codeW + "br label %" + condLabel + "\n";
        }
        codeW = codeW + endLabel + ":\n";
        return codeW;
    }
    if stmt instanceof LoopStmt {
        var bodyLabel2 = nextLabel(ctx, "loop.body");
        var endLabel2 = nextLabel(ctx, "loop.end");
        var codeL = "br label %" + bodyLabel2 + "\n";
        codeL = codeL + bodyLabel2 + ":\n";
        ctx.loopStack.push({ breakLabel: endLabel2, continueLabel: bodyLabel2 });
        codeL = codeL + genStmt2(ctx, stmt.body);
        ctx.loopStack.pop();
        if !(stmt.body instanceof BlockStmt) || !blockEndsWithTerminator(stmt.body) {
            codeL = codeL + "br label %" + bodyLabel2 + "\n";
        }
        codeL = codeL + endLabel2 + ":\n";
        return codeL;
    }
    if stmt instanceof ForStmt {
        if stmt.iterable instanceof ArrayExpr {
            var outF = "";
            var nameF = stmt.variable;
            var ptrF = "%" + nameF + ".addr";
            var tyF = "i64";
            if !ctx.locals.has(nameF) {
                outF = outF + ptrF + " = alloca " + tyF + ", align 8\n";
                ctx.locals.set(nameF, { ptr: ptrF, ty: tyF });
            } else {
                ptrF = ctx.locals.get(nameF).ptr;
                tyF = ctx.locals.get(nameF).ty;
            }

            var iF = 0;
            loop {
                if iF >= stmt.iterable.elements.length() { break; }
                var ev = genExprValue(ctx, stmt.iterable.elements[iF]);
                outF = outF + ev.code;
                outF = outF + "store " + tyF + " " + ev.val + ", " + tyF + "* " + ptrF + "\n";
                outF = outF + genStmt2(ctx, stmt.body);
                iF = iF + 1;
            }
            return outF;
        }
        return "";
    }
    if stmt instanceof ReturnStmt {
        if ctx.currentRetTy == "void" {
            return "ret void\n";
        }
        if stmt.value instanceof LiteralExpr {
            if stmt.value.kind.toString() == "LiteralKind::Null" {
                if ctx.currentRetTy == "i32" {
                    return "ret i32 0\n";
                }
                if ctx.currentRetTy == "i64" {
                    return "ret i64 0\n";
                }
            }
        }
        var rv = genExprValue(ctx, stmt.value);
        return rv.code + "ret " + ctx.currentRetTy + " " + rv.val + "\n";
    }
    if stmt instanceof BlockStmt {
        var out = "";
        var i = 0;
        loop {
            if i >= stmt.statements.length() { break; }
            var st = stmt.statements[i];
            out = out + genStmt2(ctx, st);
            if stmtIsTerminator(st) {
                break;
            }
            i = i + 1;
        }
        return out;
    }
    return "";
}

func genFunc2(ctx, f): String {
    ctx.blockId = 0;
    var fnName = f.name;
    ctx.locals = HashMap.new();
    ctx.loopStack = Vec.new();
    var retTy = "i64";
    if fnName == "main" {
        retTy = "i32";
    } else {
        retTy = llvmTypeFromTagCtx(ctx, f.returnType);
    }
    ctx.currentRetTy = retTy;

    var params = "";
    var i = 0;
    loop {
        if i >= f.params.length() { break; }
        if i > 0 { params = params + ", "; }
        var p = f.params[i];
        var pty = llvmTypeFromTagCtx(ctx, p.typeTag);
        params = params + pty + " %" + p.name;
        i = i + 1;
    }

    var code = "define " + retTy + " @" + fnName + "(" + params + ") {\n";
    code = code + "entry:\n";

    i = 0;
    loop {
        if i >= f.params.length() { break; }
        var p2 = f.params[i];
        var pty2 = llvmTypeFromTagCtx(ctx, p2.typeTag);
        var ptrp = "%" + p2.name + ".addr";
        code = code + ptrp + " = alloca " + pty2 + ", align 8\n";
        code = code + "store " + pty2 + " %" + p2.name + ", " + pty2 + "* " + ptrp + "\n";
        ctx.locals.set(p2.name, { ptr: ptrp, ty: pty2 });
        i = i + 1;
    }

    // body is a BlockStmt
    code = code + genStmt2(ctx, f.body);
    if retTy == "i32" {
        code = code + "ret i32 0\n";
    } else if retTy == "void" {
        code = code + "ret void\n";
    } else {
        code = code + "ret i64 0\n";
    }
    code = code + "}\n\n";
    return code;
}

func codegenProgram2(program): String {
    var ctx = ctxNew("rey");
    var bodies = [];

    var i = 0;
    loop {
        if i >= program.statements.length() { break; }
        var st0 = program.statements[i];
        if st0 instanceof StructDeclStmt {
            var llvmName = "%struct." + st0.name;
            var fields = [];
            var j = 0;
            loop {
                if j >= st0.fields.length() { break; }
                var f = st0.fields[j];
                fields.push({ name: f.name, ty: llvmTypeFromTagCtx(ctx, f.typeTag) });
                j = j + 1;
            }
            ctx.structDefs.set(st0.name, { llvmName: llvmName, fields: fields });
        }
        if st0 instanceof EnumDeclStmt {
            ctx.enumDefs.set(st0.name, st0.variants);
        }
        i = i + 1;
    }

    i = 0;
    loop {
        if i >= program.statements.length() { break; }
        var st = program.statements[i];
        if st instanceof FuncDeclStmt {
            bodies.push(genFunc2(ctx, st));
        }
        i = i + 1;
    }

    var code = "; Module: " + ctx.moduleName + "\n";
    code = code + "target datalayout = \"e-m:e-i64:64-f80:128-n8:16:32:64-S128\"\n";
    code = code + "target triple = \"aarch64-apple-darwin\"\n\n";
    code = code + "declare i32 @printf(i8*, ...)\n\n";

    var keys = ctx.structDefs.keys();
    i = 0;
    loop {
        if i >= keys.len() { break; }
        var name = keys.get(i);
        var def = ctx.structDefs.get(name);
        var line = def.llvmName + " = type { ";
        var j = 0;
        loop {
            if j >= def.fields.length() { break; }
            if j > 0 { line = line + ", "; }
            line = line + def.fields[j].ty;
            j = j + 1;
        }
        line = line + " }\n";
        code = code + line;
        i = i + 1;
    }
    if keys.len() > 0 {
        code = code + "\n";
    }

    // string constants
    i = 0;
    loop {
        if i >= ctx.strings.length() { break; }
        var s = ctx.strings[i];
        // interpret stored strings: if they already contain \\0A, decode for length via llvmCStringInfo on decoded form
        var info = llvmCStringInfo(s);
        code = code + llvmStrGlobalName(i) + " = private unnamed_addr constant [" + info.len.toString() + " x i8] c\"" + info.escaped + "\", align 1\n";
        i = i + 1;
    }
    if ctx.strings.length() > 0 {
        code = code + "\n";
    }

    i = 0;
    loop {
        if i >= bodies.length() { break; }
        code = code + bodies[i];
        i = i + 1;
    }
    return code;
}

func llvmType(ty): String {
    if ty.kind == TypeKind.Int {
        return "i64";
    }
    if ty.kind == TypeKind.Float {
        return "double";
    }
    if ty.kind == TypeKind.Bool {
        return "i1";
    }
    if ty.kind == TypeKind.String {
        return "i8*";
    }
    if ty.kind == TypeKind.Void {
        return "void";
    }
    if ty.kind == TypeKind.Array {
        return "i8*";
    }
    return "i8*";
}

func genLit(lit): String {
    if lit.kind == LiteralKind.Int {
        return lit.text;
    }
    if lit.kind == LiteralKind.Float {
        return lit.text;
    }
    if lit.kind == LiteralKind.Bool {
        if lit.text == "true" {
            return "1";
        }
        return "0";
    }
    if lit.kind == LiteralKind.String {
        return "\"" + lit.text + "\"";
    }
    if lit.kind == LiteralKind.Null {
        return "null";
    }
    return "undef";
}

func genExpr(ctx, expr, env): String {
    if expr.kind == ExprKind.Literal {
        var le = expr;
        return genLit(le);
    }
    if expr.kind == ExprKind.Identifier {
        var ie = expr;
        return "%" + ie.name;
    }
    if expr.kind == ExprKind.Binary {
        var be = expr;
        var left = genExpr(ctx, be.left, env);
        var right = genExpr(ctx, be.right, env);
        var op = "+";
        if be.op == "-" { op = "-"; }
        if be.op == "*" { op = "*"; }
        if be.op == "/" { op = "sitofp"; }
        if be.op == "==" { op = "icmp eq"; }
        if be.op == "!=" { op = "icmp ne"; }
        if be.op == "<" { op = "icmp slt"; }
        if be.op == ">" { op = "icmp sgt"; }
        if be.op == "<=" { op = "icmp sle"; }
        if be.op == ">=" { op = "icmp sge"; }
        return left + " " + op + " " + right;
    }
    if expr.kind == ExprKind.Call {
        var ce = expr;
        var callee = genExpr(ctx, ce.callee, env);
        var args = "";
        var i = 0;
        loop {
            if i >= ce.args.length() {
                break;
            }
            if i > 0 { args = args + ", "; }
            args = args + genExpr(ctx, ce.args[i], env);
            i = i + 1;
        }
        return callee + "(" + args + ")";
    }
    if expr.kind == ExprKind.FieldAccess {
        var fae = expr;
        var obj = genExpr(ctx, fae.object, env);
        return obj + "." + fae.name;
    }
    if expr.kind == ExprKind.Index {
        var iexpr = expr;
        var target = genExpr(ctx, iexpr.target, env);
        var index = genExpr(ctx, iexpr.index, env);
        return target + "[" + index + "]";
    }
    if expr.kind == ExprKind.Lambda {
        return "lambda";
    }
    return "undef";
}

func genStmt(ctx, stmt, env): String {
    var code = "";
    
    if stmt.kind == StmtKind.VarDecl {
        var vds = stmt;
        var value = genExpr(ctx, vds.value, env);
        code = "%" + vds.name + " = alloca i64, align 8\n";
        code = code + "store i64 " + value + ", i64* %" + vds.name + "\n";
    }
    
    if stmt.kind == StmtKind.ConstDecl {
        var cds = stmt;
        var value = genExpr(ctx, cds.value, env);
        code = "%" + cds.name + " = alloca i64, align 8\n";
        code = code + "store i64 " + value + ", i64* %" + cds.name + "\n";
    }
    
    if stmt.kind == StmtKind.FuncDecl {
        var fds = stmt;
        ctx.currentFunc = fds.name;
        ctx.blockId = 0;
        
        var retTy = "i64";
        var params = "";
        var i = 0;
        loop {
            if i >= fds.params.length() {
                break;
            }
            if i > 0 { params = params + ", "; }
            params = params + "i64 %" + fds.params[i].name;
            i = i + 1;
        }
        
        code = "define " + retTy + " @" + fds.name + "(" + params + ") {\n";
        code = code + "entry:\n";
        
        i = 0;
        loop {
            if i >= fds.params.length() {
                break;
            }
            var pname = fds.params[i].name;
            code = code + "%" + pname + "_addr = alloca i64, align 8\n";
            code = code + "store i64 %" + pname + ", i64* %" + pname + "_addr\n";
            i = i + 1;
        }
        
        var j = 0;
        loop {
            if j >= fds.body.length() {
                break;
            }
            code = code + genStmt(ctx, fds.body[j], env);
            j = j + 1;
        }
        
        code = code + "ret i64 0\n";
        code = code + "}\n";
    }
    
    if stmt.kind == StmtKind.Return {
        var rs = stmt;
        var value = genExpr(ctx, rs.value, env);
        code = "ret i64 " + value + "\n";
    }
    
    if stmt.kind == StmtKind.ExprStmt {
        var es = stmt;
        code = genExpr(ctx, es.expr, env) + "\n";
    }
    
    return code;
}

func codegenProgram(ctx, program): String {
    var code = "; Module: " + ctx.moduleName + "\n";
    code = code + "target datalayout = \"e-m:e-i64:64-f80:128-n8:16:32:64-S128\"\n";
    code = code + "target triple = \"aarch64-apple-darwin\"\n\n";
    
    code = code + "define void @println(i8*) {\n";
    code = code + "  %call = call i32 (i8*, ...) @printf(i8* %0)\n";
    code = code + "  ret void\n";
    code = code + "}\n\n";
    
    code = code + "declare i32 @printf(i8*, ...)\n\n";
    
    var i = 0;
    loop {
        if i >= program.statements.length() {
            break;
        }
        code = code + genStmt(ctx, program.statements[i], envNew());
        i = i + 1;
    }
    
    return code;
}

export pub func generateIR(program): String {
    return codegenProgram2(program);
}

export pub func compileLLVM(ir: String, outputPath: String, release: bool) {
    var llPath = outputPath + ".ll";
    var objPath = outputPath + ".o";

    writeFile(llPath, ir);
    
    var opt = "-O2";
    if release { opt = "-O3"; }
    
    var llcCmd = "llc " + opt + " -filetype=obj \"" + llPath + "\" -o \"" + objPath + "\"";
    var llcResult = exec(llcCmd);
    if llcResult.isErr() {
        // fallback: clang can compile LLVM IR directly (useful when llc isn't installed)
        var clangObjCmd = "clang " + opt + " -c -x ir \"" + llPath + "\" -o \"" + objPath + "\"";
        var clangObjResult = exec(clangObjCmd);
        if clangObjResult.isErr() {
            return Result.Err(clangObjResult.unwrapOr(llcResult.unwrapOr("llc failed")));
        }
    }
    
    var clangCmd = "clang \"" + objPath + "\" -o \"" + outputPath + "\"";
    var clangResult = exec(clangCmd);
    if clangResult.isErr() {
        return Result.Err(clangResult.unwrapOr("clang failed"));
    }

    // best-effort cleanup
    deleteFile(llPath);
    deleteFile(objPath);
    
    return Result.Ok(outputPath);
}
