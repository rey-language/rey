// LLVM Codegen for Rey

import parser::ast::{ArrayExpr, AssignStmt, BinaryExpr, BlockStmt, BreakStmt, CallExpr, ConstDeclStmt, ContinueStmt, DictEntry, DictExpr, EnumDeclStmt, EnumVariantDecl, EnumVariantExpr, EnumVariantPattern, Expr, ExprStmt, FieldAccessExpr, ForStmt, FuncDeclStmt, FuncParam, IdentExpr, IfStmt, IndexExpr, LambdaExpr, Literal, LiteralExpr, LiteralKind, LiteralPattern, LoopStmt, MatchStmt, MatchStmtArm, Pattern, PatternField, PatternKind, Program, RangePattern, ReturnStmt, Stmt, StructDeclStmt, StructField, StructInitField, StructLiteralExpr, StructPattern, TupleExpr, TypeExpr, TypeExprKind, UnaryExpr, UpdateExpr, VarDeclStmt, VariablePattern, WhileStmt, WildcardPattern, exprSpan, stmtSpan};
import typecheck::{CheckedBindingInfo, CheckedExprInfo, CheckedFieldInitInfo, CheckedNominalField, CheckedNominalLayout, CheckedNominalVariant, CheckedProgram, ResolvedSymbol, SourceUnit, Type};

struct GenExprResult {
    pub ty: string,
    pub val: string,
    pub code: string,
}

struct CStringInfo {
    pub escaped: string,
    pub len: int,
}

struct LocalVar {
    pub ptr: string,
    pub ty: string,
    pub sourceType: string,
}

struct LoopInfo {
    pub breakLabel: string,
    pub continueLabel: string,
}

struct StructFieldDef {
    pub name: string,
    pub ty: string,
    pub sourceType: string,
}

struct StructDef {
    pub llvmName: string,
    pub sourceName: string,
    pub sourcePath: string,
    pub moduleId: string,
    pub declarationIndex: int,
    pub fields: Vec<StructFieldDef>,
}

struct EnumVariantDef {
    pub name: string,
    pub payloadTypes: Vec<string>,
}

struct EnumDef {
    pub identity: int,
    pub sourceName: string,
    pub declarationIndex: int,
    pub sourcePath: string,
    pub moduleId: string,
    pub variants: Vec<EnumVariantDef>,
}

struct GlobalVarDef {
    pub name: string,
    pub declaration: any,
    pub declarationKey: string,
    pub sourcePath: string,
    pub moduleId: string,
    pub llvmName: string,
    pub ty: string,
    pub sourceType: string,
    pub isConst: bool,
}

struct CodegenContext {
    pub moduleName: string,
    pub functions: Vec<string>,
    pub strings: Vec<string>,
    pub currentFunc: string,
    pub blockId: int,
    pub locals: HashMap<string, LocalVar>,
    pub currentRetTy: string,
    pub loopStack: Vec<LoopInfo>,
    pub structDefs: HashMap<string, StructDef>,
    pub enumDefs: HashMap<string, EnumDef>,
    pub funcSigs: HashMap<string, string>,
    pub funcSymbols: HashMap<string, string>,
    pub funcArities: HashMap<string, int>,
    pub funcSourceRetTypes: HashMap<string, string>,
    pub funcParamSourceTypes: HashMap<string, string>,
    pub structTags: HashMap<string, int>,
    pub nextStructTag: int,
    pub funcAllocas: string,
    pub codegenError: string,
    pub checkedProgram: CheckedProgram?,
    pub checkedExprIndex: HashMap<string, Vec<CheckedExprInfo>>,
    pub checkedFieldInitIndex: HashMap<string, Vec<CheckedFieldInitInfo>>,
    pub globalDefs: HashMap<string, GlobalVarDef>,
    pub globalDeclarations: string,
    pub moduleInitBodies: string,
    pub moduleInitCalls: string,
    pub inGlobalInitializer: bool,
    pub currentSourcePath: string,
    pub currentModuleId: string,
    pub methodStructKey: string,
    pub methodSelfPtr: string,
    pub methodSelfTy: string,
    pub lambdaBodies: string,
    pub lambdaSeq: int,
    pub closureEnvName: string,
    pub closureSlots: HashMap<string, int>,
    pub closureTypes: HashMap<string, string>,
}

func ctxNew(name: string): CodegenContext {
    return CodegenContext {
        moduleName: name,
        functions: [],
        strings: [],
        currentFunc: "",
        blockId: 0,
        locals: HashMap.new(),
        currentRetTy: "i32",
        loopStack: Vec.new(),
        structDefs: HashMap.new(),
        enumDefs: HashMap.new(),
        funcSigs: HashMap.new(),
        funcSymbols: HashMap.new(),
        funcArities: HashMap.new(),
        funcSourceRetTypes: HashMap.new(),
        funcParamSourceTypes: HashMap.new(),
        structTags: HashMap.new(),
        nextStructTag: 8,
        funcAllocas: "",
        codegenError: "",
        checkedProgram: null,
        checkedExprIndex: HashMap.new(),
        checkedFieldInitIndex: HashMap.new(),
        globalDefs: HashMap.new(),
        globalDeclarations: "",
        moduleInitBodies: "",
        moduleInitCalls: "",
        inGlobalInitializer: false,
        currentSourcePath: "",
        currentModuleId: "",
        methodStructKey: "",
        methodSelfPtr: "",
        methodSelfTy: "",
        lambdaBodies: "",
        lambdaSeq: 0,
        closureEnvName: "",
        closureSlots: HashMap.new(),
        closureTypes: HashMap.new()
    };
}

func cgEnumIdentity(ctx: CodegenContext, name: string): int {
    if !ctx.enumDefs.has(name) { return -1; }
    var def: EnumDef = ctx.enumDefs.get(name);
    return def.identity;
}

func cgEnumVariantIndex(ctx: CodegenContext, enumName: string, variantName: string): int {
    if !ctx.enumDefs.has(enumName) { return -1; }
    var def: EnumDef = ctx.enumDefs.get(enumName);
    var i = 0;
    loop {
        if i >= def.variants.len() { break; }
        if def.variants[i].name == variantName { return i; }
        i = i + 1;
    }
    return -1;
}

func cgIsDigitText(text: string): bool {
    if text.len() == 0 { return false; }
    var i = 0;
    loop {
        if i >= text.len() { break; }
        var c = text.slice(i, i + 1);
        if c != "0" && c != "1" && c != "2" && c != "3" && c != "4" && c != "5" && c != "6" && c != "7" && c != "8" && c != "9" { return false; }
        i = i + 1;
    }
    return true;
}

func cgTupleCount(text: string): int {
    if text.len() < 3 || text.slice(0, 1) != "T" { return -1; }
    var colon = text.indexOf(":");
    if colon <= 1 { return -1; }
    var countText = text.slice(1, colon);
    if !cgIsDigitText(countText) { return -1; }
    return countText.toInt();
}

func cgTupleIndex(name: string): int {
    if !cgIsDigitText(name) { return -1; }
    return name.toInt();
}

func cgTupleElementAt(text: string, index: int): string {
    var count = cgTupleCount(text);
    if count < 0 || index < 0 || index >= count { return ""; }
    var colon = text.indexOf(":");
    var rest = text.slice(colon + 1, text.len());
    var i = 0;
    loop {
        if i >= count { break; }
        var lenColon = rest.indexOf(":");
        if lenColon <= 0 { return ""; }
        var lenText = rest.slice(0, lenColon);
        if !cgIsDigitText(lenText) { return ""; }
        var len = lenText.toInt();
        var start = lenColon + 1;
        var end = start + len;
        if end > rest.len() { return ""; }
        if i == index { return rest.slice(start, end); }
        rest = rest.slice(end, rest.len());
        i = i + 1;
    }
    return "";
}

func cgFormatTupleType(elements: Vec<string>): string {
    var body = "";
    var i = 0;
    loop {
        if i >= elements.len() { break; }
        var element = elements[i];
        body = body + element.len().toString() + ":" + element;
        i = i + 1;
    }
    return "T" + elements.len().toString() + ":" + body;
}

func cgEnumPayloadKind(ctx: CodegenContext, sourceType: string): int {
    if sourceType == "int" { return 1; }
    if sourceType == "bool" { return 2; }
    if sourceType == "float" { return 3; }
    if sourceType == "string" { return 4; }
    if sourceType == "char" { return 5; }
    if sourceType == "null" { return 6; }
    if ctx.structDefs.has(sourceType) { return 7; }
    if sourceType.startsWith("Vec<") && sourceType.endsWith(">") { return 8; }
    if sourceType.startsWith("HashMap<") && sourceType.endsWith(">") { return 9; }
    if ctx.enumDefs.has(sourceType) { return 10; }
    if sourceType.startsWith("Option<") && sourceType.endsWith(">") { return 11; }
    if sourceType.startsWith("Result<") && sourceType.endsWith(">") { return 12; }
    if cgTupleCount(sourceType) >= 0 { return 13; }
    cgSetError(ctx, "enum payload type has no supported runtime representation: " + sourceType);
    return -1;
}

func cgValueKind(ctx: CodegenContext, sourceType: string): int {
    if sourceType == "int" { return 4097; }
    if sourceType == "bool" { return 4098; }
    if sourceType == "float" { return 4099; }
    if sourceType == "string" { return 4100; }
    if sourceType == "char" { return 4101; }
    if sourceType == "null" { return 4102; }
    if ctx.structDefs.has(sourceType) { return 4103; }
    if ctx.enumDefs.has(sourceType) { return 4104; }
    if sourceType.startsWith("Vec<") && sourceType.endsWith(">") { return 4105; }
    if sourceType.startsWith("HashMap<") && sourceType.endsWith(">") { return 4106; }
    if cgTupleCount(sourceType) >= 0 { return 4107; }
    if sourceType.startsWith("Option<") && sourceType.endsWith(">") { return 4108; }
    if sourceType.startsWith("Result<") && sourceType.endsWith(">") { return 4109; }
    cgSetError(ctx, "tuple element type has no supported runtime representation: " + sourceType);
    return -1;
}

func cgFreshLocalPtr(ctx: CodegenContext, name: string): string {
    var ptr = "%" + name + "." + ctx.blockId.toString() + ".addr";
    ctx.blockId = ctx.blockId + 1;
    return ptr;
}

func cgCopyLocals(source: HashMap<string, LocalVar>): HashMap<string, LocalVar> {
    var result: HashMap<string, LocalVar> = HashMap.new();
    var keys = source.keys();
    var i = 0;
    loop {
        if i >= keys.len() { break; }
        var name = keys[i];
        result.set(name, source.get(name));
        i = i + 1;
    }
    return result;
}

func cgEnumPayloadValue(ctx: CodegenContext, enumValue: string, enumDef: EnumDef, variantIndex: int, payloadIndex: int): GenExprResult {
    var payloadType = enumDef.variants[variantIndex].payloadTypes[payloadIndex];
    var payloadKind = cgEnumPayloadKind(ctx, payloadType);
    if payloadKind < 0 { return cgErrorExpr(ctx, "unsupported enum payload representation: " + payloadType); }
    var raw = nextTemp(ctx);
    var code = raw + " = call i64 @rey_enum_get(i64 " + enumValue + ", i64 " + enumDef.identity.toString() + ", i64 " + variantIndex.toString() + ", i64 " + payloadIndex.toString() + ", i64 " + payloadKind.toString() + ")\n";
    if payloadType == "float" {
        var floatValue = nextTemp(ctx);
        return GenExprResult { ty: "double", val: floatValue, code: code + floatValue + " = bitcast i64 " + raw + " to double\n" };
    }
    if payloadType == "string" || payloadType == "char" {
        var stringValue = nextTemp(ctx);
        return GenExprResult { ty: "i8*", val: stringValue, code: code + stringValue + " = inttoptr i64 " + raw + " to i8*\n" };
    }
    if ctx.structDefs.has(payloadType) {
        var structDef: StructDef = ctx.structDefs.get(payloadType);
        var structValue = nextTemp(ctx);
        return GenExprResult { ty: structDef.llvmName + "*", val: structValue, code: code + structValue + " = inttoptr i64 " + raw + " to " + structDef.llvmName + "*\n" };
    }
    return GenExprResult { ty: "i64", val: raw, code: code };
}

func cgTaggedPayloadRaw(ctx: CodegenContext, expr: Expr, value: GenExprResult): GenExprResult {
    var sourceType = cgSourceType(ctx, expr);
    if cgEnumPayloadKind(ctx, sourceType) < 0 { return cgErrorExpr(ctx, "tagged value payload type is unsupported: " + sourceType); }
    var code = value.code;
    var raw = value.val;
    if sourceType == "float" {
        if value.ty != "double" { return cgErrorExpr(ctx, "float tagged payload has unsupported LLVM representation"); }
        var bits = nextTemp(ctx);
        code = code + bits + " = bitcast double " + value.val + " to i64\n";
        raw = bits;
    } else if sourceType == "string" || sourceType == "char" || ctx.structDefs.has(sourceType) {
        if value.ty.endsWith("*") {
            var bits2 = nextTemp(ctx);
            code = code + bits2 + " = ptrtoint " + value.ty + " " + value.val + " to i64\n";
            raw = bits2;
        } else if value.ty != "i64" {
            return cgErrorExpr(ctx, "reference tagged payload has unsupported LLVM representation");
        }
    } else if value.ty == "i1" {
        var bits3 = nextTemp(ctx);
        code = code + bits3 + " = zext i1 " + value.val + " to i64\n";
        raw = bits3;
    } else if value.ty != "i64" {
        return cgErrorExpr(ctx, "tagged payload has unsupported LLVM representation: " + sourceType);
    }
    return GenExprResult { ty: "i64", val: raw, code: code };
}

func cgEnumArgumentTypeCompatible(expr: Expr, actualType: string, expectedType: string): bool {
    if actualType == expectedType { return true; }
    var enumVariant: EnumVariantExpr? = null;
    match expr {
        Expr::EnumVariant(payload) => { enumVariant = payload; },
        Expr::Error(_) => {},
        Expr::Literal(_) => {},
        Expr::Identifier(_) => {},
        Expr::Binary(_) => {},
        Expr::Unary(_) => {},
        Expr::Update(_) => {},
        Expr::Call(_) => {},
        Expr::Index(_) => {},
        Expr::FieldAccess(_) => {},
        Expr::Lambda(_) => {},
        Expr::Match(_) => {},
        Expr::If(_) => {},
        Expr::Tuple(_) => {},
        Expr::Array(_) => {},
        Expr::Dict(_) => {},
        Expr::StructLiteral(_) => {},
    }
    if enumVariant != null {
        var variantExpr: EnumVariantExpr = enumVariant;
        if variantExpr.enumName == "Option" && variantExpr.variant == "None" && actualType.startsWith("Option<") && expectedType.startsWith("Option<") {
            return actualType == "Option<any>";
        }
        if variantExpr.enumName == "Result" && (variantExpr.variant == "Ok" || variantExpr.variant == "Err") && actualType.startsWith("Result<") && expectedType.startsWith("Result<") {
            var actualInner = actualType.slice(7, actualType.len() - 1);
            var expectedInner = expectedType.slice(7, expectedType.len() - 1);
            var actualComma = actualInner.indexOf(",");
            var expectedComma = expectedInner.indexOf(",");
            if actualComma >= 0 && expectedComma >= 0 {
                var actualOk = actualInner.slice(0, actualComma);
                var actualErr = actualInner.slice(actualComma + 1, actualInner.len());
                var expectedOk = expectedInner.slice(0, expectedComma);
                var expectedErr = expectedInner.slice(expectedComma + 1, expectedInner.len());
                if variantExpr.variant == "Ok" && actualOk == expectedOk && actualErr == "any" { return true; }
                if variantExpr.variant == "Err" && actualErr == expectedErr && actualOk == "any" { return true; }
            }
        }
    }
    return false;
}

func cgPatternLiteralTest(ctx: CodegenContext, literal: Literal, sourceType: string, value: GenExprResult): GenExprResult {
    var code = value.code;
    var condition = nextTemp(ctx);
    if literal.kind == LiteralKind::Int && sourceType == "int" && value.ty == "i64" {
        code = code + condition + " = icmp eq i64 " + value.val + ", " + literal.text + "\n";
    } else if literal.kind == LiteralKind::Bool && sourceType == "bool" {
        var boolValue = value.val;
        if value.ty == "i1" {
            var extended = nextTemp(ctx);
            code = code + extended + " = zext i1 " + value.val + " to i64\n";
            boolValue = extended;
        } else if value.ty != "i64" { return cgErrorExpr(ctx, "bool match value has unsupported LLVM representation"); }
        var expected = "0";
        if literal.text == "true" { expected = "1"; }
        code = code + condition + " = icmp eq i64 " + boolValue + ", " + expected + "\n";
    } else if literal.kind == LiteralKind::Float && sourceType == "float" && value.ty == "double" {
        code = code + condition + " = fcmp oeq double " + value.val + ", " + literal.text + "\n";
    } else if (literal.kind == LiteralKind::String && sourceType == "string") || (literal.kind == LiteralKind::Char && sourceType == "char") {
        var index = cgInternString(ctx, literal.text);
        var info: CStringInfo = llvmCStringInfo(literal.text);
        var patternString = nextTemp(ctx);
        code = code + patternString + " = call i8* @rey_str_new(i8* " + llvmStrPtr(index, info.len) + ", i64 " + (info.len - 1).toString() + ")\n";
        var valueString = value.val;
        if value.ty == "i64" {
            var cast = nextTemp(ctx);
            code = code + cast + " = inttoptr i64 " + value.val + " to i8*\n";
            valueString = cast;
        } else if value.ty != "i8*" { return cgErrorExpr(ctx, "string match value has unsupported LLVM representation"); }
        var equal = nextTemp(ctx);
        code = code + equal + " = call i64 @rey_str_eq(i8* " + valueString + ", i8* " + patternString + ")\n";
        code = code + condition + " = icmp ne i64 " + equal + ", 0\n";
    } else if literal.kind == LiteralKind::Null && sourceType == "null" && value.ty == "i64" {
        code = code + condition + " = icmp eq i64 " + value.val + ", 0\n";
    } else {
        return cgErrorExpr(ctx, "literal match has unsupported checked type or LLVM representation: " + sourceType);
    }
    return GenExprResult { ty: "i1", val: condition, code: code };
}

func cgEmitPatternTest(ctx: CodegenContext, pattern: Pattern, sourceType: string, value: GenExprResult, successLabel: string, failLabel: string): string {
    match pattern {
        Pattern::Error(_) => {
            cgSetError(ctx, "error patterns cannot be lowered");
            return "br label %" + failLabel + "\n";
        },
        Pattern::Wildcard(_) => { return value.code + "br label %" + successLabel + "\n"; },
        Pattern::Variable(variable) => {
            var variantIndex = cgEnumVariantIndex(ctx, sourceType, variable.name);
            if variantIndex >= 0 {
                var enumDef: EnumDef = ctx.enumDefs.get(sourceType);
                var matched = nextTemp(ctx);
                var condition = nextTemp(ctx);
                var code = value.code + matched + " = call i64 @rey_enum_is(i64 " + value.val + ", i64 " + enumDef.identity.toString() + ", i64 " + variantIndex.toString() + ")\n";
                code = code + condition + " = icmp ne i64 " + matched + ", 0\n";
                return code + "br i1 " + condition + ", label %" + successLabel + ", label %" + failLabel + "\n";
            }
            return value.code + "br label %" + successLabel + "\n";
        },
        Pattern::Literal(literalPattern) => {
            var tested = cgPatternLiteralTest(ctx, literalPattern.literal, sourceType, value);
            return tested.code + "br i1 " + tested.val + ", label %" + successLabel + ", label %" + failLabel + "\n";
        },
        Pattern::Range(rangePattern) => {
            if sourceType != "int" || value.ty != "i64" {
                cgSetError(ctx, "range match lowering requires a known int representation");
                return value.code + "br label %" + failLabel + "\n";
            }
            if rangePattern.start.kind != LiteralKind::Int || rangePattern.end.kind != LiteralKind::Int {
                cgSetError(ctx, "range match endpoints must be integer literals");
                return value.code + "br label %" + failLabel + "\n";
            }
            var lower = nextTemp(ctx);
            var upper = nextTemp(ctx);
            var both = nextTemp(ctx);
            var upperPredicate = "sle";
            if !rangePattern.inclusive { upperPredicate = "slt"; }
            var rangeCode = value.code + lower + " = icmp sge i64 " + value.val + ", " + rangePattern.start.text + "\n";
            rangeCode = rangeCode + upper + " = icmp " + upperPredicate + " i64 " + value.val + ", " + rangePattern.end.text + "\n";
            rangeCode = rangeCode + both + " = and i1 " + lower + ", " + upper + "\n";
            return rangeCode + "br i1 " + both + ", label %" + successLabel + ", label %" + failLabel + "\n";
        },
        Pattern::EnumVariant(enumPattern) => {
            var enumKey = cgEnumLayoutKey(ctx, sourceType, enumPattern.enumName);
            if enumKey == "" || value.ty != "i64" {
                var patternLabel = enumPattern.enumName;
                if patternLabel == "" { patternLabel = sourceType; }
                cgSetError(ctx, "enum pattern does not match the checked scrutinee layout: " + patternLabel);
                return value.code + "br label %" + failLabel + "\n";
            }
            var enumDef: EnumDef = ctx.enumDefs.get(enumKey);
            var enumName = enumDef.sourceName;
            var variantIndex = cgEnumVariantIndex(ctx, enumKey, enumPattern.variant);
            if variantIndex < 0 {
                cgSetError(ctx, "unknown enum pattern variant: " + enumName + "::" + enumPattern.variant);
                return value.code + "br label %" + failLabel + "\n";
            }
            var variantDef: EnumVariantDef = enumDef.variants[variantIndex];
            if enumPattern.payloads.len() != 0 && enumPattern.payloads.len() != variantDef.payloadTypes.len() {
                cgSetError(ctx, "enum pattern payload count/layout mismatch: " + enumName + "::" + enumPattern.variant);
                return value.code + "br label %" + failLabel + "\n";
            }
            var isVariant = nextTemp(ctx);
            var condition = nextTemp(ctx);
            var code = value.code + isVariant + " = call i64 @rey_enum_is(i64 " + value.val + ", i64 " + enumDef.identity.toString() + ", i64 " + variantIndex.toString() + ")\n";
            code = code + condition + " = icmp ne i64 " + isVariant + ", 0\n";
            if enumPattern.payloads.len() == 0 {
                return code + "br i1 " + condition + ", label %" + successLabel + ", label %" + failLabel + "\n";
            }
            var payloadStart = nextLabel(ctx, "enum.payload");
            code = code + "br i1 " + condition + ", label %" + payloadStart + ", label %" + failLabel + "\n";
            var payloadIndex = 0;
            var currentLabel = payloadStart;
            loop {
                if payloadIndex >= enumPattern.payloads.len() { break; }
                code = code + currentLabel + ":\n";
                var payloadValue = cgEnumPayloadValue(ctx, value.val, enumDef, variantIndex, payloadIndex);
                var nextPayloadLabel = successLabel;
                if payloadIndex + 1 < enumPattern.payloads.len() { nextPayloadLabel = nextLabel(ctx, "enum.payload"); }
                code = code + cgEmitPatternTest(ctx, enumPattern.payloads[payloadIndex], variantDef.payloadTypes[payloadIndex], payloadValue, nextPayloadLabel, failLabel);
                currentLabel = nextPayloadLabel;
                payloadIndex = payloadIndex + 1;
            }
            return code;
        },
        Pattern::Struct(structPattern) => {
            return cgPatternEmitStruct(ctx, structPattern, sourceType, value, successLabel, failLabel);
        },
        Pattern::Or(_) => {
            cgSetError(ctx, "or-patterns are not implemented in native codegen");
            return value.code + "br label %" + failLabel + "\n";
        },
    }
}

func cgBindPatternLocal(ctx: CodegenContext, name: string, sourceType: string, value: GenExprResult): string {
    var llvmTy = llvmTypeFromTagCtx(ctx, sourceType);
    var ptr = nextTemp(ctx) + ".addr";
    ctx.funcAllocas = ctx.funcAllocas + ptr + " = alloca " + llvmTy + ", align 8\n";
    var code = value.code;
    var storeValue = value.val;
    if llvmTy == "i64" && value.ty == "i1" {
        var extended = nextTemp(ctx);
        code = code + extended + " = zext i1 " + value.val + " to i64\n";
        storeValue = extended;
    } else if llvmTy == "i64" && value.ty.endsWith("*") {
        var pointerBits = nextTemp(ctx);
        code = code + pointerBits + " = ptrtoint " + value.ty + " " + value.val + " to i64\n";
        storeValue = pointerBits;
    } else if llvmTy.endsWith("*") && value.ty == "i64" {
        var cast = nextTemp(ctx);
        code = code + cast + " = inttoptr i64 " + value.val + " to " + llvmTy + "\n";
        storeValue = cast;
    } else if llvmTy != value.ty {
        cgSetError(ctx, "match binding has unsupported checked type/layout: " + name);
        return code;
    }
    code = code + "store " + llvmTy + " " + storeValue + ", " + llvmTy + "* " + ptr + "\n";
    ctx.locals.set(name, LocalVar { ptr: ptr, ty: llvmTy, sourceType: sourceType });
    return code;
}

func cgEmitPatternBindings(ctx: CodegenContext, pattern: Pattern, sourceType: string, value: GenExprResult): string {
    match pattern {
        Pattern::Variable(variable) => {
            if cgEnumVariantIndex(ctx, sourceType, variable.name) >= 0 { return ""; }
            return cgBindPatternLocal(ctx, variable.name, sourceType, value);
        },
        Pattern::EnumVariant(enumPattern) => {
            if enumPattern.payloads.len() == 0 { return ""; }
            var enumKey = cgEnumLayoutKey(ctx, sourceType, enumPattern.enumName);
            if enumKey == "" { return ""; }
            var enumDef: EnumDef = ctx.enumDefs.get(enumKey);
            var variantIndex = cgEnumVariantIndex(ctx, enumKey, enumPattern.variant);
            if variantIndex < 0 || variantIndex >= enumDef.variants.len() { return ""; }
            var variantDef: EnumVariantDef = enumDef.variants[variantIndex];
            var code = "";
            var i = 0;
            loop {
                if i >= enumPattern.payloads.len() { break; }
                var payloadValue = cgEnumPayloadValue(ctx, value.val, enumDef, variantIndex, i);
                code = code + cgEmitPatternBindings(ctx, enumPattern.payloads[i], variantDef.payloadTypes[i], payloadValue);
                i = i + 1;
            }
            return code;
        },
        Pattern::Wildcard(_) => { return ""; },
        Pattern::Literal(_) => { return ""; },
        Pattern::Range(_) => { return ""; },
        Pattern::Error(_) => { return ""; },
        Pattern::Struct(structPattern) => { return cgPatternEmitStructBindings(ctx, structPattern, sourceType, value); },
        Pattern::Or(_) => { return ""; },
    }
}

func cgStatementTerminates(stmt: Stmt): bool {
    match stmt {
        Stmt::Return(_) => { return true; },
        Stmt::Break(_) => { return true; },
        Stmt::Continue(_) => { return true; },
        Stmt::Block(block) => { return stmtListEndsWithTerminator(block.statements); },
        Stmt::If(_) => { return false; },
        Stmt::Match(matchStmt) => {
            if matchStmt.arms.len() == 0 { return false; }
            var i = 0;
            loop {
                if i >= matchStmt.arms.len() { break; }
                if !cgStatementTerminates(matchStmt.arms[i].body) { return false; }
                i = i + 1;
            }
            return true;
        },
        Stmt::ExprStmt(exprStmt) => { return stmtIsTerminator(stmt); },
        Stmt::VarDecl(_) => { return false; },
        Stmt::ConstDecl(_) => { return false; },
        Stmt::FuncDecl(_) => { return false; },
        Stmt::StructDecl(_) => { return false; },
        Stmt::EnumDecl(_) => { return false; },
        Stmt::Import(_) => { return false; },
        Stmt::Assign(_) => { return false; },
        Stmt::While(_) => { return false; },
        Stmt::For(_) => { return false; },
        Stmt::Loop(_) => { return false; },
    }
}

func genMatchStmt(ctx: CodegenContext, stmt: MatchStmt): string {
    var sourceType = cgSourceType(ctx, stmt.scrutinee);
    if sourceType == "" || sourceType == "any" || sourceType == "unsupported" {
        cgSetError(ctx, "match scrutinee has no supported checked codegen type");
        return "";
    }
    var scrutinee: GenExprResult = genExprValue(ctx, stmt.scrutinee);
    if sourceType != "int" && sourceType != "bool" && sourceType != "float" && sourceType != "string" && sourceType != "char" && sourceType != "null" && !ctx.enumDefs.has(sourceType) && !ctx.structDefs.has(sourceType) {
        cgSetError(ctx, "match scrutinee representation is not implemented: " + sourceType);
        return scrutinee.code;
    }
    var baseLocals = cgCopyLocals(ctx.locals);
    var matchValue = GenExprResult { ty: scrutinee.ty, val: scrutinee.val, code: "" };
    var endLabel = nextLabel(ctx, "match.end");
    var failLabel = nextLabel(ctx, "match.fail");
    var code = scrutinee.code;
    if stmt.arms.len() == 0 {
        cgSetError(ctx, "empty match has no native codegen representation");
        return code;
    }
    var firstTestLabel = nextLabel(ctx, "match.test");
    code = code + "br label %" + firstTestLabel + "\n";
    var armIndex = 0;
    var testLabel = firstTestLabel;
    loop {
        if armIndex >= stmt.arms.len() { break; }
        var arm: MatchStmtArm = stmt.arms[armIndex];
        var bodyLabel = nextLabel(ctx, "match.body");
        var nextTestLabel = failLabel;
        if armIndex + 1 < stmt.arms.len() { nextTestLabel = nextLabel(ctx, "match.test"); }
        code = code + testLabel + ":\n";
        code = code + cgEmitPatternTest(ctx, arm.pattern, sourceType, matchValue, bodyLabel, nextTestLabel);
        code = code + bodyLabel + ":\n";
        ctx.locals = cgCopyLocals(baseLocals);
        code = code + cgEmitPatternBindings(ctx, arm.pattern, sourceType, matchValue);
        code = code + genStmt2(ctx, arm.body);
        if !cgStatementTerminates(arm.body) { code = code + "br label %" + endLabel + "\n"; }
        ctx.locals = cgCopyLocals(baseLocals);
        testLabel = nextTestLabel;
        armIndex = armIndex + 1;
    }
    code = code + failLabel + ":\nunreachable\n";
    code = code + endLabel + ":\n";
    ctx.locals = baseLocals;
    return code;
}

func cgSetError(ctx: CodegenContext, message: string) {
    if ctx.codegenError == "" {
        if ctx.checkedProgram != null {
            ctx.codegenError = ctx.currentSourcePath + ": " + message;
        } else {
            ctx.codegenError = message;
        }
    }
}

func cgErrorExpr(ctx: CodegenContext, message: string): GenExprResult {
    cgSetError(ctx, message);
    return GenExprResult { ty: "i64", val: "0", code: "" };
}

func cgErrorExprAt(ctx: CodegenContext, expr: Expr, message: string): GenExprResult {
    if ctx.checkedProgram != null {
        var info = cgFindExprInfo(ctx, expr);
        if info != null {
            cgSetError(ctx, "node " + info.nodeId.toString() + ": " + message);
            return GenExprResult { ty: "i64", val: "0", code: "" };
        }
    }
    return cgErrorExpr(ctx, message);
}

func cgExprNodeKey(expr: Expr): string {
    var span = exprSpan(expr);
    var variant = "Unknown";
    match expr {
        Expr::Error(_) => { variant = "Error"; },
        Expr::Literal(_) => { variant = "Literal"; },
        Expr::Identifier(_) => { variant = "Identifier"; },
        Expr::Binary(_) => { variant = "Binary"; },
        Expr::Unary(_) => { variant = "Unary"; },
        Expr::Update(_) => { variant = "Update"; },
        Expr::Call(_) => { variant = "Call"; },
        Expr::EnumVariant(_) => { variant = "EnumVariant"; },
        Expr::Index(_) => { variant = "Index"; },
        Expr::FieldAccess(_) => { variant = "FieldAccess"; },
        Expr::Lambda(_) => { variant = "Lambda"; },
        Expr::Match(_) => { variant = "Match"; },
        Expr::If(_) => { variant = "If"; },
        Expr::Tuple(_) => { variant = "Tuple"; },
        Expr::Array(_) => { variant = "Array"; },
        Expr::Dict(_) => { variant = "Dict"; },
        Expr::StructLiteral(_) => { variant = "StructLiteral"; },
    }
    return variant + ":" + span.start.toString() + ":" + span.end.toString();
}

func cgMetadataKey(sourcePath: string, moduleId: string, identity: string): string {
    return sourcePath.len().toString() + ":" + sourcePath + moduleId.len().toString() + ":" + moduleId + identity.len().toString() + ":" + identity;
}

func cgGlobalKey(sourcePath: string, moduleId: string, name: string): string {
    return cgMetadataKey(sourcePath, moduleId, name);
}

func cgUnitIndex(checkedProgram: CheckedProgram, sourcePath: string, moduleId: string): int {
    var i = 0;
    loop {
        if i >= checkedProgram.units.len() { break; }
        if checkedProgram.units[i].sourcePath == sourcePath && checkedProgram.units[i].moduleId == moduleId { return i; }
        i = i + 1;
    }
    return -1;
}

func cgBuildGlobalDefs(ctx: CodegenContext) {
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
        var checkedProgram: CheckedProgram = maybeProgram;
        var i = 0;
        loop {
            if i >= checkedProgram.bindings.len() { break; }
            var binding: CheckedBindingInfo = checkedProgram.bindings[i];
            if binding.kind == "Global" {
                var unitIndex = cgUnitIndex(checkedProgram, binding.sourcePath, binding.moduleId);
                if unitIndex < 0 {
                    cgSetError(ctx, "checked global has no owning source unit: " + binding.name);
                } else {
                    var key = cgGlobalKey(binding.sourcePath, binding.moduleId, binding.name);
                    if ctx.globalDefs.has(key) {
                        cgSetError(ctx, "duplicate checked global slot: " + binding.moduleId + "::" + binding.name);
                    } else {
                        var llvmName = "@__rey_g" + unitIndex.toString() + "_" + binding.name;
                        var llvmType = cgCheckedLLVMType(ctx, binding.ty);
                        var sourceType = cgCheckedTypeName(ctx, binding.ty);
                        ctx.globalDefs.set(key, GlobalVarDef {
                            name: binding.name,
                            declaration: binding.declaration,
                            declarationKey: binding.declarationKey,
                            sourcePath: binding.sourcePath,
                            moduleId: binding.moduleId,
                            llvmName: llvmName,
                            ty: llvmType,
                            sourceType: sourceType,
                            isConst: binding.isConst,
                        });
                        ctx.globalDeclarations = ctx.globalDeclarations + llvmName + " = global " + llvmType + " zeroinitializer, align 8\n";
                    }
                }
            }
            i = i + 1;
        }
        if ctx.globalDeclarations != "" { ctx.globalDeclarations = ctx.globalDeclarations + "\n"; }
    }
}

func cgCurrentGlobal(ctx: CodegenContext, name: string): GlobalVarDef? {
    var key = cgGlobalKey(ctx.currentSourcePath, ctx.currentModuleId, name);
    if ctx.globalDefs.has(key) { return ctx.globalDefs.get(key); }
    return null;
}

func cgIsGlobalDeclaration(ctx: CodegenContext, stmt: Stmt, name: string): bool {
    var maybeGlobal = cgCurrentGlobal(ctx, name);
    if maybeGlobal != null {
        var global: GlobalVarDef = maybeGlobal;
        return global.declarationKey == cgCallStmtKey(stmt);
    }
    return false;
}

func cgEmitGlobalStore(ctx: CodegenContext, name: string, sourceType: string, value: GenExprResult): string {
    var maybeGlobal = cgCurrentGlobal(ctx, name);
    if maybeGlobal != null {
        var global: GlobalVarDef = maybeGlobal;
        return cgEmitGlobalStoreResolved(ctx, global, name, sourceType, value);
    }
    cgSetError(ctx, "checked top-level binding has no defining global slot: " + ctx.currentModuleId + "::" + name);
    return value.code;
}

func cgEmitGlobalStoreResolved(ctx: CodegenContext, global: GlobalVarDef, name: string, sourceType: string, value: GenExprResult): string {
    var code = value.code;
    var storedValue = value.val;
    if global.ty == "i64" && value.ty == "i1" {
        var extended = nextTemp(ctx);
        code = code + extended + " = zext i1 " + value.val + " to i64\n";
        storedValue = extended;
    } else if global.ty == "i64" && value.ty.endsWith("*") {
        var pointerBits = nextTemp(ctx);
        code = code + pointerBits + " = ptrtoint " + value.ty + " " + value.val + " to i64\n";
        storedValue = pointerBits;
    } else if global.ty.endsWith("*") && value.ty == "i64" {
        var pointerValue = nextTemp(ctx);
        code = code + pointerValue + " = inttoptr i64 " + value.val + " to " + global.ty + "\n";
        storedValue = pointerValue;
    } else if global.ty == "double" && value.ty == "i64" && sourceType == "int" {
        var floatValue = nextTemp(ctx);
        code = code + floatValue + " = sitofp i64 " + value.val + " to double\n";
        storedValue = floatValue;
    } else if global.ty != value.ty {
        cgSetError(ctx, "top-level initializer representation mismatch: " + ctx.currentModuleId + "::" + name);
        return code;
    }
    return code + "store " + global.ty + " " + storedValue + ", " + global.ty + "* " + global.llvmName + "\n";
}

func cgEmitGlobalAssignment(ctx: CodegenContext, global: GlobalVarDef, name: string, op: string, sourceType: string, value: GenExprResult): string {
    var code = value.code;
    if op != "=" {
        if global.ty != "i64" || global.sourceType != "int" || value.ty != "i64" {
            cgSetError(ctx, "compound global assignment requires int operands: " + name);
            return code;
        }
        var current = nextTemp(ctx);
        code = code + current + " = load i64, i64* " + global.llvmName + "\n";
        var arithmeticOp = "+";
        if op == "-=" { arithmeticOp = "-"; }
        if op == "*=" { arithmeticOp = "*"; }
        if op == "/=" { arithmeticOp = "/"; }
        if op == "%=" { arithmeticOp = "%"; }
        if arithmeticOp == "/" || arithmeticOp == "%" {
            var quotient: GenExprResult = cgCheckedDivRem(ctx, arithmeticOp, current, value.val);
            return code + quotient.code + "store i64 " + quotient.val + ", i64* " + global.llvmName + "\n";
        }
        var updated: GenExprResult = cgCheckedIntBin(ctx, arithmeticOp, current, value.val);
        return code + updated.code + "store i64 " + updated.val + ", i64* " + global.llvmName + "\n";
    }
    var storedValue = value.val;
    var storedTy = value.ty;
    if global.sourceType == "any" && sourceType != "any" && sourceType != "" {
        var boxedGlobal = cgBoxAny(ctx, sourceType, GenExprResult { ty: value.ty, val: value.val, code: "" });
        code = code + boxedGlobal.code;
        storedValue = boxedGlobal.val;
        storedTy = boxedGlobal.ty;
    }
    if global.ty == "i64" && storedTy == "i1" {
        var extended = nextTemp(ctx);
        code = code + extended + " = zext i1 " + storedValue + " to i64\n";
        storedValue = extended;
    } else if global.ty == "i64" && storedTy.endsWith("*") {
        var pointerBits = nextTemp(ctx);
        code = code + pointerBits + " = ptrtoint " + storedTy + " " + storedValue + " to i64\n";
        storedValue = pointerBits;
    } else if global.ty.endsWith("*") && storedTy == "i64" {
        var pointerValue = nextTemp(ctx);
        code = code + pointerValue + " = inttoptr i64 " + storedValue + " to " + global.ty + "\n";
        storedValue = pointerValue;
    } else if global.ty == "double" && storedTy == "i64" && sourceType == "int" {
        var floatValue = nextTemp(ctx);
        code = code + floatValue + " = sitofp i64 " + storedValue + " to double\n";
        storedValue = floatValue;
    } else if global.ty != storedTy {
        cgSetError(ctx, "global assignment representation mismatch: " + name);
        return code;
    }
    return code + "store " + global.ty + " " + storedValue + ", " + global.ty + "* " + global.llvmName + "\n";
}

func cgEmitIndexAssignment(ctx: CodegenContext, target: IndexExpr, op: string, valueExpr: Expr): string {
    var collectionType = cgSourceType(ctx, target.target);
    var kind = cgCollectionKind(collectionType);
    if kind != "Vec" && kind != "HashMap" {
        cgSetError(ctx, "unsupported assignment target");
        return "";
    }
    var elementType = "";
    if kind == "Vec" { elementType = cgVecElementType(collectionType); }
    if kind == "HashMap" { elementType = cgHashMapValueType(collectionType); }
    var receiver: GenExprResult = genExprValue(ctx, target.target);
    var indexValue: GenExprResult = genExprValue(ctx, target.index);
    var rhs: GenExprResult = genExprValue(ctx, valueExpr);
    var code = receiver.code + indexValue.code + rhs.code;
    if receiver.ty != "i64" {
        cgSetError(ctx, "indexed assignment receiver has no collection handle");
        return code;
    }
    var key = indexValue.val;
    if kind == "HashMap" {
        if cgSourceType(ctx, target.index) != "string" {
            cgSetError(ctx, "HashMap assignment key requires string");
            return code;
        }
        if indexValue.ty == "i64" {
            var keyCast = nextTemp(ctx);
            code = code + keyCast + " = inttoptr i64 " + indexValue.val + " to i8*\n";
            key = keyCast;
        } else if indexValue.ty != "i8*" {
            cgSetError(ctx, "HashMap assignment key requires string");
            return code;
        }
    } else if cgSourceType(ctx, target.index) != "int" || indexValue.ty != "i64" {
        cgSetError(ctx, "Vec assignment index requires int");
        return code;
    }
    if op != "=" && (elementType == "float" || rhs.ty == "double") {
        var currentFloat = nextTemp(ctx);
        if kind == "Vec" {
            code = code + currentFloat + " = call double @rey_vec_get_float(i64 " + receiver.val + ", i64 " + indexValue.val + ")\n";
        } else {
            code = code + currentFloat + " = call double @rey_hm_get_float(i64 " + receiver.val + ", i8* " + key + ")\n";
        }
        var rhsFloat = rhs.val;
        if rhs.ty != "double" {
            var widenedFloat = nextTemp(ctx);
            code = code + widenedFloat + " = sitofp i64 " + rhs.val + " to double\n";
            rhsFloat = widenedFloat;
        }
        var floatOp = "fadd";
        if op == "-=" { floatOp = "fsub"; }
        if op == "*=" { floatOp = "fmul"; }
        if op == "/=" { floatOp = "fdiv"; }
        if op == "%=" { floatOp = "frem"; }
        var updatedFloat = nextTemp(ctx);
        code = code + updatedFloat + " = " + floatOp + " double " + currentFloat + ", " + rhsFloat + "\n";
        if kind == "Vec" {
            code = code + "call void @rey_vec_set_float(i64 " + receiver.val + ", i64 " + indexValue.val + ", double " + updatedFloat + ")\n";
        } else {
            code = code + "call void @rey_hm_set_float(i64 " + receiver.val + ", i8* " + key + ", double " + updatedFloat + ")\n";
        }
        return code;
    }
    var stored = rhs.val;
    if op != "=" {
        if elementType != "int" || rhs.ty != "i64" {
            cgSetError(ctx, "compound indexed assignment requires int elements");
            return code;
        }
        var current = nextTemp(ctx);
        if kind == "Vec" {
            code = code + current + " = call i64 @rey_vec_get(i64 " + receiver.val + ", i64 " + indexValue.val + ")\n";
        } else {
            code = code + current + " = call i64 @rey_hm_get_checked(i64 " + receiver.val + ", i8* " + key + ")\n";
        }
        var arithmeticOp = "+";
        if op == "-=" { arithmeticOp = "-"; }
        if op == "*=" { arithmeticOp = "*"; }
        if op == "/=" { arithmeticOp = "/"; }
        if op == "%=" { arithmeticOp = "%"; }
        if arithmeticOp == "/" || arithmeticOp == "%" {
            var quotient: GenExprResult = cgCheckedDivRem(ctx, arithmeticOp, current, rhs.val);
            code = code + quotient.code;
            stored = quotient.val;
        } else {
            var updated: GenExprResult = cgCheckedIntBin(ctx, arithmeticOp, current, rhs.val);
            code = code + updated.code;
            stored = updated.val;
        }
    } else if elementType == "float" || rhs.ty == "double" {
        var assignedFloat = rhs.val;
        if rhs.ty != "double" {
            var widenedAssign = nextTemp(ctx);
            code = code + widenedAssign + " = sitofp i64 " + rhs.val + " to double\n";
            assignedFloat = widenedAssign;
        }
        if kind == "Vec" {
            code = code + "call void @rey_vec_set_float(i64 " + receiver.val + ", i64 " + indexValue.val + ", double " + assignedFloat + ")\n";
        } else {
            code = code + "call void @rey_hm_set_float(i64 " + receiver.val + ", i8* " + key + ", double " + assignedFloat + ")\n";
        }
        return code;
    } else if rhs.ty == "i1" {
        var extended = nextTemp(ctx);
        code = code + extended + " = zext i1 " + rhs.val + " to i64\n";
        stored = extended;
    } else if rhs.ty.endsWith("*") {
        var bits = nextTemp(ctx);
        code = code + bits + " = ptrtoint " + rhs.ty + " " + rhs.val + " to i64\n";
        stored = bits;
    } else if rhs.ty != "i64" {
        cgSetError(ctx, "indexed assignment value has no codegen representation");
        return code;
    }
    if kind == "Vec" {
        code = code + "call void @rey_vec_set(i64 " + receiver.val + ", i64 " + indexValue.val + ", i64 " + stored + ")\n";
    } else {
        code = code + "call void @rey_hm_set(i64 " + receiver.val + ", i8* " + key + ", i64 " + stored + ")\n";
    }
    return code;
}

func cgFieldInitIdentity(expression: Expr, literal: StructLiteralExpr, initializer: StructInitField): string {
    var name = initializer.name;
    return cgExprNodeKey(expression) + ":" + literal.span.start.toString() + ":" + literal.span.end.toString() + ":" + name.len().toString() + ":" + name + ":" + initializer.span.start.toString() + ":" + initializer.span.end.toString();
}

func cgBuildCheckedIndexes(ctx: CodegenContext) {
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
        var checkedProgram: CheckedProgram = maybeProgram;
        var i = 0;
        loop {
            if i >= checkedProgram.expressions.len() { break; }
            var info: CheckedExprInfo = checkedProgram.expressions[i];
            var key = cgMetadataKey(info.sourcePath, info.moduleId, cgExprNodeKey(info.expression));
            if ctx.checkedExprIndex.has(key) {
                var bucket: Vec<CheckedExprInfo> = ctx.checkedExprIndex.get(key);
                var found = false;
                var bucketIndex = 0;
                loop {
                    if bucketIndex >= bucket.len() { break; }
                    var old: CheckedExprInfo = bucket[bucketIndex];
                    if old.expression == info.expression {
                        if old.nodeId != info.nodeId { cgSetError(ctx, "ambiguous checked expression identity"); }
                        found = true;
                    }
                    bucketIndex = bucketIndex + 1;
                }
                if !found {
                    bucket.push(info);
                    ctx.checkedExprIndex.set(key, bucket);
                }
            } else {
                ctx.checkedExprIndex.set(key, [info]);
            }
            i = i + 1;
        }
        i = 0;
        loop {
            if i >= checkedProgram.fieldInitializers.len() { break; }
            var fieldInfo: CheckedFieldInitInfo = checkedProgram.fieldInitializers[i];
            var fieldKey = cgMetadataKey(fieldInfo.sourcePath, fieldInfo.moduleId, cgFieldInitIdentity(fieldInfo.expression, fieldInfo.literal, fieldInfo.initializer));
            if ctx.checkedFieldInitIndex.has(fieldKey) {
                var fieldBucket: Vec<CheckedFieldInitInfo> = ctx.checkedFieldInitIndex.get(fieldKey);
                var fieldFound = false;
                var fieldBucketIndex = 0;
                loop {
                    if fieldBucketIndex >= fieldBucket.len() { break; }
                    var oldField: CheckedFieldInitInfo = fieldBucket[fieldBucketIndex];
                    if oldField.expression == fieldInfo.expression && oldField.literal == fieldInfo.literal && oldField.initializer == fieldInfo.initializer {
                        if oldField.nodeId != fieldInfo.nodeId || oldField.fieldIndex != fieldInfo.fieldIndex { cgSetError(ctx, "ambiguous checked struct initializer identity"); }
                        fieldFound = true;
                    }
                    fieldBucketIndex = fieldBucketIndex + 1;
                }
                if !fieldFound {
                    fieldBucket.push(fieldInfo);
                    ctx.checkedFieldInitIndex.set(fieldKey, fieldBucket);
                }
            } else {
                ctx.checkedFieldInitIndex.set(fieldKey, [fieldInfo]);
            }
            i = i + 1;
        }
    }
}

func cgFindExprInfo(ctx: CodegenContext, expr: Expr): CheckedExprInfo? {
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
        var key = cgMetadataKey(ctx.currentSourcePath, ctx.currentModuleId, cgExprNodeKey(expr));
        if ctx.checkedExprIndex.has(key) {
            var bucket: Vec<CheckedExprInfo> = ctx.checkedExprIndex.get(key);
            var found: CheckedExprInfo? = null;
            var i = 0;
            loop {
                if i >= bucket.len() { break; }
                var info: CheckedExprInfo = bucket[i];
                if info.expression == expr {
                    if found != null {
                        var previous: CheckedExprInfo = found;
                        if previous.nodeId != info.nodeId { cgSetError(ctx, "ambiguous checked expression identity"); return null; }
                    }
                    found = info;
                }
                i = i + 1;
            }
            return found;
        }
    }
    return null;
}

func cgFindFieldInitInfo(ctx: CodegenContext, literalExpr: Expr, literal: StructLiteralExpr, initializer: StructInitField): CheckedFieldInitInfo? {
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
        var key = cgMetadataKey(ctx.currentSourcePath, ctx.currentModuleId, cgFieldInitIdentity(literalExpr, literal, initializer));
        if ctx.checkedFieldInitIndex.has(key) {
            var bucket: Vec<CheckedFieldInitInfo> = ctx.checkedFieldInitIndex.get(key);
            var found: CheckedFieldInitInfo? = null;
            var i = 0;
            loop {
                if i >= bucket.len() { break; }
                var info: CheckedFieldInitInfo = bucket[i];
                if info.expression == literalExpr && info.literal == literal && info.initializer == initializer {
                    if found != null {
                        var previous: CheckedFieldInitInfo = found;
                        if previous.nodeId != info.nodeId || previous.fieldIndex != info.fieldIndex { cgSetError(ctx, "ambiguous checked struct initializer identity"); return null; }
                    }
                    found = info;
                }
                i = i + 1;
            }
            return found;
        }
    }
    return null;
}

func cgNominalKey(kind: string, sourcePath: string, moduleId: string, name: string, declarationIndex: int): string {
    return kind + sourcePath.len().toString() + ":" + sourcePath + moduleId.len().toString() + ":" + moduleId + name.len().toString() + ":" + name + ":" + declarationIndex.toString();
}

func cgCheckedNominalKey(ctx: CodegenContext, ty: Type): string {
    if ty.kind != "Struct" && ty.kind != "Enum" { return ty.name; }
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
        var checkedProgram: CheckedProgram = maybeProgram;
        var layoutIndex = 0;
        loop {
            if layoutIndex >= checkedProgram.nominalLayouts.len() { break; }
            var layout: CheckedNominalLayout = checkedProgram.nominalLayouts[layoutIndex];
            if layout.kind == ty.kind && layout.name == ty.name && layout.sourcePath == ty.sourcePath && layout.moduleId == ty.moduleId {
                return cgNominalKey(layout.kind, layout.sourcePath, layout.moduleId, layout.name, layout.declarationIndex);
            }
            layoutIndex = layoutIndex + 1;
        }
        cgSetError(ctx, "checked nominal type has no owner-matched layout: " + ty.moduleId + "::" + ty.name);
        return "";
    }
    return ty.name;
}

func cgCheckedStructName(ctx: CodegenContext, sourcePath: string, moduleId: string, declarationIndex: int): string {
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
        var checkedProgram: CheckedProgram = maybeProgram;
        var layoutIndex = 0;
        loop {
            if layoutIndex >= checkedProgram.nominalLayouts.len() { break; }
            var layout: CheckedNominalLayout = checkedProgram.nominalLayouts[layoutIndex];
            if layout.kind == "Struct" && layout.sourcePath == sourcePath && layout.moduleId == moduleId && layout.declarationIndex == declarationIndex {
                return cgNominalKey(layout.kind, layout.sourcePath, layout.moduleId, layout.name, layout.declarationIndex);
            }
            layoutIndex = layoutIndex + 1;
        }
    }
    return "";
}

func cgResolveNominalKey(ctx: CodegenContext, kind: string, sourceName: string): string {
    if sourceName == "" { return ""; }
    if kind == "Struct" {
        if ctx.structDefs.has(sourceName) { return sourceName; }
        if ctx.checkedProgram == null { return ""; }
        var structKeys = ctx.structDefs.keys();
        var structLocal = "";
        var structOnly = "";
        var structCount = 0;
        var structPos = 0;
        loop {
            if structPos >= structKeys.len() { break; }
            var structKey = structKeys[structPos];
            var structDef: StructDef = ctx.structDefs.get(structKey);
            if structDef.sourceName == sourceName {
                structCount = structCount + 1;
                structOnly = structKey;
                if structDef.sourcePath == ctx.currentSourcePath && structDef.moduleId == ctx.currentModuleId { structLocal = structKey; }
            }
            structPos = structPos + 1;
        }
        if structLocal != "" { return structLocal; }
        if structCount == 1 { return structOnly; }
        return "";
    }
    if kind == "Enum" {
        if ctx.enumDefs.has(sourceName) { return sourceName; }
        if ctx.checkedProgram == null { return ""; }
        var enumKeys = ctx.enumDefs.keys();
        var enumLocal = "";
        var enumOnly = "";
        var enumCount = 0;
        var enumPos = 0;
        loop {
            if enumPos >= enumKeys.len() { break; }
            var enumKey = enumKeys[enumPos];
            var enumDef: EnumDef = ctx.enumDefs.get(enumKey);
            if enumDef.sourceName == sourceName {
                enumCount = enumCount + 1;
                enumOnly = enumKey;
                if enumDef.sourcePath == ctx.currentSourcePath && enumDef.moduleId == ctx.currentModuleId { enumLocal = enumKey; }
            }
            enumPos = enumPos + 1;
        }
        if enumLocal != "" { return enumLocal; }
        if enumCount == 1 { return enumOnly; }
        return "";
    }
    return "";
}

func cgEnumLayoutKey(ctx: CodegenContext, sourceType: string, patternEnumName: string): string {
    if sourceType == "" || !ctx.enumDefs.has(sourceType) { return ""; }
    var def: EnumDef = ctx.enumDefs.get(sourceType);
    if patternEnumName == "" || patternEnumName == sourceType || patternEnumName == def.sourceName { return sourceType; }
    return "";
}

func cgCallStmtKey(stmt: Stmt): string {
    var span = stmtSpan(stmt);
    var variant = "Stmt";
    match stmt {
        Stmt::VarDecl(_) => { variant = "VarDecl"; },
        Stmt::ConstDecl(_) => { variant = "ConstDecl"; },
        Stmt::FuncDecl(_) => { variant = "FuncDecl"; },
        Stmt::StructDecl(_) => { variant = "StructDecl"; },
        Stmt::EnumDecl(_) => { variant = "EnumDecl"; },
        Stmt::Import(_) => { variant = "Import"; },
        Stmt::If(_) => { variant = "If"; },
        Stmt::Assign(_) => { variant = "Assign"; },
        Stmt::Return(_) => { variant = "Return"; },
        Stmt::Break(_) => { variant = "Break"; },
        Stmt::Continue(_) => { variant = "Continue"; },
        Stmt::While(_) => { variant = "While"; },
        Stmt::For(_) => { variant = "For"; },
        Stmt::Loop(_) => { variant = "Loop"; },
        Stmt::Block(_) => { variant = "Block"; },
        Stmt::ExprStmt(_) => { variant = "ExprStmt"; },
        Stmt::Match(_) => { variant = "Match"; },
    }
    return variant + ":" + span.start.toString() + ":" + span.end.toString();
}

func cgBindingForDeclaration(ctx: CodegenContext, stmt: Stmt, name: string): CheckedBindingInfo? {
    var declarationKey = cgCallStmtKey(stmt);
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
        var checkedProgram: CheckedProgram = maybeProgram;
        var bindingIndex = 0;
        loop {
            if bindingIndex >= checkedProgram.bindings.len() { break; }
            var binding: CheckedBindingInfo = checkedProgram.bindings[bindingIndex];
            if binding.declarationKey == declarationKey && binding.name == name && binding.sourcePath == ctx.currentSourcePath && binding.moduleId == ctx.currentModuleId { return binding; }
            bindingIndex = bindingIndex + 1;
        }
    }
    return null;
}

func cgIsScalarType(ty: Type): bool {
    return ty.kind == "Int" || ty.kind == "Float" || ty.kind == "Bool" || ty.kind == "Char";
}

func cgScalarNullableInner(tag: string): string {
    if tag.len() < 2 || !tag.endsWith("?") { return ""; }
    var inner = tag.slice(0, tag.len() - 1);
    if inner == "int" || inner == "float" || inner == "bool" || inner == "char" { return inner; }
    return "";
}

func cgBoxScalar(ctx: CodegenContext, inner: string, value: GenExprResult): GenExprResult {
    var kind = cgValueKind(ctx, inner);
    if kind < 0 { return cgErrorExpr(ctx, "scalar nullable has no value kind: " + inner); }
    var code = value.code;
    var payload = value.val;
    if inner == "float" {
        if value.ty != "double" { return cgErrorExpr(ctx, "float nullable payload is not double"); }
        var bits = nextTemp(ctx);
        code = code + bits + " = bitcast double " + value.val + " to i64\n";
        payload = bits;
    } else if inner == "char" {
        if value.ty != "i8*" { return cgErrorExpr(ctx, "char nullable payload is not i8*"); }
        var byte = nextTemp(ctx);
        var bits2 = nextTemp(ctx);
        code = code + byte + " = load i8, i8* " + value.val + "\n";
        code = code + bits2 + " = zext i8 " + byte + " to i64\n";
        payload = bits2;
    } else if inner == "bool" && value.ty == "i1" {
        var bits3 = nextTemp(ctx);
        code = code + bits3 + " = zext i1 " + value.val + " to i64\n";
        payload = bits3;
    } else if value.ty != "i64" {
        return cgErrorExpr(ctx, "scalar nullable payload is not i64");
    }
    var boxed = nextTemp(ctx);
    code = code + boxed + " = call i64 @rey_value_new(i64 " + kind.toString() + ", i64 " + payload + ")\n";
    return GenExprResult { ty: "i64", val: boxed, code: code };
}

func cgUnboxScalar(ctx: CodegenContext, inner: string, value: string, code: string): GenExprResult {
    var kind = cgValueKind(ctx, inner);
    if kind < 0 { return cgErrorExpr(ctx, "scalar nullable has no value kind: " + inner); }
    var raw = nextTemp(ctx);
    var nextCode = code + raw + " = call i64 @rey_value_unbox(i64 " + value + ", i64 " + kind.toString() + ")\n";
    if inner == "float" {
        var floatValue = nextTemp(ctx);
        return GenExprResult { ty: "double", val: floatValue, code: nextCode + floatValue + " = bitcast i64 " + raw + " to double\n" };
    }
    if inner == "char" {
        var byte = nextTemp(ctx);
        var buffer = nextTemp(ctx);
        var text = nextTemp(ctx);
        nextCode = nextCode + byte + " = trunc i64 " + raw + " to i8\n";
        nextCode = nextCode + buffer + " = alloca i8, align 1\n";
        nextCode = nextCode + "store i8 " + byte + ", i8* " + buffer + "\n";
        nextCode = nextCode + text + " = call i8* @rey_str_new(i8* " + buffer + ", i64 1)\n";
        return GenExprResult { ty: "i8*", val: text, code: nextCode };
    }
    if inner == "bool" {
        var bit = nextTemp(ctx);
        return GenExprResult { ty: "i1", val: bit, code: nextCode + bit + " = trunc i64 " + raw + " to i1\n" };
    }
    return GenExprResult { ty: "i64", val: raw, code: nextCode };
}

func cgUnwrapType(value: Type?): Type {
    if value != null {
        var inner: Type = value;
        return inner;
    }
    var empty: Vec<Type> = Vec.new();
    return Type { kind: "Unknown", name: "", sourcePath: "", moduleId: "", inner: null, key: null, value: null, params: empty, ret: null };
}

func cgCheckedTypeName(ctx: CodegenContext, ty: Type): string {
    if ty.kind == "Int" { return "int"; }
    if ty.kind == "Float" { return "float"; }
    if ty.kind == "Bool" { return "bool"; }
    if ty.kind == "String" { return "string"; }
    if ty.kind == "Char" { return "char"; }
    if ty.kind == "Null" { return "null"; }
    if ty.kind == "Void" { return "void"; }
    if ty.kind == "Any" { return "any"; }
    if ty.kind == "Struct" || ty.kind == "Enum" { return cgCheckedNominalKey(ctx, ty); }
    if ty.kind == "Array" {
        var maybeInner = ty.inner;
        if maybeInner != null {
            var inner: Type = maybeInner;
            return "Vec<" + cgCheckedTypeName(ctx, inner) + ">";
        }
        return "Vec<any>";
    }
    if ty.kind == "Dict" {
        var maybeValue = ty.value;
        if maybeValue != null {
            var value: Type = maybeValue;
            return "HashMap<string," + cgCheckedTypeName(ctx, value) + ">";
        }
        return "HashMap<string,any>";
    }
    if ty.kind == "Option" {
        var maybeInner = ty.inner;
        if maybeInner != null {
            var inner: Type = maybeInner;
            return "Option<" + cgCheckedTypeName(ctx, inner) + ">";
        }
        return "Option<any>";
    }
    if ty.kind == "Result" {
        var okType = "any";
        var errType = "any";
        var maybeOkType = ty.inner;
        if maybeOkType != null {
            var okTypeValue: Type = maybeOkType;
            okType = cgCheckedTypeName(ctx, okTypeValue);
        }
        var maybeErrType = ty.key;
        if maybeErrType != null {
            var errTypeValue: Type = maybeErrType;
            errType = cgCheckedTypeName(ctx, errTypeValue);
        }
        return "Result<" + okType + "," + errType + ">";
    }
    if ty.kind == "Tuple" {
        var tupleElements: Vec<string> = [];
        var tupleIndex = 0;
        loop {
            if tupleIndex >= ty.params.len() { break; }
            tupleElements.push(cgCheckedTypeName(ctx, ty.params[tupleIndex]));
            tupleIndex = tupleIndex + 1;
        }
        return cgFormatTupleType(tupleElements);
    }
    if ty.kind == "Nullable" {
        var maybeNullable = ty.inner;
        if maybeNullable != null {
            var nullableInner: Type = maybeNullable;
            return cgCheckedTypeName(ctx, nullableInner) + "?";
        }
        return "null";
    }
    if ty.kind == "Function" {
        var functionParams = "";
        var functionIndex = 0;
        loop {
            if functionIndex >= ty.params.len() { break; }
            if functionIndex > 0 { functionParams = functionParams + ", "; }
            functionParams = functionParams + cgCheckedTypeName(ctx, ty.params[functionIndex]);
            functionIndex = functionIndex + 1;
        }
        var functionReturn = "void";
        var maybeFunctionReturn = ty.ret;
        if maybeFunctionReturn != null {
            var functionReturnType: Type = maybeFunctionReturn;
            functionReturn = cgCheckedTypeName(ctx, functionReturnType);
        }
        return "(" + functionParams + ") -> " + functionReturn;
    }
    if ty.kind == "Union" {
        var unionText = "";
        var unionIndex = 0;
        loop {
            if unionIndex >= ty.params.len() { break; }
            if unionIndex > 0 { unionText = unionText + " | "; }
            unionText = unionText + cgCheckedTypeName(ctx, ty.params[unionIndex]);
            unionIndex = unionIndex + 1;
        }
        if unionText == "" { return "unsupported"; }
        return unionText;
    }
    if ty.kind == "Unknown" { return ""; }
    return "unsupported";
}

func cgCheckedLLVMType(ctx: CodegenContext, ty: Type): string {
    if ty.kind == "Int" || ty.kind == "Bool" || ty.kind == "Null" || ty.kind == "Any" { return "i64"; }
    if ty.kind == "Enum" {
        var enumKey = cgCheckedNominalKey(ctx, ty);
        if ctx.enumDefs.has(enumKey) { return "i64"; }
        cgSetError(ctx, "checked enum type has no owner-matched layout: " + ty.moduleId + "::" + ty.name);
        return "i64";
    }
    if ty.kind == "Float" { return "double"; }
    if ty.kind == "String" || ty.kind == "Char" { return "i8*"; }
    if ty.kind == "Void" { return "void"; }
    if ty.kind == "Array" || ty.kind == "Dict" || ty.kind == "Option" || ty.kind == "Result" || ty.kind == "Tuple" { return "i64"; }
    if ty.kind == "Struct" {
        var structKey = cgCheckedNominalKey(ctx, ty);
        if !ctx.structDefs.has(structKey) {
            cgSetError(ctx, "checked struct type has no owner-matched layout: " + ty.moduleId + "::" + ty.name);
            return "i64";
        }
        var def: StructDef = ctx.structDefs.get(structKey);
        if def.sourcePath != ty.sourcePath || def.moduleId != ty.moduleId {
            cgSetError(ctx, "checked struct type owner/layout mismatch: " + ty.name);
            return "i64";
        }
        return def.llvmName + "*";
    }
    if ty.kind == "Function" || ty.kind == "Union" { return "i64"; }
    if ty.kind == "Nullable" {
        var maybeNullableLlvm = ty.inner;
        if maybeNullableLlvm != null {
            var nullableInner: Type = maybeNullableLlvm;
            if cgIsScalarType(nullableInner) { return "i64"; }
            var innerLlvm = cgCheckedLLVMType(ctx, nullableInner);
            if innerLlvm.endsWith("*") || innerLlvm == "i64" { return innerLlvm; }
            cgSetError(ctx, "nullable " + cgCheckedTypeName(ctx, nullableInner) + " has no codegen representation");
            return "i64";
        }
        return "i64";
    }
    cgSetError(ctx, "checked type has no codegen representation: " + cgCheckedTypeName(ctx, ty));
    return "i64";
}

func cgRegisterCheckedFunctions(ctx: CodegenContext) {
    var maybeProgram = ctx.checkedProgram;
    if maybeProgram != null {
        var checkedProgram: CheckedProgram = maybeProgram;
        var i = 0;
        loop {
            if i >= checkedProgram.symbols.len() { break; }
            var symbol: ResolvedSymbol = checkedProgram.symbols[i];
            if symbol.sourcePath == ctx.currentSourcePath && symbol.moduleId == ctx.currentModuleId && symbol.kind == "Function" && symbol.receiverPassing == "None" {
                if symbol.signature.kind != "Function" || symbol.llvmName == "" {
                    cgSetError(ctx, "checked function is missing its backend symbol or signature: " + symbol.sourceName);
                } else {
                    var maybeSignatureRet = symbol.signature.ret;
                    if maybeSignatureRet == null {
                        cgSetError(ctx, "checked function is missing its backend symbol or signature: " + symbol.sourceName);
                    } else {
                        var signatureRet: Type = maybeSignatureRet;
                        var symbolName = symbol.llvmName;
                        if symbol.sourceName == "main" && symbolName == "main" { symbolName = "_rey_main"; }
                        if ctx.funcSymbols.has(symbol.sourceName) {
                            cgSetError(ctx, "duplicate checked function symbol: " + symbol.sourceName);
                        } else {
                            ctx.funcSymbols.set(symbol.sourceName, symbolName);
                            ctx.funcArities.set(symbol.sourceName, symbol.callShape.fixedCount);
                            ctx.funcSigs.set(symbol.sourceName + ":ret", cgCheckedLLVMType(ctx, signatureRet));
                            ctx.funcSourceRetTypes.set(symbol.sourceName, cgCheckedTypeName(ctx, signatureRet));
                            var p = 0;
                            loop {
                                if p >= symbol.signature.params.len() { break; }
                                var parameterType: Type = symbol.signature.params[p];
                                ctx.funcSigs.set(symbol.sourceName + ":" + p.toString(), cgCheckedLLVMType(ctx, parameterType));
                                ctx.funcParamSourceTypes.set(symbol.sourceName + ":" + p.toString(), cgCheckedTypeName(ctx, parameterType));
                                p = p + 1;
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
    }
}

func cgAsStringValue(ctx: CodegenContext, expr: Expr, value: GenExprResult): GenExprResult {
    var sourceType = cgSourceType(ctx, expr);
    if sourceType != "string" && sourceType != "char" {
        return cgErrorExpr(ctx, "string value required");
    }
    if value.ty == "i8*" { return value; }
    if value.ty == "i64" {
        var cast = nextTemp(ctx);
        return GenExprResult { ty: "i8*", val: cast, code: value.code + cast + " = inttoptr i64 " + value.val + " to i8*\n" };
    }
    return cgErrorExpr(ctx, "unsupported string value representation");
}

func literalKindCode(kind: LiteralKind): string {
    match kind {
        LiteralKind::String => { return "string"; },
        LiteralKind::Char => { return "char"; },
        LiteralKind::Int => { return "int"; },
        LiteralKind::Float => { return "float"; },
        LiteralKind::Bool => { return "bool"; },
        LiteralKind::Null => { return "null"; },
    }
    return "";
}

func cgSourceType(ctx: CodegenContext, expr: Expr): string {
    if ctx.checkedProgram != null {
        var checkedInfo = cgFindExprInfo(ctx, expr);
        if checkedInfo != null {
            var info: CheckedExprInfo = checkedInfo;
            return cgCheckedTypeName(ctx, info.ty);
        }
        return "";
    }
    match expr {
        Expr::Error(_) => { return ""; },
        Expr::Identifier(ident) => {
            if ctx.locals.has(ident.name) {
                var local: LocalVar = ctx.locals.get(ident.name);
                return local.sourceType;
            }
            return "";
        },
        Expr::Literal(literal) => {
            return literalKindCode(literal.kind);
        },
        Expr::Array(array) => {
            if array.elements.len() == 0 { return "Vec<any>"; }
            var elementType = cgSourceType(ctx, array.elements[0]);
            if elementType == "" { elementType = "any"; }
            return "Vec<" + elementType + ">";
        },
        Expr::Dict(dictExpr) => {
            if dictExpr.entries.len() == 0 { return "HashMap<string,any>"; }
            var dictValueType = cgSourceType(ctx, dictExpr.entries[0].value);
            if dictValueType == "" { dictValueType = "any"; }
            return "HashMap<string," + dictValueType + ">";
        },
        Expr::StructLiteral(literalStruct) => { return literalStruct.name; },
        Expr::EnumVariant(enumVariant) => {
            if enumVariant.enumName == "Option" {
                if enumVariant.variant == "Some" && enumVariant.args.len() == 1 {
                    var innerType = cgSourceType(ctx, enumVariant.args[0]);
                    if innerType == "" { innerType = "any"; }
                    return "Option<" + innerType + ">";
                }
                return "Option<any>";
            }
            if enumVariant.enumName == "Result" && enumVariant.args.len() == 1 {
                var payloadType = cgSourceType(ctx, enumVariant.args[0]);
                if payloadType == "" { payloadType = "any"; }
                if enumVariant.variant == "Ok" { return "Result<" + payloadType + ",any>"; }
                if enumVariant.variant == "Err" { return "Result<any," + payloadType + ">"; }
            }
            return enumVariant.enumName;
        },
        Expr::Unary(unary) => {
            if unary.op == "!" { return "bool"; }
            if unary.op == "-" { return cgSourceType(ctx, unary.right); }
            return "";
        },
        Expr::Update(_) => { return "int"; },
        Expr::Binary(binary) => {
            if binary.op == "instanceof" || binary.op == "==" || binary.op == "!=" || binary.op == "<" || binary.op == ">" || binary.op == "<=" || binary.op == ">=" || binary.op == "&&" || binary.op == "||" {
                return "bool";
            }
            var leftType = cgSourceType(ctx, binary.left);
            var rightType = cgSourceType(ctx, binary.right);
            var leftNumeric = leftType == "int" || leftType == "float";
            var rightNumeric = rightType == "int" || rightType == "float";
            if binary.op == "+" && leftType == "string" && rightType == "string" { return "string"; }
            if leftNumeric && rightNumeric {
                if leftType == "float" || rightType == "float" { return "float"; }
                return "int";
            }
            return "";
        },
        Expr::Call(call) => {
            var identCallOption = cgExprIdentifier(call.callee);
            if identCallOption != null {
                var identCall: IdentExpr = identCallOption;
                if ctx.funcSourceRetTypes.has(identCall.name) { return ctx.funcSourceRetTypes.get(identCall.name); }
                if identCall.name == "args" { return "Vec<string>"; }
                if identCall.name == "readFile" { return "string"; }
                if identCall.name == "exec" { return "Result<string,string>"; }
                if identCall.name == "char" { return "char"; }
                var isOkConstructor = identCall.name == "Result.Ok" || identCall.name == "Ok";
                if isOkConstructor && call.args.len() == 1 {
                    var okType = cgSourceType(ctx, call.args[0]);
                    if okType == "" { okType = "any"; }
                    return "Result<" + okType + ",any>";
                }
                var isErrConstructor = identCall.name == "Result.Err" || identCall.name == "Err";
                if isErrConstructor && call.args.len() == 1 {
                    var errType = cgSourceType(ctx, call.args[0]);
                    if errType == "" { errType = "any"; }
                    return "Result<any," + errType + ">";
                }
            }
            var calleeFieldOption = cgExprFieldAccess(call.callee);
            if calleeFieldOption != null {
                var calleeField: FieldAccessExpr = calleeFieldOption;
                var objectIdentOption = cgExprIdentifier(calleeField.object);
                if objectIdentOption != null {
                    var objectIdent: IdentExpr = objectIdentOption;
                    if objectIdent.name == "Vec" && calleeField.name == "new" { return "Vec<any>"; }
                    if objectIdent.name == "HashMap" && calleeField.name == "new" { return "HashMap<string,any>"; }
                    if objectIdent.name == "Result" && calleeField.name == "Ok" && call.args.len() == 1 {
                        var okType2 = cgSourceType(ctx, call.args[0]);
                        if okType2 == "" { okType2 = "any"; }
                        return "Result<" + okType2 + ",any>";
                    }
                    if objectIdent.name == "Result" && calleeField.name == "Err" && call.args.len() == 1 {
                        var errType2 = cgSourceType(ctx, call.args[0]);
                        if errType2 == "" { errType2 = "any"; }
                        return "Result<any," + errType2 + ">";
                    }
                    if objectIdent.name == "Option" && (calleeField.name == "Some" || calleeField.name == "None") { return "Option"; }
                }
                if calleeField.name == "keys" || calleeField.name == "split" { return "Vec<string>"; }
                if calleeField.name == "values" { return "Vec<any>"; }
                if calleeField.name == "reverse" || calleeField.name == "slice" || calleeField.name == "map" || calleeField.name == "filter" {
                    var receiverType = cgSourceType(ctx, calleeField.object);
                    if cgCollectionKind(receiverType) == "Vec" { return receiverType; }
                    if calleeField.name == "slice" && receiverType == "string" { return "string"; }
                }
                if calleeField.name == "get" {
                    var receiverType = cgSourceType(ctx, calleeField.object);
                    if cgCollectionKind(receiverType) == "Vec" { return cgVecElementType(receiverType); }
                    if cgCollectionKind(receiverType) == "HashMap" { return cgHashMapValueType(receiverType); }
                }
                if calleeField.name == "unwrapErr" { return cgResultErrType(cgSourceType(ctx, calleeField.object)); }
                if calleeField.name == "unwrapStr" || calleeField.name == "unwrapOrStr" { return cgResultOkType(cgSourceType(ctx, calleeField.object)); }
                if calleeField.name == "unwrapOr" && call.args.len() == 1 {
                    var defaultType = cgSourceType(ctx, call.args[0]);
                    if defaultType != "" && defaultType != "any" { return defaultType; }
                    return cgResultOkType(cgSourceType(ctx, calleeField.object));
                }
            }
            return "";
        },
        Expr::FieldAccess(field) => {
            var ownerType = cgSourceType(ctx, field.object);
            if cgTupleCount(ownerType) >= 0 {
                var tupleElement = cgTupleElementAt(ownerType, cgTupleIndex(field.name));
                if tupleElement != "" { return tupleElement; }
                return "";
            }
            if ownerType == "" || !ctx.structDefs.has(ownerType) { return ""; }
            var def: StructDef = ctx.structDefs.get(ownerType);
            var index = 0;
            loop {
                if index >= def.fields.len() { break; }
                var item: StructFieldDef = def.fields[index];
                if item.name == field.name { return item.sourceType; }
                index = index + 1;
            }
            return "";
        },
        Expr::Index(index) => {
            var targetType = cgSourceType(ctx, index.target);
            if cgCollectionKind(targetType) == "Vec" { return cgVecElementType(targetType); }
            if cgCollectionKind(targetType) == "HashMap" { return cgHashMapValueType(targetType); }
            if targetType == "string" { return "char"; }
            return "";
        },
        Expr::Lambda(_) => { return ""; },
        Expr::Match(_) => { return ""; },
        Expr::If(_) => { return ""; },
        Expr::Tuple(tupleExpr) => {
            var tupleElements: Vec<string> = [];
            var tupleIndex = 0;
            loop {
                if tupleIndex >= tupleExpr.elements.len() { break; }
                var tupleElementType = cgSourceType(ctx, tupleExpr.elements[tupleIndex]);
                if tupleElementType == "" { tupleElementType = "any"; }
                tupleElements.push(tupleElementType);
                tupleIndex = tupleIndex + 1;
            }
            return cgFormatTupleType(tupleElements);
        },
    }
    return "";
}

func cgUnboxValue(ctx: CodegenContext, sourceType: string, value: string, code: string): GenExprResult {
    if sourceType == "string" || sourceType == "char" {
        var stringPtr = nextTemp(ctx);
        return GenExprResult { ty: "i8*", val: stringPtr, code: code + stringPtr + " = inttoptr i64 " + value + " to i8*\n" };
    }
    if ctx.structDefs.has(sourceType) {
        var def: StructDef = ctx.structDefs.get(sourceType);
        var structPtr = nextTemp(ctx);
        return GenExprResult { ty: def.llvmName + "*", val: structPtr, code: code + structPtr + " = inttoptr i64 " + value + " to " + def.llvmName + "*\n" };
    }
    if sourceType == "float" {
        var number = nextTemp(ctx);
        return GenExprResult { ty: "double", val: number, code: code + number + " = bitcast i64 " + value + " to double\n" };
    }
    return GenExprResult { ty: "i64", val: value, code: code };
}

func cgCanonicalSourceType(tag: string): string {
    if tag == "String" { return "string"; }
    if tag == "Void" { return "void"; }
    if tag == "Bool" { return "bool"; }
    if tag == "Int" { return "int"; }
    if tag == "Float" { return "float"; }
    if tag.startsWith("[") && tag.endsWith("]") {
        return "Vec<" + cgCanonicalSourceType(tag.slice(1, tag.len() - 1)) + ">";
    }
    if tag.startsWith("Vec<") && tag.endsWith(">") {
        return "Vec<" + cgCanonicalSourceType(tag.slice(4, tag.len() - 1)) + ">";
    }
    if tag.startsWith("Option<") && tag.endsWith(">") {
        return "Option<" + cgCanonicalSourceType(tag.slice(7, tag.len() - 1)) + ">";
    }
    if tag.startsWith("HashMap<") && tag.endsWith(">") {
        var innerMap = tag.slice(8, tag.len() - 1);
        var mapComma = innerMap.indexOf(",");
        if mapComma >= 0 {
            return "HashMap<" + cgCanonicalSourceType(innerMap.slice(0, mapComma).trim()) + "," + cgCanonicalSourceType(innerMap.slice(mapComma + 1, innerMap.len()).trim()) + ">";
        }
    }
    if tag.startsWith("Result<") && tag.endsWith(">") {
        var innerResult = tag.slice(7, tag.len() - 1);
        var resultComma = innerResult.indexOf(",");
        if resultComma >= 0 {
            return "Result<" + cgCanonicalSourceType(innerResult.slice(0, resultComma).trim()) + "," + cgCanonicalSourceType(innerResult.slice(resultComma + 1, innerResult.len()).trim()) + ">";
        }
    }
    return tag;
}

func cgSourceTypeFromTypeExpr(ctx: CodegenContext, expr: TypeExpr?): string {
    if expr != null {
        var typeExpr: TypeExpr = expr;
        if typeExpr.kind == TypeExprKind::Nullable {
            var nullableName = cgSourceTypeFromTypeExpr(ctx, typeExpr.inner);
            if nullableName == "" { return "null"; }
            return nullableName + "?";
        }
        if typeExpr.kind == TypeExprKind::Named {
            var named = cgCanonicalSourceType(typeExpr.name);
            if ctx.checkedProgram != null {
                var namedStruct = cgResolveNominalKey(ctx, "Struct", named);
                if namedStruct != "" { return namedStruct; }
                var namedEnum = cgResolveNominalKey(ctx, "Enum", named);
                if namedEnum != "" { return namedEnum; }
            }
            return named;
        }
        if typeExpr.kind == TypeExprKind::Applied {
            if typeExpr.name == "Vec" {
                if typeExpr.members.len() == 0 { return "Vec<any>"; }
                if typeExpr.members.len() == 1 { return "Vec<" + cgSourceTypeFromTypeExpr(ctx, typeExpr.members[0]) + ">"; }
            }
            if typeExpr.name == "HashMap" {
                if typeExpr.members.len() == 2 {
                    var keyType = cgSourceTypeFromTypeExpr(ctx, typeExpr.members[0]);
                    var valueType = cgSourceTypeFromTypeExpr(ctx, typeExpr.members[1]);
                    if keyType == "string" { return "HashMap<string," + valueType + ">"; }
                    cgSetError(ctx, "checked HashMap key type is not string");
                    return "";
                }
            }
            if typeExpr.name == "Option" && typeExpr.members.len() == 1 {
                return "Option<" + cgSourceTypeFromTypeExpr(ctx, typeExpr.members[0]) + ">";
            }
            if typeExpr.name == "Result" && typeExpr.members.len() == 2 {
                return "Result<" + cgSourceTypeFromTypeExpr(ctx, typeExpr.members[0]) + "," + cgSourceTypeFromTypeExpr(ctx, typeExpr.members[1]) + ">";
            }
            cgSetError(ctx, "unsupported checked applied type: " + typeExpr.name);
            return "";
        }
        if typeExpr.kind == TypeExprKind::Function {
            var functionParams = "";
            var functionIndex = 0;
            loop {
                if functionIndex >= typeExpr.params.len() { break; }
                if functionIndex > 0 { functionParams = functionParams + ", "; }
                functionParams = functionParams + cgSourceTypeFromTypeExpr(ctx, typeExpr.params[functionIndex]);
                functionIndex = functionIndex + 1;
            }
            var functionReturn = "void";
            if typeExpr.result != null { functionReturn = cgSourceTypeFromTypeExpr(ctx, typeExpr.result); }
            return "(" + functionParams + ") -> " + functionReturn;
        }
        if typeExpr.kind == TypeExprKind::Union {
            var unionText = "";
            var unionIndex = 0;
            loop {
                if unionIndex >= typeExpr.members.len() { break; }
                if unionIndex > 0 { unionText = unionText + " | "; }
                unionText = unionText + cgSourceTypeFromTypeExpr(ctx, typeExpr.members[unionIndex]);
                unionIndex = unionIndex + 1;
            }
            return unionText;
        }
        if typeExpr.kind == TypeExprKind::Tuple {
            var tupleElements: Vec<string> = [];
            var tupleIndex = 0;
            loop {
                if tupleIndex >= typeExpr.members.len() { break; }
                tupleElements.push(cgSourceTypeFromTypeExpr(ctx, typeExpr.members[tupleIndex]));
                tupleIndex = tupleIndex + 1;
            }
            return cgFormatTupleType(tupleElements);
        }
        cgSetError(ctx, "checked type expression has no codegen representation");
    }
    return "";
}

func cgExprIdentifier(expr: Expr): IdentExpr? {
    match expr {
        Expr::Error(_) => { return null; },
        Expr::Literal(_) => { return null; },
        Expr::Identifier(payload) => { return payload; },
        Expr::Binary(_) => { return null; },
        Expr::Unary(_) => { return null; },
        Expr::Update(_) => { return null; },
        Expr::Call(_) => { return null; },
        Expr::EnumVariant(_) => { return null; },
        Expr::Index(_) => { return null; },
        Expr::FieldAccess(_) => { return null; },
        Expr::Lambda(_) => { return null; },
        Expr::Match(_) => { return null; },
        Expr::If(_) => { return null; },
        Expr::Tuple(_) => { return null; },
        Expr::Array(_) => { return null; },
        Expr::Dict(_) => { return null; },
        Expr::StructLiteral(_) => { return null; },
    }
    return null;
}

