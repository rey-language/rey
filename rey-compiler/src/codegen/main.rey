                if cgSourceType(ctx, callExpr.args[0]) != "int" || charArg.ty != "i64" {
                    return cgErrorExpr(ctx, "char conversion requires an int");
                }
                var belowZero = nextTemp(ctx);
                var aboveByte = nextTemp(ctx);
                var invalidByte = nextTemp(ctx);
                var codeChar = charArg.code;
                codeChar = codeChar + belowZero + " = icmp slt i64 " + charArg.val + ", 0\n";
                codeChar = codeChar + aboveByte + " = icmp sgt i64 " + charArg.val + ", 255\n";
                codeChar = codeChar + invalidByte + " = or i1 " + belowZero + ", " + aboveByte + "\n";
                codeChar = codeChar + cgPanicGuard(ctx, invalidByte, "char conversion outside byte range 0..255");
                var byteValue = nextTemp(ctx);
                var byteBuffer = nextTemp(ctx);
                var charString = nextTemp(ctx);
                codeChar = codeChar + byteValue + " = trunc i64 " + charArg.val + " to i8\n";
                codeChar = codeChar + byteBuffer + " = alloca i8, align 1\n";
                codeChar = codeChar + "store i8 " + byteValue + ", i8* " + byteBuffer + "\n";
                codeChar = codeChar + charString + " = call i8* @rey_str_new(i8* " + byteBuffer + ", i64 1)\n";
                return GenExprResult { ty: "i8*", val: charString, code: codeChar };
            }
            if name == "char" {
                return cgErrorExpr(ctx, "char conversion requires one int argument");
            }
            if name == "exit" && callExpr.args.len() == 1 {
                var exitArg: GenExprResult = genExprValue(ctx, callExpr.args[0]);
                if cgSourceType(ctx, callExpr.args[0]) != "int" || exitArg.ty != "i64" {
                    return cgErrorExpr(ctx, "exit requires an int status");
                }
                return GenExprResult { ty: "void", val: "0", code: exitArg.code + "call void @rey_exit(i64 " + exitArg.val + ")\n" };
            }
            if name == "exit" {
                return cgErrorExpr(ctx, "exit requires one int status");
            }
            if name == "min" { return cgEmitMinMax(ctx, expr, callExpr, true); }
            if name == "max" { return cgEmitMinMax(ctx, expr, callExpr, false); }
            if name == "abs" { return cgEmitAbs(ctx, expr, callExpr); }
            if name == "floor" { return cgEmitFloatRounding(ctx, expr, callExpr, "floor"); }
            if name == "ceil" { return cgEmitFloatRounding(ctx, expr, callExpr, "ceil"); }
            if name == "round" { return cgEmitFloatRounding(ctx, expr, callExpr, "round"); }
            if name == "pow" { return cgEmitPow(ctx, expr, callExpr); }
            if name == "sqrt" { return cgCallEmitUnaryFloat(ctx, expr, callExpr, "sqrt"); }
            if name == "log" { return cgCallEmitUnaryFloat(ctx, expr, callExpr, "log"); }
            if name == "sin" { return cgCallEmitUnaryFloat(ctx, expr, callExpr, "sin"); }
            if name == "cos" { return cgCallEmitUnaryFloat(ctx, expr, callExpr, "cos"); }
            if name == "tan" { return cgCallEmitUnaryFloat(ctx, expr, callExpr, "tan"); }
            if name == "assert" { return cgEmitAssert(ctx, expr, callExpr); }
            if name == "int" { return cgEmitIntConversion(ctx, expr, callExpr); }
            if name == "float" { return cgEmitFloatConversion(ctx, expr, callExpr); }
            if name == "string" { return cgEmitStringConversion(ctx, expr, callExpr); }
            if !ctx.funcSymbols.has(name) { return cgErrorExprAt(ctx, expr, "unresolved call target: " + name); }
            if !ctx.funcArities.has(name) || ctx.funcArities.get(name) != callExpr.args.len() {
                return cgErrorExprAt(ctx, expr, "call arity mismatch: " + name);
            }
            var symbol = ctx.funcSymbols.get(name);
            if ctx.checkedProgram != null {
                if checkedSymbolName == "" { return cgErrorExprAt(ctx, expr, "checked direct call has no LLVM symbol: " + name); }
                symbol = checkedSymbolName;
            }
            var retKey = name + ":ret";
            if !ctx.funcSigs.has(retKey) {
                return cgErrorExprAt(ctx, expr, "missing call signature: " + name);
            }
            var retTy = ctx.funcSigs.get(retKey);
            var codeC = "";
            var argsOut = "";
            var i = 0;
            loop {
                if i >= callExpr.args.len() { break; }
                var av: GenExprResult = genExprValue(ctx, callExpr.args[i]);
                codeC = codeC + av.code;
                var argVal = av.val;
                var argTy = av.ty;
                var sigKey = name + ":" + i.toString();
                if ctx.funcSigs.has(sigKey) {
                    var expectedTy = ctx.funcSigs.get(sigKey);
                    if expectedTy != argTy {
                        if expectedTy == "i64" && argTy.endsWith("*") {
                            var castC = nextTemp(ctx);
                            codeC = codeC + castC + " = ptrtoint " + argTy + " " + argVal + " to i64\n";
                            argVal = castC;
                            argTy = "i64";
                        } else if expectedTy == "i64" && argTy == "i1" {
                            var castBool = nextTemp(ctx);
                            codeC = codeC + castBool + " = zext i1 " + argVal + " to i64\n";
                            argVal = castBool;
                            argTy = "i64";
                        } else if expectedTy.endsWith("*") && argTy == "i64" {
                            var castC = nextTemp(ctx);
                            codeC = codeC + castC + " = inttoptr i64 " + argVal + " to " + expectedTy + "\n";
                            argVal = castC;
                            argTy = expectedTy;
                        } else if expectedTy == "double" && argTy == "i64" {
                            var castFloat = nextTemp(ctx);
                            codeC = codeC + castFloat + " = sitofp i64 " + argVal + " to double\n";
                            argVal = castFloat;
                            argTy = "double";
                        } else {
                            cgSetError(ctx, "call argument type mismatch: " + name);
                        }
                    }
                }
                if i > 0 { argsOut = argsOut + ", "; }
                argsOut = argsOut + argTy + " " + argVal;
                i = i + 1;
            }

            var tmp = nextTemp(ctx);
            if retTy == "void" {
                codeC = codeC + "call void @" + symbol + "(" + argsOut + ")\n";
                return GenExprResult { ty: "void", val: "0", code: codeC };
            }
            codeC = codeC + tmp + " = call " + retTy + " @" + symbol + "(" + argsOut + ")\n";
            return GenExprResult { ty: retTy, val: tmp, code: codeC };
        }

        // method call: callExpr.callee is a FieldAccessExpr
        var calleeFieldOption = cgExprFieldAccess(callExpr.callee);
        if calleeFieldOption != null {
            var fa: FieldAccessExpr = calleeFieldOption;
            var method = fa.name;
            if ctx.checkedProgram != null {
                if callInfo != null {
                    var checkedCall: CheckedExprInfo = callInfo;
                    var maybeQualifiedSymbol = checkedCall.symbol;
                    if maybeQualifiedSymbol != null {
                        var qualifiedSymbol: ResolvedSymbol = maybeQualifiedSymbol;
                        if qualifiedSymbol.kind == "Method" || qualifiedSymbol.receiverPassing == "HiddenFirstArg" {
                            return cgCallEmitMethod(ctx, callExpr, fa.object, qualifiedSymbol);
                        }
                        if qualifiedSymbol.kind == "Function" || qualifiedSymbol.kind == "StaticCreate" {
                            if qualifiedSymbol.receiverPassing != "None" || qualifiedSymbol.llvmName == "" {
                                return cgErrorExpr(ctx, "checked qualified call lacks a direct LLVM target");
                            }
                            return cgEmitResolvedCall(ctx, callExpr, qualifiedSymbol);
                        }
                        if qualifiedSymbol.kind == "EnumVariant" {
                            return cgEmitEnumVariantCall(ctx, callExpr, qualifiedSymbol, checkedCall);
                        }
                        if qualifiedSymbol.kind != "Builtin" || qualifiedSymbol.intrinsicId == "" {
                            return cgErrorExpr(ctx, "unsupported checked qualified call kind: " + qualifiedSymbol.kind);
                        }
                        if !qualifiedSymbol.intrinsicId.endsWith("." + method) && qualifiedSymbol.intrinsicId != method {
                            return cgErrorExpr(ctx, "checked intrinsic/method mismatch: " + method);
                        }
                    } else {
                        return cgErrorExpr(ctx, "checked qualified call symbol is missing");
                    }
                } else {
                    return cgErrorExpr(ctx, "checked qualified call metadata is missing");
                }
            }
            var receiverType = cgSourceType(ctx, fa.object);
            if ctx.checkedProgram != null {
                if callInfo != null {
                    var receiverCallInfo: CheckedExprInfo = callInfo;
                    if receiverCallInfo.receiverType.kind != "Unknown" {
                        receiverType = cgCheckedTypeName(ctx, receiverCallInfo.receiverType);
                    }
                }
            }
            var receiverKind = cgCollectionKind(receiverType);
            var obj: GenExprResult = genExprValue(ctx, fa.object);
            var codeM = obj.code;

            // --- Vec static constructors accessed via FieldAccess (Vec.new) ---
            var objectIdentOption = cgExprIdentifier(fa.object);
            if objectIdentOption != null {
                var objIdent: IdentExpr = objectIdentOption;
                var objName = objIdent.name;
                if objName == "Vec" && method == "new" {
                    var t = nextTemp(ctx);
                    return GenExprResult { ty: "i64", val: t, code: t + " = call i64 @rey_vec_new()\n" };
                }
                if objName == "HashMap" && method == "new" {
                    var t = nextTemp(ctx);
                    return GenExprResult { ty: "i64", val: t, code: t + " = call i64 @rey_hm_new()\n" };
                }
                if objName == "Result" && method == "Ok" {
                    if callExpr.args.len() == 1 {
                        var av: GenExprResult = genExprValue(ctx, callExpr.args[0]);
                        var rawOk = cgTaggedPayloadRaw(ctx, callExpr.args[0], av);
                        var kindOk = cgEnumPayloadKind(ctx, cgSourceType(ctx, callExpr.args[0]));
                        if kindOk < 0 { return cgErrorExprAt(ctx, expr, "Result.Ok payload type is unsupported"); }
                        var t = nextTemp(ctx);
                        return GenExprResult { ty: "i64", val: t, code: rawOk.code + t + " = call i64 @rey_ok_typed(i64 " + rawOk.val + ", i64 " + kindOk.toString() + ")\n" };
                    }
                }
                if objName == "Result" && method == "Err" {
                    if callExpr.args.len() == 1 {
                        var av: GenExprResult = genExprValue(ctx, callExpr.args[0]);
                        var rawErr = cgTaggedPayloadRaw(ctx, callExpr.args[0], av);
                        var kindErr = cgEnumPayloadKind(ctx, cgSourceType(ctx, callExpr.args[0]));
                        if kindErr < 0 { return cgErrorExprAt(ctx, expr, "Result.Err payload type is unsupported"); }
                        var t = nextTemp(ctx);
                        return GenExprResult { ty: "i64", val: t, code: rawErr.code + t + " = call i64 @rey_err_typed(i64 " + rawErr.val + ", i64 " + kindErr.toString() + ")\n" };
                    }
                }
                if objName == "Option" && method == "Some" {
                    if callExpr.args.len() == 1 {
                        var av: GenExprResult = genExprValue(ctx, callExpr.args[0]);
                        var rawSome = cgTaggedPayloadRaw(ctx, callExpr.args[0], av);
                        var someKind = cgEnumPayloadKind(ctx, cgSourceType(ctx, callExpr.args[0]));
                        if someKind < 0 { return cgErrorExprAt(ctx, expr, "Option.Some payload type is unsupported"); }
                        var t = nextTemp(ctx);
                        return GenExprResult { ty: "i64", val: t, code: rawSome.code + t + " = call i64 @rey_some_typed(i64 " + rawSome.val + ", i64 " + someKind.toString() + ")\n" };
                    }
                }
                if objName == "Option" && method == "None" {
                    var t = nextTemp(ctx);
                    return GenExprResult { ty: "i64", val: t, code: t + " = call i64 @rey_none()\n" };
                }
            }

            // --- collect call args ---
            var argVals: Vec<GenExprResult> = [];
            var iM = 0;
            loop {
                if iM >= callExpr.args.len() { break; }
                var av: GenExprResult = genExprValue(ctx, callExpr.args[iM]);
                codeM = codeM + av.code;
                argVals.push(av);
                iM = iM + 1;
            }

            // --- String methods (obj.ty == "i8*") ---
            if receiverType == "string" && obj.ty == "i8*" {
                if method == "len" {
                    var t = nextTemp(ctx);
                    codeM = codeM + t + " = call i64 @rey_str_len(i8* " + obj.val + ")\n";
