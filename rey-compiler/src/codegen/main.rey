                    var sc = nextTemp(ctx);
                    if obj.ty.endsWith("*") {
                        codeM = codeM + sc + " = bitcast " + obj.ty + " " + obj.val + " to i8*\n";
                    } else {
                        codeM = codeM + sc + " = inttoptr i64 " + obj.val + " to i8*\n";
                    }
                    strObj = sc;
                }
                var t = nextTemp(ctx);
                if method == "endsWith" && argVals.length() == 1 {
                    var aStr = argVals[0].val;
                    if argVals[0].ty != "i8*" { var ac = nextTemp(ctx); codeM = codeM + ac + " = inttoptr i64 " + aStr + " to i8*\n"; aStr = ac; }
                    codeM = codeM + t + " = call i64 @rey_str_ends_with(i8* " + strObj + ", i8* " + aStr + ")\n";
                    return GenExprResult { ty: "i64", val: t, code: codeM };
                }
                if method == "startsWith" && argVals.length() == 1 {
                    var aStr = argVals[0].val;
                    if argVals[0].ty != "i8*" { var ac = nextTemp(ctx); codeM = codeM + ac + " = inttoptr i64 " + aStr + " to i8*\n"; aStr = ac; }
                    codeM = codeM + t + " = call i64 @rey_str_starts_with(i8* " + strObj + ", i8* " + aStr + ")\n";
                    return GenExprResult { ty: "i64", val: t, code: codeM };
                }
                if method == "indexOf" && argVals.length() == 1 {
                    var aStr = argVals[0].val;
                    if argVals[0].ty != "i8*" { var ac = nextTemp(ctx); codeM = codeM + ac + " = inttoptr i64 " + aStr + " to i8*\n"; aStr = ac; }
                    codeM = codeM + t + " = call i64 @rey_str_index_of(i8* " + strObj + ", i8* " + aStr + ")\n";
                    return GenExprResult { ty: "i64", val: t, code: codeM };
                }
                if method == "len" || method == "length" {
                    if argVals.length() == 0 {
                        codeM = codeM + t + " = call i64 @rey_str_len(i8* " + strObj + ")\n";
                        return GenExprResult { ty: "i64", val: t, code: codeM };
                    }
                }
                if method == "slice" && argVals.length() == 2 {
                    codeM = codeM + t + " = call i8* @rey_str_slice(i8* " + strObj + ", i64 " + argVals[0].val + ", i64 " + argVals[1].val + ")\n";
                    return GenExprResult { ty: "i8*", val: t, code: codeM };
                }
                if method == "trim" && argVals.length() == 0 {
                    codeM = codeM + t + " = call i8* @rey_str_trim(i8* " + strObj + ")\n";
                    return GenExprResult { ty: "i8*", val: t, code: codeM };
                }
                if method == "toString" && argVals.length() == 0 {
                    codeM = codeM + t + " = call i8* @rey_val_to_str(i64 " + obj.val + ")\n";
                    return GenExprResult { ty: "i8*", val: t, code: codeM };
                }
            }

            // module.func(args) — when obj is an unresolved ident (not a local/param), treat as direct call
            var isModuleCall = false;
            if fa.object instanceof IdentExpr {
                var objIdent = fa.object.name;
                if !ctx.locals.has(objIdent) {
                    isModuleCall = true;
                }
            }
            if isModuleCall {
                var t = nextTemp(ctx);
                var argStrM = "";
                var iFM = 0;
                loop {
                    if iFM >= argVals.length() { break; }
                    var avM = argVals[iFM];
                    var avMval = avM.val;
                    var avMty = avM.ty;
                    var sigKeyM = method + ":" + iFM.toString();
                    if ctx.funcSigs.has(sigKeyM) {
                        var expM = ctx.funcSigs.get(sigKeyM);
                        if expM != avMty {
                            if expM == "i64" && avMty.endsWith("*") {
                                var ccM = nextTemp(ctx);
                                codeM = codeM + ccM + " = ptrtoint " + avMty + " " + avMval + " to i64\n";
                                avMval = ccM;
                                avMty = "i64";
                            } else if expM.endsWith("*") && avMty == "i64" {
                                var ccM = nextTemp(ctx);
                                codeM = codeM + ccM + " = inttoptr i64 " + avMval + " to " + expM + "\n";
                                avMval = ccM;
                                avMty = expM;
                            }
                        }
                    }
                    if iFM > 0 { argStrM = argStrM + ", "; }
                    argStrM = argStrM + avMty + " " + avMval;
                    iFM = iFM + 1;
                }
                var retTyM = "i64";
                var retKeyM = method + ":ret";
                if ctx.funcSigs.has(retKeyM) {
                    retTyM = ctx.funcSigs.get(retKeyM);
                }
                if retTyM == "void" {
                    codeM = codeM + "call void @" + method + "(" + argStrM + ")\n";
                    codeM = codeM + t + " = add i64 0, 0\n";
                    return GenExprResult { ty: "void", val: t, code: codeM };
                }
                codeM = codeM + t + " = call " + retTyM + " @" + method + "(" + argStrM + ")\n";
                return GenExprResult { ty: retTyM, val: t, code: codeM };
            }

            // fallback: call as @obj_method(obj, args...)
            var t = nextTemp(ctx);
            var argStr = obj.ty + " " + obj.val;
            var iF = 0;
            loop {
                if iF >= argVals.length() { break; }
                argStr = argStr + ", " + argVals[iF].ty + " " + argVals[iF].val;
                iF = iF + 1;
            }
            var retTyFB = "i64";
            var retKeyFB = method + ":ret";
            if ctx.funcSigs.has(retKeyFB) {
                retTyFB = ctx.funcSigs.get(retKeyFB);
            }
            if retTyFB == "void" {
                codeM = codeM + "call void @" + method + "(" + argStr + ")\n";
                codeM = codeM + t + " = add i64 0, 0\n";
                return GenExprResult { ty: "void", val: t, code: codeM };
            }
            codeM = codeM + t + " = call " + retTyFB + " @" + method + "(" + argStr + ")\n";
            return GenExprResult { ty: retTyFB, val: t, code: codeM };
        }
    }

    // IndexExpr: target[index]
    if expr instanceof IndexExpr {
        var objI: GenExprResult = genExprValue(ctx, expr.target);
        var idxI: GenExprResult = genExprValue(ctx, expr.index);
        var codeI = objI.code + idxI.code;
        if objI.ty == "i8*" {
            // string[i] → char_at
            var t = nextTemp(ctx);
            codeI = codeI + t + " = call i8* @rey_str_char_at(i8* " + objI.val + ", i64 " + idxI.val + ")\n";
            return GenExprResult { ty: "i8*", val: t, code: codeI };
        }
        // Vec[i] or HashMap[i] — both are i64
        var t = nextTemp(ctx);
        codeI = codeI + t + " = call i64 @rey_vec_get(i64 " + objI.val + ", i64 " + idxI.val + ")\n";
        return GenExprResult { ty: "i64", val: t, code: codeI };
    }

    // ArrayExpr: [a, b, c] → Vec
    if expr instanceof ArrayExpr {
        var t = nextTemp(ctx);
        var codeA = t + " = call i64 @rey_vec_new()\n";
        var iA = 0;
        loop {
            if iA >= expr.elements.length() { break; }
            var el: GenExprResult = genExprValue(ctx, expr.elements[iA]);
            codeA = codeA + el.code;
            var elV = el.val;
            if el.ty.endsWith("*") {
                var pt = nextTemp(ctx);
                codeA = codeA + pt + " = ptrtoint " + el.ty + " " + el.val + " to i64\n";
                elV = pt;
            }
            codeA = codeA + "call void @rey_vec_push(i64 " + t + ", i64 " + elV + ")\n";
            iA = iA + 1;
        }
        return GenExprResult { ty: "i64", val: t, code: codeA };
    }
    if expr instanceof StructLiteralExpr {
        if !ctx.structDefs.has(expr.name) {
            return GenExprResult { ty: "i8*", val: "null", code: "" };
        }
        var def: StructDef = ctx.structDefs.get(expr.name);
        var ptr = nextTemp(ctx);
        // heap-allocate struct with a 16-byte header (tag byte at offset 0) for instanceof checks
        // sizeof trick: GEP null ptr by 1 element gives byte offset = sizeof(struct)
        var szNull = nextTemp(ctx);
        var szPtr = nextTemp(ctx);
        var szVal = nextTemp(ctx);
        var szFull = nextTemp(ctx);
        var rawPtr = nextTemp(ctx);
        var dataPtr = nextTemp(ctx);
        var codeS = szNull + " = bitcast i8* null to " + def.llvmName + "*\n";
        codeS = codeS + szPtr + " = getelementptr " + def.llvmName + ", " + def.llvmName + "* " + szNull + ", i64 1\n";
        codeS = codeS + szVal + " = ptrtoint " + def.llvmName + "* " + szPtr + " to i64\n";
        codeS = codeS + szFull + " = add i64 " + szVal + ", 16\n";
        codeS = codeS + rawPtr + " = call i8* @rey_alloc(i64 " + szFull + ")\n";
        // set tag byte
        var tagId = 0;
        if ctx.structTags.has(expr.name) { tagId = ctx.structTags.get(expr.name); }
        codeS = codeS + "store i8 " + tagId.toString() + ", i8* " + rawPtr + "\n";
        // struct data starts 16 bytes after header
        codeS = codeS + dataPtr + " = getelementptr i8, i8* " + rawPtr + ", i64 16\n";
        codeS = codeS + ptr + " = bitcast i8* " + dataPtr + " to " + def.llvmName + "*\n";

        var fields = def.fields;
        var i = 0;
        loop {
            if i >= fields.length() { break; }
            var fldI: StructFieldDef = fields[i];
            var fty = fldI.ty;
            var gep0 = nextTemp(ctx);
            codeS = codeS + gep0 + " = getelementptr inbounds " + def.llvmName + ", " + def.llvmName + "* " + ptr + ", i32 0, i32 " + i.toString() + "\n";
            if fty == "i64" || fty == "i32" || fty == "i1" {
                codeS = codeS + "store " + fty + " 0, " + fty + "* " + gep0 + "\n";
            } else if fty == "i8*" {
                codeS = codeS + "store i8* null, i8** " + gep0 + "\n";
            } else if fty.endsWith("*") {
                codeS = codeS + "store " + fty + " null, " + fty + "* " + gep0 + "\n";
            }
            i = i + 1;
        }

        i = 0;
        loop {
            if i >= expr.fields.length() { break; }
            var initF: StructInitField = expr.fields[i];
            var idx = -1;
            var j = 0;
            loop {
                if j >= fields.length() { break; }
                var fldJ: StructFieldDef = fields[j];
                if fldJ.name == initF.name { idx = j; break; }
                j = j + 1;
            }
            if idx >= 0 {
                var val: GenExprResult = genExprValue(ctx, initF.value);
                codeS = codeS + val.code;
                var gep = nextTemp(ctx);
                var fldAt: StructFieldDef = fields[idx];
                var fty2 = fldAt.ty;
                var storeVal = val.val;
                if fty2 != val.ty {
                    if fty2.endsWith("*") && val.ty == "i64" {
                        var cast = nextTemp(ctx);
                        codeS = codeS + cast + " = inttoptr i64 " + val.val + " to " + fty2 + "\n";
                        storeVal = cast;
                    } else if fty2 == "i64" && val.ty.endsWith("*") {
                        var cast = nextTemp(ctx);
                        codeS = codeS + cast + " = ptrtoint " + val.ty + " " + val.val + " to i64\n";
                        storeVal = cast;
                    }
                }
                codeS = codeS + gep + " = getelementptr inbounds " + def.llvmName + ", " + def.llvmName + "* " + ptr + ", i32 0, i32 " + idx.toString() + "\n";
                codeS = codeS + "store " + fty2 + " " + storeVal + ", " + fty2 + "* " + gep + "\n";
            }
            i = i + 1;
        }
        return GenExprResult { ty: def.llvmName + "*", val: ptr, code: codeS };
    }
    return GenExprResult { ty: "i64", val: "0", code: "" };
}

func genStmt2(ctx, stmt): String {
    if stmt instanceof VarDeclStmt {
        var stmtVD: VarDeclStmt = stmt;
        var init: GenExprResult = genExprValue(ctx, stmtVD.value);
        var ty = llvmTypeFromTagCtx(ctx, stmtVD.typeTag);
        if stmtVD.typeTag == "" {
            ty = init.ty;
        }
        var code0 = init.code;
        if ctx.locals.has(stmtVD.name) {
            var existing: LocalVar = ctx.locals.get(stmtVD.name);
            var storeV = init.val;
            // coerce init to existing slot type regardless of declared ty
            if existing.ty.endsWith("*") && init.ty == "i64" {
                var cv = nextTemp(ctx);
                code0 = code0 + cv + " = inttoptr i64 " + init.val + " to " + existing.ty + "\n";
                storeV = cv;
            } else if existing.ty == "i64" && init.ty.endsWith("*") {
                var cv = nextTemp(ctx);
                code0 = code0 + cv + " = ptrtoint " + init.ty + " " + init.val + " to i64\n";
                storeV = cv;
            } else if existing.ty == "i8*" && init.ty == "i64" {
                var cv = nextTemp(ctx);
                code0 = code0 + cv + " = inttoptr i64 " + init.val + " to i8*\n";
                storeV = cv;
            }
            code0 = code0 + "store " + existing.ty + " " + storeV + ", " + existing.ty + "* " + existing.ptr + "\n";
            return code0;
        }
        var ptr = "%" + stmtVD.name + ".addr";
        // hoist alloca to function entry block
        ctx.funcAllocas = ctx.funcAllocas + ptr + " = alloca " + ty + ", align 8\n";
        var storeVal = init.val;
        // coerce init value to declared type if mismatch
        if ty.endsWith("*") && init.ty == "i64" {
            var cv = nextTemp(ctx);
            code0 = code0 + cv + " = inttoptr i64 " + init.val + " to " + ty + "\n";
            storeVal = cv;
        } else if ty == "i64" && init.ty.endsWith("*") {
            var cv = nextTemp(ctx);
            code0 = code0 + cv + " = ptrtoint " + init.ty + " " + init.val + " to i64\n";
            storeVal = cv;
        } else if ty == "i8*" && init.ty == "i64" {
            var cv = nextTemp(ctx);
            code0 = code0 + cv + " = inttoptr i64 " + init.val + " to i8*\n";
            storeVal = cv;
        }
        code0 = code0 + "store " + ty + " " + storeVal + ", " + ty + "* " + ptr + "\n";
        ctx.locals.set(stmtVD.name, LocalVar { ptr: ptr, ty: ty });
        return code0;
    }
    if stmt instanceof ConstDeclStmt {
        var stmtCD: ConstDeclStmt = stmt;
        var init2: GenExprResult = genExprValue(ctx, stmtCD.value);
        var ty2 = llvmTypeFromTagCtx(ctx, stmtCD.typeTag);
        if stmtCD.typeTag == "" {
            ty2 = init2.ty;
        }
        var ptr2 = "%" + stmtCD.name + ".addr";
        var codeC = init2.code;
        // hoist alloca to function entry block
        ctx.funcAllocas = ctx.funcAllocas + ptr2 + " = alloca " + ty2 + ", align 8\n";
        codeC = codeC + "store " + ty2 + " " + init2.val + ", " + ty2 + "* " + ptr2 + "\n";
        ctx.locals.set(stmtCD.name, LocalVar { ptr: ptr2, ty: ty2 });
        return codeC;
    }
    if stmt instanceof ExprStmt {
        var stmtES: ExprStmt = stmt;
        var e = stmtES.expr;
        if e instanceof CallExpr {
            var callE: CallExpr = e;
            var callee = callE.callee;
            if callee instanceof IdentExpr {
                var calleeId: IdentExpr = callee;
                var cname = calleeId.name;
                if cname == "println" || cname == "print" {
                    if callE.args.length() == 1 {
                        var arg: GenExprResult = genExprValue(ctx, callE.args[0]);
                        var code = arg.code;
                        var s = arg.val;
                        if arg.ty != "i8*" {
                            // coerce int/bool to string
                            var st = nextTemp(ctx);
                            if arg.ty == "i1" {
                                var ext = nextTemp(ctx);
                                code = code + ext + " = zext i1 " + arg.val + " to i64\n";
                                code = code + st + " = call i8* @rey_bool_to_str(i64 " + ext + ")\n";
                            } else {
                                code = code + st + " = call i8* @rey_int_to_str(i64 " + arg.val + ")\n";
                            }
                            s = st;
                        }
                        if cname == "println" {
                            code = code + "call void @rey_println(i8* " + s + ")\n";
                        } else {
                            code = code + "call void @rey_print(i8* " + s + ")\n";
                        }
                        return code;
                    }
                    return "";
                }
                // writeFile / appendFile / deleteFile / mkdir as statements
                if cname == "writeFile" && callE.args.length() == 2 {
                    var a0: GenExprResult = genExprValue(ctx, callE.args[0]);
                    var a1: GenExprResult = genExprValue(ctx, callE.args[1]);
                    return a0.code + a1.code + "call void @rey_write_file(i8* " + a0.val + ", i8* " + a1.val + ")\n";
                }
                if cname == "appendFile" && callE.args.length() == 2 {
                    var a0: GenExprResult = genExprValue(ctx, callE.args[0]);
                    var a1: GenExprResult = genExprValue(ctx, callE.args[1]);
                    return a0.code + a1.code + "call void @rey_append_file(i8* " + a0.val + ", i8* " + a1.val + ")\n";
                }
                if cname == "deleteFile" && callE.args.length() == 1 {
                    var a0: GenExprResult = genExprValue(ctx, callE.args[0]);
                    return a0.code + "call void @rey_delete_file(i8* " + a0.val + ")\n";
                }
                if cname == "mkdir" && callE.args.length() == 1 {
                    var a0: GenExprResult = genExprValue(ctx, callE.args[0]);
                    return a0.code + "call void @rey_mkdir(i8* " + a0.val + ")\n";
                }
            }
            // method call statements (e.g. vec.push(x), hm.set(k,v)) — route through genExprValue
            if callE.callee instanceof FieldAccessExpr {
                var faES: FieldAccessExpr = callE.callee;
                var method = faES.name;
                // detect void-returning methods and emit call without result capture
                if method == "push" || method == "pop" || method == "set" || method == "delete" {
                    var res: GenExprResult = genExprValue(ctx, callE);
                    return res.code;
                }
            }
        }
        var ignored: GenExprResult = genExprValue(ctx, e);
        return ignored.code;
    }
    if stmt instanceof AssignStmt {
        var stmtA: AssignStmt = stmt;
        if stmtA.target instanceof IdentExpr {
            var targetId: IdentExpr = stmtA.target;
            var name = targetId.name;
            var rhs: GenExprResult = genExprValue(ctx, stmtA.value);
            var tyA = rhs.ty;
            if ctx.locals.has(name) {
                var getA: LocalVar = ctx.locals.get(name);
                tyA = getA.ty;
            } else {
                var ptrNew = "%" + name + ".addr";
                ctx.funcAllocas = ctx.funcAllocas + ptrNew + " = alloca " + tyA + ", align 8\n";
                var codeNew = rhs.code + "store " + tyA + " " + rhs.val + ", " + tyA + "* " + ptrNew + "\n";
                ctx.locals.set(name, LocalVar { ptr: ptrNew, ty: tyA });
                return codeNew;
            }

            var localA: LocalVar = ctx.locals.get(name);
            var codeA = rhs.code;
            if stmtA.op == "=" {
                var storeValA = rhs.val;
                if localA.ty != rhs.ty {
                    if localA.ty == "i64" && rhs.ty.endsWith("*") {
                        var castA = nextTemp(ctx);
                        codeA = codeA + castA + " = ptrtoint " + rhs.ty + " " + rhs.val + " to i64\n";
                        storeValA = castA;
                    } else if localA.ty.endsWith("*") && rhs.ty == "i64" {
                        var castA = nextTemp(ctx);
                        codeA = codeA + castA + " = inttoptr i64 " + rhs.val + " to " + localA.ty + "\n";
                        storeValA = castA;
                    }
                }
                codeA = codeA + "store " + localA.ty + " " + storeValA + ", " + localA.ty + "* " + localA.ptr + "\n";
                return codeA;
            }

            var cur = nextTemp(ctx);
            codeA = codeA + cur + " = load " + localA.ty + ", " + localA.ty + "* " + localA.ptr + "\n";
            var tmp = nextTemp(ctx);
            var inst = "add";
            if stmtA.op == "-=" { inst = "sub"; }
            if stmtA.op == "*=" { inst = "mul"; }
            if stmtA.op == "/=" { inst = "sdiv"; }
            if stmtA.op == "%=" { inst = "srem"; }
            codeA = codeA + tmp + " = " + inst + " " + localA.ty + " " + cur + ", " + rhs.val + "\n";
            codeA = codeA + "store " + localA.ty + " " + tmp + ", " + localA.ty + "* " + localA.ptr + "\n";
            return codeA;
        }
        if stmtA.target instanceof FieldAccessExpr {
            var fa2: FieldAccessExpr = stmtA.target;
            var objFA: GenExprResult = genExprValue(ctx, fa2.object);
            var rhs2: GenExprResult = genExprValue(ctx, stmtA.value);
            var codeFA = objFA.code + rhs2.code;
            // resolve struct type from obj
            var sname2 = "";
            if objFA.ty.endsWith("*") && objFA.ty != "i8*" {
                sname2 = objFA.ty.slice(8, objFA.ty.len() - 1);
            }
            if sname2 == "" {
                // field-by-name heuristic
                var keys2 = ctx.structDefs.keys();
                var ki2 = 0;
                loop {
                    if ki2 >= keys2.len() { break; }
                    var kk2 = keys2.get(ki2);
                    var deftmp2: StructDef = ctx.structDefs.get(kk2);
                    var flds2 = deftmp2.fields;
                    var fi2 = 0;
                    loop {
                        if fi2 >= flds2.length() { break; }
                        var fld2item: StructFieldDef = flds2[fi2];
                        if fld2item.name == fa2.name {
                            sname2 = kk2;
                            break;
                        }
                        fi2 = fi2 + 1;
                    }
                    if sname2 != "" { break; }
                    ki2 = ki2 + 1;
                }
            }
            if sname2 != "" && ctx.structDefs.has(sname2) {
                var def2FA: StructDef = ctx.structDefs.get(sname2);
                var objPtr2 = objFA.val;
                if objFA.ty == "i64" {
                    var castObj2 = nextTemp(ctx);
                    codeFA = codeFA + castObj2 + " = inttoptr i64 " + objFA.val + " to " + def2FA.llvmName + "*\n";
                    objPtr2 = castObj2;
                } else if objFA.ty != def2FA.llvmName + "*" {
                    var castObj2 = nextTemp(ctx);
                    codeFA = codeFA + castObj2 + " = bitcast " + objFA.ty + " " + objFA.val + " to " + def2FA.llvmName + "*\n";
                    objPtr2 = castObj2;
                }
                var flds2FA = def2FA.fields;
                var idx2 = -1;
                var fi3 = 0;
                loop {
                    if fi3 >= flds2FA.length() { break; }
                    var fld3item: StructFieldDef = flds2FA[fi3];
                    if fld3item.name == fa2.name { idx2 = fi3; break; }
                    fi3 = fi3 + 1;
                }
                if idx2 >= 0 {
                    var fld3at: StructFieldDef = flds2FA[idx2];
                    var fty3 = fld3at.ty;
                    var gep3 = nextTemp(ctx);
                    codeFA = codeFA + gep3 + " = getelementptr inbounds " + def2FA.llvmName + ", " + def2FA.llvmName + "* " + objPtr2 + ", i32 0, i32 " + idx2.toString() + "\n";
                    var storeVal2 = rhs2.val;
                    if fty3 != rhs2.ty {
                        if fty3 == "i64" && rhs2.ty.endsWith("*") {
                            var castF = nextTemp(ctx);
                            codeFA = codeFA + castF + " = ptrtoint " + rhs2.ty + " " + rhs2.val + " to i64\n";
                            storeVal2 = castF;
                        } else if fty3.endsWith("*") && rhs2.ty == "i64" {
                            var castF = nextTemp(ctx);
                            codeFA = codeFA + castF + " = inttoptr i64 " + rhs2.val + " to " + fty3 + "\n";
                            storeVal2 = castF;
                        } else if fty3 == "i1" && rhs2.ty == "i64" {
                            var castF = nextTemp(ctx);
                            codeFA = codeFA + castF + " = trunc i64 " + rhs2.val + " to i1\n";
                            storeVal2 = castF;
                        }
                    }
                    codeFA = codeFA + "store " + fty3 + " " + storeVal2 + ", " + fty3 + "* " + gep3 + "\n";
                    return codeFA;
                }
            }
            return rhs2.code;
        }
        return "";
    }
    if stmt instanceof IfStmt {
        var stmtIF: IfStmt = stmt;
        var condvIf: GenExprResult = genExprValue(ctx, stmtIF.condition);
        var codeIf = condvIf.code;
        var condVal = condvIf.val;
        if condvIf.ty == "i64" {
            var tmpc = nextTemp(ctx);
            codeIf = codeIf + tmpc + " = icmp ne i64 " + condvIf.val + ", 0\n";
            condVal = tmpc;
        }
        var thenLabel = nextLabel(ctx, "then");
        var elseLabel = nextLabel(ctx, "else");
        var endLabel = nextLabel(ctx, "endif");

        if stmtIF.elseBranch == null {
            codeIf = codeIf + "br i1 " + condVal + ", label %" + thenLabel + ", label %" + endLabel + "\n";
            codeIf = codeIf + thenLabel + ":\n";
            codeIf = codeIf + genStmt2(ctx, stmtIF.thenBranch);
            if !blockEndsWithTerminator(stmtIF.thenBranch) {
                codeIf = codeIf + "br label %" + endLabel + "\n";
            }
            codeIf = codeIf + endLabel + ":\n";
            return codeIf;
        }

        codeIf = codeIf + "br i1 " + condVal + ", label %" + thenLabel + ", label %" + elseLabel + "\n";
        codeIf = codeIf + thenLabel + ":\n";
        codeIf = codeIf + genStmt2(ctx, stmtIF.thenBranch);
        if !blockEndsWithTerminator(stmtIF.thenBranch) {
            codeIf = codeIf + "br label %" + endLabel + "\n";
        }
        codeIf = codeIf + elseLabel + ":\n";
        codeIf = codeIf + genStmt2(ctx, stmtIF.elseBranch);
        if !blockEndsWithTerminator(stmtIF.elseBranch) {
            codeIf = codeIf + "br label %" + endLabel + "\n";
        }
        codeIf = codeIf + endLabel + ":\n";
        return codeIf;
    }
    if stmt instanceof BreakStmt {
        if ctx.loopStack.len() == 0 { return ""; }
        var top: LoopInfo = ctx.loopStack.get(ctx.loopStack.len() - 1);
        return "br label %" + top.breakLabel + "\n";
    }
    if stmt instanceof ContinueStmt {
        if ctx.loopStack.len() == 0 { return ""; }
        var top2: LoopInfo = ctx.loopStack.get(ctx.loopStack.len() - 1);
        return "br label %" + top2.continueLabel + "\n";
    }
    if stmt instanceof WhileStmt {
        var stmtW: WhileStmt = stmt;
        var condLabel = nextLabel(ctx, "while.cond");
        var bodyLabel = nextLabel(ctx, "while.body");
        var endLabel = nextLabel(ctx, "while.end");

        var codeW = "br label %" + condLabel + "\n";
        codeW = codeW + condLabel + ":\n";
        var condvW: GenExprResult = genExprValue(ctx, stmtW.condition);
        codeW = codeW + condvW.code;
        var condVal = condvW.val;
        if condvW.ty == "i64" {
            var tmpc = nextTemp(ctx);
            codeW = codeW + tmpc + " = icmp ne i64 " + condvW.val + ", 0\n";
            condVal = tmpc;
        }
        codeW = codeW + "br i1 " + condVal + ", label %" + bodyLabel + ", label %" + endLabel + "\n";
        codeW = codeW + bodyLabel + ":\n";
        ctx.loopStack.push(LoopInfo { breakLabel: endLabel, continueLabel: condLabel });
        codeW = codeW + genStmt2(ctx, stmtW.body);
        ctx.loopStack.pop();
        if !(stmtW.body instanceof BlockStmt) || !blockEndsWithTerminator(stmtW.body) {
            codeW = codeW + "br label %" + condLabel + "\n";
        }
        codeW = codeW + endLabel + ":\n";
        return codeW;
    }
    if stmt instanceof LoopStmt {
        var stmtL: LoopStmt = stmt;
        var bodyLabel2 = nextLabel(ctx, "loop.body");
        var endLabel2 = nextLabel(ctx, "loop.end");
        var codeL = "br label %" + bodyLabel2 + "\n";
        codeL = codeL + bodyLabel2 + ":\n";
        ctx.loopStack.push(LoopInfo { breakLabel: endLabel2, continueLabel: bodyLabel2 });
        codeL = codeL + genStmt2(ctx, stmtL.body);
        ctx.loopStack.pop();
        if !(stmtL.body instanceof BlockStmt) || !blockEndsWithTerminator(stmtL.body) {
            codeL = codeL + "br label %" + bodyLabel2 + "\n";
        }
        codeL = codeL + endLabel2 + ":\n";
        return codeL;
    }
    if stmt instanceof ForStmt {
        var stmtF: ForStmt = stmt;
        if stmtF.iterable instanceof ArrayExpr {
            var arrF: ArrayExpr = stmtF.iterable;
            var outF = "";
            var nameF = stmtF.variable;
            var ptrF = "%" + nameF + ".addr";
            var tyF = "i64";
            if !ctx.locals.has(nameF) {
                ctx.funcAllocas = ctx.funcAllocas + ptrF + " = alloca " + tyF + ", align 8\n";
                ctx.locals.set(nameF, LocalVar { ptr: ptrF, ty: tyF });
            } else {
                var getF: LocalVar = ctx.locals.get(nameF);
                ptrF = getF.ptr;
                tyF = getF.ty;
            }

            var iF = 0;
            loop {
                if iF >= arrF.elements.length() { break; }
                var ev: GenExprResult = genExprValue(ctx, arrF.elements[iF]);
                outF = outF + ev.code;
                outF = outF + "store " + tyF + " " + ev.val + ", " + tyF + "* " + ptrF + "\n";
                outF = outF + genStmt2(ctx, stmtF.body);
                iF = iF + 1;
            }
            return outF;
        }
        return "";
    }
    if stmt instanceof ReturnStmt {
        var stmtRS: ReturnStmt = stmt;
        if ctx.currentRetTy == "void" {
            return "ret void\n";
        }
        if stmtRS.value instanceof LiteralExpr {
            var retLit: LiteralExpr = stmtRS.value;
            var retKStr = retLit.kind.toString();
            if retKStr == "LiteralKind::Null" || retKStr == "5" {
                if ctx.currentRetTy == "i32" {
                    return "ret i32 0\n";
                }
                if ctx.currentRetTy == "i64" {
                    return "ret i64 0\n";
                }
                if ctx.currentRetTy == "i8*" {
                    return "ret i8* null\n";
                }
                if ctx.currentRetTy.endsWith("*") {
                    return "ret " + ctx.currentRetTy + " null\n";
                }
            }
        }
        var rvR: GenExprResult = genExprValue(ctx, stmtRS.value);
        var retCode = rvR.code;
        var retVal = rvR.val;
        if ctx.currentRetTy == "i64" {
            if rvR.ty == "i1" {
                var ext = nextTemp(ctx);
                retCode = retCode + ext + " = zext i1 " + retVal + " to i64\n";
                retVal = ext;
            } else if rvR.ty != "i64" {
                if rvR.ty.endsWith("*") {
                    var ext = nextTemp(ctx);
                    retCode = retCode + ext + " = ptrtoint " + rvR.ty + " " + retVal + " to i64\n";
                    retVal = ext;
                }
            }
        } else if ctx.currentRetTy.endsWith("*") {
            if rvR.ty == "i64" {
                var ext = nextTemp(ctx);
                retCode = retCode + ext + " = inttoptr i64 " + retVal + " to " + ctx.currentRetTy + "\n";
                retVal = ext;
            }
        }
        return retCode + "ret " + ctx.currentRetTy + " " + retVal + "\n";
    }
    if stmt instanceof BlockStmt {
        var stmtBS: BlockStmt = stmt;
        var out = "";
        var i = 0;
        loop {
            if i >= stmtBS.statements.length() { break; }
            var st = stmtBS.statements[i];
            out = out + genStmt2(ctx, st);
            if stmtIsTerminator(st) {
                break;
            }
            i = i + 1;
        }
        return out;
    }
    return "";
}

func genFunc2(ctx, f): String {
    ctx.blockId = 0;
    var fDecl: FuncDeclStmt = f;
    var fnName = fDecl.name;
    ctx.locals = HashMap.new();
    ctx.loopStack = Vec.new();
    ctx.funcAllocas = "";  // reset per-function alloca accumulator
    var retTy = "i64";
    if fnName == "main" {
        retTy = "void";
        fnName = "_rey_main";
    } else {
        retTy = llvmTypeFromTagCtx(ctx, fDecl.returnType);
    }
    ctx.currentRetTy = retTy;

    var params = "";
    var i = 0;
    loop {
        if i >= fDecl.params.length() { break; }
        if i > 0 { params = params + ", "; }
        var p: FuncParam = fDecl.params[i];
        var pty = llvmTypeFromTagCtx(ctx, p.typeTag);
        params = params + pty + " %" + p.name;
        i = i + 1;
    }

    // Build header with param allocas/stores
    var header = "define " + retTy + " @" + fnName + "(" + params + ") {\n";
    header = header + "entry:\n";

    i = 0;
    loop {
        if i >= fDecl.params.length() { break; }
        var p2: FuncParam = fDecl.params[i];
        var pty2 = llvmTypeFromTagCtx(ctx, p2.typeTag);
        var ptrp = "%" + p2.name + ".addr";
        header = header + ptrp + " = alloca " + pty2 + ", align 8\n";
        header = header + "store " + pty2 + " %" + p2.name + ", " + pty2 + "* " + ptrp + "\n";
        ctx.locals.set(p2.name, LocalVar { ptr: ptrp, ty: pty2 });
        i = i + 1;
    }

    // Generate body — var allocas go to ctx.funcAllocas, stores remain inline
    var bodyCode = genStmt2(ctx, fDecl.body);

    // Assemble: header + hoisted var allocas + body
    var code = header + ctx.funcAllocas + bodyCode;
    if retTy == "i32" {
        code = code + "ret i32 0\n";
    } else if retTy == "void" {
        code = code + "ret void\n";
    } else if retTy == "i8*" {
        code = code + "ret i8* null\n";
    } else if retTy.endsWith("*") {
        code = code + "ret " + retTy + " null\n";
    } else {
        code = code + "ret i64 0\n";
    }
    code = code + "}\n\n";
    return code;
}

func codegenProgram2(program): String {
    var ctx = ctxNew("rey");
    var bodies = "";

    var i = 0;
    loop {
        if i >= program.statements.length() { break; }
        var st0 = program.statements[i];
        if st0 instanceof StructDeclStmt {
            var sDcl: StructDeclStmt = st0;
            var llvmName = "%struct." + sDcl.name;
            var fields = [];
            var j = 0;
            loop {
                if j >= sDcl.fields.length() { break; }
                var f: StructField = sDcl.fields[j];
                fields.push(StructFieldDef { name: f.name, ty: llvmTypeFromTagCtx(ctx, f.typeTag) });
                j = j + 1;
            }
            ctx.structDefs.set(sDcl.name, StructDef { llvmName: llvmName, fields: fields });
            if !ctx.structTags.has(sDcl.name) {
                ctx.structTags.set(sDcl.name, ctx.nextStructTag);
                ctx.nextStructTag = ctx.nextStructTag + 1;
            }
        }
        if st0 instanceof EnumDeclStmt {
            var eDcl: EnumDeclStmt = st0;
            ctx.enumDefs.set(eDcl.name, eDcl.variants);
        }
        i = i + 1;
    }

    // pre-pass: collect function signatures for call-site coercion
    // stored as funcname:N -> paramType; funcname:ret -> returnType
    i = 0;
    loop {
        if i >= program.statements.length() { break; }
        var st = program.statements[i];
        if st instanceof FuncDeclStmt {
            var fSt: FuncDeclStmt = st;
            var pi = 0;
            loop {
                if pi >= fSt.params.length() { break; }
                var fParam: FuncParam = fSt.params[pi];
                var pTy = llvmTypeFromTagCtx(ctx, fParam.typeTag);
                ctx.funcSigs.set(fSt.name + ":" + pi.toString(), pTy);
                pi = pi + 1;
            }
            var retTySig = llvmTypeFromTagCtx(ctx, fSt.returnType);
            if fSt.name == "main" { retTySig = "void"; }
            ctx.funcSigs.set(fSt.name + ":ret", retTySig);
        }
        i = i + 1;
    }

    i = 0;
    loop {
        if i >= program.statements.length() { break; }
        var st = program.statements[i];
        if st instanceof FuncDeclStmt {
            var fSt2: FuncDeclStmt = st;
            bodies = bodies + genFunc2(ctx, fSt2);
        }
        i = i + 1;
    }

    var code = "; Module: " + ctx.moduleName + "\n";
    code = code + "target datalayout = \"e-m:e-i64:64-f80:128-n8:16:32:64-S128\"\n";
    code = code + "target triple = \"aarch64-apple-darwin\"\n\n";
    code = code + "declare i32 @printf(i8*, ...)\n";
    code = code + "declare i32 @strcmp(i8*, i8*)\n";
    // --- rey runtime extern declarations (strings: i8* ABI; vec/map/result: i64 ABI) ---
    code = code + "declare i8*  @rey_str_new(i8*, i64)\n";
    code = code + "declare i8*  @rey_str_cstr(i8*)\n";
    code = code + "declare i8*  @rey_str_empty()\n";
    code = code + "declare i64  @rey_str_len(i8*)\n";
    code = code + "declare i8*  @rey_str_concat(i8*, i8*)\n";
    code = code + "declare i8*  @rey_str_slice(i8*, i64, i64)\n";
    code = code + "declare i8*  @rey_str_char_at(i8*, i64)\n";
    code = code + "declare i64  @rey_str_index_of(i8*, i8*)\n";
    code = code + "declare i64  @rey_str_starts_with(i8*, i8*)\n";
    code = code + "declare i64  @rey_str_ends_with(i8*, i8*)\n";
    code = code + "declare i8*  @rey_str_trim(i8*)\n";
    code = code + "declare i8*  @rey_str_replace(i8*, i8*, i8*)\n";
    code = code + "declare i8*  @rey_str_repeat(i8*, i64)\n";
    code = code + "declare i8*  @rey_str_to_upper(i8*)\n";
    code = code + "declare i8*  @rey_str_to_lower(i8*)\n";
    code = code + "declare i64  @rey_str_eq(i8*, i8*)\n";
    code = code + "declare i64  @rey_str_split(i8*, i8*)\n";
    code = code + "declare i8*  @rey_int_to_str(i64)\n";
    code = code + "declare i8*  @rey_val_to_str(i64)\n";
    code = code + "declare i8*  @rey_float_to_str(double)\n";
    code = code + "declare i8*  @rey_bool_to_str(i64)\n";
    code = code + "declare void @rey_print(i8*)\n";
    code = code + "declare void @rey_println(i8*)\n";
    code = code + "declare i64  @rey_vec_new()\n";
    code = code + "declare void @rey_vec_push(i64, i64)\n";
    code = code + "declare i64  @rey_vec_pop(i64)\n";
    code = code + "declare i64  @rey_vec_len(i64)\n";
    code = code + "declare i64  @rey_vec_get(i64, i64)\n";
    code = code + "declare void @rey_vec_set(i64, i64, i64)\n";
    code = code + "declare i64  @rey_vec_contains(i64, i64)\n";
    code = code + "declare i64  @rey_vec_str_contains(i64, i8*)\n";
    code = code + "declare i8*  @rey_vec_join(i64, i8*)\n";
    code = code + "declare i64  @rey_vec_slice_v(i64, i64, i64)\n";
    code = code + "declare i64  @rey_vec_reverse(i64)\n";
    code = code + "declare i64  @rey_vec_map(i64, i64)\n";
    code = code + "declare i64  @rey_vec_filter(i64, i64)\n";
    code = code + "declare i64  @rey_hm_new()\n";
    code = code + "declare void @rey_hm_set(i64, i8*, i64)\n";
    code = code + "declare i64  @rey_hm_get(i64, i8*)\n";
    code = code + "declare i64  @rey_hm_has(i64, i8*)\n";
    code = code + "declare void @rey_hm_delete(i64, i8*)\n";
    code = code + "declare i64  @rey_hm_keys(i64)\n";
    code = code + "declare i64  @rey_hm_values(i64)\n";
    code = code + "declare i64  @rey_ok(i64)\n";
    code = code + "declare i64  @rey_err(i64)\n";
    code = code + "declare i64  @rey_ok_str(i8*)\n";
    code = code + "declare i64  @rey_err_str(i8*)\n";
    code = code + "declare i64  @rey_result_is_ok(i64)\n";
    code = code + "declare i64  @rey_result_is_err(i64)\n";
    code = code + "declare i64  @rey_result_unwrap(i64)\n";
    code = code + "declare i64  @rey_result_unwrap_or(i64, i64)\n";
    code = code + "declare i8*  @rey_result_unwrap_str(i64)\n";
    code = code + "declare i8*  @rey_result_unwrap_or_str(i64, i8*)\n";
    code = code + "declare i64  @rey_some(i64)\n";
    code = code + "declare i64  @rey_none()\n";
    code = code + "declare i64  @rey_option_is_some(i64)\n";
    code = code + "declare i64  @rey_option_unwrap(i64)\n";
    code = code + "declare i64  @rey_instanceof_tag(i64, i64)\n";
    code = code + "declare i64  @rey_struct_instanceof(i64, i64)\n";
    code = code + "declare i8*  @rey_read_file(i8*)\n";
    code = code + "declare void @rey_write_file(i8*, i8*)\n";
    code = code + "declare void @rey_append_file(i8*, i8*)\n";
    code = code + "declare i64  @rey_file_exists(i8*)\n";
    code = code + "declare void @rey_delete_file(i8*)\n";
    code = code + "declare void @rey_mkdir(i8*)\n";
    code = code + "declare i64  @rey_list_dir(i8*)\n";
    code = code + "declare i64  @rey_exec_cmd(i8*)\n";
    code = code + "declare void @rey_exit(i64)\n";
    code = code + "declare i8*  @rey_get_env(i8*)\n";
    code = code + "declare void @rey_init(i32, i8**)\n";
    code = code + "declare i64  @rey_args()\n";
    code = code + "declare void @rey_panic(i8*)\n";
    code = code + "declare i8*  @rey_alloc(i64)\n";
    code = code + "\n";

    var keys = ctx.structDefs.keys();
    i = 0;
    loop {
        if i >= keys.len() { break; }
        var name = keys.get(i);
        var def: StructDef = ctx.structDefs.get(name);
        var line = def.llvmName + " = type { ";
        var j = 0;
        loop {
            if j >= def.fields.length() { break; }
            var defFld: StructFieldDef = def.fields[j];
            if j > 0 { line = line + ", "; }
            line = line + defFld.ty;
            j = j + 1;
        }
        line = line + " }\n";
        code = code + line;
        i = i + 1;
    }
    if keys.len() > 0 {
        code = code + "\n";
    }

    // string constants
    i = 0;
    loop {
        if i >= ctx.strings.length() { break; }
        var s = ctx.strings[i];
        // interpret stored strings: if they already contain \\0A, decode for length via llvmCStringInfo on decoded form
        var info: CStringInfo = llvmCStringInfo(s);
        code = code + llvmStrGlobalName(i) + " = private unnamed_addr constant [" + info.len.toString() + " x i8] c\"" + info.escaped + "\", align 1\n";
        i = i + 1;
    }
    if ctx.strings.length() > 0 {
        code = code + "\n";
    }

    code = code + bodies;

    // C entry point: calls rey_init(argc, argv) then _rey_main()
    code = code + "define i32 @main(i32 %argc, i8** %argv) {\n";
    code = code + "entry:\n";
    code = code + "  call void @rey_init(i32 %argc, i8** %argv)\n";
    code = code + "  call void @_rey_main()\n";
    code = code + "  ret i32 0\n";
    code = code + "}\n";

    return code;
}

func llvmType(ty): String {
    if ty.kind == TypeKind.Int {
        return "i64";
    }
    if ty.kind == TypeKind.Float {
        return "double";
    }
    if ty.kind == TypeKind.Bool {
        return "i1";
    }
    if ty.kind == TypeKind.String {
        return "i8*";
    }
    if ty.kind == TypeKind.Void {
        return "void";
    }
    if ty.kind == TypeKind.Array {
        return "i8*";
    }
    return "i8*";
}

func genLit(lit): String {
    if lit.kind == LiteralKind.Int {
        return lit.text;
    }
    if lit.kind == LiteralKind.Float {
        return lit.text;
    }
    if lit.kind == LiteralKind.Bool {
        if lit.text == "true" {
            return "1";
        }
        return "0";
    }
    if lit.kind == LiteralKind.String {
        return "\"" + lit.text + "\"";
    }
    if lit.kind == LiteralKind.Null {
        return "null";
    }
    return "undef";
}
export pub func generateIR(program): String {
    return codegenProgram2(program);
}

export pub func compileLLVM(ir: String, outputPath: String, release: bool, rtDir: String) {
    var llPath = outputPath + ".ll";
    var objPath = outputPath + ".o";

    writeFile(llPath, ir);

    var opt = "-O0";
    if release { opt = "-O2"; }

    // ensure runtime is built
    var libPath = rtDir + "/librey_rt.a";
    if !fileExists(libPath) {
        var makeCmd = "make -C \"" + rtDir + "\"";
        var makeRes = exec(makeCmd);
        if makeRes.isErr() {
            return Result.Err("failed to build rey runtime: " + makeRes.unwrapOr("make failed"));
        }
    }

    var llcCmd = "llc " + opt + " -filetype=obj \"" + llPath + "\" -o \"" + objPath + "\"";
    println("DEBUG llc: " + llcCmd);
    var llcResult = exec(llcCmd);
    if llcResult.isErr() {
        println("DEBUG llc failed: " + llcResult.unwrapOr("?"));
        // fallback: clang can compile LLVM IR directly (useful when llc isn't installed)
        var clangObjCmd = "clang " + opt + " -c -x ir \"" + llPath + "\" -o \"" + objPath + "\"";
        println("DEBUG clang obj: " + clangObjCmd);
        var clangObjResult = exec(clangObjCmd);
        if clangObjResult.isErr() {
            println("DEBUG clang obj failed: " + clangObjResult.unwrapOr("?"));
            return Result.Err(clangObjResult.unwrapOr(llcResult.unwrapOr("llc failed")));
        }
    }

    var clangCmd = "clang \"" + objPath + "\" -L\"" + rtDir + "\" -lrey_rt -o \"" + outputPath + "\"";
    println("DEBUG clang link: " + clangCmd);
    var clangResult = exec(clangCmd);
    if clangResult.isErr() {
        println("DEBUG clang link failed: " + clangResult.unwrapOr("?"));
        return Result.Err(clangResult.unwrapOr("clang failed"));
    }

    // best-effort cleanup (temporarily disabled for debugging)
    // deleteFile(llPath);
    // deleteFile(objPath);

    return Result.Ok(outputPath);
}
