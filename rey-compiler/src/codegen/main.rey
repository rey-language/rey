                    codeM = codeM + t + " = call i8* @rey_str_trim(i8* " + obj.val + ")\n";
                    return GenExprResult { ty: "i8*", val: t, code: codeM };
                }
                if method == "replace" && argVals.len() == 2 {
                    var t = nextTemp(ctx);
                    codeM = codeM + t + " = call i8* @rey_str_replace(i8* " + obj.val + ", i8* " + argVals[0].val + ", i8* " + argVals[1].val + ")\n";
                    return GenExprResult { ty: "i8*", val: t, code: codeM };
                }
                if method == "repeat" && argVals.len() == 1 {
                    var t = nextTemp(ctx);
                    codeM = codeM + t + " = call i8* @rey_str_repeat(i8* " + obj.val + ", i64 " + argVals[0].val + ")\n";
                    return GenExprResult { ty: "i8*", val: t, code: codeM };
                }
                if method == "split" && argVals.len() == 1 {
                    var t = nextTemp(ctx);
                    codeM = codeM + t + " = call i64 @rey_str_split(i8* " + obj.val + ", i8* " + argVals[0].val + ")\n";
                    return GenExprResult { ty: "i64", val: t, code: codeM };
                }
                if method == "toUpper" && argVals.len() == 0 {
                    var t = nextTemp(ctx);
                    codeM = codeM + t + " = call i8* @rey_str_to_upper(i8* " + obj.val + ")\n";
                    return GenExprResult { ty: "i8*", val: t, code: codeM };
                }
                if method == "toLower" && argVals.len() == 0 {
                    var t = nextTemp(ctx);
                    codeM = codeM + t + " = call i8* @rey_str_to_lower(i8* " + obj.val + ")\n";
                    return GenExprResult { ty: "i8*", val: t, code: codeM };
                }
                if method == "toString" { return GenExprResult { ty: "i8*", val: obj.val, code: codeM }; }
            }

            if method == "toString" {
                var rendered: GenExprResult = cgRenderToString(ctx, fa.object, obj);
                return rendered;
            }

            // --- Vec methods ---
            if receiverKind == "Vec" && method == "push" && argVals.len() == 1 {
                var expectedElementType = cgVecElementType(receiverType);
                var actualElementType = cgSourceType(ctx, callExpr.args[0]);
                var av0 = argVals[0];
                if expectedElementType != "" && expectedElementType != "any" && actualElementType != "" && actualElementType != "any" && actualElementType != expectedElementType {
                    var expectedLlvm = llvmTypeFromTagCtx(ctx, expectedElementType);
                    var actualLlvm = av0.ty;
                    var bothPointers = expectedLlvm.endsWith("*") && actualLlvm.endsWith("*");
                    var intLike = (expectedLlvm == "i64" && (actualLlvm == "i64" || actualLlvm == "i1")) || (expectedLlvm == "i64" && actualLlvm.endsWith("*")) || (expectedLlvm.endsWith("*") && actualLlvm == "i64");
                    if !bothPointers && !intLike && expectedLlvm != actualLlvm {
                        return cgErrorExpr(ctx, "Vec.push element type mismatch: expected " + expectedElementType + ", got " + actualElementType);
                    }
                }
                var itemV = av0.val;
                if av0.ty.endsWith("*") {
                    var pt = nextTemp(ctx);
                    codeM = codeM + pt + " = ptrtoint " + av0.ty + " " + av0.val + " to i64\n";
                    itemV = pt;
                } else if av0.ty == "i1" {
                    var boolItem = nextTemp(ctx);
                    codeM = codeM + boolItem + " = zext i1 " + av0.val + " to i64\n";
                    itemV = boolItem;
                } else if av0.ty == "double" {
                    var floatPush = nextTemp(ctx);
                    codeM = codeM + "call void @rey_vec_push_float(i64 " + obj.val + ", double " + av0.val + ")\n";
                    codeM = codeM + floatPush + " = add i64 0, 0\n";
                    return GenExprResult { ty: "i64", val: floatPush, code: codeM };
                }
                var t = nextTemp(ctx);
                codeM = codeM + "call void @rey_vec_push(i64 " + obj.val + ", i64 " + itemV + ")\n";
                codeM = codeM + t + " = add i64 0, 0\n";
                return GenExprResult { ty: "i64", val: t, code: codeM };
            }
            if receiverKind == "Vec" && method == "pop" && argVals.len() == 0 {
                var popped = nextTemp(ctx);
                codeM = codeM + popped + " = call i64 @rey_vec_pop(i64 " + obj.val + ")\n";
                if cgVecElementType(receiverType) == "float" {
                    var floatPop = nextTemp(ctx);
                    codeM = codeM + floatPop + " = bitcast i64 " + popped + " to double\n";
                    return GenExprResult { ty: "double", val: floatPop, code: codeM };
                }
                return cgUnboxValue(ctx, cgVecElementType(receiverType), popped, codeM);
            }
            if receiverKind == "Vec" && method == "len" && argVals.len() == 0 {
                var t = nextTemp(ctx);
                codeM = codeM + t + " = call i64 @rey_vec_len(i64 " + obj.val + ")\n";
                return GenExprResult { ty: "i64", val: t, code: codeM };
            }
            if receiverKind == "Vec" && method == "get" && argVals.len() == 1 {
                if argVals[0].ty == "i64" {
                    if cgVecElementType(receiverType) == "float" {
                        var floatGet = nextTemp(ctx);
                        codeM = codeM + floatGet + " = call double @rey_vec_get_float(i64 " + obj.val + ", i64 " + argVals[0].val + ")\n";
                        return GenExprResult { ty: "double", val: floatGet, code: codeM };
                    }
                    var t = nextTemp(ctx);
                    codeM = codeM + t + " = call i64 @rey_vec_get(i64 " + obj.val + ", i64 " + argVals[0].val + ")\n";
                    return cgUnboxValue(ctx, cgVecElementType(receiverType), t, codeM);
                }
            }
            if receiverKind == "Vec" && method == "set" && argVals.len() == 2 {
                if argVals[0].ty == "i64" {
                    var expectedSetType = cgVecElementType(receiverType);
                    var actualSetType = cgSourceType(ctx, callExpr.args[1]);
                    if expectedSetType != "" && expectedSetType != "any" && actualSetType != "" && actualSetType != "any" && actualSetType != expectedSetType {
                        var expectedSetLlvm = llvmTypeFromTagCtx(ctx, expectedSetType);
                        var actualSetLlvm = argVals[1].ty;
                        var setPointers = expectedSetLlvm.endsWith("*") && actualSetLlvm.endsWith("*");
                        var setIntLike = (expectedSetLlvm == "i64" && (actualSetLlvm == "i64" || actualSetLlvm == "i1")) || (expectedSetLlvm == "i64" && actualSetLlvm.endsWith("*")) || (expectedSetLlvm.endsWith("*") && actualSetLlvm == "i64");
                        if !setPointers && !setIntLike && expectedSetLlvm != actualSetLlvm {
                            return cgErrorExpr(ctx, "Vec.set element type mismatch: expected " + expectedSetType + ", got " + actualSetType);
                        }
                    }
                    var vv = argVals[1].val;
                    if argVals[1].ty.endsWith("*") {
                        var pt = nextTemp(ctx);
                        codeM = codeM + pt + " = ptrtoint " + argVals[1].ty + " " + argVals[1].val + " to i64\n";
                        vv = pt;
                    } else if argVals[1].ty == "i1" {
                        var boolItem = nextTemp(ctx);
                        codeM = codeM + boolItem + " = zext i1 " + argVals[1].val + " to i64\n";
                        vv = boolItem;
                    } else if argVals[1].ty == "double" {
                        var floatSet = nextTemp(ctx);
                        codeM = codeM + "call void @rey_vec_set_float(i64 " + obj.val + ", i64 " + argVals[0].val + ", double " + argVals[1].val + ")\n";
                        codeM = codeM + floatSet + " = add i64 0, 0\n";
                        return GenExprResult { ty: "i64", val: floatSet, code: codeM };
                    }
                    var t = nextTemp(ctx);
                    codeM = codeM + "call void @rey_vec_set(i64 " + obj.val + ", i64 " + argVals[0].val + ", i64 " + vv + ")\n";
                    codeM = codeM + t + " = add i64 0, 0\n";
                    return GenExprResult { ty: "i64", val: t, code: codeM };
                }
            }
            if receiverType == "string" && method == "contains" && argVals.len() == 1 {
                var t = nextTemp(ctx);
                var argStr = argVals[0].val;
                if argVals[0].ty != "i8*" {
                    return cgErrorExpr(ctx, "string.contains requires a string argument");
                }
                var idx = nextTemp(ctx);
                var cmpR = nextTemp(ctx);
                codeM = codeM + idx + " = call i64 @rey_str_index_of(i8* " + obj.val + ", i8* " + argStr + ")\n";
                codeM = codeM + cmpR + " = icmp sge i64 " + idx + ", 0\n";
                codeM = codeM + t + " = zext i1 " + cmpR + " to i64\n";
                return GenExprResult { ty: "i64", val: t, code: codeM };
            }
            if receiverKind == "Vec" && method == "indexOf" && argVals.len() == 1 {
                var indexed: GenExprResult = cgEmitVecIndexOf(ctx, obj.val, argVals[0]);
                return GenExprResult { ty: "i64", val: indexed.val, code: codeM + indexed.code };
            }
            if receiverKind == "Vec" && method == "contains" && argVals.len() == 1 {
                if argVals[0].ty == "i8*" {
                    var stringContains = nextTemp(ctx);
                    codeM = codeM + stringContains + " = call i64 @rey_vec_str_contains(i64 " + obj.val + ", i8* " + argVals[0].val + ")\n";
                    return GenExprResult { ty: "i64", val: stringContains, code: codeM };
                }
                if argVals[0].ty == "double" || argVals[0].ty == "i1" {
                    var indexed: GenExprResult = cgEmitVecIndexOf(ctx, obj.val, argVals[0]);
                    var missing = nextTemp(ctx);
                    var present = nextTemp(ctx);
                    var containsCode = codeM + indexed.code;
