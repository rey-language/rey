                }
                if method == "hash" && argVals.len() == 0 {
                    var hashValue = nextTemp(ctx);
                    codeM = codeM + hashValue + " = call i64 @rey_str_hash(i8* " + obj.val + ")\n";
                    return GenExprResult { ty: "i64", val: hashValue, code: codeM };
