            var resultCtor = "rey_ok_typed";
            if variantExpr.variant == "Err" { resultCtor = "rey_err_typed"; }
            var resultCode = payload.code + resultValue + " = call i64 @" + resultCtor + "(i64 " + payload.val + ", i64 " + resultKind.toString() + ")\n";
            return GenExprResult { ty: "i64", val: resultValue, code: resultCode };
        }
        if !ctx.enumDefs.has(checkedEnumKey) {
            return cgErrorExpr(ctx, "unknown enum variant: " + variantExpr.enumName + "::" + variantExpr.variant);
        }
        var enumDef: EnumDef = ctx.enumDefs.get(checkedEnumKey);
        var index = checkedVariantIndex;
        if ctx.checkedProgram == null {
            index = cgEnumVariantIndex(ctx, checkedEnumKey, variantExpr.variant);
        }
        if index < 0 || index >= enumDef.variants.len() || enumDef.variants[index].name != variantExpr.variant {
            return cgErrorExpr(ctx, "checked enum variant index mismatch: " + variantExpr.enumName + "::" + variantExpr.variant);
        }
        if ctx.checkedProgram != null {
            var variantInfo = cgFindExprInfo(ctx, expr);
            if variantInfo != null {
                var checkedInfo: CheckedExprInfo = variantInfo;
                if checkedInfo.enumIndex != enumDef.declarationIndex || checkedInfo.variantIndex != index || checkedInfo.ty.sourcePath != enumDef.sourcePath || checkedInfo.ty.moduleId != enumDef.moduleId || enumDef.sourceName != variantExpr.enumName {
                    return cgErrorExprAt(ctx, expr, "checked enum constructor identity/layout mismatch");
                }
                var maybeCheckedSymbol = checkedInfo.symbol;
                if maybeCheckedSymbol != null {
                    var checkedSymbol: ResolvedSymbol = maybeCheckedSymbol;
                    if checkedSymbol.signature.kind != "Function" || checkedSymbol.signature.params.len() != enumDef.variants[index].payloadTypes.len() {
                        return cgErrorExprAt(ctx, expr, "checked enum constructor payload signature/layout mismatch");
                    }
                    var signatureIndex = 0;
                    loop {
                        if signatureIndex >= enumDef.variants[index].payloadTypes.len() { break; }
                        if cgCheckedTypeName(ctx, checkedSymbol.signature.params[signatureIndex]) != enumDef.variants[index].payloadTypes[signatureIndex] {
                            return cgErrorExprAt(ctx, expr, "checked enum constructor payload type/layout mismatch");
                        }
                        signatureIndex = signatureIndex + 1;
                    }
                } else {
                    return cgErrorExprAt(ctx, expr, "checked enum constructor symbol metadata is missing");
                }
            } else {
                return cgErrorExprAt(ctx, expr, "checked enum constructor metadata is missing");
            }
        }
        var payloadTypesForVariant = enumDef.variants[index].payloadTypes;
        if variantExpr.args.len() != payloadTypesForVariant.len() {
            return cgErrorExprAt(ctx, expr, "enum constructor payload arity/layout mismatch: " + variantExpr.enumName + "::" + variantExpr.variant);
        }
        var enumValue = nextTemp(ctx);
        var enumCode = enumValue + " = call i64 @rey_enum_new(i64 " + enumDef.identity.toString() + ", i64 " + index.toString() + ", i64 " + payloadTypesForVariant.len().toString() + ")\n";
        var payloadIndex = 0;
        loop {
            if payloadIndex >= payloadTypesForVariant.len() { break; }
            var declaredType = payloadTypesForVariant[payloadIndex];
            var actualType = cgSourceType(ctx, variantExpr.args[payloadIndex]);
            if !cgEnumArgumentTypeCompatible(variantExpr.args[payloadIndex], actualType, declaredType) {
                return cgErrorExprAt(ctx, expr, "enum constructor payload type/layout mismatch at slot " + payloadIndex.toString() + ": expected " + declaredType + ", got " + actualType);
            }
            var payloadKind = cgEnumPayloadKind(ctx, declaredType);
            if payloadKind < 0 { return cgErrorExprAt(ctx, expr, "unsupported enum payload representation: " + declaredType); }
            var payloadValue: GenExprResult = genExprValue(ctx, variantExpr.args[payloadIndex]);
            enumCode = enumCode + payloadValue.code;
            var rawPayload = payloadValue.val;
            if declaredType == "float" {
                if payloadValue.ty != "double" { return cgErrorExprAt(ctx, expr, "float enum payload has unsupported LLVM representation"); }
                var bits = nextTemp(ctx);
                enumCode = enumCode + bits + " = bitcast double " + payloadValue.val + " to i64\n";
                rawPayload = bits;
            } else if declaredType == "string" || declaredType == "char" || ctx.structDefs.has(declaredType) {
                if payloadValue.ty.endsWith("*") {
                    var pointerBits = nextTemp(ctx);
                    enumCode = enumCode + pointerBits + " = ptrtoint " + payloadValue.ty + " " + payloadValue.val + " to i64\n";
                    rawPayload = pointerBits;
                } else if payloadValue.ty != "i64" {
                    return cgErrorExprAt(ctx, expr, "reference enum payload has unsupported LLVM representation");
                }
            } else if payloadValue.ty == "i1" {
                var boolBits = nextTemp(ctx);
                enumCode = enumCode + boolBits + " = zext i1 " + payloadValue.val + " to i64\n";
                rawPayload = boolBits;
            } else if payloadValue.ty != "i64" {
                return cgErrorExprAt(ctx, expr, "enum payload has unsupported LLVM representation: " + declaredType);
            }
            enumCode = enumCode + "call void @rey_enum_set(i64 " + enumValue + ", i64 " + payloadIndex.toString() + ", i64 " + payloadKind.toString() + ", i64 " + rawPayload + ")\n";
            payloadIndex = payloadIndex + 1;
        }
        return GenExprResult { ty: "i64", val: enumValue, code: enumCode };
    }
    if structLiteralPayload != null {
        var structLiteral: StructLiteralExpr = structLiteralPayload;
        var structName = structLiteral.name;
        if ctx.checkedProgram != null {
            var literalInfo = cgFindExprInfo(ctx, expr);
            if literalInfo != null {
                var checkedLiteralInfo: CheckedExprInfo = literalInfo;
                if checkedLiteralInfo.structIndex < 0 {
                    return cgErrorExprAt(ctx, expr, "checked struct literal declaration index is missing");
                }
                var checkedName = cgCheckedStructName(ctx, checkedLiteralInfo.ty.sourcePath, checkedLiteralInfo.ty.moduleId, checkedLiteralInfo.structIndex);
                if checkedName == "" || !ctx.structDefs.has(checkedName) {
                    return cgErrorExprAt(ctx, expr, "checked struct literal/declaration identity mismatch: " + structLiteral.name);
                }
                var checkedDef: StructDef = ctx.structDefs.get(checkedName);
                if checkedDef.sourceName != structLiteral.name || checkedDef.sourcePath != checkedLiteralInfo.ty.sourcePath || checkedDef.moduleId != checkedLiteralInfo.ty.moduleId {
                    return cgErrorExprAt(ctx, expr, "checked struct literal/declaration identity mismatch: " + structLiteral.name);
                }
                structName = checkedName;
            } else {
                return cgErrorExprAt(ctx, expr, "checked struct literal metadata is missing");
            }
        }
        if !ctx.structDefs.has(structName) {
            return cgErrorExprAt(ctx, expr, "unknown struct literal: " + structName);
        }
        var def: StructDef = ctx.structDefs.get(structName);
        var ptr = nextTemp(ctx);
        // heap-allocate struct with a 16-byte header (tag byte at offset 0) for instanceof checks
        // sizeof trick: GEP null ptr by 1 element gives byte offset = sizeof(struct)
        var szNull = nextTemp(ctx);
        var szPtr = nextTemp(ctx);
        var szVal = nextTemp(ctx);
        var szFull = nextTemp(ctx);
        var rawPtr = nextTemp(ctx);
        var dataPtr = nextTemp(ctx);
        var codeS = szNull + " = bitcast i8* null to " + def.llvmName + "*\n";
        codeS = codeS + szPtr + " = getelementptr " + def.llvmName + ", " + def.llvmName + "* " + szNull + ", i64 1\n";
        codeS = codeS + szVal + " = ptrtoint " + def.llvmName + "* " + szPtr + " to i64\n";
        codeS = codeS + szFull + " = add i64 " + szVal + ", 16\n";
        codeS = codeS + rawPtr + " = call i8* @rey_alloc(i64 " + szFull + ")\n";
        // set tag byte
        var tagId = 0;
        if ctx.structTags.has(structName) { tagId = ctx.structTags.get(structName); }
        codeS = codeS + "store i8 " + tagId.toString() + ", i8* " + rawPtr + "\n";
        // struct data starts 16 bytes after header
        codeS = codeS + dataPtr + " = getelementptr i8, i8* " + rawPtr + ", i64 16\n";
        codeS = codeS + ptr + " = bitcast i8* " + dataPtr + " to " + def.llvmName + "*\n";

        var fields = def.fields;
        var i = 0;
        loop {
            if i >= fields.len() { break; }
            var fldI: StructFieldDef = fields[i];
            var fty = fldI.ty;
            var gep0 = nextTemp(ctx);
            codeS = codeS + gep0 + " = getelementptr inbounds " + def.llvmName + ", " + def.llvmName + "* " + ptr + ", i32 0, i32 " + i.toString() + "\n";
            if fty == "i64" || fty == "i32" || fty == "i1" {
                codeS = codeS + "store " + fty + " 0, " + fty + "* " + gep0 + "\n";
            } else if fty == "i8*" {
                codeS = codeS + "store i8* null, i8** " + gep0 + "\n";
            } else if fty.endsWith("*") {
                codeS = codeS + "store " + fty + " null, " + fty + "* " + gep0 + "\n";
            }
            i = i + 1;
        }
        i = 0;
        loop {
            if i >= structLiteral.fields.len() { break; }
            var initF: StructInitField = structLiteral.fields[i];
            var idx = -1;
            if ctx.checkedProgram != null {
                var fieldInitInfo = cgFindFieldInitInfo(ctx, expr, structLiteral, initF);
                if fieldInitInfo == null {
                    cgSetError(ctx, "checked struct initializer metadata is missing: " + initF.name);
                } else {
                    var checkedInit: CheckedFieldInitInfo = fieldInitInfo;
                    idx = checkedInit.fieldIndex;
                    if idx < 0 || idx >= fields.len() {
                        cgSetError(ctx, "checked struct initializer field index is out of range: " + initF.name);
                        idx = -1;
                    } else {
                        var indexedField: StructFieldDef = fields[idx];
                        if indexedField.name != initF.name {
                            cgSetError(ctx, "checked struct initializer index/name mismatch: " + initF.name);
                            idx = -1;
                        } else {
                            var valueLlvm = cgCheckedLLVMType(ctx, checkedInit.valueType);
                            var pointerCoercion = (indexedField.ty.endsWith("*") && valueLlvm == "i64") || (indexedField.ty == "i64" && valueLlvm.endsWith("*"));
                            if valueLlvm != indexedField.ty && !pointerCoercion {
                                cgSetError(ctx, "checked struct initializer value type/layout mismatch: " + initF.name);
                                idx = -1;
                            }
                        }
                    }
                }
            } else {
                var j = 0;
                loop {
                    if j >= fields.len() { break; }
                    var fldJ: StructFieldDef = fields[j];
                    if fldJ.name == initF.name { idx = j; break; }
                    j = j + 1;
                }
            }
            if idx >= 0 {
                var val: GenExprResult = genExprValue(ctx, initF.value);
                codeS = codeS + val.code;
                var gep = nextTemp(ctx);
                var fldAt: StructFieldDef = fields[idx];
                var fty2 = fldAt.ty;
                var storeVal = val.val;
                if fty2 != val.ty {
                    if fty2.endsWith("*") && val.ty == "i64" {
                        var cast = nextTemp(ctx);
                        codeS = codeS + cast + " = inttoptr i64 " + val.val + " to " + fty2 + "\n";
                        storeVal = cast;
                    } else if fty2 == "i64" && val.ty.endsWith("*") {
                        var cast = nextTemp(ctx);
                        codeS = codeS + cast + " = ptrtoint " + val.ty + " " + val.val + " to i64\n";
                        storeVal = cast;
                    } else if fty2 == "i64" && val.ty == "i1" {
                        var cast = nextTemp(ctx);
                        codeS = codeS + cast + " = zext i1 " + val.val + " to i64\n";
                        storeVal = cast;
                    } else if fty2.endsWith("*") && val.ty.endsWith("*") {
                        var cast = nextTemp(ctx);
                        codeS = codeS + cast + " = bitcast " + val.ty + " " + val.val + " to " + fty2 + "\n";
                        storeVal = cast;
                    } else {
                        cgSetError(ctx, "struct initializer field type mismatch: " + initF.name);
                    }
                }
                codeS = codeS + gep + " = getelementptr inbounds " + def.llvmName + ", " + def.llvmName + "* " + ptr + ", i32 0, i32 " + idx.toString() + "\n";
                codeS = codeS + "store " + fty2 + " " + storeVal + ", " + fty2 + "* " + gep + "\n";
            } else {
                cgSetError(ctx, "unknown struct initializer field: " + initF.name);
            }
            i = i + 1;
        }
        return GenExprResult { ty: def.llvmName + "*", val: ptr, code: codeS };
    }
    if tuplePayload != null {
        var tupleExpr: TupleExpr = tuplePayload;
        return cgEmitTuple(ctx, tupleExpr);
    }
    if dictPayload != null {
        var dictExpr: DictExpr = dictPayload;
        return cgEmitDict(ctx, dictExpr, cgSourceType(ctx, expr));
    }
    if lambdaPayload != null {
        var lambdaExpr: LambdaExpr = lambdaPayload;
        return cgClosureEmit(ctx, expr, lambdaExpr);
    }
    return cgErrorExprAt(ctx, expr, "unsupported expression node");
}

func genStmt2(ctx: CodegenContext, stmt: Stmt): string {
    var varDeclPayload: VarDeclStmt? = null;
    var constDeclPayload: ConstDeclStmt? = null;
    var exprStmtPayload: ExprStmt? = null;
    var assignPayload: AssignStmt? = null;
    var ifPayload: IfStmt? = null;
    var breakPayload: BreakStmt? = null;
    var continuePayload: ContinueStmt? = null;
    var whilePayload: WhileStmt? = null;
    var loopPayload: LoopStmt? = null;
    var forPayload: ForStmt? = null;
    var returnPayload: ReturnStmt? = null;
    var blockPayload: BlockStmt? = null;
    var matchPayload: MatchStmt? = null;
    match stmt {
        Stmt::VarDecl(payload) => { varDeclPayload = payload; },
        Stmt::ConstDecl(payload) => { constDeclPayload = payload; },
        Stmt::FuncDecl(_) => {},
        Stmt::StructDecl(_) => {},
        Stmt::EnumDecl(_) => {},
        Stmt::Import(_) => {},
        Stmt::If(payload) => { ifPayload = payload; },
        Stmt::Assign(payload) => { assignPayload = payload; },
        Stmt::Return(payload) => { returnPayload = payload; },
        Stmt::Break(payload) => { breakPayload = payload; },
        Stmt::Continue(payload) => { continuePayload = payload; },
        Stmt::While(payload) => { whilePayload = payload; },
        Stmt::For(payload) => { forPayload = payload; },
        Stmt::Loop(payload) => { loopPayload = payload; },
        Stmt::Block(payload) => { blockPayload = payload; },
        Stmt::ExprStmt(payload) => { exprStmtPayload = payload; },
        Stmt::Match(payload) => { matchPayload = payload; },
    }
    if varDeclPayload != null {
        var stmtVD: VarDeclStmt = varDeclPayload;
        if ctx.checkedProgram == null && stmtVD.typeExpr != null && stmtVD.typeTag == "" {
            cgSetError(ctx, "variable TypeExpr requires checker-resolved type metadata");
        }
        var init: GenExprResult = genExprValue(ctx, stmtVD.value);
        var sourceType = cgCanonicalSourceType(stmtVD.typeTag);
        if stmtVD.typeExpr != null { sourceType = cgSourceTypeFromTypeExpr(ctx, stmtVD.typeExpr); }
        if sourceType == "" { sourceType = cgSourceType(ctx, stmtVD.value); }
        var ty = llvmTypeFromTagCtx(ctx, stmtVD.typeTag);
        if stmtVD.typeTag == "" {
            if stmtVD.typeExpr != null { ty = llvmTypeFromTagCtx(ctx, sourceType); }
            else { ty = init.ty; }
        }
        if ctx.checkedProgram != null {
            var maybeNominalBinding = cgBindingForDeclaration(ctx, stmt, stmtVD.name);
            if maybeNominalBinding != null {
                var nominalBinding: CheckedBindingInfo = maybeNominalBinding;
                sourceType = cgCheckedTypeName(ctx, nominalBinding.ty);
                ty = cgCheckedLLVMType(ctx, nominalBinding.ty);
            }
        }
        var code0 = init.code;
        var initSource = cgSourceType(ctx, stmtVD.value);
        var scalarTarget = cgScalarNullableInner(sourceType);
        var storedInit = init;
        if scalarTarget != "" && initSource == scalarTarget {
            storedInit = cgBoxScalar(ctx, scalarTarget, GenExprResult { ty: init.ty, val: init.val, code: "" });
            code0 = code0 + storedInit.code;
        }
        if sourceType == "any" && initSource != "any" && initSource != "" {
            storedInit = cgBoxAny(ctx, initSource, GenExprResult { ty: init.ty, val: init.val, code: "" });
            code0 = code0 + storedInit.code;
        }
        var unionStored = cgUnionPrepare(ctx, sourceType, initSource, GenExprResult { ty: storedInit.ty, val: storedInit.val, code: "" });
        code0 = code0 + unionStored.code;
        storedInit = unionStored;
        if ctx.inGlobalInitializer && cgIsGlobalDeclaration(ctx, stmt, stmtVD.name) {
            return cgEmitGlobalStore(ctx, stmtVD.name, sourceType, GenExprResult { ty: storedInit.ty, val: storedInit.val, code: code0 });
        }
        var ptr = cgFreshLocalPtr(ctx, stmtVD.name);
        // hoist alloca to function entry block
        ctx.funcAllocas = ctx.funcAllocas + ptr + " = alloca " + ty + ", align 8\n";
        var storeVal = storedInit.val;
        var storeTy = storedInit.ty;
        // coerce init value to declared type if mismatch
        if ty.endsWith("*") && storeTy == "i64" {
            var cv = nextTemp(ctx);
            code0 = code0 + cv + " = inttoptr i64 " + storeVal + " to " + ty + "\n";
            storeVal = cv;
        } else if ty == "i64" && storeTy == "i1" {
            var cv = nextTemp(ctx);
            code0 = code0 + cv + " = zext i1 " + storeVal + " to i64\n";
            storeVal = cv;
        } else if ty == "i64" && storeTy.endsWith("*") {
            var cv = nextTemp(ctx);
            code0 = code0 + cv + " = ptrtoint " + storeTy + " " + storeVal + " to i64\n";
            storeVal = cv;
        } else if ty == "i8*" && storeTy == "i64" {
            var cv = nextTemp(ctx);
            code0 = code0 + cv + " = inttoptr i64 " + storeVal + " to i8*\n";
            storeVal = cv;
        }
        code0 = code0 + "store " + ty + " " + storeVal + ", " + ty + "* " + ptr + "\n";
        ctx.locals.set(stmtVD.name, LocalVar { ptr: ptr, ty: ty, sourceType: sourceType });
        return code0;
    }
    if constDeclPayload != null {
        var stmtCD: ConstDeclStmt = constDeclPayload;
        if ctx.checkedProgram == null && stmtCD.typeExpr != null && stmtCD.typeTag == "" {
            cgSetError(ctx, "constant TypeExpr requires checker-resolved type metadata");
        }
        var init2: GenExprResult = genExprValue(ctx, stmtCD.value);
        var sourceType2 = cgCanonicalSourceType(stmtCD.typeTag);
        if stmtCD.typeExpr != null { sourceType2 = cgSourceTypeFromTypeExpr(ctx, stmtCD.typeExpr); }
        if sourceType2 == "" { sourceType2 = cgSourceType(ctx, stmtCD.value); }
        var ty2 = llvmTypeFromTagCtx(ctx, stmtCD.typeTag);
        if stmtCD.typeTag == "" {
            if stmtCD.typeExpr != null { ty2 = llvmTypeFromTagCtx(ctx, sourceType2); }
            else { ty2 = init2.ty; }
        }
        if ctx.checkedProgram != null {
            var maybeNominalBinding = cgBindingForDeclaration(ctx, stmt, stmtCD.name);
            if maybeNominalBinding != null {
                var nominalBinding: CheckedBindingInfo = maybeNominalBinding;
                sourceType2 = cgCheckedTypeName(ctx, nominalBinding.ty);
                ty2 = cgCheckedLLVMType(ctx, nominalBinding.ty);
            }
        }
        if ctx.inGlobalInitializer && cgIsGlobalDeclaration(ctx, stmt, stmtCD.name) {
            return cgEmitGlobalStore(ctx, stmtCD.name, sourceType2, init2);
        }
        var ptr2 = cgFreshLocalPtr(ctx, stmtCD.name);
        var codeC = init2.code;
        // hoist alloca to function entry block
        ctx.funcAllocas = ctx.funcAllocas + ptr2 + " = alloca " + ty2 + ", align 8\n";
        var constValue = init2.val;
        var constStoreTy = init2.ty;
        var constSource = cgSourceType(ctx, stmtCD.value);
        var constScalarTarget = cgScalarNullableInner(sourceType2);
        if constScalarTarget != "" && constSource == constScalarTarget {
            var boxedConst = cgBoxScalar(ctx, constScalarTarget, GenExprResult { ty: init2.ty, val: init2.val, code: "" });
            codeC = codeC + boxedConst.code;
            constValue = boxedConst.val;
            constStoreTy = boxedConst.ty;
        }
        if ty2 == "i64" && constStoreTy == "i1" {
            var constBool = nextTemp(ctx);
            codeC = codeC + constBool + " = zext i1 " + constValue + " to i64\n";
            constValue = constBool;
        } else if ty2 == "i8*" && constStoreTy == "i64" {
            var constString = nextTemp(ctx);
            codeC = codeC + constString + " = inttoptr i64 " + constValue + " to i8*\n";
            constValue = constString;
        }
        codeC = codeC + "store " + ty2 + " " + constValue + ", " + ty2 + "* " + ptr2 + "\n";
        ctx.locals.set(stmtCD.name, LocalVar { ptr: ptr2, ty: ty2, sourceType: sourceType2 });
        return codeC;
    }
    if exprStmtPayload != null {
        var stmtES: ExprStmt = exprStmtPayload;
        var e = stmtES.expr;
        var callOption = cgExprCall(e);
        if callOption != null {
            var callE: CallExpr = callOption;
            var callee = callE.callee;
            var calleeIdentOption = cgExprIdentifier(callee);
            if calleeIdentOption != null {
                var calleeId: IdentExpr = calleeIdentOption;
                var cname = calleeId.name;
                if ctx.checkedProgram != null {
                    var checkedStmtCall = cgFindExprInfo(ctx, e);
                    if checkedStmtCall != null {
                        var checkedStmtCallInfo: CheckedExprInfo = checkedStmtCall;
                        var maybeStmtSymbol = checkedStmtCallInfo.symbol;
                        if maybeStmtSymbol != null {
                            var stmtSymbol: ResolvedSymbol = maybeStmtSymbol;
                            if stmtSymbol.kind == "Builtin" {
                                cname = stmtSymbol.intrinsicId;
                            } else if stmtSymbol.kind != "Function" {
                                return cgErrorExpr(ctx, "statement intrinsic is unresolved: " + cname).code;
                            }
                        } else {
                            return cgErrorExpr(ctx, "statement intrinsic is unresolved: " + cname).code;
                        }
                    } else {
                        return cgErrorExpr(ctx, "checked statement call metadata is missing").code;
                    }
                }
                if cname == "println" || cname == "print" || cname == "eprint" || cname == "eprintln" {
                    var stderr = cname == "eprint" || cname == "eprintln";
                    var newline = cname == "println" || cname == "eprintln";
                    return cgEmitText(ctx, callE, stderr, newline);
                }
                if cname == "exit" {
                    var exitResult: GenExprResult = genExprValue(ctx, e);
                    return exitResult.code + "unreachable\n";
                }
                // writeFile / appendFile / deleteFile / mkdir as statements
                if cname == "writeFile" && callE.args.len() == 2 {
                    var a0: GenExprResult = genExprValue(ctx, callE.args[0]);
                    var a1: GenExprResult = genExprValue(ctx, callE.args[1]);
                    var path = cgAsStringValue(ctx, callE.args[0], a0);
                    var contents = cgAsStringValue(ctx, callE.args[1], a1);
                    return path.code + contents.code + "call void @rey_write_file(i8* " + path.val + ", i8* " + contents.val + ")\n";
                }
                if cname == "appendFile" && callE.args.len() == 2 {
                    var a0: GenExprResult = genExprValue(ctx, callE.args[0]);
                    var a1: GenExprResult = genExprValue(ctx, callE.args[1]);
                    var path = cgAsStringValue(ctx, callE.args[0], a0);
                    var contents = cgAsStringValue(ctx, callE.args[1], a1);
                    return path.code + contents.code + "call void @rey_append_file(i8* " + path.val + ", i8* " + contents.val + ")\n";
                }
                if cname == "deleteFile" && callE.args.len() == 1 {
                    var a0: GenExprResult = genExprValue(ctx, callE.args[0]);
                    var path = cgAsStringValue(ctx, callE.args[0], a0);
                    return path.code + "call void @rey_delete_file(i8* " + path.val + ")\n";
                }
                if cname == "mkdir" && callE.args.len() == 1 {
                    var a0: GenExprResult = genExprValue(ctx, callE.args[0]);
                    var path = cgAsStringValue(ctx, callE.args[0], a0);
                    return path.code + "call void @rey_mkdir(i8* " + path.val + ")\n";
                }
            }
            // method call statements (e.g. vec.push(x), hm.set(k,v)) — route through genExprValue
            var calleeFieldOption = cgExprFieldAccess(callE.callee);
            if calleeFieldOption != null {
                var faES: FieldAccessExpr = calleeFieldOption;
                var method = faES.name;
                // detect void-returning methods and emit call without result capture
                if method == "push" || method == "pop" || method == "set" || method == "delete" {
                    var res: GenExprResult = genExprValue(ctx, e);
                    return res.code;
                }
                if method == "reverse" && callE.args.len() == 0 {
                    var reversed: GenExprResult = genExprValue(ctx, e);
                    var reverseCode = reversed.code;
                    var reverseReceiver = cgExprIdentifier(faES.object);
                    if reverseReceiver != null {
                        var reverseName: IdentExpr = reverseReceiver;
                        if reversed.ty == "i64" {
