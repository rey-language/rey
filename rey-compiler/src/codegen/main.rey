                }
                if method == "startsWith" && argVals.len() == 1 {
                    var t = nextTemp(ctx);
                    codeM = codeM + t + " = call i64 @rey_str_starts_with(i8* " + obj.val + ", i8* " + argVals[0].val + ")\n";
                    return GenExprResult { ty: "i64", val: t, code: codeM };
                }
                if method == "endsWith" && argVals.len() == 1 {
                    var t = nextTemp(ctx);
                    codeM = codeM + t + " = call i64 @rey_str_ends_with(i8* " + obj.val + ", i8* " + argVals[0].val + ")\n";
                    return GenExprResult { ty: "i64", val: t, code: codeM };
                }
                if method == "indexOf" && argVals.len() == 1 {
                    var t = nextTemp(ctx);
                    codeM = codeM + t + " = call i64 @rey_str_index_of(i8* " + obj.val + ", i8* " + argVals[0].val + ")\n";
                    return GenExprResult { ty: "i64", val: t, code: codeM };
                }
                if method == "trim" && argVals.len() == 0 {
