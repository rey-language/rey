// LLVM Codegen for Rey

struct GenExprResult {
    pub ty: String,
    pub val: String,
    pub code: String,
}

struct CStringInfo {
    pub escaped: String,
    pub len: int,
}

struct LocalVar {
    pub ptr: String,
    pub ty: String,
}

struct LoopInfo {
    pub breakLabel: String,
    pub continueLabel: String,
}

struct StructFieldDef {
    pub name: String,
    pub ty: String,
}

struct StructDef {
    pub llvmName: String,
    pub fields: Vec,
}

struct CodegenContext {
    pub moduleName: String,
    pub functions: [String],
    pub strings: [String],
    pub currentFunc: String,
    pub blockId: int,
    pub locals: HashMap,
    pub currentRetTy: String,
    pub loopStack: Vec,
    pub structDefs: HashMap,
    pub enumDefs: HashMap,
    pub funcSigs: HashMap,
    pub structTags: HashMap,
    pub nextStructTag: int,
    pub funcAllocas: String,
}

func ctxNew(name: String) {
    return CodegenContext {
        moduleName: name,
        functions: [],
        strings: [],
        currentFunc: "",
        blockId: 0,
        locals: HashMap.new(),
        currentRetTy: "i32",
        loopStack: Vec.new(),
        structDefs: HashMap.new(),
        enumDefs: HashMap.new(),
        funcSigs: HashMap.new(),
        structTags: HashMap.new(),
        nextStructTag: 8,
        funcAllocas: ""
    };
}

func cgInternString(ctx, s: String): int {
    var i = 0;
    loop {
        if i >= ctx.strings.length() {
            break;
        }
        if ctx.strings[i] == s {
            return i;
        }
        i = i + 1;
    }
    ctx.strings.push(s);
    return ctx.strings.length() - 1;
}

func llvmEscapeByte(c: String): String {
    if c == "\n" { return "\\0A"; }
    if c == "\r" { return "\\0D"; }
    if c == "\t" { return "\\09"; }
    if c == "\"" { return "\\22"; }
    if c == "\\" { return "\\5C"; }
    return c;
}

func llvmCStringInfo(s: String) {
    var out = "";
    var i = 0;
    var n = 0;
    loop {
        if i >= s.len() {
            break;
        }
        var c = s[i];
        out = out + llvmEscapeByte(c);
        n = n + 1;
        i = i + 1;
    }
    // null terminator
    out = out + "\\00";
    n = n + 1;
    return CStringInfo { escaped: out, len: n };
}

func llvmStrGlobalName(idx: int): String {
    return "@.str" + idx.toString();
}

func llvmStrPtr(idx: int, len: int): String {
    return "getelementptr inbounds ([" + len.toString() + " x i8], [" + len.toString() + " x i8]* " + llvmStrGlobalName(idx) + ", i64 0, i64 0)";
}

func nextTemp(ctx): String {
    var n = ctx.blockId;
    ctx.blockId = ctx.blockId + 1;
    return "%t" + n.toString();
}

func nextLabel(ctx, prefix: String): String {
    var n = ctx.blockId;
    ctx.blockId = ctx.blockId + 1;
    return prefix + n.toString();
}

func llvmTypeFromTagCtx(ctx, tag: String): String {
    if tag == "" { return "i64"; }
    if tag == "int" { return "i64"; }
    if tag == "float" { return "double"; }
    if tag == "bool" { return "i64"; }
    if tag == "String" { return "i8*"; }
    if tag == "Void" { return "void"; }
    if ctx.structDefs.has(tag) {
        var def: StructDef = ctx.structDefs.get(tag);
        return def.llvmName + "*";
    }
    if ctx.enumDefs.has(tag) {
        return "i64";
    }
    return "i64";
}

func llvmTypeFromTag(tag: String): String {
    return llvmTypeFromTagCtx(ctxNew("tmp"), tag);
}

func blockEndsWithReturn(block): bool {
    if !(block instanceof BlockStmt) { return false; }
    if block.statements.length() == 0 { return false; }
    var last = block.statements[block.statements.length() - 1];
    return last instanceof ReturnStmt;
}

func stmtIsTerminator(stmt): bool {
    if stmt instanceof ReturnStmt { return true; }
    if stmt instanceof BreakStmt { return true; }
    if stmt instanceof ContinueStmt { return true; }
    return false;
}

func blockEndsWithTerminator(block): bool {
    if !(block instanceof BlockStmt) { return false; }
    if block.statements.length() == 0 { return false; }
    var last = block.statements[block.statements.length() - 1];
    return stmtIsTerminator(last);
}

func genExprValue(ctx, expr) {
    if expr instanceof LiteralExpr {
        var litE: LiteralExpr = expr;
        // kStr: Rust interpreter returns "LiteralKind::String"; native IR returns "0"/"2"/"3"/"4"/"5"
        // (LiteralKind enum: String=0,Char=1,Int=2,Float=3,Bool=4,Null=5)
        var kStr = litE.kind.toString();
        if kStr == "LiteralKind::String" || kStr == "0" {
            // intern the raw bytes as a global constant, then wrap in a ReyStr via rey_str_new
            var idx = cgInternString(ctx, litE.text);
            var info: CStringInfo = llvmCStringInfo(litE.text);
            var rawPtr = llvmStrPtr(idx, info.len);
            var slen = info.len - 1;  // exclude null terminator from ReyStr.len
            var tmp = nextTemp(ctx);
            var code0 = tmp + " = call i8* @rey_str_new(i8* " + rawPtr + ", i64 " + slen.toString() + ")\n";
            return GenExprResult { ty: "i8*", val: tmp, code: code0 };
        }
        if kStr == "LiteralKind::Int" || kStr == "2" {
            return GenExprResult { ty: "i64", val: litE.text, code: "" };
        }
        if kStr == "LiteralKind::Float" || kStr == "3" {
            return GenExprResult { ty: "double", val: litE.text, code: "" };
        }
        if kStr == "LiteralKind::Bool" || kStr == "4" {
            if litE.text == "true" { return GenExprResult { ty: "i1", val: "1", code: "" }; }
            return GenExprResult { ty: "i1", val: "0", code: "" };
        }
    }
    if expr instanceof IdentExpr {
        if ctx.locals.has(expr.name) {
            var local: LocalVar = ctx.locals.get(expr.name);
            var tmp = nextTemp(ctx);
            var code = tmp + " = load " + local.ty + ", " + local.ty + "* " + local.ptr + "\n";
            return GenExprResult { ty: local.ty, val: tmp, code: code };
        }
        return GenExprResult { ty: "i64", val: "%" + expr.name, code: "" };
    }
    if expr instanceof FieldAccessExpr {
        var obj: GenExprResult = genExprValue(ctx, expr.object);
        var codeF = obj.code;

        if expr.object instanceof IdentExpr {
            var enumName = expr.object.name;
            if ctx.enumDefs.has(enumName) {
                var variants = ctx.enumDefs.get(enumName);
                var i0 = 0;
                loop {
                    if i0 >= variants.length() { break; }
                    if variants[i0] == expr.name {
                        return GenExprResult { ty: "i64", val: i0.toString(), code: codeF };
                    }
                    i0 = i0 + 1;
                }
            }
        }

        var keys = ctx.structDefs.keys();
        var sname = "";
        var i = 0;
        loop {
            if i >= keys.len() { break; }
            var k = keys.get(i);
            var def: StructDef = ctx.structDefs.get(k);
            if obj.ty == def.llvmName + "*" {
                sname = k;
                break;
            }
            i = i + 1;
        }
        if sname == "" && obj.ty == "i64" {
            // struct passed as opaque i64 — find struct by field name heuristic
            // prefer simple-typed fields (i8*, i64) over struct-pointer fields to avoid false matches
            var snameSimple = "";
            var snameStruct = "";
            var ki = 0;
            loop {
                if ki >= keys.len() { break; }
                var kk = keys.get(ki);
                var deftmp: StructDef = ctx.structDefs.get(kk);
                var flds = deftmp.fields;
                var fi = 0;
                loop {
                    if fi >= flds.length() { break; }
                    var fldItem: StructFieldDef = flds[fi];
                    if fldItem.name == expr.name {
                        var fty0 = fldItem.ty;
                        if fty0 == "i8*" || fty0 == "i64" || fty0 == "i1" {
                            if snameSimple == "" { snameSimple = kk; }
                        } else {
                            if snameStruct == "" { snameStruct = kk; }
                        }
                        break;
                    }
                    fi = fi + 1;
                }
                ki = ki + 1;
            }
            if snameStruct != "" {
                sname = snameStruct;
            } else {
                sname = snameSimple;
            }
            if sname != "" {
                // cast i64 → struct pointer before GEP
                var castTmp = nextTemp(ctx);
                var defForCast: StructDef = ctx.structDefs.get(sname);
                codeF = codeF + castTmp + " = inttoptr i64 " + obj.val + " to " + defForCast.llvmName + "*\n";
                obj = GenExprResult { ty: defForCast.llvmName + "*", val: castTmp, code: codeF };
            }
        }
        if sname == "" {
            return GenExprResult { ty: "i64", val: "0", code: codeF };
        }
        var def2: StructDef = ctx.structDefs.get(sname);
        var fields = def2.fields;
        var idx = -1;
        i = 0;
        loop {
            if i >= fields.length() { break; }
            var fi2: StructFieldDef = fields[i];
            if fi2.name == expr.name {
                idx = i;
                break;
            }
            i = i + 1;
        }
        if idx < 0 {
            return GenExprResult { ty: "i64", val: "0", code: codeF };
        }
        var gep = nextTemp(ctx);
        var fldIdx: StructFieldDef = fields[idx];
        var fieldTy = fldIdx.ty;
        codeF = codeF + gep + " = getelementptr inbounds " + def2.llvmName + ", " + def2.llvmName + "* " + obj.val + ", i32 0, i32 " + idx.toString() + "\n";
        var tmp2 = nextTemp(ctx);
        codeF = codeF + tmp2 + " = load " + fieldTy + ", " + fieldTy + "* " + gep + "\n";
        return GenExprResult { ty: fieldTy, val: tmp2, code: codeF };
    }
    if expr instanceof BinaryExpr {
        // instanceof operator — handled before evaluating operands
        if expr.op == "instanceof" {
            // left: the object; right: an IdentExpr naming the type
            var lo: GenExprResult = genExprValue(ctx, expr.left);
            var typeName = "";
            if expr.right instanceof IdentExpr { typeName = expr.right.name; }
            var code0 = lo.code;
            // coerce pointer to i64 if needed (typed vars load as %struct.X*)
            var loVal = lo.val;
            if lo.ty.endsWith("*") {
                var tpi = nextTemp(ctx);
                code0 = code0 + tpi + " = ptrtoint " + lo.ty + " " + lo.val + " to i64\n";
                loVal = tpi;
            }
            // well-known tagged heap types via rey_instanceof_tag
            var tagId = -1;
            if typeName == "Vec"    { tagId = 2; }
            if typeName == "HashMap" { tagId = 3; }
            if typeName == "Result" { tagId = 4; }  // Ok counts; Err is 5
            if typeName == "Option" { tagId = 6; }
            // Result.Ok / Result.Err as separate enum variants
            if typeName == "Ok"     { tagId = 4; }
            if typeName == "Err"    { tagId = 5; }
            if typeName == "Some"   { tagId = 6; }
            if typeName == "None"   { tagId = 7; }
            if tagId >= 0 {
                var t0 = nextTemp(ctx);
                code0 = code0 + t0 + " = call i64 @rey_instanceof_tag(i64 " + loVal + ", i64 " + tagId.toString() + ")\n";
                var t1 = nextTemp(ctx);
                code0 = code0 + t1 + " = icmp ne i64 " + t0 + ", 0\n";
                return GenExprResult { ty: "i1", val: t1, code: code0 };
            }
            // user struct: tag is 16 bytes before data ptr, use rey_struct_instanceof
            if ctx.structTags.has(typeName) {
                var stTagId = ctx.structTags.get(typeName);
                var t0s = nextTemp(ctx);
                code0 = code0 + t0s + " = call i64 @rey_struct_instanceof(i64 " + loVal + ", i64 " + stTagId.toString() + ")\n";
                var t1s = nextTemp(ctx);
                code0 = code0 + t1s + " = icmp ne i64 " + t0s + ", 0\n";
                return GenExprResult { ty: "i1", val: t1s, code: code0 };
            }
            // unknown type — fallback true
            return GenExprResult { ty: "i1", val: "1", code: code0 };
        }

        var l: GenExprResult = genExprValue(ctx, expr.left);
        var r: GenExprResult = genExprValue(ctx, expr.right);
        var code = l.code + r.code;
        var isStrOp = (l.ty == "i8*" || r.ty == "i8*");

        if expr.op == "+" {
            if isStrOp {
                var tmp = nextTemp(ctx);
                // coerce integer to string if needed
                var lv = l.val;
                var rv = r.val;
                if l.ty != "i8*" {
                    var lt = nextTemp(ctx);
                    var lcast = l.val;
                    if l.ty.endsWith("*") {
                        var lp = nextTemp(ctx);
                        code = code + lp + " = ptrtoint " + l.ty + " " + l.val + " to i64\n";
                        lcast = lp;
                    }
                    code = code + lt + " = call i8* @rey_val_to_str(i64 " + lcast + ")\n";
                    lv = lt;
                }
                if r.ty != "i8*" {
                    var rt = nextTemp(ctx);
                    var rcast = r.val;
                    if r.ty.endsWith("*") {
                        var rp = nextTemp(ctx);
                        code = code + rp + " = ptrtoint " + r.ty + " " + r.val + " to i64\n";
                        rcast = rp;
                    }
                    code = code + rt + " = call i8* @rey_val_to_str(i64 " + rcast + ")\n";
                    rv = rt;
                }
                code = code + tmp + " = call i8* @rey_str_concat(i8* " + lv + ", i8* " + rv + ")\n";
                return GenExprResult { ty: "i8*", val: tmp, code: code };
            }
            var tmp2 = nextTemp(ctx);
            code = code + tmp2 + " = add i64 " + l.val + ", " + r.val + "\n";
            return GenExprResult { ty: "i64", val: tmp2, code: code };
        }
        if expr.op == "-" || expr.op == "*" || expr.op == "/" || expr.op == "%" {
            var tmp3 = nextTemp(ctx);
            var inst = "sub";
            if expr.op == "*" { inst = "mul"; }
            if expr.op == "/" { inst = "sdiv"; }
            if expr.op == "%" { inst = "srem"; }
            code = code + tmp3 + " = " + inst + " i64 " + l.val + ", " + r.val + "\n";
            return GenExprResult { ty: "i64", val: tmp3, code: code };
        }
        if expr.op == "==" || expr.op == "!=" {
            if isStrOp {
                var lv3 = l.val;
                var rv3 = r.val;
                if l.ty != "i8*" {
                    var lt3 = nextTemp(ctx);
                    if l.ty.endsWith("*") {
                        code = code + lt3 + " = bitcast " + l.ty + " " + l.val + " to i8*\n";
                    } else {
                        code = code + lt3 + " = inttoptr i64 " + l.val + " to i8*\n";
                    }
                    lv3 = lt3;
                }
                if r.ty != "i8*" {
                    var rt3 = nextTemp(ctx);
                    if r.ty.endsWith("*") {
                        code = code + rt3 + " = bitcast " + r.ty + " " + r.val + " to i8*\n";
                    } else {
                        code = code + rt3 + " = inttoptr i64 " + r.val + " to i8*\n";
                    }
                    rv3 = rt3;
                }
                var eq = nextTemp(ctx);
                code = code + eq + " = call i64 @rey_str_eq(i8* " + lv3 + ", i8* " + rv3 + ")\n";
                var b = nextTemp(ctx);
                if expr.op == "==" {
                    code = code + b + " = icmp ne i64 " + eq + ", 0\n";
                } else {
                    code = code + b + " = icmp eq i64 " + eq + ", 0\n";
                }
                return GenExprResult { ty: "i1", val: b, code: code };
            }
            var pred = "eq";
            if expr.op == "!=" { pred = "ne"; }
            var lv4 = l.val;
            var rv4 = r.val;
            if l.ty.endsWith("*") {
                var lp4 = nextTemp(ctx);
                code = code + lp4 + " = ptrtoint " + l.ty + " " + l.val + " to i64\n";
                lv4 = lp4;
            }
            if r.ty.endsWith("*") {
                var rp4 = nextTemp(ctx);
                code = code + rp4 + " = ptrtoint " + r.ty + " " + r.val + " to i64\n";
                rv4 = rp4;
            }
            var tmp4 = nextTemp(ctx);
            code = code + tmp4 + " = icmp " + pred + " i64 " + lv4 + ", " + rv4 + "\n";
            return GenExprResult { ty: "i1", val: tmp4, code: code };
        }
        if expr.op == "<" || expr.op == ">" || expr.op == "<=" || expr.op == ">=" {
            var pred2 = "slt";
            if expr.op == ">" { pred2 = "sgt"; }
            if expr.op == "<=" { pred2 = "sle"; }
            if expr.op == ">=" { pred2 = "sge"; }
            var tmp5 = nextTemp(ctx);
            if l.ty == "i8*" {
                // string comparison via strcmp
                var cmpTmp = nextTemp(ctx);
                code = code + cmpTmp + " = call i32 @strcmp(i8* " + l.val + ", i8* " + r.val + ")\n";
                code = code + tmp5 + " = icmp " + pred2 + " i32 " + cmpTmp + ", 0\n";
            } else {
                var lv5 = l.val;
                var rv5 = r.val;
                if l.ty.endsWith("*") {
                    var lp5 = nextTemp(ctx);
                    code = code + lp5 + " = ptrtoint " + l.ty + " " + l.val + " to i64\n";
                    lv5 = lp5;
                }
                if r.ty.endsWith("*") {
                    var rp5 = nextTemp(ctx);
                    code = code + rp5 + " = ptrtoint " + r.ty + " " + r.val + " to i64\n";
                    rv5 = rp5;
                }
                code = code + tmp5 + " = icmp " + pred2 + " i64 " + lv5 + ", " + rv5 + "\n";
            }
            return GenExprResult { ty: "i1", val: tmp5, code: code };
        }
        if expr.op == "&&" || expr.op == "||" {
            var lc = l.val;
            var rc = r.val;
            if l.ty == "i64" {
                var lt2 = nextTemp(ctx);
                code = code + lt2 + " = icmp ne i64 " + l.val + ", 0\n";
                lc = lt2;
            }
            if r.ty == "i64" {
                var rt2 = nextTemp(ctx);
                code = code + rt2 + " = icmp ne i64 " + r.val + ", 0\n";
                rc = rt2;
            }
            var tmp6 = nextTemp(ctx);
            var inst2 = "and";
            if expr.op == "||" { inst2 = "or"; }
            code = code + tmp6 + " = " + inst2 + " i1 " + lc + ", " + rc + "\n";
            return GenExprResult { ty: "i1", val: tmp6, code: code };
        }
    }
    if expr instanceof UnaryExpr {
        var rvU: GenExprResult = genExprValue(ctx, expr.right);
        var code2 = rvU.code;
        if expr.op == "!" {
            var boolVal = rvU.val;
            if rvU.ty == "i64" {
                var trunc4 = nextTemp(ctx);
                code2 = code2 + trunc4 + " = trunc i64 " + rvU.val + " to i1\n";
                boolVal = trunc4;
            }
            var tmp4 = nextTemp(ctx);
            code2 = code2 + tmp4 + " = xor i1 " + boolVal + ", true\n";
            return GenExprResult { ty: "i1", val: tmp4, code: code2 };
        }
        if expr.op == "-" {
            var tmp5 = nextTemp(ctx);
            code2 = code2 + tmp5 + " = sub i64 0, " + rvU.val + "\n";
            return GenExprResult { ty: "i64", val: tmp5, code: code2 };
        }
    }
    if expr instanceof CallExpr {
        if expr.callee instanceof IdentExpr {
            var name = expr.callee.name;
            // builtin constructors
            if name == "Vec.new"    { var t = nextTemp(ctx); return GenExprResult { ty: "i64", val: t, code: t + " = call i64 @rey_vec_new()\n" }; }
            if name == "HashMap.new" { var t = nextTemp(ctx); return GenExprResult { ty: "i64", val: t, code: t + " = call i64 @rey_hm_new()\n" }; }
            // Result/Option constructors
            if name == "Result.Ok" || name == "Ok" {
                if expr.args.length() == 1 {
                    var av: GenExprResult = genExprValue(ctx, expr.args[0]);
                    var t = nextTemp(ctx);
                    if av.ty == "i8*" {
                        return GenExprResult { ty: "i64", val: t, code: av.code + t + " = call i64 @rey_ok_str(i8* " + av.val + ")\n" };
                    }
                    var avVal = av.val;
                    var avCode = av.code;
                    if av.ty.endsWith("*") && av.ty != "i8*" {
                        var cast = nextTemp(ctx);
                        avCode = avCode + cast + " = ptrtoint " + av.ty + " " + av.val + " to i64\n";
                        avVal = cast;
                    }
                    return GenExprResult { ty: "i64", val: t, code: avCode + t + " = call i64 @rey_ok(i64 " + avVal + ")\n" };
                }
            }
            if name == "Result.Err" || name == "Err" {
                if expr.args.length() == 1 {
                    var av: GenExprResult = genExprValue(ctx, expr.args[0]);
                    var t = nextTemp(ctx);
                    if av.ty == "i8*" {
                        return GenExprResult { ty: "i64", val: t, code: av.code + t + " = call i64 @rey_err_str(i8* " + av.val + ")\n" };
                    }
                    var avVal2 = av.val;
                    var avCode2 = av.code;
                    if av.ty.endsWith("*") && av.ty != "i8*" {
                        var cast2 = nextTemp(ctx);
                        avCode2 = avCode2 + cast2 + " = ptrtoint " + av.ty + " " + av.val + " to i64\n";
                        avVal2 = cast2;
                    }
                    return GenExprResult { ty: "i64", val: t, code: avCode2 + t + " = call i64 @rey_err(i64 " + avVal2 + ")\n" };
                }
            }
            if name == "Option.Some" || name == "Some" {
                if expr.args.length() == 1 {
                    var av: GenExprResult = genExprValue(ctx, expr.args[0]);
                    var t = nextTemp(ctx);
                    return GenExprResult { ty: "i64", val: t, code: av.code + t + " = call i64 @rey_some(i64 " + av.val + ")\n" };
                }
            }
            if name == "Option.None" || name == "None" {
                var t = nextTemp(ctx);
                return GenExprResult { ty: "i64", val: t, code: t + " = call i64 @rey_none()\n" };
            }
            // builtins: readFile, writeFile, fileExists, etc.
            if name == "readFile" && expr.args.length() == 1 {
                var av: GenExprResult = genExprValue(ctx, expr.args[0]);
                var t = nextTemp(ctx);
                var ap = av.val; if av.ty != "i8*" { ap = "null"; }
                return GenExprResult { ty: "i8*", val: t, code: av.code + t + " = call i8* @rey_read_file(i8* " + ap + ")\n" };
            }
            if name == "writeFile" && expr.args.length() == 2 {
                var a0 = genExprValue(ctx, expr.args[0]);
                var a1 = genExprValue(ctx, expr.args[1]);
                var t = nextTemp(ctx);
                return GenExprResult { ty: "i64", val: t, code: a0.code + a1.code + "call void @rey_write_file(i8* " + a0.val + ", i8* " + a1.val + ")\n" + t + " = add i64 0, 0\n" };
            }
            if name == "appendFile" && expr.args.length() == 2 {
                var a0 = genExprValue(ctx, expr.args[0]);
                var a1 = genExprValue(ctx, expr.args[1]);
                var t = nextTemp(ctx);
                return GenExprResult { ty: "i64", val: t, code: a0.code + a1.code + "call void @rey_append_file(i8* " + a0.val + ", i8* " + a1.val + ")\n" + t + " = add i64 0, 0\n" };
            }
            if name == "fileExists" && expr.args.length() == 1 {
                var av: GenExprResult = genExprValue(ctx, expr.args[0]);
                var t = nextTemp(ctx);
