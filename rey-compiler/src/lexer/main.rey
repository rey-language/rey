// NOTE: this is duplicated from `lexer/token.rey` so `import lexer;` works without generics/extra imports.
// bootstrap compiler is intentionally messy right now.

enum TokenKind {
    Identifier,
    StringLiteral,
    CharLiteral,
    NumberLiteral,

    // keywords
    Var,
    Const,
    Func,
    Struct,
    Enum,
    Import,
    Export,
    Pub,
    Return,
    If,
    Else,
    While,
    For,
    In,
    Break,
    Continue,
    Match,
    InstanceOf,
    True,
    False,
    Null,

    // punctuation/operators
    LeftParen,
    RightParen,
    LeftBrace,
    RightBrace,
    LeftBracket,
    RightBracket,
    Comma,
    Dot,
    Semicolon,
    Colon,
    ColonColon,
    Arrow,
    Equal,
    EqualEqual,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    Plus,
    PlusPlus,
    PlusEqual,
    Minus,
    MinusMinus,
    MinusEqual,
    Star,
    StarEqual,
    Slash,
    SlashEqual,
    Percent,
    PercentEqual,
    AndAnd,
    OrOr,
    Not,
    Question,

    Eof,
}

struct Span {
    pub start: int,
    pub end: int,
    pub line: int,
    pub column: int,
}

struct Token {
    pub kind: String,
    pub lexeme: String,
    pub span: Span,
}

enum LexErrorKind {
    UnexpectedCharacter,
    UnterminatedString,
    UnterminatedChar,
    InvalidNumber,
}

struct LexError {
    pub kind: String,
    pub message: String,
    pub span: Span,
}

struct Lexer {
    pub source: String,
    pub pos: int,
    pub start: int,
    pub line: int,
    pub column: int,
    pub tokens: [Token],
    pub errors: [LexError],
}

struct LexerResult {
    pub tokens: [Token],
    pub errors: [LexError],
}

func isAlpha(c: String): bool {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_";
}

func isDigit(c: String): bool {
    return c >= "0" && c <= "9";
}

func isAlphaNumeric(c: String): bool {
    return isAlpha(c) || isDigit(c);
}

func isWhitespace(c: String): bool {
    return c == " " || c == "\n" || c == "\t" || c == "\r";
}

func isPunctuation(c: String): bool {
    return c == "(" || c == ")" || c == "{" || c == "}" || c == "[" || c == "]" || 
           c == "," || c == "." || c == ";" || c == ":" || c == "+" || c == "-" ||
           c == "*" || c == "/" || c == "%" || c == "^" || c == "&" || c == "|" ||
           c == "!" || c == "=" || c == "<" || c == ">" || c == "?";
}

func newSpan(start: int, end: int, line: int, column: int) {
    return Span { start: start, end: end, line: line, column: column };
}

func makeToken(kind, lexeme: String, span) {
    return Token { kind: kind, lexeme: lexeme, span: span };
}

func makeError(kind, message: String, span) {
    return LexError { kind: kind, message: message, span: span };
}

func addToken(lexer: Lexer, kind: String, lexeme: String) {
    var span = newSpan(lexer.start, lexer.pos, lexer.line, lexer.column);
    var token = makeToken(kind, lexeme, span);
    lexer.tokens.push(token);
}

func addError(lexer: Lexer, kind: String, message: String) {
    var span = newSpan(lexer.pos, lexer.pos + 1, lexer.line, lexer.column);
    var error = makeError(kind, message, span);
    lexer.errors.push(error);
}

func lexAdvance(lexer: Lexer): String {
    if lexer.pos >= lexer.source.len() {
        return "";
    }
    var c = lexer.source[lexer.pos];
    lexer.pos = lexer.pos + 1;
    if c == "\n" {
        lexer.line = lexer.line + 1;
        lexer.column = 0;
    } else {
        lexer.column = lexer.column + 1;
    }
    return c;
}

func lexPeek(lexer: Lexer): String {
    if lexer.pos >= lexer.source.len() {
        return "";
    }
    return lexer.source[lexer.pos];
}

func lexPeekNext(lexer: Lexer): String {
    if lexer.pos + 1 >= lexer.source.len() {
        return "";
    }
    return lexer.source[lexer.pos + 1];
}

func lexMatchChar(lexer: Lexer, expected: String): bool {
    if lexer.pos >= lexer.source.len() {
        return false;
    }
    if lexer.source[lexer.pos] != expected {
        return false;
    }
    lexer.pos = lexer.pos + 1;
    lexer.column = lexer.column + 1;
    return true;
}

func skipWhitespace(lexer: Lexer) {
    loop {
        if lexer.pos >= lexer.source.len() {
            break;
        }
        var c = lexPeek(lexer);
        if c == " " || c == "\t" || c == "\r" {
            lexAdvance(lexer);
        } else if c == "\n" {
            lexAdvance(lexer);
            lexer.line = lexer.line + 1;
            lexer.column = 0;
        } else if c == "/" {
            var next = lexPeekNext(lexer);
            if next == "/" {
                loop {
                    if lexer.pos >= lexer.source.len() {
                        break;
                    }
                    if lexPeek(lexer) == "\n" {
                        break;
                    }
                    lexAdvance(lexer);
                }
            } else if next == "*" {
                lexAdvance(lexer);
                lexAdvance(lexer);
                loop {
                    if lexer.pos >= lexer.source.len() {
                        addError(lexer, "UnexpectedCharacter", "Unterminated block comment");
                        break;
                    }
                    if lexPeek(lexer) == "*" && lexPeekNext(lexer) == "/" {
                        lexAdvance(lexer);
                        lexAdvance(lexer);
                        break;
                    }
                    lexAdvance(lexer);
                }
            } else {
                break;
            }
        } else {
            break;
        }
    }
}

func scanString(lexer: Lexer): String {
    var result = "";
    loop {
        if lexer.pos >= lexer.source.len() {
            addError(lexer, "UnterminatedString", "Unterminated string literal");
            break;
        }
        var c = lexAdvance(lexer);
        if c == "\"" {
            break;
        }
        if c == "\\" {
            var next = lexPeek(lexer);
            if next == "n" {
                result = result + "\n";
                lexAdvance(lexer);
            } else if next == "t" {
                result = result + "\t";
                lexAdvance(lexer);
            } else if next == "r" {
                result = result + "\r";
                lexAdvance(lexer);
            } else if next == "\\" {
                result = result + "\\";
                lexAdvance(lexer);
            } else if next == "\"" {
                result = result + "\"";
                lexAdvance(lexer);
            } else {
                result = result + next;
                lexAdvance(lexer);
            }
        } else {
            result = result + c;
        }
    }
    return result;
}

func scanChar(lexer: Lexer): String {
    var result = "";
    loop {
        if lexer.pos >= lexer.source.len() {
            addError(lexer, "UnterminatedChar", "Unterminated char literal");
            break;
        }
        var c = lexAdvance(lexer);
        if c == "'" {
            break;
        }
        if c == "\\" {
            var next = lexPeek(lexer);
            if next == "n" {
                result = result + "\n";
                lexAdvance(lexer);
            } else if next == "t" {
                result = result + "\t";
                lexAdvance(lexer);
            } else if next == "\\" {
                result = result + "\\";
                lexAdvance(lexer);
            } else if next == "'" {
                result = result + "'";
                lexAdvance(lexer);
            }
        } else {
            result = result + c;
        }
    }
    return result;
}

func scanNumber(lexer: Lexer): String {
    var result = "";
    var hasDot = false;
    loop {
        if lexer.pos >= lexer.source.len() {
            break;
        }
        var c = lexPeek(lexer);
        if c == "." {
            var next = lexPeekNext(lexer);
            if isDigit(next) && !hasDot {
                result = result + c;
                lexAdvance(lexer);
                hasDot = true;
            } else {
                break;
            }
        } else if isDigit(c) {
            result = result + c;
            lexAdvance(lexer);
        } else if c == "e" || c == "E" {
            result = result + c;
            lexAdvance(lexer);
            var next = lexPeek(lexer);
            if next == "+" || next == "-" {
                result = result + next;
                lexAdvance(lexer);
            }
        } else {
            break;
        }
    }
    return result;
}

func scanIdentifier(lexer: Lexer): String {
    var result = "";
    loop {
        if lexer.pos >= lexer.source.len() {
            break;
        }
        var c = lexPeek(lexer);
        if isAlphaNumeric(c) {
            result = result + c;
            lexAdvance(lexer);
        } else {
            break;
        }
    }
    return result;
}

func getKeyword(kind: String) {
    if kind == "var" { return "Var"; }
    if kind == "const" { return "Const"; }
    if kind == "func" { return "Func"; }
    if kind == "struct" { return "Struct"; }
    if kind == "enum" { return "Enum"; }
    if kind == "import" { return "Import"; }
    if kind == "export" { return "Export"; }
    if kind == "pub" { return "Pub"; }
    if kind == "return" { return "Return"; }
    if kind == "if" { return "If"; }
    if kind == "else" { return "Else"; }
    if kind == "while" { return "While"; }
    if kind == "for" { return "For"; }
    if kind == "in" { return "In"; }
    if kind == "loop" { return "Loop"; }
    if kind == "break" { return "Break"; }
    if kind == "continue" { return "Continue"; }
    if kind == "match" { return "Match"; }
    if kind == "instanceof" { return "InstanceOf"; }
    if kind == "true" { return "True"; }
    if kind == "false" { return "False"; }
    if kind == "null" { return "Null"; }
    return "Identifier";
}

func scanToken(lexer: Lexer) {
    lexer.start = lexer.pos;
    var c = lexAdvance(lexer);
    
    if c == "" {
        addToken(lexer, "Eof", "");
        return null;
    }
    
    if isWhitespace(c) {
        return null;
    }
    
    if c == "(" { addToken(lexer, "LeftParen", "("); return null; }
    if c == ")" { addToken(lexer, "RightParen", ")"); return null; }
    if c == "{" { addToken(lexer, "LeftBrace", "{"); return null; }
    if c == "}" { addToken(lexer, "RightBrace", "}"); return null; }
    if c == "[" { addToken(lexer, "LeftBracket", "["); return null; }
    if c == "]" { addToken(lexer, "RightBracket", "]"); return null; }
    if c == "," { addToken(lexer, "Comma", ","); return null; }
    if c == "." { addToken(lexer, "Dot", "."); return null; }
    if c == ";" { addToken(lexer, "Semicolon", ";"); return null; }
    if c == "+" { 
        if lexMatchChar(lexer, "+") { addToken(lexer, "PlusPlus", "++"); return null; }
        if lexMatchChar(lexer, "=") { addToken(lexer, "PlusEqual", "+="); return null; }
        addToken(lexer, "Plus", "+"); return null; 
    }
    if c == "-" {
        if lexMatchChar(lexer, "-") { addToken(lexer, "MinusMinus", "--"); return null; }
        if lexMatchChar(lexer, "=") { addToken(lexer, "MinusEqual", "-="); return null; }
        if lexMatchChar(lexer, ">") { addToken(lexer, "Arrow", "->"); return null; }
        addToken(lexer, "Minus", "-"); return null;
    }
    if c == "*" {
        if lexMatchChar(lexer, "=") { addToken(lexer, "StarEqual", "*="); return null; }
        addToken(lexer, "Star", "*"); return null;
    }
    if c == "/" {
        if lexMatchChar(lexer, "=") { addToken(lexer, "SlashEqual", "/="); return null; }
        addToken(lexer, "Slash", "/"); return null;
    }
    if c == "%" {
        if lexMatchChar(lexer, "=") { addToken(lexer, "PercentEqual", "%="); return null; }
        addToken(lexer, "Percent", "%"); return null;
    }
    if c == "=" {
        if lexMatchChar(lexer, "=") { addToken(lexer, "EqualEqual", "=="); return null; }
        addToken(lexer, "Equal", "="); return null;
    }
    if c == "!" {
        if lexMatchChar(lexer, "=") { addToken(lexer, "NotEqual", "!="); return null; }
        addToken(lexer, "Not", "!"); return null;
    }
    if c == "<" {
        if lexMatchChar(lexer, "=") { addToken(lexer, "LessEqual", "<="); return null; }
        addToken(lexer, "Less", "<"); return null;
    }
    if c == ">" {
        if lexMatchChar(lexer, "=") { addToken(lexer, "GreaterEqual", ">="); return null; }
        addToken(lexer, "Greater", ">"); return null;
    }
    if c == ":" {
        if lexMatchChar(lexer, ":") { addToken(lexer, "ColonColon", "::"); return null; }
        addToken(lexer, "Colon", ":"); return null;
    }
    if c == "?" { addToken(lexer, "Question", "?"); return null; }
    if c == "&" {
        if lexMatchChar(lexer, "&") { addToken(lexer, "AndAnd", "&&"); return null; }
        addToken(lexer, "Identifier", "&"); return null;
    }
    if c == "|" {
        if lexMatchChar(lexer, "|") { addToken(lexer, "OrOr", "||"); return null; }
        addToken(lexer, "Identifier", "|"); return null;
    }
    
    if c == "\"" {
        var str = scanString(lexer);
        addToken(lexer, "StringLiteral", str);
        return null;
    }
    
    if c == "'" {
        var ch = scanChar(lexer);
        addToken(lexer, "CharLiteral", ch);
        return null;
    }
    
    if isDigit(c) {
        lexer.pos = lexer.pos - 1;
        lexer.column = lexer.column - 1;
        var num = scanNumber(lexer);
        addToken(lexer, "NumberLiteral", num);
        return null;
    }
    
    if isAlpha(c) {
        lexer.pos = lexer.pos - 1;
        lexer.column = lexer.column - 1;
        var ident = scanIdentifier(lexer);
        var kind = getKeyword(ident);
        addToken(lexer, kind, ident);
        return null;
    }
    
    addError(lexer, "UnexpectedCharacter", "Unexpected character: " + c);
}

export pub func newLexer(source: String): Lexer {
    return Lexer {
        source: source,
        pos: 0,
        start: 0,
        line: 1,
        column: 0,
        tokens: [],
        errors: []
    };
}

export pub func tokenize(source: String, path: String): LexerResult {
    var lexer = newLexer(source);
    
    loop {
        if lexer.pos >= lexer.source.len() {
            break;
        }
        skipWhitespace(lexer);
        if lexer.pos >= lexer.source.len() {
            break;
        }
        var c = lexPeek(lexer);
        if c == "" {
            break;
        }
        if c == "\n" {
            lexAdvance(lexer);
            lexer.line = lexer.line + 1;
            lexer.column = 0;
            continue;
        }
        scanToken(lexer);
    }
    
    addToken(lexer, "Eof", "");
    
    return LexerResult {
        tokens: lexer.tokens,
        errors: lexer.errors
    };
}
