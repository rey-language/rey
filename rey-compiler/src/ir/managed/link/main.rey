import ir::{IRProgram, IRFunction, IRValue, IRType, IRTypeKind, BasicBlock, Instruction, InstructionKind, Terminator, SourceRef, EffectSummary, Escape};
import ir;
import ir::managed::{ManagedProgram, ManagedLayout, ManagedField, ManagedFunction, ManagedAllocation, ManagedDerived, ManagedVariableLayout, ManagedHook};
import ir::managed::roots::{RuntimeBindings, ManagedHookBinding, lowerManagedRoots};
import ir::managed::regions::{RegionBindings, RegionHookBinding, lowerManagedRegionsCompleted, lowerManagedRegionsWithPromotionStress};
import ir::managed::completion::{completeManagedMemory, experimentalEscapeSummaryEnabled};
import ir::managed::scalar::{applyScalarReplacementForCompilerFast};
import ir::managed::placement::{ManagedStorage, ManagedPlacement, ManagedAllocationPlacement, ManagedCallPlacement, planManagedPlacement};
import ir::lower::{lowerProgram, lowerManagedProgram, getLowerTargetOS};
import ir::verify::{verifyProgram};
import frontend::graph::{EmbeddedSource, canonicalSourcePath, checkSourceFileGraphWithEmbedded};
