pub struct LinkedManagedProgram {
    pub module: ManagedProgram,
    pub bindings: RuntimeBindings,
}

pub func findManagedRuntimeRoot(explicitRoot: string, executable: string): string {
    if explicitRoot != "" { return canonicalSourcePath(explicitRoot); }
    var directory = ".";
    var index = executable.len() - 1;
    while index >= 0 {
        if executable.slice(index, index + 1) == "/" {
            directory = executable.slice(0, index);
            if directory == "" { directory = "/"; }
            break;
        }
        index -= 1;
    }
    var candidates: Vec<string> = ["runtime-rey", directory + "/runtime-rey", directory + "/../runtime-rey", directory + "/runtime-rey-src"];
    index = 0;
    while index < candidates.len() {
        var candidate = canonicalSourcePath(candidates[index]);
        if fileExists(candidate + "/main.rey") && fileExists(candidate + "/managed/main.rey") { return candidate; }
        index += 1;
    }
    return "";
}

func effectiveRuntimeRoot(runtimeRoot: string): string {
    if runtimeRoot != "" { return canonicalSourcePath(runtimeRoot); }
    return embeddedRuntimeRoot();
}

func embeddedRuntimeHasPath(sources: Vec<EmbeddedSource>, path: string): bool {
    var index = 0;
    while index < sources.len() {
        if canonicalSourcePath(sources[index].path) == canonicalSourcePath(path) { return true; }
        index += 1;
    }
    return false;
}

func targetHostSourcePath(root: string, target: string): string {
    var canonical = target;
    if canonical == "darwin" { canonical = "darwin-arm64"; }
    if canonical == "linux" { canonical = "linux-arm64"; }
    if canonical == "linux-x64" { return root + "/host/main.rey"; }
    if canonical == "linux-arm64" { return root + "/host/linux-arm64.rey"; }
    if canonical == "darwin-arm64" { return root + "/host/darwin-arm64.rey"; }
    if canonical == "darwin-x64" { return root + "/host/darwin.rey"; }
    return "";
}

func runtimeSourcesForTarget(root: string, target: string, sources: Vec<EmbeddedSource>): Result<Vec<EmbeddedSource>, string> {
    var hostPath = targetHostSourcePath(root, target);
    if hostPath == "" { return Result.Err("managed linker: target-specific host I/O is unsupported for " + target); }
    var hostSource = "";
    var found = false;
    var index = 0;
    while index < sources.len() {
        if canonicalSourcePath(sources[index].path) == canonicalSourcePath(hostPath) {
            hostSource = sources[index].source;
            found = true;
            break;
        }
        index += 1;
    }
    if !found && fileExists(hostPath) {
        hostSource = readFile(hostPath);
        found = true;
    }
    if !found { return Result.Err("managed linker: missing host runtime source for " + target + " at " + hostPath); }
    var mainHostPath = root + "/host/main.rey";
    var result: Vec<EmbeddedSource> = [];
    index = 0;
    while index < sources.len() {
        if canonicalSourcePath(sources[index].path) != canonicalSourcePath(mainHostPath) {
            result.push(sources[index]);
        }
        index += 1;
    }
    result.push(EmbeddedSource { path: mainHostPath, source: hostSource });
    return Result.Ok(result);
}

func copyInts(values: Vec<int>): Vec<int> {
    var result: Vec<int> = [];
    var index = 0;
    while index < values.len() { result.push(values[index]); index += 1; }
    return result;
}

func copySource(value: SourceRef): SourceRef {
    return ir.sourceRef(value.unitId, value.start, value.end);
}

func copyValues(values: Vec<IRValue>): Vec<IRValue> {
    var result: Vec<IRValue> = [];
    var index = 0;
    while index < values.len() {
        result.push(ir.irValue(values[index].id, IRType { kind: values[index].ty.kind }));
        index += 1;
    }
    return result;
}

func copyFunction(value: IRFunction, shift: int): IRFunction {
    var blocks: Vec<BasicBlock> = [];
    var blockIndex = 0;
    while blockIndex < value.blocks.len() {
        var block = value.blocks[blockIndex];
        var instructions: Vec<Instruction> = [];
        var instructionIndex = 0;
        while instructionIndex < block.instructions.len() {
            var item = block.instructions[instructionIndex];
            var target = item.functionId;
            if item.kind == InstructionKind::Call { target += shift; }
            instructions.push(Instruction {
                kind: item.kind, resultId: item.resultId, ty: IRType { kind: item.ty.kind },
                operands: copyInts(item.operands), immediate: item.immediate,
                comparison: item.comparison, functionId: target, source: copySource(item.source),
            });
            instructionIndex += 1;
        }
        var term = block.terminator;
        var copiedTerm = Terminator {
            kind: term.kind, targetBlockId: term.targetBlockId, targetArgs: copyInts(term.targetArgs),
            conditionValueId: term.conditionValueId, trueTargetBlockId: term.trueTargetBlockId,
            trueArgs: copyInts(term.trueArgs), falseTargetBlockId: term.falseTargetBlockId,
            falseArgs: copyInts(term.falseArgs), valueId: term.valueId, source: copySource(term.source),
        };
        blocks.push(ir.basicBlock(block.id, copyValues(block.params), instructions, copiedTerm));
        blockIndex += 1;
    }
    var parameterTypes: Vec<IRType> = [];
    var index = 0;
    while index < value.signature.parameterTypes.len() {
        parameterTypes.push(IRType { kind: value.signature.parameterTypes[index].kind }); index += 1;
    }
    var escapes: Vec<Escape> = [];
    index = 0;
    while index < value.effects.argumentEscapes.len() { escapes.push(value.effects.argumentEscapes[index]); index += 1; }
    var effects = value.effects;
    var copiedEffects = ir.effectSummary(effects.readsMemory, effects.writesMemory, effects.allocates,
        effects.mayBlock, effects.synchronizes, effects.unresolvedCallees, escapes, effects.resultEscape);
    return ir.irFunction(value.id + shift, ir.functionKey(value.key.module, value.key.owner, value.key.name),
        ir.functionSignature(parameterTypes, IRType { kind: value.signature.returnType.kind }),
        copyValues(value.parameters), blocks, copiedEffects);
}

var runtimeExactIndex: HashMap<string, Vec<int>> = HashMap.new();
var runtimeNameIndex: HashMap<string, Vec<int>> = HashMap.new();

func runtimeExactKey(name: string, module: string): string { return name.len().toString() + ":" + name + module.len().toString() + ":" + module; }

func buildRuntimeIndex(program: IRProgram) {
    runtimeExactIndex = HashMap.new();
    runtimeNameIndex = HashMap.new();
    var index = 0;
    while index < program.functions.len() {
        var function = program.functions[index];
        var exactKey = runtimeExactKey(function.key.name, function.key.module);
        if runtimeExactIndex.has(exactKey) { var exact = runtimeExactIndex.get(exactKey); exact.push(index); runtimeExactIndex.set(exactKey, exact); }
        else { runtimeExactIndex.set(exactKey, [index]); }
        if runtimeNameIndex.has(function.key.name) { var named = runtimeNameIndex.get(function.key.name); named.push(index); runtimeNameIndex.set(function.key.name, named); }
        else { runtimeNameIndex.set(function.key.name, [index]); }
        index += 1;
    }
}

func runtimeId(program: IRProgram, name: string, expectedModule: string): int {
    var key = runtimeExactKey(name, expectedModule);
    if !runtimeExactIndex.has(key) { return -1; }
    var matches: Vec<int> = runtimeExactIndex.get(key);
    if matches.len() != 1 { return -1; }
    return program.functions[matches[0]].id;
}

func runtimeHookId(program: IRProgram, name: string, root: string): int {
    if !runtimeNameIndex.has(name) { return -1; }
    var matches: Vec<int> = runtimeNameIndex.get(name);
    var result = -1;
    var index = 0;
    while index < matches.len() {
        var function = program.functions[matches[index]];
        if function.key.module == root + "/managed/main.rey" || function.key.module == root + "/containers/main.rey" {
            if result >= 0 { return -1; }
            result = function.id;
        }
        index += 1;
    }
    return result;
}

func containsId(ids: Vec<int>, id: int): bool {
    var index = 0;
    while index < ids.len() { if ids[index] == id { return true; } index += 1; }
    return false;
}

func collectingRuntimeFunctions(program: IRProgram, root: string): Result<Vec<int>, string> {
    var collector = runtimeId(program, "gcCollect", root + "/gc/main.rey");
    if collector < 0 { return Result.Err("managed linker: collector safepoint function is missing"); }
    var collecting: Vec<int> = [collector];
    var collectingIndex: HashMap<string, bool> = HashMap.new();
    collectingIndex.set(collector.toString(), true);
    var changed = true;
    var remaining = 5000000;
    while changed {
        changed = false;
        var functionIndex = 0;
        while functionIndex < program.functions.len() {
            var function = program.functions[functionIndex];
            if !collectingIndex.has(function.id.toString()) {
                var blockIndex = 0;
                var found = false;
                while blockIndex < function.blocks.len() && !found {
                    var instructionIndex = 0;
                    while instructionIndex < function.blocks[blockIndex].instructions.len() && !found {
                        if remaining <= 0 { return Result.Err("managed linker: safepoint analysis work budget exhausted"); }
                        remaining -= 1;
                        var item = function.blocks[blockIndex].instructions[instructionIndex];
                        if item.kind == InstructionKind::Call && collectingIndex.has(item.functionId.toString()) { found = true; }
                        instructionIndex += 1;
                    }
                    blockIndex += 1;
                }
                if found { collecting.push(function.id); collectingIndex.set(function.id.toString(), true); changed = true; }
            }
            functionIndex += 1;
        }
    }
    return Result.Ok(collecting);
}

func copyModule(input: ManagedProgram, program: IRProgram): ManagedProgram {
    var layouts: Vec<ManagedLayout> = [];
    var index = 0;
    while index < input.layouts.len() {
        var item = input.layouts[index];
        var fields: Vec<ManagedField> = [];
        var fieldIndex = 0;
        while fieldIndex < item.fields.len() {
            var field = item.fields[fieldIndex];
            fields.push(ManagedField { name: field.name, offset: field.offset, kind: field.kind, layoutId: field.layoutId });
            fieldIndex += 1;
        }
        layouts.push(ManagedLayout { id: item.id, key: item.key, payloadBytes: item.payloadBytes, fields: fields });
        index += 1;
    }
    var functions: Vec<ManagedFunction> = [];
    index = 0;
    while index < input.functions.len() {
        var item = input.functions[index];
        functions.push(ManagedFunction { functionId: item.functionId, referenceValues: copyInts(item.referenceValues),
            parameterLayouts: copyInts(item.parameterLayouts), returnLayout: item.returnLayout });
        index += 1;
    }
    var allocations: Vec<ManagedAllocation> = [];
    index = 0;
    while index < input.allocations.len() {
        var item = input.allocations[index];
        allocations.push(ManagedAllocation { functionId: item.functionId, blockId: item.blockId, resultId: item.resultId, layoutId: item.layoutId });
        index += 1;
    }
    var derived: Vec<ManagedDerived> = [];
    index = 0;
    while index < input.derived.len() {
        var item = input.derived[index];
        derived.push(ManagedDerived { functionId: item.functionId, valueId: item.valueId, ownerId: item.ownerId });
        index += 1;
    }
    var variables: Vec<ManagedVariableLayout> = [];
    index = 0;
    while index < input.variableLayouts.len() {
        var item = input.variableLayouts[index];
        variables.push(ManagedVariableLayout { layoutId: item.layoutId, tailKind: item.tailKind }); index += 1;
    }
    var hooks: Vec<ManagedHook> = [];
    index = 0;
    while index < input.hooks.len() {
        var item = input.hooks[index];
        hooks.push(ManagedHook { functionId: item.functionId, runtimeName: item.runtimeName, mayCollect: item.mayCollect }); index += 1;
    }
    return ManagedProgram { program: program, layouts: layouts, functions: functions, allocations: allocations,
        derived: derived, allocateFunctionId: input.allocateFunctionId,
        storeReferenceFunctionId: input.storeReferenceFunctionId, collectFunctionId: input.collectFunctionId,
        variableLayouts: variables, hooks: hooks };
}

pub func linkManagedRuntime(input: ManagedProgram, runtimeProgram: IRProgram, runtimeRoot: string): Result<LinkedManagedProgram, string> {
    buildRuntimeIndex(runtimeProgram);
    var userVerified = verifyProgram(input.program);
    if !userVerified.ok { return Result.Err("managed linker: invalid user IR: " + userVerified.errors.join("\n")); }
    var runtimeVerified = verifyProgram(runtimeProgram);
    if !runtimeVerified.ok { return Result.Err("managed linker: invalid runtime IR: " + runtimeVerified.errors.join("\n")); }
    var shift = ir.nextFunctionId(input.program);
    if shift < 0 { return Result.Err("managed linker: exhausted function IDs"); }
    var functions: Vec<IRFunction> = [];
    var index = 0;
    while index < input.program.functions.len() {
        functions.push(copyFunction(input.program.functions[index], 0)); index += 1;
    }
    index = 0;
    while index < runtimeProgram.functions.len() {
        var function = runtimeProgram.functions[index];
        if function.id > 9223372036854775807 - shift { return Result.Err("managed linker: exhausted function IDs"); }
        functions.push(copyFunction(function, shift)); index += 1;
    }
    var root = canonicalSourcePath(runtimeRoot);
    var managedModule = root + "/managed/main.rey";
    var layoutModule = root + "/layout/main.rey";
    var names: Vec<string> = ["managedCreate", "managedDestroy", "managedAllocate", "managedCollect", "managedRootPush",
        "managedRootSet", "managedRootPop", "managedStoreReference", "managedRegionCreate", "managedRegionEnd",
        "managedRegionAllocate", "managedAllocateDestination", "layoutRegistryCreate", "layoutRegisterFixed", "layoutRegistryRelease", "layoutRegisterVariable"];
    var ids: Vec<int> = [];
    index = 0;
    while index < names.len() {
        var moduleName = managedModule;
        if index >= 12 { moduleName = layoutModule; }
        var id = runtimeId(runtimeProgram, names[index], moduleName);
        if id < 0 { return Result.Err("managed linker: missing or ambiguous runtime function " + names[index]); }
        ids.push(id + shift); index += 1;
    }
    var safepoints = collectingRuntimeFunctions(runtimeProgram, root);
    if safepoints.isErr() { return Result.Err(safepoints.unwrapErr()); }
    var nongc: Vec<int> = [ids[4], ids[5], ids[6], ids[7], ids[8], ids[9], ids[10], ids[12], ids[13], ids[14], ids[15]];
    index = 0;
    while index < nongc.len() {
        if containsId(safepoints.unwrap(), nongc[index] - shift) { return Result.Err("managed linker: a root/setup/region helper may collect"); }
        index += 1;
    }
    var hooks: Vec<ManagedHookBinding> = [];
    index = 0;
    while index < input.hooks.len() {
        var hook = input.hooks[index];
        var id = runtimeHookId(runtimeProgram, hook.runtimeName, root);
        if id < 0 { return Result.Err("managed linker: missing or ambiguous runtime hook " + hook.runtimeName); }
        if !hook.mayCollect && containsId(safepoints.unwrap(), id) {
            return Result.Err("managed linker: collecting runtime hook was declared non-collecting: " + hook.runtimeName);
        }
        hooks.push(ManagedHookBinding { functionId: hook.functionId, runtimeFunctionId: id + shift, mayCollect: hook.mayCollect });
        index += 1;
    }
    var bindings = RuntimeBindings { create: ids[0], destroy: ids[1], allocate: ids[2], collect: ids[3], rootPush: ids[4],
        rootSet: ids[5], rootPop: ids[6], storeReference: ids[7], regionCreate: ids[8], regionEnd: ids[9], regionAllocate: ids[10],
        allocateDestination: ids[11], layoutCreate: ids[12], layoutRegister: ids[13], layoutRelease: ids[14],
        layoutRegisterVariable: ids[15], hooks: hooks };
    var program = ir.irProgram(input.program.entryFunctionId, functions);
    return Result.Ok(LinkedManagedProgram { module: copyModule(input, program), bindings: bindings });
}

pub func loadManagedRuntime(runtimeRoot: string, stdRoot: string): Result<IRProgram, string> {
    var root = effectiveRuntimeRoot(runtimeRoot);
    var embeddedSources: Vec<EmbeddedSource> = [];
    if runtimeRoot == "" { embeddedSources = embeddedRuntimeSources(); }
    var selectedSources = runtimeSourcesForTarget(root, getLowerTargetOS(), embeddedSources);
    if selectedSources.isErr() { return Result.Err(selectedSources.unwrapErr()); }
    var graphSources = selectedSources.unwrap();
    if stdRoot == embeddedStdRoot() {
        var embeddedStd = embeddedStdSources();
        var sourceAt = 0;
        while sourceAt < embeddedStd.len() { graphSources.push(embeddedStd[sourceAt]); sourceAt += 1; }
    }
    var entry = root + "/main.rey";
    var units: Vec<string> = [root + "/layout/main.rey", root + "/heap/main.rey", root + "/gc/main.rey", root + "/managed/main.rey", root + "/containers/main.rey", root + "/host/main.rey"];
    var checked = checkSourceFileGraphWithEmbedded(entry, stdRoot, units, graphSources);
    if checked.isErr() { return Result.Err(checked.unwrapErr()); }
    return lowerProgram(checked.unwrap());
}

pub func requiresManagedLowering(checked: CheckedProgram): bool {
    var index = 0;
    while index < checked.nominalLayouts.len() {
        if checked.nominalLayouts[index].kind == "Struct" || checked.nominalLayouts[index].kind == "Enum" { return true; }
        index += 1;
    }
    index = 0;
    while index < checked.expressions.len() {
        var kind = checked.expressions[index].ty.kind;
        if kind == "Struct" || kind == "Nullable" || kind == "String" || kind == "Char" || kind == "Tuple" || kind == "Enum" || kind == "Option" || kind == "Result" || kind == "Array" || kind == "Vec" || kind == "HashMap" || kind == "Map" || kind == "Dict" { return true; }
        index += 1;
    }
    return false;
}

pub func buildManagedProgram(checked: CheckedProgram, runtimeRoot: string, stdRoot: string, stress: bool, regions: bool): Result<IRProgram, string> {
    if regions {
        return Result.Err("managed linker: buildManagedProgram does not lower region placements; pass regions=false for the legacy collector runtime, or call buildRegionProgram");
    }
    var input = lowerManagedProgram(checked);
    if input.isErr() { return Result.Err(input.unwrapErr()); }
    var root = effectiveRuntimeRoot(runtimeRoot);
    var runtime = loadManagedRuntime(runtimeRoot, stdRoot);
    if runtime.isErr() { return Result.Err(runtime.unwrapErr()); }
    var linked = linkManagedRuntime(input.unwrap(), runtime.unwrap(), root);
    if linked.isErr() { return Result.Err(linked.unwrapErr()); }
    var module = linked.unwrap().module;
    var allocations: Vec<ManagedAllocationPlacement> = [];
    var index = 0;
    while index < module.allocations.len() {
        var item = module.allocations[index];
        allocations.push(ManagedAllocationPlacement { functionId: item.functionId, resultId: item.resultId, storage: ManagedStorage::Heap }); index += 1;
    }
    var placements = ManagedPlacement { allocations: allocations, calls: [], regionFunctions: [] };
    return lowerManagedRoots(module, linked.unwrap().bindings, placements, stress);
}

pub struct LinkedRegionProgram {
    pub module: ManagedProgram,
    pub bindings: RegionBindings,
}

pub func regionRuntimeUnits(runtimeRoot: string): Vec<string> {
    var root = canonicalSourcePath(runtimeRoot);
    var units: Vec<string> = [];
    units.push(root + "/main.rey");
    units.push(root + "/regions/main.rey");
    units.push(root + "/managed/main.rey");
    units.push(root + "/layout/main.rey");
    units.push(root + "/containers/main.rey");
    units.push(root + "/task/main.rey");
    units.push(root + "/host/main.rey");
    return units;
}

func forbiddenRuntimeModule(module: string): bool {
    if module.contains("/gc/") || module.endsWith("/gc/main.rey") { return true; }
    if module.contains("/heap/") || module.endsWith("/heap/main.rey") { return true; }
    return false;
}

func forbiddenRuntimeName(name: string): bool {
    if name == "managedCollect" || name == "gcCollect" || name == "gcCreate" || name == "gcDestroy" || name == "gcRegisterRootRange" || name == "gcUnregisterRootRange" { return true; }
    if name == "heapCreate" || name == "heapDestroy" || name == "heapAllocate" || name == "heapAllocateSized" { return true; }
    return false;
}

func forbiddenRuntimeProgram(program: IRProgram): string {
    var index = 0;
    while index < program.functions.len() {
        var function = program.functions[index];
        if forbiddenRuntimeModule(function.key.module) { return "region linker: refused to load gc or heap module " + function.key.module; }
        if forbiddenRuntimeName(function.key.name) { return "region linker: refused to load collector or heap function " + function.key.name; }
        index += 1;
    }
    return "";
}

func requiredRuntimeModulesPresent(program: IRProgram, root: string): string {
    var suffixes: Vec<string> = ["/regions/main.rey", "/managed/main.rey", "/layout/main.rey", "/containers/main.rey", "/host/main.rey"];
    var suffixIndex = 0;
    while suffixIndex < suffixes.len() {
        var expected = root + suffixes[suffixIndex];
        var found = false;
        var index = 0;
        while index < program.functions.len() {
            if program.functions[index].key.module == expected { found = true; }
            index += 1;
        }
        if !found { return "region linker: runtime graph did not include " + expected; }
        suffixIndex += 1;
    }
    return "";
}

func regionSymbolSignature(function: IRFunction, parameterKinds: Vec<IRTypeKind>, returnKind: IRTypeKind): bool {
    if function.signature.returnType.kind != returnKind || function.parameters.len() != parameterKinds.len() || function.signature.parameterTypes.len() != parameterKinds.len() { return false; }
    var index = 0;
    while index < parameterKinds.len() {
        if function.parameters[index].ty.kind != parameterKinds[index] || function.signature.parameterTypes[index].kind != parameterKinds[index] { return false; }
        index += 1;
    }
    return true;
}

func resolveRegionSymbol(program: IRProgram, modules: Vec<string>, name: string, parameterKinds: Vec<IRTypeKind>, returnKind: IRTypeKind): Result<int, string> {
    var found = -1;
    if runtimeNameIndex.has(name) {
        var matches: Vec<int> = runtimeNameIndex.get(name);
        var index = 0;
        while index < matches.len() {
            var function = program.functions[matches[index]];
            if containsString(modules, function.key.module) {
                if !regionSymbolSignature(function, parameterKinds, returnKind) { return Result.Err("region linker: runtime function signature mismatch " + name); }
                if found >= 0 { return Result.Err("region linker: missing or ambiguous runtime function " + name); }
                found = function.id;
            }
            index += 1;
        }
    }
    if found < 0 { return Result.Err("region linker: missing or ambiguous runtime function " + name); }
    return Result.Ok(found);
}
func resolveOptionalRegionSymbol(program: IRProgram, modules: Vec<string>, name: string, parameterKinds: Vec<IRTypeKind>, returnKind: IRTypeKind): Result<int, string> {
    var found = -1;
    if runtimeNameIndex.has(name) {
        var matches: Vec<int> = runtimeNameIndex.get(name);
        var index = 0;
        while index < matches.len() {
            var function = program.functions[matches[index]];
            if containsString(modules, function.key.module) {
                if !regionSymbolSignature(function, parameterKinds, returnKind) { return Result.Err("region linker: runtime function signature mismatch " + name); }
                if found >= 0 { return Result.Err("region linker: missing or ambiguous runtime function " + name); }
                found = function.id;
            }
            index += 1;
        }
    }
    return Result.Ok(found);
}

func containsString(values: Vec<string>, value: string): bool {
    var index = 0;
    while index < values.len() { if values[index] == value { return true; } index += 1; }
    return false;
}

func regionApiModules(root: string): Vec<string> {
    var modules: Vec<string> = [];
    modules.push(root + "/regions/main.rey");
    modules.push(root + "/managed/main.rey");
    return modules;
}

func layoutModule(root: string): Vec<string> {
    var modules: Vec<string> = [];
    modules.push(root + "/layout/main.rey");
    return modules;
}

func hookModules(root: string): Vec<string> {
    var modules = regionApiModules(root);
    modules.push(root + "/containers/main.rey");
    return modules;
}

func shiftedId(id: int, shift: int): Result<int, string> {
    if id < 0 || shift < 0 || id > 9223372036854775807 - shift { return Result.Err("region linker: exhausted function IDs"); }
    return Result.Ok(id + shift);
}

pub func linkRegionRuntime(input: ManagedProgram, runtimeProgram: IRProgram, runtimeRoot: string): Result<LinkedRegionProgram, string> {
    buildRuntimeIndex(runtimeProgram);
    if input.program.functions.len() <= 512 {
        var userVerified = verifyProgram(input.program);
        if !userVerified.ok { return Result.Err("region linker: invalid user IR: " + userVerified.errors.join("\n")); }
        var runtimeVerified = verifyProgram(runtimeProgram);
        if !runtimeVerified.ok { return Result.Err("region linker: invalid runtime IR: " + runtimeVerified.errors.join("\n")); }
    }
    var forbidden = forbiddenRuntimeProgram(runtimeProgram);
    if forbidden != "" { return Result.Err(forbidden); }
    var root = canonicalSourcePath(runtimeRoot);
    var shift = ir.nextFunctionId(input.program);
    if shift < 0 { return Result.Err("region linker: exhausted function IDs"); }
    var raw = IRTypeKind::RawAddress;
    var i64Kind = IRTypeKind::I64;
    var voidKind = IRTypeKind::Void;
    var api = regionApiModules(root);
    var layouts = layoutModule(root);
    var create = resolveRegionSymbol(runtimeProgram, api, "managedCreate", [raw], raw);
    if create.isErr() { return Result.Err(create.unwrapErr()); }
    var destroy = resolveRegionSymbol(runtimeProgram, api, "managedDestroy", [raw], voidKind);
    if destroy.isErr() { return Result.Err(destroy.unwrapErr()); }
    var storeReference = resolveRegionSymbol(runtimeProgram, api, "managedStoreReference", [raw, raw, i64Kind, raw], voidKind);
    if storeReference.isErr() { return Result.Err(storeReference.unwrapErr()); }
    var regionCreate = resolveRegionSymbol(runtimeProgram, api, "managedHandleRegionCreate", [raw], raw);
    if regionCreate.isErr() { return Result.Err(regionCreate.unwrapErr()); }
    var regionEnd = resolveRegionSymbol(runtimeProgram, api, "managedHandleRegionEnd", [raw, raw], voidKind);
    if regionEnd.isErr() { return Result.Err(regionEnd.unwrapErr()); }
    var regionAllocate = resolveRegionSymbol(runtimeProgram, api, "managedHandleRegionAllocate", [raw, raw, i64Kind, i64Kind], raw);
    if regionAllocate.isErr() { return Result.Err(regionAllocate.unwrapErr()); }
    var allocateDestination = resolveRegionSymbol(runtimeProgram, api, "managedHandleAllocateDestination", [raw, raw, i64Kind, i64Kind], raw);
    if allocateDestination.isErr() { return Result.Err(allocateDestination.unwrapErr()); }
    var allocateProgram = resolveRegionSymbol(runtimeProgram, api, "managedAllocateProgram", [raw, i64Kind, i64Kind], raw);
    if allocateProgram.isErr() { return Result.Err(allocateProgram.unwrapErr()); }
    var promoteReference = resolveRegionSymbol(runtimeProgram, api, "managedHandlePromoteReference", [raw, raw, raw], raw);
    if promoteReference.isErr() { return Result.Err(promoteReference.unwrapErr()); }
    var promotionCount = resolveRegionSymbol(runtimeProgram, api, "managedPromotionCount", [raw], i64Kind);
    if promotionCount.isErr() { return Result.Err(promotionCount.unwrapErr()); }
    var layoutCreate = resolveRegionSymbol(runtimeProgram, layouts, "layoutRegistryCreate", [i64Kind], raw);
    if layoutCreate.isErr() { return Result.Err(layoutCreate.unwrapErr()); }
    var layoutRegister = resolveRegionSymbol(runtimeProgram, layouts, "layoutRegisterFixed", [raw, i64Kind, raw, i64Kind], i64Kind);
    if layoutRegister.isErr() { return Result.Err(layoutRegister.unwrapErr()); }
    var layoutRegisterVariable = resolveRegionSymbol(runtimeProgram, layouts, "layoutRegisterVariable", [raw, i64Kind, raw, i64Kind, i64Kind], i64Kind);
    if layoutRegisterVariable.isErr() { return Result.Err(layoutRegisterVariable.unwrapErr()); }
    var layoutRelease = resolveRegionSymbol(runtimeProgram, layouts, "layoutRegistryRelease", [raw], voidKind);
    if layoutRelease.isErr() { return Result.Err(layoutRelease.unwrapErr()); }
    var ids: Vec<int> = [create.unwrap(), destroy.unwrap(), storeReference.unwrap(), regionCreate.unwrap(), regionEnd.unwrap(), regionAllocate.unwrap(), allocateDestination.unwrap(), allocateProgram.unwrap(), promoteReference.unwrap(), promotionCount.unwrap(), layoutCreate.unwrap(), layoutRegister.unwrap(), layoutRegisterVariable.unwrap(), layoutRelease.unwrap()];
    var shifted: Vec<int> = [];
    var index = 0;
    while index < ids.len() {
        var moved = shiftedId(ids[index], shift);
        if moved.isErr() { return Result.Err(moved.unwrapErr()); }
        var prior = 0;
        while prior < shifted.len() { if shifted[prior] == moved.unwrap() { return Result.Err("region linker: runtime binding IDs must be unique"); } prior += 1; }
        shifted.push(moved.unwrap());
        index += 1;
    }
    var hooks: Vec<RegionHookBinding> = [];
    var hookModulesForRoot = hookModules(root);
    index = 0;
    while index < input.hooks.len() {
        var hook = input.hooks[index];
        var runtimeHook = -1;
        var functionIndex = 0;
        while functionIndex < runtimeProgram.functions.len() {
            var function = runtimeProgram.functions[functionIndex];
            if function.key.name == hook.runtimeName && containsString(hookModulesForRoot, function.key.module) {
                if runtimeHook >= 0 { return Result.Err("region linker: missing or ambiguous runtime hook " + hook.runtimeName); }
                runtimeHook = function.id;
            }
            functionIndex += 1;
        }
        if runtimeHook < 0 { return Result.Err("region linker: missing or ambiguous runtime hook " + hook.runtimeName); }
        var runtimeFunction = runtimeProgram.functions[0];
        var runtimeFound = false;
        functionIndex = 0;
        while functionIndex < runtimeProgram.functions.len() {
            if runtimeProgram.functions[functionIndex].id == runtimeHook { runtimeFunction = runtimeProgram.functions[functionIndex]; runtimeFound = true; }
            functionIndex += 1;
        }
        if !runtimeFound { return Result.Err("region linker: missing or ambiguous runtime hook " + hook.runtimeName); }
        var stubIndex = 0;
        var stubFound = false;
        var stub = input.program.functions[0];
        while stubIndex < input.program.functions.len() {
            if input.program.functions[stubIndex].id == hook.functionId { stub = input.program.functions[stubIndex]; stubFound = true; }
            stubIndex += 1;
        }
        if !stubFound { return Result.Err("region linker: managed hook stub function is missing"); }
        if runtimeFunction.parameters.len() != stub.parameters.len() + 1 || runtimeFunction.signature.returnType.kind != stub.signature.returnType.kind || runtimeFunction.parameters[0].ty.kind != IRTypeKind::RawAddress { return Result.Err("region linker: hook runtime signature must prepend one raw context parameter"); }
        var parameterIndex = 0;
        while parameterIndex < stub.parameters.len() {
            if runtimeFunction.parameters[parameterIndex + 1].ty.kind != stub.parameters[parameterIndex].ty.kind { return Result.Err("region linker: hook runtime signature must prepend one raw context parameter"); }
            parameterIndex += 1;
        }
        var movedHook = shiftedId(runtimeHook, shift);
        if movedHook.isErr() { return Result.Err(movedHook.unwrapErr()); }
        var priorHook = 0;
        while priorHook < hooks.len() {
            if hooks[priorHook].functionId == hook.functionId || hooks[priorHook].runtimeFunctionId == movedHook.unwrap() { return Result.Err("region linker: managed hook stub and runtime IDs must be unique"); }
            priorHook += 1;
        }
        hooks.push(RegionHookBinding { functionId: hook.functionId, runtimeFunctionId: movedHook.unwrap(), mayCollect: hook.mayCollect });
        index += 1;
    }
    var functions: Vec<IRFunction> = [];
    index = 0;
    while index < input.program.functions.len() { functions.push(copyFunction(input.program.functions[index], 0)); index += 1; }
    index = 0;
    while index < runtimeProgram.functions.len() {
        var function = runtimeProgram.functions[index];
        if function.id > 9223372036854775807 - shift { return Result.Err("region linker: exhausted function IDs"); }
        functions.push(copyFunction(function, shift));
        index += 1;
    }
    var cohortCreate = resolveOptionalRegionSymbol(runtimeProgram, api, "managedHandleRegionCreateCohort", [raw, raw, i64Kind, i64Kind], raw);
    if cohortCreate.isErr() { return Result.Err(cohortCreate.unwrapErr()); }
    var cohortId = -1;
    if cohortCreate.unwrap() >= 0 {
        var movedCohort = shiftedId(cohortCreate.unwrap(), shift);
        if movedCohort.isErr() { return Result.Err(movedCohort.unwrapErr()); }
        var priorCohort = 0;
        while priorCohort < shifted.len() { if shifted[priorCohort] == movedCohort.unwrap() { return Result.Err("region linker: runtime binding IDs must be unique"); } priorCohort += 1; }
        cohortId = movedCohort.unwrap();
    }
    var bindings = RegionBindings { create: shifted[0], destroy: shifted[1], storeReference: shifted[2], regionCreate: shifted[3], regionEnd: shifted[4], regionAllocate: shifted[5], allocateDestination: shifted[6], allocateProgram: shifted[7], promoteReference: shifted[8], promotionCount: shifted[9], layoutCreate: shifted[10], layoutRegister: shifted[11], layoutRegisterVariable: shifted[12], layoutRelease: shifted[13], cohortCreate: cohortId, hooks: hooks };
    var program = ir.irProgram(input.program.entryFunctionId, functions);
    return Result.Ok(LinkedRegionProgram { module: copyModule(input, program), bindings: bindings });
}

pub func loadRegionRuntime(runtimeRoot: string, stdRoot: string): Result<IRProgram, string> {
    var root = effectiveRuntimeRoot(runtimeRoot);
    var embeddedSources: Vec<EmbeddedSource> = [];
    if runtimeRoot == "" { embeddedSources = embeddedRuntimeSources(); }
    var selectedSources = runtimeSourcesForTarget(root, getLowerTargetOS(), embeddedSources);
    if selectedSources.isErr() { return Result.Err(selectedSources.unwrapErr()); }
    var graphSources = selectedSources.unwrap();
    if stdRoot == embeddedStdRoot() {
        var embeddedStd = embeddedStdSources();
        var sourceAt = 0;
        while sourceAt < embeddedStd.len() { graphSources.push(embeddedStd[sourceAt]); sourceAt += 1; }
    }
    var units = regionRuntimeUnits(root);
    var index = 0;
    while index < units.len() {
        var available = embeddedRuntimeHasPath(graphSources, units[index]);
        if !available { available = fileExists(units[index]); }
        if !available { return Result.Err("region linker: missing runtime unit " + units[index]); }
        index += 1;
    }
    var checked = checkSourceFileGraphWithEmbedded(root + "/main.rey", stdRoot, units, graphSources);
    if checked.isErr() { return Result.Err(checked.unwrapErr()); }
    var lowered = lowerProgram(checked.unwrap());
    if lowered.isErr() { return Result.Err(lowered.unwrapErr()); }
    var program = lowered.unwrap();
    var forbidden = forbiddenRuntimeProgram(program);
    if forbidden != "" { return Result.Err(forbidden); }
    var present = requiredRuntimeModulesPresent(program, root);
    if present != "" { return Result.Err(present); }
    return Result.Ok(program);
}

pub func buildRegionProgram(checked: CheckedProgram, runtimeRoot: string, stdRoot: string, promotionStress: bool): Result<IRProgram, string> {
    var input = lowerManagedProgram(checked);
    if input.isErr() { return Result.Err(input.unwrapErr()); }
    var root = effectiveRuntimeRoot(runtimeRoot);
    var runtime = loadRegionRuntime(runtimeRoot, stdRoot);
    if runtime.isErr() { return Result.Err(runtime.unwrapErr()); }
    var linked = linkRegionRuntime(input.unwrap(), runtime.unwrap(), root);
    if linked.isErr() { return Result.Err(linked.unwrapErr()); }
    var linkedProgram = linked.unwrap();
    var planned = planManagedPlacement(linkedProgram.module);
    if planned.isErr() { return Result.Err(planned.unwrapErr()); }
    return lowerManagedRegionsWithPromotionStress(linkedProgram.module, linkedProgram.bindings, planned.unwrap(), promotionStress);
}

pub func buildCompletedRegionProgram(checked: CheckedProgram, runtimeRoot: string, stdRoot: string, promotionStress: bool): Result<IRProgram, string> {
    if experimentalEscapeSummaryEnabled() && runtimeRoot != "" { return Result.Err("experimental escape summary requires the embedded runtime"); }
    var input = lowerManagedProgram(checked);
    if input.isErr() { return Result.Err(input.unwrapErr()); }
    var root = effectiveRuntimeRoot(runtimeRoot);
    var runtime = loadRegionRuntime(runtimeRoot, stdRoot);
    if runtime.isErr() { return Result.Err(runtime.unwrapErr()); }
    var linked = linkRegionRuntime(input.unwrap(), runtime.unwrap(), root);
    if linked.isErr() { return Result.Err(linked.unwrapErr()); }
    var linkedProgram = linked.unwrap();
    var replaced = applyScalarReplacementForCompilerFast(linkedProgram.module);
    if replaced.isErr() { return Result.Err(replaced.unwrapErr()); }
    var completed = completeManagedMemory(replaced.unwrap());
    if completed.isErr() { return Result.Err(completed.unwrapErr()); }
    var lowered = lowerManagedRegionsCompleted(replaced.unwrap(), linkedProgram.bindings, completed.unwrap(), promotionStress);
    if lowered.isErr() { return Result.Err(lowered.unwrapErr()); }
    return lowered;
}
