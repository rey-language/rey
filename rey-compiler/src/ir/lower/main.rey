var structCache: HashMap<string, HashMap<string, string>> = HashMap.new();
var enumCache: HashMap<string, HashMap<string, string>> = HashMap.new();
var arrayCache: HashMap<string, string> = HashMap.new();
var dictCache: HashMap<string, string> = HashMap.new();
var optionCache: HashMap<string, string> = HashMap.new();
var resultCache: HashMap<string, HashMap<string, string>> = HashMap.new();
var tupleCache: Vec<CachedTupleKey> = [];
var unsupportedCache: HashMap<string, HashMap<string, string>> = HashMap.new();
var layoutIds: HashMap<string, int> = HashMap.new();
var backingIds: HashMap<string, int> = HashMap.new();
var bucketIds: HashMap<string, int> = HashMap.new();
var nodeIds: HashMap<string, int> = HashMap.new();
var layoutCacheReady: bool = false;
var cachedStringLayout: int = -2;
var activeExprFlat: Vec<ExprSpanEntry> = [];
var activeExprRanges: Vec<ExprFileRange> = [];
var activeExprReady: bool = false;
var activeExprRoot: string = emptyString;
var activeExprQueryReady: bool = false;
var activeExprQueryRaw: string = emptyString;
var activeExprQueryKey: string = emptyString;
var activeExprRangeKey: string = emptyString;
var activeExprRangeIndex: int = -1;
var activeExprWindowStart: int = 0;
var activeExprWindowCount: int = 0;
var activeGlobalSlots: Vec<GlobalSlot> = [];
var activeGlobalGetId: int = -1;
var activeGlobalSetId: int = -1;
var activeGlobalBytes: int = 0;
var lowerTargetOS: string = "darwin";
var trustedPackedOutput: bool = false;
// Darwin MAP_FIXED rejects 0x200000000 with EPERM. 0x180000000 is a free fixed page.
var globalSlabAddress: int = 6442450944;

pub func setLowerTargetOS(os: string) {
    lowerTargetOS = os;
}

pub func setTrustedPackedOutput(enabled: bool) {
    trustedPackedOutput = enabled;
}

pub func getLowerTargetOS(): string {
    return lowerTargetOS;
}

func beginLayoutCache() {
    layoutIds = HashMap.new();
    backingIds = HashMap.new();
    bucketIds = HashMap.new();
    nodeIds = HashMap.new();
    layoutCacheReady = false;
    cachedStringLayout = -2;
}

func finishLayoutCache() {
    layoutCacheReady = true;
}

func rememberLayoutId(cache: HashMap<string, int>, key: string, id: int) {
    if id > 0 || layoutCacheReady { cache.set(key, id); }
}

func cachedLayoutId(cache: HashMap<string, int>, key: string): int {
    if cache.has(key) {
        var cached = cache.get(key);
        if cached > 0 || layoutCacheReady { return cached; }
    }
    return -2;
}

func cachedNominalKey(cache: HashMap<string, HashMap<string, string>>, ty: Type, prefix: string): string {
    if cache.has(ty.sourcePath) {
        var byName = cache.get(ty.sourcePath);
        if byName.has(ty.name) { return byName.get(ty.name); }
        var built = prefix + ty.sourcePath.len().toString() + prefixColon + ty.sourcePath + ty.moduleId.len().toString() + prefixColon + ty.moduleId + ty.name.len().toString() + prefixColon + ty.name;
        byName.set(ty.name, built);
        cache.set(ty.sourcePath, byName);
        return built;
    }
    var created: HashMap<string, string> = HashMap.new();
    var first = prefix + ty.sourcePath.len().toString() + prefixColon + ty.sourcePath + ty.moduleId.len().toString() + prefixColon + ty.moduleId + ty.name.len().toString() + prefixColon + ty.name;
    created.set(ty.name, first);
    cache.set(ty.sourcePath, created);
    return first;
}

func cachedWrappedKey(cache: HashMap<string, string>, prefix: string, innerKey: string): string {
    if cache.has(innerKey) { return cache.get(innerKey); }
    var built = prefix + innerKey;
    cache.set(innerKey, built);
    return built;
}

func cachedSizedKey(cache: HashMap<string, string>, prefix: string, innerKey: string): string {
    if cache.has(innerKey) { return cache.get(innerKey); }
    var built = prefix + innerKey.len().toString() + prefixColon + innerKey;
    cache.set(innerKey, built);
    return built;
}

func cachedTupleKey(ty: Type): string {
    var index = 0;
    loop {
        if index >= tupleCache.len() { break; }
        var entry = tupleCache[index];
        if entry.parts.len() == ty.params.len() {
            var same = true;
            var part = 0;
            loop {
                if part >= ty.params.len() { break; }
                if entry.parts[part] != managedTypeKey(ty.params[part]) { same = false; break; }
                part = part + 1;
            }
            if same { return entry.cached; }
        }
        index = index + 1;
    }
    var parts: Vec<string> = [];
    var key = prefixTuple + ty.params.len().toString() + prefixColon;
    var build = 0;
    loop {
        if build >= ty.params.len() { break; }
        var item = managedTypeKey(ty.params[build]);
        parts.push(item);
        key = key + item.len().toString() + prefixColon + item;
        build = build + 1;
    }
    tupleCache.push(CachedTupleKey { parts: parts, cached: key });
    return key;
}

func managedTypeKey(ty: Type): string {
    if ty.kind == kindInt { return keyInt; }
    if ty.kind == kindBool { return keyBool; }
    if ty.kind == kindChar { return keyChar; }
    if ty.kind == kindString { return keyString; }
    if ty.kind == kindFloat { return keyFloat; }
    if ty.kind == kindVoid { return keyVoid; }
    if ty.kind == kindNull { return keyNull; }
    if ty.kind == kindStruct { return cachedNominalKey(structCache, ty, nominalStruct); }
    if ty.kind == kindEnum { return cachedNominalKey(enumCache, ty, nominalEnum); }
    if ty.kind == kindNullable {
        var inner = ty.inner;
        if inner != null { return managedTypeKey(inner); }
        return keyMissingNullable;
    }
    if ty.kind == kindArray {
        var inner = ty.inner;
        if inner != null { return cachedWrappedKey(arrayCache, prefixVec, managedTypeKey(inner)); }
        return keyVecAny;
    }
    if ty.kind == kindDict {
        var value = ty.value;
        if value != null { return cachedWrappedKey(dictCache, prefixMap, managedTypeKey(value)); }
        return keyMapAny;
    }
    if ty.kind == kindTuple { return cachedTupleKey(ty); }
    if ty.kind == kindOption {
        var optionInner = ty.inner;
        if optionInner != null { return cachedSizedKey(optionCache, prefixOption, managedTypeKey(optionInner)); }
        return keyOptionAny;
    }
    if ty.kind == kindResult {
        var okType = ty.inner;
        var errType = ty.key;
        var okKey = keyAnyWord;
        var errKey = keyAnyWord;
        if okType != null { okKey = managedTypeKey(okType); }
        if errType != null { errKey = managedTypeKey(errType); }
        if resultCache.has(okKey) {
            var byErr = resultCache.get(okKey);
            if byErr.has(errKey) { return byErr.get(errKey); }
            var built = prefixResult + okKey.len().toString() + prefixColon + okKey + errKey.len().toString() + prefixColon + errKey;
            byErr.set(errKey, built);
            resultCache.set(okKey, byErr);
            return built;
        }
        var createdResult: HashMap<string, string> = HashMap.new();
        var firstResult = prefixResult + okKey.len().toString() + prefixColon + okKey + errKey.len().toString() + prefixColon + errKey;
        createdResult.set(errKey, firstResult);
        resultCache.set(okKey, createdResult);
        return firstResult;
    }
    if unsupportedCache.has(ty.kind) {
        var byName = unsupportedCache.get(ty.kind);
        if byName.has(ty.name) { return byName.get(ty.name); }
        var built = prefixUnsupported + ty.kind + prefixColon + ty.name;
        byName.set(ty.name, built);
        unsupportedCache.set(ty.kind, byName);
        return built;
    }
    var createdUnsupported: HashMap<string, string> = HashMap.new();
    var firstUnsupported = prefixUnsupported + ty.kind + prefixColon + ty.name;
    createdUnsupported.set(ty.name, firstUnsupported);
    unsupportedCache.set(ty.kind, createdUnsupported);
    return firstUnsupported;
}

func managedLayoutId(layouts: Vec<ManagedLayout>, ty: Type): int {
    if ty.kind == kindNullable {
        var inner = ty.inner;
        if inner != null { return managedLayoutId(layouts, inner); }
        return -1;
    }
    var key = managedTypeKey(ty);
    var cached = cachedLayoutId(layoutIds, key);
    if cached != -2 { return cached; }
    var index = 0;
    loop { if index >= layouts.len() { break; } if layouts[index].key == key { rememberLayoutId(layoutIds, key, layouts[index].id); return layouts[index].id; } index = index + 1; }
    rememberLayoutId(layoutIds, key, 0);
    return 0;
}

func managedTypeIsSupported(checked: CheckedProgram, layouts: Vec<ManagedLayout>, ty: Type, allowNull: bool): bool {
    if ty.kind == kindInt || ty.kind == kindBool || ty.kind == kindChar || ty.kind == kindVoid { return true; }
    if ty.kind == kindNull { return allowNull; }
    return managedLayoutId(layouts, ty) > 0;
}

func managedIRType(layouts: Vec<ManagedLayout>, ty: Type): IRType {
    if managedLayoutId(layouts, ty) > 0 || ty.kind == kindNull || ty.kind == kindAny || ty.kind == kindStruct || ty.kind == kindEnum || ty.kind == kindTuple || ty.kind == kindString || ty.kind == kindArray || ty.kind == kindDict || ty.kind == kindOption || ty.kind == kindResult || ty.kind == kindNullable { return ir.irRawAddress(); }
    return toIRType(ty);
}

func managedExpressionType(lowerer: FunctionLowerer, checkedType: Type): Type {
    var maybeExpected = lowerer.expectedType;
    if maybeExpected == null { return checkedType; }
    var expected = requiredType(maybeExpected, checkedType);
    if checkedType.kind == kindNull { return expected; }
    if checkedType.kind == expected.kind && managedTypeContainsAny(checkedType) { return expected; }
    if managedTypeHasNullLeaf(checkedType) && managedNullSpecializationCompatible(checkedType, expected, lowerer.managedLayouts) { return expected; }
    return checkedType;
}

func managedTypeHasNullLeaf(ty: Type): bool {
    if ty.kind == kindNull { return true; }
    var maybeInner = ty.inner;
    if maybeInner != null { if managedTypeHasNullLeaf(requiredType(maybeInner, ty)) { return true; } }
    var maybeKey = ty.key;
    if maybeKey != null { if managedTypeHasNullLeaf(requiredType(maybeKey, ty)) { return true; } }
    var maybeValue = ty.value;
    if maybeValue != null { if managedTypeHasNullLeaf(requiredType(maybeValue, ty)) { return true; } }
    var index = 0;
    loop { if index >= ty.params.len() { break; } if managedTypeHasNullLeaf(ty.params[index]) { return true; } index = index + 1; }
    return false;
}

// A checked Null leaf is only a temporary type hole when an exact surrounding
// generic type supplies a managed-reference element. Keep every concrete sibling
// exact so context never changes an inferred non-null value or guesses a type.
func managedNullSpecializationCompatible(checkedType: Type, expectedType: Type, layouts: Vec<ManagedLayout>): bool {
    if checkedType.kind == kindNull {
        return expectedType.kind != kindNull && expectedType.kind != kindAny && expectedType.kind != kindUnknown && managedLayoutId(layouts, expectedType) > 0 && managedIRType(layouts, expectedType).kind == IRTypeKind::RawAddress;
    }
    if checkedType.kind != expectedType.kind { return false; }
    if checkedType.kind == kindArray || checkedType.kind == kindNullable || checkedType.kind == kindOption {
        var checkedInner = checkedType.inner;
        var expectedInner = expectedType.inner;
        if checkedInner == null || expectedInner == null { return checkedInner == null && expectedInner == null && managedTypeKey(checkedType) == managedTypeKey(expectedType); }
        return managedNullSpecializationCompatible(requiredType(checkedInner, checkedType), requiredType(expectedInner, expectedType), layouts);
    }
    if checkedType.kind == kindDict {
        var checkedValue = checkedType.value;
        var expectedValue = expectedType.value;
        if checkedValue == null || expectedValue == null { return checkedValue == null && expectedValue == null && managedTypeKey(checkedType) == managedTypeKey(expectedType); }
        return managedNullSpecializationCompatible(requiredType(checkedValue, checkedType), requiredType(expectedValue, expectedType), layouts);
    }
    if checkedType.kind == kindResult {
        var checkedInnerResult = checkedType.inner;
        var expectedInnerResult = expectedType.inner;
        var checkedKeyResult = checkedType.key;
        var expectedKeyResult = expectedType.key;
        if checkedInnerResult == null || expectedInnerResult == null { if (checkedInnerResult == null) != (expectedInnerResult == null) { return false; } }
        else if !managedNullSpecializationCompatible(requiredType(checkedInnerResult, checkedType), requiredType(expectedInnerResult, expectedType), layouts) { return false; }
        if checkedKeyResult == null || expectedKeyResult == null { return (checkedKeyResult == null) == (expectedKeyResult == null) && managedTypeKey(checkedType) == managedTypeKey(expectedType); }
        return managedNullSpecializationCompatible(requiredType(checkedKeyResult, checkedType), requiredType(expectedKeyResult, expectedType), layouts);
    }
    if checkedType.kind == kindTuple {
        if checkedType.params.len() != expectedType.params.len() { return false; }
        var index = 0;
        loop { if index >= checkedType.params.len() { break; } if !managedNullSpecializationCompatible(checkedType.params[index], expectedType.params[index], layouts) { return false; } index = index + 1; }
        return true;
    }
    return managedTypeKey(checkedType) == managedTypeKey(expectedType);
}

func lowerExprExpected(lowerer: FunctionLowerer, expression: Expr, expected: Type): LowerValue {
    var previous = lowerer.expectedType;
    lowerer.expectedType = expected;
    var value = lowerExpr(lowerer, expression);
    lowerer.expectedType = previous;
    return value;
}

func managedLayoutKey(layout: CheckedNominalLayout): string {
    var nominal = layout.kind.toLower();
    var prefix = nominal + ":";
    if layout.kind == kindEnum { prefix = "$enum:"; }
    return prefix + layout.sourcePath.len().toString() + ":" + layout.sourcePath + layout.moduleId.len().toString() + ":" + layout.moduleId + layout.name.len().toString() + ":" + layout.name;
}

func managedTypeContainsAny(ty: Type): bool {
    if ty.kind == kindAny || ty.kind == kindUnknown { return true; }
    var maybeInner = ty.inner;
    if maybeInner != null { if managedTypeContainsAny(requiredType(maybeInner, ty)) { return true; } }
    var maybeKey = ty.key;
    if maybeKey != null { if managedTypeContainsAny(requiredType(maybeKey, ty)) { return true; } }
    var maybeValue = ty.value;
    if maybeValue != null { if managedTypeContainsAny(requiredType(maybeValue, ty)) { return true; } }
    var index = 0;
    loop { if index >= ty.params.len() { break; } if managedTypeContainsAny(ty.params[index]) { return true; } index = index + 1; }
    return false;
}

func managedTypeIsString(ty: Type): bool {
    if ty.kind == kindString { return true; }
    if ty.kind == kindNullable { var inner = ty.inner; if inner != null { return managedTypeIsString(inner); } }
    return false;
}

func managedExprIsNullLiteral(expression: Expr): bool {
    match expression {
        Expr::Literal(literal) => { return literal.kind == LiteralKind::Null; },
        _ => { return false; },
    }
}

func managedTypeUsesIdentityEquality(ty: Type): bool {
    if ty.kind == kindStruct || ty.kind == kindArray || ty.kind == kindDict { return true; }
    if ty.kind == kindNullable { var inner = ty.inner; if inner != null { return managedTypeUsesIdentityEquality(inner); } }
    return false;
}

func managedTypeUsesValueEquality(ty: Type): bool {
    if ty.kind == kindNullable { var inner = ty.inner; if inner != null { return managedTypeUsesValueEquality(inner); } }
    return ty.kind == kindTuple || ty.kind == kindEnum || ty.kind == kindOption || ty.kind == kindResult;
}

func findLayoutIdByKey(layouts: Vec<ManagedLayout>, key: string): int {
    var index = 0;
    loop { if index >= layouts.len() { break; } if layouts[index].key == key { return layouts[index].id; } index = index + 1; }
    return 0;
}

func ensureManagedLayout(catalog: ManagedCatalog, key: string, payloadBytes: int, fields: Vec<ManagedField>): int {
    var existing = findLayoutIdByKey(catalog.layouts, key);
    if existing > 0 { return existing; }
    var id = catalog.layouts.len() + 1;
    catalog.layouts.push(ManagedLayout { id: id, key: key, payloadBytes: payloadBytes, fields: fields });
    return id;
}

func ensureVariableLayout(catalog: ManagedCatalog, layoutId: int, tailKind: int) {
    var index = 0;
    loop { if index >= catalog.variableLayouts.len() { break; } if catalog.variableLayouts[index].layoutId == layoutId { return; } index = index + 1; }
    catalog.variableLayouts.push(ManagedVariableLayout { layoutId: layoutId, tailKind: tailKind });
}

func managedFieldKind(layouts: Vec<ManagedLayout>, ty: Type): IRTypeKind {
    if ty.kind == kindBool { return IRTypeKind::Bool; }
    if managedLayoutId(layouts, ty) > 0 { return IRTypeKind::RawAddress; }
    return IRTypeKind::I64;
}

func nominalLayoutForType(checked: CheckedProgram, ty: Type): CheckedNominalLayout? {
    var index = 0;
    loop {
        if index >= checked.nominalLayouts.len() { break; }
        var layout = checked.nominalLayouts[index];
        if layout.kind == ty.kind && layout.name == ty.name && layout.sourcePath == ty.sourcePath && layout.moduleId == ty.moduleId { return layout; }
        index = index + 1;
    }
    return null;
}

func catalogEnsureType(checked: CheckedProgram, catalog: ManagedCatalog, ty: Type): int {
    if catalog.error != emptyString { return -1; }
    if ty.kind == kindInt || ty.kind == kindBool || ty.kind == kindChar || ty.kind == kindVoid || ty.kind == kindNull { return 0; }
    if ty.kind == kindNullable { var inner = ty.inner; if inner != null { return catalogEnsureType(checked, catalog, inner); } catalog.error = "nullable managed type has no checked inner type"; return -1; }
    if ty.kind == kindString {
        var key = managedTypeKey(ty);
        var existing = findLayoutIdByKey(catalog.layouts, key);
        if existing > 0 { ensureVariableLayout(catalog, existing, 1); return existing; }
        var stringId = ensureManagedLayout(catalog, key, 8, [ManagedField { name: "length", offset: 0, kind: IRTypeKind::I64, layoutId: 0 }]);
        ensureVariableLayout(catalog, stringId, 1);
        return stringId;
    }
    if ty.kind == kindStruct || ty.kind == kindEnum {
        var key = managedLayoutKeyFromType(ty);
        var existing = findLayoutIdByKey(catalog.layouts, key);
        if existing > 0 { return existing; }
        var maybeNominal = nominalLayoutForType(checked, ty);
        if maybeNominal == null { catalog.error = "managed nominal type has no exact checked source/module layout: " + key; return -1; }
        var nominal = requiredNominalLayout(maybeNominal, checked.nominalLayouts[0]);
        var id = ensureManagedLayout(catalog, key, 0, []);
        if ty.kind == kindStruct {
            var fields: Vec<ManagedField> = [];
            var fieldIndex = 0;
            loop {
                if fieldIndex >= nominal.fields.len() { break; }
                var checkedField = nominal.fields[fieldIndex];
                if checkedField.fieldIndex != fieldIndex { catalog.error = "checked nominal fields are not in exact field-index order"; return -1; }
                var childId = catalogEnsureType(checked, catalog, checkedField.ty);
                if childId < 0 { return -1; }
                var fieldKind = managedFieldKind(catalog.layouts, checkedField.ty);
                if fieldKind == IRTypeKind::I64 && checkedField.ty.kind != kindInt && checkedField.ty.kind != kindChar {
                    catalog.error = "struct field has an unsupported managed type: " + checkedField.ty.kind; return -1;
                }
                if fieldKind == IRTypeKind::Bool { fieldKind = IRTypeKind::Bool; }
                fields.push(ManagedField { name: checkedField.name, offset: fieldIndex * 8, kind: fieldKind, layoutId: childId });
                fieldIndex = fieldIndex + 1;
            }
            catalog.layouts.set(id - 1, ManagedLayout { id: id, key: key, payloadBytes: fields.len() * 8, fields: fields });
            return id;
        }
        var outerFields: Vec<ManagedField> = [ManagedField { name: "tag", offset: 0, kind: IRTypeKind::I64, layoutId: 0 }, ManagedField { name: "$payload", offset: 8, kind: IRTypeKind::RawAddress, layoutId: -1 }];
        catalog.layouts.set(id - 1, ManagedLayout { id: id, key: key, payloadBytes: 16, fields: outerFields });
        var variantIndex = 0;
        loop {
            if variantIndex >= nominal.variants.len() { break; }
            var variant = nominal.variants[variantIndex];
            var payloadFields: Vec<ManagedField> = [];
            var payloadIndex = 0;
            loop {
                if payloadIndex >= variant.payloadTypes.len() { break; }
                var payloadType = variant.payloadTypes[payloadIndex];
                var payloadTypeId = catalogEnsureType(checked, catalog, payloadType);
                if payloadTypeId < 0 { return -1; }
                var fieldKind = managedFieldKind(catalog.layouts, payloadType);
                if fieldKind == IRTypeKind::I64 && payloadType.kind != kindInt && payloadType.kind != kindChar { catalog.error = "enum payload has unsupported managed type: " + payloadType.kind; return -1; }
                payloadFields.push(ManagedField { name: payloadIndex.toString(), offset: payloadIndex * 8, kind: fieldKind, layoutId: payloadTypeId });
                payloadIndex = payloadIndex + 1;
            }
            var payloadKey = "$enum-payload:" + key.len().toString() + ":" + key + variantIndex.toString();
            ensureManagedLayout(catalog, payloadKey, payloadFields.len() * 8, payloadFields);
            variantIndex = variantIndex + 1;
        }
        return id;
    }
    if ty.kind == kindTuple {
        var key = managedTypeKey(ty);
        var existing = findLayoutIdByKey(catalog.layouts, key);
        if existing > 0 { return existing; }
        var fields: Vec<ManagedField> = [];
        var index = 0;
        loop {
            if index >= ty.params.len() { break; }
            var child = ty.params[index];
            var childId = catalogEnsureType(checked, catalog, child);
            if childId < 0 { return -1; }
            var kind = managedFieldKind(catalog.layouts, child);
            if kind == IRTypeKind::I64 && child.kind != kindInt && child.kind != kindChar { catalog.error = "tuple element has unsupported managed type: " + child.kind; return -1; }
            fields.push(ManagedField { name: index.toString(), offset: index * 8, kind: kind, layoutId: childId });
            index = index + 1;
        }
        return ensureManagedLayout(catalog, key, fields.len() * 8, fields);
    }
    if ty.kind == kindOption || ty.kind == kindResult {
        var key = managedTypeKey(ty);
        var existing = findLayoutIdByKey(catalog.layouts, key);
        if existing > 0 { return existing; }
        var id = ensureManagedLayout(catalog, key, 16, [ManagedField { name: "tag", offset: 0, kind: IRTypeKind::I64, layoutId: 0 }, ManagedField { name: "$payload", offset: 8, kind: IRTypeKind::RawAddress, layoutId: -1 }]);
        var variantCount = 2;
        var variantIndex = 0;
        loop {
            if variantIndex >= variantCount { break; }
            var payloadFields: Vec<ManagedField> = [];
            if ty.kind == kindOption && variantIndex == 0 {
                var maybeInner = ty.inner;
                if maybeInner != null { var valueType = requiredType(maybeInner, managedUnknownType()); var payloadId = catalogEnsureType(checked, catalog, valueType); if payloadId < 0 { return -1; } var kind = managedFieldKind(catalog.layouts, valueType); if kind == IRTypeKind::I64 && valueType.kind != kindInt && valueType.kind != kindChar { catalog.error = "Option payload has unsupported managed type: " + valueType.kind; return -1; } payloadFields.push(ManagedField { name: "0", offset: 0, kind: kind, layoutId: payloadId }); }
            } else if ty.kind == kindResult {
                var maybePayload = ty.inner;
                if variantIndex == 1 { maybePayload = ty.key; }
                if maybePayload != null { var valueType2 = requiredType(maybePayload, managedUnknownType()); var payloadId2 = catalogEnsureType(checked, catalog, valueType2); if payloadId2 < 0 { return -1; } var kind2 = managedFieldKind(catalog.layouts, valueType2); if kind2 == IRTypeKind::I64 && valueType2.kind != kindInt && valueType2.kind != kindChar { catalog.error = "Result payload has unsupported managed type: " + valueType2.kind; return -1; } payloadFields.push(ManagedField { name: "0", offset: 0, kind: kind2, layoutId: payloadId2 }); }
            }
            var payloadKey = key + ":payload:" + variantIndex.toString();
            ensureManagedLayout(catalog, payloadKey, payloadFields.len() * 8, payloadFields);
            variantIndex = variantIndex + 1;
        }
        return id;
    }
    if ty.kind == kindArray {
        var key = managedTypeKey(ty);
        var existing = findLayoutIdByKey(catalog.layouts, key);
        if existing > 0 { return existing; }
        var maybeInner = ty.inner;
        if maybeInner == null { catalog.error = "Vec type has no checked element type"; return -1; }
        var element = requiredType(maybeInner, ty);
        var elementId = catalogEnsureType(checked, catalog, element);
        if elementId < 0 || element.kind == kindAny || element.kind == kindFloat { catalog.error = "Vec element type is unsupported by managed storage: " + element.kind; return -1; }
        var tailKind = 1;
        if managedLayoutId(catalog.layouts, element) > 0 { tailKind = 2; }
        var backingKey = "$vec-backing:" + managedTypeKey(element);
        var backingFields: Vec<ManagedField> = [ManagedField { name: "length", offset: 0, kind: IRTypeKind::I64, layoutId: 0 }];
        var backingId = ensureManagedLayout(catalog, backingKey, 8, backingFields);
        ensureVariableLayout(catalog, backingId, tailKind);
        return ensureManagedLayout(catalog, key, 8, [ManagedField { name: "data", offset: 0, kind: IRTypeKind::RawAddress, layoutId: backingId }]);
    }
    if ty.kind == kindDict {
        var key = managedTypeKey(ty);
        var existing = findLayoutIdByKey(catalog.layouts, key);
        if existing > 0 { return existing; }
        var maybeValue = ty.value;
        if maybeValue == null { catalog.error = "HashMap type has no checked value type"; return -1; }
        var value = requiredType(maybeValue, ty);
        var valueId = catalogEnsureType(checked, catalog, value);
        if valueId < 0 || value.kind == kindAny || value.kind == kindFloat { catalog.error = "HashMap value type is unsupported by managed storage: " + value.kind; return -1; }
        var stringType = Type { kind: kindString, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
        var stringId = catalogEnsureType(checked, catalog, stringType);
        var nodeKey = "$map-node:" + managedTypeKey(value);
        var nodeId = ensureManagedLayout(catalog, nodeKey, 0, []);
        var nodeFields: Vec<ManagedField> = [ManagedField { name: "key", offset: 0, kind: IRTypeKind::RawAddress, layoutId: stringId }, ManagedField { name: "value", offset: 8, kind: managedFieldKind(catalog.layouts, value), layoutId: valueId }, ManagedField { name: "next", offset: 16, kind: IRTypeKind::RawAddress, layoutId: nodeId }];
        if nodeFields[1].kind == IRTypeKind::I64 && value.kind != kindInt && value.kind != kindChar { catalog.error = "HashMap value has unsupported managed type: " + value.kind; return -1; }
        catalog.layouts.set(nodeId - 1, ManagedLayout { id: nodeId, key: nodeKey, payloadBytes: 24, fields: nodeFields });
        var bucketKey = "$map-buckets:" + managedTypeKey(value);
        var bucketId = ensureManagedLayout(catalog, bucketKey, 8, [ManagedField { name: "initialized", offset: 0, kind: IRTypeKind::I64, layoutId: 0 }]);
        ensureVariableLayout(catalog, bucketId, 2);
        return ensureManagedLayout(catalog, key, 16, [ManagedField { name: "buckets", offset: 0, kind: IRTypeKind::RawAddress, layoutId: bucketId }, ManagedField { name: "length", offset: 8, kind: IRTypeKind::I64, layoutId: 0 }]);
    }
    catalog.error = "managed lowering does not support type family " + ty.kind + " (" + managedTypeKey(ty) + ") at " + ty.sourcePath + " name=" + ty.name;
    return -1;
}

func managedLayoutKeyFromType(ty: Type): string {
    return managedTypeKey(ty);
}

func buildManagedLayouts(checked: CheckedProgram): Result<ManagedCatalog, string> {
    var catalog = ManagedCatalog { layouts: [], variableLayouts: [], error: emptyString };
    var builtinStringType = Type { kind: kindString, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
    catalogEnsureType(checked, catalog, builtinStringType);
    if catalog.error != emptyString { return Result.Err(lowerError(checked.entryPath, 0, catalog.error)); }
    var index = 0;
    loop { if index >= checked.nominalLayouts.len() { break; } var layout = checked.nominalLayouts[index]; var ty = Type { kind: layout.kind, name: layout.name, sourcePath: layout.sourcePath, moduleId: layout.moduleId, inner: null, key: null, value: null, params: [], ret: null }; catalogEnsureType(checked, catalog, ty); if catalog.error != emptyString { return Result.Err(lowerError(layout.sourcePath, 0, catalog.error)); } index = index + 1; }
    index = 0;
    loop { if index >= checked.bindings.len() { break; } var bindingType = checked.bindings[index].ty; if bindingType.kind != kindFunction && !managedTypeContainsAny(bindingType) { catalogEnsureType(checked, catalog, bindingType); if catalog.error != emptyString { return Result.Err(lowerError(checked.bindings[index].sourcePath, 0, catalog.error)); } } index = index + 1; }
    index = 0;
    // Null-only leaves in literal/call expression metadata are holes, not storage
    // descriptors. Their enclosing binding, field, parameter, or return type is
    // cataloged above and supplies the exact nullable reference layout at lowering.
    loop { if index >= checked.expressions.len() { break; } var expressionType = checked.expressions[index].ty; if expressionType.kind != kindFunction && !managedTypeContainsAny(expressionType) && !managedTypeHasNullLeaf(expressionType) { catalogEnsureType(checked, catalog, expressionType); if catalog.error != emptyString { return Result.Err(lowerError(checked.expressions[index].sourcePath, exprSpan(checked.expressions[index].expression).start, catalog.error)); } } index = index + 1; }
    index = 0;
    loop { if index >= checked.symbols.len() { break; } var symbol = checked.symbols[index]; if symbol.kind == kindFunction && symbol.receiverPassing == litNone { var signature = symbol.signature; var parameterIndex = 0; loop { if parameterIndex >= signature.params.len() { break; } var parameterType = signature.params[parameterIndex]; if parameterType.kind != kindFunction && !managedTypeContainsAny(parameterType) { catalogEnsureType(checked, catalog, parameterType); if catalog.error != emptyString { return Result.Err(lowerError(symbol.sourcePath, 0, catalog.error)); } } parameterIndex = parameterIndex + 1; } var maybeResultType = signature.ret; if maybeResultType != null { var resultType = requiredType(maybeResultType, managedUnknownType()); if resultType.kind != kindFunction && !managedTypeContainsAny(resultType) { catalogEnsureType(checked, catalog, resultType); if catalog.error != emptyString { return Result.Err(lowerError(symbol.sourcePath, 0, catalog.error)); } } } } index = index + 1; }
    return Result.Ok(catalog);
}

func toIRType(ty: Type): IRType {
    if ty.kind == kindInt { return irI64(); }
    if ty.kind == kindBool { return irBool(); }
    if ty.kind == kindChar { return irI64(); }
    if ty.kind == kindRawAddress { return ir.irRawAddress(); }
    return irVoid();
}

func functionTypeResult(ty: Type): Type {
    var result = ty.ret;
    if result != null { return result; }
    return managedUnknownType();
}

func findFunctionSymbol(checked: CheckedProgram, sourcePath: string, moduleId: string, declarationIndex: int): ResolvedSymbol? {
    var i = 0;
    loop {
        if i >= checked.symbols.len() { break; }
        var symbol = checked.symbols[i];
        if symbol.sourcePath == sourcePath && symbol.moduleId == moduleId && symbol.declarationIndex == declarationIndex && symbol.kind == kindFunction && symbol.receiverPassing == litNone {
            return symbol;
        }
        i = i + 1;
    }
    return null;
}

func findPlanForSymbol(plans: Vec<FunctionPlan>, symbol: ResolvedSymbol): int {
    var i = 0;
    loop {
        if i >= plans.len() { break; }
        var plan = plans[i];
        if plan.sourcePath == symbol.sourcePath && plan.moduleId == symbol.moduleId && plan.sourceName == symbol.sourceName {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

func preflightFunction(checked: CheckedProgram, sourcePath: string, moduleId: string, declaration: FuncDeclStmt, declarationIndex: int, id: int, isEntrySource: bool, managed: bool, managedLayouts: Vec<ManagedLayout>): Result<FunctionPlan, string> {
    var maybeSymbol = findFunctionSymbol(checked, sourcePath, moduleId, declarationIndex);
    if maybeSymbol != null {
    var symbol = requiredResolvedSymbol(maybeSymbol, checked.symbols[0]);
    if symbol.signature.kind != kindFunction {
        return Result.Err(lowerError(sourcePath, declaration.span.start, "checked function signature is not callable"));
    }
    if symbol.signature.params.len() != declaration.params.len() {
        return Result.Err(lowerError(sourcePath, declaration.span.start, "checked function parameter metadata does not match its declaration"));
    }
    var parameterTypes: Vec<IRType> = [];
    var parameterLayouts: Vec<int> = [];
    var parameterIndex = 0;
    loop {
        if parameterIndex >= declaration.params.len() { break; }
        var parameter = declaration.params[parameterIndex];
        if parameter.variadic && !managed {
            return Result.Err(lowerError(sourcePath, declaration.span.start, "variadic parameters require managed IR lowering"));
        }
        var checkedParameterType = symbol.signature.params[parameterIndex];
        if managed {
            if !managedTypeIsSupported(checked, managedLayouts, checkedParameterType, false) {
                return Result.Err(lowerError(sourcePath, declaration.span.start, "parameter '" + parameter.name + "' has unsupported managed type " + checkedParameterType.kind));
            }
            parameterTypes.push(managedIRType(managedLayouts, checkedParameterType));
            parameterLayouts.push(managedLayoutId(managedLayouts, checkedParameterType));
        } else {
            if !checkedTypeIsValue(checkedParameterType) {
                return Result.Err(lowerError(sourcePath, declaration.span.start, "parameter '" + parameter.name + "' has unsupported type " + checkedParameterType.kind));
            }
            parameterTypes.push(toIRType(checkedParameterType));
            parameterLayouts.push(0);
        }
        parameterIndex = parameterIndex + 1;
    }
    var resultType = functionTypeResult(symbol.signature);
    var returnLayout = 0;
    if managed {
        if !managedTypeIsSupported(checked, managedLayouts, resultType, false) {
            return Result.Err(lowerError(sourcePath, declaration.span.start, "function result has unsupported managed type " + resultType.kind));
        }
        returnLayout = managedLayoutId(managedLayouts, resultType);
    } else if !checkedTypeIsSupported(resultType) {
        return Result.Err(lowerError(sourcePath, declaration.span.start, "function result has unsupported type " + resultType.kind));
    }
    var irResult = toIRType(resultType);
    if managed { irResult = managedIRType(managedLayouts, resultType); }
    if isEntrySource && declaration.name == litMain && (declaration.params.len() != 0 || irResult.kind != IRTypeKind::Void) {
        return Result.Err(lowerError(sourcePath, declaration.span.start, "IR entry main must take no parameters and return void"));
    }
    return Result.Ok(FunctionPlan {
        id: id,
        sourcePath: sourcePath,
        moduleId: moduleId,
        sourceName: symbol.sourceName,
        declarationIndex: declarationIndex,
        declaration: declaration,
        symbol: symbol,
        parameterTypes: parameterTypes,
        parameterLayouts: parameterLayouts,
        returnType: irResult,
        returnLayout: returnLayout,
    });
    }
    return Result.Err(lowerError(sourcePath, declaration.span.start, "checked function has no matching resolved symbol"));
}

func exprKindCode(expression: Expr): int {
    match expression {
        Expr::Error(_) => { return 1; },
        Expr::Literal(_) => { return 2; },
        Expr::Identifier(_) => { return 3; },
        Expr::Binary(_) => { return 4; },
        Expr::Unary(_) => { return 5; },
        Expr::Update(_) => { return 6; },
        Expr::Call(_) => { return 7; },
        Expr::EnumVariant(_) => { return 8; },
        Expr::Index(_) => { return 9; },
        Expr::FieldAccess(_) => { return 10; },
        Expr::Lambda(_) => { return 11; },
        Expr::Match(_) => { return 12; },
        Expr::If(_) => { return 13; },
        Expr::Tuple(_) => { return 14; },
        Expr::Array(_) => { return 15; },
        Expr::Dict(_) => { return 16; },
        Expr::StructLiteral(_) => { return 17; },
    }
}

func exprEntryLess(left: ExprSpanEntry, right: ExprSpanEntry): bool {
    if left.spanStart != right.spanStart { return left.spanStart < right.spanStart; }
    if left.spanEnd != right.spanEnd { return left.spanEnd < right.spanEnd; }
    if left.kindCode != right.kindCode { return left.kindCode < right.kindCode; }
    return left.infoIndex < right.infoIndex;
}

func siftExprEntries(entries: Vec<ExprSpanEntry>, start: int, count: int): Vec<ExprSpanEntry> {
    var root = start;
    var sorted = entries;
    loop {
        var child = root * 2 + 1;
        if child >= count { break; }
        if child + 1 < count && exprEntryLess(sorted[child], sorted[child + 1]) { child = child + 1; }
        if exprEntryLess(sorted[root], sorted[child]) {
            var swapped = sorted[root];
            sorted.set(root, sorted[child]);
            sorted.set(child, swapped);
            root = child;
        } else { break; }
    }
    return sorted;
}

func sortExprEntries(entries: Vec<ExprSpanEntry>): Vec<ExprSpanEntry> {
    var sorted = entries;
    var count = sorted.len();
    if count < 2 { return sorted; }
    var start = count / 2 - 1;
    loop {
        sorted = siftExprEntries(sorted, start, count);
        if start == 0 { break; }
        start = start - 1;
    }
    var end = count - 1;
    loop {
        if end <= 0 { break; }
        var swapped = sorted[0];
        sorted.set(0, sorted[end]);
        sorted.set(end, swapped);
        sorted = siftExprEntries(sorted, 0, end);
        end = end - 1;
    }
    return sorted;
}

func addExprPathPart(parts: Vec<string>, part: string, absolute: bool): Vec<string> {
    if part == "" || part == "." { return parts; }
    if part == ".." {
        if parts.len() > 0 {
            var last = parts[parts.len() - 1];
            if last != ".." { parts.pop(); return parts; }
        }
        if !absolute { parts.push(part); }
        return parts;
    }
    parts.push(part);
    return parts;
}

func collapseExprPath(path: string): string {
    var absolute = path.startsWith("/");
    var parts: Vec<string> = [];
    var part = "";
    var i = 0;
    loop {
        if i >= path.len() { break; }
        var char = path.slice(i, i + 1);
        if char == "/" {
            parts = addExprPathPart(parts, part, absolute);
            part = "";
        } else {
            part = part + char;
        }
        i = i + 1;
    }
    parts = addExprPathPart(parts, part, absolute);
    var out = "";
    if absolute { out = "/"; }
    i = 0;
    loop {
        if i >= parts.len() { break; }
        if out.len() > 0 && out != "/" { out = out + "/"; }
        out = out + parts[i];
        i = i + 1;
    }
    if out.len() == 0 { return "."; }
    return out;
}

func exprDirname(path: string): string {
    var slash = path.len() - 1;
    loop {
        if slash < 0 { break; }
        if path.slice(slash, slash + 1) == "/" {
            if slash == 0 { return "/"; }
            return path.slice(0, slash);
        }
        slash = slash - 1;
    }
    return ".";
}

func collapsedExprQuery(path: string): string {
    if activeExprQueryReady && path == activeExprQueryRaw { return activeExprQueryKey; }
    var key = collapseExprPath(path);
    activeExprQueryRaw = path;
    activeExprQueryKey = key;
    activeExprQueryReady = true;
    return key;
}

func lowerBoundActive(spanStart: int): int {
    var low = activeExprWindowStart;
    var high = activeExprWindowStart + activeExprWindowCount;
    loop {
        if low >= high { break; }
        var mid = low + (high - low) / 2;
        if activeExprFlat[mid].spanStart < spanStart { low = mid + 1; }
        else { high = mid; }
    }
    return low;
}

func prepareExprRange(key: string): bool {
    if activeExprRangeIndex >= 0 && activeExprRangeKey == key {
        var cached = activeExprRanges[activeExprRangeIndex];
        activeExprWindowStart = cached.start;
        activeExprWindowCount = cached.count;
        return true;
    }
    var rangeIndex = 0;
    loop {
        if rangeIndex >= activeExprRanges.len() { return false; }
        var range = activeExprRanges[rangeIndex];
        if range.path == key {
            activeExprRangeKey = key;
            activeExprRangeIndex = rangeIndex;
            activeExprWindowStart = range.start;
            activeExprWindowCount = range.count;
            return true;
        }
        rangeIndex = rangeIndex + 1;
    }
    return false;
}

func sameExprModule(info: CheckedExprInfo, sourcePath: string, moduleId: string, key: string): bool {
    if info.moduleId == moduleId { return true; }
    if info.sourcePath == sourcePath { return true; }
    return collapseExprPath(info.sourcePath) == key || collapseExprPath(info.moduleId) == collapseExprPath(moduleId);
}

func searchActiveWindow(checked: CheckedProgram, sourcePath: string, moduleId: string, expression: Expr, key: string): CheckedExprInfo? {
    var span = exprSpan(expression);
    var kindCode = exprKindCode(expression);
    var end = activeExprWindowStart + activeExprWindowCount;
    var cursor = lowerBoundActive(span.start);
    var onlyIndex = -1;
    var matchCount = 0;
    loop {
        if cursor >= end { break; }
        var entry = activeExprFlat[cursor];
        if entry.spanStart != span.start { break; }
        if entry.spanEnd == span.end && entry.kindCode == kindCode {
            onlyIndex = entry.infoIndex;
            matchCount = matchCount + 1;
        }
        cursor = cursor + 1;
    }
    if matchCount == 0 {
        var scan = activeExprWindowStart;
        loop {
            if scan >= end { break; }
            var scanned = activeExprFlat[scan];
            if scanned.spanStart == span.start && scanned.spanEnd == span.end && scanned.kindCode == kindCode {
                onlyIndex = scanned.infoIndex;
                matchCount = matchCount + 1;
                if matchCount > 1 { break; }
            }
            scan = scan + 1;
        }
    }
    if matchCount == 1 {
        var only = checked.expressions[onlyIndex];
        if sameExprModule(only, sourcePath, moduleId, key) { return only; }
        if only.expression == expression { return only; }
        return null;
    }
    if matchCount > 1 {
        var again = lowerBoundActive(span.start);
        loop {
            if again >= end { break; }
            var candidateEntry = activeExprFlat[again];
            if candidateEntry.spanStart != span.start { break; }
            if candidateEntry.spanEnd == span.end && candidateEntry.kindCode == kindCode {
                var candidate = checked.expressions[candidateEntry.infoIndex];
                if sameExprModule(candidate, sourcePath, moduleId, key) && candidate.expression == expression { return candidate; }
            }
            again = again + 1;
        }
    }
    return null;
}

func searchExprKey(checked: CheckedProgram, sourcePath: string, moduleId: string, expression: Expr, key: string): CheckedExprInfo? {
    if !prepareExprRange(key) { return null; }
    var hit = searchActiveWindow(checked, sourcePath, moduleId, expression, key);
    if hit != null { return hit; }
    var rangeIndex = 0;
    loop {
        if rangeIndex >= activeExprRanges.len() { break; }
        if rangeIndex != activeExprRangeIndex && activeExprRanges[rangeIndex].path == key {
            var range = activeExprRanges[rangeIndex];
            activeExprWindowStart = range.start;
            activeExprWindowCount = range.count;
            var extra = searchActiveWindow(checked, sourcePath, moduleId, expression, key);
            if extra != null {
                activeExprRangeKey = key;
                activeExprRangeIndex = rangeIndex;
                return extra;
            }
        }
        rangeIndex = rangeIndex + 1;
    }
    return null;
}

func buildExprIndex(checked: CheckedProgram) {
    activeExprFlat = [];
    activeExprRanges = [];
    activeExprRoot = exprDirname(collapseExprPath(checked.entryPath));
    activeExprQueryReady = false;
    activeExprQueryRaw = emptyString;
    activeExprQueryKey = emptyString;
    activeExprRangeKey = emptyString;
    activeExprRangeIndex = -1;
    activeExprWindowStart = 0;
    activeExprWindowCount = 0;
    activeExprReady = false;
    var paths: Vec<string> = [];
    var groups: Vec<Vec<ExprSpanEntry>> = [];
    var pathGroups: HashMap<string, int> = HashMap.new();
    var index = 0;
    loop {
        if index >= checked.expressions.len() { break; }
        var info = checked.expressions[index];
        var found = -1;
        if pathGroups.has(info.sourcePath) { found = pathGroups.get(info.sourcePath); }
        var span = exprSpan(info.expression);
        var entry = ExprSpanEntry { spanStart: span.start, spanEnd: span.end, kindCode: exprKindCode(info.expression), nodeId: info.nodeId, infoIndex: index };
        if found < 0 {
            paths.push(info.sourcePath);
            var fresh: Vec<ExprSpanEntry> = [entry];
            groups.push(fresh);
            pathGroups.set(info.sourcePath, groups.len() - 1);
        } else {
            var group = groups[found];
            group.push(entry);
            groups.set(found, group);
        }
        index = index + 1;
    }
    var groupIndex = 0;
    loop {
        if groupIndex >= groups.len() { break; }
        var sorted = sortExprEntries(groups[groupIndex]);
        var rangeStart = activeExprFlat.len();
        var entryIndex = 0;
        loop {
            if entryIndex >= sorted.len() { break; }
            activeExprFlat.push(sorted[entryIndex]);
            entryIndex = entryIndex + 1;
        }
        activeExprRanges.push(ExprFileRange { path: collapseExprPath(paths[groupIndex]), start: rangeStart, count: sorted.len() });
        groupIndex = groupIndex + 1;
    }
    activeExprReady = true;
}

func findExprInfo(checked: CheckedProgram, sourcePath: string, moduleId: string, expression: Expr): CheckedExprInfo? {
    if activeExprReady {
        var key = collapsedExprQuery(sourcePath);
        var hit = searchExprKey(checked, sourcePath, moduleId, expression, key);
        if hit != null { return hit; }
        if !key.startsWith("/") && activeExprRoot != "" && activeExprRoot != "." {
            var rooted = collapseExprPath(activeExprRoot + "/" + key);
            if rooted != key {
                var rootedHit = searchExprKey(checked, sourcePath, moduleId, expression, rooted);
                if rootedHit != null { return rootedHit; }
            }
        }
    }
    var i = 0;
    loop {
        if i >= checked.expressions.len() { break; }
        var info = checked.expressions[i];
        if info.sourcePath == sourcePath && info.moduleId == moduleId && info.expression == expression { return info; }
        i = i + 1;
    }
    return null;
}

func findManagedLayout(layouts: Vec<ManagedLayout>, layoutId: int): ManagedLayout? {
    if layoutId <= 0 || layoutId > layouts.len() { return null; }
    var layout = layouts[layoutId - 1];
    if layout.id != layoutId { return null; }
    return layout;
}

func findFieldInitializer(checked: CheckedProgram, sourcePath: string, moduleId: string, expression: Expr, literal: StructLiteralExpr, initializer: StructInitField): CheckedFieldInitInfo? {
    var found: CheckedFieldInitInfo? = null;
    var index = 0;
    loop {
        if index >= checked.fieldInitializers.len() { break; }
        var info = checked.fieldInitializers[index];
        if info.sourcePath == sourcePath && info.moduleId == moduleId && info.expression == expression && info.literal == literal && info.initializer == initializer {
            if found != null { return null; }
            found = info;
        }
        index = index + 1;
    }
    return found;
}

func lowerBoolAsI64(lowerer: FunctionLowerer, valueId: int, source: SourceRef): IRValue {
    var result = allocateValue(lowerer, irI64());
    var resultParams: Vec<IRValue> = [result];
    var trueBlock = reserveBlock(lowerer, []);
    var falseBlock = reserveBlock(lowerer, []);
    var mergeBlock = reserveBlock(lowerer, resultParams);
    finishBlock(lowerer, branch(valueId, trueBlock, [], falseBlock, [], source));
    enterBlock(lowerer, trueBlock, []);
    var one = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(one.id, 1, source));
    finishBlock(lowerer, jump(mergeBlock, [one.id], source));
    enterBlock(lowerer, falseBlock, []);
    var zero = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(zero.id, 0, source));
    finishBlock(lowerer, jump(mergeBlock, [zero.id], source));
    enterBlock(lowerer, mergeBlock, resultParams);
    return result;
}

func managedFieldForAccess(lowerer: FunctionLowerer, expression: Expr, access: FieldAccessExpr): ManagedField? {
    var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
    if maybeInfo == null { lowerer.error = lowerError(lowerer.sourcePath, access.span.start, "checked field access metadata is missing"); return null; }
    var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
    if info.receiverType.kind == kindTuple {
        var tupleLayoutId = managedLayoutId(lowerer.managedLayouts, info.receiverType);
        var maybeTupleLayout = findManagedLayout(lowerer.managedLayouts, tupleLayoutId);
        if maybeTupleLayout == null { lowerer.error = lowerError(lowerer.sourcePath, access.span.start, "tuple receiver has no exact managed layout"); return null; }
        var tupleLayout = requiredManagedLayout(maybeTupleLayout, lowerer.managedLayouts[0]);
        if info.fieldIndex < 0 || info.fieldIndex >= tupleLayout.fields.len() || tupleLayout.fields[info.fieldIndex].name != info.fieldIndex.toString() {
            lowerer.error = lowerError(lowerer.sourcePath, access.span.start, "checked tuple member index is outside its exact layout");
            return null;
        }
        var tupleField = tupleLayout.fields[info.fieldIndex];
        if tupleField.kind != managedIRType(lowerer.managedLayouts, info.ty).kind || tupleField.layoutId != managedLayoutId(lowerer.managedLayouts, info.ty) {
            lowerer.error = lowerError(lowerer.sourcePath, access.span.start, "checked tuple member type differs from its exact layout");
            return null;
        }
        return tupleField;
    }
    var layoutId = managedLayoutId(lowerer.managedLayouts, info.receiverType);
    var maybeLayout = findManagedLayout(lowerer.managedLayouts, layoutId);
    if maybeLayout == null { lowerer.error = lowerError(lowerer.sourcePath, access.span.start, "field receiver has no owner-matched managed layout"); return null; }
    var layout = requiredManagedLayout(maybeLayout, lowerer.managedLayouts[0]);
    if info.fieldIndex < 0 || info.fieldIndex >= layout.fields.len() {
        lowerer.error = lowerError(lowerer.sourcePath, access.span.start, "checked field index is outside its managed layout");
        return null;
    }
    var field = layout.fields[info.fieldIndex];
    if field.name != access.name {
        lowerer.error = lowerError(lowerer.sourcePath, access.span.start, "checked field index does not identify the source field");
        return null;
    }
    var checkedFieldLayout = managedLayoutId(lowerer.managedLayouts, info.ty);
    if checkedFieldLayout != field.layoutId || managedIRType(lowerer.managedLayouts, info.ty).kind != field.kind {
        lowerer.error = lowerError(lowerer.sourcePath, access.span.start, "checked field type does not match its nominal layout metadata");
        return null;
    }
    return field;
}

func emitManagedFieldStore(lowerer: FunctionLowerer, owner: IRValue, field: ManagedField, value: LowerValue, span: Span): bool {
    var source = spanRef(lowerer.sourcePath, span);
    if owner.ty.kind != IRTypeKind::RawAddress || value.id < 0 {
        lowerer.error = lowerError(lowerer.sourcePath, span.start, "managed field store requires a reference owner and a value");
        return false;
    }
    if field.kind == IRTypeKind::RawAddress {
        if value.ty.kind != IRTypeKind::RawAddress {
            lowerer.error = lowerError(lowerer.sourcePath, span.start, "managed reference field value has the wrong IR type");
            return false;
        }
        var offset = allocateValue(lowerer, irI64());
        appendInstruction(lowerer, constI64(offset.id, field.offset, source));
        appendInstruction(lowerer, call(-1, irVoid(), lowerer.storeReferenceFunctionId, [owner.id, offset.id, value.id], source));
        return lowerer.error == emptyString;
    }
    var storedValue = value;
    if field.kind == IRTypeKind::Bool {
        if value.ty.kind != IRTypeKind::Bool {
            lowerer.error = lowerError(lowerer.sourcePath, span.start, "managed bool field value has the wrong IR type");
            return false;
        }
        var encoded = lowerBoolAsI64(lowerer, value.id, source);
        storedValue = LowerValue { id: encoded.id, ty: encoded.ty };
    } else if value.ty.kind != IRTypeKind::I64 {
        lowerer.error = lowerError(lowerer.sourcePath, span.start, "managed integer field value has the wrong IR type");
        return false;
    }
    var headerOffset = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(headerOffset.id, 16 + field.offset, source));
    var address = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(address.id, owner.id, headerOffset.id, source));
    appendInstruction(lowerer, ir.rawStoreI64(address.id, storedValue.id, source));
    return lowerer.error == emptyString;
}

func initializeManagedFieldZero(lowerer: FunctionLowerer, owner: IRValue, field: ManagedField, source: SourceRef): bool {
    if field.kind == IRTypeKind::RawAddress {
        var nullValue = allocateValue(lowerer, ir.irRawAddress());
        appendInstruction(lowerer, ir.rawNull(nullValue.id, source));
        var payloadOffset = allocateValue(lowerer, irI64());
        appendInstruction(lowerer, constI64(payloadOffset.id, field.offset, source));
        appendInstruction(lowerer, call(-1, irVoid(), lowerer.storeReferenceFunctionId, [owner.id, payloadOffset.id, nullValue.id], source));
        return lowerer.error == emptyString;
    }
    var zero = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(zero.id, 0, source));
    var headerOffset = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(headerOffset.id, 16 + field.offset, source));
    var address = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(address.id, owner.id, headerOffset.id, source));
    appendInstruction(lowerer, ir.rawStoreI64(address.id, zero.id, source));
    return lowerer.error == emptyString;
}

func managedCallHook(lowerer: FunctionLowerer, runtimeName: string, resultType: IRType, operands: Vec<int>, source: SourceRef): LowerValue {
    var functionId = managedHookId(lowerer.hooks, runtimeName);
    if functionId < 0 {
        lowerer.error = lowerError(lowerer.sourcePath, source.start, "managed runtime helper is not declared in the hook catalog: " + runtimeName);
        return LowerValue { id: -1, ty: irVoid() };
    }
    var resultId = -1;
    if resultType.kind != IRTypeKind::Void { resultId = allocateValue(lowerer, resultType).id; }
    appendInstruction(lowerer, call(resultId, resultType, functionId, operands, source));
    return LowerValue { id: resultId, ty: resultType };
}

func lowerManagedI64AsBool(lowerer: FunctionLowerer, value: LowerValue, source: SourceRef): LowerValue {
    if value.id < 0 || value.ty.kind != IRTypeKind::I64 { return LowerValue { id: -1, ty: irVoid() }; }
    var zero = managedI64Constant(lowerer, 0, source);
    var result = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, compareI64(result.id, ir.compareNe(), value.id, zero.id, source));
    return LowerValue { id: result.id, ty: result.ty };
}

func managedI64Constant(lowerer: FunctionLowerer, value: int, source: SourceRef): IRValue {
    var constant = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(constant.id, value, source));
    return constant;
}

func managedStringLayoutId(lowerer: FunctionLowerer): int {
    if layoutCacheReady && cachedStringLayout >= -1 { return cachedStringLayout; }
    var stringType = Type { kind: kindString, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
    var id = managedLayoutId(lowerer.managedLayouts, stringType);
    if layoutCacheReady { cachedStringLayout = id; }
    return id;
}

func lowerManagedStringLiteral(lowerer: FunctionLowerer, expression: Expr, literal: LiteralExpr): LowerValue {
    var source = spanRef(lowerer.sourcePath, literal.span);
    var layoutId = managedStringLayoutId(lowerer);
    if layoutId <= 0 { return failExpression(lowerer, expression, "managed string layout is missing from the checked catalog"); }
    var layoutValue = managedI64Constant(lowerer, layoutId, source);
    var textLength = literal.text.len();
    var payloadBytes = 8 + textLength + 1;
    var sizeValue = managedI64Constant(lowerer, payloadBytes, source);
    var object = managedCallHook(lowerer, "managedAllocateSized", ir.irRawAddress(), [layoutValue.id, sizeValue.id], source);
    if lowerer.error != emptyString { return object; }
    var lengthValue = managedI64Constant(lowerer, textLength, source);
    var lengthOffset = managedI64Constant(lowerer, 16, source);
    var lengthAddress = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(lengthAddress.id, object.id, lengthOffset.id, source));
    appendInstruction(lowerer, ir.rawStoreI64(lengthAddress.id, lengthValue.id, source));
    var byteText = emptyString;
    var packedIndex = 0;
    loop {
        if textLength - packedIndex < 8 { break; }
        var highByteText = literal.text.slice(packedIndex + 7, packedIndex + 8);
        var packedValue = highByteText.hash();
        if packedValue >= 128 { packedValue = packedValue - 256; }
        var byteIndex = packedIndex + 6;
        loop {
            if byteIndex < packedIndex { break; }
            byteText = literal.text.slice(byteIndex, byteIndex + 1);
            packedValue = packedValue * 256 + byteText.hash();
            byteIndex = byteIndex - 1;
        }
        var storedWord = managedI64Constant(lowerer, packedValue, source);
        var wordOffset = managedI64Constant(lowerer, 24 + packedIndex, source);
        var wordAddress = allocateValue(lowerer, ir.irRawAddress());
        appendInstruction(lowerer, ir.rawOffset(wordAddress.id, object.id, wordOffset.id, source));
        appendInstruction(lowerer, ir.rawStoreI64(wordAddress.id, storedWord.id, source));
        packedIndex = packedIndex + 8;
    }
    var index = packedIndex;
    loop {
        if index >= textLength { break; }
        byteText = literal.text.slice(index, index + 1);
        var byteValue = byteText.hash();
        var storedByte = managedI64Constant(lowerer, byteValue, source);
        var byteOffset = managedI64Constant(lowerer, 24 + index, source);
        var byteAddress = allocateValue(lowerer, ir.irRawAddress());
        appendInstruction(lowerer, ir.rawOffset(byteAddress.id, object.id, byteOffset.id, source));
        appendInstruction(lowerer, ir.rawStoreByte(byteAddress.id, storedByte.id, source));
        index = index + 1;
    }
    var terminatorByte = managedI64Constant(lowerer, 0, source);
    var terminatorOffset = managedI64Constant(lowerer, 24 + textLength, source);
    var terminatorAddress = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(terminatorAddress.id, object.id, terminatorOffset.id, source));
    appendInstruction(lowerer, ir.rawStoreByte(terminatorAddress.id, terminatorByte.id, source));
    return object;
}

func lowerManagedTupleLiteral(lowerer: FunctionLowerer, expression: Expr, tuple: TupleExpr): LowerValue {
    var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
    if maybeInfo == null { return failExpression(lowerer, expression, "checked tuple expression type is missing"); }
    var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
    var tupleType = managedExpressionType(lowerer, info.ty);
    var layoutId = managedLayoutId(lowerer.managedLayouts, tupleType);
    var maybeLayout = findManagedLayout(lowerer.managedLayouts, layoutId);
    if tupleType.kind != kindTuple || maybeLayout == null { return failExpression(lowerer, expression, "tuple expression has no exact checked tuple layout"); }
    var layout = requiredManagedLayout(maybeLayout, lowerer.managedLayouts[0]);
    var source = spanRef(lowerer.sourcePath, tuple.span);
    var layoutValue = managedI64Constant(lowerer, layoutId, source);
    var object = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, call(object.id, object.ty, lowerer.allocateFunctionId, [layoutValue.id], source));
    var fieldIndex = 0;
    loop { if fieldIndex >= layout.fields.len() { break; } if !initializeManagedFieldZero(lowerer, object, layout.fields[fieldIndex], source) { return LowerValue { id: -1, ty: irVoid() }; } fieldIndex = fieldIndex + 1; }
    if tuple.elements.len() != tupleType.params.len() { return failExpression(lowerer, expression, "tuple literal arity differs from its checked type"); }
    fieldIndex = 0;
    loop {
        if fieldIndex >= tuple.elements.len() { break; }
        var elementType = tupleType.params[fieldIndex];
        var element = lowerExprExpected(lowerer, tuple.elements[fieldIndex], elementType);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        if !emitManagedFieldStore(lowerer, object, layout.fields[fieldIndex], element, tuple.span) { return LowerValue { id: -1, ty: irVoid() }; }
        fieldIndex = fieldIndex + 1;
    }
    return LowerValue { id: object.id, ty: object.ty };
}

func managedArrayElementType(ty: Type): Type {
    var inner = ty.inner;
    if inner != null { return inner; }
    return Type { kind: kindUnknown, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
}

func cachedDerivedLayoutId(cache: HashMap<string, int>, layouts: Vec<ManagedLayout>, prefix: string, typeKey: string): int {
    var cached = cachedLayoutId(cache, typeKey);
    if cached != -2 { return cached; }
    var id = findLayoutIdByKey(layouts, prefix + typeKey);
    rememberLayoutId(cache, typeKey, id);
    return id;
}

func managedArrayBackingLayoutId(lowerer: FunctionLowerer, elementType: Type): int {
    return cachedDerivedLayoutId(backingIds, lowerer.managedLayouts, prefixBacking, managedTypeKey(elementType));
}

func managedMapBucketsLayoutId(lowerer: FunctionLowerer, valueType: Type): int {
    return cachedDerivedLayoutId(bucketIds, lowerer.managedLayouts, prefixBuckets, managedTypeKey(valueType));
}

func managedMapNodeLayoutId(lowerer: FunctionLowerer, valueType: Type): int {
    return cachedDerivedLayoutId(nodeIds, lowerer.managedLayouts, prefixNode, managedTypeKey(valueType));
}

func lowerManagedArrayLiteral(lowerer: FunctionLowerer, expression: Expr, array: ArrayExpr): LowerValue {
    var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
    if maybeInfo == null { return failExpression(lowerer, expression, "checked Vec literal type is missing"); }
    var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
    var vectorType = managedExpressionType(lowerer, info.ty);
    if vectorType.kind != kindArray { return failExpression(lowerer, expression, "array literal does not have a checked Vec type"); }
    var elementType = managedArrayElementType(vectorType);
    if elementType.kind == kindUnknown || elementType.kind == kindAny || elementType.kind == kindFloat { return failExpression(lowerer, expression, "Vec literal requires a supported concrete checked element type"); }
    var vectorLayout = managedLayoutId(lowerer.managedLayouts, vectorType);
    var backingLayout = managedArrayBackingLayoutId(lowerer, elementType);
    if vectorLayout <= 0 || backingLayout <= 0 { return failExpression(lowerer, expression, "Vec literal has no exact header/backing layouts"); }
    var source = spanRef(lowerer.sourcePath, array.span);
    var headerValue = managedI64Constant(lowerer, vectorLayout, source);
    var backingValue = managedI64Constant(lowerer, backingLayout, source);
    var capacityValue = managedI64Constant(lowerer, array.elements.len(), source);
    var vector = managedCallHook(lowerer, "managedVecCreate", ir.irRawAddress(), [headerValue.id, backingValue.id, capacityValue.id], source);
    var elementIndex = 0;
    while elementIndex < array.elements.len() {
        var value = lowerExprExpected(lowerer, array.elements[elementIndex], elementType);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        var sourceRefValue = value.ty.kind == IRTypeKind::RawAddress;
        if sourceRefValue {
            if value.ty.kind != IRTypeKind::RawAddress { return failExpression(lowerer, array.elements[elementIndex], "Vec reference element is not a canonical managed reference"); }
            managedCallHook(lowerer, "managedVecPushReference", irVoid(), [vector.id, backingValue.id, value.id], spanRef(lowerer.sourcePath, exprSpan(array.elements[elementIndex])));
        } else {
            var storedValue = value;
            if value.ty.kind == IRTypeKind::Bool { var encoded = lowerBoolAsI64(lowerer, value.id, sourceRef(lowerer.sourcePath, exprSpan(array.elements[elementIndex]).start, exprSpan(array.elements[elementIndex]).end)); storedValue = LowerValue { id: encoded.id, ty: encoded.ty }; }
            if storedValue.ty.kind != IRTypeKind::I64 { return failExpression(lowerer, array.elements[elementIndex], "Vec scalar storage requires i64, bool, or char values"); }
            managedCallHook(lowerer, "managedVecPushI64", irVoid(), [vector.id, backingValue.id, storedValue.id], spanRef(lowerer.sourcePath, exprSpan(array.elements[elementIndex])));
        }
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        elementIndex = elementIndex + 1;
    }
    return vector;
}

func lowerManagedDictLiteral(lowerer: FunctionLowerer, expression: Expr, dictionary: DictExpr): LowerValue {
    var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
    var mapType = managedUnknownType();
    if maybeInfo != null {
        var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
        mapType = info.ty;
    } else {
        var maybeExpected = lowerer.expectedType;
        if maybeExpected == null { return failExpression(lowerer, expression, "unannotated HashMap literal has no checked contextual type"); }
        mapType = requiredType(maybeExpected, managedUnknownType());
    }
    mapType = managedExpressionType(lowerer, mapType);
    if mapType.kind != kindDict || mapType.value == null { return failExpression(lowerer, expression, "HashMap literal requires a concrete checked value type"); }
    var valueType = requiredType(mapType.value, managedUnknownType());
    if valueType.kind == kindAny || valueType.kind == kindFloat { return failExpression(lowerer, expression, "HashMap literal requires a supported concrete value type"); }
    var mapLayout = managedLayoutId(lowerer.managedLayouts, mapType);
    var bucketsLayout = managedMapBucketsLayoutId(lowerer, valueType);
    var nodeLayout = managedMapNodeLayoutId(lowerer, valueType);
    if mapLayout <= 0 || bucketsLayout <= 0 || nodeLayout <= 0 { return failExpression(lowerer, expression, "HashMap literal has no exact descriptor layouts"); }
    var source = spanRef(lowerer.sourcePath, dictionary.span);
    var mapLayoutValue = managedI64Constant(lowerer, mapLayout, source);
    var bucketsLayoutValue = managedI64Constant(lowerer, bucketsLayout, source);
    var map = managedCallHook(lowerer, "managedMapCreate", ir.irRawAddress(), [mapLayoutValue.id, bucketsLayoutValue.id], source);
    var index = 0;
    loop {
        if index >= dictionary.entries.len() { break; }
        var entry: DictEntry = dictionary.entries[index];
        var keyValue = lowerExprExpected(lowerer, entry.key, Type { kind: kindString, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null });
        var value = lowerExprExpected(lowerer, entry.value, valueType);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        var nodeLayoutValue = managedI64Constant(lowerer, nodeLayout, spanRef(lowerer.sourcePath, entry.span));
        if value.ty.kind == IRTypeKind::RawAddress {
            managedCallHook(lowerer, "managedMapSetReference", irVoid(), [map.id, nodeLayoutValue.id, keyValue.id, value.id], spanRef(lowerer.sourcePath, entry.span));
        } else {
            var storedValue = value;
            if value.ty.kind == IRTypeKind::Bool { var encoded = lowerBoolAsI64(lowerer, value.id, spanRef(lowerer.sourcePath, entry.span)); storedValue = LowerValue { id: encoded.id, ty: encoded.ty }; }
            if storedValue.ty.kind != IRTypeKind::I64 { return failExpression(lowerer, entry.value, "HashMap scalar storage requires i64, bool, or char values"); }
            managedCallHook(lowerer, "managedMapSetI64", irVoid(), [map.id, nodeLayoutValue.id, keyValue.id, storedValue.id], spanRef(lowerer.sourcePath, entry.span));
        }
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        index = index + 1;
    }
    return map;
}

func lowerManagedIndex(lowerer: FunctionLowerer, expression: Expr, indexExpr: IndexExpr): LowerValue {
    var maybeTargetInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, indexExpr.target);
    if maybeTargetInfo == null { return failExpression(lowerer, expression, "checked indexed-owner type is missing"); }
    var targetInfo = requiredCheckedExprInfo(maybeTargetInfo, lowerer.checked.expressions[0]);
    var targetType = managedExpressionType(lowerer, targetInfo.ty);
    var owner = lowerExprExpected(lowerer, indexExpr.target, targetType);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    var indexType = Type { kind: kindInt, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
    if targetType.kind == kindDict { indexType = Type { kind: kindString, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null }; }
    var indexValue = lowerExprExpected(lowerer, indexExpr.index, indexType);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    var expectedIndexKind = IRTypeKind::I64;
    if targetType.kind == kindDict { expectedIndexKind = IRTypeKind::RawAddress; }
    if owner.id < 0 || owner.ty.kind != IRTypeKind::RawAddress || indexValue.id < 0 || indexValue.ty.kind != expectedIndexKind {
        return failExpression(lowerer, expression, "managed index requires a canonical owner reference and an index matching its checked aggregate type");
    }
    var source = spanRef(lowerer.sourcePath, indexExpr.span);
    if targetType.kind == kindArray {
        var elementType = managedArrayElementType(targetType);
        if elementType.kind == kindAny || elementType.kind == kindUnknown || elementType.kind == kindFloat { return failExpression(lowerer, expression, "Vec index requires a concrete supported element type"); }
        if managedLayoutId(lowerer.managedLayouts, elementType) > 0 {
            return managedCallHook(lowerer, "managedVecGetReference", ir.irRawAddress(), [owner.id, indexValue.id], source);
        }
        var stored = managedCallHook(lowerer, "managedVecGetI64", irI64(), [owner.id, indexValue.id], source);
        if elementType.kind == kindBool { return lowerManagedI64AsBool(lowerer, stored, source); }
        return stored;
    }
    if targetType.kind == kindDict {
        var valueType = targetType.value;
        if valueType == null { return failExpression(lowerer, expression, "HashMap index has no concrete checked value type"); }
    var resolvedValueType = requiredType(valueType, managedUnknownType());
        if resolvedValueType.kind == kindAny || resolvedValueType.kind == kindFloat { return failExpression(lowerer, expression, "HashMap index requires a concrete supported value type"); }
        if managedLayoutId(lowerer.managedLayouts, resolvedValueType) > 0 {
            return managedCallHook(lowerer, "managedMapGetReference", ir.irRawAddress(), [owner.id, indexValue.id], source);
        }
        var mapStored = managedCallHook(lowerer, "managedMapGetI64", irI64(), [owner.id, indexValue.id], source);
        if resolvedValueType.kind == kindBool { return lowerManagedI64AsBool(lowerer, mapStored, source); }
        return mapStored;
    }
    if targetType.kind == kindString { return managedCallHook(lowerer, "managedStringByte", irI64(), [owner.id, indexValue.id], source); }
    return failExpression(lowerer, expression, "indexed target is outside managed aggregate lowering");
}

func managedMethodArgumentType(receiver: Type, method: string, index: int, fallback: Type): Type {
    if receiver.kind == kindArray && (method == litPush || method == litContains || method == litIndexOf || (method == litSet && index == 1)) {
        var maybeElement = receiver.inner;
        if maybeElement != null { return maybeElement; }
    }
    if receiver.kind == kindDict && (method == litSet && index == 1) {
        var maybeValue = receiver.value;
        if maybeValue != null { return maybeValue; }
    }
    if fallback.kind == kindAny || fallback.kind == kindUnknown {
        if receiver.kind == kindOption && (method == litUnwrapOr || method == litUnwrap) { var maybeInner = receiver.inner; if maybeInner != null { return maybeInner; } }
        if receiver.kind == kindResult && (method == litUnwrap || method == litUnwrapOr) { var maybeOk = receiver.inner; if maybeOk != null { return maybeOk; } }
        if receiver.kind == kindResult && method == litUnwrapErr { var maybeErr = receiver.key; if maybeErr != null { return maybeErr; } }
    }
    return fallback;
}

func managedTaggedPayloadKey(outer: ManagedLayout, variantIndex: int, ty: Type): string {
    if ty.kind == kindEnum { return "$enum-payload:" + outer.key.len().toString() + ":" + outer.key + variantIndex.toString(); }
    return outer.key + ":payload:" + variantIndex.toString();
}

func lowerManagedTaggedTag(lowerer: FunctionLowerer, owner: LowerValue, span: SourceRef): LowerValue {
    var offset = managedI64Constant(lowerer, 16, span);
    var address = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(address.id, owner.id, offset.id, span));
    var tag = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, ir.rawLoadI64(tag.id, address.id, span));
    return LowerValue { id: tag.id, ty: tag.ty };
}

func lowerManagedTaggedPayload(lowerer: FunctionLowerer, owner: LowerValue, receiverType: Type, variantIndex: int, payloadType: Type, span: SourceRef): LowerValue {
    var outerId = managedLayoutId(lowerer.managedLayouts, receiverType);
    var maybeOuter = findManagedLayout(lowerer.managedLayouts, outerId);
    if maybeOuter == null { lowerer.error = lowerError(lowerer.sourcePath, span.start, "tagged payload owner has no exact outer descriptor"); return LowerValue { id: -1, ty: irVoid() }; }
    var outer = requiredManagedLayout(maybeOuter, lowerer.managedLayouts[0]);
    var payloadReferenceOffset = managedI64Constant(lowerer, 24, span);
    var payloadReferenceAddress = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(payloadReferenceAddress.id, owner.id, payloadReferenceOffset.id, span));
    var payloadOwner = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawLoadAddress(payloadOwner.id, payloadReferenceAddress.id, span));
    var payloadLayoutId = findLayoutIdByKey(lowerer.managedLayouts, managedTaggedPayloadKey(outer, variantIndex, receiverType));
    var maybePayloadLayout = findManagedLayout(lowerer.managedLayouts, payloadLayoutId);
    if maybePayloadLayout == null { lowerer.error = lowerError(lowerer.sourcePath, span.start, "tagged payload has no exact variant descriptor"); return LowerValue { id: -1, ty: irVoid() }; }
    var payloadLayout = requiredManagedLayout(maybePayloadLayout, lowerer.managedLayouts[0]);
    if payloadLayout.fields.len() != 1 { lowerer.error = lowerError(lowerer.sourcePath, span.start, "unwrap helper requires a single-field checked payload"); return LowerValue { id: -1, ty: irVoid() }; }
    var field = payloadLayout.fields[0];
    if field.kind != managedIRType(lowerer.managedLayouts, payloadType).kind || field.layoutId != managedLayoutId(lowerer.managedLayouts, payloadType) {
        lowerer.error = lowerError(lowerer.sourcePath, span.start, "unwrap payload type differs from its exact checked descriptor");
        return LowerValue { id: -1, ty: irVoid() };
    }
    var valueOffset = managedI64Constant(lowerer, 16 + field.offset, span);
    var valueAddress = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(valueAddress.id, payloadOwner.id, valueOffset.id, span));
    if field.kind == IRTypeKind::RawAddress {
        var valueReference = allocateValue(lowerer, ir.irRawAddress());
        appendInstruction(lowerer, ir.rawLoadAddress(valueReference.id, valueAddress.id, span));
        return LowerValue { id: valueReference.id, ty: valueReference.ty };
    }
    var word = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, ir.rawLoadI64(word.id, valueAddress.id, span));
    if field.kind == IRTypeKind::Bool { return lowerManagedI64AsBool(lowerer, LowerValue { id: word.id, ty: word.ty }, span); }
    return LowerValue { id: word.id, ty: word.ty };
}

func finishManagedTrapBlock(lowerer: FunctionLowerer, code: int, span: Span) {
    var source = spanRef(lowerer.sourcePath, span);
    var trapCode = managedI64Constant(lowerer, code, source);
    appendInstruction(lowerer, ir.rawFail(trapCode.id, source));
    if lowerer.plan.returnType.kind == IRTypeKind::Void { finishBlock(lowerer, returnVoid(source)); return; }
    var fallback = allocateValue(lowerer, lowerer.plan.returnType);
    if fallback.ty.kind == IRTypeKind::RawAddress { appendInstruction(lowerer, ir.rawNull(fallback.id, source)); }
    else if fallback.ty.kind == IRTypeKind::Bool { appendInstruction(lowerer, constBool(fallback.id, false, source)); }
    else { appendInstruction(lowerer, constI64(fallback.id, 0, source)); }
    finishBlock(lowerer, returnValue(fallback.id, source));
}

func lowerManagedTaggedMethod(lowerer: FunctionLowerer, expression: Expr, receiver: LowerValue, receiverType: Type, method: string, args: Vec<LowerValue>, source: SourceRef): LowerValue {
    var option = receiverType.kind == kindOption;
    var tag = lowerManagedTaggedTag(lowerer, receiver, source);
    var successTag = 0;
    var failureTag = 1;
    if method == litIsNone || method == litIsErr { successTag = 1; failureTag = 0; }
    if method == litIsSome || method == litIsNone || method == litIsOk || method == litIsErr {
        var wanted = managedI64Constant(lowerer, successTag, source);
        var result = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, compareI64(result.id, ir.compareEq(), tag.id, wanted.id, source));
        return LowerValue { id: result.id, ty: result.ty };
    }
    var variantIndex = 0;
    var payloadType: Type? = receiverType.inner;
    if method == litUnwrapErr { variantIndex = 1; payloadType = receiverType.key; }
    if method == litUnwrapOr && !option { variantIndex = 0; payloadType = receiverType.inner; }
    if method != litUnwrap && method != litUnwrapErr && method != litUnwrapOr { return failExpression(lowerer, expression, "unsupported Option/Result method '" + method + "'"); }
    if payloadType == null { return failExpression(lowerer, expression, "Option/Result unwrap requires a concrete checked payload type"); }
    var resolvedPayloadType = requiredType(payloadType, managedUnknownType());
    if resolvedPayloadType.kind == kindAny || resolvedPayloadType.kind == kindUnknown || resolvedPayloadType.kind == kindVoid || resolvedPayloadType.kind == kindFloat { return failExpression(lowerer, expression, "Option/Result unwrap payload is not a supported concrete type"); }
    if method == litUnwrapOr {
        if args.len() != 1 || args[0].ty.kind != managedIRType(lowerer.managedLayouts, resolvedPayloadType).kind { return failExpression(lowerer, expression, "unwrapOr fallback does not match its checked payload type"); }
        var expectedTag = managedI64Constant(lowerer, successTag, source);
        var isPayload = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, compareI64(isPayload.id, ir.compareEq(), tag.id, expectedTag.id, source));
        var resultType = managedIRType(lowerer.managedLayouts, resolvedPayloadType);
        var resultParam = allocateValue(lowerer, resultType);
        var mergeId = reserveBlock(lowerer, [resultParam]);
        var payloadBlock = reserveBlock(lowerer, []);
        var fallbackBlock = reserveBlock(lowerer, []);
        finishBlock(lowerer, branch(isPayload.id, payloadBlock, [], fallbackBlock, [], source));
        enterBlock(lowerer, payloadBlock, []);
        var payloadValue = lowerManagedTaggedPayload(lowerer, receiver, receiverType, variantIndex, resolvedPayloadType, source);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        finishBlock(lowerer, jump(mergeId, [payloadValue.id], source));
        enterBlock(lowerer, fallbackBlock, []);
        finishBlock(lowerer, jump(mergeId, [args[0].id], source));
        enterBlock(lowerer, mergeId, [resultParam]);
        return LowerValue { id: resultParam.id, ty: resultParam.ty };
    }
    var expectedTagValue = managedI64Constant(lowerer, variantIndex, source);
    var isExpectedVariant = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, compareI64(isExpectedVariant.id, ir.compareEq(), tag.id, expectedTagValue.id, source));
    var payloadBlock2 = reserveBlock(lowerer, []);
    var trapBlock = reserveBlock(lowerer, []);
    finishBlock(lowerer, branch(isExpectedVariant.id, payloadBlock2, [], trapBlock, [], source));
    enterBlock(lowerer, trapBlock, []);
    finishManagedTrapBlock(lowerer, 2301, exprSpan(expression));
    enterBlock(lowerer, payloadBlock2, []);
    return lowerManagedTaggedPayload(lowerer, receiver, receiverType, variantIndex, resolvedPayloadType, source);
}

func lowerManagedBoolAnd(lowerer: FunctionLowerer, left: LowerValue, right: LowerValue, source: SourceRef): LowerValue {
    var result = allocateValue(lowerer, irBool());
    var mergeId = reserveBlock(lowerer, [result]);
    var trueId = reserveBlock(lowerer, []);
    var falseId = reserveBlock(lowerer, []);
    finishBlock(lowerer, branch(left.id, trueId, [], falseId, [], source));
    enterBlock(lowerer, trueId, []);
    finishBlock(lowerer, jump(mergeId, [right.id], source));
    enterBlock(lowerer, falseId, []);
    var falseValue = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, constBool(falseValue.id, false, source));
    finishBlock(lowerer, jump(mergeId, [falseValue.id], source));
    enterBlock(lowerer, mergeId, [result]);
    return LowerValue { id: result.id, ty: result.ty };
}

func lowerManagedBoolNot(lowerer: FunctionLowerer, value: LowerValue, source: SourceRef): LowerValue {
    var falseValue = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, constBool(falseValue.id, false, source));
    var result = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, compareBool(result.id, ir.compareEq(), value.id, falseValue.id, source));
    return LowerValue { id: result.id, ty: result.ty };
}

func lowerManagedBoolOr(lowerer: FunctionLowerer, left: LowerValue, right: LowerValue, source: SourceRef): LowerValue {
    var result = allocateValue(lowerer, irBool());
    var mergeId = reserveBlock(lowerer, [result]);
    var trueId = reserveBlock(lowerer, []);
    var rightId = reserveBlock(lowerer, []);
    finishBlock(lowerer, branch(left.id, trueId, [], rightId, [], source));
    enterBlock(lowerer, trueId, []);
    var yes = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, constBool(yes.id, true, source));
    finishBlock(lowerer, jump(mergeId, [yes.id], source));
    enterBlock(lowerer, rightId, []);
    finishBlock(lowerer, jump(mergeId, [right.id], source));
    enterBlock(lowerer, mergeId, [result]);
    return LowerValue { id: result.id, ty: result.ty };
}

func lowerManagedFieldValue(lowerer: FunctionLowerer, owner: LowerValue, field: ManagedField, fieldType: Type, source: SourceRef): LowerValue {
    var offset = managedI64Constant(lowerer, 16 + field.offset, source);
    var address = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(address.id, owner.id, offset.id, source));
    if field.kind == IRTypeKind::RawAddress {
        var value = allocateValue(lowerer, ir.irRawAddress());
        appendInstruction(lowerer, ir.rawLoadAddress(value.id, address.id, source));
        return LowerValue { id: value.id, ty: value.ty };
    }
    var word = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, ir.rawLoadI64(word.id, address.id, source));
    if fieldType.kind == kindBool { return lowerManagedI64AsBool(lowerer, LowerValue { id: word.id, ty: word.ty }, source); }
    return LowerValue { id: word.id, ty: word.ty };
}

func managedTaggedPayloadTypes(checked: CheckedProgram, ty: Type, variantIndex: int): Vec<Type> {
    if ty.kind == kindEnum {
        var maybeNominal = nominalLayoutForType(checked, ty);
        if maybeNominal != null { var nominal = requiredNominalLayout(maybeNominal, checked.nominalLayouts[0]); if variantIndex >= 0 && variantIndex < nominal.variants.len() { return nominal.variants[variantIndex].payloadTypes; } }
        return [];
    }
    if ty.kind == kindOption && variantIndex == 0 { var maybeInner = ty.inner; if maybeInner != null { return [requiredType(maybeInner, managedUnknownType())]; } }
    if ty.kind == kindResult { if variantIndex == 0 { var maybeInner = ty.inner; if maybeInner != null { return [requiredType(maybeInner, managedUnknownType())]; } } if variantIndex == 1 { var maybeKey = ty.key; if maybeKey != null { return [requiredType(maybeKey, managedUnknownType())]; } } }
    return [];
}

func managedEqualityGuardKey(ty: Type): string {
    if ty.kind == kindTuple || ty.kind == kindEnum || ty.kind == kindOption || ty.kind == kindResult { return managedTypeKey(ty); }
    return "";
}

func managedEqualityPathContains(path: Vec<string>, key: string): bool {
    var index = 0;
    loop { if index >= path.len() { break; } if path[index] == key { return true; } index = index + 1; }
    return false;
}

func managedEqualityPathWith(path: Vec<string>, key: string): Vec<string> {
    var extended: Vec<string> = [];
    var index = 0;
    loop { if index >= path.len() { break; } extended.push(path[index]); index = index + 1; }
    extended.push(key);
    return extended;
}

func lowerManagedTaggedFieldsEqual(lowerer: FunctionLowerer, left: LowerValue, right: LowerValue, ty: Type, variantIndex: int, payloadTypes: Vec<Type>, source: SourceRef, equalityPath: Vec<string>): LowerValue {
    if payloadTypes.len() == 0 { var yes = allocateValue(lowerer, irBool()); appendInstruction(lowerer, constBool(yes.id, true, source)); return LowerValue { id: yes.id, ty: yes.ty }; }
    var outerId = managedLayoutId(lowerer.managedLayouts, ty);
    var maybeOuter = findManagedLayout(lowerer.managedLayouts, outerId);
    if maybeOuter == null { lowerer.error = lowerError(lowerer.sourcePath, source.start, "tagged equality has no exact outer descriptor"); return LowerValue { id: -1, ty: irVoid() }; }
    var outer = requiredManagedLayout(maybeOuter, lowerer.managedLayouts[0]);
    var leftPayloadOffset = managedI64Constant(lowerer, 24, source);
    var leftPayloadAddress = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(leftPayloadAddress.id, left.id, leftPayloadOffset.id, source));
    var leftPayload = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawLoadAddress(leftPayload.id, leftPayloadAddress.id, source));
    var rightPayloadOffset = managedI64Constant(lowerer, 24, source);
    var rightPayloadAddress = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(rightPayloadAddress.id, right.id, rightPayloadOffset.id, source));
    var rightPayload = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawLoadAddress(rightPayload.id, rightPayloadAddress.id, source));
    var payloadKey = managedTaggedPayloadKey(outer, variantIndex, ty);
    var payloadLayoutId = findLayoutIdByKey(lowerer.managedLayouts, payloadKey);
    var maybePayloadLayout = findManagedLayout(lowerer.managedLayouts, payloadLayoutId);
    if maybePayloadLayout == null { lowerer.error = lowerError(lowerer.sourcePath, source.start, "tagged equality has no exact payload descriptor"); return LowerValue { id: -1, ty: irVoid() }; }
    var payloadLayout = requiredManagedLayout(maybePayloadLayout, lowerer.managedLayouts[0]);
    if payloadLayout.fields.len() != payloadTypes.len() { lowerer.error = lowerError(lowerer.sourcePath, source.start, "tagged equality payload shape does not match checked metadata"); return LowerValue { id: -1, ty: irVoid() }; }
    var equalValue = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, constBool(equalValue.id, true, source));
    var allEqual = LowerValue { id: equalValue.id, ty: equalValue.ty };
    var fieldIndex = 0;
    loop {
        if fieldIndex >= payloadTypes.len() { break; }
        var field = payloadLayout.fields[fieldIndex];
        var leftValue = lowerManagedFieldValue(lowerer, LowerValue { id: leftPayload.id, ty: leftPayload.ty }, field, payloadTypes[fieldIndex], source);
        var rightValue = lowerManagedFieldValue(lowerer, LowerValue { id: rightPayload.id, ty: rightPayload.ty }, field, payloadTypes[fieldIndex], source);
        var fieldEqual = lowerManagedValueEqualRecursive(lowerer, leftValue, rightValue, payloadTypes[fieldIndex], false, source, equalityPath);
        var combined = lowerManagedBoolAnd(lowerer, allEqual, fieldEqual, source);
        allEqual = combined;
        fieldIndex = fieldIndex + 1;
    }
    return allEqual;
}

func lowerManagedTaggedEqual(lowerer: FunctionLowerer, left: LowerValue, right: LowerValue, ty: Type, source: SourceRef, equalityPath: Vec<string>): LowerValue {
    var variantCount = 0;
    if ty.kind == kindEnum {
        var maybeNominal = nominalLayoutForType(lowerer.checked, ty);
        if maybeNominal == null { lowerer.error = lowerError(lowerer.sourcePath, source.start, "enum equality has no exact nominal layout"); return LowerValue { id: -1, ty: irVoid() }; }
        var nominal = requiredNominalLayout(maybeNominal, lowerer.checked.nominalLayouts[0]);
        variantCount = nominal.variants.len();
    } else { variantCount = 2; }
    if variantCount <= 0 { lowerer.error = lowerError(lowerer.sourcePath, source.start, "tagged equality has no checked variants"); return LowerValue { id: -1, ty: irVoid() }; }
    var leftTag = lowerManagedTaggedTag(lowerer, left, source);
    var rightTag = lowerManagedTaggedTag(lowerer, right, source);
    var tagsEqual = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, compareI64(tagsEqual.id, ir.compareEq(), leftTag.id, rightTag.id, source));
    var result = allocateValue(lowerer, irBool());
    var mergeId = reserveBlock(lowerer, [result]);
    var variantBlock = reserveBlock(lowerer, []);
    var differentBlock = reserveBlock(lowerer, []);
    finishBlock(lowerer, branch(tagsEqual.id, variantBlock, [], differentBlock, [], source));
    enterBlock(lowerer, differentBlock, []);
    var falseForDifferent = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, constBool(falseForDifferent.id, false, source));
    finishBlock(lowerer, jump(mergeId, [falseForDifferent.id], source));
    enterBlock(lowerer, variantBlock, []);
    var variantIndex = 0;
    loop {
        if variantIndex >= variantCount { break; }
        var tagValue = managedI64Constant(lowerer, variantIndex, source);
        var matches = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, compareI64(matches.id, ir.compareEq(), leftTag.id, tagValue.id, source));
        var payloadBlock = reserveBlock(lowerer, []);
        var nextBlock = reserveBlock(lowerer, []);
        finishBlock(lowerer, branch(matches.id, payloadBlock, [], nextBlock, [], source));
        enterBlock(lowerer, payloadBlock, []);
        var payloadTypes = managedTaggedPayloadTypes(lowerer.checked, ty, variantIndex);
        var fieldEqual = lowerManagedTaggedFieldsEqual(lowerer, left, right, ty, variantIndex, payloadTypes, source, equalityPath);
        finishBlock(lowerer, jump(mergeId, [fieldEqual.id], source));
        enterBlock(lowerer, nextBlock, []);
        variantIndex = variantIndex + 1;
    }
    var invalidFalse = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, constBool(invalidFalse.id, false, source));
    finishBlock(lowerer, jump(mergeId, [invalidFalse.id], source));
    enterBlock(lowerer, mergeId, [result]);
    return LowerValue { id: result.id, ty: result.ty };
}

func lowerManagedValueEqual(lowerer: FunctionLowerer, left: LowerValue, right: LowerValue, ty: Type, negate: bool, source: SourceRef): LowerValue {
    return lowerManagedValueEqualRecursive(lowerer, left, right, ty, negate, source, []);
}

func lowerManagedValueEqualRecursive(lowerer: FunctionLowerer, left: LowerValue, right: LowerValue, ty: Type, negate: bool, source: SourceRef, equalityPath: Vec<string>): LowerValue {
    var guardKey = managedEqualityGuardKey(ty);
    if guardKey != emptyString {
        if managedEqualityPathContains(equalityPath, guardKey) {
            lowerer.error = lowerError(lowerer.sourcePath, source.start, "managed recursive value equality is unsupported for recursive type " + guardKey);
            return LowerValue { id: -1, ty: irVoid() };
        }
        equalityPath = managedEqualityPathWith(equalityPath, guardKey);
    }
    if ty.kind == kindString { var equal = managedCallHook(lowerer, "managedStringEqual", irBool(), [left.id, right.id], source); if negate { return lowerManagedBoolNot(lowerer, equal, source); } return equal; }
    if ty.kind == kindNullable {
        var inner = ty.inner;
        if inner != null && managedLayoutId(lowerer.managedLayouts, requiredType(inner, ty)) > 0 {
            var rawEqual = allocateValue(lowerer, irBool());
            appendInstruction(lowerer, ir.rawEqual(rawEqual.id, left.id, right.id, source));
            var nullValue = allocateValue(lowerer, ir.irRawAddress());
            appendInstruction(lowerer, ir.rawNull(nullValue.id, source));
            var leftNull = allocateValue(lowerer, irBool());
            appendInstruction(lowerer, ir.rawEqual(leftNull.id, left.id, nullValue.id, source));
            var rightNull = allocateValue(lowerer, irBool());
            appendInstruction(lowerer, ir.rawEqual(rightNull.id, right.id, nullValue.id, source));
            // `leftNull == false` and `rightNull == false` determine when string bytes may be read.
            var bothNonNull = lowerManagedBoolAnd(lowerer, lowerManagedBoolNot(lowerer, LowerValue { id: leftNull.id, ty: leftNull.ty }, source), lowerManagedBoolNot(lowerer, LowerValue { id: rightNull.id, ty: rightNull.ty }, source), source);
            var merge = allocateValue(lowerer, irBool());
            var mergeId = reserveBlock(lowerer, [merge]);
            var stringsBlock = reserveBlock(lowerer, []);
            var nullsBlock = reserveBlock(lowerer, []);
            finishBlock(lowerer, branch(bothNonNull.id, stringsBlock, [], nullsBlock, [], source));
            enterBlock(lowerer, stringsBlock, []);
            var resolvedInner = requiredType(inner, ty);
            var same = lowerManagedValueEqualRecursive(lowerer, left, right, resolvedInner, false, source, equalityPath);
            if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
            finishBlock(lowerer, jump(mergeId, [same.id], source));
            enterBlock(lowerer, nullsBlock, []);
            finishBlock(lowerer, jump(mergeId, [rawEqual.id], source));
            enterBlock(lowerer, mergeId, [merge]);
            var result = LowerValue { id: merge.id, ty: merge.ty };
            if negate { return lowerManagedBoolNot(lowerer, result, source); }
            return result;
        }
        if inner != null { ty = requiredType(inner, ty); }
    }
    if ty.kind == kindTuple {
        var layoutId = managedLayoutId(lowerer.managedLayouts, ty);
        var maybeLayout = findManagedLayout(lowerer.managedLayouts, layoutId);
        if maybeLayout == null { lowerer.error = lowerError(lowerer.sourcePath, source.start, "tuple equality has no exact checked layout"); return LowerValue { id: -1, ty: irVoid() }; }
        var layout = requiredManagedLayout(maybeLayout, lowerer.managedLayouts[0]);
        var result = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, constBool(result.id, true, source));
        var index = 0;
        loop {
            if index >= ty.params.len() { break; }
            var field = layout.fields[index];
            var leftField = lowerManagedFieldValue(lowerer, left, field, ty.params[index], source);
            var rightField = lowerManagedFieldValue(lowerer, right, field, ty.params[index], source);
            var same = lowerManagedValueEqualRecursive(lowerer, leftField, rightField, ty.params[index], false, source, equalityPath);
            var both = lowerManagedBoolAnd(lowerer, LowerValue { id: result.id, ty: result.ty }, same, source);
            result = irValue(both.id, both.ty);
            index = index + 1;
        }
        if negate { return lowerManagedBoolNot(lowerer, LowerValue { id: result.id, ty: result.ty }, source); }
        return LowerValue { id: result.id, ty: result.ty };
    }
    if ty.kind == kindEnum || ty.kind == kindOption || ty.kind == kindResult {
        var tagged = lowerManagedTaggedEqual(lowerer, left, right, ty, source, equalityPath);
        if negate { return lowerManagedBoolNot(lowerer, tagged, source); }
        return tagged;
    }
    if left.ty.kind == IRTypeKind::Bool && right.ty.kind == IRTypeKind::Bool {
        var comparedBool = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, compareBool(comparedBool.id, ir.compareEq(), left.id, right.id, source));
        if negate { return lowerManagedBoolNot(lowerer, LowerValue { id: comparedBool.id, ty: comparedBool.ty }, source); }
        return LowerValue { id: comparedBool.id, ty: comparedBool.ty };
    }
    if left.ty.kind == IRTypeKind::I64 && right.ty.kind == IRTypeKind::I64 {
        var comparedI64 = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, compareI64(comparedI64.id, ir.compareEq(), left.id, right.id, source));
        if negate { return lowerManagedBoolNot(lowerer, LowerValue { id: comparedI64.id, ty: comparedI64.ty }, source); }
        return LowerValue { id: comparedI64.id, ty: comparedI64.ty };
    }
    var equal = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, ir.rawEqual(equal.id, left.id, right.id, source));
    if negate { return lowerManagedBoolNot(lowerer, LowerValue { id: equal.id, ty: equal.ty }, source); }
    return LowerValue { id: equal.id, ty: equal.ty };
}

func managedPatternVariantIndex(checked: CheckedProgram, ty: Type, enumName: string, variantName: string): int {
    var actualType = ty;
    if actualType.kind == kindNullable { var inner = actualType.inner; if inner != null { actualType = requiredType(inner, actualType); } }
    if actualType.kind == kindOption {
        if (enumName == emptyString || enumName == kindOption) && variantName == litSome { return 0; }
        if (enumName == emptyString || enumName == kindOption) && variantName == litNone { return 1; }
        return -1;
    }
    if actualType.kind == kindResult {
        if (enumName == emptyString || enumName == kindResult) && variantName == litOk { return 0; }
        if (enumName == emptyString || enumName == kindResult) && variantName == litErr { return 1; }
        return -1;
    }
    if actualType.kind != kindEnum || (enumName != emptyString && enumName != actualType.name) { return -1; }
    var maybeLayout = nominalLayoutForType(checked, actualType);
    if maybeLayout == null { return -1; }
    var nominal = requiredNominalLayout(maybeLayout, checked.nominalLayouts[0]);
    var index = 0;
    loop { if index >= nominal.variants.len() { break; } if nominal.variants[index].name == variantName && nominal.variants[index].variantIndex == index { return index; } index = index + 1; }
    return -1;
}

func lowerManagedTaggedPayloadField(lowerer: FunctionLowerer, owner: LowerValue, ty: Type, variantIndex: int, fieldIndex: int, fieldType: Type, source: SourceRef): LowerValue {
    var outerId = managedLayoutId(lowerer.managedLayouts, ty);
    var maybeOuter = findManagedLayout(lowerer.managedLayouts, outerId);
    if maybeOuter == null { lowerer.error = lowerError(lowerer.sourcePath, source.start, "pattern payload has no exact outer descriptor"); return LowerValue { id: -1, ty: irVoid() }; }
    var outer = requiredManagedLayout(maybeOuter, lowerer.managedLayouts[0]);
    var payloadOffset = managedI64Constant(lowerer, 24, source);
    var payloadAddress = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(payloadAddress.id, owner.id, payloadOffset.id, source));
    var payloadOwner = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawLoadAddress(payloadOwner.id, payloadAddress.id, source));
    var payloadLayoutId = findLayoutIdByKey(lowerer.managedLayouts, managedTaggedPayloadKey(outer, variantIndex, ty));
    var maybePayloadLayout = findManagedLayout(lowerer.managedLayouts, payloadLayoutId);
    if maybePayloadLayout == null { lowerer.error = lowerError(lowerer.sourcePath, source.start, "pattern payload has no exact variant descriptor"); return LowerValue { id: -1, ty: irVoid() }; }
    var payloadLayout = requiredManagedLayout(maybePayloadLayout, lowerer.managedLayouts[0]);
    if fieldIndex < 0 || fieldIndex >= payloadLayout.fields.len() { lowerer.error = lowerError(lowerer.sourcePath, source.start, "pattern payload field index is outside its descriptor"); return LowerValue { id: -1, ty: irVoid() }; }
    var field = payloadLayout.fields[fieldIndex];
    if field.kind != managedIRType(lowerer.managedLayouts, fieldType).kind || field.layoutId != managedLayoutId(lowerer.managedLayouts, fieldType) {
        lowerer.error = lowerError(lowerer.sourcePath, source.start, "pattern payload field differs from its checked payload type"); return LowerValue { id: -1, ty: irVoid() };
    }
    return lowerManagedFieldValue(lowerer, LowerValue { id: payloadOwner.id, ty: payloadOwner.ty }, field, fieldType, source);
}

func lowerManagedPatternLiteral(lowerer: FunctionLowerer, pattern: Pattern, value: LowerValue, expected: Type, literal: Literal, source: SourceRef): LowerValue {
    if literal.kind == LiteralKind::Null {
        if value.ty.kind != IRTypeKind::RawAddress { return failPattern(lowerer, pattern, "null pattern requires a nullable managed reference"); }
        var nullValue = allocateValue(lowerer, ir.irRawAddress());
        appendInstruction(lowerer, ir.rawNull(nullValue.id, source));
        var result = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, ir.rawEqual(result.id, value.id, nullValue.id, source));
        return LowerValue { id: result.id, ty: result.ty };
    }
    var literalType = Type { kind: kindUnknown, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
    var literalValue = LowerValue { id: -1, ty: irVoid() };
    if literal.kind == LiteralKind::Bool {
        literalType = Type { kind: kindBool, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
        var boolValue = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, constBool(boolValue.id, literal.text == boolTrue, source));
        literalValue = LowerValue { id: boolValue.id, ty: boolValue.ty };
    } else if literal.kind == LiteralKind::Int {
        literalType = Type { kind: kindInt, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
        var parsed = parseIntegerLiteral(literal.text, false);
        if parsed.isErr() { return failPattern(lowerer, pattern, parsed.unwrapErr()); }
        var intValue = managedI64Constant(lowerer, parsed.unwrap(), source);
        literalValue = LowerValue { id: intValue.id, ty: intValue.ty };
    } else if literal.kind == LiteralKind::Char {
        literalType = Type { kind: kindChar, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
        if literal.text.len() != 1 { return failPattern(lowerer, pattern, "checked char pattern does not contain exactly one byte"); }
        var charValue = managedI64Constant(lowerer, literal.text.hash(), source);
        literalValue = LowerValue { id: charValue.id, ty: charValue.ty };
    } else if literal.kind == LiteralKind::String {
        literalType = Type { kind: kindString, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
        var literalExpr = Expr::Literal(LiteralExpr { kind: LiteralKind::String, text: literal.text, span: patternSpan(pattern) });
        literalValue = lowerManagedStringLiteral(lowerer, literalExpr, LiteralExpr { kind: LiteralKind::String, text: literal.text, span: patternSpan(pattern) });
    } else {
        return failPattern(lowerer, pattern, "managed literal pattern family is unsupported");
    }
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    if literalType.kind != expected.kind { return failPattern(lowerer, pattern, "literal pattern type differs from its checked scrutinee type"); }
    return lowerManagedValueEqual(lowerer, value, literalValue, literalType, false, source);
}

func failPattern(lowerer: FunctionLowerer, pattern: Pattern, message: string): LowerValue {
    lowerer.error = lowerError(lowerer.sourcePath, patternSpan(pattern).start, message);
    return LowerValue { id: -1, ty: irVoid() };
}

func lowerManagedNullablePatternCondition(lowerer: FunctionLowerer, pattern: Pattern, value: LowerValue, inner: Type, source: SourceRef): LowerValue {
    var nullValue = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawNull(nullValue.id, source));
    var isNull = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, ir.rawEqual(isNull.id, value.id, nullValue.id, source));
    var notNull = lowerManagedBoolNot(lowerer, LowerValue { id: isNull.id, ty: isNull.ty }, source);
    var result = allocateValue(lowerer, irBool());
    var mergeId = reserveBlock(lowerer, [result]);
    var innerBlock = reserveBlock(lowerer, []);
    var nullBlock = reserveBlock(lowerer, []);
    finishBlock(lowerer, branch(notNull.id, innerBlock, [], nullBlock, [], source));
    enterBlock(lowerer, innerBlock, []);
    var innerResult = lowerManagedPatternCondition(lowerer, pattern, value, inner);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    finishBlock(lowerer, jump(mergeId, [innerResult.id], source));
    enterBlock(lowerer, nullBlock, []);
    var no = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, constBool(no.id, false, source));
    finishBlock(lowerer, jump(mergeId, [no.id], source));
    enterBlock(lowerer, mergeId, [result]);
    return LowerValue { id: result.id, ty: result.ty };
}

func lowerManagedPatternCondition(lowerer: FunctionLowerer, pattern: Pattern, value: LowerValue, expected: Type): LowerValue {
    var source = spanRef(lowerer.sourcePath, patternSpan(pattern));
    if expected.kind == kindNullable {
        match pattern {
            Pattern::Literal(literal) => {
                if literal.literal.kind == LiteralKind::Null { return lowerManagedPatternLiteral(lowerer, pattern, value, expected, literal.literal, source); }
                var inner = expected.inner;
                if inner == null { return failPattern(lowerer, pattern, "nullable pattern has no checked inner type"); }
                var resolvedInner = requiredType(inner, expected);
                return lowerManagedNullablePatternCondition(lowerer, pattern, value, resolvedInner, source);
            },
            Pattern::Wildcard(_) => { var yes = allocateValue(lowerer, irBool()); appendInstruction(lowerer, constBool(yes.id, true, source)); return LowerValue { id: yes.id, ty: yes.ty }; },
            Pattern::Variable(variable) => {
                var inner = expected.inner;
                if inner == null { return failPattern(lowerer, pattern, "nullable pattern has no checked inner type"); }
                var resolvedInner = requiredType(inner, expected);
                if managedPatternVariantIndex(lowerer.checked, resolvedInner, "", variable.name) < 0 {
                    var yesVariable = allocateValue(lowerer, irBool());
                    appendInstruction(lowerer, constBool(yesVariable.id, true, source));
                    return LowerValue { id: yesVariable.id, ty: yesVariable.ty };
                }
                return lowerManagedNullablePatternCondition(lowerer, pattern, value, resolvedInner, source);
            },
            _ => {
                var inner = expected.inner;
                if inner == null { return failPattern(lowerer, pattern, "nullable pattern has no checked inner type"); }
                var resolvedInner2 = requiredType(inner, expected);
                return lowerManagedNullablePatternCondition(lowerer, pattern, value, resolvedInner2, source);
            },
        }
    }
    match pattern {
        Pattern::Error(_) => { return failPattern(lowerer, pattern, "checked pattern contains a parse error"); },
        Pattern::Wildcard(_) => { var yes = allocateValue(lowerer, irBool()); appendInstruction(lowerer, constBool(yes.id, true, source)); return LowerValue { id: yes.id, ty: yes.ty }; },
        Pattern::Variable(variable) => {
            var variantIndex = managedPatternVariantIndex(lowerer.checked, expected, "", variable.name);
            if variantIndex >= 0 {
                var tagged = expected;
                if tagged.kind == kindNullable { var maybeInner = tagged.inner; if maybeInner != null { tagged = requiredType(maybeInner, tagged); } }
                var tag = lowerManagedTaggedTag(lowerer, value, source);
                var tagValue = managedI64Constant(lowerer, variantIndex, source);
                var isVariant = allocateValue(lowerer, irBool());
                appendInstruction(lowerer, compareI64(isVariant.id, ir.compareEq(), tag.id, tagValue.id, source));
                return LowerValue { id: isVariant.id, ty: isVariant.ty };
            }
            var yesVariable = allocateValue(lowerer, irBool());
            appendInstruction(lowerer, constBool(yesVariable.id, true, source));
            return LowerValue { id: yesVariable.id, ty: yesVariable.ty };
        },
        Pattern::Literal(literal) => { return lowerManagedPatternLiteral(lowerer, pattern, value, expected, literal.literal, source); },
        Pattern::Range(range) => {
            if value.ty.kind != IRTypeKind::I64 || expected.kind != kindInt { return failPattern(lowerer, pattern, "range patterns require a checked integer scrutinee"); }
            var start = parseIntegerLiteral(range.start.text, false);
            var end = parseIntegerLiteral(range.end.text, false);
            if start.isErr() || end.isErr() { return failPattern(lowerer, pattern, "range pattern has an invalid checked integer bound"); }
            var startValue = managedI64Constant(lowerer, start.unwrap(), source);
            var endValue = managedI64Constant(lowerer, end.unwrap(), source);
            var afterStart = allocateValue(lowerer, irBool());
            appendInstruction(lowerer, compareI64(afterStart.id, ir.compareSge(), value.id, startValue.id, source));
            var beforeEnd = allocateValue(lowerer, irBool());
            var endPredicate = ir.compareSle();
            if !range.inclusive { endPredicate = ir.compareSlt(); }
            appendInstruction(lowerer, compareI64(beforeEnd.id, endPredicate, value.id, endValue.id, source));
            return lowerManagedBoolAnd(lowerer, LowerValue { id: afterStart.id, ty: afterStart.ty }, LowerValue { id: beforeEnd.id, ty: beforeEnd.ty }, source);
        },
        Pattern::Or(orPattern) => {
            var leftCondition = lowerManagedPatternCondition(lowerer, orPattern.left, value, expected);
            if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
            var rightCondition = lowerManagedPatternCondition(lowerer, orPattern.right, value, expected);
            if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
            return lowerManagedBoolOr(lowerer, leftCondition, rightCondition, source);
        },
        Pattern::Struct(structPattern) => {
            var structType = expected;
            if structType.kind == kindNullable { var maybeInner = structType.inner; if maybeInner != null { structType = requiredType(maybeInner, structType); } }
            if structType.kind != kindStruct || structPattern.structName != structType.name { return failPattern(lowerer, pattern, "struct pattern does not match its exact checked nominal type"); }
            var maybeNominal = nominalLayoutForType(lowerer.checked, structType);
            var layoutId = managedLayoutId(lowerer.managedLayouts, structType);
            var maybeLayout = findManagedLayout(lowerer.managedLayouts, layoutId);
            if maybeNominal == null || maybeLayout == null { return failPattern(lowerer, pattern, "struct pattern has no exact checked descriptor"); }
            var nominal = requiredNominalLayout(maybeNominal, lowerer.checked.nominalLayouts[0]);
            var layout = requiredManagedLayout(maybeLayout, lowerer.managedLayouts[0]);
            var all = allocateValue(lowerer, irBool());
            appendInstruction(lowerer, constBool(all.id, true, source));
            var combined = LowerValue { id: all.id, ty: all.ty };
            var fieldPatternIndex = 0;
            loop {
                if fieldPatternIndex >= structPattern.fields.len() { break; }
                var patternField = structPattern.fields[fieldPatternIndex];
                var checkedFieldIndex = -1;
                var fieldIndex = 0;
                loop { if fieldIndex >= nominal.fields.len() { break; } if nominal.fields[fieldIndex].name == patternField.name { checkedFieldIndex = nominal.fields[fieldIndex].fieldIndex; break; } fieldIndex = fieldIndex + 1; }
                if checkedFieldIndex < 0 || checkedFieldIndex >= layout.fields.len() { return failPattern(lowerer, pattern, "struct pattern field is absent from its exact checked layout"); }
                var fieldType = nominal.fields[checkedFieldIndex].ty;
                var fieldValue = lowerManagedFieldValue(lowerer, value, layout.fields[checkedFieldIndex], fieldType, source);
                var fieldCondition = lowerManagedPatternCondition(lowerer, patternField.pattern, fieldValue, fieldType);
                combined = lowerManagedBoolAnd(lowerer, combined, fieldCondition, source);
                fieldPatternIndex = fieldPatternIndex + 1;
            }
            return combined;
        },
        Pattern::EnumVariant(enumPattern) => {
            var nullable = expected.kind == kindNullable;
            var taggedType = expected;
            if nullable { var maybeInner = expected.inner; if maybeInner != null { taggedType = requiredType(maybeInner, expected); } }
            var variantIndex = managedPatternVariantIndex(lowerer.checked, taggedType, enumPattern.enumName, enumPattern.variant);
            if variantIndex < 0 { return failPattern(lowerer, pattern, "enum pattern variant does not match its exact checked scrutinee type"); }
            var tag = lowerManagedTaggedTag(lowerer, value, source);
            var wantedTag = managedI64Constant(lowerer, variantIndex, source);
            var tagMatches = allocateValue(lowerer, irBool());
            appendInstruction(lowerer, compareI64(tagMatches.id, ir.compareEq(), tag.id, wantedTag.id, source));
            if enumPattern.payloads.len() == 0 { return LowerValue { id: tagMatches.id, ty: tagMatches.ty }; }
            var payloadTypes = managedTaggedPayloadTypes(lowerer.checked, taggedType, variantIndex);
            if payloadTypes.len() != enumPattern.payloads.len() { return failPattern(lowerer, pattern, "enum pattern payload count differs from the checked variant shape"); }
            var result = allocateValue(lowerer, irBool());
            var mergeId = reserveBlock(lowerer, [result]);
            var payloadBlock = reserveBlock(lowerer, []);
            var failedBlock = reserveBlock(lowerer, []);
            finishBlock(lowerer, branch(tagMatches.id, payloadBlock, [], failedBlock, [], source));
            enterBlock(lowerer, payloadBlock, []);
            var all = allocateValue(lowerer, irBool());
            appendInstruction(lowerer, constBool(all.id, true, source));
            var conditions = LowerValue { id: all.id, ty: all.ty };
            var payloadIndex = 0;
            loop {
                if payloadIndex >= enumPattern.payloads.len() { break; }
                var payloadValue = lowerManagedTaggedPayloadField(lowerer, value, taggedType, variantIndex, payloadIndex, payloadTypes[payloadIndex], source);
                var payloadCondition = lowerManagedPatternCondition(lowerer, enumPattern.payloads[payloadIndex], payloadValue, payloadTypes[payloadIndex]);
                conditions = lowerManagedBoolAnd(lowerer, conditions, payloadCondition, source);
                payloadIndex = payloadIndex + 1;
            }
            finishBlock(lowerer, jump(mergeId, [conditions.id], source));
            enterBlock(lowerer, failedBlock, []);
            var no = allocateValue(lowerer, irBool());
            appendInstruction(lowerer, constBool(no.id, false, source));
            finishBlock(lowerer, jump(mergeId, [no.id], source));
            enterBlock(lowerer, mergeId, [result]);
            return LowerValue { id: result.id, ty: result.ty };
        },
    }
    return failPattern(lowerer, pattern, "unsupported managed pattern");
}

func bindingLookupKey(sourcePath: string, moduleId: string, declarationKey: string, name: string): string {
    return sourcePath.len().toString() + ":" + sourcePath + moduleId.len().toString() + ":" + moduleId + declarationKey.len().toString() + ":" + declarationKey + name.len().toString() + ":" + name;
}

func buildBindingIndex(checked: CheckedProgram): HashMap<string, Vec<int>> {
    var index: HashMap<string, Vec<int>> = HashMap.new();
    var bindingIndex = 0;
    loop {
        if bindingIndex >= checked.bindings.len() { break; }
        var binding = checked.bindings[bindingIndex];
        var key = bindingLookupKey(binding.sourcePath, binding.moduleId, binding.declarationKey, binding.name);
        if index.has(key) {
            var indices: Vec<int> = index.get(key);
            indices.push(bindingIndex);
            index.set(key, indices);
        } else { index.set(key, [bindingIndex]); }
        bindingIndex += 1;
    }
    return index;
}

func findPatternBinding(checked: CheckedProgram, bindingIndex: HashMap<string, Vec<int>>, sourcePath: string, moduleId: string, pattern: Pattern, name: string): CheckedBindingInfo? {
    var wantedKey = "Pattern:" + patternSpan(pattern).start.toString() + ":" + patternSpan(pattern).end.toString();
    var key = bindingLookupKey(sourcePath, moduleId, wantedKey, name);
    if !bindingIndex.has(key) { return null; }
    var indices: Vec<int> = bindingIndex.get(key);
    var index = 0;
    var found: CheckedBindingInfo? = null;
    loop {
        if index >= indices.len() { break; }
        var binding = checked.bindings[indices[index]];
        if binding.kind == litPattern {
            if found != null { return null; }
            found = binding;
        }
        index = index + 1;
    }
    return found;
}

func lowerManagedBindPattern(lowerer: FunctionLowerer, pattern: Pattern, value: LowerValue, expected: Type, identityPrefix: string): bool {
    match pattern {
        Pattern::Variable(variable) => {
            var variantIndex = managedPatternVariantIndex(lowerer.checked, expected, "", variable.name);
            if variantIndex >= 0 { return true; }
            var maybeBinding = findPatternBinding(lowerer.checked, lowerer.bindingIndex, lowerer.sourcePath, lowerer.moduleId, pattern, variable.name);
            if maybeBinding == null { lowerer.error = lowerError(lowerer.sourcePath, variable.span.start, "checked pattern binder metadata is missing or ambiguous"); return false; }
            var binding = requiredCheckedBindingInfo(maybeBinding, lowerer.checked.bindings[0]);
            if managedIRType(lowerer.managedLayouts, binding.ty).kind != value.ty.kind { lowerer.error = lowerError(lowerer.sourcePath, variable.span.start, "checked pattern binder type differs from its matched value"); return false; }
            bindLocal(lowerer, variable.name, identityPrefix + binding.declarationKey + ":" + variable.name, true, managedLayoutId(lowerer.managedLayouts, binding.ty), irValue(value.id, value.ty));
            return lowerer.error == emptyString;
        },
        Pattern::EnumVariant(enumPattern) => {
            var taggedType = expected;
            if taggedType.kind == kindNullable { var maybeInner = taggedType.inner; if maybeInner != null { taggedType = requiredType(maybeInner, taggedType); } }
            var variantIndex = managedPatternVariantIndex(lowerer.checked, taggedType, enumPattern.enumName, enumPattern.variant);
            if variantIndex < 0 { lowerer.error = lowerError(lowerer.sourcePath, enumPattern.span.start, "checked pattern variant cannot be resolved in its exact nominal type"); return false; }
            var payloadTypes = managedTaggedPayloadTypes(lowerer.checked, taggedType, variantIndex);
            if enumPattern.payloads.len() == 0 { return true; }
            if payloadTypes.len() != enumPattern.payloads.len() { lowerer.error = lowerError(lowerer.sourcePath, enumPattern.span.start, "checked pattern payload count differs from its variant shape"); return false; }
            var index = 0;
            loop {
                if index >= enumPattern.payloads.len() { break; }
                var payload = lowerManagedTaggedPayloadField(lowerer, value, taggedType, variantIndex, index, payloadTypes[index], spanRef(lowerer.sourcePath, enumPattern.span));
                if lowerer.error != emptyString { return false; }
                if !lowerManagedBindPattern(lowerer, enumPattern.payloads[index], payload, payloadTypes[index], identityPrefix + "payload:" + index.toString() + ":") { return false; }
                index = index + 1;
            }
            return true;
        },
        Pattern::Struct(structPattern) => {
            var structType = expected;
            if structType.kind == kindNullable { var maybeInner = structType.inner; if maybeInner != null { structType = requiredType(maybeInner, structType); } }
            var maybeNominal = nominalLayoutForType(lowerer.checked, structType);
            var maybeLayout = findManagedLayout(lowerer.managedLayouts, managedLayoutId(lowerer.managedLayouts, structType));
            if maybeNominal == null || maybeLayout == null { lowerer.error = lowerError(lowerer.sourcePath, structPattern.span.start, "struct pattern binder has no exact checked layout"); return false; }
            var nominal = requiredNominalLayout(maybeNominal, lowerer.checked.nominalLayouts[0]);
            var layout = requiredManagedLayout(maybeLayout, lowerer.managedLayouts[0]);
            var index = 0;
            loop {
                if index >= structPattern.fields.len() { break; }
                var patternField = structPattern.fields[index];
                var fieldIndex = 0;
                loop { if fieldIndex >= nominal.fields.len() { break; } if nominal.fields[fieldIndex].name == patternField.name { break; } fieldIndex = fieldIndex + 1; }
                if fieldIndex >= nominal.fields.len() { lowerer.error = lowerError(lowerer.sourcePath, patternField.span.start, "struct pattern binder field is absent from its checked layout"); return false; }
                var fieldType = nominal.fields[fieldIndex].ty;
                var fieldValue = lowerManagedFieldValue(lowerer, value, layout.fields[fieldIndex], fieldType, spanRef(lowerer.sourcePath, patternField.span));
                if !lowerManagedBindPattern(lowerer, patternField.pattern, fieldValue, fieldType, identityPrefix + "field:" + fieldIndex.toString() + ":") { return false; }
                index = index + 1;
            }
            return true;
        },
        Pattern::Or(orPattern) => {
            lowerer.error = lowerError(lowerer.sourcePath, patternSpan(pattern).start, "or-pattern binders require checker-joined binder metadata and are not yet lowered");
            return false;
        },
        _ => { return true; },
    }
}

func lowerManagedMatch(lowerer: FunctionLowerer, matchStmt: MatchStmt) {
    var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, matchStmt.scrutinee);
    if maybeInfo == null { lowerer.error = lowerError(lowerer.sourcePath, matchStmt.span.start, "managed match scrutinee has no checked type metadata"); return; }
    var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
    var scrutineeType = managedExpressionType(lowerer, info.ty);
    if !managedTypeIsSupported(lowerer.checked, lowerer.managedLayouts, scrutineeType, true) { lowerer.error = lowerError(lowerer.sourcePath, matchStmt.span.start, "managed match scrutinee type is unsupported"); return; }
    var scrutinee = lowerExprExpected(lowerer, matchStmt.scrutinee, scrutineeType);
    if lowerer.error != emptyString { return; }
    if lowerer.terminated { lowerer.error = lowerError(lowerer.sourcePath, matchStmt.span.start, "managed match scrutinee unexpectedly terminated control flow"); return; }
    if matchStmt.arms.len() == 0 { lowerer.error = lowerError(lowerer.sourcePath, matchStmt.span.start, "managed match has no checked arms"); return; }

    var beforeScopes = cloneScopes(lowerer.scopes);
    var mergeEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var mergeId = -1;
    var armIndex = 0;
    loop {
        if armIndex >= matchStmt.arms.len() { break; }
        var arm = matchStmt.arms[armIndex];
        var armInputScopes = cloneScopes(lowerer.scopes);
        var bodyEnvironment = makeBlockEnvironment(lowerer, armInputScopes);
        var nextEnvironment = makeBlockEnvironment(lowerer, armInputScopes);
        var condition = lowerManagedPatternCondition(lowerer, arm.pattern, scrutinee, scrutineeType);
        if lowerer.error != emptyString { return; }
        var bodyId = reserveBlock(lowerer, bodyEnvironment.params);
        var nextId = reserveBlock(lowerer, nextEnvironment.params);
        finishBlock(lowerer, branch(condition.id, bodyId, bodyEnvironment.args, nextId, nextEnvironment.args, spanRef(lowerer.sourcePath, arm.span)));

        lowerer.scopes = cloneScopes(bodyEnvironment.scopes);
        enterBlock(lowerer, bodyId, bodyEnvironment.params);
        pushScope(lowerer);
        if !lowerManagedBindPattern(lowerer, arm.pattern, scrutinee, scrutineeType, "match:" + patternSpan(arm.pattern).start.toString() + ":") {
            popScope(lowerer);
            return;
        }
        lowerStmt(lowerer, arm.body);
        popScope(lowerer);
        if lowerer.error != emptyString { return; }
        if !lowerer.terminated {
            if mergeId < 0 { mergeId = reserveBlock(lowerer, mergeEnvironment.params); }
            var mergeArgs = blockArgsForKeys(lowerer, lowerer.scopes, mergeEnvironment.bindingKeys, arm.span.start);
            if lowerer.error != emptyString { return; }
            finishBlock(lowerer, jump(mergeId, mergeArgs, spanRef(lowerer.sourcePath, arm.span)));
        }
        lowerer.scopes = cloneScopes(nextEnvironment.scopes);
        enterBlock(lowerer, nextId, nextEnvironment.params);
        armIndex = armIndex + 1;
    }
    finishManagedTrapBlock(lowerer, 2302, matchStmt.span);
    if mergeId >= 0 {
        lowerer.scopes = cloneScopes(mergeEnvironment.scopes);
        enterBlock(lowerer, mergeId, mergeEnvironment.params);
    }
    else { lowerer.terminated = true; lowerer.currentBlockId = -1; }
}

func lowerManagedStringCharValue(lowerer: FunctionLowerer, character: LowerValue, source: SourceRef): LowerValue {
    var layoutId = managedStringLayoutId(lowerer);
    if layoutId <= 0 { lowerer.error = lowerError(lowerer.sourcePath, source.start, "managed string layout is missing"); return LowerValue { id: -1, ty: irVoid() }; }
    var layoutValue = managedI64Constant(lowerer, layoutId, source);
    var sizeValue = managedI64Constant(lowerer, 10, source);
    var object = managedCallHook(lowerer, "managedAllocateSized", ir.irRawAddress(), [layoutValue.id, sizeValue.id], source);
    var lengthValue = managedI64Constant(lowerer, 1, source);
    var lengthOffset = managedI64Constant(lowerer, 16, source);
    var lengthAddress = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(lengthAddress.id, object.id, lengthOffset.id, source));
    appendInstruction(lowerer, ir.rawStoreI64(lengthAddress.id, lengthValue.id, source));
    var byteOffset = managedI64Constant(lowerer, 24, source);
    var byteAddress = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(byteAddress.id, object.id, byteOffset.id, source));
    appendInstruction(lowerer, ir.rawStoreByte(byteAddress.id, character.id, source));
    var nul = managedI64Constant(lowerer, 0, source);
    var nulOffset = managedI64Constant(lowerer, 25, source);
    var nulAddress = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(nulAddress.id, object.id, nulOffset.id, source));
    appendInstruction(lowerer, ir.rawStoreByte(nulAddress.id, nul.id, source));
    return object;
}

func lowerManagedCharRange(lowerer: FunctionLowerer, value: LowerValue, span: Span): bool {
    if value.id < 0 || value.ty.kind != IRTypeKind::I64 { lowerer.error = lowerError(lowerer.sourcePath, span.start, "char conversion requires an i64 value"); return false; }
    var source = spanRef(lowerer.sourcePath, span);
    var zero = managedI64Constant(lowerer, 0, source);
    var max = managedI64Constant(lowerer, 255, source);
    var aboveZero = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, compareI64(aboveZero.id, ir.compareSge(), value.id, zero.id, source));
    var belowLimit = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, compareI64(belowLimit.id, ir.compareSle(), value.id, max.id, source));
    var valid = lowerManagedBoolAnd(lowerer, LowerValue { id: aboveZero.id, ty: aboveZero.ty }, LowerValue { id: belowLimit.id, ty: belowLimit.ty }, source);
    var validBlock = reserveBlock(lowerer, []);
    var invalidBlock = reserveBlock(lowerer, []);
    finishBlock(lowerer, branch(valid.id, validBlock, [], invalidBlock, [], source));
    enterBlock(lowerer, invalidBlock, []);
    finishManagedTrapBlock(lowerer, 2302, span);
    enterBlock(lowerer, validBlock, []);
    return lowerer.error == emptyString;
}

func lowerManagedBoolString(lowerer: FunctionLowerer, value: LowerValue, expression: Expr): LowerValue {
    if value.id < 0 || value.ty.kind != IRTypeKind::Bool { return failExpression(lowerer, expression, "bool-to-string conversion requires a bool value"); }
    var source = spanRef(lowerer.sourcePath, exprSpan(expression));
    var stringType = ir.irRawAddress();
    var result = allocateValue(lowerer, stringType);
    var mergeId = reserveBlock(lowerer, [result]);
    var trueId = reserveBlock(lowerer, []);
    var falseId = reserveBlock(lowerer, []);
    finishBlock(lowerer, branch(value.id, trueId, [], falseId, [], source));
    enterBlock(lowerer, trueId, []);
    var trueExpr = Expr::Literal(LiteralExpr { kind: LiteralKind::String, text: "true", span: exprSpan(expression) });
    var trueText = lowerManagedStringLiteral(lowerer, trueExpr, LiteralExpr { kind: LiteralKind::String, text: "true", span: exprSpan(expression) });
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    finishBlock(lowerer, jump(mergeId, [trueText.id], source));
    enterBlock(lowerer, falseId, []);
    var falseExpr = Expr::Literal(LiteralExpr { kind: LiteralKind::String, text: "false", span: exprSpan(expression) });
    var falseText = lowerManagedStringLiteral(lowerer, falseExpr, LiteralExpr { kind: LiteralKind::String, text: "false", span: exprSpan(expression) });
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    finishBlock(lowerer, jump(mergeId, [falseText.id], source));
    enterBlock(lowerer, mergeId, [result]);
    return LowerValue { id: result.id, ty: result.ty };
}

func lowerManagedPrintable(lowerer: FunctionLowerer, expression: Expr, argument: LowerValue, source: SourceRef): LowerValue {
    var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
    if maybeInfo == null { return failExpression(lowerer, expression, "print argument has no checked type"); }
    var argumentInfo = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
    if argumentInfo.ty.kind == kindString { return argument; }
    if argumentInfo.ty.kind == kindBool { return lowerManagedBoolString(lowerer, argument, expression); }
    if argumentInfo.ty.kind == kindChar { return lowerManagedStringCharValue(lowerer, argument, source); }
    if argumentInfo.ty.kind == kindInt {
        var layoutValue = managedI64Constant(lowerer, managedStringLayoutId(lowerer), source);
        return managedCallHook(lowerer, "managedStringFromInt", ir.irRawAddress(), [layoutValue.id, argument.id], source);
    }
    return failExpression(lowerer, expression, "managed print supports string, bool, int, and char arguments");
}

func lowerManagedAssert(lowerer: FunctionLowerer, expression: Expr, callExpr: CallExpr, source: SourceRef): LowerValue {
    if callExpr.args.len() != 2 { return failExpression(lowerer, expression, "assert requires a condition and a message"); }
    var condition = lowerExprExpected(lowerer, callExpr.args[0], plainType(kindBool));
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    if condition.id < 0 || condition.ty.kind != IRTypeKind::Bool { return failExpression(lowerer, expression, "assert condition must be bool"); }

    var message = lowerExpr(lowerer, callExpr.args[1]);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    var maybeMessageInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, callExpr.args[1]);
    if maybeMessageInfo == null { return failExpression(lowerer, callExpr.args[1], "assert message has no checked type"); }
    var messageInfo = requiredCheckedExprInfo(maybeMessageInfo, lowerer.checked.expressions[0]);
    var rendered = message;
    if messageInfo.ty.kind == kindChar {
        rendered = lowerManagedStringCharValue(lowerer, message, source);
    } else if messageInfo.ty.kind == kindNull {
        var nullLiteral = LiteralExpr { kind: LiteralKind::String, text: "null", span: exprSpan(callExpr.args[1]) };
        rendered = lowerManagedStringLiteral(lowerer, callExpr.args[1], nullLiteral);
    } else {
        rendered = lowerManagedPrintable(lowerer, callExpr.args[1], message, source);
    }
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }

    var beforeScopes = cloneScopes(lowerer.scopes);
    var passEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var failEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var passId = reserveBlock(lowerer, passEnvironment.params);
    var failId = reserveBlock(lowerer, failEnvironment.params);
    finishBlock(lowerer, branch(condition.id, passId, passEnvironment.args, failId, failEnvironment.args, source));

    lowerer.scopes = cloneScopes(failEnvironment.scopes);
    enterBlock(lowerer, failId, failEnvironment.params);
    var prefixLiteral = LiteralExpr { kind: LiteralKind::String, text: "rey panic: ", span: exprSpan(expression) };
    var prefix = lowerManagedStringLiteral(lowerer, expression, prefixLiteral);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    var stderr = managedI64Constant(lowerer, 2, source);
    managedCallHook(lowerer, litManagedWriteString, irVoid(), [prefix.id, stderr.id], source);
    managedCallHook(lowerer, litManagedWriteString, irVoid(), [rendered.id, stderr.id], source);
    var newlineLiteral = LiteralExpr { kind: LiteralKind::String, text: "\n", span: exprSpan(expression) };
    var newline = lowerManagedStringLiteral(lowerer, expression, newlineLiteral);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    managedCallHook(lowerer, litManagedWriteString, irVoid(), [newline.id, stderr.id], source);
    var exitCode = managedI64Constant(lowerer, 1, source);
    managedCallHook(lowerer, litManagedExit, irVoid(), [exitCode.id], source);
    var passArguments = blockArgsForKeys(lowerer, lowerer.scopes, passEnvironment.bindingKeys, source.start);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    finishBlock(lowerer, jump(passId, passArguments, source));

    lowerer.scopes = cloneScopes(passEnvironment.scopes);
    enterBlock(lowerer, passId, passEnvironment.params);
    return LowerValue { id: -1, ty: irVoid() };
}

func lowerManagedBuiltinCall(lowerer: FunctionLowerer, expression: Expr, callExpr: CallExpr, info: CheckedExprInfo, symbol: ResolvedSymbol): LowerValue {
    var intrinsic = symbol.intrinsicId;
    var source = spanRef(lowerer.sourcePath, exprSpan(expression));
    if intrinsic == litAssert { return lowerManagedAssert(lowerer, expression, callExpr, source); }
    if intrinsic == litPrint || intrinsic == litPrintln || intrinsic == litEprint || intrinsic == litEprintln {
        var fd = 1;
        if intrinsic == litEprint || intrinsic == litEprintln { fd = 2; }
        var printIndex = 0;
        while printIndex < callExpr.args.len() {
            var argument = lowerExpr(lowerer, callExpr.args[printIndex]);
            if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
            var printable = lowerManagedPrintable(lowerer, callExpr.args[printIndex], argument, source);
            if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
            var fdValue = managedI64Constant(lowerer, fd, source);
            var discarded = managedCallHook(lowerer, "managedWriteString", irVoid(), [printable.id, fdValue.id], source);
            if lowerer.error != emptyString { return discarded; }
            printIndex = printIndex + 1;
        }
        if intrinsic == litPrintln || intrinsic == litEprintln {
            var newlineLiteral = LiteralExpr { kind: LiteralKind::String, text: "\n", span: exprSpan(expression) };
            var newline = lowerManagedStringLiteral(lowerer, expression, newlineLiteral);
            if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
            var newlineFd = managedI64Constant(lowerer, fd, source);
            var discardedNewline = managedCallHook(lowerer, "managedWriteString", irVoid(), [newline.id, newlineFd.id], source);
            if lowerer.error != emptyString { return discardedNewline; }
        }
        return LowerValue { id: -1, ty: irVoid() };
    }
    if intrinsic == litArgs {
        if callExpr.args.len() != 0 { return failExpression(lowerer, expression, "args expects no arguments"); }
        var resultType = managedExpressionType(lowerer, info.ty);
        if resultType.kind != kindArray { return failExpression(lowerer, expression, "args requires a concrete Vec<String> result type"); }
        var element = managedArrayElementType(resultType);
        if element.kind != kindString { return failExpression(lowerer, expression, "args requires Vec<String>"); }
        var headerId = managedLayoutId(lowerer.managedLayouts, resultType);
        var dataId = managedArrayBackingLayoutId(lowerer, element);
        var stringId = managedStringLayoutId(lowerer);
        if headerId <= 0 || dataId <= 0 || stringId <= 0 { return failExpression(lowerer, expression, "args requires registered Vec/String layout descriptors"); }
        var header = managedI64Constant(lowerer, headerId, source);
        var data = managedI64Constant(lowerer, dataId, source);
        var text = managedI64Constant(lowerer, stringId, source);
        return managedCallHook(lowerer, "managedArgsCreate", ir.irRawAddress(), [header.id, data.id, text.id], source);
    }
    if intrinsic == litFileExists {
        if callExpr.args.len() != 1 { return failExpression(lowerer, expression, "fileExists expects one path"); }
        var path = lowerExpr(lowerer, callExpr.args[0]);
        if path.id < 0 || path.ty.kind != IRTypeKind::RawAddress { return failExpression(lowerer, expression, "fileExists path must be a managed string"); }
        return managedCallHook(lowerer, "managedFileExists", irBool(), [path.id], source);
    }
    if intrinsic == litDeleteFile {
        if callExpr.args.len() != 1 { return failExpression(lowerer, expression, "deleteFile expects one path"); }
        var path = lowerExpr(lowerer, callExpr.args[0]);
        if path.id < 0 || path.ty.kind != IRTypeKind::RawAddress { return failExpression(lowerer, expression, "deleteFile path must be a managed string"); }
        return managedCallHook(lowerer, "managedDeleteFile", irVoid(), [path.id], source);
    }
    if intrinsic == litReadFile {
        if callExpr.args.len() != 1 { return failExpression(lowerer, expression, "readFile expects one path"); }
        var path = lowerExpr(lowerer, callExpr.args[0]);
        if path.id < 0 || path.ty.kind != IRTypeKind::RawAddress { return failExpression(lowerer, expression, "readFile path must be a managed string"); }
        var stringLayout = managedI64Constant(lowerer, managedStringLayoutId(lowerer), source);
        return managedCallHook(lowerer, "managedReadFile", ir.irRawAddress(), [path.id, stringLayout.id], source);
    }
    if intrinsic == litWriteFile || intrinsic == litAppendFile {
        if callExpr.args.len() != 2 { return failExpression(lowerer, expression, intrinsic + " expects a path and content"); }
        var path = lowerExpr(lowerer, callExpr.args[0]);
        var content = lowerExpr(lowerer, callExpr.args[1]);
        if path.id < 0 || content.id < 0 || path.ty.kind != IRTypeKind::RawAddress || content.ty.kind != IRTypeKind::RawAddress { return failExpression(lowerer, expression, intrinsic + " requires managed strings"); }
        var helper = "managedWriteFile";
        if intrinsic == litAppendFile { helper = "managedAppendFile"; }
        return managedCallHook(lowerer, helper, irVoid(), [path.id, content.id], source);
    }
    if intrinsic == litListDir {
        if callExpr.args.len() != 1 { return failExpression(lowerer, expression, "listDir expects one path"); }
        var path = lowerExpr(lowerer, callExpr.args[0]);
        if path.id < 0 || path.ty.kind != IRTypeKind::RawAddress { return failExpression(lowerer, expression, "listDir path must be a managed string"); }
        var resultType = managedExpressionType(lowerer, info.ty);
        if resultType.kind != kindArray { return failExpression(lowerer, expression, "listDir requires a concrete Vec<String> result type"); }
        var element = managedArrayElementType(resultType);
        if element.kind != kindString { return failExpression(lowerer, expression, "listDir requires Vec<String>"); }
        var headerId = managedLayoutId(lowerer.managedLayouts, resultType);
        var dataId = managedArrayBackingLayoutId(lowerer, element);
        var stringId = managedStringLayoutId(lowerer);
        if headerId <= 0 || dataId <= 0 || stringId <= 0 { return failExpression(lowerer, expression, "listDir requires registered Vec/String layout descriptors"); }
        var header = managedI64Constant(lowerer, headerId, source);
        var data = managedI64Constant(lowerer, dataId, source);
        var text = managedI64Constant(lowerer, stringId, source);
        return managedCallHook(lowerer, "managedListDir", ir.irRawAddress(), [path.id, text.id, header.id, data.id], source);
    }
    if intrinsic == litExit {
        if callExpr.args.len() != 1 { return failExpression(lowerer, expression, "exit expects one status"); }
        var status = lowerExpr(lowerer, callExpr.args[0]);
        if status.id < 0 || status.ty.kind != IRTypeKind::I64 { return failExpression(lowerer, expression, "exit status must be an int"); }
        return managedCallHook(lowerer, "managedExit", irVoid(), [status.id], source);
    }
    if intrinsic == litVecNew {
        var resultType = managedExpressionType(lowerer, info.ty);
        if resultType.kind != kindArray { return failExpression(lowerer, expression, "Vec.new requires a concrete contextual Vec element type"); }
        var element = managedArrayElementType(resultType);
        var headerId = managedLayoutId(lowerer.managedLayouts, resultType);
        var dataId = managedArrayBackingLayoutId(lowerer, element);
        if element.kind == kindAny || element.kind == kindUnknown || element.kind == kindFloat || headerId <= 0 || dataId <= 0 { return failExpression(lowerer, expression, "Vec.new requires a supported concrete element type and descriptors"); }
        var headerValue = managedI64Constant(lowerer, headerId, source);
        var dataValue = managedI64Constant(lowerer, dataId, source);
        var capacity = managedI64Constant(lowerer, 0, source);
        return managedCallHook(lowerer, "managedVecCreate", ir.irRawAddress(), [headerValue.id, dataValue.id, capacity.id], source);
    }
    if intrinsic == litHashMapNew {
        var resultType = managedExpressionType(lowerer, info.ty);
        if resultType.kind != kindDict || resultType.value == null { return failExpression(lowerer, expression, "HashMap.new requires a concrete contextual value type"); }
        var valueType = requiredType(resultType.value, managedUnknownType());
        var mapId = managedLayoutId(lowerer.managedLayouts, resultType);
        var bucketsId = managedMapBucketsLayoutId(lowerer, valueType);
        if valueType.kind == kindAny || valueType.kind == kindFloat || mapId <= 0 || bucketsId <= 0 { return failExpression(lowerer, expression, "HashMap.new requires a supported concrete value type and descriptors"); }
        var mapValue = managedI64Constant(lowerer, mapId, source);
        var bucketsValue = managedI64Constant(lowerer, bucketsId, source);
        return managedCallHook(lowerer, "managedMapCreate", ir.irRawAddress(), [mapValue.id, bucketsValue.id], source);
    }
    if intrinsic == litInt || intrinsic == litChar || intrinsic == litString {
        if callExpr.args.len() != 1 { return failExpression(lowerer, expression, "managed conversion requires exactly one argument"); }
        var argumentInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, callExpr.args[0]);
        if argumentInfo == null { return failExpression(lowerer, expression, "managed conversion argument has no checked type"); }
        var argInfo = requiredCheckedExprInfo(argumentInfo, lowerer.checked.expressions[0]);
        var argument = lowerExpr(lowerer, callExpr.args[0]);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        if intrinsic == litInt && argInfo.ty.kind == kindChar { return argument; }
        if intrinsic == litInt && argInfo.ty.kind == kindString { return managedCallHook(lowerer, "managedStringToInt", irI64(), [argument.id], source); }
        if intrinsic == litChar && argInfo.ty.kind == kindInt { if !lowerManagedCharRange(lowerer, argument, exprSpan(expression)) { return LowerValue { id: -1, ty: irVoid() }; } return argument; }
        if intrinsic == litChar && argInfo.ty.kind == kindChar { return argument; }
        if intrinsic == litString && argInfo.ty.kind == kindString { return argument; }
        if intrinsic == litString && argInfo.ty.kind == kindChar { return lowerManagedStringCharValue(lowerer, argument, source); }
        if intrinsic == litString && argInfo.ty.kind == kindBool { return lowerManagedBoolString(lowerer, argument, expression); }
        if intrinsic == litString && (argInfo.ty.kind == kindInt || argInfo.ty.kind == kindChar) {
            var layoutId = managedStringLayoutId(lowerer);
            var layoutValue = managedI64Constant(lowerer, layoutId, source);
            return managedCallHook(lowerer, "managedStringFromInt", ir.irRawAddress(), [layoutValue.id, argument.id], source);
        }
        if intrinsic == litString && argInfo.ty.kind == kindBool { return failExpression(lowerer, expression, "bool-to-string conversion is not in the managed helper contract"); }
        return failExpression(lowerer, expression, "managed conversion from " + argInfo.ty.kind + " is unsupported");
    }
    if intrinsic.endsWith(".toString") {
        if callExpr.args.len() != 0 { return failExpression(lowerer, expression, "toString expects no arguments"); }
        var accessForString: FieldAccessExpr? = null;
        match callExpr.callee { Expr::FieldAccess(fieldAccess) => { accessForString = fieldAccess; }, _ => {} }
        if accessForString == null { return failExpression(lowerer, expression, "toString requires a checked receiver"); }
        var receiverAccess = requiredFieldAccess(accessForString, fallbackFieldAccess(callExpr.callee));
        var receiverTypeForString = info.receiverType;
        var value = lowerExprExpected(lowerer, receiverAccess.object, receiverTypeForString);
        if receiverTypeForString.kind == kindString { return value; }
        if receiverTypeForString.kind == kindBool { return lowerManagedBoolString(lowerer, value, expression); }
        if receiverTypeForString.kind == kindChar { return lowerManagedStringCharValue(lowerer, value, source); }
        if receiverTypeForString.kind == kindInt {
            var stringLayoutValue = managedI64Constant(lowerer, managedStringLayoutId(lowerer), source);
            return managedCallHook(lowerer, "managedStringFromInt", ir.irRawAddress(), [stringLayoutValue.id, value.id], source);
        }
        return failExpression(lowerer, expression, "toString is unsupported for managed receiver type " + receiverTypeForString.kind);
    }
    var maybeAccess: FieldAccessExpr? = null;
    match callExpr.callee { Expr::FieldAccess(access) => { maybeAccess = access; }, _ => {} }
    if maybeAccess == null { return failExpression(lowerer, expression, "managed builtin is outside the supported conversion/method surface: " + intrinsic); }
    var access = requiredFieldAccess(maybeAccess, fallbackFieldAccess(callExpr.callee));
    var receiverType = info.receiverType;
    if receiverType.kind == kindUnknown { receiverType = symbol.receiverType; }
    if receiverType.kind == kindUnknown { return failExpression(lowerer, expression, "managed method call has no exact checked receiver type"); }
    var receiver = lowerExprExpected(lowerer, access.object, receiverType);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    if receiver.id < 0 || receiver.ty.kind != IRTypeKind::RawAddress { return failExpression(lowerer, expression, "managed collection/string method receiver is not a canonical reference"); }
    var method = access.name;
    var args: Vec<LowerValue> = [];
    var argIndex = 0;
    loop {
        if argIndex >= callExpr.args.len() { break; }
        var fallbackType: Type = Type { kind: kindUnknown, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
        if argIndex < symbol.signature.params.len() { fallbackType = symbol.signature.params[argIndex]; }
        var expected = managedMethodArgumentType(receiverType, method, argIndex, fallbackType);
        if expected.kind == kindUnknown || expected.kind == kindAny {
            var checkedArgument = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, callExpr.args[argIndex]);
            if checkedArgument != null { var checkedArg: CheckedExprInfo = checkedArgument; expected = checkedArg.ty; }
        }
        var argument = lowerExprExpected(lowerer, callExpr.args[argIndex], expected);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        args.push(argument);
        argIndex = argIndex + 1;
    }
    if receiverType.kind == kindString {
        if method == litToString { return receiver; }
        if method == litLen { return managedCallHook(lowerer, "managedStringLength", irI64(), [receiver.id], source); }
        if method == litHash { return managedCallHook(lowerer, "managedStringHash", irI64(), [receiver.id], source); }
        if method == litToInt { return managedCallHook(lowerer, "managedStringToInt", irI64(), [receiver.id], source); }
        if method == litContains { return managedCallHook(lowerer, "managedStringContains", irBool(), [receiver.id, args[0].id], source); }
        if method == litStartsWith { return managedCallHook(lowerer, "managedStringStartsWith", irBool(), [receiver.id, args[0].id], source); }
        if method == litEndsWith { return managedCallHook(lowerer, "managedStringEndsWith", irBool(), [receiver.id, args[0].id], source); }
        if method == litIndexOf { return managedCallHook(lowerer, "managedStringIndexOf", irI64(), [receiver.id, args[0].id], source); }
        var stringLayout = managedI64Constant(lowerer, managedStringLayoutId(lowerer), source);
        if method == litSlice { return managedCallHook(lowerer, "managedStringSlice", ir.irRawAddress(), [stringLayout.id, receiver.id, args[0].id, args[1].id], source); }
        if method == litReplace { return managedCallHook(lowerer, "managedStringReplace", ir.irRawAddress(), [stringLayout.id, receiver.id, args[0].id, args[1].id], source); }
        if method == litRepeat { return managedCallHook(lowerer, "managedStringRepeat", ir.irRawAddress(), [stringLayout.id, receiver.id, args[0].id], source); }
        if method == litToUpper || method == litToLower { var upper = allocateValue(lowerer, irBool()); appendInstruction(lowerer, constBool(upper.id, method == litToUpper, source)); return managedCallHook(lowerer, "managedStringCase", ir.irRawAddress(), [stringLayout.id, receiver.id, upper.id], source); }
        if method == litTrim { return managedCallHook(lowerer, "managedStringTrim", ir.irRawAddress(), [stringLayout.id, receiver.id], source); }
        if method == litPadLeft || method == litPadRight { var left = allocateValue(lowerer, irBool()); appendInstruction(lowerer, constBool(left.id, method == litPadLeft, source)); return managedCallHook(lowerer, "managedStringPad", ir.irRawAddress(), [stringLayout.id, receiver.id, args[0].id, args[1].id, left.id], source); }
    }
    if receiverType.kind == kindArray {
        var elementType = managedArrayElementType(receiverType);
        var elementIsReference = managedLayoutId(lowerer.managedLayouts, elementType) > 0;
        var backingId = managedArrayBackingLayoutId(lowerer, elementType);
        var backing = managedI64Constant(lowerer, backingId, source);
        if method == litJoin {
            if elementType.kind != kindString { return failExpression(lowerer, expression, "Vec.join requires String elements"); }
            var stringLayout = managedI64Constant(lowerer, managedStringLayoutId(lowerer), source);
            return managedCallHook(lowerer, "managedVecJoin", ir.irRawAddress(), [receiver.id, args[0].id, stringLayout.id], source);
        }
        if method == litLen { return managedCallHook(lowerer, "managedVecLength", irI64(), [receiver.id], source); }
        if method == litContains {
            if elementIsReference {
                var containsHelper = "managedVecContainsReference";
                if elementType.kind == kindString { containsHelper = "managedVecContainsString"; }
                return managedCallHook(lowerer, containsHelper, irBool(), [receiver.id, args[0].id], source);
            }
            var searched = args[0];
            if searched.ty.kind == IRTypeKind::Bool { var encodedSearch = lowerBoolAsI64(lowerer, searched.id, source); searched = LowerValue { id: encodedSearch.id, ty: encodedSearch.ty }; }
            if searched.ty.kind != IRTypeKind::I64 { return failExpression(lowerer, expression, "Vec.contains requires i64, bool, or reference elements"); }
            return managedCallHook(lowerer, "managedVecContainsI64", irBool(), [receiver.id, searched.id], source);
        }
        if method == litGet {
            if elementIsReference { return managedCallHook(lowerer, "managedVecGetReference", ir.irRawAddress(), [receiver.id, args[0].id], source); }
            var value = managedCallHook(lowerer, "managedVecGetI64", irI64(), [receiver.id, args[0].id], source);
            if elementType.kind == kindBool { return lowerManagedI64AsBool(lowerer, value, source); }
            return value;
        }
        if method == litSet || method == litPush {
            var value = args[0];
            if method == litSet { value = args[1]; }
            var helper = "managedVecSetI64";
            var operands: Vec<int> = [receiver.id, args[0].id, value.id];
            if method == litPush { helper = "managedVecPushI64"; operands = [receiver.id, backing.id, value.id]; }
            if elementIsReference { helper = "managedVecSetReference"; if method == litPush { helper = "managedVecPushReference"; operands = [receiver.id, backing.id, value.id]; } }
            else if value.ty.kind == IRTypeKind::Bool { var encoded = lowerBoolAsI64(lowerer, value.id, source); operands.set(operands.len() - 1, encoded.id); }
            var discarded = managedCallHook(lowerer, helper, irVoid(), operands, source);
            return discarded;
        }
        if method == litPop {
            if elementIsReference { return managedCallHook(lowerer, "managedVecPopReference", ir.irRawAddress(), [receiver.id], source); }
            var popped = managedCallHook(lowerer, "managedVecPopI64", irI64(), [receiver.id], source);
            if elementType.kind == kindBool { return lowerManagedI64AsBool(lowerer, popped, source); }
            return popped;
        }
    }
    if receiverType.kind == kindDict {
        var valueType = requiredType(receiverType.value, managedUnknownType());
        var valueIsReference = managedLayoutId(lowerer.managedLayouts, valueType) > 0;
        if method == litLen { return managedCallHook(lowerer, "managedMapLength", irI64(), [receiver.id], source); }
        if method == litKeys {
            var keysType = managedExpressionType(lowerer, info.ty);
            if keysType.kind != kindArray { return failExpression(lowerer, expression, "HashMap.keys must produce a checked Vec<string>"); }
            var keyType = managedArrayElementType(keysType);
            var keyHeaderId = managedLayoutId(lowerer.managedLayouts, keysType);
            var keyDataId = managedArrayBackingLayoutId(lowerer, keyType);
            if keyType.kind != kindString || keyHeaderId <= 0 || keyDataId <= 0 { return failExpression(lowerer, expression, "HashMap.keys requires registered Vec<string> descriptors"); }
            var keyHeader = managedI64Constant(lowerer, keyHeaderId, source);
            var keyData = managedI64Constant(lowerer, keyDataId, source);
            return managedCallHook(lowerer, "managedMapKeys", ir.irRawAddress(), [receiver.id, keyHeader.id, keyData.id], source);
        }
        if method == litHas { return managedCallHook(lowerer, "managedMapHas", irBool(), [receiver.id, args[0].id], source); }
        if method == litGet {
            if valueIsReference { return managedCallHook(lowerer, "managedMapGetReference", ir.irRawAddress(), [receiver.id, args[0].id], source); }
            var value = managedCallHook(lowerer, "managedMapGetI64", irI64(), [receiver.id, args[0].id], source);
            if valueType.kind == kindBool { return lowerManagedI64AsBool(lowerer, value, source); }
            return value;
        }
        if method == litSet || method == litDelete {
            if method == litDelete { var erased = managedCallHook(lowerer, "managedMapDelete", irBool(), [receiver.id, args[0].id], source); return LowerValue { id: -1, ty: irVoid() }; }
            var nodeId = managedMapNodeLayoutId(lowerer, valueType);
            var node = managedI64Constant(lowerer, nodeId, source);
            var value = args[1];
            if valueIsReference { return managedCallHook(lowerer, "managedMapSetReference", irVoid(), [receiver.id, node.id, args[0].id, value.id], source); }
            if value.ty.kind == IRTypeKind::Bool { var encoded = lowerBoolAsI64(lowerer, value.id, source); value = LowerValue { id: encoded.id, ty: encoded.ty }; }
            return managedCallHook(lowerer, "managedMapSetI64", irVoid(), [receiver.id, node.id, args[0].id, value.id], source);
        }
    }
    if receiverType.kind == kindOption || receiverType.kind == kindResult { return lowerManagedTaggedMethod(lowerer, expression, receiver, receiverType, method, args, source); }
    return failExpression(lowerer, expression, "managed method '" + method + "' on " + receiverType.kind + " is outside the implemented core");
}

func lowerManagedFieldAccess(lowerer: FunctionLowerer, expression: Expr, access: FieldAccessExpr): LowerValue {
    var maybeField = managedFieldForAccess(lowerer, expression, access);
    if maybeField == null { return LowerValue { id: -1, ty: irVoid() }; }
    var field = requiredManagedField(maybeField, ManagedField { name: emptyString, offset: 0, kind: IRTypeKind::I64, layoutId: 0 });
    var owner = lowerExpr(lowerer, access.object);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    if owner.ty.kind != IRTypeKind::RawAddress || owner.id < 0 {
        return failExpression(lowerer, expression, "managed field receiver did not lower to a canonical reference");
    }
    var addressOffset = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(addressOffset.id, 16 + field.offset, spanRef(lowerer.sourcePath, access.span)));
    var address = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawOffset(address.id, owner.id, addressOffset.id, spanRef(lowerer.sourcePath, access.span)));
    if field.kind == IRTypeKind::RawAddress {
        var loadedReference = allocateValue(lowerer, ir.irRawAddress());
        appendInstruction(lowerer, ir.rawLoadAddress(loadedReference.id, address.id, spanRef(lowerer.sourcePath, access.span)));
        return LowerValue { id: loadedReference.id, ty: loadedReference.ty };
    }
    var loadedWord = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, ir.rawLoadI64(loadedWord.id, address.id, spanRef(lowerer.sourcePath, access.span)));
    if field.kind == IRTypeKind::Bool {
        var zero = allocateValue(lowerer, irI64());
        appendInstruction(lowerer, constI64(zero.id, 0, spanRef(lowerer.sourcePath, access.span)));
        var loadedBool = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, compareI64(loadedBool.id, ir.compareNe(), loadedWord.id, zero.id, spanRef(lowerer.sourcePath, access.span)));
        return LowerValue { id: loadedBool.id, ty: loadedBool.ty };
    }
    return LowerValue { id: loadedWord.id, ty: loadedWord.ty };
}

func lowerManagedStructLiteral(lowerer: FunctionLowerer, expression: Expr, literal: StructLiteralExpr): LowerValue {
    var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
    if maybeInfo == null { return failExpression(lowerer, expression, "checked struct literal identity is missing"); }
    var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
    var layoutId = managedLayoutId(lowerer.managedLayouts, info.ty);
    var maybeLayout = findManagedLayout(lowerer.managedLayouts, layoutId);
    if maybeLayout == null { return failExpression(lowerer, expression, "struct literal has no owner-matched managed layout"); }
    var layout = requiredManagedLayout(maybeLayout, lowerer.managedLayouts[0]);
    var allocationLayout = allocateValue(lowerer, irI64());
    var source = spanRef(lowerer.sourcePath, literal.span);
    appendInstruction(lowerer, constI64(allocationLayout.id, layoutId, source));
    var object = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, call(object.id, object.ty, lowerer.allocateFunctionId, [allocationLayout.id], source));
    var zeroFieldIndex = 0;
    loop {
        if zeroFieldIndex >= layout.fields.len() { break; }
        if !initializeManagedFieldZero(lowerer, object, layout.fields[zeroFieldIndex], source) { return LowerValue { id: -1, ty: irVoid() }; }
        zeroFieldIndex = zeroFieldIndex + 1;
    }
    var initialized: Vec<bool> = [];
    var fieldIndex = 0;
    loop { if fieldIndex >= layout.fields.len() { break; } initialized.push(false); fieldIndex = fieldIndex + 1; }
    var initIndex = 0;
    loop {
        if initIndex >= literal.fields.len() { break; }
        var initializer = literal.fields[initIndex];
        var maybeInitInfo = findFieldInitializer(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression, literal, initializer);
        if maybeInitInfo == null { return failExpression(lowerer, expression, "checked struct field initializer identity is missing or ambiguous"); }
        var initInfo = requiredCheckedFieldInitInfo(maybeInitInfo, lowerer.checked.fieldInitializers[0]);
        if initInfo.fieldIndex < 0 || initInfo.fieldIndex >= layout.fields.len() {
            return failExpression(lowerer, initializer.value, "checked struct field initializer index is outside its nominal layout");
        }
        var field = layout.fields[initInfo.fieldIndex];
        if field.name != initializer.name || initialized[initInfo.fieldIndex] {
            return failExpression(lowerer, initializer.value, "checked struct initializer index does not match its source field");
        }
        var value = lowerExprExpected(lowerer, initializer.value, initInfo.valueType);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        var actualLayout = 0;
        var valueIsNull = false;
        var maybeValueInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, initializer.value);
        if maybeValueInfo != null {
            var valueInfo = requiredCheckedExprInfo(maybeValueInfo, lowerer.checked.expressions[0]);
            var effectiveValueType = valueInfo.ty;
            if valueInfo.ty.kind == kindNull { effectiveValueType = initInfo.valueType; }
            if valueInfo.ty.kind == initInfo.valueType.kind && managedTypeContainsAny(valueInfo.ty) { effectiveValueType = initInfo.valueType; }
            if managedTypeHasNullLeaf(valueInfo.ty) && managedNullSpecializationCompatible(valueInfo.ty, initInfo.valueType, lowerer.managedLayouts) { effectiveValueType = initInfo.valueType; }
            actualLayout = managedLayoutId(lowerer.managedLayouts, effectiveValueType);
            valueIsNull = valueInfo.ty.kind == kindNull;
        }
        if field.layoutId > 0 {
            if value.ty.kind != IRTypeKind::RawAddress || (actualLayout != field.layoutId && !valueIsNull) {
                return failExpression(lowerer, initializer.value, "checked managed reference initializer does not match the field layout");
            }
        } else if value.ty.kind != field.kind {
            return failExpression(lowerer, initializer.value, "checked scalar initializer does not match the managed field layout");
        }
        if !emitManagedFieldStore(lowerer, object, field, value, initializer.span) { return LowerValue { id: -1, ty: irVoid() }; }
        initialized.set(initInfo.fieldIndex, true);
        initIndex = initIndex + 1;
    }
    fieldIndex = 0;
    loop {
        if fieldIndex >= initialized.len() { break; }
        if !initialized[fieldIndex] { return failExpression(lowerer, expression, "checked struct literal omits a required field"); }
        fieldIndex = fieldIndex + 1;
    }
    return LowerValue { id: object.id, ty: object.ty };
}

func lowerManagedTaggedConstructor(lowerer: FunctionLowerer, expression: Expr, args: Vec<Expr>, info: CheckedExprInfo, symbol: ResolvedSymbol): LowerValue {
    var resultType = managedExpressionType(lowerer, info.ty);
    var outerLayoutId = managedLayoutId(lowerer.managedLayouts, resultType);
    var maybeOuterLayout = findManagedLayout(lowerer.managedLayouts, outerLayoutId);
    if maybeOuterLayout == null { return failExpression(lowerer, expression, "tagged constructor has no concrete managed outer layout"); }
    var outerLayout = requiredManagedLayout(maybeOuterLayout, lowerer.managedLayouts[0]);
    if outerLayout.fields.len() != 2 || outerLayout.fields[0].name != litTag || outerLayout.fields[1].name != litPayload || outerLayout.fields[1].layoutId != -1 {
        return failExpression(lowerer, expression, "tagged constructor outer descriptor does not match the checked tagged-value schema");
    }
    var variantIndex = info.variantIndex;
    var payloadTypes: Vec<Type> = [];
    var payloadKey = "";
    if resultType.kind == kindEnum {
        var maybeNominal = nominalLayoutForType(lowerer.checked, resultType);
        if maybeNominal == null { return failExpression(lowerer, expression, "enum constructor has no exact checked nominal layout"); }
        var nominal = requiredNominalLayout(maybeNominal, lowerer.checked.nominalLayouts[0]);
        if variantIndex < 0 || variantIndex >= nominal.variants.len() || nominal.variants[variantIndex].variantIndex != variantIndex {
            return failExpression(lowerer, expression, "enum constructor variant index is outside the checked nominal layout");
        }
        var variant = nominal.variants[variantIndex];
        if symbol.sourceName != resultType.name + "::" + variant.name { return failExpression(lowerer, expression, "enum constructor symbol does not match its checked variant index"); }
        payloadTypes = variant.payloadTypes;
        payloadKey = "$enum-payload:" + outerLayout.key.len().toString() + ":" + outerLayout.key + variantIndex.toString();
    } else if resultType.kind == kindOption || resultType.kind == kindResult {
        if variantIndex < 0 || variantIndex > 1 { return failExpression(lowerer, expression, "Option/Result constructor has an invalid checked variant index"); }
        var payloadType: Type? = null;
        if resultType.kind == kindOption {
            if variantIndex == 0 { payloadType = resultType.inner; }
        } else {
            if variantIndex == 0 { payloadType = resultType.inner; } else { payloadType = resultType.key; }
        }
        if payloadType != null { var resolvedPayloadType = requiredType(payloadType, managedUnknownType()); payloadTypes.push(resolvedPayloadType); }
        payloadKey = outerLayout.key + ":payload:" + variantIndex.toString();
        if resultType.kind == kindOption && symbol.sourceName == litOptionNone && variantIndex != 1 { return failExpression(lowerer, expression, "Option::None metadata has the wrong variant index"); }
        if resultType.kind == kindOption && symbol.sourceName == litOptionSome && variantIndex != 0 { return failExpression(lowerer, expression, "Option::Some metadata has the wrong variant index"); }
        if resultType.kind == kindResult && symbol.sourceName == litResultOk && variantIndex != 0 { return failExpression(lowerer, expression, "Result::Ok metadata has the wrong variant index"); }
        if resultType.kind == kindResult && symbol.sourceName == litResultErr && variantIndex != 1 { return failExpression(lowerer, expression, "Result::Err metadata has the wrong variant index"); }
    } else {
        return failExpression(lowerer, expression, "resolved variant constructor is not a checked tagged aggregate");
    }
    if args.len() != payloadTypes.len() { return failExpression(lowerer, expression, "variant constructor argument count differs from its checked payload shape"); }
    var payloadValues: Vec<LowerValue> = [];
    var payloadIndex = 0;
    loop {
        if payloadIndex >= args.len() { break; }
        var payload = lowerExprExpected(lowerer, args[payloadIndex], payloadTypes[payloadIndex]);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        payloadValues.push(payload);
        payloadIndex = payloadIndex + 1;
    }
    var payloadLayoutId = 0;
    var payloadLayout: ManagedLayout? = null;
    if payloadValues.len() > 0 {
        payloadLayoutId = findLayoutIdByKey(lowerer.managedLayouts, payloadKey);
        payloadLayout = findManagedLayout(lowerer.managedLayouts, payloadLayoutId);
        if payloadLayout == null { return failExpression(lowerer, expression, "variant payload has no exact checked descriptor"); }
        var resolvedPayloadLayout = requiredManagedLayout(payloadLayout, lowerer.managedLayouts[0]);
        if resolvedPayloadLayout.fields.len() != payloadValues.len() { return failExpression(lowerer, expression, "variant payload descriptor has the wrong field count"); }
    }
    var source = spanRef(lowerer.sourcePath, exprSpan(expression));
    var payloadObject = LowerValue { id: -1, ty: irVoid() };
    if payloadValues.len() > 0 {
        var payloadLayoutValue = managedI64Constant(lowerer, payloadLayoutId, source);
        var payloadObjectValue = allocateValue(lowerer, ir.irRawAddress());
        payloadObject = LowerValue { id: payloadObjectValue.id, ty: payloadObjectValue.ty };
        appendInstruction(lowerer, call(payloadObject.id, payloadObject.ty, lowerer.allocateFunctionId, [payloadLayoutValue.id], source));
        var resolvedPayloadLayout2 = requiredManagedLayout(payloadLayout, lowerer.managedLayouts[0]);
        payloadIndex = 0;
        loop {
            if payloadIndex >= payloadValues.len() { break; }
            var payloadField = resolvedPayloadLayout2.fields[payloadIndex];
            if !emitManagedFieldStore(lowerer, irValue(payloadObject.id, payloadObject.ty), payloadField, payloadValues[payloadIndex], exprSpan(args[payloadIndex])) { return LowerValue { id: -1, ty: irVoid() }; }
            payloadIndex = payloadIndex + 1;
        }
    }
    var outerLayoutValue = managedI64Constant(lowerer, outerLayoutId, source);
    var object = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, call(object.id, object.ty, lowerer.allocateFunctionId, [outerLayoutValue.id], source));
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    var tagValue = managedI64Constant(lowerer, variantIndex, source);
    var tagField = outerLayout.fields[0];
    if !emitManagedFieldStore(lowerer, object, tagField, LowerValue { id: tagValue.id, ty: tagValue.ty }, exprSpan(expression)) { return LowerValue { id: -1, ty: irVoid() }; }
    var payloadFieldOuter = outerLayout.fields[1];
    if payloadValues.len() == 0 {
        var nullValue = allocateValue(lowerer, ir.irRawAddress());
        appendInstruction(lowerer, ir.rawNull(nullValue.id, source));
        if !emitManagedFieldStore(lowerer, object, payloadFieldOuter, LowerValue { id: nullValue.id, ty: nullValue.ty }, exprSpan(expression)) { return LowerValue { id: -1, ty: irVoid() }; }
    } else {
        if !emitManagedFieldStore(lowerer, object, payloadFieldOuter, payloadObject, exprSpan(expression)) { return LowerValue { id: -1, ty: irVoid() }; }
    }
    return LowerValue { id: object.id, ty: object.ty };
}

func stmtVariant(stmt: Stmt): string {
    match stmt {
        Stmt::VarDecl(_) => { return "VarDecl"; },
        Stmt::ConstDecl(_) => { return "ConstDecl"; },
        Stmt::FuncDecl(_) => { return "FuncDecl"; },
        Stmt::StructDecl(_) => { return "StructDecl"; },
        Stmt::EnumDecl(_) => { return "EnumDecl"; },
        Stmt::Import(_) => { return "Import"; },
        Stmt::If(_) => { return "If"; },
        Stmt::Assign(_) => { return "Assign"; },
        Stmt::Return(_) => { return "Return"; },
        Stmt::Break(_) => { return "Break"; },
        Stmt::Continue(_) => { return "Continue"; },
        Stmt::While(_) => { return "While"; },
        Stmt::For(_) => { return "For"; },
        Stmt::Loop(_) => { return "Loop"; },
        Stmt::Block(_) => { return "Block"; },
        Stmt::ExprStmt(_) => { return "ExprStmt"; },
        Stmt::Match(_) => { return "Match"; },
    }
    return "Unknown";
}

func bindingForDeclaration(checked: CheckedProgram, bindingIndex: HashMap<string, Vec<int>>, sourcePath: string, moduleId: string, statement: Stmt, name: string): CheckedBindingInfo? {
    var span = stmtSpan(statement);
    var declarationKey = stmtVariant(statement) + ":" + span.start.toString() + ":" + span.end.toString();
    var key = bindingLookupKey(sourcePath, moduleId, declarationKey, name);
    if !bindingIndex.has(key) { return null; }
    var indices: Vec<int> = bindingIndex.get(key);
    var candidate = 0;
    loop {
        if candidate >= indices.len() { break; }
        var binding = checked.bindings[indices[candidate]];
        if binding.sourcePath == sourcePath && binding.moduleId == moduleId && binding.declarationKey == declarationKey && binding.name == name { return binding; }
        candidate += 1;
    }
    return null;
}

func pushScope(lowerer: FunctionLowerer) {
    lowerer.scopes.push(LocalScope { bindings: [] });
}

func popScope(lowerer: FunctionLowerer) {
    lowerer.scopes.pop();
}

func findLocalLocation(scopes: Vec<LocalScope>, name: string): LocalLocation {
    var scopeIndex = scopes.len() - 1;
    loop {
        if scopeIndex < 0 { break; }
        var scope = scopes[scopeIndex];
        var bindingIndex = scope.bindings.len() - 1;
        loop {
            if bindingIndex < 0 { break; }
            var binding = scope.bindings[bindingIndex];
            if binding.name == name { return LocalLocation { found: true, scopeIndex: scopeIndex, bindingIndex: bindingIndex, binding: binding }; }
            bindingIndex = bindingIndex - 1;
        }
        scopeIndex = scopeIndex - 1;
    }
    return LocalLocation { found: false, scopeIndex: -1, bindingIndex: -1, binding: LocalBinding { name: emptyString, identity: emptyString, isConst: false, layoutId: 0, value: irValue(-1, irVoid()) } };
}

func findLocal(lowerer: FunctionLowerer, name: string): IRValue? {
    var location = findLocalLocation(lowerer.scopes, name);
    if location.found { return location.binding.value; }
    return null;
}

func updateLocal(lowerer: FunctionLowerer, location: LocalLocation, value: IRValue) {
    var scope = lowerer.scopes[location.scopeIndex];
    var binding = scope.bindings[location.bindingIndex];
    scope.bindings.set(location.bindingIndex, LocalBinding {
        name: binding.name,
        identity: binding.identity,
        isConst: binding.isConst,
        layoutId: binding.layoutId,
        value: value,
    });
    lowerer.scopes.set(location.scopeIndex, scope);
}

func bindLocal(lowerer: FunctionLowerer, name: string, identity: string, isConst: bool, layoutId: int, value: IRValue) {
    if lowerer.scopes.len() == 0 {
        lowerer.error = lowerError(lowerer.sourcePath, 0, "internal lowering error: no lexical scope");
        return;
    }
    var scopeIndex = lowerer.scopes.len() - 1;
    var scope = lowerer.scopes[scopeIndex];
    scope.bindings.push(LocalBinding { name: name, identity: identity, isConst: isConst, layoutId: layoutId, value: value });
    lowerer.scopes.set(scopeIndex, scope);
}

func allocateValue(lowerer: FunctionLowerer, ty: IRType): IRValue {
    var result = irValue(lowerer.nextValueId, ty);
    lowerer.nextValueId = lowerer.nextValueId + 1;
    return result;
}

func cloneScopes(scopes: Vec<LocalScope>): Vec<LocalScope> {
    var copied: Vec<LocalScope> = [];
    var scopeIndex = 0;
    loop {
        if scopeIndex >= scopes.len() { break; }
        var sourceScope = scopes[scopeIndex];
        var copiedBindings: Vec<LocalBinding> = [];
        var bindingIndex = 0;
        loop {
            if bindingIndex >= sourceScope.bindings.len() { break; }
            var sourceBinding = sourceScope.bindings[bindingIndex];
            copiedBindings.push(LocalBinding {
                name: sourceBinding.name,
                identity: sourceBinding.identity,
                isConst: sourceBinding.isConst,
                layoutId: sourceBinding.layoutId,
                value: sourceBinding.value,
            });
            bindingIndex = bindingIndex + 1;
        }
        copied.push(LocalScope { bindings: copiedBindings });
        scopeIndex = scopeIndex + 1;
    }
    return copied;
}

func findBindingIdentity(scopes: Vec<LocalScope>, identity: string): LocalLocation {
    var scopeIndex = scopes.len() - 1;
    loop {
        if scopeIndex < 0 { break; }
        var scope = scopes[scopeIndex];
        var bindingIndex = scope.bindings.len() - 1;
        loop {
            if bindingIndex < 0 { break; }
            var binding = scope.bindings[bindingIndex];
            if binding.identity == identity {
                return LocalLocation { found: true, scopeIndex: scopeIndex, bindingIndex: bindingIndex, binding: binding };
            }
            bindingIndex = bindingIndex - 1;
        }
        scopeIndex = scopeIndex - 1;
    }
    return LocalLocation { found: false, scopeIndex: -1, bindingIndex: -1, binding: LocalBinding { name: emptyString, identity: emptyString, isConst: false, layoutId: 0, value: irValue(-1, irVoid()) } };
}

func makeBlockEnvironment(lowerer: FunctionLowerer, sourceScopes: Vec<LocalScope>): BlockEnvironment {
    var targetScopes = cloneScopes(sourceScopes);
    var params: Vec<IRValue> = [];
    var args: Vec<int> = [];
    var keys: Vec<string> = [];
    var scopeIndex = 0;
    loop {
        if scopeIndex >= sourceScopes.len() { break; }
        var sourceScope = sourceScopes[scopeIndex];
        var targetScope = targetScopes[scopeIndex];
        var bindingIndex = 0;
        loop {
            if bindingIndex >= sourceScope.bindings.len() { break; }
            var sourceBinding = sourceScope.bindings[bindingIndex];
            args.push(sourceBinding.value.id);
            keys.push(sourceBinding.identity);
            var parameter = allocateValue(lowerer, sourceBinding.value.ty);
            params.push(parameter);
            var targetBinding = targetScope.bindings[bindingIndex];
            targetScope.bindings.set(bindingIndex, LocalBinding {
                name: targetBinding.name,
                identity: targetBinding.identity,
                isConst: targetBinding.isConst,
                layoutId: targetBinding.layoutId,
                value: parameter,
            });
            bindingIndex = bindingIndex + 1;
        }
        targetScopes.set(scopeIndex, targetScope);
        scopeIndex = scopeIndex + 1;
    }
    return BlockEnvironment { scopes: targetScopes, params: params, args: args, bindingKeys: keys };
}

func blockArgsForKeys(lowerer: FunctionLowerer, scopes: Vec<LocalScope>, keys: Vec<string>, offset: int): Vec<int> {
    var args: Vec<int> = [];
    var i = 0;
    loop {
        if i >= keys.len() { break; }
        var location = findBindingIdentity(scopes, keys[i]);
        if !location.found {
            lowerer.error = lowerError(lowerer.sourcePath, offset, "internal lowering error: block edge lost a live lexical binding");
            return args;
        }
        args.push(location.binding.value.id);
        i = i + 1;
    }
    return args;
}

func lowerTypeOfExpr(lowerer: FunctionLowerer, expression: Expr): IRType? {
    var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
    if maybeInfo != null {
        var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
        if lowerer.managed {
            // Null carries no storage type of its own. Its legality is established by
            // type checking at the surrounding nullable-reference operation; lowering
            // it as the canonical raw null keeps that contextual fact intact.
            if info.ty.kind == kindNull { return ir.irRawAddress(); }
            var effectiveType = managedExpressionType(lowerer, info.ty);
            if !managedTypeIsSupported(lowerer.checked, lowerer.managedLayouts, effectiveType, true) {
                lowerer.error = lowerError(lowerer.sourcePath, exprSpan(expression).start, "expression type " + info.ty.kind + " is outside the managed aggregate slice or lacks a concrete contextual type");
                return null;
            }
            return managedIRType(lowerer.managedLayouts, effectiveType);
        }
        if !checkedTypeIsSupported(info.ty) {
            lowerer.error = lowerError(lowerer.sourcePath, exprSpan(expression).start, "expression type " + info.ty.kind + " is outside the scalar IR slice");
            return null;
        }
        return toIRType(info.ty);
    }
    if lowerer.managed {
        var contextualAggregateLiteral = false;
        match expression {
            Expr::Literal(literal) => {
                if literal.kind == LiteralKind::Int || literal.kind == LiteralKind::Bool || literal.kind == LiteralKind::Char || literal.kind == LiteralKind::Null {
                    var literalType = Type { kind: kindInt, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
                    if literal.kind == LiteralKind::Bool { literalType = Type { kind: kindBool, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null }; }
                    if literal.kind == LiteralKind::Char { literalType = Type { kind: kindChar, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null }; }
                    if literal.kind == LiteralKind::Null { literalType = Type { kind: kindNull, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null }; }
                    if literalType.kind == kindNull {
                        var maybeExpected = lowerer.expectedType;
                        if maybeExpected != null {
                            var expectedType = requiredType(maybeExpected, managedUnknownType());
                            if managedTypeIsSupported(lowerer.checked, lowerer.managedLayouts, expectedType, true) && managedIRType(lowerer.managedLayouts, expectedType).kind == IRTypeKind::RawAddress { return ir.irRawAddress(); }
                        }
                        return ir.irRawAddress();
                    }
                    return toIRType(literalType);
                }
                if literal.kind == LiteralKind::String {
                    var maybeExpectedString = lowerer.expectedType;
                    if maybeExpectedString != null {
                        var expectedStringType = requiredType(maybeExpectedString, managedUnknownType());
                        if managedTypeIsString(expectedStringType) { return ir.irRawAddress(); }
                    }
                }
            },
            Expr::Tuple(_) => { contextualAggregateLiteral = true; },
            Expr::Array(_) => { contextualAggregateLiteral = true; },
            Expr::Dict(_) => { contextualAggregateLiteral = true; },
            _ => {},
        }
        if contextualAggregateLiteral {
            var maybeExpected = lowerer.expectedType;
            if maybeExpected == null {
                lowerer.error = lowerError(lowerer.sourcePath, exprSpan(expression).start, "aggregate literal has no exact checked contextual type");
                return null;
            }
            var expectedType = requiredType(maybeExpected, managedUnknownType());
            if !managedTypeIsSupported(lowerer.checked, lowerer.managedLayouts, expectedType, true) {
                lowerer.error = lowerError(lowerer.sourcePath, exprSpan(expression).start, "aggregate literal contextual type is unsupported or incomplete");
                return null;
            }
            return managedIRType(lowerer.managedLayouts, expectedType);
        }
    }
    lowerer.error = lowerError(lowerer.sourcePath, exprSpan(expression).start, "checked expression metadata is missing");
    return null;
}

func digitValue(digit: string): int {
    if digit >= litN0 && digit <= litN9 { return digit.toInt(); }
    if digit == litA || digit == litA2 { return 10; }
    if digit == litB || digit == litB2 { return 11; }
    if digit == litC || digit == litC2 { return 12; }
    if digit == litD || digit == litD2 { return 13; }
    if digit == litE || digit == litE2 { return 14; }
    if digit == litF || digit == litF2 { return 15; }
    return -1;
}

func parseIntegerLiteral(text: string, negative: bool): Result<int, string> {
    var body = text;
    var base = 10;
    if body.len() > 2 && body.slice(0, 1) == litN0 && (body.slice(1, 2) == litX || body.slice(1, 2) == litX2) {
        base = 16;
        body = body.slice(2, body.len());
    } else if body.len() > 2 && body.slice(0, 1) == litN0 && (body.slice(1, 2) == litB || body.slice(1, 2) == litB2) {
        base = 2;
        body = body.slice(2, body.len());
    }
    var value = 0;
    var sawDigit = false;
    var previousWasDigit = false;
    var i = 0;
    loop {
        if i >= body.len() { break; }
        var digit = body.slice(i, i + 1);
        if digit == litEmpty {
            if !previousWasDigit || i + 1 >= body.len() { return Result.Err("misplaced underscore in integer literal"); }
            previousWasDigit = false;
        } else {
            var parsedDigit = digitValue(digit);
            if parsedDigit < 0 || parsedDigit >= base { return Result.Err("invalid digit in integer literal"); }
            sawDigit = true;
            previousWasDigit = true;
            if negative {
                var minI64 = -9223372036854775807 - 1;
                if value < (minI64 + parsedDigit) / base { return Result.Err("integer literal exceeds signed i64 range"); }
                value = value * base - parsedDigit;
            } else {
                var maxI64 = 9223372036854775807;
                if value > (maxI64 - parsedDigit) / base { return Result.Err("integer literal exceeds signed i64 range"); }
                value = value * base + parsedDigit;
            }
        }
        i = i + 1;
    }
    if !sawDigit { return Result.Err("integer literal has no digits"); }
    if !previousWasDigit { return Result.Err("misplaced underscore in integer literal"); }
    return Result.Ok(value);
}

func checkedArithmeticInstruction(op: string, resultId: int, leftId: int, rightId: int, source: SourceRef): Instruction {
    if op == opAdd { return addCheckedI64(resultId, leftId, rightId, source); }
    if op == opSub { return subCheckedI64(resultId, leftId, rightId, source); }
    if op == opMul { return mulCheckedI64(resultId, leftId, rightId, source); }
    if op == opDiv { return divCheckedI64(resultId, leftId, rightId, source); }
    return remCheckedI64(resultId, leftId, rightId, source);
}

func appendInstruction(lowerer: FunctionLowerer, instruction: Instruction) {
    if lowerer.error != emptyString { return; }
    lowerer.currentInstructions.push(instruction);
}

func failExpression(lowerer: FunctionLowerer, expression: Expr, message: string): LowerValue {
    lowerer.error = lowerError(lowerer.sourcePath, exprSpan(expression).start, message);
    return LowerValue { id: -1, ty: irVoid() };
}

func plainType(kind: string): Type {
    return Type { kind: kind, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
}

func hiddenName(role: string, span: Span): string {
    return "$" + role + ":" + span.start.toString();
}

func findGlobalSlot(lowerer: FunctionLowerer, name: string): int {
    var index = 0;
    loop {
        if index >= lowerer.globalSlots.len() { break; }
        var slot = lowerer.globalSlots[index];
        if slot.moduleId == lowerer.moduleId && slot.name == name { return index; }
        index = index + 1;
    }
    return -1;
}

func globalIsReference(slot: GlobalSlot): bool {
    return slot.ty.kind != kindInt && slot.ty.kind != kindBool && slot.ty.kind != kindChar;
}

func emitGlobalLoad(lowerer: FunctionLowerer, slot: GlobalSlot, source: SourceRef): LowerValue {
    if lowerer.globalGetFunctionId < 0 {
        lowerer.error = lowerError(lowerer.sourcePath, source.start, "internal lowering error: global slot helper is missing");
        return LowerValue { id: -1, ty: irVoid() };
    }
    var indexValue = managedI64Constant(lowerer, slot.slot, source);
    var loaded = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, call(loaded.id, irI64(), lowerer.globalGetFunctionId, [indexValue.id], source));
    var bits = LowerValue { id: loaded.id, ty: loaded.ty };
    if slot.ty.kind == kindBool { return lowerManagedI64AsBool(lowerer, bits, source); }
    if globalIsReference(slot) {
        var address = allocateValue(lowerer, ir.irRawAddress());
        appendInstruction(lowerer, ir.rawFromInt(address.id, loaded.id, source));
        return LowerValue { id: address.id, ty: address.ty };
    }
    return bits;
}

func emitGlobalStore(lowerer: FunctionLowerer, slot: GlobalSlot, value: LowerValue, source: SourceRef): bool {
    if lowerer.globalSetFunctionId < 0 {
        lowerer.error = lowerError(lowerer.sourcePath, source.start, "internal lowering error: global slot helper is missing");
        return false;
    }
    var stored = value;
    if slot.ty.kind == kindBool {
        if value.ty.kind != IRTypeKind::Bool {
            lowerer.error = lowerError(lowerer.sourcePath, source.start, "global bool value does not match its checked type");
            return false;
        }
        var encoded = lowerBoolAsI64(lowerer, value.id, source);
        stored = LowerValue { id: encoded.id, ty: encoded.ty };
    } else if globalIsReference(slot) {
        if value.ty.kind != IRTypeKind::RawAddress {
            lowerer.error = lowerError(lowerer.sourcePath, source.start, "global reference value does not match its checked type");
            return false;
        }
        var bits = allocateValue(lowerer, irI64());
        appendInstruction(lowerer, ir.rawToInt(bits.id, value.id, source));
        stored = LowerValue { id: bits.id, ty: bits.ty };
    } else if value.ty.kind != IRTypeKind::I64 {
        lowerer.error = lowerError(lowerer.sourcePath, source.start, "global scalar value does not match its checked type");
        return false;
    }
    var indexValue = managedI64Constant(lowerer, slot.slot, source);
    appendInstruction(lowerer, call(-1, irVoid(), lowerer.globalSetFunctionId, [indexValue.id, stored.id], source));
    return lowerer.error == emptyString;
}

func lowerGlobalInitializers(lowerer: FunctionLowerer) {
    var index = 0;
    loop {
        if index >= lowerer.globalSlots.len() || lowerer.error != emptyString { break; }
        var slot = lowerer.globalSlots[index];
        var savedPath = lowerer.sourcePath;
        var savedModule = lowerer.moduleId;
        lowerer.sourcePath = slot.sourcePath;
        lowerer.moduleId = slot.moduleId;
        var value = lowerExprExpected(lowerer, slot.initializer, slot.ty);
        lowerer.sourcePath = savedPath;
        lowerer.moduleId = savedModule;
        if lowerer.error != emptyString { return; }
        emitGlobalStore(lowerer, slot, value, spanRef(slot.sourcePath, slot.span));
        index = index + 1;
    }
}

func rangeCallBounds(lowerer: FunctionLowerer, expression: Expr): RangeCall {
    var missing = RangeCall { found: false, start: expression, end: expression };
    match expression {
        Expr::Call(callExpr) => {
            if callExpr.args.len() != 2 { return missing; }
            var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
            if maybeInfo == null { return missing; }
            var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
            if info.symbol == null { return missing; }
            var symbol = requiredResolvedSymbol(info.symbol, lowerer.checked.symbols[0]);
            if symbol.intrinsicId != litRange { return missing; }
            return RangeCall { found: true, start: callExpr.args[0], end: callExpr.args[1] };
        },
        _ => { return missing; },
    }
    return missing;
}

func lowerVariadicPack(lowerer: FunctionLowerer, vectorType: Type, args: Vec<Expr>, start: int, span: Span): LowerValue {
    if !lowerer.managed {
        lowerer.error = lowerError(lowerer.sourcePath, span.start, "variadic arguments require managed IR lowering");
        return LowerValue { id: -1, ty: irVoid() };
    }
    var elementType = managedArrayElementType(vectorType);
    if elementType.kind == kindUnknown || elementType.kind == kindAny || elementType.kind == kindFloat {
        lowerer.error = lowerError(lowerer.sourcePath, span.start, "variadic parameter requires a concrete supported element type");
        return LowerValue { id: -1, ty: irVoid() };
    }
    var vectorLayout = managedLayoutId(lowerer.managedLayouts, vectorType);
    var backingLayout = managedArrayBackingLayoutId(lowerer, elementType);
    if vectorLayout <= 0 || backingLayout <= 0 {
        lowerer.error = lowerError(lowerer.sourcePath, span.start, "variadic parameter has no exact Vec layout");
        return LowerValue { id: -1, ty: irVoid() };
    }
    var source = spanRef(lowerer.sourcePath, span);
    var count = args.len() - start;
    if count < 0 { count = 0; }
    var headerValue = managedI64Constant(lowerer, vectorLayout, source);
    var capacityValue = managedI64Constant(lowerer, count, source);
    var vector = managedCallHook(lowerer, "managedVecCreate", ir.irRawAddress(), [headerValue.id, managedI64Constant(lowerer, backingLayout, source).id, capacityValue.id], source);
    var packName = hiddenName("pack", span);
    pushScope(lowerer);
    bindLocal(lowerer, packName, packName, true, vectorLayout, irValue(vector.id, vector.ty));
    var argumentIndex = start;
    loop {
        if argumentIndex >= args.len() || lowerer.error != emptyString { break; }
        var value = lowerExprExpected(lowerer, args[argumentIndex], elementType);
        if lowerer.error != emptyString { popScope(lowerer); return LowerValue { id: -1, ty: irVoid() }; }
        var packed = findLocal(lowerer, packName);
        if packed == null {
            popScope(lowerer);
            lowerer.error = lowerError(lowerer.sourcePath, span.start, "internal lowering error: variadic vector was lost across a block edge");
            return LowerValue { id: -1, ty: irVoid() };
        }
        if packed != null {
            var packedValue: IRValue = packed;
            var elementSource = spanRef(lowerer.sourcePath, exprSpan(args[argumentIndex]));
            var backingNow = managedI64Constant(lowerer, backingLayout, elementSource);
            if managedLayoutId(lowerer.managedLayouts, elementType) > 0 {
                if value.ty.kind != IRTypeKind::RawAddress {
                    popScope(lowerer);
                    lowerer.error = lowerError(lowerer.sourcePath, elementSource.start, "variadic reference element is not a canonical managed reference");
                    return LowerValue { id: -1, ty: irVoid() };
                }
                managedCallHook(lowerer, "managedVecPushReference", irVoid(), [packedValue.id, backingNow.id, value.id], elementSource);
            } else {
                var storedValue = value;
                if value.ty.kind == IRTypeKind::Bool {
                    var encoded = lowerBoolAsI64(lowerer, value.id, elementSource);
                    storedValue = LowerValue { id: encoded.id, ty: encoded.ty };
                }
                if storedValue.ty.kind != IRTypeKind::I64 {
                    popScope(lowerer);
                    lowerer.error = lowerError(lowerer.sourcePath, elementSource.start, "variadic scalar element requires i64, bool, or char");
                    return LowerValue { id: -1, ty: irVoid() };
                }
                managedCallHook(lowerer, "managedVecPushI64", irVoid(), [packedValue.id, backingNow.id, storedValue.id], elementSource);
            }
        }
        argumentIndex = argumentIndex + 1;
    }
    var finished = findLocal(lowerer, packName);
    popScope(lowerer);
    if finished == null || lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    if finished != null {
        var finishedValue: IRValue = finished;
        return LowerValue { id: finishedValue.id, ty: finishedValue.ty };
    }
    return LowerValue { id: -1, ty: irVoid() };
}

func packedWriterIdentifier(expression: Expr, name: string): bool {
    match expression {
        Expr::Identifier(identifier) => { return identifier.name == name; },
        _ => { return false; },
    }
}

func packedWriterBoolLiteral(expression: Expr, value: string): bool {
    match expression {
        Expr::Literal(literal) => { return literal.kind == LiteralKind::Bool && literal.text == value; },
        _ => { return false; },
    }
}

func packedWriterMethodCall(expression: Expr, receiver: string, method: string): bool {
    match expression {
        Expr::Call(callExpr) => {
            if callExpr.args.len() != 0 { return false; }
            match callExpr.callee {
                Expr::FieldAccess(access) => { return access.name == method && packedWriterIdentifier(access.object, receiver); },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
}

func packedWriterByteStringCall(expression: Expr): bool {
    match expression {
        Expr::Call(callExpr) => {
            if callExpr.args.len() != 1 || !packedWriterIdentifier(callExpr.args[0], "bytes") { return false; }
            return packedWriterIdentifier(callExpr.callee, "byteString");
        },
        _ => { return false; },
    }
}

func packedWriterWriteCall(expression: Expr): bool {
    match expression {
        Expr::Call(callExpr) => {
            if callExpr.args.len() != 2 || !packedWriterIdentifier(callExpr.args[0], "path") || !packedWriterMethodCall(callExpr.args[1], "encoded", "unwrap") { return false; }
            return packedWriterIdentifier(callExpr.callee, "writeFile");
        },
        _ => { return false; },
    }
}

func packedWriterFallbackShape(plan: FunctionPlan): bool {
    var declaration = plan.declaration;
    var signature = plan.symbol.signature;
    if plan.sourceName != "__reyPackedWriteBytesFallback" || declaration.name != plan.sourceName || declaration.isPub || !plan.sourcePath.endsWith("/native/output/main.rey") || declaration.params.len() != 2 || declaration.body.len() != 4 { return false; }
    if plan.symbol.kind != kindFunction || plan.symbol.sourceName != declaration.name || plan.symbol.sourcePath != plan.sourcePath || plan.symbol.moduleId != plan.moduleId || plan.symbol.intrinsicId != emptyString { return false; }
    if declaration.params[0].name != "path" || declaration.params[0].hasDefault || declaration.params[0].variadic || declaration.params[1].name != "bytes" || declaration.params[1].hasDefault || declaration.params[1].variadic { return false; }
    if signature.kind != kindFunction || signature.params.len() != 2 || signature.ret == null { return false; }
    var pathType = signature.params[0];
    var bytesType = signature.params[1];
    var maybeElementType = bytesType.inner;
    var resultType = requiredType(signature.ret, managedUnknownType());
    if maybeElementType == null || pathType.kind != kindString || bytesType.kind != kindArray || resultType.kind != kindBool || plan.returnType.kind != IRTypeKind::Bool { return false; }
    var elementType = requiredType(maybeElementType, managedUnknownType());
    if elementType.kind != kindInt { return false; }

    match declaration.body[0] {
        Stmt::VarDecl(variable) => { if variable.name != "encoded" || !packedWriterByteStringCall(variable.value) { return false; } },
        _ => { return false; },
    }
    match declaration.body[1] {
        Stmt::If(statement) => {
            if !packedWriterMethodCall(statement.condition, "encoded", "isErr") || statement.elseBranch != null || statement.thenBranch.statements.len() != 1 { return false; }
            match statement.thenBranch.statements[0] {
                Stmt::Return(returnStatement) => { if !packedWriterBoolLiteral(returnStatement.value, "false") { return false; } },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    match declaration.body[2] {
        Stmt::ExprStmt(statement) => { if !packedWriterWriteCall(statement.expr) { return false; } },
        _ => { return false; },
    }
    match declaration.body[3] {
        Stmt::Return(statement) => { return packedWriterBoolLiteral(statement.value, "true"); },
        _ => { return false; },
    }
}

func packedWriterDependenciesTrusted(lowerer: FunctionLowerer, plan: FunctionPlan): bool {
    var byteCall: Expr = Expr::Identifier(IdentExpr { name: emptyString, span: plan.declaration.span });
    match plan.declaration.body[0] {
        Stmt::VarDecl(variable) => { byteCall = variable.value; },
        _ => { return false; },
    }
    var maybeByteInfo = findExprInfo(lowerer.checked, plan.sourcePath, plan.moduleId, byteCall);
    if maybeByteInfo == null { return false; }
    var byteInfo = requiredCheckedExprInfo(maybeByteInfo, lowerer.checked.expressions[0]);
    if byteInfo.symbol == null { return false; }
    var byteSymbol = requiredResolvedSymbol(byteInfo.symbol, lowerer.checked.symbols[0]);
    if byteSymbol.kind != kindFunction || byteSymbol.sourceName != "byteString" || !byteSymbol.sourcePath.endsWith("/native/bytes/main.rey") { return false; }
    if byteSymbol.signature.kind != kindFunction || byteSymbol.signature.params.len() != 1 || byteSymbol.signature.ret == null { return false; }
    var byteInput = byteSymbol.signature.params[0];
    var maybeElementType = byteInput.inner;
    var byteResult = requiredType(byteSymbol.signature.ret, managedUnknownType());
    if maybeElementType == null || byteInput.kind != kindArray || byteResult.kind != kindResult { return false; }
    var byteElementType = requiredType(maybeElementType, managedUnknownType());
    if byteElementType.kind != kindInt { return false; }
    var byteResultValue = byteResult.inner;
    var byteResultError = byteResult.key;
    if byteResultValue == null || byteResultError == null { return false; }
    var byteValueType = requiredType(byteResultValue, managedUnknownType());
    var byteErrorType = requiredType(byteResultError, managedUnknownType());
    if byteValueType.kind != kindString || byteErrorType.kind != kindString { return false; }

    var writeStmt = plan.declaration.body[2];
    var writeCall: Expr = Expr::Identifier(IdentExpr { name: emptyString, span: plan.declaration.span });
    match writeStmt {
        Stmt::ExprStmt(statement) => { writeCall = statement.expr; },
        _ => { return false; },
    }
    var maybeWriteInfo = findExprInfo(lowerer.checked, plan.sourcePath, plan.moduleId, writeCall);
    if maybeWriteInfo == null { return false; }
    var writeInfo = requiredCheckedExprInfo(maybeWriteInfo, lowerer.checked.expressions[0]);
    if writeInfo.symbol == null { return false; }
    var writeSymbol = requiredResolvedSymbol(writeInfo.symbol, lowerer.checked.symbols[0]);
    return writeSymbol.kind == "Builtin" && writeSymbol.sourceName == "writeFile" && writeSymbol.intrinsicId == "writeFile";
}

func lowerPackedWriterFallback(lowerer: FunctionLowerer, expression: Expr, callExpr: CallExpr, target: FunctionPlan): LowerValue {
    if callExpr.args.len() != 2 { return failExpression(lowerer, expression, "validated packed writer fallback requires exactly two arguments"); }
    var pathType = target.symbol.signature.params[0];
    var bytesType = target.symbol.signature.params[1];
    var path = lowerExprExpected(lowerer, callExpr.args[0], pathType);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    var bytes = lowerExprExpected(lowerer, callExpr.args[1], bytesType);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    var elementType = managedArrayElementType(bytesType);
    var dataLayoutId = managedArrayBackingLayoutId(lowerer, elementType);
    if path.ty.kind != IRTypeKind::RawAddress || bytes.ty.kind != IRTypeKind::RawAddress || elementType.kind != kindInt || dataLayoutId <= 0 { return failExpression(lowerer, expression, "packed writer arguments do not match managed string and Vec<int> layouts"); }
    var layoutValue = managedI64Constant(lowerer, dataLayoutId, spanRef(lowerer.sourcePath, exprSpan(expression)));
    return managedCallHook(lowerer, litManagedWriteBytes, irBool(), [path.id, bytes.id, layoutValue.id], spanRef(lowerer.sourcePath, exprSpan(expression)));
}

func packedSegmentsFallbackShape(plan: FunctionPlan): bool {
    var declaration = plan.declaration;
    var signature = plan.symbol.signature;
    if plan.sourceName != "__reyPackedWriteSegmentsFallback" || declaration.name != plan.sourceName || declaration.isPub || !plan.sourcePath.endsWith("/native/output/main.rey") || declaration.params.len() != 3 || declaration.body.len() != 1 { return false; }
    if plan.symbol.kind != kindFunction || plan.symbol.sourceName != declaration.name || plan.symbol.sourcePath != plan.sourcePath || plan.symbol.moduleId != plan.moduleId || plan.symbol.intrinsicId != emptyString { return false; }
    if declaration.params[0].name != "path" || declaration.params[1].name != "header" || declaration.params[2].name != "body" { return false; }
    var index = 0;
    while index < declaration.params.len() { if declaration.params[index].hasDefault || declaration.params[index].variadic { return false; } index += 1; }
    if signature.kind != kindFunction || signature.params.len() != 3 || signature.ret == null || plan.returnType.kind != IRTypeKind::Bool { return false; }
    var headerType = signature.params[1];
    var element = headerType.inner;
    var bodyType = signature.params[2];
    if signature.params[0].kind != kindString || headerType.kind != kindArray || element == null || requiredType(element, managedUnknownType()).kind != kindInt { return false; }
    if bodyType.kind != kindStruct || bodyType.name != "PackedBuffer" || !bodyType.sourcePath.endsWith("/native/packed/main.rey") || requiredType(signature.ret, managedUnknownType()).kind != kindBool { return false; }
    match declaration.body[0] {
        Stmt::Return(statement) => {
            match statement.value {
                Expr::Call(callExpr) => {
                    return callExpr.args.len() == 3 && packedWriterIdentifier(callExpr.callee, "packedBufferWriteSegments") && packedWriterIdentifier(callExpr.args[0], "path") && packedWriterIdentifier(callExpr.args[1], "header") && packedWriterIdentifier(callExpr.args[2], "body");
                },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
}

func packedSegmentsDependenciesTrusted(lowerer: FunctionLowerer, plan: FunctionPlan): bool {
    var expression: Expr = Expr::Identifier(IdentExpr { name: emptyString, span: plan.declaration.span });
    match plan.declaration.body[0] {
        Stmt::Return(statement) => { expression = statement.value; },
        _ => { return false; },
    }
    var maybeInfo = findExprInfo(lowerer.checked, plan.sourcePath, plan.moduleId, expression);
    if maybeInfo == null { return false; }
    var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
    if info.symbol == null { return false; }
    var symbol = requiredResolvedSymbol(info.symbol, lowerer.checked.symbols[0]);
    var signature = plan.symbol.signature;
    if symbol.kind != kindFunction || symbol.sourceName != "packedBufferWriteSegments" || symbol.sourcePath != signature.params[2].sourcePath || symbol.signature.kind != kindFunction || symbol.signature.params.len() != 3 || symbol.signature.ret == null { return false; }
    var i = 0;
    while i < 3 { if managedTypeKey(symbol.signature.params[i]) != managedTypeKey(signature.params[i]) { return false; } i += 1; }
    return requiredType(symbol.signature.ret, managedUnknownType()).kind == kindBool;
}

func lowerPackedSegmentsFallback(lowerer: FunctionLowerer, expression: Expr, callExpr: CallExpr, target: FunctionPlan): LowerValue {
    if callExpr.args.len() != 3 { return failExpression(lowerer, expression, "validated packed segment writer requires three arguments"); }
    var pathType = target.symbol.signature.params[0];
    var headerType = target.symbol.signature.params[1];
    var bodyType = target.symbol.signature.params[2];
    var bodyLayoutId = managedLayoutId(lowerer.managedLayouts, bodyType);
    var maybeLayout = findManagedLayout(lowerer.managedLayouts, bodyLayoutId);
    if maybeLayout == null { return failExpression(lowerer, expression, "packed buffer layout is missing"); }
    var layout = requiredManagedLayout(maybeLayout, lowerer.managedLayouts[0]);
    if layout.payloadBytes != 24 || layout.fields.len() != 3 || layout.fields[0].name != "lanes" || layout.fields[0].offset != 0 || layout.fields[0].kind != IRTypeKind::RawAddress || layout.fields[0].layoutId != managedLayoutId(lowerer.managedLayouts, headerType) || layout.fields[1].name != "length" || layout.fields[1].offset != 8 || layout.fields[1].kind != IRTypeKind::I64 || layout.fields[2].name != "magic" || layout.fields[2].offset != 16 || layout.fields[2].kind != IRTypeKind::I64 { return failExpression(lowerer, expression, "packed buffer layout does not match the trusted writer"); }
    var path = lowerExprExpected(lowerer, callExpr.args[0], pathType);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    var header = lowerExprExpected(lowerer, callExpr.args[1], headerType);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    var body = lowerExprExpected(lowerer, callExpr.args[2], bodyType);
    var elementType = managedArrayElementType(headerType);
    var dataLayoutId = managedArrayBackingLayoutId(lowerer, elementType);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    if path.ty.kind != IRTypeKind::RawAddress || header.ty.kind != IRTypeKind::RawAddress || body.ty.kind != IRTypeKind::RawAddress || elementType.kind != kindInt || bodyLayoutId <= 0 || dataLayoutId <= 0 { return failExpression(lowerer, expression, "packed segment writer arguments have invalid layouts"); }
    var source = spanRef(lowerer.sourcePath, exprSpan(expression));
    var bodyLayout = managedI64Constant(lowerer, bodyLayoutId, source);
    var dataLayout = managedI64Constant(lowerer, dataLayoutId, source);
    return managedCallHook(lowerer, litManagedWritePackedSegments, irBool(), [path.id, header.id, body.id, bodyLayout.id, dataLayout.id], source);
}

func lowerCall(lowerer: FunctionLowerer, expression: Expr, callExpr: CallExpr): LowerValue {
    var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
    if maybeInfo != null {
    var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
    var maybeSymbol = info.symbol;
    if maybeSymbol != null {
    var symbol = requiredResolvedSymbol(maybeSymbol, lowerer.checked.symbols[0]);
    if lowerer.managed && symbol.kind == litEnumVariant {
        return lowerManagedTaggedConstructor(lowerer, expression, callExpr.args, info, symbol);
    }
    if symbol.kind == litBuiltin && symbol.intrinsicId.startsWith("__reyRaw") {
        if lowerer.managed { return failExpression(lowerer, expression, "ordinary managed source lowering cannot grant raw-address authority"); }
        return lowerRawIntrinsic(lowerer, expression, callExpr, info, symbol);
    }
    if lowerer.managed && symbol.kind == litBuiltin {
        return lowerManagedBuiltinCall(lowerer, expression, callExpr, info, symbol);
    }
    if symbol.kind != kindFunction || symbol.receiverPassing != litNone || symbol.intrinsicId != emptyString {
        return failExpression(lowerer, expression, "only calls to top-level source functions are supported");
    }
    var targetIndex = findPlanForSymbol(lowerer.plans, symbol);
    if targetIndex < 0 {
        if lowerer.managed { return failExpression(lowerer, expression, "resolved call target is not a top-level managed function in this source graph"); }
        return failExpression(lowerer, expression, "resolved call target is not a top-level scalar function in this source unit");
    }
    var target = lowerer.plans[targetIndex];
    if lowerer.managed && trustedPackedOutput && target.sourceName == "__reyPackedWriteBytesFallback" && packedWriterFallbackShape(target) && packedWriterDependenciesTrusted(lowerer, target) {
        return lowerPackedWriterFallback(lowerer, expression, callExpr, target);
    }
    if lowerer.managed && trustedPackedOutput && target.sourceName == "__reyPackedWriteSegmentsFallback" && packedSegmentsFallbackShape(target) && packedSegmentsDependenciesTrusted(lowerer, target) {
        return lowerPackedSegmentsFallback(lowerer, expression, callExpr, target);
    }
    var arguments: Vec<int> = [];
    var preparedArguments: Vec<LowerValue> = [];
    var preparedArgumentIndex = 0;
    var preparedParameterIndex = 0;
    loop {
        if preparedParameterIndex >= target.declaration.params.len() { break; }
        var preparedParameter = target.declaration.params[preparedParameterIndex];
        if preparedParameter.variadic {
            var packed = lowerVariadicPack(lowerer, target.symbol.signature.params[preparedParameterIndex], callExpr.args, preparedArgumentIndex, exprSpan(expression));
            if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
            preparedArguments.push(packed);
            preparedArgumentIndex = callExpr.args.len();
        } else if preparedArgumentIndex < callExpr.args.len() {
            var prepared = lowerExprExpected(lowerer, callExpr.args[preparedArgumentIndex], target.symbol.signature.params[preparedParameterIndex]);
            if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
            preparedArguments.push(prepared);
            preparedArgumentIndex = preparedArgumentIndex + 1;
        } else { break; }
        preparedParameterIndex = preparedParameterIndex + 1;
    }
    pushScope(lowerer);
    var argumentIndex = 0;
    var parameterIndex = 0;
    loop {
        if parameterIndex >= target.declaration.params.len() { break; }
        var parameter = target.declaration.params[parameterIndex];
        var argumentExpectedType: Type = target.symbol.signature.params[parameterIndex];
        var argument = LowerValue { id: -1, ty: irVoid() };
        var argumentExpression = parameter.default;
        var checkingDefault = false;
        if parameter.variadic {
            argument = preparedArguments[parameterIndex];
            argumentIndex = callExpr.args.len();
        } else if argumentIndex < callExpr.args.len() {
            argumentExpression = callExpr.args[argumentIndex];
            argument = preparedArguments[parameterIndex];
            argumentIndex = argumentIndex + 1;
        } else if parameter.hasDefault {
            checkingDefault = true;
            var savedPath = lowerer.sourcePath;
            var savedModule = lowerer.moduleId;
            lowerer.sourcePath = target.sourcePath;
            lowerer.moduleId = target.moduleId;
            argument = lowerExprExpected(lowerer, parameter.default, argumentExpectedType);
            lowerer.sourcePath = savedPath;
            lowerer.moduleId = savedModule;
            argumentExpression = parameter.default;
        } else {
            popScope(lowerer);
            return failExpression(lowerer, expression, "call is missing an argument for '" + parameter.name + "'");
        }
        if lowerer.error != emptyString { popScope(lowerer); return LowerValue { id: -1, ty: irVoid() }; }
        if argument.id < 0 || argument.ty.kind == IRTypeKind::Void {
            popScope(lowerer);
            if parameter.variadic { return failExpression(lowerer, expression, "variadic argument list did not lower to a vector"); }
            return failExpression(lowerer, argumentExpression, "void call cannot be used as an argument");
        }
        if argument.ty.kind != target.parameterTypes[parameterIndex].kind {
            popScope(lowerer);
            if parameter.variadic { return failExpression(lowerer, expression, "variadic argument list does not match the parameter vector type"); }
            return failExpression(lowerer, argumentExpression, "checked call argument does not match the target scalar type");
        }
        if lowerer.managed && target.parameterLayouts[parameterIndex] > 0 && !parameter.variadic {
            var actualLayout = 0;
            var isNullArgument = false;
            var savedPath2 = lowerer.sourcePath;
            var savedModule2 = lowerer.moduleId;
            if checkingDefault { lowerer.sourcePath = target.sourcePath; lowerer.moduleId = target.moduleId; }
            var maybeArgumentInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, argumentExpression);
            if checkingDefault { lowerer.sourcePath = savedPath2; lowerer.moduleId = savedModule2; }
            if maybeArgumentInfo != null {
                var argumentInfo = requiredCheckedExprInfo(maybeArgumentInfo, lowerer.checked.expressions[0]);
                var effectiveArgumentType = argumentInfo.ty;
                if argumentInfo.ty.kind == kindNull { effectiveArgumentType = argumentExpectedType; }
                if argumentInfo.ty.kind == argumentExpectedType.kind && managedTypeContainsAny(argumentInfo.ty) { effectiveArgumentType = argumentExpectedType; }
                if managedTypeHasNullLeaf(argumentInfo.ty) && managedNullSpecializationCompatible(argumentInfo.ty, argumentExpectedType, lowerer.managedLayouts) { effectiveArgumentType = argumentExpectedType; }
                actualLayout = managedLayoutId(lowerer.managedLayouts, effectiveArgumentType);
                isNullArgument = argumentInfo.ty.kind == kindNull;
            }
            if actualLayout != target.parameterLayouts[parameterIndex] && !isNullArgument {
                popScope(lowerer);
                return failExpression(lowerer, argumentExpression, "checked call argument has a different nominal managed layout");
            }
        }
        bindLocal(lowerer, parameter.name, "call-argument:" + parameterIndex.toString(), true, target.parameterLayouts[parameterIndex], irValue(argument.id, argument.ty));
        parameterIndex = parameterIndex + 1;
    }
    parameterIndex = 0;
    loop {
        if parameterIndex >= target.declaration.params.len() || lowerer.error != emptyString { break; }
        var bound = findLocal(lowerer, target.declaration.params[parameterIndex].name);
        if bound == null {
            lowerer.error = lowerError(lowerer.sourcePath, exprSpan(expression).start, "internal lowering error: call argument was lost across a block edge");
            break;
        }
        if bound != null {
            var boundValue: IRValue = bound;
            arguments.push(boundValue.id);
        }
        parameterIndex = parameterIndex + 1;
    }
    popScope(lowerer);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    if argumentIndex != callExpr.args.len() {
        return failExpression(lowerer, expression, "call has more arguments than the function signature");
    }
    var resultType = toIRType(info.ty);
    if lowerer.managed { resultType = managedIRType(lowerer.managedLayouts, info.ty); }
    if resultType.kind != target.returnType.kind {
        return failExpression(lowerer, expression, "checked call result does not match its resolved function signature");
    }
    if lowerer.managed && target.returnLayout > 0 {
        var resultLayout = managedLayoutId(lowerer.managedLayouts, info.ty);
        if resultLayout != target.returnLayout {
            return failExpression(lowerer, expression, "checked call result has a different nominal managed layout");
        }
    }
    var resultId = -1;
    if resultType.kind != IRTypeKind::Void {
        var result = allocateValue(lowerer, resultType);
        resultId = result.id;
    }
    var span = exprSpan(expression);
    if lowerer.managed {
        appendInstruction(lowerer, call(-1, irVoid(), lowerer.collectFunctionId, [], spanRef(lowerer.sourcePath, span)));
    }
    appendInstruction(lowerer, call(resultId, resultType, target.id, arguments, spanRef(lowerer.sourcePath, span)));
    return LowerValue { id: resultId, ty: resultType };
    }
    return failExpression(lowerer, expression, "call has no checked resolved symbol");
    }
    return failExpression(lowerer, expression, "checked call metadata is missing");
}

func lowerRawIntrinsic(lowerer: FunctionLowerer, expression: Expr, callExpr: CallExpr, info: CheckedExprInfo, symbol: ResolvedSymbol): LowerValue {
    var id = symbol.intrinsicId;
    var parameterTypes: Vec<IRType> = [];
    var resultType = irVoid();
    if id == litReyRawNull { resultType = ir.irRawAddress(); }
    else if id == litReyRawMap { parameterTypes = [irI64()]; resultType = ir.irRawAddress(); }
    else if id == litReyRawUnmap { parameterTypes = [ir.irRawAddress(), irI64()]; }
    else if id == litReyRawOffset { parameterTypes = [ir.irRawAddress(), irI64()]; resultType = ir.irRawAddress(); }
    else if id == litReyRawLoadI64 || id == litReyRawLoadByte { parameterTypes = [ir.irRawAddress()]; resultType = irI64(); }
    else if id == litReyRawStoreI64 || id == litReyRawStoreByte { parameterTypes = [ir.irRawAddress(), irI64()]; }
    else if id == litReyRawEqual { parameterTypes = [ir.irRawAddress(), ir.irRawAddress()]; resultType = irBool(); }
    else if id == litReyRawLoadAddress { parameterTypes = [ir.irRawAddress()]; resultType = ir.irRawAddress(); }
    else if id == litReyRawStoreAddress { parameterTypes = [ir.irRawAddress(), ir.irRawAddress()]; }
    else if id == litReyRawFail { parameterTypes = [irI64()]; }
    else if id == litReyRawFromInt { parameterTypes = [irI64()]; resultType = ir.irRawAddress(); }
    else if id == litReyRawToInt { parameterTypes = [ir.irRawAddress()]; resultType = irI64(); }
    else if id == litReyRawSyscall || id == litReyRawHostSyscall { parameterTypes = [irI64(), ir.irRawAddress(), ir.irRawAddress(), ir.irRawAddress(), ir.irRawAddress(), ir.irRawAddress(), ir.irRawAddress()]; resultType = ir.irRawAddress(); }
    else if id == litReyRawArgCount { resultType = irI64(); }
    else if id == litReyRawArg { parameterTypes = [irI64()]; resultType = ir.irRawAddress(); }
    else { return failExpression(lowerer, expression, "unknown trusted raw intrinsic"); }
    if callExpr.args.len() != parameterTypes.len() || toIRType(info.ty).kind != resultType.kind {
        return failExpression(lowerer, expression, "trusted raw intrinsic signature mismatch");
    }
    var operands: Vec<int> = [];
    var index = 0;
    while index < parameterTypes.len() {
        var argument = lowerExpr(lowerer, callExpr.args[index]);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        if argument.id < 0 || argument.ty.kind != parameterTypes[index].kind {
            return failExpression(lowerer, expression, "trusted raw intrinsic operand type mismatch");
        }
        operands.push(argument.id);
        index += 1;
    }
    var resultId = -1;
    if resultType.kind != IRTypeKind::Void { resultId = allocateValue(lowerer, resultType).id; }
    var source = spanRef(lowerer.sourcePath, exprSpan(expression));
    var instruction = ir.rawNull(resultId, source);
    if id == litReyRawMap { instruction = ir.rawMap(resultId, operands[0], source); }
    else if id == litReyRawUnmap { instruction = ir.rawUnmap(operands[0], operands[1], source); }
    else if id == litReyRawOffset { instruction = ir.rawOffset(resultId, operands[0], operands[1], source); }
    else if id == litReyRawLoadI64 { instruction = ir.rawLoadI64(resultId, operands[0], source); }
    else if id == litReyRawStoreI64 { instruction = ir.rawStoreI64(operands[0], operands[1], source); }
    else if id == litReyRawLoadByte { instruction = ir.rawLoadByte(resultId, operands[0], source); }
    else if id == litReyRawStoreByte { instruction = ir.rawStoreByte(operands[0], operands[1], source); }
    else if id == litReyRawEqual { instruction = ir.rawEqual(resultId, operands[0], operands[1], source); }
    else if id == litReyRawLoadAddress { instruction = ir.rawLoadAddress(resultId, operands[0], source); }
    else if id == litReyRawStoreAddress { instruction = ir.rawStoreAddress(operands[0], operands[1], source); }
    else if id == litReyRawFail { instruction = ir.rawFail(operands[0], source); }
    else if id == litReyRawFromInt { instruction = ir.rawFromInt(resultId, operands[0], source); }
    else if id == litReyRawToInt { instruction = ir.rawToInt(resultId, operands[0], source); }
    else if id == litReyRawSyscall || id == litReyRawHostSyscall {
        var syscallArguments: Vec<int> = [];
        var syscallIndex = 1;
        while syscallIndex < operands.len() { syscallArguments.push(operands[syscallIndex]); syscallIndex += 1; }
        if id == litReyRawHostSyscall { instruction = ir.rawHostSyscall(resultId, operands[0], syscallArguments, source); }
        else { instruction = ir.rawSyscall(resultId, operands[0], syscallArguments, source); }
    }
    else if id == litReyRawArgCount { instruction = ir.rawArgCount(resultId, source); }
    else if id == litReyRawArg { instruction = ir.rawArg(resultId, operands[0], source); }
    appendInstruction(lowerer, instruction);
    return LowerValue { id: resultId, ty: resultType };
}

func lowerShortCircuit(lowerer: FunctionLowerer, binary: BinaryExpr, left: LowerValue): LowerValue {
    if left.id < 0 || left.ty.kind != IRTypeKind::Bool {
        lowerer.error = lowerError(lowerer.sourcePath, binary.span.start, "logical operator requires a bool left operand");
        return LowerValue { id: -1, ty: irVoid() };
    }
    var isAnd = binary.op == opAnd;
    var beforeScopes = cloneScopes(lowerer.scopes);
    var rhsEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var mergeEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var resultParameter = allocateValue(lowerer, irBool());
    var mergeParams: Vec<IRValue> = [];
    var parameterIndex = 0;
    loop {
        if parameterIndex >= mergeEnvironment.params.len() { break; }
        mergeParams.push(mergeEnvironment.params[parameterIndex]);
        parameterIndex = parameterIndex + 1;
    }
    mergeParams.push(resultParameter);
    var rhsId = reserveBlock(lowerer, rhsEnvironment.params);
    var mergeId = reserveBlock(lowerer, mergeParams);
    var shortCircuitValue = allocateValue(lowerer, irBool());
    var shortCircuitBool = !isAnd;
    appendInstruction(lowerer, constBool(shortCircuitValue.id, shortCircuitBool, spanRef(lowerer.sourcePath, binary.span)));
    var shortCircuitArgs: Vec<int> = [];
    var argumentIndex = 0;
    loop {
        if argumentIndex >= mergeEnvironment.args.len() { break; }
        shortCircuitArgs.push(mergeEnvironment.args[argumentIndex]);
        argumentIndex = argumentIndex + 1;
    }
    shortCircuitArgs.push(shortCircuitValue.id);
    var trueTarget = rhsId;
    var trueArgs: Vec<int> = rhsEnvironment.args;
    var falseTarget = mergeId;
    var falseArgs: Vec<int> = shortCircuitArgs;
    if !isAnd {
        trueTarget = mergeId;
        trueArgs = shortCircuitArgs;
        falseTarget = rhsId;
        falseArgs = rhsEnvironment.args;
    }
    finishBlock(lowerer, branch(left.id, trueTarget, trueArgs, falseTarget, falseArgs, spanRef(lowerer.sourcePath, binary.span)));

    lowerer.scopes = cloneScopes(rhsEnvironment.scopes);
    enterBlock(lowerer, rhsId, rhsEnvironment.params);
    var right = lowerExpr(lowerer, binary.right);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    if right.id < 0 || right.ty.kind != IRTypeKind::Bool {
        lowerer.error = lowerError(lowerer.sourcePath, exprSpan(binary.right).start, "logical operator requires a bool right operand");
        return LowerValue { id: -1, ty: irVoid() };
    }
    var rhsMergeArgs = blockArgsForKeys(lowerer, lowerer.scopes, mergeEnvironment.bindingKeys, binary.span.start);
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    rhsMergeArgs.push(right.id);
    finishBlock(lowerer, jump(mergeId, rhsMergeArgs, spanRef(lowerer.sourcePath, binary.span)));

    lowerer.scopes = cloneScopes(mergeEnvironment.scopes);
    enterBlock(lowerer, mergeId, mergeParams);
    return LowerValue { id: resultParameter.id, ty: irBool() };
}

func lowerUnary(lowerer: FunctionLowerer, expression: Expr, unary: UnaryExpr, resultType: IRType): LowerValue {
    if unary.op == opNot {
        var operand = lowerExpr(lowerer, unary.right);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        if operand.id < 0 || operand.ty.kind != IRTypeKind::Bool || resultType.kind != IRTypeKind::Bool {
            return failExpression(lowerer, expression, "logical negation requires a bool operand");
        }
        var falseValue = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, constBool(falseValue.id, false, spanRef(lowerer.sourcePath, unary.span)));
        var compared = allocateValue(lowerer, irBool());
        appendInstruction(lowerer, compareBool(compared.id, ir.compareEq(), operand.id, falseValue.id, spanRef(lowerer.sourcePath, unary.span)));
        return LowerValue { id: compared.id, ty: compared.ty };
    }
    if unary.op == opSub {
        match unary.right {
            Expr::Literal(literal) => {
                if literal.kind == LiteralKind::Int {
                    var parsed = parseIntegerLiteral(literal.text, true);
                    if parsed.isErr() { return failExpression(lowerer, expression, parsed.unwrapErr()); }
                    var value = allocateValue(lowerer, irI64());
                    appendInstruction(lowerer, constI64(value.id, parsed.unwrap(), spanRef(lowerer.sourcePath, unary.span)));
                    return LowerValue { id: value.id, ty: value.ty };
                }
            },
            _ => {},
        }
        var operand = lowerExpr(lowerer, unary.right);
        if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
        if operand.id < 0 || operand.ty.kind != IRTypeKind::I64 || resultType.kind != IRTypeKind::I64 {
            return failExpression(lowerer, expression, "unary negation requires an i64 operand");
        }
        var zero = allocateValue(lowerer, irI64());
        appendInstruction(lowerer, constI64(zero.id, 0, spanRef(lowerer.sourcePath, unary.span)));
        var negated = allocateValue(lowerer, irI64());
        appendInstruction(lowerer, subCheckedI64(negated.id, zero.id, operand.id, spanRef(lowerer.sourcePath, unary.span)));
        return LowerValue { id: negated.id, ty: negated.ty };
    }
    return failExpression(lowerer, expression, "unary operator '" + unary.op + "' is unsupported by scalar IR lowering");
}

func lowerExpr(lowerer: FunctionLowerer, expression: Expr): LowerValue {
    if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
    var maybeIRType = lowerTypeOfExpr(lowerer, expression);
    var resultType = irVoid();
    if maybeIRType != null { resultType = maybeIRType; }
    if maybeIRType == null { return LowerValue { id: -1, ty: irVoid() }; }
    match expression {
        Expr::Literal(literal) => {
            if lowerer.managed && literal.kind == LiteralKind::String { return lowerManagedStringLiteral(lowerer, expression, literal); }
            var value = allocateValue(lowerer, resultType);
            var span = exprSpan(expression);
            if literal.kind == LiteralKind::Int {
                var parsedInteger = parseIntegerLiteral(literal.text, false);
                if parsedInteger.isErr() { return failExpression(lowerer, expression, parsedInteger.unwrapErr()); }
                appendInstruction(lowerer, constI64(value.id, parsedInteger.unwrap(), spanRef(lowerer.sourcePath, span)));
                return LowerValue { id: value.id, ty: resultType };
            }
            if literal.kind == LiteralKind::Bool {
                appendInstruction(lowerer, constBool(value.id, literal.text == boolTrue, spanRef(lowerer.sourcePath, span)));
                return LowerValue { id: value.id, ty: resultType };
            }
            if lowerer.managed && literal.kind == LiteralKind::Char {
                if literal.text.len() != 1 { return failExpression(lowerer, expression, "checked char literal does not contain exactly one byte"); }
                appendInstruction(lowerer, constI64(value.id, literal.text.hash(), spanRef(lowerer.sourcePath, span)));
                return LowerValue { id: value.id, ty: resultType };
            }
            if literal.kind == LiteralKind::Null && lowerer.managed {
                appendInstruction(lowerer, ir.rawNull(value.id, spanRef(lowerer.sourcePath, span)));
                return LowerValue { id: value.id, ty: resultType };
            }
            return failExpression(lowerer, expression, "only integer and boolean literals are supported");
        },
        Expr::Identifier(identifier) => {
            var maybeLocal = findLocal(lowerer, identifier.name);
            if maybeLocal != null {
                var local: IRValue = maybeLocal;
                if local.ty.kind != resultType.kind { return failExpression(lowerer, expression, "checked identifier type differs from its local SSA binding"); }
                return LowerValue { id: local.id, ty: local.ty };
            }
            var globalIndex = findGlobalSlot(lowerer, identifier.name);
            if globalIndex >= 0 {
                var loaded = emitGlobalLoad(lowerer, lowerer.globalSlots[globalIndex], spanRef(lowerer.sourcePath, exprSpan(expression)));
                if loaded.id < 0 || loaded.ty.kind != resultType.kind { return failExpression(lowerer, expression, "global value does not match its checked type"); }
                return loaded;
            }
            return failExpression(lowerer, expression, "identifier '" + identifier.name + "' is not a local scalar binding");
        },
        Expr::Binary(binary) => {
            var left = lowerExpr(lowerer, binary.left);
            if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
            if binary.op == opAnd || binary.op == opOr { return lowerShortCircuit(lowerer, binary, left); }
            var right = lowerExpr(lowerer, binary.right);
            if lowerer.error != emptyString { return LowerValue { id: -1, ty: irVoid() }; }
            var unknownType = managedUnknownType();
            var leftType = unknownType;
            var rightType = unknownType;
            if lowerer.managed {
                var maybeLeftInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, binary.left);
                var maybeRightInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, binary.right);
                if maybeLeftInfo != null { var leftInfo: CheckedExprInfo = maybeLeftInfo; leftType = leftInfo.ty; }
                if maybeRightInfo != null { var rightInfo: CheckedExprInfo = maybeRightInfo; rightType = rightInfo.ty; }
                if binary.op == opAdd && leftType.kind == kindString && rightType.kind == kindString {
                    var layoutValue = managedI64Constant(lowerer, managedStringLayoutId(lowerer), spanRef(lowerer.sourcePath, binary.span));
                    return managedCallHook(lowerer, "managedStringConcat", ir.irRawAddress(), [layoutValue.id, left.id, right.id], spanRef(lowerer.sourcePath, binary.span));
                }
                if (binary.op == opEq || binary.op == opNe) && managedTypeIsString(leftType) && managedTypeIsString(rightType) && (leftType.kind == kindNullable || rightType.kind == kindNullable) {
                    var stringComparisonType = leftType;
                    if rightType.kind == kindNullable { stringComparisonType = rightType; }
                    return lowerManagedValueEqual(lowerer, left, right, stringComparisonType, binary.op == opNe, spanRef(lowerer.sourcePath, binary.span));
                }
                if (binary.op == opEq || binary.op == opNe) && leftType.kind == kindNullable && managedTypeIsString(leftType) && rightType.kind == kindNull {
                    return lowerManagedValueEqual(lowerer, left, right, leftType, binary.op == opNe, spanRef(lowerer.sourcePath, binary.span));
                }
                if (binary.op == opEq || binary.op == opNe) && rightType.kind == kindNullable && managedTypeIsString(rightType) && leftType.kind == kindNull {
                    return lowerManagedValueEqual(lowerer, left, right, rightType, binary.op == opNe, spanRef(lowerer.sourcePath, binary.span));
                }
                if (binary.op == opEq || binary.op == opNe || binary.op == opLt || binary.op == opLe || binary.op == opGt || binary.op == opGe) && leftType.kind == kindString && rightType.kind == kindString {
                    if binary.op == opEq || binary.op == opNe {
                        var stringEqual = managedCallHook(lowerer, "managedStringEqual", irBool(), [left.id, right.id], spanRef(lowerer.sourcePath, binary.span));
                        if binary.op == opEq { return stringEqual; }
                        var falseValue = allocateValue(lowerer, irBool());
                        appendInstruction(lowerer, constBool(falseValue.id, false, spanRef(lowerer.sourcePath, binary.span)));
                        var negated = allocateValue(lowerer, irBool());
                        appendInstruction(lowerer, compareBool(negated.id, ir.compareEq(), stringEqual.id, falseValue.id, spanRef(lowerer.sourcePath, binary.span)));
                        return LowerValue { id: negated.id, ty: negated.ty };
                    }
                    var stringOrder = managedCallHook(lowerer, "managedStringCompare", irI64(), [left.id, right.id], spanRef(lowerer.sourcePath, binary.span));
                    var zeroOrder = managedI64Constant(lowerer, 0, spanRef(lowerer.sourcePath, binary.span));
                    var predicate = ir.compareSlt();
                    if binary.op == opLe { predicate = ir.compareSle(); }
                    if binary.op == opGt { predicate = ir.compareSgt(); }
                    if binary.op == opGe { predicate = ir.compareSge(); }
                    var ordered = allocateValue(lowerer, irBool());
                    appendInstruction(lowerer, compareI64(ordered.id, predicate, stringOrder.id, zeroOrder.id, spanRef(lowerer.sourcePath, binary.span)));
                    return LowerValue { id: ordered.id, ty: ordered.ty };
                }
                var hasNullOperand = leftType.kind == kindNull || rightType.kind == kindNull || managedExprIsNullLiteral(binary.left) || managedExprIsNullLiteral(binary.right);
                if (binary.op == opEq || binary.op == opNe) && left.ty.kind == IRTypeKind::RawAddress && right.ty.kind == IRTypeKind::RawAddress && hasNullOperand {
                    var otherType = leftType;
                    if managedExprIsNullLiteral(binary.left) || leftType.kind == kindNull { otherType = rightType; }
                    if managedExprIsNullLiteral(binary.right) || rightType.kind == kindNull { otherType = leftType; }
                    if managedTypeIsString(otherType) && (otherType.kind == kindNullable || managedTypeIsString(otherType)) {
                        return lowerManagedValueEqual(lowerer, left, right, otherType, binary.op == opNe, spanRef(lowerer.sourcePath, binary.span));
                    }
                    var nullEqual = allocateValue(lowerer, irBool());
                    appendInstruction(lowerer, ir.rawEqual(nullEqual.id, left.id, right.id, spanRef(lowerer.sourcePath, binary.span)));
                    if binary.op == opEq { return LowerValue { id: nullEqual.id, ty: nullEqual.ty }; }
                    return lowerManagedBoolNot(lowerer, LowerValue { id: nullEqual.id, ty: nullEqual.ty }, spanRef(lowerer.sourcePath, binary.span));
                }
                if (binary.op == opEq || binary.op == opNe) && left.ty.kind == IRTypeKind::RawAddress && right.ty.kind == IRTypeKind::RawAddress && managedTypeKey(leftType) == managedTypeKey(rightType) && (managedTypeUsesValueEquality(leftType) || managedTypeUsesValueEquality(rightType)) {
                    var valueComparisonType = leftType;
                    if rightType.kind == kindNullable { valueComparisonType = rightType; }
                    return lowerManagedValueEqual(lowerer, left, right, valueComparisonType, binary.op == opNe, spanRef(lowerer.sourcePath, binary.span));
                }
            }
            if binary.op == opAdd || binary.op == opSub || binary.op == opMul || binary.op == opDiv || binary.op == opRem {
                if left.ty.kind != IRTypeKind::I64 || right.ty.kind != IRTypeKind::I64 || resultType.kind != IRTypeKind::I64 {
                    return failExpression(lowerer, expression, "checked arithmetic lowering requires i64 operands and result");
                }
                var computed = allocateValue(lowerer, irI64());
                appendInstruction(lowerer, checkedArithmeticInstruction(binary.op, computed.id, left.id, right.id, spanRef(lowerer.sourcePath, binary.span)));
                return LowerValue { id: computed.id, ty: computed.ty };
            }
            if binary.op == opEq || binary.op == opNe || binary.op == opLt || binary.op == opLe || binary.op == opGt || binary.op == opGe {
                var predicate = ir.compareEq();
                if binary.op == opNe { predicate = ir.compareNe(); }
                if lowerer.managed && left.ty.kind == IRTypeKind::RawAddress && right.ty.kind == IRTypeKind::RawAddress && resultType.kind == IRTypeKind::Bool && (binary.op == opEq || binary.op == opNe) && managedTypeUsesIdentityEquality(leftType) && managedTypeKey(leftType) == managedTypeKey(rightType) {
                    var equal = allocateValue(lowerer, irBool());
                    appendInstruction(lowerer, ir.rawEqual(equal.id, left.id, right.id, spanRef(lowerer.sourcePath, binary.span)));
                    if binary.op == opEq { return LowerValue { id: equal.id, ty: equal.ty }; }
                    var falseValue = allocateValue(lowerer, irBool());
                    appendInstruction(lowerer, constBool(falseValue.id, false, spanRef(lowerer.sourcePath, binary.span)));
                    var notEqual = allocateValue(lowerer, irBool());
                    appendInstruction(lowerer, compareBool(notEqual.id, ir.compareEq(), equal.id, falseValue.id, spanRef(lowerer.sourcePath, binary.span)));
                    return LowerValue { id: notEqual.id, ty: notEqual.ty };
                }
                if left.ty.kind == IRTypeKind::Bool && right.ty.kind == IRTypeKind::Bool && resultType.kind == IRTypeKind::Bool && (binary.op == opEq || binary.op == opNe) {
                    var boolCompared = allocateValue(lowerer, irBool());
                    appendInstruction(lowerer, compareBool(boolCompared.id, predicate, left.id, right.id, spanRef(lowerer.sourcePath, binary.span)));
                    return LowerValue { id: boolCompared.id, ty: boolCompared.ty };
                }
                if left.ty.kind != IRTypeKind::I64 || right.ty.kind != IRTypeKind::I64 || resultType.kind != IRTypeKind::Bool {
                    return failExpression(lowerer, expression, "scalar comparison lowering requires i64 operands, or bool equality operands");
                }
                if binary.op == opLt { predicate = ir.compareSlt(); }
                if binary.op == opLe { predicate = ir.compareSle(); }
                if binary.op == opGt { predicate = ir.compareSgt(); }
                if binary.op == opGe { predicate = ir.compareSge(); }
                var compared = allocateValue(lowerer, irBool());
                appendInstruction(lowerer, compareI64(compared.id, predicate, left.id, right.id, spanRef(lowerer.sourcePath, binary.span)));
                return LowerValue { id: compared.id, ty: compared.ty };
            }
            return failExpression(lowerer, expression, "binary operator '" + binary.op + "' is unsupported by scalar IR lowering");
        },
        Expr::Unary(unary) => { return lowerUnary(lowerer, expression, unary, resultType); },
        Expr::Call(callExpr) => { return lowerCall(lowerer, expression, callExpr); },
        Expr::FieldAccess(access) => {
            if lowerer.managed {
                var maybeFieldInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
                if maybeFieldInfo != null {
                    var fieldInfo = requiredCheckedExprInfo(maybeFieldInfo, lowerer.checked.expressions[0]);
                    if fieldInfo.symbol != null {
                        var fieldSymbol = requiredResolvedSymbol(fieldInfo.symbol, lowerer.checked.symbols[0]);
                        if fieldSymbol.kind == litEnumVariant { return lowerManagedTaggedConstructor(lowerer, expression, [], fieldInfo, fieldSymbol); }
                    }
                }
            }
            if lowerer.managed { return lowerManagedFieldAccess(lowerer, expression, access); }
            return failExpression(lowerer, expression, "expression syntax is unsupported by scalar IR lowering");
        },
        Expr::StructLiteral(literal) => {
            if lowerer.managed { return lowerManagedStructLiteral(lowerer, expression, literal); }
            return failExpression(lowerer, expression, "expression syntax is unsupported by scalar IR lowering");
        },
        Expr::Tuple(tuple) => { if lowerer.managed { return lowerManagedTupleLiteral(lowerer, expression, tuple); } return failExpression(lowerer, expression, "tuple expression is unsupported by scalar IR lowering"); },
        Expr::Array(array) => { if lowerer.managed { return lowerManagedArrayLiteral(lowerer, expression, array); } return failExpression(lowerer, expression, "array expression is unsupported by scalar IR lowering"); },
        Expr::Dict(dictionary) => { if lowerer.managed { return lowerManagedDictLiteral(lowerer, expression, dictionary); } return failExpression(lowerer, expression, "dictionary expression is unsupported by scalar IR lowering"); },
        Expr::Index(index) => { if lowerer.managed { return lowerManagedIndex(lowerer, expression, index); } return failExpression(lowerer, expression, "index expression is unsupported by scalar IR lowering"); },
        Expr::EnumVariant(variantExpr) => {
            if lowerer.managed {
                var maybeVariantInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, expression);
                if maybeVariantInfo != null {
                    var variantInfo = requiredCheckedExprInfo(maybeVariantInfo, lowerer.checked.expressions[0]);
                    if variantInfo.symbol != null { var variantSymbol = requiredResolvedSymbol(variantInfo.symbol, lowerer.checked.symbols[0]); return lowerManagedTaggedConstructor(lowerer, expression, variantExpr.args, variantInfo, variantSymbol); }
                }
                return failExpression(lowerer, expression, "enum variant has no checked constructor symbol");
            }
            return failExpression(lowerer, expression, "enum variant expression is unsupported by scalar IR lowering");
        },
        _ => { return failExpression(lowerer, expression, "expression syntax is unsupported by scalar IR lowering"); },
    }
    return LowerValue { id: -1, ty: irVoid() };
}

func alwaysTerminates(statements: Vec<Stmt>): bool {
    var i = 0;
    loop {
        if i >= statements.len() { break; }
        var statement = statements[i];
        match statement {
            Stmt::Return(_) => { return true; },
            Stmt::Break(_) => { return true; },
            Stmt::Continue(_) => { return true; },
            Stmt::Block(block) => { if alwaysTerminates(block.statements) { return true; } },
            Stmt::If(ifStmt) => {
                var maybeElse = ifStmt.elseBranch;
                if maybeElse != null {
                    var elseBlock: BlockStmt = maybeElse;
                    if alwaysTerminates(ifStmt.thenBranch.statements) && alwaysTerminates(elseBlock.statements) { return true; }
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    return false;
}

func reserveBlock(lowerer: FunctionLowerer, params: Vec<IRValue>): int {
    var id = lowerer.blocks.len();
    var placeholder = basicBlock(id, params, [], returnVoid(sourceRef(lowerer.sourcePath, 0, 0)));
    lowerer.blocks.push(placeholder);
    return id;
}

func finishBlock(lowerer: FunctionLowerer, terminator: Terminator) {
    var block = basicBlock(lowerer.currentBlockId, lowerer.currentParams, lowerer.currentInstructions, terminator);
    lowerer.blocks.set(lowerer.currentBlockId, block);
    lowerer.currentInstructions = [];
    lowerer.terminated = true;
}

func enterBlock(lowerer: FunctionLowerer, blockId: int, params: Vec<IRValue>) {
    lowerer.currentBlockId = blockId;
    lowerer.currentParams = params;
    lowerer.currentInstructions = [];
    lowerer.terminated = false;
}

func lowerStatements(lowerer: FunctionLowerer, statements: Vec<Stmt>) {
    var i = 0;
    loop {
        if i >= statements.len() { break; }
        if lowerer.error != emptyString { return; }
        if lowerer.terminated { return; }
        lowerStmt(lowerer, statements[i]);
        i = i + 1;
    }
}

func lowerDeclaration(lowerer: FunctionLowerer, statement: Stmt, name: string, initializer: Expr, span: Span) {
    var maybeBinding = bindingForDeclaration(lowerer.checked, lowerer.bindingIndex, lowerer.sourcePath, lowerer.moduleId, statement, name);
    if maybeBinding != null {
        var binding = requiredCheckedBindingInfo(maybeBinding, lowerer.checked.bindings[0]);
        if lowerer.managed {
            if !managedTypeIsSupported(lowerer.checked, lowerer.managedLayouts, binding.ty, false) {
                lowerer.error = lowerError(lowerer.sourcePath, span.start, "local '" + name + "' has unsupported managed type " + binding.ty.kind);
                return;
            }
        } else if !checkedTypeIsValue(binding.ty) {
            lowerer.error = lowerError(lowerer.sourcePath, span.start, "local '" + name + "' has unsupported type " + binding.ty.kind);
            return;
        }
        var initializerValue = lowerExprExpected(lowerer, initializer, binding.ty);
        if lowerer.error != emptyString { return; }
        var expectedType = toIRType(binding.ty);
        if lowerer.managed { expectedType = managedIRType(lowerer.managedLayouts, binding.ty); }
        var matches = initializerValue.ty.kind == expectedType.kind;
        if lowerer.managed && managedLayoutId(lowerer.managedLayouts, binding.ty) > 0 {
            var initialLayout = 0;
            var isNull = false;
            var maybeInitializerInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, initializer);
            if maybeInitializerInfo != null {
                var initializerInfo = requiredCheckedExprInfo(maybeInitializerInfo, lowerer.checked.expressions[0]);
                var effectiveInitializerType = initializerInfo.ty;
                if initializerInfo.ty.kind == kindNull { effectiveInitializerType = binding.ty; }
                if initializerInfo.ty.kind == binding.ty.kind && managedTypeContainsAny(initializerInfo.ty) { effectiveInitializerType = binding.ty; }
                if managedTypeHasNullLeaf(initializerInfo.ty) && managedNullSpecializationCompatible(initializerInfo.ty, binding.ty, lowerer.managedLayouts) { effectiveInitializerType = binding.ty; }
                initialLayout = managedLayoutId(lowerer.managedLayouts, effectiveInitializerType);
                isNull = initializerInfo.ty.kind == kindNull;
            }
            matches = initializerValue.ty.kind == IRTypeKind::RawAddress && (initialLayout == managedLayoutId(lowerer.managedLayouts, binding.ty) || isNull);
        }
        if initializerValue.id < 0 || initializerValue.ty.kind == IRTypeKind::Void || !matches {
            lowerer.error = lowerError(lowerer.sourcePath, span.start, "local initializer does not produce its checked scalar type");
            return;
        }
        var identity = "local:" + binding.declarationKey + ":" + binding.name;
        var layoutId = 0;
        if lowerer.managed { layoutId = managedLayoutId(lowerer.managedLayouts, binding.ty); }
        bindLocal(lowerer, name, identity, binding.isConst, layoutId, irValue(initializerValue.id, initializerValue.ty));
        return;
    }
    lowerer.error = lowerError(lowerer.sourcePath, span.start, "checked local binding metadata is missing");
}

func lowerReturn(lowerer: FunctionLowerer, statement: ReturnStmt) {
    var returnSpan = statement.span;
    var valueSpan = exprSpan(statement.value);
    if valueSpan.start == returnSpan.start {
        if lowerer.plan.returnType.kind != IRTypeKind::Void {
            lowerer.error = lowerError(lowerer.sourcePath, returnSpan.start, "value-returning function requires a scalar return value");
            return;
        }
        finishBlock(lowerer, returnVoid(spanRef(lowerer.sourcePath, returnSpan)));
        return;
    }
    if lowerer.plan.returnType.kind == IRTypeKind::Void {
        lowerer.error = lowerError(lowerer.sourcePath, returnSpan.start, "void function cannot return a value in scalar IR lowering");
        return;
    }
    var returnExpectedType = functionTypeResult(lowerer.plan.symbol.signature);
    var value = lowerExprExpected(lowerer, statement.value, returnExpectedType);
    if lowerer.error != emptyString { return; }
    if value.id < 0 || value.ty.kind != lowerer.plan.returnType.kind {
        lowerer.error = lowerError(lowerer.sourcePath, returnSpan.start, "return value does not match the checked function result type");
        return;
    }
    if lowerer.managed && lowerer.plan.returnLayout > 0 {
        var actualLayout = 0;
        var isNull = false;
        var maybeInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, statement.value);
        if maybeInfo != null {
            var info = requiredCheckedExprInfo(maybeInfo, lowerer.checked.expressions[0]);
            var effectiveReturnType = info.ty;
            if info.ty.kind == kindNull { effectiveReturnType = returnExpectedType; }
            if info.ty.kind == returnExpectedType.kind && managedTypeContainsAny(info.ty) { effectiveReturnType = returnExpectedType; }
            if managedTypeHasNullLeaf(info.ty) && managedNullSpecializationCompatible(info.ty, returnExpectedType, lowerer.managedLayouts) { effectiveReturnType = returnExpectedType; }
            actualLayout = managedLayoutId(lowerer.managedLayouts, effectiveReturnType);
            isNull = info.ty.kind == kindNull;
        }
        if actualLayout != lowerer.plan.returnLayout && !isNull {
            lowerer.error = lowerError(lowerer.sourcePath, returnSpan.start, "return value has a different checked nominal managed layout");
            return;
        }
    }
    finishBlock(lowerer, returnValue(value.id, spanRef(lowerer.sourcePath, returnSpan)));
}

func lowerIf(lowerer: FunctionLowerer, statement: IfStmt) {
    var condition = lowerExpr(lowerer, statement.condition);
    if lowerer.error != emptyString { return; }
    if condition.ty.kind != IRTypeKind::Bool || condition.id < 0 {
        lowerer.error = lowerError(lowerer.sourcePath, exprSpan(statement.condition).start, "if condition must lower to a bool SSA value");
        return;
    }
    var maybeElse = statement.elseBranch;
    var hasElse = maybeElse != null;
    var thenTerminates = alwaysTerminates(statement.thenBranch.statements);
    var elseTerminates = false;
    if maybeElse != null {
        var elseBlock: BlockStmt = maybeElse;
        elseTerminates = alwaysTerminates(elseBlock.statements);
    }
    var bothTerminate = hasElse && thenTerminates && elseTerminates;
    var beforeScopes = cloneScopes(lowerer.scopes);
    var thenEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var elseEnvironment = BlockEnvironment { scopes: [], params: [], args: [], bindingKeys: [] };
    if maybeElse != null { elseEnvironment = makeBlockEnvironment(lowerer, beforeScopes); }
    var mergeEnvironment = BlockEnvironment { scopes: [], params: [], args: [], bindingKeys: [] };
    if !bothTerminate { mergeEnvironment = makeBlockEnvironment(lowerer, beforeScopes); }
    var thenId = reserveBlock(lowerer, thenEnvironment.params);
    var elseId = -1;
    if hasElse { elseId = reserveBlock(lowerer, elseEnvironment.params); }
    var mergeId = -1;
    if !bothTerminate { mergeId = reserveBlock(lowerer, mergeEnvironment.params); }
    var span = statement.span;
    var falseTarget = mergeId;
    var falseArgs: Vec<int> = mergeEnvironment.args;
    if hasElse { falseTarget = elseId; falseArgs = elseEnvironment.args; }
    finishBlock(lowerer, branch(condition.id, thenId, thenEnvironment.args, falseTarget, falseArgs, spanRef(lowerer.sourcePath, span)));

    lowerer.scopes = cloneScopes(thenEnvironment.scopes);
    enterBlock(lowerer, thenId, thenEnvironment.params);
    pushScope(lowerer);
    lowerStatements(lowerer, statement.thenBranch.statements);
    popScope(lowerer);
    if lowerer.error != emptyString { return; }
    if !lowerer.terminated {
        if mergeId < 0 { lowerer.error = lowerError(lowerer.sourcePath, span.start, "internal lowering error: missing if merge block"); return; }
        var thenArgs = blockArgsForKeys(lowerer, lowerer.scopes, mergeEnvironment.bindingKeys, span.start);
        if lowerer.error != emptyString { return; }
        finishBlock(lowerer, jump(mergeId, thenArgs, spanRef(lowerer.sourcePath, span)));
    }

    if maybeElse != null {
        lowerer.scopes = cloneScopes(elseEnvironment.scopes);
        enterBlock(lowerer, elseId, elseEnvironment.params);
        pushScope(lowerer);
        var explicitElse: BlockStmt = maybeElse;
        lowerStatements(lowerer, explicitElse.statements);
        popScope(lowerer);
        if lowerer.error != emptyString { return; }
        if !lowerer.terminated {
            if mergeId < 0 { lowerer.error = lowerError(lowerer.sourcePath, span.start, "internal lowering error: missing if merge block"); return; }
            var elseArgs = blockArgsForKeys(lowerer, lowerer.scopes, mergeEnvironment.bindingKeys, span.start);
            if lowerer.error != emptyString { return; }
            finishBlock(lowerer, jump(mergeId, elseArgs, spanRef(lowerer.sourcePath, span)));
        }
    }
    if mergeId >= 0 {
        lowerer.scopes = cloneScopes(mergeEnvironment.scopes);
        enterBlock(lowerer, mergeId, mergeEnvironment.params);
    }
    else { lowerer.terminated = true; lowerer.currentBlockId = -1; }
}

func lowerWhile(lowerer: FunctionLowerer, statement: WhileStmt) {
    var beforeScopes = cloneScopes(lowerer.scopes);
    var headerEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var bodyEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var exitEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var headerId = reserveBlock(lowerer, headerEnvironment.params);
    var bodyId = reserveBlock(lowerer, bodyEnvironment.params);
    var exitId = reserveBlock(lowerer, exitEnvironment.params);
    var span = statement.span;
    finishBlock(lowerer, jump(headerId, headerEnvironment.args, spanRef(lowerer.sourcePath, span)));

    lowerer.scopes = cloneScopes(headerEnvironment.scopes);
    enterBlock(lowerer, headerId, headerEnvironment.params);
    var condition = lowerExpr(lowerer, statement.condition);
    if lowerer.error != emptyString { return; }
    if condition.id < 0 || condition.ty.kind != IRTypeKind::Bool {
        lowerer.error = lowerError(lowerer.sourcePath, exprSpan(statement.condition).start, "while condition must lower to a bool SSA value");
        return;
    }
    var bodyArgs = blockArgsForKeys(lowerer, lowerer.scopes, bodyEnvironment.bindingKeys, span.start);
    if lowerer.error != emptyString { return; }
    var exitArgs = blockArgsForKeys(lowerer, lowerer.scopes, exitEnvironment.bindingKeys, span.start);
    if lowerer.error != emptyString { return; }
    finishBlock(lowerer, branch(condition.id, bodyId, bodyArgs, exitId, exitArgs, spanRef(lowerer.sourcePath, span)));

    lowerer.loopTargets.push(LoopTarget { headerBlockId: headerId, exitBlockId: exitId, continueBlockId: headerId, bindingKeys: headerEnvironment.bindingKeys, exitKeys: exitEnvironment.bindingKeys });
    lowerer.scopes = cloneScopes(bodyEnvironment.scopes);
    enterBlock(lowerer, bodyId, bodyEnvironment.params);
    pushScope(lowerer);
    lowerStatements(lowerer, statement.body);
    popScope(lowerer);
    if lowerer.error != emptyString { return; }
    if !lowerer.terminated {
        var backedgeArgs = blockArgsForKeys(lowerer, lowerer.scopes, headerEnvironment.bindingKeys, span.start);
        if lowerer.error != emptyString { return; }
        finishBlock(lowerer, jump(headerId, backedgeArgs, spanRef(lowerer.sourcePath, span)));
    }
    lowerer.loopTargets.pop();

    lowerer.scopes = cloneScopes(exitEnvironment.scopes);
    enterBlock(lowerer, exitId, exitEnvironment.params);
}

func lowerLoop(lowerer: FunctionLowerer, statement: LoopStmt) {
    var beforeScopes = cloneScopes(lowerer.scopes);
    var headerEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var bodyEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var exitEnvironment = makeBlockEnvironment(lowerer, beforeScopes);
    var headerId = reserveBlock(lowerer, headerEnvironment.params);
    var bodyId = reserveBlock(lowerer, bodyEnvironment.params);
    var exitId = reserveBlock(lowerer, exitEnvironment.params);
    var span = statement.span;
    finishBlock(lowerer, jump(headerId, headerEnvironment.args, spanRef(lowerer.sourcePath, span)));

    lowerer.scopes = cloneScopes(headerEnvironment.scopes);
    enterBlock(lowerer, headerId, headerEnvironment.params);
    var bodyArgs = blockArgsForKeys(lowerer, lowerer.scopes, bodyEnvironment.bindingKeys, span.start);
    if lowerer.error != emptyString { return; }
    finishBlock(lowerer, jump(bodyId, bodyArgs, spanRef(lowerer.sourcePath, span)));

    lowerer.loopTargets.push(LoopTarget { headerBlockId: headerId, exitBlockId: exitId, continueBlockId: headerId, bindingKeys: headerEnvironment.bindingKeys, exitKeys: exitEnvironment.bindingKeys });
    lowerer.scopes = cloneScopes(bodyEnvironment.scopes);
    enterBlock(lowerer, bodyId, bodyEnvironment.params);
    pushScope(lowerer);
    lowerStatements(lowerer, statement.body);
    popScope(lowerer);
    if lowerer.error != emptyString { return; }
    if !lowerer.terminated {
        var backedgeArgs = blockArgsForKeys(lowerer, lowerer.scopes, headerEnvironment.bindingKeys, span.start);
        if lowerer.error != emptyString { return; }
        finishBlock(lowerer, jump(headerId, backedgeArgs, spanRef(lowerer.sourcePath, span)));
    }
    lowerer.loopTargets.pop();

    lowerer.scopes = cloneScopes(exitEnvironment.scopes);
    enterBlock(lowerer, exitId, exitEnvironment.params);
}

func containsContinue(statements: Vec<Stmt>): bool {
    var index = 0;
    loop {
        if index >= statements.len() { break; }
        var statement = statements[index];
        match statement {
            Stmt::Continue(_) => { return true; },
            Stmt::Block(block) => { if containsContinue(block.statements) { return true; } },
            Stmt::If(ifStmt) => {
                if containsContinue(ifStmt.thenBranch.statements) { return true; }
                var maybeElse = ifStmt.elseBranch;
                if maybeElse != null {
                    var elseBlock: BlockStmt = maybeElse;
                    if containsContinue(elseBlock.statements) { return true; }
                }
            },
            _ => {},
        }
        index = index + 1;
    }
    return false;
}

func lowerFor(lowerer: FunctionLowerer, statement: ForStmt) {
    var bounds = rangeCallBounds(lowerer, statement.iterable);
    if !bounds.found {
        lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "for loops require a range(start, end) iterable");
        return;
    }
    var start = lowerExpr(lowerer, bounds.start);
    if lowerer.error != emptyString { return; }
    var end = lowerExpr(lowerer, bounds.end);
    if lowerer.error != emptyString { return; }
    if start.id < 0 || end.id < 0 || start.ty.kind != IRTypeKind::I64 || end.ty.kind != IRTypeKind::I64 {
        lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "range for loop requires i64 bounds");
        return;
    }
    var outside = cloneScopes(lowerer.scopes);
    pushScope(lowerer);
    var endName = hiddenName("for-end", statement.span);
    bindLocal(lowerer, endName, endName, true, 0, irValue(end.id, end.ty));
    bindLocal(lowerer, statement.variable, "for:" + statement.span.start.toString(), false, 0, irValue(start.id, start.ty));
    if lowerer.error != emptyString { return; }
    var loopScopes = cloneScopes(lowerer.scopes);
    var headerEnvironment = makeBlockEnvironment(lowerer, loopScopes);
    var bodyEnvironment = makeBlockEnvironment(lowerer, loopScopes);
    var stepEnvironment = makeBlockEnvironment(lowerer, loopScopes);
    var exitEnvironment = makeBlockEnvironment(lowerer, outside);
    var headerId = reserveBlock(lowerer, headerEnvironment.params);
    var bodyId = reserveBlock(lowerer, bodyEnvironment.params);
    var needsStep = !alwaysTerminates(statement.body) || containsContinue(statement.body);
    var stepId = headerId;
    if needsStep { stepId = reserveBlock(lowerer, stepEnvironment.params); }
    var exitId = reserveBlock(lowerer, exitEnvironment.params);
    var span = statement.span;
    finishBlock(lowerer, jump(headerId, headerEnvironment.args, spanRef(lowerer.sourcePath, span)));

    lowerer.scopes = cloneScopes(headerEnvironment.scopes);
    enterBlock(lowerer, headerId, headerEnvironment.params);
    var cursor = findLocal(lowerer, statement.variable);
    var limit = findLocal(lowerer, endName);
    if cursor == null || limit == null {
        lowerer.error = lowerError(lowerer.sourcePath, span.start, "internal lowering error: for loop bindings were lost");
        return;
    }
    var cursorValue = requiredIRValue(cursor, irValue(-1, irVoid()));
    var limitValue = requiredIRValue(limit, irValue(-1, irVoid()));
    var compared = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, compareI64(compared.id, ir.compareSlt(), cursorValue.id, limitValue.id, spanRef(lowerer.sourcePath, span)));
    var bodyArgs = blockArgsForKeys(lowerer, lowerer.scopes, bodyEnvironment.bindingKeys, span.start);
    if lowerer.error != emptyString { return; }
    var exitArgs = blockArgsForKeys(lowerer, lowerer.scopes, exitEnvironment.bindingKeys, span.start);
    if lowerer.error != emptyString { return; }
    finishBlock(lowerer, branch(compared.id, bodyId, bodyArgs, exitId, exitArgs, spanRef(lowerer.sourcePath, span)));

    lowerer.loopTargets.push(LoopTarget { headerBlockId: headerId, exitBlockId: exitId, continueBlockId: stepId, bindingKeys: stepEnvironment.bindingKeys, exitKeys: exitEnvironment.bindingKeys });
    lowerer.scopes = cloneScopes(bodyEnvironment.scopes);
    enterBlock(lowerer, bodyId, bodyEnvironment.params);
    pushScope(lowerer);
    lowerStatements(lowerer, statement.body);
    popScope(lowerer);
    if lowerer.error != emptyString { return; }
    if !lowerer.terminated && needsStep {
        var stepArgs = blockArgsForKeys(lowerer, lowerer.scopes, stepEnvironment.bindingKeys, span.start);
        if lowerer.error != emptyString { return; }
        finishBlock(lowerer, jump(stepId, stepArgs, spanRef(lowerer.sourcePath, span)));
    }
    lowerer.loopTargets.pop();

    if needsStep {
        lowerer.scopes = cloneScopes(stepEnvironment.scopes);
        enterBlock(lowerer, stepId, stepEnvironment.params);
        var current = findLocal(lowerer, statement.variable);
        if current == null {
            lowerer.error = lowerError(lowerer.sourcePath, span.start, "internal lowering error: for loop variable was lost");
            return;
        }
        var currentValue = requiredIRValue(current, irValue(-1, irVoid()));
        var one = allocateValue(lowerer, irI64());
        appendInstruction(lowerer, constI64(one.id, 1, spanRef(lowerer.sourcePath, span)));
        var next = allocateValue(lowerer, irI64());
        appendInstruction(lowerer, addCheckedI64(next.id, currentValue.id, one.id, spanRef(lowerer.sourcePath, span)));
        var location = findLocalLocation(lowerer.scopes, statement.variable);
        if !location.found {
            lowerer.error = lowerError(lowerer.sourcePath, span.start, "internal lowering error: for loop variable was lost");
            return;
        }
        updateLocal(lowerer, location, next);
        var backArgs = blockArgsForKeys(lowerer, lowerer.scopes, headerEnvironment.bindingKeys, span.start);
        if lowerer.error != emptyString { return; }
        finishBlock(lowerer, jump(headerId, backArgs, spanRef(lowerer.sourcePath, span)));
    }

    lowerer.scopes = cloneScopes(exitEnvironment.scopes);
    enterBlock(lowerer, exitId, exitEnvironment.params);
}

func lowerLoopTransfer(lowerer: FunctionLowerer, span: Span, isBreak: bool) {
    if lowerer.loopTargets.len() == 0 {
        var label = "continue";
        if isBreak { label = "break"; }
        lowerer.error = lowerError(lowerer.sourcePath, span.start, label + " used outside a lowered loop");
        return;
    }
    var target = lowerer.loopTargets[lowerer.loopTargets.len() - 1];
    var targetKeys = target.bindingKeys;
    var targetBlockId = target.continueBlockId;
    if isBreak { targetBlockId = target.exitBlockId; targetKeys = target.exitKeys; }
    var args = blockArgsForKeys(lowerer, lowerer.scopes, targetKeys, span.start);
    if lowerer.error != emptyString { return; }
    finishBlock(lowerer, jump(targetBlockId, args, spanRef(lowerer.sourcePath, span)));
}

func assignGlobal(lowerer: FunctionLowerer, statement: AssignStmt, name: string): bool {
    var slotIndex = findGlobalSlot(lowerer, name);
    if slotIndex < 0 { return false; }
    var slot = lowerer.globalSlots[slotIndex];
    if slot.isConst {
        lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "cannot assign to const '" + name + "'");
        return true;
    }
    var fieldExpectedType = slot.ty;
    var right = lowerExprExpected(lowerer, statement.value, fieldExpectedType);
    if lowerer.error != emptyString { return true; }
    var newValue = right;
    if statement.op == opAddAssign || statement.op == opSubAssign || statement.op == opMulAssign || statement.op == opDivAssign || statement.op == opRemAssign {
        var current = emitGlobalLoad(lowerer, slot, spanRef(lowerer.sourcePath, statement.span));
        if current.id < 0 || current.ty.kind != IRTypeKind::I64 || right.ty.kind != IRTypeKind::I64 {
            lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "checked compound assignment requires i64 operands");
            return true;
        }
        var sum = allocateValue(lowerer, irI64());
        var operation = statement.op.slice(0, statement.op.len() - 1);
        finishAssignmentInstruction(lowerer, sum, current.id, right.id, operation, statement.span);
        newValue = LowerValue { id: sum.id, ty: sum.ty };
    } else if statement.op != opAssign {
        lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "assignment operator '" + statement.op + "' is unsupported by scalar IR lowering");
        return true;
    }
    emitGlobalStore(lowerer, slot, newValue, spanRef(lowerer.sourcePath, statement.span));
    return true;
}

func lowerAssignment(lowerer: FunctionLowerer, statement: AssignStmt) {
    var maybeIdentifier = statement.target;
    match maybeIdentifier {
        Expr::Identifier(identifier) => {
            var location = findLocalLocation(lowerer.scopes, identifier.name);
            if !location.found {
                if assignGlobal(lowerer, statement, identifier.name) { return; }
                lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "assignment target is not a local scalar binding");
                return;
            }
            if location.binding.isConst {
                lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "cannot assign to const '" + identifier.name + "'");
                return;
            }
            var fieldExpectedType = Type { kind: kindUnknown, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
            var maybeTargetInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, statement.target);
            if maybeTargetInfo != null { var targetInfo = requiredCheckedExprInfo(maybeTargetInfo, lowerer.checked.expressions[0]); fieldExpectedType = targetInfo.ty; }
            var right = lowerExprExpected(lowerer, statement.value, fieldExpectedType);
            if lowerer.error != emptyString { return; }
            var newValue = right;
            if statement.op == opAddAssign || statement.op == opSubAssign || statement.op == opMulAssign || statement.op == opDivAssign || statement.op == opRemAssign {
                if location.binding.value.ty.kind != IRTypeKind::I64 || right.ty.kind != IRTypeKind::I64 || right.id < 0 {
                    lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "checked compound assignment requires i64 operands");
                    return;
                }
                var sum = allocateValue(lowerer, irI64());
                var operation = statement.op.slice(0, statement.op.len() - 1);
                finishAssignmentInstruction(lowerer, sum, location.binding.value.id, right.id, operation, statement.span);
                newValue = LowerValue { id: sum.id, ty: sum.ty };
            } else if statement.op != opAssign {
                lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "assignment operator '" + statement.op + "' is unsupported by scalar IR lowering");
                return;
            }
            if newValue.id < 0 || newValue.ty.kind != location.binding.value.ty.kind {
                lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "assignment value does not match the checked local scalar type");
                return;
            }
            if lowerer.managed && statement.op == opAssign && location.binding.layoutId > 0 {
                var assignedLayout = 0;
                var assignedNull = false;
                var assignmentExpectedType: Type = Type { kind: kindUnknown, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
                var maybeAssignmentTargetInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, statement.target);
                if maybeAssignmentTargetInfo != null { var assignmentTargetInfo: CheckedExprInfo = maybeAssignmentTargetInfo; assignmentExpectedType = assignmentTargetInfo.ty; }
                var maybeAssignedInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, statement.value);
                if maybeAssignedInfo != null {
                    var assignedInfo = requiredCheckedExprInfo(maybeAssignedInfo, lowerer.checked.expressions[0]);
                    var effectiveAssignedType = assignedInfo.ty;
                    if assignedInfo.ty.kind == kindNull || (assignedInfo.ty.kind == assignmentExpectedType.kind && managedTypeContainsAny(assignedInfo.ty)) { effectiveAssignedType = assignmentExpectedType; }
                    if managedTypeHasNullLeaf(assignedInfo.ty) && managedNullSpecializationCompatible(assignedInfo.ty, assignmentExpectedType, lowerer.managedLayouts) { effectiveAssignedType = assignmentExpectedType; }
                    assignedLayout = managedLayoutId(lowerer.managedLayouts, effectiveAssignedType);
                    assignedNull = assignedInfo.ty.kind == kindNull;
                }
                if assignedLayout != location.binding.layoutId && !assignedNull {
                    lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "assignment has a different checked nominal managed layout");
                    return;
                }
            }
            updateLocal(lowerer, location, irValue(newValue.id, newValue.ty));
        },
        Expr::FieldAccess(access) => {
            if !lowerer.managed {
                lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "only direct local identifier assignments are supported by scalar IR lowering");
                return;
            }
            if statement.op != opAssign {
                lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "compound managed field assignment is unsupported");
                return;
            }
            var maybeField = managedFieldForAccess(lowerer, statement.target, access);
            if maybeField == null { return; }
            var field = requiredManagedField(maybeField, ManagedField { name: emptyString, offset: 0, kind: IRTypeKind::I64, layoutId: 0 });
            var maybeAccessInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, statement.target);
            if maybeAccessInfo != null { var accessInfo: CheckedExprInfo = maybeAccessInfo; if accessInfo.receiverType.kind == kindTuple { lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "tuple values are immutable"); return; } }
            var owner = lowerExpr(lowerer, access.object);
            if lowerer.error != emptyString { return; }
            var expectedFieldType: Type = Type { kind: kindUnknown, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
            if maybeAccessInfo != null { var accessInfo2: CheckedExprInfo = maybeAccessInfo; expectedFieldType = accessInfo2.ty; }
            var right = lowerExprExpected(lowerer, statement.value, expectedFieldType);
            if lowerer.error != emptyString { return; }
            var matchesField = right.ty.kind == field.kind;
            if field.layoutId > 0 {
                var rightLayout = 0;
                var rightIsNull = false;
                var maybeRightInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, statement.value);
                if maybeRightInfo != null {
                    var rightInfo: CheckedExprInfo = maybeRightInfo;
                    var effectiveRightType = rightInfo.ty;
                    if rightInfo.ty.kind == kindNull || (rightInfo.ty.kind == expectedFieldType.kind && managedTypeContainsAny(rightInfo.ty)) { effectiveRightType = expectedFieldType; }
                    if managedTypeHasNullLeaf(rightInfo.ty) && managedNullSpecializationCompatible(rightInfo.ty, expectedFieldType, lowerer.managedLayouts) { effectiveRightType = expectedFieldType; }
                    rightLayout = managedLayoutId(lowerer.managedLayouts, effectiveRightType);
                    rightIsNull = rightInfo.ty.kind == kindNull;
                }
                matchesField = right.ty.kind == IRTypeKind::RawAddress && (rightLayout == field.layoutId || rightIsNull);
            }
            if !matchesField {
                lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "field assignment value does not match its checked nominal field type");
                return;
            }
            var ownerValue = irValue(owner.id, owner.ty);
            emitManagedFieldStore(lowerer, ownerValue, field, right, statement.span);
        },
        Expr::Index(index) => {
            if !lowerer.managed { lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "indexed assignment is unsupported by scalar IR lowering"); return; }
            if statement.op != opAssign { lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "compound managed indexed assignment is unsupported"); return; }
            var maybeOwnerInfo = findExprInfo(lowerer.checked, lowerer.sourcePath, lowerer.moduleId, index.target);
            if maybeOwnerInfo == null { lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "checked indexed assignment owner metadata is missing"); return; }
            var ownerInfo = requiredCheckedExprInfo(maybeOwnerInfo, lowerer.checked.expressions[0]);
            var ownerType = managedExpressionType(lowerer, ownerInfo.ty);
            var owner = lowerExprExpected(lowerer, index.target, ownerType);
            if lowerer.error != emptyString { return; }
            var targetType = Type { kind: kindUnknown, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
            var indexType = Type { kind: kindInt, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null };
            if ownerType.kind == kindArray { targetType = managedArrayElementType(ownerType); }
            else if ownerType.kind == kindDict { indexType = Type { kind: kindString, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: [], ret: null }; targetType = requiredType(ownerType.value, managedUnknownType()); }
            else { lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "managed indexed assignment owner is not Vec or HashMap"); return; }
            var indexValue = lowerExprExpected(lowerer, index.index, indexType);
            if lowerer.error != emptyString { return; }
            var expectedIndexKind = IRTypeKind::I64;
            if ownerType.kind == kindDict { expectedIndexKind = IRTypeKind::RawAddress; }
            if indexValue.id < 0 || indexValue.ty.kind != expectedIndexKind { lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "indexed assignment key does not match its checked aggregate type"); return; }
            var right = lowerExprExpected(lowerer, statement.value, targetType);
            if lowerer.error != emptyString { return; }
            if owner.id < 0 || owner.ty.kind != IRTypeKind::RawAddress { lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "indexed assignment owner is not a canonical reference"); return; }
            if ownerType.kind == kindArray {
                var elementType = managedArrayElementType(ownerType);
                var isReference = managedLayoutId(lowerer.managedLayouts, elementType) > 0;
                var helper = "managedVecSetI64";
                var stored = right;
                if isReference { helper = "managedVecSetReference"; }
                else if right.ty.kind == IRTypeKind::Bool { var encoded = lowerBoolAsI64(lowerer, right.id, spanRef(lowerer.sourcePath, statement.span)); stored = LowerValue { id: encoded.id, ty: encoded.ty }; }
                if (isReference && right.ty.kind != IRTypeKind::RawAddress) || (!isReference && stored.ty.kind != IRTypeKind::I64) { lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "Vec assignment value does not match its checked element type"); return; }
                managedCallHook(lowerer, helper, irVoid(), [owner.id, indexValue.id, stored.id], spanRef(lowerer.sourcePath, statement.span));
                return;
            }
            if ownerType.kind == kindDict {
            var valueType = requiredType(ownerType.value, managedUnknownType());
                var isReference = managedLayoutId(lowerer.managedLayouts, valueType) > 0;
                var helper = "managedMapSetI64";
                var stored = right;
                var nodeLayout = managedI64Constant(lowerer, managedMapNodeLayoutId(lowerer, valueType), spanRef(lowerer.sourcePath, statement.span));
                if isReference { helper = "managedMapSetReference"; }
                else if right.ty.kind == IRTypeKind::Bool { var encoded2 = lowerBoolAsI64(lowerer, right.id, spanRef(lowerer.sourcePath, statement.span)); stored = LowerValue { id: encoded2.id, ty: encoded2.ty }; }
                if (isReference && right.ty.kind != IRTypeKind::RawAddress) || (!isReference && stored.ty.kind != IRTypeKind::I64) { lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "HashMap assignment value does not match its checked value type"); return; }
                managedCallHook(lowerer, helper, irVoid(), [owner.id, nodeLayout.id, indexValue.id, stored.id], spanRef(lowerer.sourcePath, statement.span));
                return;
            }
            lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "only Vec and HashMap indexed values are mutable in managed lowering");
        },
        _ => { lowerer.error = lowerError(lowerer.sourcePath, statement.span.start, "only direct local identifier assignments are supported by scalar IR lowering"); },
    }
}

func finishAssignmentInstruction(lowerer: FunctionLowerer, result: IRValue, leftId: int, rightId: int, op: string, span: Span) {
    appendInstruction(lowerer, checkedArithmeticInstruction(op, result.id, leftId, rightId, spanRef(lowerer.sourcePath, span)));
}

func lowerStmt(lowerer: FunctionLowerer, statement: Stmt) {
    if lowerer.error != emptyString { return; }
    match statement {
        Stmt::VarDecl(declaration) => { lowerDeclaration(lowerer, statement, declaration.name, declaration.value, declaration.span); },
        Stmt::ConstDecl(declaration) => { lowerDeclaration(lowerer, statement, declaration.name, declaration.value, declaration.span); },
        Stmt::Return(returnStmt) => { lowerReturn(lowerer, returnStmt); },
        Stmt::If(ifStmt) => { lowerIf(lowerer, ifStmt); },
        Stmt::Block(block) => {
            pushScope(lowerer);
            lowerStatements(lowerer, block.statements);
            popScope(lowerer);
        },
        Stmt::ExprStmt(expressionStmt) => {
            var ignored = lowerExpr(lowerer, expressionStmt.expr);
        },
        Stmt::Assign(assignStmt) => { lowerAssignment(lowerer, assignStmt); },
        Stmt::FuncDecl(declaration) => { lowerer.error = lowerError(lowerer.sourcePath, declaration.span.start, "nested function declarations are unsupported by scalar IR lowering"); },
        Stmt::Import(importStmt) => { lowerer.error = lowerError(lowerer.sourcePath, importStmt.span.start, "nested imports are unsupported by scalar IR lowering"); },
        Stmt::StructDecl(declaration) => { lowerer.error = lowerError(lowerer.sourcePath, declaration.span.start, "struct declarations are unsupported by scalar IR lowering"); },
        Stmt::EnumDecl(declaration) => { lowerer.error = lowerError(lowerer.sourcePath, declaration.span.start, "enum declarations are unsupported by scalar IR lowering"); },
        Stmt::While(whileStmt) => { lowerWhile(lowerer, whileStmt); },
        Stmt::For(forStmt) => { lowerFor(lowerer, forStmt); },
        Stmt::Loop(loopStmt) => { lowerLoop(lowerer, loopStmt); },
        Stmt::Break(breakStmt) => { lowerLoopTransfer(lowerer, breakStmt.span, true); },
        Stmt::Continue(continueStmt) => { lowerLoopTransfer(lowerer, continueStmt.span, false); },
        Stmt::Match(matchStmt) => { if lowerer.managed { lowerManagedMatch(lowerer, matchStmt); } else { lowerer.error = lowerError(lowerer.sourcePath, matchStmt.span.start, "match statements are unsupported by scalar IR lowering"); } },
    }
}

func unknownEffectsFor(parameters: int): EffectSummary {
    var escapes: Vec<Escape> = [];
    var i = 0;
    loop {
        if i >= parameters { break; }
        escapes.push(escapeUnknown());
        i = i + 1;
    }
    return effectSummary(factUnknown(), factUnknown(), factUnknown(), factUnknown(), factUnknown(), factUnknown(), escapes, escapeUnknown());
}

func lowerFunction(checked: CheckedProgram, bindingIndex: HashMap<string, Vec<int>>, plan: FunctionPlan, plans: Vec<FunctionPlan>, managed: bool, managedLayouts: Vec<ManagedLayout>, allocateFunctionId: int, storeReferenceFunctionId: int, collectFunctionId: int, hooks: Vec<ManagedHook>): Result<IRFunction, string> {
    var parameterValues: Vec<IRValue> = [];
    var parameterIndex = 0;
    loop {
        if parameterIndex >= plan.parameterTypes.len() { break; }
        parameterValues.push(irValue(parameterIndex, plan.parameterTypes[parameterIndex]));
        parameterIndex = parameterIndex + 1;
    }
    var lowerer = FunctionLowerer {
        checked: checked,
        bindingIndex: bindingIndex,
        managed: managed,
        managedLayouts: managedLayouts,
        allocateFunctionId: allocateFunctionId,
        storeReferenceFunctionId: storeReferenceFunctionId,
        collectFunctionId: collectFunctionId,
        hooks: hooks,
        expectedType: null,
        plan: plan,
        plans: plans,
        sourcePath: plan.sourcePath,
        moduleId: plan.moduleId,
        nextValueId: parameterValues.len(),
        currentBlockId: 0,
        currentParams: [],
        terminated: false,
        currentInstructions: [],
        blocks: [],
        scopes: [],
        loopTargets: [],
        globalSlots: activeGlobalSlots,
        globalGetFunctionId: activeGlobalGetId,
        globalSetFunctionId: activeGlobalSetId,
        error: emptyString,
    };
    reserveBlock(lowerer, []);
    pushScope(lowerer);
    var parameterIndex2 = 0;
    loop {
        if parameterIndex2 >= plan.declaration.params.len() { break; }
        var parameter: FuncParam = plan.declaration.params[parameterIndex2];
        bindLocal(lowerer, parameter.name, "parameter:" + parameterIndex2.toString(), false, plan.parameterLayouts[parameterIndex2], parameterValues[parameterIndex2]);
        parameterIndex2 = parameterIndex2 + 1;
    }
    if plan.sourcePath == checked.entryPath && plan.sourceName == litMain && lowerer.globalSlots.len() > 0 {
        emitGlobalSlab(lowerer);
        if lowerer.error != emptyString { return Result.Err(lowerer.error); }
        lowerGlobalInitializers(lowerer);
        if lowerer.error != emptyString { return Result.Err(lowerer.error); }
    }
    lowerStatements(lowerer, plan.declaration.body);
    if lowerer.error != emptyString { return Result.Err(lowerer.error); }
    if !lowerer.terminated {
        if plan.returnType.kind != IRTypeKind::Void {
            return Result.Err(lowerError(plan.sourcePath, plan.declaration.span.start, "non-void function has a path without a scalar return"));
        }
        finishBlock(lowerer, returnVoid(sourceRef(plan.sourcePath, plan.declaration.span.end, plan.declaration.span.end)));
    }
    var blockIndex = 0;
    loop {
        if blockIndex >= lowerer.blocks.len() { break; }
        var block = lowerer.blocks[blockIndex];
        if block.id != blockIndex {
            return Result.Err(lowerError(plan.sourcePath, plan.declaration.span.start, "internal lowering error: block IDs are not insertion ordered"));
        }
        blockIndex = blockIndex + 1;
    }
    var signature = functionSignature(plan.parameterTypes, plan.returnType);
    var function = irFunction(plan.id, functionKey(plan.moduleId, "", plan.sourceName), signature, parameterValues, lowerer.blocks, unknownEffectsFor(parameterValues.len()));
    return Result.Ok(function);
}

func planGlobalSlot(checked: CheckedProgram, bindingIndex: HashMap<string, Vec<int>>, catalog: ManagedCatalog, managed: bool, slotIndex: int, sourcePath: string, moduleId: string, statement: Stmt, name: string, initializer: Expr, span: Span, isConst: bool): Result<GlobalSlot, string> {
    var maybeBinding = bindingForDeclaration(checked, bindingIndex, sourcePath, moduleId, statement, name);
    if maybeBinding == null { return Result.Err(lowerError(sourcePath, span.start, "top-level value '" + name + "' has no checked binding")); }
    var binding = requiredCheckedBindingInfo(maybeBinding, checked.bindings[0]);
    var supported = binding.ty.kind == kindInt || binding.ty.kind == kindBool || binding.ty.kind == kindChar;
    if !supported && managed {
        supported = binding.ty.kind != kindFloat && binding.ty.kind != kindVoid && binding.ty.kind != kindFunction && binding.ty.kind != kindUnknown && binding.ty.kind != kindAny;
    }
    if !supported { return Result.Err(lowerError(sourcePath, span.start, "top-level value '" + name + "' has unsupported type " + binding.ty.kind)); }
    var layoutId = 0;
    if managed { layoutId = managedLayoutId(catalog.layouts, binding.ty); }
    return Result.Ok(GlobalSlot { moduleId: moduleId, name: name, sourcePath: sourcePath, isConst: isConst, slot: slotIndex, ty: binding.ty, layoutId: layoutId, initializer: initializer, span: span });
}

func emitGlobalSlab(lowerer: FunctionLowerer) {
    var source = sourceRef(lowerer.sourcePath, lowerer.plan.declaration.span.start, lowerer.plan.declaration.span.end);
    var syscallNumber = 197;
    var flags = 4114;
    if lowerTargetOS == "linux-x64" { syscallNumber = 9; flags = 50; }
    else if lowerTargetOS == "linux" || lowerTargetOS == "linux-arm64" { syscallNumber = 222; flags = 50; }
    else if lowerTargetOS == "darwin-x64" { syscallNumber = 33554629; }
    var number = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(number.id, syscallNumber, source));
    var address = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(address.id, globalSlabAddress, source));
    var size = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(size.id, activeGlobalBytes, source));
    var prot = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(prot.id, 3, source));
    var flagValue = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(flagValue.id, flags, source));
    var fd = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(fd.id, -1, source));
    var offset = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(offset.id, 0, source));
    var mapped = allocateValue(lowerer, ir.irRawAddress());
    var addressArg = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawFromInt(addressArg.id, address.id, source));
    var sizeArg = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawFromInt(sizeArg.id, size.id, source));
    var protArg = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawFromInt(protArg.id, prot.id, source));
    var flagsArg = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawFromInt(flagsArg.id, flagValue.id, source));
    var fdArg = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawFromInt(fdArg.id, fd.id, source));
    var offsetArg = allocateValue(lowerer, ir.irRawAddress());
    appendInstruction(lowerer, ir.rawFromInt(offsetArg.id, offset.id, source));
    var arguments: Vec<int> = [addressArg.id, sizeArg.id, protArg.id, flagsArg.id, fdArg.id, offsetArg.id];
    appendInstruction(lowerer, ir.rawSyscall(mapped.id, number.id, arguments, source));
    var mappedBits = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, ir.rawToInt(mappedBits.id, mapped.id, source));
    var matched = allocateValue(lowerer, irBool());
    appendInstruction(lowerer, compareI64(matched.id, ir.compareEq(), mappedBits.id, address.id, source));
    var okId = reserveBlock(lowerer, []);
    var badId = reserveBlock(lowerer, []);
    var noArgs: Vec<int> = [];
    finishBlock(lowerer, branch(matched.id, okId, noArgs, badId, noArgs, source));
    enterBlock(lowerer, badId, []);
    var trap = allocateValue(lowerer, irI64());
    appendInstruction(lowerer, constI64(trap.id, 2301, source));
    appendInstruction(lowerer, ir.rawFail(trap.id, source));
    finishBlock(lowerer, returnVoid(source));
    enterBlock(lowerer, okId, []);
}

func buildGlobalAccess(functionId: int, isStore: bool): IRFunction {
    var source = sourceRef("<rey-global>", 0, 0);
    var indexParameter = irValue(0, irI64());
    var parameters: Vec<IRValue> = [indexParameter];
    var parameterTypes: Vec<IRType> = [irI64()];
    var nextId = 1;
    var stored = irValue(-1, irI64());
    if isStore {
        stored = irValue(1, irI64());
        parameters.push(stored);
        parameterTypes.push(irI64());
        nextId = 2;
    }
    var addressConst = irValue(nextId, irI64());
    nextId = nextId + 1;
    var base = irValue(nextId, ir.irRawAddress());
    nextId = nextId + 1;
    var eight = irValue(nextId, irI64());
    nextId = nextId + 1;
    var scaled = irValue(nextId, irI64());
    nextId = nextId + 1;
    var header = irValue(nextId, irI64());
    nextId = nextId + 1;
    var byteOffset = irValue(nextId, irI64());
    nextId = nextId + 1;
    var slotAddress = irValue(nextId, ir.irRawAddress());
    nextId = nextId + 1;
    var instructions: Vec<Instruction> = [
        constI64(addressConst.id, globalSlabAddress, source),
        ir.rawFromInt(base.id, addressConst.id, source),
        constI64(eight.id, 8, source),
        mulCheckedI64(scaled.id, indexParameter.id, eight.id, source),
        constI64(header.id, 8, source),
        addCheckedI64(byteOffset.id, scaled.id, header.id, source),
        ir.rawOffset(slotAddress.id, base.id, byteOffset.id, source),
    ];
    var resultType = irVoid();
    var terminator = returnVoid(source);
    var name = litSet;
    if !isStore {
        name = litGet;
        var loaded = irValue(nextId, irI64());
        instructions.push(ir.rawLoadI64(loaded.id, slotAddress.id, source));
        terminator = returnValue(loaded.id, source);
        resultType = irI64();
    } else {
        instructions.push(ir.rawStoreI64(slotAddress.id, stored.id, source));
    }
    var block = basicBlock(0, [], instructions, terminator);
    return irFunction(functionId, functionKey("__rey_global", emptyString, name), functionSignature(parameterTypes, resultType), parameters, [block], unknownEffectsFor(parameters.len()));
}

func buildGlobalGet(functionId: int): IRFunction {
    return buildGlobalAccess(functionId, false);
}

func buildGlobalSet(functionId: int): IRFunction {
    return buildGlobalAccess(functionId, true);
}

func findBlockIndexById(function: IRFunction, blockId: int): int {
    var index = 0;
    loop {
        if index >= function.blocks.len() { break; }
        if function.blocks[index].id == blockId { return index; }
        index = index + 1;
    }
    return -1;
}

func pruneReachableBlocks(function: IRFunction): IRFunction {
    var blockCount = function.blocks.len();
    if blockCount == 0 { return function; }
    var reachable: Vec<int> = [];
    var index = 0;
    loop { if index >= blockCount { break; } reachable.push(0); index = index + 1; }
    reachable.set(0, 1);
    var work: Vec<int> = [0];
    loop {
        if work.len() == 0 { break; }
        var current = work.pop();
        var terminator = function.blocks[current].terminator;
        if terminator.kind == TerminatorKind::Jump {
            var target = findBlockIndexById(function, terminator.targetBlockId);
            if target >= 0 && reachable[target] == 0 { reachable.set(target, 1); work.push(target); }
        } else if terminator.kind == TerminatorKind::Branch {
            var trueTarget = findBlockIndexById(function, terminator.trueTargetBlockId);
            if trueTarget >= 0 && reachable[trueTarget] == 0 { reachable.set(trueTarget, 1); work.push(trueTarget); }
            var falseTarget = findBlockIndexById(function, terminator.falseTargetBlockId);
            if falseTarget >= 0 && reachable[falseTarget] == 0 { reachable.set(falseTarget, 1); work.push(falseTarget); }
        }
    }
    var reachableCount = 0;
    index = 0;
    loop { if index >= blockCount { break; } reachableCount = reachableCount + reachable[index]; index = index + 1; }
    if reachableCount == blockCount { return function; }
    var blocks: Vec<BasicBlock> = [];
    index = 0;
    loop { if index >= blockCount { break; } if reachable[index] != 0 { blocks.push(function.blocks[index]); } index = index + 1; }
    return IRFunction { id: function.id, key: function.key, signature: function.signature, parameters: function.parameters, blocks: blocks, effects: function.effects };
}

func lowerProgramCore(checked: CheckedProgram, managed: bool, catalog: ManagedCatalog): Result<LoweredCore, string> {
    if checked.units.len() == 0 {
        return Result.Err(lowerError(checked.entryPath, 0, "checked source graph contains no source units"));
    }
    buildExprIndex(checked);
    var bindingIndex = buildBindingIndex(checked);
    var plans: Vec<FunctionPlan> = [];
    var globalSlots: Vec<GlobalSlot> = [];
    var unitIndex = 0;
    loop {
        if unitIndex >= checked.units.len() { break; }
        var unit = checked.units[unitIndex];
        var statementIndex = 0;
        loop {
            if statementIndex >= unit.program.statements.len() { break; }
            var statement = unit.program.statements[statementIndex];
            match statement {
                Stmt::FuncDecl(declaration) => {
                    var isEntrySource = unit.sourcePath == checked.entryPath;
                    var maybePlan = preflightFunction(checked, unit.sourcePath, unit.moduleId, declaration, statementIndex, plans.len(), isEntrySource, managed, catalog.layouts);
                    if maybePlan.isErr() { return Result.Err(maybePlan.unwrapErr()); }
                    plans.push(maybePlan.unwrap());
                },
                Stmt::Import(_) => {},
                Stmt::VarDecl(declaration) => {
                    var planned = planGlobalSlot(checked, bindingIndex, catalog, managed, globalSlots.len(), unit.sourcePath, unit.moduleId, statement, declaration.name, declaration.value, declaration.span, false);
                    if planned.isErr() { return Result.Err(planned.unwrapErr()); }
                    globalSlots.push(planned.unwrap());
                },
                Stmt::ConstDecl(declaration) => {
                    var plannedConst = planGlobalSlot(checked, bindingIndex, catalog, managed, globalSlots.len(), unit.sourcePath, unit.moduleId, statement, declaration.name, declaration.value, declaration.span, true);
                    if plannedConst.isErr() { return Result.Err(plannedConst.unwrapErr()); }
                    globalSlots.push(plannedConst.unwrap());
                },
                Stmt::StructDecl(declaration) => {
                    if !managed { return Result.Err(lowerError(unit.sourcePath, declaration.span.start, "struct declarations are unsupported by scalar IR lowering")); }
                    if declaration.methods.len() > 0 { return Result.Err(lowerError(unit.sourcePath, declaration.span.start, "managed aggregate lowering does not support struct methods")); }
                },
                Stmt::EnumDecl(declaration) => {
                    if !managed { return Result.Err(lowerError(unit.sourcePath, declaration.span.start, "enum declarations are unsupported by scalar IR lowering")); }
                },
                _ => {
                    var mode = "scalar";
                    if managed { mode = "managed"; }
                    return Result.Err(lowerError(unit.sourcePath, stmtSpan(statement).start, "only top-level function declarations are supported by " + mode + " IR lowering"));
                },
            }
            statementIndex = statementIndex + 1;
        }
        unitIndex = unitIndex + 1;
    }
    if plans.len() == 0 {
        var family = "scalar";
        if managed { family = "managed"; }
        return Result.Err(lowerError(checked.entryPath, 0, "checked source graph contains no " + family + " functions"));
    }
    var entryFunctionId = -1;
    var planIndex = 0;
    loop {
        if planIndex >= plans.len() { break; }
        if plans[planIndex].sourcePath == checked.entryPath && plans[planIndex].sourceName == litMain {
            if entryFunctionId >= 0 {
                var family = "scalar";
                if managed { family = "managed"; }
                return Result.Err(lowerError(checked.entryPath, plans[planIndex].declaration.span.start, "multiple " + family + " entry functions named main"));
            }
            entryFunctionId = plans[planIndex].id;
        }
        planIndex = planIndex + 1;
    }
    if entryFunctionId < 0 {
        var family = "scalar";
        if managed { family = "managed"; }
        return Result.Err(lowerError(checked.entryPath, 0, "checked source graph has no " + family + " entry function main"));
    }

    var result = irProgram(entryFunctionId, []);
    var managedLayouts = catalog.layouts;
    var allocateFunctionId = -1;
    var storeReferenceFunctionId = -1;
    var collectFunctionId = -1;
    var hooks: Vec<ManagedHook> = [];
    if managed {
        allocateFunctionId = plans.len();
        storeReferenceFunctionId = plans.len() + 1;
        collectFunctionId = plans.len() + 2;
        hooks = buildManagedHooks(plans.len() + 3);
    }
    activeGlobalSlots = globalSlots;
    activeGlobalGetId = -1;
    activeGlobalSetId = -1;
    activeGlobalBytes = 0;
    if globalSlots.len() > 0 {
        var nextFunctionId = plans.len();
        if managed { nextFunctionId = plans.len() + 3 + hooks.len(); }
        activeGlobalGetId = nextFunctionId;
        activeGlobalSetId = nextFunctionId + 1;
        var rawBytes = (globalSlots.len() + 1) * 8;
        activeGlobalBytes = ((rawBytes + 4095) / 4096) * 4096;
    }
    var functionIndex = 0;
    loop {
        if functionIndex >= plans.len() { break; }
        var lowered = lowerFunction(checked, bindingIndex, plans[functionIndex], plans, managed, managedLayouts, allocateFunctionId, storeReferenceFunctionId, collectFunctionId, hooks);
        if lowered.isErr() { return Result.Err(lowered.unwrapErr()); }
        result = withFunction(result, pruneReachableBlocks(lowered.unwrap()));
        functionIndex = functionIndex + 1;
    }
    if managed {
        result = withFunction(result, managedAllocateStub(allocateFunctionId));
        result = withFunction(result, managedStoreReferenceStub(storeReferenceFunctionId));
        result = withFunction(result, managedCollectStub(collectFunctionId));
        var hookIndex = 0;
        loop { if hookIndex >= hooks.len() { break; } result = withFunction(result, managedHookStub(hooks[hookIndex])); hookIndex = hookIndex + 1; }
    }
    if activeGlobalGetId >= 0 {
        result = withFunction(result, buildGlobalGet(activeGlobalGetId));
        result = withFunction(result, buildGlobalSet(activeGlobalSetId));
    }
    return Result.Ok(LoweredCore { program: result, plans: plans, allocateFunctionId: allocateFunctionId, storeReferenceFunctionId: storeReferenceFunctionId, collectFunctionId: collectFunctionId, variableLayouts: catalog.variableLayouts, hooks: hooks });
}

func managedAllocateStub(functionId: int): IRFunction {
    var source = sourceRef("<managed-private>", 0, 0);
    var parameter = irValue(0, irI64());
    var trapCode = irValue(1, irI64());
    var result = irValue(2, ir.irRawAddress());
    var instructions: Vec<Instruction> = [constI64(trapCode.id, 2299, source), ir.rawFail(trapCode.id, source), ir.rawNull(result.id, source)];
    var block = basicBlock(0, [], instructions, returnValue(result.id, source));
    return irFunction(functionId, functionKey("__rey_managed_private", "", "allocate"), functionSignature([irI64()], ir.irRawAddress()), [parameter], [block], unknownEffectsFor(1));
}

func managedStoreReferenceStub(functionId: int): IRFunction {
    var source = sourceRef("<managed-private>", 0, 0);
    var owner = irValue(0, ir.irRawAddress());
    var offset = irValue(1, irI64());
    var value = irValue(2, ir.irRawAddress());
    var trapCode = irValue(3, irI64());
    var instructions: Vec<Instruction> = [constI64(trapCode.id, 2299, source), ir.rawFail(trapCode.id, source)];
    var block = basicBlock(0, [], instructions, returnVoid(source));
    return irFunction(functionId, functionKey("__rey_managed_private", "", "storeReference"), functionSignature([ir.irRawAddress(), irI64(), ir.irRawAddress()], irVoid()), [owner, offset, value], [block], unknownEffectsFor(3));
}

func managedCollectStub(functionId: int): IRFunction {
    var source = sourceRef("<managed-private>", 0, 0);
    var trapCode = irValue(0, irI64());
    var instructions: Vec<Instruction> = [constI64(trapCode.id, 2299, source), ir.rawFail(trapCode.id, source)];
    var block = basicBlock(0, [], instructions, returnVoid(source));
    return irFunction(functionId, functionKey("__rey_managed_private", "", "collect"), functionSignature([], irVoid()), [], [block], unknownEffectsFor(0));
}

func managedHookNames(): Vec<string> {
    var names: Vec<string> = [
        "managedAllocateSized",
        "managedStringLength", "managedStringByte", "managedStringEqual", "managedStringCompare", "managedStringHash",
        "managedStringConcat", "managedStringSlice", "managedStringFromInt", "managedStringToInt", "managedStringContains",
        "managedStringIndexOf", "managedStringStartsWith", "managedStringEndsWith", "managedStringCase", "managedStringTrim",
        "managedStringRepeat", "managedStringReplace", "managedStringPad", "managedWriteString",
        "managedArgsCreate", "managedExit", "managedFileExists", "managedDeleteFile", "managedWriteFile", "managedAppendFile",
        "managedReadFile", "managedListDir", "managedVecCreate", "managedVecJoin", "managedVecLength", "managedVecCapacity", "managedVecGetI64", "managedVecGetReference",
        "managedVecSetI64", "managedVecSetReference", "managedVecPushI64", "managedVecPushReference", "managedVecPopI64",
        "managedVecPopReference", "managedVecContainsI64", "managedVecContainsReference", "managedVecContainsString", "managedVecTruncate",
        "managedMapCreate", "managedMapLength", "managedMapHas", "managedMapKeys", "managedMapGetI64", "managedMapGetReference",
        "managedMapSetI64", "managedMapSetReference", "managedMapDelete",
    ];
    if trustedPackedOutput { names.push(litManagedWriteBytes); names.push(litManagedWritePackedSegments); }
    return names;
}

func managedHookCollects(name: string): bool {
    return name == litManagedAllocateSized || name == litManagedStringConcat || name == litManagedStringSlice || name == litManagedStringFromInt || name == litManagedStringCase || name == litManagedStringTrim || name == litManagedStringRepeat || name == litManagedStringReplace || name == litManagedStringPad || name == litManagedVecCreate || name == litManagedVecPushI64 || name == litManagedVecPushReference || name == litManagedMapCreate || name == litManagedMapKeys || name == litManagedMapSetI64 || name == litManagedMapSetReference;
}

func buildManagedHooks(firstId: int): Vec<ManagedHook> {
    var hooks: Vec<ManagedHook> = [];
    var names = managedHookNames();
    var index = 0;
    loop { if index >= names.len() { break; } hooks.push(ManagedHook { functionId: firstId + hooks.len(), runtimeName: names[index], mayCollect: managedHookCollects(names[index]) }); index = index + 1; }
    return hooks;
}

func managedHookId(hooks: Vec<ManagedHook>, name: string): int {
    var index = 0;
    loop { if index >= hooks.len() { break; } if hooks[index].runtimeName == name { return hooks[index].functionId; } index = index + 1; }
    return -1;
}

func managedHookParameters(name: string): Vec<IRType> {
    var raw = ir.irRawAddress();
    if name == litManagedAllocateSized { return [irI64(), irI64()]; }
    if name == litManagedStringLength || name == litManagedStringToInt || name == litManagedStringHash { return [raw]; }
    if name == litManagedStringByte || name == litManagedVecGetI64 || name == litManagedVecGetReference { return [raw, irI64()]; }
    if name == litManagedVecPopI64 || name == litManagedVecPopReference || name == litManagedVecLength || name == litManagedVecCapacity || name == litManagedMapLength { return [raw]; }
    if name == litManagedStringEqual || name == litManagedStringCompare || name == litManagedStringContains || name == litManagedStringIndexOf || name == litManagedStringStartsWith || name == litManagedStringEndsWith || name == litManagedMapHas || name == litManagedMapGetI64 || name == litManagedMapGetReference || name == litManagedMapDelete { return [raw, raw]; }
    if name == litManagedStringConcat { return [irI64(), raw, raw]; }
    if name == litManagedVecJoin { return [raw, raw, irI64()]; }
    if name == litManagedStringSlice { return [irI64(), raw, irI64(), irI64()]; }
    if name == litManagedStringFromInt { return [irI64(), irI64()]; }
    if name == litManagedStringCase { return [irI64(), raw, irBool()]; }
    if name == litManagedStringTrim { return [irI64(), raw]; }
    if name == litManagedStringRepeat { return [irI64(), raw, irI64()]; }
    if name == litManagedStringReplace { return [irI64(), raw, raw, raw]; }
    if name == litManagedStringPad { return [irI64(), raw, irI64(), raw, irBool()]; }
    if name == litManagedWriteString { return [raw, irI64()]; }
    if name == litManagedWriteBytes { return [raw, raw, irI64()]; }
    if name == litManagedWritePackedSegments { return [raw, raw, raw, irI64(), irI64()]; }
    if name == litManagedArgsCreate { return [irI64(), irI64(), irI64()]; }
    if name == litManagedExit { return [irI64()]; }
    if name == litManagedFileExists || name == litManagedDeleteFile { return [raw]; }
    if name == litManagedWriteFile || name == litManagedAppendFile { return [raw, raw]; }
    if name == litManagedReadFile { return [raw, irI64()]; }
    if name == litManagedListDir { return [raw, irI64(), irI64(), irI64()]; }
    if name == litManagedVecCreate { return [irI64(), irI64(), irI64()]; }
    if name == litManagedVecContainsI64 { return [raw, irI64()]; }
    if name == litManagedVecContainsReference || name == litManagedVecContainsString { return [raw, raw]; }
    if name == litManagedVecSetI64 || name == litManagedVecPushI64 { return [raw, irI64(), irI64()]; }
    if name == litManagedVecSetReference || name == litManagedVecPushReference { return [raw, irI64(), raw]; }
    if name == litManagedVecTruncate { return [raw, irI64()]; }
    if name == litManagedMapCreate { return [irI64(), irI64()]; }
    if name == litManagedMapSetI64 { return [raw, irI64(), raw, irI64()]; }
    if name == litManagedMapSetReference { return [raw, irI64(), raw, raw]; }
    if name == litManagedMapKeys { return [raw, irI64(), irI64()]; }
    return [];
}

func managedHookResult(name: string): IRType {
    if name == litManagedAllocateSized || name == litManagedStringConcat || name == litManagedStringSlice || name == litManagedStringFromInt || name == litManagedStringCase || name == litManagedStringTrim || name == litManagedStringRepeat || name == litManagedStringReplace || name == litManagedStringPad || name == litManagedArgsCreate || name == litManagedReadFile || name == litManagedListDir || name == litManagedVecCreate || name == litManagedVecJoin || name == litManagedVecGetReference || name == litManagedVecPopReference || name == litManagedMapCreate || name == litManagedMapKeys || name == litManagedMapGetReference { return ir.irRawAddress(); }
    if name == litManagedVecSetI64 || name == litManagedVecSetReference || name == litManagedVecPushI64 || name == litManagedVecPushReference || name == litManagedVecTruncate || name == litManagedMapSetI64 || name == litManagedMapSetReference { return irVoid(); }
    if name == litManagedStringEqual || name == litManagedStringContains || name == litManagedStringStartsWith || name == litManagedStringEndsWith || name == litManagedFileExists || name == litManagedMapHas || name == litManagedMapDelete || name == litManagedVecContainsI64 || name == litManagedVecContainsReference || name == litManagedVecContainsString || name == litManagedWriteBytes || name == litManagedWritePackedSegments { return irBool(); }
    if name == litManagedStringLength || name == litManagedStringByte || name == litManagedStringCompare || name == litManagedStringHash || name == litManagedStringIndexOf || name == litManagedStringToInt || name == litManagedVecLength || name == litManagedVecCapacity || name == litManagedVecGetI64 || name == litManagedVecPopI64 || name == litManagedMapLength || name == litManagedMapGetI64 { return irI64(); }
    return irVoid();
}

func managedHookStub(hook: ManagedHook): IRFunction {
    var source = sourceRef("<managed-private>", 0, 0);
    var parameterTypes = managedHookParameters(hook.runtimeName);
    var parameters: Vec<IRValue> = [];
    var index = 0;
    loop { if index >= parameterTypes.len() { break; } parameters.push(irValue(index, parameterTypes[index])); index = index + 1; }
    var resultType = managedHookResult(hook.runtimeName);
    var instructions: Vec<Instruction> = [];
    var trapCode = irValue(parameters.len(), irI64());
    instructions.push(constI64(trapCode.id, 2299, source));
    instructions.push(ir.rawFail(trapCode.id, source));
    var terminator = returnVoid(source);
    if resultType.kind == IRTypeKind::RawAddress {
        var result = irValue(parameters.len() + 1, resultType);
        instructions.push(ir.rawNull(result.id, source));
        terminator = returnValue(result.id, source);
    } else if resultType.kind == IRTypeKind::I64 {
        var resultI64 = irValue(parameters.len() + 1, resultType);
        instructions.push(constI64(resultI64.id, 0, source));
        terminator = returnValue(resultI64.id, source);
    } else if resultType.kind == IRTypeKind::Bool {
        var resultBool = irValue(parameters.len() + 1, resultType);
        instructions.push(constBool(resultBool.id, false, source));
        terminator = returnValue(resultBool.id, source);
    }
    var block = basicBlock(0, [], instructions, terminator);
    return irFunction(hook.functionId, functionKey("__rey_managed_hook", "", hook.runtimeName), functionSignature(parameterTypes, resultType), parameters, [block], unknownEffectsFor(parameters.len()));
}

func containsManagedValue(values: Vec<int>, valueId: int): bool {
    var index = 0;
    loop { if index >= values.len() { break; } if values[index] == valueId { return true; } index = index + 1; }
    return false;
}

func appendReferenceValue(values: Vec<int>, value: IRValue) {
    if value.ty.kind == IRTypeKind::RawAddress && !containsManagedValue(values, value.id) { values.push(value.id); }
}

func findConstantI64(function: IRFunction, valueId: int): int {
    var blockIndex = 0;
    loop {
        if blockIndex >= function.blocks.len() { break; }
        var block = function.blocks[blockIndex];
        var instructionIndex = 0;
        loop {
            if instructionIndex >= block.instructions.len() { break; }
            var instruction = block.instructions[instructionIndex];
            if instruction.resultId == valueId && instruction.kind == InstructionKind::ConstI64 { return instruction.immediate; }
            instructionIndex = instructionIndex + 1;
        }
        blockIndex = blockIndex + 1;
    }
    return -1;
}

func managedFunctionMetadata(function: IRFunction, plan: FunctionPlan): ManagedFunction {
    var references: Vec<int> = [];
    var parameterIndex = 0;
    loop { if parameterIndex >= function.parameters.len() { break; } appendReferenceValue(references, function.parameters[parameterIndex]); parameterIndex = parameterIndex + 1; }
    var blockIndex = 0;
    loop {
        if blockIndex >= function.blocks.len() { break; }
        var block = function.blocks[blockIndex];
        var paramIndex = 0;
        loop { if paramIndex >= block.params.len() { break; } appendReferenceValue(references, block.params[paramIndex]); paramIndex = paramIndex + 1; }
        var instructionIndex = 0;
        loop {
            if instructionIndex >= block.instructions.len() { break; }
            var instruction = block.instructions[instructionIndex];
            if instruction.resultId >= 0 && instruction.ty.kind == IRTypeKind::RawAddress && instruction.kind != InstructionKind::RawOffset {
                var value = irValue(instruction.resultId, instruction.ty);
                appendReferenceValue(references, value);
            }
            instructionIndex = instructionIndex + 1;
        }
        blockIndex = blockIndex + 1;
    }
    return ManagedFunction { functionId: function.id, referenceValues: references, parameterLayouts: plan.parameterLayouts, returnLayout: plan.returnLayout };
}

func collectManagedAnnotations(program: IRProgram, plans: Vec<FunctionPlan>, allocateFunctionId: int): Result<ManagedAnnotations, string> {
    var functions: Vec<ManagedFunction> = [];
    var allocations: Vec<ManagedAllocation> = [];
    var derived: Vec<ManagedDerived> = [];
    var functionIndices: HashMap<string, int> = HashMap.new();
    var programIndex = 0;
    loop {
        if programIndex >= program.functions.len() { break; }
        var key = program.functions[programIndex].id.toString();
        if !functionIndices.has(key) { functionIndices.set(key, programIndex); }
        programIndex = programIndex + 1;
    }
    var functionIndex = 0;
    loop {
        if functionIndex >= plans.len() { break; }
        var plan = plans[functionIndex];
        var key = plan.id.toString();
        if !functionIndices.has(key) { return Result.Err("managed lowering lost a source function while collecting metadata"); }
        var function = program.functions[functionIndices.get(key)];
        functions.push(managedFunctionMetadata(function, plan));
        var blockIndex = 0;
        loop {
            if blockIndex >= function.blocks.len() { break; }
            var block = function.blocks[blockIndex];
            var instructionIndex = 0;
            loop {
                if instructionIndex >= block.instructions.len() { break; }
                var instruction = block.instructions[instructionIndex];
                if instruction.kind == InstructionKind::RawOffset && instruction.resultId >= 0 && instruction.operands.len() == 2 {
                    derived.push(ManagedDerived { functionId: function.id, valueId: instruction.resultId, ownerId: instruction.operands[0] });
                } else if instruction.kind == InstructionKind::Call && instruction.functionId == allocateFunctionId && instruction.resultId >= 0 && instruction.operands.len() == 1 {
                    var layoutId = findConstantI64(function, instruction.operands[0]);
                    if layoutId <= 0 { return Result.Err("managed allocation hook call has no constant positive layout ID"); }
                    allocations.push(ManagedAllocation { functionId: function.id, blockId: block.id, resultId: instruction.resultId, layoutId: layoutId });
                }
                instructionIndex = instructionIndex + 1;
            }
            blockIndex = blockIndex + 1;
        }
        functionIndex = functionIndex + 1;
    }
    return Result.Ok(ManagedAnnotations { functions: functions, allocations: allocations, derived: derived });
}

pub func lowerProgram(checked: CheckedProgram): Result<IRProgram, string> {
    beginLayoutCache();
    var emptyCatalog = ManagedCatalog { layouts: [], variableLayouts: [], error: emptyString };
    var core = lowerProgramCore(checked, false, emptyCatalog);
    finishLayoutCache();
    if core.isErr() { return Result.Err(core.unwrapErr()); }
    return Result.Ok(core.unwrap().program);
}

pub func lowerManagedProgram(checked: CheckedProgram): Result<ManagedProgram, string> {
    beginLayoutCache();
    var layoutsResult = buildManagedLayouts(checked);
    finishLayoutCache();
    if layoutsResult.isErr() { return Result.Err(layoutsResult.unwrapErr()); }
    var catalog = layoutsResult.unwrap();
    var coreResult = lowerProgramCore(checked, true, catalog);
    if coreResult.isErr() { return Result.Err(coreResult.unwrapErr()); }
    var core = coreResult.unwrap();
    var annotationResult = collectManagedAnnotations(core.program, core.plans, core.allocateFunctionId);
    if annotationResult.isErr() { return Result.Err(annotationResult.unwrapErr()); }
    var annotations = annotationResult.unwrap();
    return Result.Ok(ManagedProgram {
        program: core.program,
        layouts: catalog.layouts,
        functions: annotations.functions,
        allocations: annotations.allocations,
        derived: annotations.derived,
        allocateFunctionId: core.allocateFunctionId,
        storeReferenceFunctionId: core.storeReferenceFunctionId,
        collectFunctionId: core.collectFunctionId,
        variableLayouts: core.variableLayouts,
        hooks: core.hooks,
    });
}
