// Lower checked scalar source and the opt-in managed aggregate slice to SSA IR.
import ir;
import ir::{IRProgram, IRFunction, IRType, IRTypeKind, IRValue, SourceRef, EffectSummary, Escape, BasicBlock, Instruction, InstructionKind, Terminator, TerminatorKind, irProgram, irFunction, irValue, irI64, irBool, irVoid, functionKey, functionSignature, effectSummary, factUnknown, escapeUnknown, sourceRef, constI64, constBool, addCheckedI64, subCheckedI64, mulCheckedI64, divCheckedI64, remCheckedI64, compareI64, compareBool, call, jump, branch, returnValue, returnVoid, basicBlock, withFunction};
import ir::managed::{ManagedField, ManagedLayout, ManagedVariableLayout, ManagedHook, ManagedFunction, ManagedAllocation, ManagedDerived, ManagedProgram};
import typecheck::{CheckedProgram, CheckedExprInfo, CheckedBindingInfo, CheckedFieldInitInfo, CheckedNominalLayout, ResolvedSymbol, Type};
import parser::ast::{Program, Stmt, Expr, FuncDeclStmt, FuncParam, VarDeclStmt, ConstDeclStmt, AssignStmt, IfStmt, WhileStmt, ForStmt, LoopStmt, ReturnStmt, BlockStmt, ExprStmt, BinaryExpr, UnaryExpr, Literal, LiteralExpr, IdentExpr, CallExpr, FieldAccessExpr, StructLiteralExpr, StructInitField, EnumVariantExpr, TupleExpr, ArrayExpr, DictExpr, DictEntry, IndexExpr, MatchStmt, MatchStmtArm, Pattern, WildcardPattern, VariablePattern, LiteralPattern, EnumVariantPattern, StructPattern, RangePattern, OrPattern, PatternField, LiteralKind, StmtKind, ExprKind, PatternKind, stmtSpan, exprSpan, patternSpan};
import lexer::{Span};

struct FunctionPlan {
    pub id: int,
    pub sourcePath: string,
    pub moduleId: string,
    pub sourceName: string,
    pub declarationIndex: int,
    pub declaration: FuncDeclStmt,
    pub symbol: ResolvedSymbol,
    pub parameterTypes: Vec<IRType>,
    pub parameterLayouts: Vec<int>,
    pub returnType: IRType,
    pub returnLayout: int,
}

struct LoweredCore {
    pub program: IRProgram,
    pub plans: Vec<FunctionPlan>,
    pub allocateFunctionId: int,
    pub storeReferenceFunctionId: int,
    pub collectFunctionId: int,
    pub variableLayouts: Vec<ManagedVariableLayout>,
    pub hooks: Vec<ManagedHook>,
}

struct ManagedCatalog {
    pub layouts: Vec<ManagedLayout>,
    pub variableLayouts: Vec<ManagedVariableLayout>,
    pub error: string,
}

struct ManagedAnnotations {
    pub functions: Vec<ManagedFunction>,
    pub allocations: Vec<ManagedAllocation>,
    pub derived: Vec<ManagedDerived>,
}

struct LocalBinding {
    pub name: string,
    pub identity: string,
    pub isConst: bool,
    pub layoutId: int,
    pub value: IRValue,
}

struct LocalScope {
    pub bindings: Vec<LocalBinding>,
}

struct LowerValue {
    pub id: int,
    pub ty: IRType,
}

var emptyString: string = "";
var kindVoid: string = "Void";
var kindBool: string = "Bool";
var kindInt: string = "Int";
var kindUnknown: string = "Unknown";
var kindRawAddress: string = "RawAddress";
var sharedTypeParams: Vec<Type> = [];
var sharedUnknownType: Type = Type { kind: kindUnknown, name: emptyString, sourcePath: emptyString, moduleId: emptyString, inner: null, key: null, value: null, params: sharedTypeParams, ret: null };

func managedUnknownType(): Type {
    return sharedUnknownType;
}

func requiredType(value: Type?, fallback: Type): Type {
    if value != null { return value; }
    return fallback;
}

func requiredCheckedExprInfo(value: CheckedExprInfo?, fallback: CheckedExprInfo): CheckedExprInfo {
    if value != null { return value; }
    return fallback;
}

func requiredCheckedBindingInfo(value: CheckedBindingInfo?, fallback: CheckedBindingInfo): CheckedBindingInfo {
    if value != null { return value; }
    return fallback;
}

func requiredCheckedFieldInitInfo(value: CheckedFieldInitInfo?, fallback: CheckedFieldInitInfo): CheckedFieldInitInfo {
    if value != null { return value; }
    return fallback;
}

func requiredNominalLayout(value: CheckedNominalLayout?, fallback: CheckedNominalLayout): CheckedNominalLayout {
    if value != null { return value; }
    return fallback;
}

func requiredManagedLayout(value: ManagedLayout?, fallback: ManagedLayout): ManagedLayout {
    if value != null { return value; }
    return fallback;
}

func requiredManagedField(value: ManagedField?, fallback: ManagedField): ManagedField {
    if value != null { return value; }
    return fallback;
}

func requiredResolvedSymbol(value: ResolvedSymbol?, fallback: ResolvedSymbol): ResolvedSymbol {
    if value != null { return value; }
    return fallback;
}

func requiredIRValue(value: IRValue?, fallback: IRValue): IRValue {
    if value != null { return value; }
    return fallback;
}

func requiredFieldAccess(value: FieldAccessExpr?, fallback: FieldAccessExpr): FieldAccessExpr {
    if value != null { return value; }
    return fallback;
}

func fallbackFieldAccess(expression: Expr): FieldAccessExpr {
    return FieldAccessExpr { object: expression, name: emptyString, span: exprSpan(expression) };
}

struct LocalLocation {
    pub found: bool,
    pub scopeIndex: int,
    pub bindingIndex: int,
    pub binding: LocalBinding,
}

struct BlockEnvironment {
    pub scopes: Vec<LocalScope>,
    pub params: Vec<IRValue>,
    pub args: Vec<int>,
    pub bindingKeys: Vec<string>,
}

struct LoopTarget {
    pub headerBlockId: int,
    pub exitBlockId: int,
    pub continueBlockId: int,
    pub bindingKeys: Vec<string>,
    pub exitKeys: Vec<string>,
}

struct ExprSpanEntry {
    pub spanStart: int,
    pub spanEnd: int,
    pub kindCode: int,
    pub nodeId: int,
    pub infoIndex: int,
}

struct ExprFileRange {
    pub path: string,
    pub start: int,
    pub count: int,
}

struct CachedTupleKey {
    pub parts: Vec<string>,
    pub cached: string,
}

struct GlobalSlot {
    pub moduleId: string,
    pub name: string,
    pub sourcePath: string,
    pub isConst: bool,
    pub slot: int,
    pub ty: Type,
    pub layoutId: int,
    pub initializer: Expr,
    pub span: Span,
}

struct RangeCall {
    pub found: bool,
    pub start: Expr,
    pub end: Expr,
}

struct FunctionLowerer {
    pub checked: CheckedProgram,
    pub bindingIndex: HashMap<string, Vec<int>>,
    pub managed: bool,
    pub managedLayouts: Vec<ManagedLayout>,
    pub allocateFunctionId: int,
    pub storeReferenceFunctionId: int,
    pub collectFunctionId: int,
    pub hooks: Vec<ManagedHook>,
    pub expectedType: Type?,
    pub plan: FunctionPlan,
    pub plans: Vec<FunctionPlan>,
    pub sourcePath: string,
    pub moduleId: string,
    pub nextValueId: int,
    pub currentBlockId: int,
    pub currentParams: Vec<IRValue>,
    pub terminated: bool,
    pub currentInstructions: Vec<Instruction>,
    pub blocks: Vec<BasicBlock>,
    pub scopes: Vec<LocalScope>,
    pub loopTargets: Vec<LoopTarget>,
    pub globalSlots: Vec<GlobalSlot>,
    pub globalGetFunctionId: int,
    pub globalSetFunctionId: int,
    pub error: string,
}

func lowerError(path: string, offset: int, message: string): string {
    return path + ":" + offset.toString() + ": " + message;
}

func spanRef(path: string, span: Span): SourceRef {
    return sourceRef(path, span.start, span.end);
}

func checkedTypeIsValue(ty: Type): bool {
    return ty.kind == kindInt || ty.kind == kindBool || ty.kind == kindRawAddress;
}

func checkedTypeIsSupported(ty: Type): bool {
    return checkedTypeIsValue(ty) || ty.kind == kindVoid;
}

