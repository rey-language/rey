import ir::{IRProgram, IRType, IRTypeKind, IRFunction, BasicBlock, Instruction, InstructionKind, Terminator, TerminatorKind, IRValue, SourceRef, CompareI64Predicate, irVoid, functionKeyName};

struct ValueDef {
    pub id: int,
    pub ty: IRType,
    pub blockIndex: int,
    pub instructionIndex: int,
}

struct DefinitionTable {
    pub definitions: Vec<ValueDef>,
    pub denseIndices: Vec<int>,
    pub sparseIndices: HashMap<string, int>,
    pub usesDenseIndices: bool,
}

struct DominatorTraversal {
    pub reversePostorder: Vec<int>,
    pub order: Vec<int>,
    pub parent: Vec<int>,
}

pub struct VerifyResult {
    pub ok: bool,
    pub errors: Vec<string>,
}

func sameType(left: IRType, right: IRType): bool {
    return left.kind == right.kind;
}

func validSource(source: SourceRef): bool {
    return source.unitId != "" && source.start >= 0 && source.end >= source.start;
}

func findFunctionIndex(program: IRProgram, functionId: int): int {
    var i = 0;
    loop {
        if i >= program.functions.len() { break; }
        if program.functions[i].id == functionId { return i; }
        i = i + 1;
    }
    return -1;
}

func findBlockIndex(indices: HashMap<string, int>, blockId: int): int {
    var key = blockId.toString();
    if indices.has(key) { return indices.get(key); }
    return -1;
}

func buildDefinitionTable(definitions: Vec<ValueDef>, indices: HashMap<string, int>): DefinitionTable {
    var maximumId = -1;
    var index = 0;
    loop {
        if index >= definitions.len() { break; }
        if definitions[index].id > maximumId { maximumId = definitions[index].id; }
        index = index + 1;
    }
    if maximumId >= 0 && maximumId <= 1000000 && maximumId <= definitions.len() * 4 + 1024 {
        var denseIndices: Vec<int> = [];
        index = 0;
        loop {
            if index > maximumId { break; }
            denseIndices.push(-1);
            index = index + 1;
        }
        index = 0;
        loop {
            if index >= definitions.len() { break; }
            var definitionId = definitions[index].id;
            if denseIndices[definitionId] < 0 { denseIndices.set(definitionId, index); }
            index = index + 1;
        }
        return DefinitionTable { definitions: definitions, denseIndices: denseIndices, sparseIndices: HashMap.new(), usesDenseIndices: true };
    }
    return DefinitionTable { definitions: definitions, denseIndices: [], sparseIndices: indices, usesDenseIndices: false };
}

func findDefinition(table: DefinitionTable, valueId: int): ValueDef {
    if table.usesDenseIndices {
        if valueId >= 0 && valueId < table.denseIndices.len() {
            var definitionIndex = table.denseIndices[valueId];
            if definitionIndex >= 0 { return table.definitions[definitionIndex]; }
        }
        return ValueDef { id: -1, ty: irVoid(), blockIndex: -1, instructionIndex: -1 };
    }
    var key = valueId.toString();
    if table.sparseIndices.has(key) { return table.definitions[table.sparseIndices.get(key)]; }
    return ValueDef { id: -1, ty: irVoid(), blockIndex: -1, instructionIndex: -1 };
}

func checkSource(errors: Vec<string>, source: SourceRef, context: string): void {
    if !validSource(source) {
        errors.push(context + ": invalid source span");
    }
}

func checkUse(errors: Vec<string>, table: DefinitionTable, valueId: int, useBlockIndex: int, useInstructionIndex: int, dominance: Vec<int>, blockCount: int, context: string): void {
    if valueId < 0 {
        errors.push(context + ": invalid negative SSA operand");
        return;
    }
    var definition = findDefinition(table, valueId);
    if definition.id < 0 {
        errors.push(context + ": undefined SSA value %v" + valueId.toString());
        return;
    }
    if definition.ty.kind == IRTypeKind::Void {
        errors.push(context + ": void cannot be used as an SSA operand");
    }
    if definition.blockIndex < 0 { return; }
    if definition.blockIndex == useBlockIndex {
        if definition.instructionIndex >= 0 && definition.instructionIndex >= useInstructionIndex {
            errors.push(context + ": SSA value %v" + valueId.toString() + " is used before its definition");
        }
        return;
    }
    var definitionIndex = definition.blockIndex * 2;
    var useIndex = useBlockIndex * 2;
    if definitionIndex < 0 || useIndex < 0 || definitionIndex + 1 >= dominance.len() || useIndex + 1 >= dominance.len() {
        errors.push(context + ": definition of %v" + valueId.toString() + " does not dominate this use");
        return;
    }
    var definitionStart = dominance[definitionIndex];
    var useStart = dominance[useIndex];
    var definitionEnd = dominance[definitionIndex + 1];
    var useEnd = dominance[useIndex + 1];
    if definitionStart < 0 || useStart < 0 || definitionStart > useStart || useEnd > definitionEnd {
        errors.push(context + ": definition of %v" + valueId.toString() + " does not dominate this use");
    }
}

func appendGraphEdge(graph: Vec<Vec<int>>, source: int, target: int): void {
    var neighbors = graph[source];
    neighbors.push(target);
    graph.set(source, neighbors);
}

func computeReversePostorder(successors: Vec<Vec<int>>, blockCount: int): DominatorTraversal {
    var postorder: Vec<int> = [];
    var visited: Vec<int> = [];
    var iterator: Vec<int> = [];
    var parent: Vec<int> = [];
    var order: Vec<int> = [];
    var index = 0;
    loop {
        if index >= blockCount { break; }
        visited.push(0);
        iterator.push(0);
        parent.push(-1);
        index = index + 1;
    }
    var stack: Vec<int> = [];
    if blockCount > 0 {
        visited.set(0, 1);
        stack.push(0);
        order.push(0);
    }
    loop {
        if stack.len() == 0 { break; }
        var node = stack[stack.len() - 1];
        var next = iterator[node];
        var found = -1;
        var neighbors = successors[node];
        loop {
            if next >= neighbors.len() { break; }
            var candidate = neighbors[next];
            next = next + 1;
            if visited[candidate] == 0 { found = candidate; break; }
        }
        iterator.set(node, next);
        if found < 0 {
            postorder.push(node);
            stack.pop();
        } else {
            visited.set(found, 1);
            parent.set(found, node);
            order.push(found);
            stack.push(found);
        }
    }
    var rpo: Vec<int> = [];
    var postIndex = postorder.len();
    loop {
        if postIndex <= 0 { break; }
        postIndex = postIndex - 1;
        rpo.push(postorder[postIndex]);
    }
    return DominatorTraversal { reversePostorder: rpo, order: order, parent: parent };
}

func intersectDominators(left: int, right: int, idom: Vec<int>, rpoNumber: Vec<int>): int {
    var first = left;
    var second = right;
    loop {
        if first == second { return first; }
        loop {
            if rpoNumber[first] <= rpoNumber[second] { break; }
            first = idom[first];
        }
        loop {
            if rpoNumber[second] <= rpoNumber[first] { break; }
            second = idom[second];
        }
    }
    return 0;
}

func evalDominator(value: int, semi: Vec<int>, ancestor: Vec<int>, label: Vec<int>): int {
    var path: Vec<int> = [];
    var current = value;
    loop {
        var parent = ancestor[current];
        if parent < 0 || ancestor[parent] < 0 { break; }
        path.push(current);
        current = parent;
    }
    loop {
        if path.len() == 0 { break; }
        var node = path.pop();
        var parent = ancestor[node];
        var grandparent = ancestor[parent];
        if semi[label[parent]] < semi[label[node]] { label.set(node, label[parent]); }
        ancestor.set(node, grandparent);
    }
    return label[value];
}

func computeImmediateDominators(predecessors: Vec<Vec<int>>, blockCount: int, traversal: DominatorTraversal): Vec<int> {
    var idom: Vec<int> = [];
    var semi: Vec<int> = [];
    var ancestor: Vec<int> = [];
    var label: Vec<int> = [];
    var bucket: Vec<Vec<int>> = [];
    var index = 0;
    loop {
        if index >= blockCount { break; }
        idom.push(-1);
        semi.push(-1);
        ancestor.push(-1);
        label.push(index);
        bucket.push([]);
        index = index + 1;
    }
    if traversal.order.len() == 0 { return idom; }
    var orderIndex = 0;
    loop {
        if orderIndex >= traversal.order.len() { break; }
        semi.set(traversal.order[orderIndex], orderIndex);
        label.set(traversal.order[orderIndex], traversal.order[orderIndex]);
        orderIndex = orderIndex + 1;
    }
    var root = traversal.order[0];
    idom.set(root, root);
    orderIndex = traversal.order.len() - 1;
    loop {
        if orderIndex <= 0 { break; }
        var block = traversal.order[orderIndex];
        var semidominator = semi[block];
        var predecessorIndex = 0;
        var blockPredecessors = predecessors[block];
        loop {
            if predecessorIndex >= blockPredecessors.len() { break; }
            var predecessor = blockPredecessors[predecessorIndex];
            if semi[predecessor] >= 0 {
                var candidate = evalDominator(predecessor, semi, ancestor, label);
                if semi[candidate] < semidominator { semidominator = semi[candidate]; }
            }
            predecessorIndex = predecessorIndex + 1;
        }
        semi.set(block, semidominator);
        var semiVertex = traversal.order[semidominator];
        var semiBucket = bucket[semiVertex];
        semiBucket.push(block);
        bucket.set(semiVertex, semiBucket);
        var parent = traversal.parent[block];
        ancestor.set(block, parent);
        var parentBucket = bucket[parent];
        var bucketAt = 0;
        loop {
            if bucketAt >= parentBucket.len() { break; }
            var pending = parentBucket[bucketAt];
            var candidate = evalDominator(pending, semi, ancestor, label);
            if semi[candidate] < semi[pending] { idom.set(pending, candidate); }
            else { idom.set(pending, parent); }
            bucketAt = bucketAt + 1;
        }
        bucket.set(parent, []);
        orderIndex = orderIndex - 1;
    }
    orderIndex = 1;
    loop {
        if orderIndex >= traversal.order.len() { break; }
        var block = traversal.order[orderIndex];
        var semiVertex = traversal.order[semi[block]];
        if idom[block] >= 0 && idom[block] != semiVertex { idom.set(block, idom[idom[block]]); }
        orderIndex = orderIndex + 1;
    }
    return idom;
}

func computeDominanceIntervals(idom: Vec<int>, blockCount: int): Vec<int> {
    var interval: Vec<int> = [];
    var index = 0;
    loop {
        if index >= blockCount * 2 { break; }
        interval.push(-1);
        index = index + 1;
    }
    if blockCount == 0 { return interval; }
    var firstChild: Vec<int> = [];
    var nextSibling: Vec<int> = [];
    index = 0;
    loop {
        if index >= blockCount { break; }
        firstChild.push(-1);
        nextSibling.push(-1);
        index = index + 1;
    }
    var childIndex = 1;
    loop {
        if childIndex >= blockCount { break; }
        var parentIndex = idom[childIndex];
        if parentIndex >= 0 {
            nextSibling.set(childIndex, firstChild[parentIndex]);
            firstChild.set(parentIndex, childIndex);
        }
        childIndex = childIndex + 1;
    }
    var stack: Vec<int> = [];
    stack.push(0);
    var timer = 0;
    loop {
        if stack.len() == 0 { break; }
        var marker = stack.pop();
        if marker >= blockCount {
            var exitIndex = marker - blockCount;
            interval.set(exitIndex * 2 + 1, timer);
            continue;
        }
        interval.set(marker * 2, timer);
        timer = timer + 1;
        stack.push(marker + blockCount);
        var child = firstChild[marker];
        loop {
            if child < 0 { break; }
            stack.push(child);
            child = nextSibling[child];
        }
    }
    return interval;
}

func analyzeDominance(successors: Vec<Vec<int>>, predecessors: Vec<Vec<int>>, blockCount: int): Vec<int> {
    var traversal = computeReversePostorder(successors, blockCount);
    var idom = computeImmediateDominators(predecessors, blockCount, traversal);
    return computeDominanceIntervals(idom, blockCount);
}

func checkI64Operand(errors: Vec<string>, table: DefinitionTable, valueId: int, context: string): void {
    var definition = findDefinition(table, valueId);
    if definition.id >= 0 && definition.ty.kind != IRTypeKind::I64 {
        errors.push(context + ": operand must have type i64");
    }
}

func checkBoolOperand(errors: Vec<string>, table: DefinitionTable, valueId: int, context: string): void {
    var definition = findDefinition(table, valueId);
    if definition.id >= 0 && definition.ty.kind != IRTypeKind::Bool {
        errors.push(context + ": operand must have type bool");
    }
}

func checkRawAddressOperand(errors: Vec<string>, table: DefinitionTable, valueId: int, context: string): void {
    var definition = findDefinition(table, valueId);
    if definition.id >= 0 && definition.ty.kind != IRTypeKind::RawAddress {
        errors.push(context + ": operand must have type raw.address");
    }
}

func checkRawUnusedFields(errors: Vec<string>, instruction: Instruction, context: string, name: string): void {
    if instruction.immediate != 0 || instruction.comparison != CompareI64Predicate::Eq || instruction.functionId != -1 {
        errors.push(context + ": " + name + " has invalid unused fields");
    }
}

func checkCheckedI64Instruction(errors: Vec<string>, table: DefinitionTable, instruction: Instruction, context: string, name: string): void {
    if instruction.ty.kind != IRTypeKind::I64 || instruction.resultId < 0 { errors.push(context + ": " + name + " requires an i64 result"); }
    if instruction.operands.len() != 2 { errors.push(context + ": " + name + " requires exactly two operands"); }
    if instruction.immediate != 0 || instruction.functionId != -1 || instruction.comparison != CompareI64Predicate::Eq { errors.push(context + ": " + name + " has invalid unused fields"); }
    var operandIndex = 0;
    loop {
        if operandIndex >= instruction.operands.len() { break; }
        checkI64Operand(errors, table, instruction.operands[operandIndex], context);
        operandIndex = operandIndex + 1;
    }
}

func checkFunction(program: IRProgram, function: IRFunction, functionIndices: HashMap<string, int>): Vec<string> {
    var errors: Vec<string> = [];
    var functionLabel = "function %f" + function.id.toString() + " (" + functionKeyName(function.key) + ")";

    if function.id < 0 { errors.push(functionLabel + ": function ID must be nonnegative"); }
    if function.key.module == "" || function.key.name == "" { errors.push(functionLabel + ": stable key requires a module and name"); }
    if function.blocks.len() == 0 { errors.push(functionLabel + ": function must contain an entry block"); }
    if function.parameters.len() != function.signature.parameterTypes.len() {
        errors.push(functionLabel + ": formal parameter count does not match signature");
    }
    if function.effects.argumentEscapes.len() != function.signature.parameterTypes.len() {
        errors.push(functionLabel + ": effect argument vector does not match signature arity");
    }

    var blockIndices: HashMap<string, int> = HashMap.new();
    var blockAt = 0;
    loop { if blockAt >= function.blocks.len() { break; } var key = function.blocks[blockAt].id.toString(); if !blockIndices.has(key) { blockIndices.set(key, blockAt); } blockAt = blockAt + 1; }

    var paramIndex = 0;
    loop {
        if paramIndex >= function.signature.parameterTypes.len() { break; }
        if function.signature.parameterTypes[paramIndex].kind == IRTypeKind::Void {
            errors.push(functionLabel + ": signature parameter " + paramIndex.toString() + " cannot be void");
        }
        paramIndex = paramIndex + 1;
    }

    var definitions: Vec<ValueDef> = [];
    var definitionIndices: HashMap<string, int> = HashMap.new();
    paramIndex = 0;
    loop {
        if paramIndex >= function.parameters.len() { break; }
        var parameter = function.parameters[paramIndex];
        if parameter.id < 0 { errors.push(functionLabel + ": formal parameter ID must be nonnegative"); }
        if parameter.ty.kind == IRTypeKind::Void { errors.push(functionLabel + ": formal parameter cannot be void"); }
        if paramIndex < function.signature.parameterTypes.len() {
            if !sameType(parameter.ty, function.signature.parameterTypes[paramIndex]) {
                errors.push(functionLabel + ": formal parameter type does not match signature");
            }
        }
        if parameter.id >= 0 {
            var key = parameter.id.toString();
            if definitionIndices.has(key) {
                errors.push(functionLabel + ": duplicate SSA value ID %v" + parameter.id.toString());
            } else {
                definitionIndices.set(key, definitions.len());
            }
            definitions.push(ValueDef { id: parameter.id, ty: parameter.ty, blockIndex: -1, instructionIndex: -1 });
        }
        paramIndex = paramIndex + 1;
    }

    var blockIndex = 0;
    loop {
        if blockIndex >= function.blocks.len() { break; }
        var block = function.blocks[blockIndex];
        if block.id < 0 { errors.push(functionLabel + ": block ID must be nonnegative"); }
        if blockIndices.get(block.id.toString()) != blockIndex { errors.push(functionLabel + ": duplicate block ID bb" + block.id.toString()); }
        if blockIndex == 0 && block.params.len() != 0 {
            errors.push(functionLabel + ": entry block cannot have parameters");
        }
        var parameterIndex = 0;
        loop {
            if parameterIndex >= block.params.len() { break; }
            var parameter = block.params[parameterIndex];
            if parameter.id < 0 { errors.push(functionLabel + ": block parameter ID must be nonnegative"); }
            if parameter.ty.kind == IRTypeKind::Void { errors.push(functionLabel + ": block parameter cannot be void"); }
            if parameter.id >= 0 {
                var key = parameter.id.toString();
                if definitionIndices.has(key) {
                    errors.push(functionLabel + ": duplicate SSA value ID %v" + parameter.id.toString());
                } else {
                    definitionIndices.set(key, definitions.len());
                }
                definitions.push(ValueDef { id: parameter.id, ty: parameter.ty, blockIndex: blockIndex, instructionIndex: -1 });
            }
            parameterIndex = parameterIndex + 1;
        }
        var instructionIndex = 0;
        loop {
            if instructionIndex >= block.instructions.len() { break; }
            var instruction = block.instructions[instructionIndex];
            if instruction.resultId < -1 { errors.push(functionLabel + ": result ID must be nonnegative or the void sentinel -1"); }
            if instruction.resultId >= 0 {
                var key = instruction.resultId.toString();
                if definitionIndices.has(key) {
                    errors.push(functionLabel + ": duplicate SSA value ID %v" + instruction.resultId.toString());
                } else {
                    definitionIndices.set(key, definitions.len());
                }
                definitions.push(ValueDef { id: instruction.resultId, ty: instruction.ty, blockIndex: blockIndex, instructionIndex: instructionIndex });
            }
            checkSource(errors, instruction.source, functionLabel + " block bb" + block.id.toString() + " instruction " + instructionIndex.toString());
            instructionIndex = instructionIndex + 1;
        }
        checkSource(errors, block.terminator.source, functionLabel + " block bb" + block.id.toString() + " terminator");
        blockIndex = blockIndex + 1;
    }

    var definitionTable = buildDefinitionTable(definitions, definitionIndices);

    var blockCount = function.blocks.len();
    var successors: Vec<Vec<int>> = [];
    var predecessors: Vec<Vec<int>> = [];
    var edgeNode = 0;
    loop {
        if edgeNode >= blockCount { break; }
        successors.push([]);
        predecessors.push([]);
        edgeNode = edgeNode + 1;
    }

    blockIndex = 0;
    loop {
        if blockIndex >= blockCount { break; }
        var block = function.blocks[blockIndex];
        var terminator = block.terminator;
        var context = functionLabel + " block bb" + block.id.toString() + " terminator";
        if terminator.kind == TerminatorKind::Invalid {
            errors.push(context + ": invalid terminator");
        } else if terminator.kind == TerminatorKind::Jump {
            if terminator.conditionValueId != -1 || terminator.trueTargetBlockId != -1 || terminator.falseTargetBlockId != -1 || terminator.trueArgs.len() != 0 || terminator.falseArgs.len() != 0 || terminator.valueId != -1 {
                errors.push(context + ": jump contains fields belonging to another terminator kind");
            }
            var targetIndex = findBlockIndex(blockIndices, terminator.targetBlockId);
            if targetIndex < 0 {
                errors.push(context + ": jump target bb" + terminator.targetBlockId.toString() + " does not exist");
            } else {
                appendGraphEdge(successors, blockIndex, targetIndex);
                appendGraphEdge(predecessors, targetIndex, blockIndex);
                var target = function.blocks[targetIndex];
                if terminator.targetArgs.len() != target.params.len() {
                    errors.push(context + ": jump argument count does not match target parameters");
                }
                var argumentIndex = 0;
                loop {
                    if argumentIndex >= terminator.targetArgs.len() || argumentIndex >= target.params.len() { break; }
                    var argument = findDefinition(definitionTable, terminator.targetArgs[argumentIndex]);
                    if argument.id >= 0 && !sameType(argument.ty, target.params[argumentIndex].ty) {
                        errors.push(context + ": jump argument type does not match target parameter");
                    }
                    argumentIndex = argumentIndex + 1;
                }
            }
        } else if terminator.kind == TerminatorKind::Branch {
            if terminator.targetBlockId != -1 || terminator.targetArgs.len() != 0 || terminator.valueId != -1 {
                errors.push(context + ": branch contains fields belonging to another terminator kind");
            }
            var condition = findDefinition(definitionTable, terminator.conditionValueId);
            if condition.id >= 0 && condition.ty.kind != IRTypeKind::Bool { errors.push(context + ": branch condition must have type bool"); }
            var trueIndex = findBlockIndex(blockIndices, terminator.trueTargetBlockId);
            if trueIndex < 0 {
                errors.push(context + ": true branch target bb" + terminator.trueTargetBlockId.toString() + " does not exist");
            } else {
                appendGraphEdge(successors, blockIndex, trueIndex);
                appendGraphEdge(predecessors, trueIndex, blockIndex);
                var trueBlock = function.blocks[trueIndex];
                if terminator.trueArgs.len() != trueBlock.params.len() { errors.push(context + ": true branch argument count does not match target parameters"); }
                var trueArgIndex = 0;
                loop {
                    if trueArgIndex >= terminator.trueArgs.len() || trueArgIndex >= trueBlock.params.len() { break; }
                    var trueArg = findDefinition(definitionTable, terminator.trueArgs[trueArgIndex]);
                    if trueArg.id >= 0 && !sameType(trueArg.ty, trueBlock.params[trueArgIndex].ty) { errors.push(context + ": true branch argument type does not match target parameter"); }
                    trueArgIndex = trueArgIndex + 1;
                }
            }
            var falseIndex = findBlockIndex(blockIndices, terminator.falseTargetBlockId);
            if falseIndex < 0 {
                errors.push(context + ": false branch target bb" + terminator.falseTargetBlockId.toString() + " does not exist");
            } else {
                appendGraphEdge(successors, blockIndex, falseIndex);
                appendGraphEdge(predecessors, falseIndex, blockIndex);
                var falseBlock = function.blocks[falseIndex];
                if terminator.falseArgs.len() != falseBlock.params.len() { errors.push(context + ": false branch argument count does not match target parameters"); }
                var falseArgIndex = 0;
                loop {
                    if falseArgIndex >= terminator.falseArgs.len() || falseArgIndex >= falseBlock.params.len() { break; }
                    var falseArg = findDefinition(definitionTable, terminator.falseArgs[falseArgIndex]);
                    if falseArg.id >= 0 && !sameType(falseArg.ty, falseBlock.params[falseArgIndex].ty) { errors.push(context + ": false branch argument type does not match target parameter"); }
                    falseArgIndex = falseArgIndex + 1;
                }
            }
        } else if terminator.kind == TerminatorKind::Return {
            if terminator.targetBlockId != -1 || terminator.targetArgs.len() != 0 || terminator.conditionValueId != -1 || terminator.trueTargetBlockId != -1 || terminator.trueArgs.len() != 0 || terminator.falseTargetBlockId != -1 || terminator.falseArgs.len() != 0 {
                errors.push(context + ": return contains fields belonging to another terminator kind");
            }
            if function.signature.returnType.kind == IRTypeKind::Void {
                if terminator.valueId != -1 { errors.push(context + ": void function must return void"); }
            } else if terminator.valueId < 0 {
                errors.push(context + ": non-void function must return an SSA value");
            } else {
                var returned = findDefinition(definitionTable, terminator.valueId);
                if returned.id >= 0 && !sameType(returned.ty, function.signature.returnType) { errors.push(context + ": return value type does not match function result"); }
            }
        }
        blockIndex = blockIndex + 1;
    }

    if blockCount > 0 && predecessors[0].len() > 0 { errors.push(functionLabel + ": entry block bb" + function.blocks[0].id.toString() + " cannot have incoming edges"); }

    var dominance = analyzeDominance(successors, predecessors, blockCount);
    var useErrors: Vec<string> = [];
    blockIndex = 0;
    loop {
        if blockIndex >= blockCount { break; }
        var block = function.blocks[blockIndex];
        var instructionIndex = 0;
        loop {
            if instructionIndex >= block.instructions.len() { break; }
            var instruction = block.instructions[instructionIndex];
            var context = functionLabel + " block bb" + block.id.toString() + " instruction " + instructionIndex.toString();
            var operandCount = instruction.operands.len();
            if instruction.kind == InstructionKind::ConstI64 {
                if instruction.ty.kind != IRTypeKind::I64 || instruction.resultId < 0 { errors.push(context + ": const.i64 requires an i64 result"); }
                if operandCount != 0 || instruction.functionId != -1 || instruction.comparison != CompareI64Predicate::Eq { errors.push(context + ": const.i64 has invalid unused fields"); }
            } else if instruction.kind == InstructionKind::ConstBool {
                if instruction.ty.kind != IRTypeKind::Bool || instruction.resultId < 0 { errors.push(context + ": const.bool requires a bool result"); }
                if instruction.immediate != 0 && instruction.immediate != 1 { errors.push(context + ": bool immediate must be 0 or 1"); }
                if operandCount != 0 || instruction.functionId != -1 || instruction.comparison != CompareI64Predicate::Eq { errors.push(context + ": const.bool has invalid unused fields"); }
            } else if instruction.kind == InstructionKind::AddCheckedI64 {
                checkCheckedI64Instruction(errors, definitionTable, instruction, context, "add.checked.i64");
            } else if instruction.kind == InstructionKind::SubCheckedI64 {
                checkCheckedI64Instruction(errors, definitionTable, instruction, context, "sub.checked.i64");
            } else if instruction.kind == InstructionKind::MulCheckedI64 {
                checkCheckedI64Instruction(errors, definitionTable, instruction, context, "mul.checked.i64");
            } else if instruction.kind == InstructionKind::DivCheckedI64 {
                checkCheckedI64Instruction(errors, definitionTable, instruction, context, "div.checked.i64");
            } else if instruction.kind == InstructionKind::RemCheckedI64 {
                checkCheckedI64Instruction(errors, definitionTable, instruction, context, "rem.checked.i64");
            } else if instruction.kind == InstructionKind::CompareI64 {
                if instruction.ty.kind != IRTypeKind::Bool || instruction.resultId < 0 { errors.push(context + ": compare.i64 requires a bool result"); }
                if operandCount != 2 { errors.push(context + ": compare.i64 requires exactly two operands"); }
                if instruction.immediate != 0 || instruction.functionId != -1 { errors.push(context + ": compare.i64 has invalid unused fields"); }
                var compareIndex = 0;
                loop {
                    if compareIndex >= operandCount { break; }
                    checkI64Operand(errors, definitionTable, instruction.operands[compareIndex], context);
                    compareIndex = compareIndex + 1;
                }
            } else if instruction.kind == InstructionKind::CompareBool {
                if instruction.ty.kind != IRTypeKind::Bool || instruction.resultId < 0 { errors.push(context + ": compare.bool requires a bool result"); }
                if operandCount != 2 { errors.push(context + ": compare.bool requires exactly two operands"); }
                if instruction.immediate != 0 || instruction.functionId != -1 { errors.push(context + ": compare.bool has invalid unused fields"); }
                if instruction.comparison != CompareI64Predicate::Eq && instruction.comparison != CompareI64Predicate::Ne { errors.push(context + ": compare.bool permits only eq or ne predicates"); }
                var boolCompareIndex = 0;
                loop {
                    if boolCompareIndex >= operandCount { break; }
                    checkBoolOperand(errors, definitionTable, instruction.operands[boolCompareIndex], context);
                    boolCompareIndex = boolCompareIndex + 1;
                }
            } else if instruction.kind == InstructionKind::RawNull {
                if instruction.ty.kind != IRTypeKind::RawAddress || instruction.resultId < 0 { errors.push(context + ": raw.null requires a raw.address result"); }
                if operandCount != 0 { errors.push(context + ": raw.null requires no operands"); }
                checkRawUnusedFields(errors, instruction, context, "raw.null");
            } else if instruction.kind == InstructionKind::RawMap {
                if instruction.ty.kind != IRTypeKind::RawAddress || instruction.resultId < 0 { errors.push(context + ": raw.map requires a raw.address result"); }
                if operandCount != 1 { errors.push(context + ": raw.map requires exactly one operand"); }
                checkRawUnusedFields(errors, instruction, context, "raw.map");
                if operandCount > 0 { checkI64Operand(errors, definitionTable, instruction.operands[0], context); }
            } else if instruction.kind == InstructionKind::RawUnmap {
                if instruction.ty.kind != IRTypeKind::Void || instruction.resultId != -1 { errors.push(context + ": raw.unmap requires a void result and ID -1"); }
                if operandCount != 2 { errors.push(context + ": raw.unmap requires exactly two operands"); }
                checkRawUnusedFields(errors, instruction, context, "raw.unmap");
                if operandCount > 0 { checkRawAddressOperand(errors, definitionTable, instruction.operands[0], context); }
                if operandCount > 1 { checkI64Operand(errors, definitionTable, instruction.operands[1], context); }
            } else if instruction.kind == InstructionKind::RawOffset {
                if instruction.ty.kind != IRTypeKind::RawAddress || instruction.resultId < 0 { errors.push(context + ": raw.offset requires a raw.address result"); }
                if operandCount != 2 { errors.push(context + ": raw.offset requires exactly two operands"); }
                checkRawUnusedFields(errors, instruction, context, "raw.offset");
                if operandCount > 0 { checkRawAddressOperand(errors, definitionTable, instruction.operands[0], context); }
                if operandCount > 1 { checkI64Operand(errors, definitionTable, instruction.operands[1], context); }
            } else if instruction.kind == InstructionKind::RawLoadI64 {
                if instruction.ty.kind != IRTypeKind::I64 || instruction.resultId < 0 { errors.push(context + ": raw.load.i64 requires an i64 result"); }
                if operandCount != 1 { errors.push(context + ": raw.load.i64 requires exactly one operand"); }
                checkRawUnusedFields(errors, instruction, context, "raw.load.i64");
                if operandCount > 0 { checkRawAddressOperand(errors, definitionTable, instruction.operands[0], context); }
            } else if instruction.kind == InstructionKind::RawStoreI64 {
                if instruction.ty.kind != IRTypeKind::Void || instruction.resultId != -1 { errors.push(context + ": raw.store.i64 requires a void result and ID -1"); }
                if operandCount != 2 { errors.push(context + ": raw.store.i64 requires exactly two operands"); }
                checkRawUnusedFields(errors, instruction, context, "raw.store.i64");
                if operandCount > 0 { checkRawAddressOperand(errors, definitionTable, instruction.operands[0], context); }
                if operandCount > 1 { checkI64Operand(errors, definitionTable, instruction.operands[1], context); }
            } else if instruction.kind == InstructionKind::RawLoadAddress {
                if instruction.ty.kind != IRTypeKind::RawAddress || instruction.resultId < 0 { errors.push(context + ": raw.load.address requires a raw.address result"); }
                if operandCount != 1 { errors.push(context + ": raw.load.address requires exactly one operand"); }
                checkRawUnusedFields(errors, instruction, context, "raw.load.address");
                if operandCount > 0 { checkRawAddressOperand(errors, definitionTable, instruction.operands[0], context); }
            } else if instruction.kind == InstructionKind::RawStoreAddress {
                if instruction.ty.kind != IRTypeKind::Void || instruction.resultId != -1 { errors.push(context + ": raw.store.address requires a void result and ID -1"); }
                if operandCount != 2 { errors.push(context + ": raw.store.address requires exactly two operands"); }
                checkRawUnusedFields(errors, instruction, context, "raw.store.address");
                if operandCount > 0 { checkRawAddressOperand(errors, definitionTable, instruction.operands[0], context); }
                if operandCount > 1 { checkRawAddressOperand(errors, definitionTable, instruction.operands[1], context); }
            } else if instruction.kind == InstructionKind::RawLoadByte {
                if instruction.ty.kind != IRTypeKind::I64 || instruction.resultId < 0 { errors.push(context + ": raw.load.byte requires an i64 result"); }
                if operandCount != 1 { errors.push(context + ": raw.load.byte requires exactly one operand"); }
                checkRawUnusedFields(errors, instruction, context, "raw.load.byte");
                if operandCount > 0 { checkRawAddressOperand(errors, definitionTable, instruction.operands[0], context); }
            } else if instruction.kind == InstructionKind::RawStoreByte {
                if instruction.ty.kind != IRTypeKind::Void || instruction.resultId != -1 { errors.push(context + ": raw.store.byte requires a void result and ID -1"); }
                if operandCount != 2 { errors.push(context + ": raw.store.byte requires exactly two operands"); }
                checkRawUnusedFields(errors, instruction, context, "raw.store.byte");
                if operandCount > 0 { checkRawAddressOperand(errors, definitionTable, instruction.operands[0], context); }
                if operandCount > 1 { checkI64Operand(errors, definitionTable, instruction.operands[1], context); }
            } else if instruction.kind == InstructionKind::RawEqual {
                if instruction.ty.kind != IRTypeKind::Bool || instruction.resultId < 0 { errors.push(context + ": raw.equal requires a bool result"); }
                if operandCount != 2 { errors.push(context + ": raw.equal requires exactly two operands"); }
                checkRawUnusedFields(errors, instruction, context, "raw.equal");
                var rawEqualIndex = 0;
                loop {
                    if rawEqualIndex >= operandCount { break; }
                    checkRawAddressOperand(errors, definitionTable, instruction.operands[rawEqualIndex], context);
                    rawEqualIndex = rawEqualIndex + 1;
                }
            } else if instruction.kind == InstructionKind::RawFail {
                if instruction.ty.kind != IRTypeKind::Void || instruction.resultId != -1 { errors.push(context + ": raw.fail requires a void result and ID -1"); }
                if operandCount != 1 { errors.push(context + ": raw.fail requires exactly one operand"); }
                checkRawUnusedFields(errors, instruction, context, "raw.fail");
                if operandCount > 0 { checkI64Operand(errors, definitionTable, instruction.operands[0], context); }
            } else if instruction.kind == InstructionKind::RawFromInt {
                if instruction.ty.kind != IRTypeKind::RawAddress || instruction.resultId < 0 { errors.push(context + ": raw.from.int requires a raw.address result"); }
                if operandCount != 1 { errors.push(context + ": raw.from.int requires exactly one operand"); }
                checkRawUnusedFields(errors, instruction, context, "raw.from.int");
                if operandCount > 0 { checkI64Operand(errors, definitionTable, instruction.operands[0], context); }
            } else if instruction.kind == InstructionKind::RawToInt {
                if instruction.ty.kind != IRTypeKind::I64 || instruction.resultId < 0 { errors.push(context + ": raw.to.int requires an i64 result"); }
                if operandCount != 1 { errors.push(context + ": raw.to.int requires exactly one operand"); }
                checkRawUnusedFields(errors, instruction, context, "raw.to.int");
                if operandCount > 0 { checkRawAddressOperand(errors, definitionTable, instruction.operands[0], context); }
            } else if instruction.kind == InstructionKind::RawSyscall || instruction.kind == InstructionKind::RawHostSyscall {
                var operationName = "raw.syscall";
                if instruction.kind == InstructionKind::RawHostSyscall { operationName = "raw.host.syscall"; }
                if instruction.ty.kind != IRTypeKind::RawAddress || instruction.resultId < 0 { errors.push(context + ": " + operationName + " requires a raw.address result"); }
                if operandCount != 7 { errors.push(context + ": " + operationName + " requires a number and six arguments"); }
                checkRawUnusedFields(errors, instruction, context, operationName);
                if operandCount > 0 { checkI64Operand(errors, definitionTable, instruction.operands[0], context); }
                var syscallIndex = 1;
                while syscallIndex < operandCount {
                    checkRawAddressOperand(errors, definitionTable, instruction.operands[syscallIndex], context);
                    syscallIndex = syscallIndex + 1;
                }
            } else if instruction.kind == InstructionKind::RawArgCount {
                if instruction.ty.kind != IRTypeKind::I64 || instruction.resultId < 0 { errors.push(context + ": raw.arg.count requires an i64 result"); }
                if operandCount != 0 { errors.push(context + ": raw.arg.count requires no operands"); }
                checkRawUnusedFields(errors, instruction, context, "raw.arg.count");
            } else if instruction.kind == InstructionKind::RawArg {
                if instruction.ty.kind != IRTypeKind::RawAddress || instruction.resultId < 0 { errors.push(context + ": raw.arg requires a raw.address result"); }
                if operandCount != 1 { errors.push(context + ": raw.arg requires exactly one operand"); }
                checkRawUnusedFields(errors, instruction, context, "raw.arg");
                if operandCount > 0 { checkI64Operand(errors, definitionTable, instruction.operands[0], context); }
            } else if instruction.kind == InstructionKind::Call {
                if instruction.immediate != 0 || instruction.comparison != CompareI64Predicate::Eq { errors.push(context + ": call has invalid unused fields"); }
                var calleeIndex = -1;
                if functionIndices.has(instruction.functionId.toString()) { calleeIndex = functionIndices.get(instruction.functionId.toString()); }
                if calleeIndex < 0 {
                    errors.push(context + ": call target %f" + instruction.functionId.toString() + " does not exist");
                } else {
                    var callee = program.functions[calleeIndex];
                    if !sameType(instruction.ty, callee.signature.returnType) { errors.push(context + ": call result type does not match callee return type"); }
                    if instruction.operands.len() != callee.signature.parameterTypes.len() { errors.push(context + ": call argument count does not match callee signature"); }
                    var callArgIndex = 0;
                    loop {
                        if callArgIndex >= instruction.operands.len() || callArgIndex >= callee.signature.parameterTypes.len() { break; }
                        var callArg = findDefinition(definitionTable, instruction.operands[callArgIndex]);
                        if callArg.id >= 0 && !sameType(callArg.ty, callee.signature.parameterTypes[callArgIndex]) { errors.push(context + ": call argument type does not match callee signature"); }
                        callArgIndex = callArgIndex + 1;
                    }
                }
                if instruction.ty.kind == IRTypeKind::Void {
                    if instruction.resultId != -1 { errors.push(context + ": void call result ID must be -1"); }
                } else if instruction.resultId < 0 {
                    errors.push(context + ": non-void call must define an SSA result");
                }
            }
            var operandIndex = 0;
            loop {
                if operandIndex >= instruction.operands.len() { break; }
                checkUse(useErrors, definitionTable, instruction.operands[operandIndex], blockIndex, instructionIndex, dominance, blockCount, context);
                operandIndex = operandIndex + 1;
            }
            instructionIndex = instructionIndex + 1;
        }
        var terminator = block.terminator;
        var termContext = functionLabel + " block bb" + block.id.toString() + " terminator";
        if terminator.kind == TerminatorKind::Branch {
            var condition = findDefinition(definitionTable, terminator.conditionValueId);
            if condition.id >= 0 && condition.ty.kind != IRTypeKind::Bool { errors.push(termContext + ": branch condition must have type bool"); }
        }
        var useIndex = block.instructions.len();
        if terminator.kind == TerminatorKind::Jump {
            var argumentIndex = 0;
            loop {
                if argumentIndex >= terminator.targetArgs.len() { break; }
                checkUse(useErrors, definitionTable, terminator.targetArgs[argumentIndex], blockIndex, useIndex, dominance, blockCount, termContext);
                argumentIndex = argumentIndex + 1;
            }
        } else if terminator.kind == TerminatorKind::Branch {
            checkUse(useErrors, definitionTable, terminator.conditionValueId, blockIndex, useIndex, dominance, blockCount, termContext);
            var trueArgIndex = 0;
            loop {
                if trueArgIndex >= terminator.trueArgs.len() { break; }
                checkUse(useErrors, definitionTable, terminator.trueArgs[trueArgIndex], blockIndex, useIndex, dominance, blockCount, termContext);
                trueArgIndex = trueArgIndex + 1;
            }
            var falseArgIndex = 0;
            loop {
                if falseArgIndex >= terminator.falseArgs.len() { break; }
                checkUse(useErrors, definitionTable, terminator.falseArgs[falseArgIndex], blockIndex, useIndex, dominance, blockCount, termContext);
                falseArgIndex = falseArgIndex + 1;
            }
        } else if terminator.kind == TerminatorKind::Return && terminator.valueId != -1 {
            checkUse(useErrors, definitionTable, terminator.valueId, blockIndex, useIndex, dominance, blockCount, termContext);
        }
        blockIndex = blockIndex + 1;
    }

    blockIndex = 0;
    loop {
        if blockIndex >= blockCount { break; }
        if dominance.get(blockIndex * 2) < 0 { errors.push(functionLabel + ": unreachable block bb" + function.blocks[blockIndex].id.toString()); }
        blockIndex = blockIndex + 1;
    }

    var useErrorIndex = 0;
    loop {
        if useErrorIndex >= useErrors.len() { break; }
        errors.push(useErrors[useErrorIndex]);
        useErrorIndex = useErrorIndex + 1;
    }
    return errors;
}

pub func verifyProgram(program: IRProgram): VerifyResult {
    var errors: Vec<string> = [];
    if program.functions.len() == 0 { errors.push("program: must contain at least one function"); }
    if program.entryFunctionId < 0 { errors.push("program: entry function ID must be nonnegative"); }
    var functionIndices: HashMap<string, int> = HashMap.new();
    var index = 0;
    loop { if index >= program.functions.len() { break; } var key = program.functions[index].id.toString(); if !functionIndices.has(key) { functionIndices.set(key, index); } index = index + 1; }
    var entryIndex = -1;
    if functionIndices.has(program.entryFunctionId.toString()) { entryIndex = functionIndices.get(program.entryFunctionId.toString()); }
    if entryIndex < 0 {
        errors.push("program: entry function %f" + program.entryFunctionId.toString() + " does not exist");
    } else {
        var entry = program.functions[entryIndex];
        if entry.parameters.len() != 0 || entry.signature.parameterTypes.len() != 0 {
            errors.push("program: entry function must have no arguments");
        }
        if entry.signature.returnType.kind == IRTypeKind::RawAddress {
            errors.push("program: entry function result must be scalar or void");
        }
    }

    var functionIdCounts: HashMap<string, int> = HashMap.new();
    var stableKeyCounts: HashMap<string, int> = HashMap.new();
    var functionIndex = 0;
    loop {
        if functionIndex >= program.functions.len() { break; }
        var function = program.functions[functionIndex];
        if function.id < 0 { errors.push("program: function IDs must be nonnegative"); }
        var functionKey = function.id.toString();
        var priorCount = 0;
        if functionIdCounts.has(functionKey) { priorCount = functionIdCounts.get(functionKey); }
        var duplicateAt = 0;
        loop { if duplicateAt >= priorCount { break; } errors.push("program: duplicate function ID %f" + function.id.toString()); duplicateAt = duplicateAt + 1; }
        functionIdCounts.set(functionKey, priorCount + 1);
        var stableKey = function.key.module.len().toString() + ":" + function.key.module + function.key.owner.len().toString() + ":" + function.key.owner + function.key.name.len().toString() + ":" + function.key.name;
        priorCount = 0;
        if stableKeyCounts.has(stableKey) { priorCount = stableKeyCounts.get(stableKey); }
        duplicateAt = 0;
        loop { if duplicateAt >= priorCount { break; } errors.push("program: duplicate stable function key " + functionKeyName(function.key)); duplicateAt = duplicateAt + 1; }
        stableKeyCounts.set(stableKey, priorCount + 1);
        var functionErrors = checkFunction(program, function, functionIndices);
        var errorIndex = 0;
        loop {
            if errorIndex >= functionErrors.len() { break; }
            errors.push(functionErrors[errorIndex]);
            errorIndex = errorIndex + 1;
        }
        functionIndex = functionIndex + 1;
    }
    return VerifyResult { ok: errors.len() == 0, errors: errors };
}
