    " if ok \x7B return i; \x7D\n        i = i - 1;\n    \x7D\n    return -1;\n\x7D\n\nfunc trimRightNewlines(s: string): string \x7B\n    var end = s.len() - 1;\n    loop \x7B\n        if end < 0 \x7B break; \x7D\n        var c = "))) +
    (("s[end];\n        if c == '\\n' || c == '\\r' \x7B\n            end = end - 1;\n        \x7D else \x7B\n            break;\n        \x7D\n    \x7D\n    if end < 0 \x7B return \"\"; \x7D\n    var out = \"\";\n    var i = 0;\n    lo" +
    ("op \x7B\n        if i > end \x7B break; \x7D\n        out = out + s[i].toString();\n        i = i + 1;\n    \x7D\n    return out;\n\x7D\n\nfunc parseStatusAndBody(stdout: string): any \x7B\n    var statusMarker = \"\\n__R" +
