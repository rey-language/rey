func embeddedStdSource14Part0(): string {
    return ((("// Small, immutable-by-convention 2D and 3D vector primitives.\n\npub struct Vec2 \x7B\n    pub x: float,\n    pub y: float,\n\x7D\n\npub struct Vec3 \x7B\n    pub x: float,\n    pub y: float,\n    pub z: float," +
    "\n\x7D\n\npub func vec2(x: float, y: float): Vec2 \x7B\n    return Vec2 \x7B x: x, y: y \x7D;\n\x7D\n\npub func vec2Add(a: Vec2, b: Vec2): Vec2 \x7B\n    return vec2(a.x + b.x, a.y + b.y);\n\x7D\n\npub func vec2Sub(a: Vec2, ") +
    ("b: Vec2): Vec2 \x7B\n    return vec2(a.x - b.x, a.y - b.y);\n\x7D\n\npub func vec2Scale(v: Vec2, s: float): Vec2 \x7B\n    return vec2(v.x * s, v.y * s);\n\x7D\n\npub func vec2Dot(a: Vec2, b: Vec2): float \x7B\n    r" +
    ("eturn a.x * b.x + a.y * b.y;\n\x7D\n\npub func vec2Length(v: Vec2): float \x7B\n    return nativeSqrt(vec2Dot(v, v));\n\x7D\n\npub func vec2Distance(a: Vec2, b: Vec2): float \x7B\n    return vec2Length(vec2Sub(a," +
    " b));\n\x7D\n\npub func vec2Normalize(v: Vec2): Vec2 \x7B\n    var length = vec2Length(v);\n    if length == 0.0 \x7B\n        return vec2(0.0, 0.0);\n    \x7D\n    return vec2Scale(v, 1.0 / length);\n\x7D\n\npub func "))) +
    (("vec3(x: float, y: float, z: float): Vec3 \x7B\n    return Vec3 \x7B x: x, y: y, z: z \x7D;\n\x7D\n\npub func vec3Add(a: Vec3, b: Vec3): Vec3 \x7B\n    return vec3(a.x + b.x, a.y + b.y, a.z + b.z);\n\x7D\n\npub func vec" +
    "3Sub(a: Vec3, b: Vec3): Vec3 \x7B\n    return vec3(a.x - b.x, a.y - b.y, a.z - b.z);\n\x7D\n\npub func vec3Scale(v: Vec3, s: float): Vec3 \x7B\n    return vec3(v.x * s, v.y * s, v.z * s);\n\x7D\n\npub func vec3Do") +
