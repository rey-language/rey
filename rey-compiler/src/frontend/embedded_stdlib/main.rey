func embeddedStdSource26Part0(): string {
    return (((("// SQLite CLI-backed SQL helpers with a no-op memory mock when sqlite3 is absent.\n\nimport std::process;\n\npub struct Connection \x7B\n    pub path: string,\n    pub driver: string,\n\x7D\n\npub struct Que" +
    "ryResult \x7B\n    pub columns: Vec<string>,\n    pub rows: Vec<Vec<string>>,\n    pub changes: int,\n    pub ok: bool,\n    pub error: string,\n\x7D\n\nfunc shellQuote(value: string): string \x7B\n    var out ") +
    ("= \"'\";\n    var i = 0;\n    loop \x7B\n        if i >= value.len() \x7B break; \x7D\n        var c = value[i];\n        if int(c) == 39 \x7B\n            out = out + \"'\\\\''\";\n        \x7D else \x7B\n            out = " +
    ("out + c.toString();\n        \x7D\n        i = i + 1;\n    \x7D\n    return out + \"'\";\n\x7D\n\nfunc emptyResult(ok: bool, error: string): QueryResult \x7B\n    return QueryResult \x7B\n        columns: Vec.new(),\n  " +
    "      rows: Vec.new(),\n        changes: 0,\n        ok: ok,\n        error: error,\n    \x7D;\n\x7D\n\nfunc parseChanges(value: string): int \x7B\n    var result = 0;\n    var i = 0;\n    loop \x7B\n        if i >="))) +
    ((" value.len() \x7B break; \x7D\n        var digit = int(value[i]) - 48;\n        if digit < 0 || digit > 9 \x7B return 0; \x7D\n        result = result * 10 + digit;\n        i = i + 1;\n    \x7D\n    return result" +
    ";\n\x7D\n\nfunc parseOutput(output: string): QueryResult \x7B\n    var lines = output.split(\"\\n\");\n    var lineCount = lines.len();\n    if lineCount > 0 && lines[lineCount - 1] == \"\" \x7B\n        lineCount") +
    (" = lineCount - 1;\n    \x7D\n\n    var changes = 0;\n    if lineCount >= 2 && lines[lineCount - 2] == \"__rey_changes\" \x7B\n        changes = parseChanges(lines[lineCount - 1]);\n        lineCount = lineC" +
    ("ount - 2;\n    \x7D\n\n    var columns: Vec<string> = Vec.new();\n    var rows: Vec<Vec<string>> = Vec.new();\n    if lineCount == 0 \x7B\n        var result = emptyResult(true, \"\");\n        result.change" +
    "s = changes;\n        return result;\n    \x7D\n\n    columns = lines[0].split(\"|\");\n    var rowIndex = 1;\n    loop \x7B\n        if rowIndex >= lineCount \x7B break; \x7D\n        rows.push(lines[rowIndex].spl")))) +
    ((("it(\"|\"));\n        rowIndex = rowIndex + 1;\n    \x7D\n\n    return QueryResult \x7B\n        columns: columns,\n        rows: rows,\n        changes: changes,\n        ok: true,\n        error: \"\",\n    \x7D;\n\x7D" +
    "\n\npub func connect(path: string): Connection \x7B\n    var sqlite = process.which(\"sqlite3\");\n    if sqlite.isNone() \x7B\n        return Connection \x7B path: path, driver: \"memory\" \x7D;\n    \x7D\n\n    // sql") +
    ("ite3 starts a new process for each call, so use a temporary file to\n    // preserve state for connections requested as :memory:.\n    if path == \":memory:\" \x7B\n        var temporaryPath = process" +
    (".tempDir() + \"/rey_sql_\" + nativeRandom().toString() + \".db\";\n        return Connection \x7B path: temporaryPath, driver: \"sqlite3-memory\" \x7D;\n    \x7D\n    return Connection \x7B path: path, driver: \"sq" +
    "lite3\" \x7D;\n\x7D\n\npub func execute(conn: Connection, sql: string): QueryResult \x7B\n    if conn.driver == \"memory\" \x7B\n        // The fallback intentionally provides a predictable empty mock only.\n     "))) +
    (("   return emptyResult(true, \"\");\n    \x7D\n\n    var script = sql + \"\\n;\\nSELECT changes() AS __rey_changes;\";\n    var input = \"printf '%s\\\\n' \" + shellQuote(script);\n    var command = input + \" | " +
    ("sqlite3 -header -separator '|' -- \" + shellQuote(conn.path);\n    var result = process.runDetailed(command);\n    if result.code != 0 \x7B\n        var error = result.stderr.trim();\n        if error" +
    ".len() == 0 \x7B\n            error = \"sqlite3 exited with code \" + result.code.toString();\n        \x7D\n        return emptyResult(false, error);\n    \x7D\n\n    return parseOutput(result.stdout);\n\x7D\n\npub")) +
    (" func query(conn: Connection, sql: string): QueryResult \x7B\n    return execute(conn, sql);\n\x7D\n\npub func escapeString(val: string): string \x7B\n    var out = \"\";\n    var i = 0;\n    loop \x7B\n        if " +
    ("i >= val.len() \x7B break; \x7D\n        var c = val[i];\n        if c == '\\'' \x7B\n            out = out + \"''\";\n        \x7D else \x7B\n            out = out + c.toString();\n        \x7D\n        i = i + 1;\n    \x7D" +
    "\n    return out;\n\x7D\n\npub func close(conn: Connection): void \x7B\n    if conn.driver == \"sqlite3-memory\" && fileExists(conn.path) \x7B\n        deleteFile(conn.path);\n    \x7D\n\x7D\n")))));
