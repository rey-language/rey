func embeddedStdSource13Part0(): string {
    return ((("// JSON string escaping and small JSON serialization helpers.\n\nfunc hexDigit(value: int): string \x7B\n    return \"0123456789abcdef\"[value].toString();\n\x7D\n\npub func escapeString(s: string): string " +
    "\x7B\n    var out = \"\";\n    var i = 0;\n    loop \x7B\n        if i >= s.len() \x7B break; \x7D\n        var c = s[i];\n        if c == '\"' \x7B\n            out = out + \"\\\\\\\"\";\n        \x7D else if c == '\\\\' \x7B\n     ") +
    ("       out = out + \"\\\\\\\\\";\n        \x7D else if c == '\\n' \x7B\n            out = out + \"\\\\n\";\n        \x7D else if c == '\\r' \x7B\n            out = out + \"\\\\r\";\n        \x7D else if c == '\\t' \x7B\n            o" +
    ("ut = out + \"\\\\t\";\n        \x7D else \x7B\n            var code = int(c);\n            if code < 32 \x7B\n                out = out + \"\\\\u00\" + hexDigit(code / 16) + hexDigit(code % 16);\n            \x7D else" +
    " \x7B\n                out = out + c.toString();\n            \x7D\n        \x7D\n        i = i + 1;\n    \x7D\n    return out;\n\x7D\n\npub func stringifyString(s: string): string \x7B\n    return \"\\\"\" + escapeString(s)"))) +
    ((" + \"\\\"\";\n\x7D\n\npub func stringifyInt(n: int): string \x7B\n    return n.toString();\n\x7D\n\npub func stringifyFloat(f: float): string \x7B\n    return f.toString();\n\x7D\n\npub func stringifyBool(b: bool): string " +
    ("\x7B\n    if b \x7B\n        return \"true\";\n    \x7D\n    return \"false\";\n\x7D\n\n// Array entries are already-serialized JSON values, which allows nesting.\npub func stringifyArray(items: Vec<string>): string " +
    "\x7B\n    var out = \"[\";\n    var i = 0;\n    loop \x7B\n        if i >= items.len() \x7B break; \x7D\n        if i > 0 \x7B\n            out = out + \",\";\n        \x7D\n        out = out + items[i];\n        i = i + 1;")) +
    ("\n    \x7D\n    return out + \"]\";\n\x7D\n\n// Each object entry is [plain string key, serialized JSON value].\npub func stringifyObject(entries: Vec<Vec<string>>): string \x7B\n    var out = \"\x7B\x7B\";\n    var i =" +
    (" 0;\n    loop \x7B\n        if i >= entries.len() \x7B break; \x7D\n        if i > 0 \x7B\n            out = out + \",\";\n        \x7D\n        var entry = entries[i];\n        assert(entry.len() == 2, \"std::json.st" +
    "ringifyObject expects [key, value] entries\");\n        out = out + stringifyString(entry[0]) + \":\" + entry[1];\n        i = i + 1;\n    \x7D\n    return out + \"\x7D\x7D\";\n\x7D\n"))));
}

