    "          inQuotes = false;\n            \x7D\n        \x7D else if c == '\"' \x7B\n            inQuotes = true;\n        \x7D else if c == '=' \x7B\n            return i;\n        \x7D\n        i = i + 1;\n    \x7D\n    re"))) +
    ((("turn -1;\n\x7D\n\nfunc decodeString(value: string): string \x7B\n    var result = \"\";\n    var i = 1;\n    var end = value.len() - 1;\n    loop \x7B\n        if i >= end \x7B break; \x7D\n        var c = value[i];\n  " +
    "      if c == '\\\\' && i + 1 < end \x7B\n            var next = value[i + 1];\n            if next == 'n' \x7B\n                result = result + \"\\n\";\n            \x7D else if next == 'r' \x7B\n              ") +
