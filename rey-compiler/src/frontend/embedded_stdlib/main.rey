    " home: Option<string> = getEnv(\"HOME\");\n    if home.isSome() \x7B\n        return home.unwrap();\n    \x7D\n    home = getEnv(\"USERPROFILE\");\n    if home.isSome() \x7B\n        return home.unwrap();\n    \x7D\n") +
