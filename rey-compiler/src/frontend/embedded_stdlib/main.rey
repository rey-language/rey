func embeddedStdSource11Part0(): string {
    return ((("// RGB image buffers with PPM text serialization.\n\npub struct Image \x7B\n    pub width: int,\n    pub height: int,\n    pub pixels: Vec<int>,\n\x7D\n\npub func createImage(width: int, height: int): Image" +
    " \x7B\n    assert(width >= 0 && height >= 0, \"image dimensions must be non-negative\");\n    var pixels: Vec<int> = Vec.new();\n    var count = width * height;\n    var i = 0;\n    loop \x7B\n        if i ") +
    (">= count \x7B break; \x7D\n        pixels.push(0);\n        i = i + 1;\n    \x7D\n    return Image \x7B width: width, height: height, pixels: pixels \x7D;\n\x7D\n\npub func setPixel(img: Image, x: int, y: int, r: int," +
    (" g: int, b: int): void \x7B\n    assert(x >= 0 && x < img.width && y >= 0 && y < img.height, \"pixel coordinate is outside the image\");\n    assert(r >= 0 && r <= 255 && g >= 0 && g <= 255 && b >= 0" +
    " && b <= 255, \"RGB channels must be in 0..255\");\n    img.pixels.set(y * img.width + x, r * 65536 + g * 256 + b);\n\x7D\n\npub func getPixel(img: Image, x: int, y: int): Vec<int> \x7B\n    assert(x >= 0 "))) +
    (("&& x < img.width && y >= 0 && y < img.height, \"pixel coordinate is outside the image\");\n    var packed = img.pixels[y * img.width + x];\n    var rgb: Vec<int> = Vec.new();\n    rgb.push(packed /" +
    (" 65536);\n    rgb.push((packed / 256) % 256);\n    rgb.push(packed % 256);\n    return rgb;\n\x7D\n\npub func toPpm(img: Image): string \x7B\n    assert(img.width >= 0 && img.height >= 0 && img.pixels.len(" +
    ") == img.width * img.height, \"image buffer dimensions do not match its pixels\");\n    var ppm = \"P3\\n\" + img.width.toString() + \" \" + img.height.toString() + \"\\n255\\n\";\n    var i = 0;\n    loop ")) +
    ("\x7B\n        if i >= img.pixels.len() \x7B break; \x7D\n        var packed = img.pixels[i];\n        ppm = ppm + (packed / 65536).toString() + \" \"\n            + ((packed / 256) % 256).toString() + \" \"\n  " +
    ("          + (packed % 256).toString();\n        if (i + 1) % img.width != 0 \x7B ppm = ppm + \" \"; \x7D\n        if (i + 1) % img.width == 0 \x7B ppm = ppm + \"\\n\"; \x7D\n        i = i + 1;\n    \x7D\n    return pp" +
    "m;\n\x7D\n\npub func writePpm(img: Image, path: string): bool \x7B\n    writeFile(path, toPpm(img));\n    return fileExists(path);\n\x7D\n"))));
}

