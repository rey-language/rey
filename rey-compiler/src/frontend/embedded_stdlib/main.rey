    "extIndex + 1);\n    \x7D\n\n    var positions: Vec<int> = Vec.new();\n    positions.push(textIndex);\n    var cursor = textIndex;\n    var limit = text.len();\n    if quantifier == '?' \x7B limit = textInd")))) +
    ((("ex + 1; \x7D\n    loop \x7B\n        if cursor >= limit \x7B break; \x7D\n        if !atomMatches(pattern, patternIndex, end, text, cursor) \x7B break; \x7D\n        cursor = cursor + 1;\n        positions.push(curs" +
    ("or);\n    \x7D\n\n    var minimum = 0;\n    if quantifier == '+' \x7B minimum = 1; \x7D\n    if positions.len() - 1 < minimum \x7B return -1; \x7D\n\n    var candidate = positions.len() - 1;\n    loop \x7B\n        if c" +
    "andidate < minimum \x7B break; \x7D\n        var result = matchFrom(pattern, nextPattern, text, positions[candidate]);\n        if result >= 0 \x7B return result; \x7D\n        candidate = candidate - 1;\n   ")) +
    (" \x7D\n    return -1;\n\x7D\n\nfunc findStartFrom(pattern: string, text: string, startAt: int): int \x7B\n    var first = startAt;\n    var last = text.len();\n    if pattern.len() > 0 && pattern[0] == '^' \x7B " +
    ("last = 0; \x7D\n    loop \x7B\n        if first > last \x7B break; \x7D\n        if matchFrom(pattern, 0, text, first) >= 0 \x7B return first; \x7D\n        first = first + 1;\n    \x7D\n    return -1;\n\x7D\n\npub func isMat" +
