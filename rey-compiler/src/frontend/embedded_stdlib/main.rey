func embeddedStdSource30Part0(): string {
    return (("// Time and simple duration formatting utilities.\n\npub func sleep(ms: int): void \x7B\n    nativeSleepMs(ms);\n\x7D\n\n// Format short durations in milliseconds and longer durations in seconds with\n// m" +
    "illisecond precision. This formatter is intended for nonnegative timings.\npub func formatDurationMs(ms: int): string \x7B\n    if ms < 1000 \x7B\n        return ms.toString() + \" ms\";\n    \x7D\n\n    var s") +
    ("econds = ms / 1000;\n    var remainingMs = ms % 1000;\n    var fraction = remainingMs.toString();\n    if remainingMs < 10 \x7B\n        fraction = \"00\" + fraction;\n    \x7D else if remainingMs < 100 \x7B\n" +
    ("        fraction = \"0\" + fraction;\n    \x7D\n    return seconds.toString() + \".\" + fraction + \" s\";\n\x7D\n\n// Add an `s` unit to Rey's standard float representation.\npub func formatDurationSeconds(sec" +
    ": float): string \x7B\n    return sec.toString() + \" s\";\n\x7D\n")));
}

