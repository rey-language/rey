    ("   i = i + 1;\n    \x7D\n    return hash;\n\x7D\n\npub func md5(data: string): string \x7B\n    var input = \"printf '%s' \" + shellQuote(data);\n    var macResult: Result<string, string> = exec(input + \" | md5" +
    " -q\");\n    if macResult.isOk() \x7B\n        var digest = macResult.unwrap().trim().toLower();\n        if digest.len() == 32 \x7B\n            return digest;\n        \x7D\n    \x7D\n\n    var linuxResult: Resu")))) +
    ((("lt<string, string> = exec(input + \" | md5sum\");\n    if linuxResult.isOk() \x7B\n        var digest = linuxResult.unwrap().trim().toLower();\n        if digest.len() >= 32 \x7B\n            return prefi" +
