    " \" \".repeat(pad + 1) + \"|\";\n        h = h + 1;\n    \x7D\n    println(headerStr);\n    println(sep);\n\n    var r = 0;\n    loop \x7B\n        if r >= rows.len() \x7B\n            break;\n        \x7D\n        var ")))) +
