    "tatus: 0, body: \"\", error: \"http: invalid status code: \" + statusStr \x7D;\n        \x7D\n        status = (status * 10) + (int(ch) - 48);\n        k = k + 1;\n    \x7D\n\n    return \x7B ok: true, status: stat")))) +
    ((("us, body: body, error: \"\" \x7D;\n\x7D\n\nfunc buildHeaders(headers: HashMap<string, string>): string \x7B\n    var out = \"\";\n    var entries = headers.entries();\n    var i = 0;\n    loop \x7B\n        if i >= e" +
