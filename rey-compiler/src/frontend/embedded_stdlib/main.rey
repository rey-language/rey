    "' || s[0] == '+' \x7B\n        i = 1;\n    \x7D\n    if i >= s.len() \x7B return false; \x7D\n    loop \x7B\n        if i >= s.len() \x7B break; \x7D\n        var c = s[i];\n        if c < '0' || c > '9' \x7B return false; ") +
