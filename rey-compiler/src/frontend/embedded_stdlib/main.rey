    (" spanSlice(s: Span, start: int, end: int): Span \x7B\n    assert(start >= 0 && start <= end && end <= s.length, \"spanSlice range is outside the span\");\n    return makeSpan(s.buffer, s.offset + sta" +
    "rt, end - start);\n\x7D\n\npub func copy(dest: Vec<any>, destOffset: int, src: Vec<any>, srcOffset: int, count: int): void \x7B\n    assert(destOffset >= 0 && srcOffset >= 0 && count >= 0, \"copy offsets"))) +
    ((" and count must be nonnegative\");\n    assert(destOffset + count <= dest.len(), \"copy destination range is outside the buffer\");\n    assert(srcOffset + count <= src.len(), \"copy source range is" +
    (" outside the buffer\");\n\n    // Stage values first so overlapping source and destination ranges are safe.\n    var staged: Vec<any> = Vec.new();\n    var i = 0;\n    loop \x7B\n        if i >= count \x7B" +
    " break; \x7D\n        staged.push(src[srcOffset + i]);\n        i = i + 1;\n    \x7D\n\n    var original: Vec<any> = Vec.new();\n    i = 0;\n    loop \x7B\n        if i >= dest.len() \x7B break; \x7D\n        origina")) +
