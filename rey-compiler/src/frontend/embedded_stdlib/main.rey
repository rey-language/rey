    ("\n\nfunc stripComment(line: string): string \x7B\n    var inQuotes = false;\n    var escaped = false;\n    var i = 0;\n    loop \x7B\n        if i >= line.len() \x7B break; \x7D\n        var c = line[i];\n        " +
    "if inQuotes \x7B\n            if escaped \x7B\n                escaped = false;\n            \x7D else if c == '\\\\' \x7B\n                escaped = true;\n            \x7D else if c == '\"' \x7B\n                inQuo")) +
