func embeddedStdSource27Part0(): string {
    return ((((("// String helpers implemented with Rey's built-in string operations.\n\nfunc isWhitespace(c: string): bool \x7B\n    return c == \" \" || c == \"\\n\" || c == \"\\t\" || c == \"\\r\";\n\x7D\n\nfunc isAsciiLetter(c: " +
    "string): bool \x7B\n    var code = c.hash();\n    return (code >= 65 && code <= 90) || (code >= 97 && code <= 122);\n\x7D\n\nfunc isAsciiDigit(c: string): bool \x7B\n    var code = c.hash();\n    return code ") +
    (">= 48 && code <= 57;\n\x7D\n\npub func trimStart(s: string): string \x7B\n    var start = 0;\n    loop \x7B\n        if start >= s.len() || !isWhitespace(slice(s, start, start + 1)) \x7B break; \x7D\n        start " +
    ("= start + 1;\n    \x7D\n    return slice(s, start, s.len());\n\x7D\n\npub func trimEnd(s: string): string \x7B\n    var end = s.len();\n    loop \x7B\n        if end <= 0 || !isWhitespace(slice(s, end - 1, end)) " +
    "\x7B break; \x7D\n        end = end - 1;\n    \x7D\n    return slice(s, 0, end);\n\x7D\n\npub func trim(s: string): string \x7B\n    return trimEnd(trimStart(s));\n\x7D\n\npub func startsWith(s: string, prefix: string): "))) +
    (("bool \x7B\n    if prefix.len() > s.len() \x7B return false; \x7D\n    var i = 0;\n    loop \x7B\n        if i >= prefix.len() \x7B break; \x7D\n        if s[i] != prefix[i] \x7B return false; \x7D\n        i = i + 1;\n    \x7D" +
    "\n    return true;\n\x7D\n\npub func endsWith(s: string, suffix: string): bool \x7B\n    if suffix.len() > s.len() \x7B return false; \x7D\n    var offset = s.len() - suffix.len();\n    var i = 0;\n    loop \x7B\n   ") +
    ("     if i >= suffix.len() \x7B break; \x7D\n        if s[offset + i] != suffix[i] \x7B return false; \x7D\n        i = i + 1;\n    \x7D\n    return true;\n\x7D\n\npub func indexOf(s: string, sub: string): int \x7B\n    if" +
    (" sub.len() == 0 \x7B return 0; \x7D\n    if sub.len() > s.len() \x7B return -1; \x7D\n    var i = 0;\n    loop \x7B\n        if i + sub.len() > s.len() \x7B break; \x7D\n        var found = true;\n        var j = 0;\n   " +
    "     loop \x7B\n            if j >= sub.len() \x7B break; \x7D\n            if s[i + j] != sub[j] \x7B found = false; break; \x7D\n            j = j + 1;\n        \x7D\n        if found \x7B return i; \x7D\n        i = i +")))) +
    (((" 1;\n    \x7D\n    return -1;\n\x7D\n\npub func lastIndexOf(s: string, sub: string, fromIndex: int = -1): int \x7B\n    var start = fromIndex;\n    if start == -1 \x7B start = s.len() - sub.len(); \x7D\n    if start" +
    " < 0 \x7B return -1; \x7D\n    if start > s.len() - sub.len() \x7B start = s.len() - sub.len(); \x7D\n    if start < 0 \x7B return -1; \x7D\n    if sub.len() == 0 \x7B return start; \x7D\n    var i = start;\n    loop \x7B\n  ") +
