    return ((("// Leveled logging. The selected threshold is stored in this process environment.\n\nimport std::string;\n\nfunc logAt(level: int, name: string, msg: string): void \x7B\n    if getLogLevel() <= level " +
    "\x7B\n        println(formatLog(name, msg));\n    \x7D\n\x7D\n\npub func levelTrace(): int \x7B\n    return 0;\n\x7D\n\npub func levelDebug(): int \x7B\n    return 1;\n\x7D\n\npub func levelInfo(): int \x7B\n    return 2;\n\x7D\n\npub f") +
    ("unc levelWarn(): int \x7B\n    return 3;\n\x7D\n\npub func levelError(): int \x7B\n    return 4;\n\x7D\n\npub func setLogLevel(level: int): void \x7B\n    assert(level >= levelTrace() && level <= levelError(), \"log l" +
    "evel must be between 0 and 4\");\n    nativeSetEnv(\"REY_STD_LOG_LEVEL\", level.toString());\n\x7D\n\npub func getLogLevel(): int \x7B\n    var stored: Option<string> = getEnv(\"REY_STD_LOG_LEVEL\");\n    if s")) +
    (("tored.isSome() \x7B\n        var parsed: Option<int> = string.parseInt(stored.unwrap());\n        if parsed.isSome() \x7B\n            var value = parsed.unwrap();\n            if value >= levelTrace() " +
    "&& value <= levelError() \x7B\n                return value;\n            \x7D\n        \x7D\n    \x7D\n    return levelInfo();\n\x7D\n\npub func trace(msg: string): void \x7B\n    logAt(levelTrace(), \"TRACE\", msg);\n\x7D\n\n") +
    ("pub func debug(msg: string): void \x7B\n    logAt(levelDebug(), \"DEBUG\", msg);\n\x7D\n\npub func info(msg: string): void \x7B\n    logAt(levelInfo(), \"INFO\", msg);\n\x7D\n\npub func warn(msg: string): void \x7B\n    " +
