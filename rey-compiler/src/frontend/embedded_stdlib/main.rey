    ("   \x7D\n\n    var border = \"+\" + \"-\".repeat(width + 2) + \"+\";\n    println(border);\n    println(\"| \" + title + \" \".repeat(width - title.len()) + \" |\");\n    println(border);\n\n    var j = 0;\n    loop" +
    " \x7B\n        if j >= lines.len() \x7B\n            break;\n        \x7D\n        println(\"| \" + lines[j] + \" \".repeat(width - lines[j].len()) + \" |\");\n        j = j + 1;\n    \x7D\n    println(border);\n\x7D\n")))));
