func embeddedStdSource6Part0(): string {
    return (((("// RFC 4180 style CSV parsing and serialization.\n\npub func parse(text: string): Vec<Vec<string>> \x7B\n    return parseWithDelimiter(text, \",\");\n\x7D\n\npub func parseWithDelimiter(text: string, delim:" +
    " string): Vec<Vec<string>> \x7B\n    assert(delim.len() == 1, \"CSV delimiter must be exactly one character\");\n\n    var rows: Vec<Vec<string>> = Vec.new();\n    if text.len() == 0 \x7B return rows; \x7D\n\n") +
    ("    var row: Vec<string> = Vec.new();\n    var field = \"\";\n    var inQuotes = false;\n    var endedWithRecordBreak = false;\n    var i = 0;\n    loop \x7B\n        if i >= text.len() \x7B break; \x7D\n      " +
    "  var c = text[i];\n\n        if inQuotes \x7B\n            if c == '\"' \x7B\n                if i + 1 < text.len() && text[i + 1] == '\"' \x7B\n                    field = field + \"\\\"\";\n                    ")) +
    (("i = i + 2;\n                \x7D else \x7B\n                    inQuotes = false;\n                    i = i + 1;\n                \x7D\n            \x7D else \x7B\n                field = field + c.toString();\n  " +
    "              i = i + 1;\n            \x7D\n            endedWithRecordBreak = false;\n        \x7D else if c == '\"' && field.len() == 0 \x7B\n            inQuotes = true;\n            endedWithRecordBreak ") +
    ("= false;\n            i = i + 1;\n        \x7D else if c == delim[0] \x7B\n            row.push(field);\n            field = \"\";\n            endedWithRecordBreak = false;\n            i = i + 1;\n        " +
    ("\x7D else if c == '\\n' \x7B\n            row.push(field);\n            rows.push(row);\n            row = Vec.new();\n            field = \"\";\n            endedWithRecordBreak = true;\n            i = i +" +
    " 1;\n        \x7D else if c == '\\r' && i + 1 < text.len() && text[i + 1] == '\\n' \x7B\n            row.push(field);\n            rows.push(row);\n            row = Vec.new();\n            field = \"\";\n   ")))) +
    ((("         endedWithRecordBreak = true;\n            i = i + 2;\n        \x7D else \x7B\n            field = field + c.toString();\n            endedWithRecordBreak = false;\n            i = i + 1;\n       " +
    " \x7D\n    \x7D\n\n    // A final line break already completed its record; do not add a phantom row.\n    if !endedWithRecordBreak \x7B\n        row.push(field);\n        rows.push(row);\n    \x7D\n    return row") +
    ("s;\n\x7D\n\npub func stringify(rows: Vec<Vec<string>>): string \x7B\n    return stringifyWithDelimiter(rows, \",\");\n\x7D\n\npub func stringifyWithDelimiter(rows: Vec<Vec<string>>, delim: string): string \x7B\n   " +
    (" assert(delim.len() == 1, \"CSV delimiter must be exactly one character\");\n    var out = \"\";\n    var i = 0;\n    loop \x7B\n        if i >= rows.len() \x7B break; \x7D\n        if i > 0 \x7B out = out + \"\\r\\n" +
    "\"; \x7D\n        var row = rows[i];\n        var j = 0;\n        loop \x7B\n            if j >= row.len() \x7B break; \x7D\n            if j > 0 \x7B out = out + delim; \x7D\n            var value = row[j];\n         "))) +
    (("   var needsQuotes = false;\n            var k = 0;\n            loop \x7B\n                if k >= value.len() \x7B break; \x7D\n                if value[k] == delim[0] || value[k] == '\"' || value[k] == '" +
