func embeddedStdSource28Part0(): string {
    return ((("// Synchronous state helpers. These do not provide cross-thread synchronization.\n\npub struct AtomicInt \x7B\n    pub val: int,\n\x7D\n\npub func atomicInt(initial: int): AtomicInt \x7B\n    return AtomicInt" +
    " \x7B val: initial \x7D;\n\x7D\n\npub func atomicGet(a: AtomicInt): int \x7B\n    return a.val;\n\x7D\n\npub func atomicSet(a: AtomicInt, v: int): void \x7B\n    a.val = v;\n\x7D\n\npub func atomicAdd(a: AtomicInt, delta: in") +
    ("t): int \x7B\n    a.val = a.val + delta;\n    return a.val;\n\x7D\n\npub func atomicSub(a: AtomicInt, delta: int): int \x7B\n    a.val = a.val - delta;\n    return a.val;\n\x7D\n\npub struct Mutex \x7B\n    pub locked:" +
    " bool,\n\x7D\n\npub func mutex(): Mutex \x7B\n    return Mutex \x7B locked: false \x7D;\n\x7D\n\n// lock is a nonblocking try-lock: it returns false when already locked.\npub func lock(m: Mutex): bool \x7B\n    if m.loc")) +
    (("ked \x7B return false; \x7D\n    m.locked = true;\n    return true;\n\x7D\n\npub func unlock(m: Mutex): void \x7B\n    m.locked = false;\n\x7D\n\npub struct Channel \x7B\n    pub queue: Vec<any>,\n\x7D\n\npub func channel(): C" +
    "hannel \x7B\n    return Channel \x7B queue: Vec.new() \x7D;\n\x7D\n\npub func send(ch: Channel, val: any): void \x7B\n    ch.queue.push(val);\n\x7D\n\n// recv removes the oldest queued value, or returns null when the q") +
    ("ueue is empty.\npub func recv(ch: Channel): any \x7B\n    if ch.queue.len() == 0 \x7B return null; \x7D\n    var value = ch.queue[0];\n    var remaining: Vec<any> = Vec.new();\n    var i = 1;\n    loop \x7B\n   " +
    "     if i >= ch.queue.len() \x7B break; \x7D\n        remaining.push(ch.queue[i]);\n        i = i + 1;\n    \x7D\n    ch.queue = remaining;\n    return value;\n\x7D\n")));
}

