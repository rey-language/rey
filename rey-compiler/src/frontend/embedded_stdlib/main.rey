    ("       j = j + 1;\n        \x7D\n        if found \x7B return i; \x7D\n        i = i - 1;\n    \x7D\n    return -1;\n\x7D\n\npub func contains(s: string, sub: string): bool \x7B\n    return indexOf(s, sub) >= 0;\n\x7D\n\npub " +
    "func replace(s: string, from: string, to: string): string \x7B\n    if from.len() == 0 \x7B return s; \x7D\n    var at = indexOf(s, from);\n    if at < 0 \x7B return s; \x7D\n    return slice(s, 0, at) + to + sl"))) +
    (("ice(s, at + from.len(), s.len());\n\x7D\n\npub func replaceAll(s: string, from: string, to: string): string \x7B\n    if from.len() == 0 \x7B return s; \x7D\n    var result = \"\";\n    var i = 0;\n    loop \x7B\n    " +
