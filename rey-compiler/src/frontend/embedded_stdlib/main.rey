func embeddedStdSource9Part0(): string {
    return (((("// Filesystem helpers built on the compiler's native filesystem operations.\n\npub func read(path: string): string \x7B\n    return readFile(path);\n\x7D\n\npub func write(path: string, content: string): " +
    ("void \x7B\n    writeFile(path, content);\n\x7D\n\npub func append(path: string, content: string): void \x7B\n    appendFile(path, content);\n\x7D\n\npub func exists(path: string): bool \x7B\n    return fileExists(pat" +
    "h);\n\x7D\n\npub func remove(path: string): void \x7B\n    deleteFile(path);\n\x7D\n\npub func mkdir(path: string): void \x7B\n    nativeMkdir(path);\n\x7D\n\npub func mkdirAll(path: string): void \x7B\n    nativeMkdirAll(")) +
    ("path);\n\x7D\n\npub func removeDir(path: string): void \x7B\n    nativeRemoveDir(path);\n\x7D\n\npub func removeDirAll(path: string): void \x7B\n    nativeRemoveDirAll(path);\n\x7D\n\npub func isFile(path: string): boo" +
    ("l \x7B\n    return nativeIsFile(path);\n\x7D\n\npub func isDir(path: string): bool \x7B\n    return nativeIsDir(path);\n\x7D\n\n// list returns entry names (not full paths)\npub func list(path: string): Vec<string" +
    "> \x7B\n    return listDir(path);\n\x7D\n\n// listPaths returns full paths for entries\npub func listPaths(path: string): Vec<string> \x7B\n    return nativeListDirPaths(path);\n\x7D\n\npub func join(a: string, b:"))) +
    ((" string): string \x7B\n    return nativePathJoin(a, b);\n\x7D\n\npub func basename(path: string): string \x7B\n    return nativeBasename(path);\n\x7D\n\npub func dirname(path: string): string \x7B\n    return nativeD" +
    ("irname(path);\n\x7D\n\n// extname returns the extension without a leading dot, or \"\".\npub func extname(path: string): string \x7B\n    return nativeExtname(path);\n\x7D\n\npub func copy(src: string, dst: stri" +
    "ng): void \x7B\n    nativeCopyFile(src, dst);\n\x7D\n\npub func move(src: string, dst: string): void \x7B\n    nativeMoveFile(src, dst);\n\x7D\n\n// Creates an empty file when path does not already exist. Existin")) +
    (("g files are\n// left untouched, including their contents.\npub func touch(path: string): void \x7B\n    if !exists(path) \x7B\n        write(path, \"\");\n    \x7D\n\x7D\n\n// Reads newline-delimited text. A final " +
    "line feed does not create an extra\n// empty item, and CRLF line endings are returned without the carriage return.\npub func readLines(path: string): Vec<string> \x7B\n    var contents = read(path);") +
    ("\n    var lines: Vec<string> = Vec.new();\n    if contents == \"\" \x7B\n        return lines;\n    \x7D\n    var splitLines = contents.split(\"\\n\");\n    var i = 0;\n    loop \x7B\n        if i >= splitLines.len" +
    "() \x7B\n            break;\n        \x7D\n        // A final delimiter terminates the preceding line; it is not a line.\n        if i == splitLines.len() - 1 && splitLines[i] == \"\" && contents.endsWith")))) +
