func embeddedStdSource29Part0(): string {
    return (("// Assertions and reporting helpers for standard library tests.\n\npub func assertEq(actual, expected, msg: string): void \x7B\n    assert(actual == expected, msg);\n\x7D\n\npub func assertNotEq(actual, e" +
    "xpected, msg: string): void \x7B\n    assert(actual != expected, msg);\n\x7D\n\npub func assertTrue(condition: bool, msg: string): void \x7B\n    assert(condition, msg);\n\x7D\n\npub func assertFalse(condition: b") +
    ("ool, msg: string): void \x7B\n    assert(!condition, msg);\n\x7D\n\npub func assertApprox(actual: float, expected: float, epsilon: float, msg: string): void \x7B\n    var difference = actual - expected;\n   " +
    (" if difference < 0.0 \x7B\n        difference = -difference;\n    \x7D\n    assert(difference <= epsilon, msg);\n\x7D\n\npub func pass(msg: string): void \x7B\n    println(\"PASS: \" + msg);\n\x7D\n\npub func fail(msg: " +
    "string): void \x7B\n    println(\"FAIL: \" + msg);\n    assert(false, msg);\n\x7D\n")));
}

