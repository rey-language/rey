    " = Vec.new();\n    var i = 0;\n    loop \x7B\n        if i >= headers.len() \x7B\n            break;\n        \x7D\n        var width = headers[i].len();\n        var j = 0;\n        loop \x7B\n            if j >="))) +
    ((" rows.len() \x7B\n                break;\n            \x7D\n            if i < rows[j].len() \x7B\n                var rowLen = rows[j][i].len();\n                if rowLen > width \x7B\n                    wid" +
    "th = rowLen;\n                \x7D\n            \x7D\n            j = j + 1;\n        \x7D\n        colWidths.push(width);\n        i = i + 1;\n    \x7D\n\n    var sep = \"\";\n    var k = 0;\n    loop \x7B\n        if k ") +
