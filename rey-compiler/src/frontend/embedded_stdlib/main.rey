func embeddedStdSource8Part0(): string {
    return (((("// Small string formatting and integer radix helpers.\n\npub func format(template: string, args: Vec<any>): string \x7B\n    var output = \"\";\n    var index = 0;\n    var nextAutomatic = 0;\n\n    loop " +
    "\x7B\n        if index >= template.len() \x7B break; \x7D\n        if template[index] != '\x7B' \x7B\n            output = output + template[index].toString();\n            index = index + 1;\n            continu") +
    ("e;\n        \x7D\n\n        var close = index + 1;\n        loop \x7B\n            if close >= template.len() || template[close] == '\x7D' \x7B break; \x7D\n            close = close + 1;\n        \x7D\n        if clos" +
    "e >= template.len() \x7B\n            output = output + template[index].toString();\n            index = index + 1;\n            continue;\n        \x7D\n\n        var token = template.slice(index + 1, cl")) +
    (("ose);\n        var argumentIndex = -1;\n        if token.len() == 0 \x7B\n            argumentIndex = nextAutomatic;\n            nextAutomatic = nextAutomatic + 1;\n        \x7D else \x7B\n            var p" +
    "arsedIndex = 0;\n            var validIndex = true;\n            var digitIndex = 0;\n            loop \x7B\n                if digitIndex >= token.len() \x7B break; \x7D\n                var digit = int(to") +
    ("ken[digitIndex]) - 48;\n                if digit < 0 || digit > 9 \x7B\n                    validIndex = false;\n                    break;\n                \x7D\n                if validIndex \x7B\n        " +
    "            if parsedIndex > args.len() / 10 || (parsedIndex == args.len() / 10 && digit > args.len() % 10) \x7B\n                        validIndex = false;\n                    \x7D else \x7B\n         "))) +
    ((("               parsedIndex = parsedIndex * 10 + digit;\n                    \x7D\n                \x7D\n                digitIndex = digitIndex + 1;\n            \x7D\n            if validIndex \x7B argumentIn" +
    "dex = parsedIndex; \x7D\n        \x7D\n\n        if argumentIndex >= 0 && argumentIndex < args.len() \x7B\n            var rendered: string = args[argumentIndex].toString();\n            output = output + r") +
    ("endered;\n        \x7D else \x7B\n            output = output + template.slice(index, close + 1);\n        \x7D\n        index = close + 1;\n    \x7D\n\n    return output;\n\x7D\n\npub func padLeft(s: string, width: i" +
    "nt, pad: string): string \x7B\n    if width <= s.len() || pad.len() == 0 \x7B return s; \x7D\n    var needed = width - s.len();\n    return pad.repeat(needed).slice(0, needed) + s;\n\x7D\n\npub func padRight(s:")) +
    ((" string, width: int, pad: string): string \x7B\n    if width <= s.len() || pad.len() == 0 \x7B return s; \x7D\n    var needed = width - s.len();\n    return s + pad.repeat(needed).slice(0, needed);\n\x7D\n\nfun" +
    "c toRadix(value: int, radix: int): string \x7B\n    var digits = \"0123456789abcdef\";\n    if value == 0 \x7B return \"0\"; \x7D\n\n    var negative = value < 0;\n    var remaining = value;\n    var output = \"\"") +
    (";\n    loop \x7B\n        if remaining == 0 \x7B break; \x7D\n        var digit = remaining % radix;\n        if digit < 0 \x7B digit = -digit; \x7D\n        output = digits[digit].toString() + output;\n        re" +
    ("maining = remaining / radix;\n    \x7D\n    if negative \x7B return \"-\" + output; \x7D\n    return output;\n\x7D\n\npub func toHex(val: int): string \x7B\n    return toRadix(val, 16);\n\x7D\n\npub func toBin(val: int): s" +
    "tring \x7B\n    return toRadix(val, 2);\n\x7D\n\npub func toOct(val: int): string \x7B\n    return toRadix(val, 8);\n\x7D\n")))));
