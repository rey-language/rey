    (";\n            if digits > 3 || value > 255 \x7B return Vec.new(); \x7D\n        \x7D\n        i = i + 1;\n    \x7D\n\n    if digits == 0 || digits > 3 || octets.len() != 3 || value > 255 \x7B\n        return Vec.n" +
    "ew();\n    \x7D\n    octets.push(value);\n    return octets;\n\x7D\n\npub func isIpv4(host: string): bool \x7B\n    return parseIpv4(host).len() == 4;\n\x7D\n\nfunc isPingHost(host: string): bool \x7B\n    if host.len(")) +
