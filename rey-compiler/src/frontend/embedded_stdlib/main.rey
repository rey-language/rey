    ("[textIndex]);\n    loop \x7B\n        if i >= last \x7B break; \x7D\n        if i + 2 < last && pattern[i + 1] == '-' \x7B\n            var lower = int(pattern[i]);\n            var upper = int(pattern[i + 2])" +
