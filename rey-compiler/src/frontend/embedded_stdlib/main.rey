    return ((("// Process Module\n// Pure Rey wrapper around native process builtins\n\npub func args(): Vec<string> \x7B\n    return nativeArgs();\n\x7D\n\npub func exit(code: int): void \x7B\n    nativeExit(code);\n\x7D\n\npub f" +
    "unc env(key: string): Option<string> \x7B\n    return getEnv(key);\n\x7D\n\npub func setEnv(key: string, value: string): void \x7B\n    nativeSetEnv(key, value);\n\x7D\n\npub func unsetEnv(key: string): void \x7B\n  ") +
    ("  nativeUnsetEnv(key);\n\x7D\n\npub func envAll(): HashMap<string, string> \x7B\n    return nativeEnvAll();\n\x7D\n\npub func cwd(): string \x7B\n    return nativeCwd();\n\x7D\n\npub func chdir(path: string): void \x7B\n  " +
    ("  nativeChdir(path);\n\x7D\n\npub func tempDir(): string \x7B\n    return nativeTempDir();\n\x7D\n\npub func sleepMs(ms: int): void \x7B\n    nativeSleepMs(ms);\n\x7D\n\npub func which(name: string): Option<string> \x7B\n " +
    "   return nativeWhich(name);\n\x7D\n\n// run executes a shell command and returns Result<string, string>\npub func run(cmd: string): Result<string, string> \x7B\n    return exec(cmd);\n\x7D\n\n// runDetailed e"))) +
    (("xecutes a shell command and returns \x7Bcode, stdout, stderr\x7D\npub func runDetailed(cmd: string): any \x7B\n    return nativeExecDetailed(cmd);\n\x7D\n\n// Windows sets OS=Windows_NT for normal user process" +
    "es. The case-insensitive\n// comparison also accepts compatible environments that vary the casing.\npub func isWindows(): bool \x7B\n    var os: Option<string> = getEnv(\"OS\");\n    if os.isSome() \x7B\n ") +
    ("       return os.unwrap().toLower() == \"windows_nt\";\n    \x7D\n    return false;\n\x7D\n\n// `uname` is provided by macOS and Linux. On Windows, this command normally\n// exits unsuccessfully and both he" +
    ("lpers return false.\npub func isMac(): bool \x7B\n    var result = nativeExecDetailed(\"uname -s\");\n    return result.code == 0 && result.stdout.trim() == \"Darwin\";\n\x7D\n\npub func isLinux(): bool \x7B\n   " +
    " var result = nativeExecDetailed(\"uname -s\");\n    return result.code == 0 && result.stdout.trim() == \"Linux\";\n\x7D\n"))));
