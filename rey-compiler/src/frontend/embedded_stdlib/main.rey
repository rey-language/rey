    "out + c.toString();\n        \x7D\n        i = i + 1;\n    \x7D\n    return out + \"'\";\n\x7D\n\nfunc hexValue(c: char): int \x7B\n    var code = int(c);\n    if code >= 48 && code <= 57 \x7B\n        return code - 48;")) +
    ("\n    \x7D\n    if code >= 97 && code <= 102 \x7B\n        return code - 87;\n    \x7D\n    return -1;\n\x7D\n\nfunc prefix(value: string, length: int): string \x7B\n    var out = \"\";\n    var i = 0;\n    loop \x7B\n      " +
