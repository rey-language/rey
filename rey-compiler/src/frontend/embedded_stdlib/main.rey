func embeddedStdSource7Part0(): string {
    return (("// Convenience accessors for the process environment.\n\npub func get(key: string): any \x7B\n    return getEnv(key);\n\x7D\n\npub func getOr(key: string, defaultVal: string): string \x7B\n    var value: Opti" +
    "on<string> = getEnv(key);\n    if value.isSome() \x7B\n        return value.unwrap();\n    \x7D\n    return defaultVal;\n\x7D\n\npub func set(key: string, value: string): void \x7B\n    nativeSetEnv(key, value);\n") +
    ("\x7D\n\npub func remove(key: string): void \x7B\n    nativeUnsetEnv(key);\n\x7D\n\npub func has(key: string): bool \x7B\n    var value: Option<string> = getEnv(key);\n    return value.isSome();\n\x7D\n\npub func all():" +
    " any \x7B\n    var values: HashMap<string, string> = nativeEnvAll();\n    return values;\n\x7D\n"));
