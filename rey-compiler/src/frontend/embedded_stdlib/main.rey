    "d = 0;\n    if total <= 0 \x7B\n        if current > 0 \x7B\n            filled = safeWidth;\n        \x7D\n    \x7D else if current >= total \x7B\n        filled = safeWidth;\n    \x7D else if current > 0 && safeWidt"))) +
    (("h > 0 \x7B\n        filled = current * safeWidth / total;\n    \x7D\n    return \"[\" + \"=\".repeat(filled) + \" \".repeat(safeWidth - filled) + \"]\";\n\x7D\n\n// Prints the title and content inside an ASCII box. " +
