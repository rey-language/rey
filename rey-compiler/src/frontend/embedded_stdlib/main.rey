    return ((("// Operating-system details backed by the host environment and standard commands.\n\nfunc unameValue(): string \x7B\n    var result: Result<string, string> = exec(\"uname -s\");\n    if result.isOk() \x7B" +
    ("\n        return result.unwrap().trim();\n    \x7D\n    return \"\";\n\x7D\n\npub func name(): string \x7B\n    var os: Option<string> = getEnv(\"OS\");\n    if os.isSome() && os.unwrap().toLower() == \"windows_nt\"" +
    " \x7B\n        return \"windows\";\n    \x7D\n\n    var value = unameValue();\n    if value == \"Darwin\" \x7B\n        return \"macos\";\n    \x7D\n    if value == \"Linux\" \x7B\n        return \"linux\";\n    \x7D\n    if value ")) +
    (("== \"Windows\" || value == \"MINGW\" || value == \"MSYS\" \x7B\n        return \"windows\";\n    \x7D\n    return \"unknown\";\n\x7D\n\npub func arch(): string \x7B\n    var value = \"\";\n    var architecture: Option<string" +
    "> = getEnv(\"PROCESSOR_ARCHITEW6432\");\n    if architecture.isSome() \x7B\n        value = architecture.unwrap();\n    \x7D else \x7B\n        architecture = getEnv(\"PROCESSOR_ARCHITECTURE\");\n        if arc") +
    ("hitecture.isSome() \x7B\n            value = architecture.unwrap();\n        \x7D\n    \x7D\n\n    if value == \"\" \x7B\n        var result: Result<string, string> = exec(\"uname -m\");\n        if result.isOk() \x7B\n" +
    "            value = result.unwrap().trim();\n        \x7D\n    \x7D\n\n    value = value.toLower();\n    if value == \"aarch64\" || value == \"arm64\" \x7B\n        return \"arm64\";\n    \x7D\n    if value == \"amd64\" "))) +
    (("|| value == \"x64\" || value == \"x86_64\" \x7B\n        return \"x86_64\";\n    \x7D\n    if value == \"i386\" || value == \"i686\" || value == \"x86\" \x7B\n        return \"x86\";\n    \x7D\n    return value;\n\x7D\n\npub func " +
    ("eol(): string \x7B\n    if name() == \"windows\" \x7B\n        return \"\\r\\n\";\n    \x7D\n    return \"\\n\";\n\x7D\n\npub func hostname(): string \x7B\n    var result: Result<string, string> = exec(\"hostname\");\n    if re" +
    "sult.isOk() \x7B\n        var value = result.unwrap().trim();\n        if value != \"\" \x7B\n            return value;\n        \x7D\n    \x7D\n\n    var host: Option<string> = getEnv(\"HOSTNAME\");\n    if host.isS")) +
