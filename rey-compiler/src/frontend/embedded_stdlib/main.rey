    "turn line;\n\x7D\n\nfunc findUnquotedEquals(line: string): int \x7B\n    var inQuotes = false;\n    var escaped = false;\n    var i = 0;\n    loop \x7B\n        if i >= line.len() \x7B break; \x7D\n        var c = li") +
