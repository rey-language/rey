    (("        \x7D\n    \x7D\n    return found;\n\x7D\n\nfunc matchFrom(pattern: string, patternIndex: int, text: string, textIndex: int): int \x7B\n    if patternIndex >= pattern.len() \x7B return textIndex; \x7D\n    if p" +
    ("atternIndex == 0 && pattern[patternIndex] == '^' \x7B\n        return matchFrom(pattern, patternIndex + 1, text, textIndex);\n    \x7D\n    if pattern[patternIndex] == '$' && patternIndex == pattern.le" +
    "n() - 1 \x7B\n        if textIndex == text.len() \x7B return textIndex; \x7D\n        return -1;\n    \x7D\n\n    var end = atomEnd(pattern, patternIndex);\n    var quantifier = '\\0';\n    if end < pattern.len()")) +
    (" \x7B\n        if pattern[end] == '*' || pattern[end] == '+' || pattern[end] == '?' \x7B\n            quantifier = pattern[end];\n        \x7D\n    \x7D\n    var nextPattern = end;\n    if quantifier != '\\0' \x7B " +
