// Rey Compiler - Full Pipeline

import lexer;
import parser;

struct CompileResult {
    pub ok: bool,
    pub errors: String,
    pub ir: String,
    pub outputPath: String,
}

func compileSource(source: String, path: String, cmd: String) {
    var lexResult = lexer.tokenize(source, path);
    if lexResult.errors.length() > 0 {
        return CompileResult { ok: false, errors: "lexer error", ir: "", outputPath: "" };
    }
    
    var parseResult = parser.parse(lexResult.tokens, path);
    if parseResult.errors.length() > 0 {
        return CompileResult { ok: false, errors: "parse error", ir: "", outputPath: "" };
    }

    // bootstrap mode: lexer+parser only for now
    return CompileResult { ok: true, errors: "ok", ir: "", outputPath: "" };
}

func compileFile(entryPath: String, cmd: String) {
    var exists = fileExists(entryPath);
    if !exists {
        return CompileResult { ok: false, errors: "file not found", ir: "", outputPath: "" };
    }
    
    var content = readFile(entryPath);
    return compileSource(content, entryPath, cmd);
}

func main() {
    var cliArgs = args();
    if cliArgs.length() < 2 {
        println("Usage: reyc <build|run|check> <file>");
    } else {
        var cmd = cliArgs[1];
        var path = cliArgs[2];
        
        var result = compileFile(path, cmd);
        
        if result.ok {
            println("Success: " + result.outputPath);
            if cmd == "run" {
                exec(result.outputPath);
            }
        } else {
            println("Error: " + result.errors);
        }
    }
}
