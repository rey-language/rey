// Typechecker Implementation for Rey

enum TypeKind {
    Any,
    Void,
    Bool,
    Int,
    Float,
    String,
    Char,
    Null,
    Array,
    Dict,
    Tuple,
    Struct,
    Enum,
    Function,
    Option,
    Result,
    Union,
    Unknown,
}

struct Type {
    pub kind: String,
    pub name: String,
    pub inner: Type?,
    pub key: Type?,
    pub value: Type?,
    pub params: [Type],
    pub ret: Type?,
}

struct Symbol {
    pub name: String,
    pub ty: Type,
    pub isConst: bool,
}

struct TypeEnv {
    pub symbols: HashMap,
    pub parent: TypeEnv?,
}

struct TypeError {
    pub message: String,
    pub span: int,
}

struct TypecheckResult {
    pub ok: bool,
    pub errors: [TypeError],
}

func newType(kind) {
    return Type { kind: kind, name: "", inner: null, key: null, value: null, params: [], ret: null };
}

func newTypeNamed(kind, name: String) {
    return Type { kind: kind, name: name, inner: null, key: null, value: null, params: [], ret: null };
}

func newFunctionType(params, ret) {
    return Type { kind: "Function", name: "", inner: null, key: null, value: null, params: params, ret: ret };
}

func newArrayType(inner) {
    var t = newType("Array");
    t.inner = inner;
    return t;
}

func newOptionType(inner) {
    var t = newType("Option");
    t.inner = inner;
    return t;
}

func newResultType(ok, err) {
    var t = newType("Result");
    t.inner = ok;
    t.key = err;
    return t;
}

func typeEqual(a, b): bool {
    if a.kind == "Any" || b.kind == "Any" {
        return true;
    }
    if a.kind != b.kind {
        return false;
    }
    if a.kind == "Struct" || a.kind == "Enum" {
        return a.name == b.name;
    }
    return true;
}

func envNew() {
    return TypeEnv { symbols: HashMap.new(), parent: null };
}

func envDefine(env, name: String, ty, isConst: bool) {
    env.symbols.set(name, Symbol { name: name, ty: ty, isConst: isConst });
}

func envResolve(env, name: String) {
    if env.symbols.has(name) {
        return env.symbols.get(name);
    }
    if env.parent != null {
        return envResolve(env.parent, name);
    }
    return Symbol { name: "", ty: newType("Unknown"), isConst: false };
}

func inferExpr(env, expr) {
    // Implementation would infer types based on expression kind
    return newType("Any");
}

func inferStmt(env, stmt) {
    return [];
}

func typecheckProgram(program) {
    // bootstrap mode: don't typecheck yet
    return TypecheckResult { ok: true, errors: [] };
}

export pub func typecheck(program) {
    return typecheckProgram(program);
}
