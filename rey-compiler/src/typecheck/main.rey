        Expr::Identifier(_) => { return null; },
        Expr::Binary(_) => { return null; },
        Expr::Unary(_) => { return null; },
        Expr::Update(_) => { return null; },
        Expr::Call(_) => { return null; },
        Expr::EnumVariant(_) => { return null; },
        Expr::Index(_) => { return null; },
        Expr::FieldAccess(_) => { return null; },
        Expr::Lambda(_) => { return null; },
        Expr::Match(_) => { return null; },
        Expr::If(_) => { return null; },
        Expr::Tuple(_) => { return null; },
        Expr::Array(_) => { return null; },
        Expr::Dict(_) => { return null; },
        Expr::StructLiteral(_) => { return null; },
    }
    return null;
}

func returnedExpressionHasValue(retStmt: ReturnStmt): bool {
    if !isNullExpression(retStmt.value) { return true; }
    return exprSpan(retStmt.value).start != retStmt.span.start;
}

func isNullExpression(expr: Expr): bool {
    match expr {
        Expr::Error(_) => { return false; },
        Expr::Literal(payload) => { return payload.kind == LiteralKind::Null; },
        Expr::Identifier(_) => { return false; },
        Expr::Binary(_) => { return false; },
        Expr::Unary(_) => { return false; },
        Expr::Update(_) => { return false; },
        Expr::Call(_) => { return false; },
        Expr::EnumVariant(_) => { return false; },
        Expr::Index(_) => { return false; },
        Expr::FieldAccess(_) => { return false; },
        Expr::Lambda(_) => { return false; },
        Expr::Match(_) => { return false; },
        Expr::If(_) => { return false; },
        Expr::Tuple(_) => { return false; },
        Expr::Array(_) => { return false; },
        Expr::Dict(_) => { return false; },
        Expr::StructLiteral(_) => { return false; },
    }
    return false;
}

