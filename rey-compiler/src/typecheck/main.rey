// Incremental native typechecker. Unknown is an error state, never an any alias.

import lexer::{Span};
import parser::ast::{LiteralKind, Literal, ExprKind, TypeExprKind, TypeExpr, Expr, ErrorExpr, LiteralExpr, IdentExpr, BinaryExpr, UnaryExpr, UpdateExpr, CallExpr, EnumVariantExpr, IndexExpr, FieldAccessExpr, LambdaExpr, MatchExpr, MatchArm, IfExpr, TupleExpr, ArrayExpr, DictExpr, DictEntry, StructLiteralExpr, StructInitField, StmtKind, Stmt, VarDeclStmt, ConstDeclStmt, FuncDeclStmt, FuncParam, StructDeclStmt, StructField, EnumDeclStmt, EnumVariantDecl, ImportStmt, ImportSourceKind, ReturnStmt, BreakStmt, ContinueStmt, WhileStmt, ForStmt, LoopStmt, BlockStmt, ExprStmt, IfStmt, AssignStmt, MatchStmt, MatchStmtArm, PatternKind, Pattern, ErrorPattern, WildcardPattern, LiteralPattern, VariablePattern, EnumVariantPattern, RangePattern, StructPattern, PatternField, OrPattern, Program, ParseError, exprSpan, stmtSpan, patternSpan};

pub enum TypeKind {
    Any,
    Void,
    Bool,
    Int,
    Float,
    String,
    Char,
    Null,
    Array,
    Dict,
    Tuple,
    Struct,
    Enum,
    Function,
    Option,
    Result,
    Nullable,
    Union,
    Unknown,
}

pub struct Type {
    pub kind: string,
    pub name: string,
    pub sourcePath: string,
    pub moduleId: string,
    pub inner: Type?,
    pub key: Type?,
    pub value: Type?,
    pub params: Vec<Type>,
    pub ret: Type?,
}

struct Symbol {
    pub name: string,
    pub ty: Type,
    pub isConst: bool,
}

struct TypeEnv {
    pub symbols: HashMap<string, Symbol>,
    pub parent: TypeEnv?,
    pub lambdaBoundary: bool,
}

struct LookupResult {
    pub found: bool,
    pub symbol: Symbol,
    pub crossedLambda: bool,
}

struct FunctionSig {
    pub params: Vec<Type>,
    pub required: int,
    pub variadic: bool,
    pub variadicType: Type,
    pub ret: Type,
    pub inferReturn: bool,
    pub owner: string,
    pub sourcePath: string,
    pub moduleId: string,
    pub llvmName: string,
    pub isPub: bool,
    pub declarationIndex: int,
}

struct FieldLookup {
    pub found: bool,
    pub ty: Type,
    pub isPub: bool,
    pub fieldIndex: int,
    pub structIndex: int,
    pub sourcePath: string,
    pub moduleId: string,
}

pub struct SourceUnit {
    pub sourcePath: string,
    pub moduleId: string,
    pub source: string,
    pub isEntry: bool,
    pub program: Program,
}

pub struct ImportEdge {
    pub fromPath: string,
    pub toPath: string,
    pub sourceKind: ImportSourceKind,
    pub namespaceName: string,
    pub items: Vec<string>,
    pub span: Span,
}

pub struct SourceGraph {
    pub entryPath: string,
    pub units: Vec<SourceUnit>,
    pub edges: Vec<ImportEdge>,
    pub errors: Vec<string>,
}

pub struct CheckedNominalField {
    pub name: string,
    pub fieldIndex: int,
    pub ty: Type,
    pub isPub: bool,
}

pub struct CheckedNominalVariant {
    pub name: string,
    pub variantIndex: int,
    pub payloadTypes: Vec<Type>,
}

pub struct CheckedNominalLayout {
    pub kind: string,
    pub name: string,
    pub sourcePath: string,
    pub moduleId: string,
    pub declarationIndex: int,
    pub fields: Vec<CheckedNominalField>,
    pub variants: Vec<CheckedNominalVariant>,
}

struct ModuleSummary {
    pub sourcePath: string,
    pub moduleId: string,
    pub moduleIndex: int,
    pub functions: HashMap<string, FunctionSig>,
    pub structs: HashMap<string, StructDeclStmt>,
    pub enums: HashMap<string, EnumDeclStmt>,
    pub structIndices: HashMap<string, int>,
    pub enumIndices: HashMap<string, int>,
    pub structCount: int,
    pub nominalLayouts: Vec<CheckedNominalLayout>,
}

pub struct CallShape {
    pub requiredCount: int,
    pub fixedCount: int,
    pub variadicIndex: int,
}

pub struct ResolvedSymbol {
    pub sourcePath: string,
    pub moduleId: string,
    pub sourceName: string,
    pub llvmName: string,
    pub kind: string,
    pub intrinsicId: string,
    pub isPub: bool,
    pub signature: Type,
    pub callShape: CallShape,
    pub declarationIndex: int,
    pub receiverType: Type,
    pub receiverPassing: string,
}

pub struct CheckedExprInfo {
    pub sourcePath: string,
    pub moduleId: string,
    pub nodeId: int,
    pub expression: Expr,
    pub ty: Type,
    pub symbol: ResolvedSymbol?,
    pub receiverType: Type,
    pub structIndex: int,
    pub fieldIndex: int,
    pub enumIndex: int,
    pub variantIndex: int,
}

pub struct CheckedBindingInfo {
    pub sourcePath: string,
    pub moduleId: string,
    pub nodeId: int,
    pub declaration: any,
    pub declarationKey: string,
    pub name: string,
    pub ty: Type,
    pub kind: string,
    pub isConst: bool,
    pub parameterIndex: int,
}

pub struct CheckedFieldInitInfo {
    pub sourcePath: string,
    pub moduleId: string,
    pub nodeId: int,
    pub expression: Expr,
    pub literal: StructLiteralExpr,
    pub initializer: StructInitField,
    pub fieldIndex: int,
    pub valueType: Type,
}

pub struct CheckedProgram {
    pub entryPath: string,
    pub units: Vec<SourceUnit>,
    pub edges: Vec<ImportEdge>,
    pub expressions: Vec<CheckedExprInfo>,
    pub bindings: Vec<CheckedBindingInfo>,
    pub fieldInitializers: Vec<CheckedFieldInitInfo>,
    pub symbols: Vec<ResolvedSymbol>,
    pub nominalLayouts: Vec<CheckedNominalLayout>,
}

struct PatternResult {
    pub coversAll: bool,
    pub variant: string,
    pub coversVariant: bool,
}

pub struct TypeError {
    pub message: string,
    // Raw Span.start offset only; the checker has no source-path/line mapping.
    pub span: int,
    pub sourcePath: string,
    pub moduleId: string,
}

pub struct TypecheckResult {
    pub ok: bool,
    pub errors: Vec<TypeError>,
    pub checkedProgram: CheckedProgram?,
}

struct TypecheckContext {
    pub globals: TypeEnv,
    pub structs: HashMap<string, StructDeclStmt>,
    pub enums: HashMap<string, EnumDeclStmt>,
    pub functions: HashMap<string, FunctionSig>,
    pub structOwners: HashMap<string, string>,
    pub structSources: HashMap<string, string>,
    pub structIndices: HashMap<string, int>,
    pub enumOwners: HashMap<string, string>,
    pub enumSources: HashMap<string, string>,
    pub enumIndices: HashMap<string, int>,
    pub namespaces: HashMap<string, string>,
    pub moduleSummaries: HashMap<string, ModuleSummary>,
    pub importedOwners: HashMap<string, string>,
    pub errors: Vec<TypeError>,
    pub suppressErrors: bool,
    pub inFunction: bool,
    pub currentReturn: Type,
    pub returnTypes: Vec<Type>,
    pub loopDepth: int,
    pub sourcePath: string,
    pub moduleId: string,
    pub moduleIndex: int,
    pub isEntry: bool,
    pub currentStruct: string,
    pub globalDeclSpans: HashMap<string, int>,
    pub program: Program,
    pub recording: bool,
    pub nextNodeId: int,
    pub expressions: Vec<CheckedExprInfo>,
    pub bindings: Vec<CheckedBindingInfo>,
    pub fieldInitializers: Vec<CheckedFieldInitInfo>,
    pub symbols: Vec<ResolvedSymbol>,
    pub expressionIndex: HashMap<string, Vec<int>>,
    pub bindingIndex: HashMap<string, Vec<int>>,
    pub fieldInitializerIndex: HashMap<string, Vec<int>>,
}

func makeType(kind: string): Type {
    return Type { kind: kind, name: "", sourcePath: "", moduleId: "", inner: null, key: null, value: null, params: [], ret: null };
}

func namedType(kind: string, name: string): Type {
    return Type { kind: kind, name: name, sourcePath: "", moduleId: "", inner: null, key: null, value: null, params: [], ret: null };
}

func namedTypeOwned(kind: string, name: string, sourcePath: string, moduleId: string): Type {
    return Type { kind: kind, name: name, sourcePath: sourcePath, moduleId: moduleId, inner: null, key: null, value: null, params: [], ret: null };
}

func arrayType(inner: Type): Type {
    var ty = makeType("Array");
    ty.inner = inner;
    return ty;
}

func dictType(value: Type): Type {
    var ty = makeType("Dict");
    ty.key = makeType("String");
    ty.value = value;
    return ty;
}

func optionType(inner: Type): Type {
    var ty = makeType("Option");
    ty.inner = inner;
    return ty;
}

func resultType(ok: Type, err: Type): Type {
    var ty = makeType("Result");
    ty.inner = ok;
    ty.key = err;
    return ty;
}

func nullableType(inner: Type): Type {
    var ty = makeType("Nullable");
    ty.inner = inner;
    return ty;
}

func functionType(params: Vec<Type>, ret: Type): Type {
    var ty = makeType("Function");
    ty.params = params;
    ty.ret = ret;
    return ty;
}

func emptySignature(): FunctionSig {
    return FunctionSig { params: [], required: 0, variadic: false, variadicType: makeType("Unknown"), ret: makeType("Unknown"), inferReturn: false, owner: "", sourcePath: "", moduleId: "", llvmName: "", isPub: false, declarationIndex: -1 };
}

func newEnv(parent: TypeEnv?, lambdaBoundary: bool): TypeEnv {
    return TypeEnv { symbols: HashMap.new(), parent: parent, lambdaBoundary: lambdaBoundary };
}

func newContext(): TypecheckContext {
    return TypecheckContext {
        globals: newEnv(null, false),
        structs: HashMap.new(),
        enums: HashMap.new(),
        functions: HashMap.new(),
        structOwners: HashMap.new(),
        structSources: HashMap.new(),
        structIndices: HashMap.new(),
        enumOwners: HashMap.new(),
        enumSources: HashMap.new(),
        enumIndices: HashMap.new(),
        namespaces: HashMap.new(),
        moduleSummaries: HashMap.new(),
        importedOwners: HashMap.new(),
        errors: [],
        suppressErrors: false,
        inFunction: false,
        currentReturn: makeType("Unknown"),
        returnTypes: [],
        loopDepth: 0,
        sourcePath: "",
        moduleId: "",
        moduleIndex: 0,
        isEntry: false,
        currentStruct: "",
        globalDeclSpans: HashMap.new(),
        program: Program { statements: [], span: Span { start: -1, end: -1, line: 0, column: 0 } },
        recording: false,
        nextNodeId: 0,
        expressions: [],
        bindings: [],
        fieldInitializers: [],
        symbols: [],
        expressionIndex: HashMap.new(),
        bindingIndex: HashMap.new(),
        fieldInitializerIndex: HashMap.new(),
    };
}

func addError(ctx: TypecheckContext, message: string, span: int) {
    if !ctx.suppressErrors {
        ctx.errors.push(TypeError { message: message, span: span, sourcePath: ctx.sourcePath, moduleId: ctx.moduleId });
    }
}

func typeName(ty: Type): string {
    if ty.kind == "Struct" || ty.kind == "Enum" { return ty.name; }
    if ty.kind == "Array" {
        var inner = ty.inner;
        if inner != null {
            var innerType: Type = inner;
            return "Vec<" + typeName(innerType) + ">";
        }
        return "Vec<any>";
    }
    if ty.kind == "Dict" {
        var value = ty.value;
        if value != null {
            var valueType: Type = value;
            return "HashMap<string," + typeName(valueType) + ">";
        }
        return "HashMap<string,any>";
    }
    if ty.kind == "Option" {
        var optionInner = ty.inner;
        if optionInner != null {
            var optionTypeValue: Type = optionInner;
            return "Option<" + typeName(optionTypeValue) + ">";
        }
        return "Option<any>";
    }
    if ty.kind == "Result" { return "Result"; }
    if ty.kind == "Tuple" { return "tuple"; }
    if ty.kind == "Nullable" {
        var nullableInner = ty.inner;
        if nullableInner != null {
            var nullableTypeValue: Type = nullableInner;
            return typeName(nullableTypeValue) + "?";
        }
    }
    if ty.kind == "Union" {
        var text = "";
        var i = 0;
        loop {
            if i >= ty.params.len() { break; }
            if i > 0 { text = text + " | "; }
            text = text + typeName(ty.params[i]);
            i = i + 1;
        }
        return text;
    }
    if ty.kind == "Function" { return "function"; }
    if ty.kind == "Int" { return "int"; }
    if ty.kind == "Float" { return "float"; }
    if ty.kind == "Bool" { return "bool"; }
    if ty.kind == "String" { return "string"; }
    if ty.kind == "Void" { return "void"; }
    if ty.kind == "Char" { return "char"; }
    if ty.kind == "Any" { return "any"; }
    if ty.kind == "Null" { return "null"; }
    return "unknown";
}

func diagnosticTypeName(ty: Type): string {
    if ty.kind == "Int" { return "Int"; }
    if ty.kind == "Float" { return "Float"; }
    if ty.kind == "Bool" { return "Bool"; }
    if ty.kind == "String" { return "String"; }
    if ty.kind == "Void" { return "Void"; }
    if ty.kind == "Char" { return "Char"; }
    if ty.kind == "Any" { return "Any"; }
    if ty.kind == "Null" { return "Null"; }
    return typeName(ty);
}

func arithmeticOperandLabel(ty: Type): string {
    if ty.kind == "Null" { return "Null"; }
    return typeName(ty);
}

func typeEqual(a: Type, b: Type): bool {
    if a.kind != b.kind { return false; }
    if a.kind == "Struct" || a.kind == "Enum" {
        return a.name == b.name && a.moduleId == b.moduleId && a.sourcePath == b.sourcePath;
    }
    if a.kind == "Array" || a.kind == "Nullable" || a.kind == "Option" {
        var aInner = a.inner;
        var bInner = b.inner;
        if aInner != null {
            if bInner != null {
                var aInnerType: Type = aInner;
                var bInnerType: Type = bInner;
                return typeEqual(aInnerType, bInnerType);
            }
            return false;
        }
        return bInner == null;
    }
    if a.kind == "Result" {
        var aOk = a.inner;
        var bOk = b.inner;
        var aErr = a.key;
        var bErr = b.key;
        if aOk != null {
            if bOk != null {
                if aErr != null {
                    if bErr != null {
                        var aOkType: Type = aOk;
                        var bOkType: Type = bOk;
                        var aErrType: Type = aErr;
                        var bErrType: Type = bErr;
                        return typeEqual(aOkType, bOkType) && typeEqual(aErrType, bErrType);
                    }
                }
            }
            return false;
        }
        return bOk == null && aErr == null && bErr == null;
    }
    if a.kind == "Dict" {
        var aValue = a.value;
        var bValue = b.value;
        if aValue != null {
            if bValue != null {
                var aValueType: Type = aValue;
                var bValueType: Type = bValue;
                return typeEqual(aValueType, bValueType);
            }
            return false;
        }
        return bValue == null;
    }
    if a.kind == "Tuple" || a.kind == "Function" || a.kind == "Union" {
        if a.params.len() != b.params.len() { return false; }
        var i = 0;
        loop {
            if i >= a.params.len() { break; }
            if !typeEqual(a.params[i], b.params[i]) { return false; }
            i = i + 1;
        }
        if a.kind == "Function" {
            var aReturn = a.ret;
            var bReturn = b.ret;
            if aReturn != null {
                if bReturn != null {
                    var aReturnType: Type = aReturn;
                    var bReturnType: Type = bReturn;
                    return typeEqual(aReturnType, bReturnType);
                }
                return false;
            }
            return bReturn == null;
        }
        return true;
    }
    return true;
}

func isUnknown(ty: Type): bool {
    return ty.kind == "Unknown";
}

func isNumeric(ty: Type): bool {
    return ty.kind == "Int" || ty.kind == "Float";
}

func isRenderable(ty: Type): bool {
    if ty.kind == "Any" { return true; }
    if ty.kind == "Int" || ty.kind == "Float" || ty.kind == "Bool" || ty.kind == "String" || ty.kind == "Char" || ty.kind == "Null" { return true; }
    if ty.kind == "Nullable" {
        var inner = ty.inner;
        if inner != null {
            var innerType: Type = inner;
            return isRenderable(innerType);
        }
        return false;
    }
    if ty.kind == "Union" {
        var i = 0;
        loop {
            if i >= ty.params.len() { break; }
            if !isRenderable(ty.params[i]) { return false; }
            i = i + 1;
        }
        return ty.params.len() > 0;
    }
    return false;
}

func canAssign(target: Type, source: Type): bool {
    if target.kind == "Any" || source.kind == "Any" { return true; }
    if target.kind == "Unknown" || source.kind == "Unknown" { return false; }
    if typeEqual(target, source) { return true; }
    if target.kind == "Nullable" {
        if source.kind == "Null" { return true; }
        var nullableInner = target.inner;
        if nullableInner != null {
            var nullableTypeValue: Type = nullableInner;
            return canAssign(nullableTypeValue, source);
        }
    }
    if target.kind == "Option" && source.kind == "Option" {
        var targetInner = target.inner;
        var sourceInner = source.inner;
        if targetInner != null {
            if sourceInner != null {
                var targetTypeValue: Type = targetInner;
                var sourceTypeValue: Type = sourceInner;
                return canAssign(targetTypeValue, sourceTypeValue);
            }
        }
        return true;
    }
    if target.kind == "Result" && source.kind == "Result" {
        var targetOk = target.inner;
        var sourceOk = source.inner;
        var targetErr = target.key;
        var sourceErr = source.key;
        if targetOk != null {
            if sourceOk != null {
                if targetErr != null {
                    if sourceErr != null {
                        var targetOkType: Type = targetOk;
                        var sourceOkType: Type = sourceOk;
                        var targetErrType: Type = targetErr;
                        var sourceErrType: Type = sourceErr;
                        return canAssign(targetOkType, sourceOkType) && canAssign(targetErrType, sourceErrType);
                    }
                }
            }
        }
        return true;
    }
    if target.kind == "Array" && source.kind == "Array" {
        var targetElement = target.inner;
        var sourceElement = source.inner;
        if targetElement != null {
            if sourceElement != null {
                var targetElementType: Type = targetElement;
                var sourceElementType: Type = sourceElement;
                return canAssign(targetElementType, sourceElementType);
            }
        }
        return true;
    }
    if target.kind == "Dict" && source.kind == "Dict" {
        var targetValue = target.value;
        var sourceValue = source.value;
        if targetValue != null {
            if sourceValue != null {
                var targetValueType: Type = targetValue;
                var sourceValueType: Type = sourceValue;
                return canAssign(targetValueType, sourceValueType);
            }
        }
        return true;
    }
    if target.kind == "Union" {
        var i = 0;
        loop {
            if i >= target.params.len() { break; }
            if canAssign(target.params[i], source) { return true; }
            i = i + 1;
        }
        return false;
    }
    if source.kind == "Union" {
        var j = 0;
        loop {
            if j >= source.params.len() { break; }
            if !canAssign(target, source.params[j]) { return false; }
            j = j + 1;
        }
        return true;
    }
    return false;
}

func joinTypes(a: Type, b: Type): Type {
    if isUnknown(a) { return b; }
    if isUnknown(b) { return a; }
    if typeEqual(a, b) { return a; }
    if a.kind == "Any" || b.kind == "Any" { return makeType("Any"); }
    var items: Vec<Type> = [];
    if a.kind == "Union" {
        var i = 0;
        loop {
            if i >= a.params.len() { break; }
            items.push(a.params[i]);
            i = i + 1;
        }
    } else { items.push(a); }
    if b.kind == "Union" {
        var j = 0;
        loop {
            if j >= b.params.len() { break; }
            var found = false;
            var k = 0;
            loop {
                if k >= items.len() { break; }
                if typeEqual(items[k], b.params[j]) { found = true; }
                k = k + 1;
            }
            if !found { items.push(b.params[j]); }
            j = j + 1;
        }
    } else {
        var found2 = false;
        var k2 = 0;
        loop {
            if k2 >= items.len() { break; }
            if typeEqual(items[k2], b) { found2 = true; }
            k2 = k2 + 1;
        }
        if !found2 { items.push(b); }
    }
    var result = makeType("Union");
    result.params = items;
    return result;
}

func resolveNamedType(ctx: TypecheckContext, name: string, span: int, allowVoid: bool): Type {
    if name == "int" { return makeType("Int"); }
    if name == "float" { return makeType("Float"); }
    if name == "bool" { return makeType("Bool"); }
    if name == "string" { return makeType("String"); }
    if name == "char" { return makeType("Char"); }
    if name == "any" { return makeType("Any"); }
    if name == "void" {
        if !allowVoid { addError(ctx, "void is only valid as a function return type", span); return makeType("Unknown"); }
        return makeType("Void");
    }
    if name == "Vec" { return arrayType(makeType("Any")); }
    if name == "HashMap" { return dictType(makeType("Any")); }
    if name == "Option" { return optionType(makeType("Any")); }
    if name == "Result" { return resultType(makeType("Any"), makeType("Any")); }
    if name == "String" || name == "Int" || name == "Float" || name == "Bool" || name == "Void" || name == "Char" || name == "Any" {
        var lower = "string";
        if name == "Int" { lower = "int"; }
        else if name == "Float" { lower = "float"; }
        else if name == "Bool" { lower = "bool"; }
        else if name == "Void" { lower = "void"; }
        else if name == "Char" { lower = "char"; }
        else if name == "Any" { lower = "any"; }
        addError(ctx, "capitalized primitive type '" + name + "'; use '" + lower + "' (lowercase)", span);
        return makeType("Unknown");
    }
    if name == "null" {
        addError(ctx, "null is a value, not a standalone type; use a nullable or union type", span);
        return makeType("Unknown");
    }
    if ctx.structs.has(name) {
        var owner = ctx.structOwners.get(name);
        var source = ctx.structSources.get(name);
        return namedTypeOwned("Struct", name, source, owner);
    }
    if ctx.enums.has(name) {
        var enumOwner = ctx.enumOwners.get(name);
        var enumSource = ctx.enumSources.get(name);
        return namedTypeOwned("Enum", name, enumSource, enumOwner);
    }
    addError(ctx, "unknown type '" + name + "'", span);
    return makeType("Unknown");
}

func resolveTypeExpr(ctx: TypecheckContext, expr: TypeExpr, allowVoid: bool): Type {
    match expr.kind {
        TypeExprKind::Named => { return resolveNamedType(ctx, expr.name, expr.span.start, allowVoid); },
        TypeExprKind::Nullable => {
            var innerExpr = expr.inner;
            if innerExpr != null {
                var innerTypeExpr: TypeExpr = innerExpr;
                var inner = resolveTypeExpr(ctx, innerTypeExpr, false);
                if inner.kind == "Void" || inner.kind == "Null" { addError(ctx, "invalid nullable inner type", expr.span.start); return makeType("Unknown"); }
                return nullableType(inner);
            }
            addError(ctx, "nullable type is missing its inner type", expr.span.start);
            return makeType("Unknown");
        },
        TypeExprKind::Union => {
            var union = makeType("Union");
            var i = 0;
            loop {
                if i >= expr.members.len() { break; }
                var member = makeType("Unknown");
                if isNullNamedTypeExpr(expr.members[i]) { member = makeType("Null"); }
                else { member = resolveTypeExpr(ctx, expr.members[i], false); }
                if !isUnknown(member) { union = joinTypes(union, member); }
                i = i + 1;
            }
            if union.kind == "Union" && union.params.len() == 0 { return makeType("Unknown"); }
            if union.kind == "Union" && union.params.len() == 1 { return union.params[0]; }
            return union;
        },
        TypeExprKind::Tuple => {
            var tuple = makeType("Tuple");
            var i2 = 0;
            loop {
                if i2 >= expr.members.len() { break; }
                tuple.params.push(resolveTypeExpr(ctx, expr.members[i2], false));
                i2 = i2 + 1;
            }
            return tuple;
        },
        TypeExprKind::Function => {
            var fn = makeType("Function");
            var p = 0;
            loop {
                if p >= expr.params.len() { break; }
                fn.params.push(resolveTypeExpr(ctx, expr.params[p], false));
                p = p + 1;
            }
            var resultExpr = expr.result;
            if resultExpr != null {
                var resultTypeExpr: TypeExpr = resultExpr;
                fn.ret = resolveTypeExpr(ctx, resultTypeExpr, true);
            } else { fn.ret = makeType("Void"); }
            return fn;
        },
        TypeExprKind::Applied => {
            if expr.name == "Vec" {
                if expr.members.len() > 1 { addError(ctx, "Vec accepts at most one type argument", expr.span.start); return makeType("Unknown"); }
                if expr.members.len() == 0 { return arrayType(makeType("Any")); }
                return arrayType(resolveTypeExpr(ctx, expr.members[0], false));
            }
            if expr.name == "HashMap" {
                if expr.members.len() != 2 { addError(ctx, "HashMap requires key and value type arguments", expr.span.start); return makeType("Unknown"); }
                var keyType = resolveTypeExpr(ctx, expr.members[0], false);
                if keyType.kind != "String" && keyType.kind != "Any" { addError(ctx, "HashMap keys must be string", expr.span.start); }
                return dictType(resolveTypeExpr(ctx, expr.members[1], false));
            }
            if expr.name == "Option" {
                if expr.members.len() != 1 { addError(ctx, "Option requires one type argument", expr.span.start); return makeType("Unknown"); }
                return optionType(resolveTypeExpr(ctx, expr.members[0], false));
            }
            if expr.name == "Result" {
                if expr.members.len() != 2 { addError(ctx, "Result requires two type arguments", expr.span.start); return makeType("Unknown"); }
                return resultType(resolveTypeExpr(ctx, expr.members[0], false), resolveTypeExpr(ctx, expr.members[1], false));
            }
            addError(ctx, "unsupported applied type '" + expr.name + "'", expr.span.start);
            return makeType("Unknown");
        },
        TypeExprKind::Error => {
            addError(ctx, "unsupported type expression", expr.span.start);
            return makeType("Unknown");
        },
    }
    return makeType("Unknown");
}

func isNullNamedTypeExpr(expr: TypeExpr): bool {
    match expr.kind {
        TypeExprKind::Named => { return expr.name == "null"; },
        TypeExprKind::Error => { return false; },
        TypeExprKind::Nullable => { return false; },
        TypeExprKind::Union => { return false; },
        TypeExprKind::Tuple => { return false; },
        TypeExprKind::Function => { return false; },
        TypeExprKind::Applied => { return false; },
    }
    return false;
}

func resolveTypeTag(ctx: TypecheckContext, expr: TypeExpr?, tag: string, span: int, allowVoid: bool): Type {
    if expr != null { return resolveTypeExpr(ctx, expr, allowVoid); }
    if tag == "" { return makeType("Unknown"); }
    if tag.endsWith("?") {
        var innerTag = tag.slice(0, tag.len() - 1);
        var inner = resolveNamedType(ctx, innerTag, span, false);
        return nullableType(inner);
    }
    if tag.startsWith("[") && tag.endsWith("]") {
        var innerTag2 = tag.slice(1, tag.len() - 1);
        return arrayType(resolveNamedType(ctx, innerTag2, span, false));
    }
    return resolveNamedType(ctx, tag, span, allowVoid);
}

func lookupEnv(env: TypeEnv, name: string): LookupResult {
    if env.symbols.has(name) {
        return LookupResult { found: true, symbol: env.symbols.get(name), crossedLambda: false };
    }
    var parent = env.parent;
    if parent != null {
        var parentEnv: TypeEnv = parent;
        var result = lookupEnv(parentEnv, name);
        if env.lambdaBoundary && result.found { result.crossedLambda = true; }
        return result;
    }
    return LookupResult { found: false, symbol: Symbol { name: "", ty: makeType("Unknown"), isConst: false }, crossedLambda: false };
}

func defineSymbol(ctx: TypecheckContext, env: TypeEnv, name: string, ty: Type, isConst: bool, span: int) {
    if env.symbols.has(name) {
        addError(ctx, "duplicate declaration of '" + name + "'", span);
        return;
    }
    env.symbols.set(name, Symbol { name: name, ty: ty, isConst: isConst });
}

func expectType(ctx: TypecheckContext, expected: Type, actual: Type, message: string, span: int) {
    if isUnknown(expected) || isUnknown(actual) { return; }
    if !canAssign(expected, actual) {
        addError(ctx, message + ": expected " + typeName(expected) + ", got " + typeName(actual) + "; expected " + diagnosticTypeName(expected) + " but got " + diagnosticTypeName(actual), span);
    }
}

func makeSignature(params: Vec<Type>, required: int, variadic: bool, variadicType: Type, ret: Type): FunctionSig {
    return FunctionSig { params: params, required: required, variadic: variadic, variadicType: variadicType, ret: ret, inferReturn: false, owner: "", sourcePath: "", moduleId: "", llvmName: "", isPub: true, declarationIndex: -1 };
}

func resolvedCallSymbol(ctx: TypecheckContext, name: string, sig: FunctionSig, kind: string, intrinsicId: string, receiverType: Type): ResolvedSymbol {
    var fixedCount = sig.params.len();
    var variadicIndex = -1;
    if sig.variadic { variadicIndex = fixedCount - 1; fixedCount = fixedCount - 1; }
    var sourcePath = sig.sourcePath;
    var moduleId = sig.moduleId;
    if sourcePath == "" { sourcePath = "runtime"; moduleId = "runtime"; }
    var llvmName = sig.llvmName;
    if intrinsicId != "" || kind == "Local" { llvmName = ""; }
    var receiverPassing = "None";
    if kind == "Method" { receiverPassing = "HiddenFirstArg"; }
    return ResolvedSymbol {
        sourcePath: sourcePath,
        moduleId: moduleId,
        sourceName: name,
        llvmName: llvmName,
        kind: kind,
        intrinsicId: intrinsicId,
        isPub: sig.isPub,
        signature: functionType(sig.params, sig.ret),
        callShape: CallShape { requiredCount: sig.required, fixedCount: fixedCount, variadicIndex: variadicIndex },
        declarationIndex: sig.declarationIndex,
        receiverType: receiverType,
        receiverPassing: receiverPassing,
    };
}

func isBuiltinSignature(sig: FunctionSig): bool {
    return sig.sourcePath == "" && sig.declarationIndex < 0;
}

func addBuiltin(ctx: TypecheckContext, name: string, sig: FunctionSig) {
    ctx.functions.set(name, sig);
    ctx.symbols.push(resolvedCallSymbol(ctx, name, sig, "Builtin", name, makeType("Unknown")));
}

func registerBuiltins(ctx: TypecheckContext) {
    var str = makeType("String");
    var int = makeType("Int");
    var bool = makeType("Bool");
    var void = makeType("Void");
    var any = makeType("Any");
    var twoStrings = [str, str];
    var oneString = [str];
    var twoInts = [int, int];
    addBuiltin(ctx, "print", makeSignature([], 0, true, any, void));
    addBuiltin(ctx, "println", makeSignature([], 0, true, any, void));
    addBuiltin(ctx, "eprint", makeSignature([], 0, true, any, void));
    addBuiltin(ctx, "eprintln", makeSignature([], 0, true, any, void));
    addBuiltin(ctx, "assert", makeSignature([bool, any], 2, false, any, void));
    addBuiltin(ctx, "readFile", makeSignature(oneString, 1, false, any, str));
    addBuiltin(ctx, "writeFile", makeSignature(twoStrings, 2, false, any, void));
    addBuiltin(ctx, "appendFile", makeSignature(twoStrings, 2, false, any, void));
    addBuiltin(ctx, "fileExists", makeSignature(oneString, 1, false, any, bool));
    addBuiltin(ctx, "deleteFile", makeSignature(oneString, 1, false, any, void));
    addBuiltin(ctx, "mkdir", makeSignature(oneString, 1, false, any, void));
    addBuiltin(ctx, "listDir", makeSignature(oneString, 1, false, any, arrayType(str)));
    addBuiltin(ctx, "getEnv", makeSignature(oneString, 1, false, any, optionType(str)));
    addBuiltin(ctx, "exec", makeSignature(oneString, 1, false, any, resultType(str, str)));
    addBuiltin(ctx, "args", makeSignature([], 0, false, any, arrayType(str)));
    addBuiltin(ctx, "exit", makeSignature([int], 1, false, any, void));
    addBuiltin(ctx, "int", makeSignature([any], 1, false, any, int));
    addBuiltin(ctx, "float", makeSignature([any], 1, false, any, makeType("Float")));
    addBuiltin(ctx, "string", makeSignature([any], 1, false, any, str));
    addBuiltin(ctx, "char", makeSignature([int], 1, false, any, makeType("Char")));
    addBuiltin(ctx, "range", makeSignature(twoInts, 2, false, any, arrayType(int)));
    addBuiltin(ctx, "input", makeSignature([str], 0, false, any, str));
    addBuiltin(ctx, "abs", makeSignature([any], 1, false, any, any));
    addBuiltin(ctx, "min", makeSignature([any, any], 2, false, any, any));
    addBuiltin(ctx, "max", makeSignature([any, any], 2, false, any, any));
    addBuiltin(ctx, "floor", makeSignature([any], 1, false, any, int));
    addBuiltin(ctx, "ceil", makeSignature([any], 1, false, any, int));
    addBuiltin(ctx, "round", makeSignature([any], 1, false, any, int));
    addBuiltin(ctx, "sqrt", makeSignature([any], 1, false, any, makeType("Float")));
    addBuiltin(ctx, "pow", makeSignature([any, any], 2, false, any, makeType("Float")));
    addBuiltin(ctx, "log", makeSignature([any], 1, false, any, makeType("Float")));
    addBuiltin(ctx, "sin", makeSignature([any], 1, false, any, makeType("Float")));
    addBuiltin(ctx, "cos", makeSignature([any], 1, false, any, makeType("Float")));
    addBuiltin(ctx, "tan", makeSignature([any], 1, false, any, makeType("Float")));
    addBuiltin(ctx, "random", makeSignature([], 0, false, any, makeType("Float")));
}

func llvmSymbolNameAt(moduleIndex: int, sourceName: string, owner: string): string {
    var name = "__rey_m" + moduleIndex.toString() + "_";
    if owner != "" { name = name + owner + "_"; }
    return name + sourceName;
}

func llvmSymbolName(ctx: TypecheckContext, sourceName: string, owner: string): string {
    if owner == "" && sourceName == "main" && ctx.isEntry { return "_rey_main"; }
    return llvmSymbolNameAt(ctx.moduleIndex, sourceName, owner);
}

func signatureForDecl(ctx: TypecheckContext, decl: FuncDeclStmt, owner: string, declarationIndex: int): FunctionSig {
    var params: Vec<Type> = [];
    var required = 0;
    var sawDefault = false;
    var variadic = false;
    var variadicType = makeType("Unknown");
    var i = 0;
    loop {
        if i >= decl.params.len() { break; }
        var param: FuncParam = decl.params[i];
        var paramType = makeType("Any");
        if param.typeExpr != null || param.typeTag != "" {
            paramType = resolveTypeTag(ctx, param.typeExpr, param.typeTag, decl.span.start, false);
        }
        if param.variadic {
            if i != decl.params.len() - 1 { addError(ctx, "variadic parameter must be last", decl.span.start); }
            if variadic { addError(ctx, "only one variadic parameter is allowed", decl.span.start); }
            variadic = true;
            variadicType = paramType;
            params.push(arrayType(paramType));
        } else {
            params.push(paramType);
            if param.hasDefault { sawDefault = true; }
            else if !sawDefault { required = required + 1; }
            else { addError(ctx, "required parameter cannot follow a default parameter", decl.span.start); }
        }
        i = i + 1;
    }
    var ret = makeType("Unknown");
    var inferRet = decl.returnType == "" && decl.returnTypeExpr == null;
    if !inferRet { ret = resolveTypeTag(ctx, decl.returnTypeExpr, decl.returnType, decl.span.start, true); }
    var llvmName = llvmSymbolName(ctx, decl.name, owner);
    return FunctionSig { params: params, required: required, variadic: variadic, variadicType: variadicType, ret: ret, inferReturn: inferRet, owner: owner, sourcePath: ctx.sourcePath, moduleId: ctx.moduleId, llvmName: llvmName, isPub: decl.isPub, declarationIndex: declarationIndex };
}

func registerFunction(ctx: TypecheckContext, decl: FuncDeclStmt, owner: string, declarationIndex: int) {
    var key = decl.name;
    if owner != "" { key = owner + "." + decl.name; }
    if owner == "" && ctx.namespaces.has(decl.name) { addError(ctx, "function name collides with imported namespace '" + decl.name + "'", decl.span.start); }
    if owner == "" && (ctx.structs.has(decl.name) || ctx.enums.has(decl.name)) { addError(ctx, "function name collides with type '" + decl.name + "'", decl.span.start); }
    if ctx.functions.has(key) {
        var prior: FunctionSig = ctx.functions.get(key);
        if !isBuiltinSignature(prior) {
            addError(ctx, "duplicate function '" + key + "'", decl.span.start);
            return;
        }
    }
    var signature = signatureForDecl(ctx, decl, owner, declarationIndex);
    ctx.functions.set(key, signature);
    var llvmName = signature.llvmName;
    var variadicIndex = -1;
    if signature.variadic { variadicIndex = signature.params.len() - 1; }
    var receiverType = makeType("Unknown");
    var receiverPassing = "None";
    if owner != "" { receiverType = resolveNamedType(ctx, owner, decl.span.start, false); receiverPassing = "HiddenFirstArg"; }
    ctx.symbols.push(ResolvedSymbol {
        sourcePath: signature.sourcePath,
        moduleId: signature.moduleId,
        sourceName: key,
        llvmName: llvmName,
        kind: "Function",
        intrinsicId: "",
        isPub: signature.isPub,
        signature: functionType(signature.params, signature.ret),
        callShape: CallShape { requiredCount: signature.required, fixedCount: signature.params.len(), variadicIndex: variadicIndex },
        declarationIndex: declarationIndex,
        receiverType: receiverType,
        receiverPassing: receiverPassing,
    });
}

func collectDeclarations(ctx: TypecheckContext, program: Program) {
    var i = 0;
    loop {
        if i >= program.statements.len() { break; }
        var stmt = program.statements[i];
        match stmt {
            Stmt::StructDecl(decl) => {
                if ctx.namespaces.has(decl.name) { addError(ctx, "type name collides with imported namespace '" + decl.name + "'", decl.span.start); }
                if ctx.functions.has(decl.name) { addError(ctx, "type name collides with function '" + decl.name + "'", decl.span.start); }
                if ctx.structs.has(decl.name) || ctx.enums.has(decl.name) { addError(ctx, "duplicate type '" + decl.name + "'", decl.span.start); }
                else {
                    ctx.structs.set(decl.name, decl);
                    ctx.structOwners.set(decl.name, ctx.moduleId);
                    ctx.structSources.set(decl.name, ctx.sourcePath);
                    ctx.structIndices.set(decl.name, i);
                    ctx.symbols.push(ResolvedSymbol { sourcePath: ctx.sourcePath, moduleId: ctx.moduleId, sourceName: decl.name, llvmName: llvmSymbolName(ctx, decl.name, ""), kind: "Struct", intrinsicId: "", isPub: decl.isPub, signature: resolveNamedType(ctx, decl.name, decl.span.start, false), callShape: CallShape { requiredCount: 0, fixedCount: 0, variadicIndex: -1 }, declarationIndex: i, receiverType: makeType("Unknown"), receiverPassing: "None" });
                }
            },
            Stmt::EnumDecl(declE) => {
                if ctx.namespaces.has(declE.name) { addError(ctx, "type name collides with imported namespace '" + declE.name + "'", declE.span.start); }
                if ctx.functions.has(declE.name) { addError(ctx, "type name collides with function '" + declE.name + "'", declE.span.start); }
                if ctx.structs.has(declE.name) || ctx.enums.has(declE.name) { addError(ctx, "duplicate type '" + declE.name + "'", declE.span.start); }
                else {
                    ctx.enums.set(declE.name, declE);
                    ctx.enumOwners.set(declE.name, ctx.moduleId);
                    ctx.enumSources.set(declE.name, ctx.sourcePath);
                    ctx.enumIndices.set(declE.name, i);
                    ctx.symbols.push(ResolvedSymbol { sourcePath: ctx.sourcePath, moduleId: ctx.moduleId, sourceName: declE.name, llvmName: llvmSymbolName(ctx, declE.name, ""), kind: "Enum", intrinsicId: "", isPub: declE.isPub, signature: resolveNamedType(ctx, declE.name, declE.span.start, false), callShape: CallShape { requiredCount: 0, fixedCount: 0, variadicIndex: -1 }, declarationIndex: i, receiverType: makeType("Unknown"), receiverPassing: "None" });
                    bindEnumValue(ctx, declE.name, declE.span.start);
                }
            },
            _ => {},
        }
        i = i + 1;
    }
    i = 0;
    loop {
        if i >= program.statements.len() { break; }
        var stmt2 = program.statements[i];
        match stmt2 {
            Stmt::FuncDecl(decl) => { registerFunction(ctx, decl, "", i); },
            Stmt::StructDecl(declS) => {
                var j = 0;
                loop {
                    if j >= declS.methods.len() { break; }
                    registerFunction(ctx, declS.methods[j], declS.name, j);
                    j = j + 1;
                }
            },
            _ => {},
        }
        i = i + 1;
    }
}

func summarySignature(symbol: ResolvedSymbol): FunctionSig {
    var ret = makeType("Unknown");
    var signatureReturn = symbol.signature.ret;
    if signatureReturn != null {
        var resolvedReturn: Type = signatureReturn;
        ret = resolvedReturn;
    }
    var variadic = symbol.callShape.variadicIndex >= 0;
    var variadicType = makeType("Unknown");
    if variadic && symbol.callShape.variadicIndex < symbol.signature.params.len() {
        var lastParam = symbol.signature.params[symbol.callShape.variadicIndex];
        var lastInner = lastParam.inner;
        if lastParam.kind == "Array" {
            if lastInner != null {
                var resolvedInner: Type = lastInner;
                variadicType = resolvedInner;
            } else { variadicType = lastParam; }
        } else { variadicType = lastParam; }
    }
    var owner = "";
    if symbol.receiverPassing == "HiddenFirstArg" {
        var dot = symbol.sourceName.indexOf(".");
        if dot >= 0 { owner = symbol.sourceName.slice(0, dot); }
    }
    return FunctionSig {
        params: symbol.signature.params,
        required: symbol.callShape.requiredCount,
        variadic: variadic,
        variadicType: variadicType,
        ret: ret,
        inferReturn: false,
        owner: owner,
        sourcePath: symbol.sourcePath,
        moduleId: symbol.moduleId,
        llvmName: symbol.llvmName,
        isPub: symbol.isPub,
        declarationIndex: symbol.declarationIndex,
    };
}

func buildModuleSummary(unit: SourceUnit, checked: CheckedProgram, moduleIndex: int): ModuleSummary {
    var summary = ModuleSummary {
        sourcePath: unit.sourcePath,
        moduleId: unit.moduleId,
        moduleIndex: moduleIndex,
        functions: HashMap.new(),
        structs: HashMap.new(),
        enums: HashMap.new(),
        structIndices: HashMap.new(),
        enumIndices: HashMap.new(),
        structCount: 0,
        nominalLayouts: checked.nominalLayouts,
    };
    var i = 0;
    loop {
        if i >= unit.program.statements.len() { break; }
        var stmt = unit.program.statements[i];
        match stmt {
            Stmt::StructDecl(decl) => {
                summary.structs.set(decl.name, decl);
                summary.structIndices.set(decl.name, i);
                summary.structCount = summary.structCount + 1;
            },
            Stmt::EnumDecl(decl) => {
                summary.enums.set(decl.name, decl);
                summary.enumIndices.set(decl.name, i);
            },
            _ => {},
        }
        i = i + 1;
    }
    i = 0;
    loop {
        if i >= checked.symbols.len() { break; }
        var symbol: ResolvedSymbol = checked.symbols[i];
        if symbol.kind == "Function" && symbol.sourcePath == unit.sourcePath && symbol.moduleId == unit.moduleId {
            summary.functions.set(symbol.sourceName, summarySignature(symbol));
        }
        i = i + 1;
    }
    return summary;
}

func importTypeBinding(ctx: TypecheckContext, name: string, sourceModule: string, sourcePath: string, isStruct: bool, declarationIndex: int, decl, span: int) {
    if ctx.namespaces.has(name) {
        addError(ctx, "imported type collides with namespace '" + name + "'", span);
        return;
    }
    if ctx.functions.has(name) || ctx.structs.has(name) || ctx.enums.has(name) {
        if ctx.importedOwners.has("type:" + name) && ctx.importedOwners.get("type:" + name) == sourceModule { return; }
        addError(ctx, "Duplicate import: imported name collision for '" + name + "'", span);
        return;
    }
    if isStruct {
        ctx.structs.set(name, decl);
        ctx.structOwners.set(name, sourceModule);
        ctx.structSources.set(name, sourcePath);
        ctx.structIndices.set(name, declarationIndex);
    } else {
        ctx.enums.set(name, decl);
        ctx.enumOwners.set(name, sourceModule);
        ctx.enumSources.set(name, sourcePath);
        ctx.enumIndices.set(name, declarationIndex);
        bindEnumValue(ctx, name, span);
    }
    ctx.importedOwners.set("type:" + name, sourceModule);
}

func bindEnumValue(ctx: TypecheckContext, name: string, span: int) {
    if ctx.globals.symbols.has(name) { return; }
    ctx.globals.symbols.set(name, Symbol { name: name, ty: resolveNamedType(ctx, name, span, false), isConst: true });
}

func importFunctionBinding(ctx: TypecheckContext, name: string, sig: FunctionSig, span: int) {
    if !sig.isPub {
        addError(ctx, "cannot import private function '" + name + "' from " + sig.sourcePath, span);
        return;
    }
    if !signatureTypesVisible(ctx, sig) {
        addError(ctx, "public function '" + name + "' exposes a private type from " + sig.sourcePath, span);
        return;
    }
    if ctx.namespaces.has(name) || ctx.structs.has(name) || ctx.enums.has(name) {
        addError(ctx, "Duplicate import: imported name collision for '" + name + "'", span);
        return;
    }
    if ctx.functions.has(name) {
        var prior: FunctionSig = ctx.functions.get(name);
        if prior.sourcePath == sig.sourcePath && prior.moduleId == sig.moduleId { return; }
        addError(ctx, "Duplicate import: imported name collision for '" + name + "'", span);
        return;
    }
    ctx.functions.set(name, sig);
    ctx.importedOwners.set("function:" + name, sig.moduleId);
}

func typeVisibleToCaller(ctx: TypecheckContext, ty: Type): bool {
    if ty.kind == "Struct" {
        if ty.moduleId == "" || ty.moduleId == ctx.moduleId { return true; }
        if !ctx.moduleSummaries.has(ty.moduleId) { return false; }
        var summary: ModuleSummary = ctx.moduleSummaries.get(ty.moduleId);
        if !summary.structs.has(ty.name) { return false; }
        var decl: StructDeclStmt = summary.structs.get(ty.name);
        return decl.isPub;
    }
    if ty.kind == "Enum" {
        if ty.moduleId == "" || ty.moduleId == ctx.moduleId { return true; }
        if !ctx.moduleSummaries.has(ty.moduleId) { return false; }
        var summaryE: ModuleSummary = ctx.moduleSummaries.get(ty.moduleId);
        if !summaryE.enums.has(ty.name) { return false; }
        var declE: EnumDeclStmt = summaryE.enums.get(ty.name);
        return declE.isPub;
    }
    if ty.kind == "Array" || ty.kind == "Nullable" || ty.kind == "Option" {
        var inner = ty.inner;
        if inner != null {
            var innerType: Type = inner;
            return typeVisibleToCaller(ctx, innerType);
        }
        return true;
    }
    if ty.kind == "Dict" {
        var value = ty.value;
        if value != null {
            var valueType: Type = value;
            return typeVisibleToCaller(ctx, valueType);
        }
        return true;
    }
    if ty.kind == "Result" {
        var okType = ty.inner;
        if okType != null {
            var okValue: Type = okType;
            if !typeVisibleToCaller(ctx, okValue) { return false; }
        }
        var errType = ty.key;
        if errType != null {
            var errValue: Type = errType;
            if !typeVisibleToCaller(ctx, errValue) { return false; }
        }
        return true;
    }
    if ty.kind == "Tuple" || ty.kind == "Union" || ty.kind == "Function" {
        var i = 0;
        loop {
            if i >= ty.params.len() { break; }
            if !typeVisibleToCaller(ctx, ty.params[i]) { return false; }
            i = i + 1;
        }
        if ty.kind == "Function" {
            var functionReturn = ty.ret;
            if functionReturn != null {
                var functionReturnType: Type = functionReturn;
                return typeVisibleToCaller(ctx, functionReturnType);
            }
        }
    }
    return true;
}

func signatureTypesVisible(ctx: TypecheckContext, sig: FunctionSig): bool {
    var i = 0;
    loop {
        if i >= sig.params.len() { break; }
        if !typeVisibleToCaller(ctx, sig.params[i]) { return false; }
        i = i + 1;
    }
    return typeVisibleToCaller(ctx, sig.ret);
}

func installImportedMethods(ctx: TypecheckContext, summary: ModuleSummary, structName: string, span: int) {
    var decl: StructDeclStmt = summary.structs.get(structName);
    var i = 0;
    loop {
        if i >= decl.methods.len() { break; }
        var method = decl.methods[i];
        var key = structName + "." + method.name;
        if summary.functions.has(key) {
            var sig: FunctionSig = summary.functions.get(key);
            if sig.isPub {
                if ctx.functions.has(key) {
                    var prior: FunctionSig = ctx.functions.get(key);
                    if prior.moduleId != sig.moduleId { addError(ctx, "imported method collision for '" + key + "'", span); }
                } else {
                    ctx.functions.set(key, sig);
                }
            }
        }
        i = i + 1;
    }
}

func installImports(ctx: TypecheckContext, unit: SourceUnit, graph: SourceGraph) {
    var i = 0;
    loop {
        if i >= graph.edges.len() { break; }
        var edge = graph.edges[i];
        if edge.fromPath != unit.sourcePath { i = i + 1; continue; }
        if !ctx.moduleSummaries.has(edge.toPath) {
            addError(ctx, "import module was not loaded: " + edge.toPath, edge.span.start);
            i = i + 1;
            continue;
        }
        var summary: ModuleSummary = ctx.moduleSummaries.get(edge.toPath);
        if edge.namespaceName != "" {
            if ctx.namespaces.has(edge.namespaceName) && ctx.namespaces.get(edge.namespaceName) != summary.moduleId {
                addError(ctx, "import namespace collision for '" + edge.namespaceName + "'", edge.span.start);
            } else {
                if ctx.functions.has(edge.namespaceName) || ctx.structs.has(edge.namespaceName) || ctx.enums.has(edge.namespaceName) {
                    addError(ctx, "import namespace collides with declaration '" + edge.namespaceName + "'", edge.span.start);
                } else { ctx.namespaces.set(edge.namespaceName, summary.moduleId); }
            }
        }
        var itemIndex = 0;
        loop {
            if itemIndex >= edge.items.len() { break; }
            var importedName = edge.items[itemIndex];
            var found = false;
            if summary.functions.has(importedName) {
                var importedFunction: FunctionSig = summary.functions.get(importedName);
                if importedFunction.owner == "" {
                    found = true;
                    importFunctionBinding(ctx, importedName, importedFunction, edge.span.start);
                }
            }
            if !found && summary.structs.has(importedName) {
                var importedStruct: StructDeclStmt = summary.structs.get(importedName);
                found = true;
                if !importedStruct.isPub { addError(ctx, "cannot import private struct '" + importedName + "' from " + summary.sourcePath, edge.span.start); }
                else {
                    var structIndex = summary.structIndices.get(importedName);
                    importTypeBinding(ctx, importedName, summary.moduleId, summary.sourcePath, true, structIndex, importedStruct, edge.span.start);
                    installImportedMethods(ctx, summary, importedName, edge.span.start);
                }
            }
            if !found && summary.enums.has(importedName) {
                var importedEnum: EnumDeclStmt = summary.enums.get(importedName);
                found = true;
                if !importedEnum.isPub { addError(ctx, "cannot import private enum '" + importedName + "' from " + summary.sourcePath, edge.span.start); }
                else { importTypeBinding(ctx, importedName, summary.moduleId, summary.sourcePath, false, summary.enumIndices.get(importedName), importedEnum, edge.span.start); }
            }
            if !found { addError(ctx, "module " + summary.sourcePath + " has no public declaration '" + importedName + "'; '" + importedName + "' not found in file", edge.span.start); }
            itemIndex = itemIndex + 1;
        }
        i = i + 1;
    }
}

func validateDeclarations(ctx: TypecheckContext, program: Program) {
    var i = 0;
    loop {
        if i >= program.statements.len() { break; }
        var stmt = program.statements[i];
        match stmt {
        Stmt::StructDecl(decl) => {
            var seenFields: HashMap<string, bool> = HashMap.new();
            var j = 0;
            loop {
                if j >= decl.fields.len() { break; }
                var field = decl.fields[j];
                if seenFields.has(field.name) { addError(ctx, "duplicate field '" + field.name + "' on " + decl.name, decl.span.start); }
                seenFields.set(field.name, true);
                var fieldType = resolveTypeTag(ctx, field.typeExpr, field.typeTag, decl.span.start, false);
                if fieldType.kind == "Unknown" { }
                j = j + 1;
            }
            var m = 0;
            loop {
                if m >= decl.methods.len() { break; }
                var method = decl.methods[m];
                if method.returnTypeExpr != null || method.returnType != "" { resolveTypeTag(ctx, method.returnTypeExpr, method.returnType, method.span.start, true); }
                m = m + 1;
            }
        },
        Stmt::EnumDecl(enumDecl) => {
            var seenVariants: HashMap<string, bool> = HashMap.new();
            var v = 0;
            loop {
                if v >= enumDecl.variantDecls.len() { break; }
                var variant = enumDecl.variantDecls[v];
                if seenVariants.has(variant.name) { addError(ctx, "duplicate enum variant '" + variant.name + "'", variant.span.start); }
                seenVariants.set(variant.name, true);
                var namedPayload = false;
                var positionalPayload = false;
                var p = 0;
                loop {
                    if p >= variant.payloadTypes.len() { break; }
                    if p < variant.payloadNames.len() {
                        if variant.payloadNames[p] == "" { positionalPayload = true; }
                        else { namedPayload = true; }
                    }
                    resolveTypeExpr(ctx, variant.payloadTypes[p], false);
                    p = p + 1;
                }
                if namedPayload && positionalPayload { addError(ctx, "enum variant payloads must be all named or all positional", variant.span.start); }
                v = v + 1;
            }
        },
        _ => {},
        }
        i = i + 1;
    }
}

func defineGlobalPlaceholders(ctx: TypecheckContext, program: Program) {
    var i = 0;
    loop {
        if i >= program.statements.len() { break; }
        var stmt = program.statements[i];
        match stmt {
        Stmt::VarDecl(decl) => {
            if ctx.namespaces.has(decl.name) { addError(ctx, "variable name collides with imported namespace '" + decl.name + "'", decl.span.start); }
            if declaredNameCollides(ctx, decl.name) { addError(ctx, "duplicate declaration of '" + decl.name + "'", decl.span.start); }
            if ctx.globals.symbols.has(decl.name) { addError(ctx, "duplicate declaration of '" + decl.name + "'", decl.span.start); }
            else {
                ctx.globals.symbols.set(decl.name, Symbol { name: decl.name, ty: makeType("Unknown"), isConst: false });
                ctx.globalDeclSpans.set(decl.name, decl.span.start);
            }
        },
        Stmt::ConstDecl(declC) => {
            if ctx.namespaces.has(declC.name) { addError(ctx, "variable name collides with imported namespace '" + declC.name + "'", declC.span.start); }
            if declaredNameCollides(ctx, declC.name) { addError(ctx, "duplicate declaration of '" + declC.name + "'", declC.span.start); }
            if ctx.globals.symbols.has(declC.name) { addError(ctx, "duplicate declaration of '" + declC.name + "'", declC.span.start); }
            else {
                ctx.globals.symbols.set(declC.name, Symbol { name: declC.name, ty: makeType("Unknown"), isConst: true });
                ctx.globalDeclSpans.set(declC.name, declC.span.start);
            }
        },
        _ => {},
        }
        i = i + 1;
    }
}

func declaredNameCollides(ctx: TypecheckContext, name: string): bool {
    if ctx.structs.has(name) || ctx.enums.has(name) { return true; }
    if !ctx.functions.has(name) { return false; }
    var existing: FunctionSig = ctx.functions.get(name);
    return !isBuiltinSignature(existing);
}

func canAccessPrivateField(ctx: TypecheckContext, structName: string, structModule: string): bool {
    if ctx.currentStruct != structName { return false; }
    if structModule != "" && structModule != ctx.moduleId { return false; }
    return true;
}

func digitValue(text: string): int {
    if text == "0" { return 0; }
    if text == "1" { return 1; }
    if text == "2" { return 2; }
    if text == "3" { return 3; }
    if text == "4" { return 4; }
    if text == "5" { return 5; }
    if text == "6" { return 6; }
    if text == "7" { return 7; }
    if text == "8" { return 8; }
    if text == "9" { return 9; }
    if text == "a" || text == "A" { return 10; }
    if text == "b" || text == "B" { return 11; }
    if text == "c" || text == "C" { return 12; }
    if text == "d" || text == "D" { return 13; }
    if text == "e" || text == "E" { return 14; }
    if text == "f" || text == "F" { return 15; }
    return 0;
}

func integerLiteralValue(text: string): int {
    var body = text;
    var sign = 1;
    if body.startsWith("-") { sign = -1; body = body.slice(1, body.len()); }
    if body.startsWith("+") { body = body.slice(1, body.len()); }
    var base = 10;
    if body.len() > 2 && body.slice(0, 1) == "0" && (body.slice(1, 2) == "x" || body.slice(1, 2) == "X") {
        base = 16;
        body = body.slice(2, body.len());
    } else if body.len() > 2 && body.slice(0, 1) == "0" && (body.slice(1, 2) == "b" || body.slice(1, 2) == "B") {
        base = 2;
        body = body.slice(2, body.len());
    }
    var value = 0;
    var i = 0;
    loop {
        if i >= body.len() { break; }
        var digit = body.slice(i, i + 1);
        if digit != "_" { value = value * base + digitValue(digit); }
        i = i + 1;
    }
    return sign * value;
}

func bindingTooEarly(ctx: TypecheckContext, env: TypeEnv, name: string, span: int): bool {
    if env.symbols.has(name) {
        if env.parent == null && ctx.globalDeclSpans.has(name) && span < ctx.globalDeclSpans.get(name) { return true; }
        return false;
    }
    var parent = env.parent;
    if parent != null {
        var parentEnv: TypeEnv = parent;
        return bindingTooEarly(ctx, parentEnv, name, span);
    }
    return false;
}

func lookupIdentifier(ctx: TypecheckContext, env: TypeEnv, name: string, span: int): Type {
    if bindingTooEarly(ctx, env, name, span) {
        addError(ctx, "undefined variable '" + name + "'", span);
        return makeType("Unknown");
    }
    var found = lookupEnv(env, name);
    if found.found { return found.symbol.ty; }
    if ctx.functions.has(name) {
        var sig: FunctionSig = ctx.functions.get(name);
        return functionType(sig.params, sig.ret);
    }
    addError(ctx, "unknown identifier '" + name + "'", span);
    return makeType("Unknown");
}

func functionFromType(ty: Type): FunctionSig {
    var ret = makeType("Unknown");
    var functionReturn = ty.ret;
    if functionReturn != null {
        var functionReturnType: Type = functionReturn;
        ret = functionReturnType;
    }
    return makeSignature(ty.params, ty.params.len(), false, makeType("Unknown"), ret);
}

func checkCallArguments(ctx: TypecheckContext, sig: FunctionSig, args: Vec<Expr>, env: TypeEnv, span: int): Type {
    var minArgs = sig.required;
    var maxArgs = sig.params.len();
    if sig.variadic { maxArgs = maxArgs - 1; }
    if args.len() < minArgs || (!sig.variadic && args.len() > maxArgs) {
        if sig.variadic { addError(ctx, "function expects at least " + minArgs.toString() + " arguments, got " + args.len().toString(), span); }
        else if minArgs == maxArgs { addError(ctx, "function expects " + maxArgs.toString() + " arguments, got " + args.len().toString() + "; expects " + minArgs.toString() + "..=" + maxArgs.toString() + " arguments", span); }
        else { addError(ctx, "function expects " + minArgs.toString() + " to " + maxArgs.toString() + " arguments, got " + args.len().toString(), span); }
    }
    var i = 0;
    loop {
        if i >= args.len() { break; }
        var actual = inferExpr(ctx, env, args[i]);
        var expected = makeType("Unknown");
        if sig.variadic && i >= maxArgs { expected = sig.variadicType; }
        else if i < sig.params.len() { expected = sig.params[i]; }
        if !isUnknown(expected) && !canAssign(expected, actual) {
            addError(ctx, "argument " + (i + 1).toString() + " type mismatch: expected " + typeName(expected) + ", got " + typeName(actual) + "; argument expected " + diagnosticTypeName(expected) + " but got " + diagnosticTypeName(actual), span);
        }
        i = i + 1;
    }
    return sig.ret;
}

func findStructField(ctx: TypecheckContext, structName: string, fieldName: string): FieldLookup {
    var owner = "";
    if ctx.structOwners.has(structName) { owner = ctx.structOwners.get(structName); }
    return findStructFieldInModule(ctx, structName, owner, fieldName);
}

func storedStructFieldType(ctx: TypecheckContext, moduleId: string, structName: string, fieldIndex: int): Type? {
    if moduleId == "" || !ctx.moduleSummaries.has(moduleId) { return null; }
    var summary: ModuleSummary = ctx.moduleSummaries.get(moduleId);
    var layoutIndex = 0;
    loop {
        if layoutIndex >= summary.nominalLayouts.len() { break; }
        var layout: CheckedNominalLayout = summary.nominalLayouts[layoutIndex];
        if layout.kind == "Struct" && layout.name == structName && layout.moduleId == moduleId {
            var fieldPos = 0;
            loop {
                if fieldPos >= layout.fields.len() { break; }
                if layout.fields[fieldPos].fieldIndex == fieldIndex { return layout.fields[fieldPos].ty; }
                fieldPos = fieldPos + 1;
            }
        }
        layoutIndex = layoutIndex + 1;
    }
    return null;
}

func storedEnumPayloadType(ctx: TypecheckContext, enumName: string, variantIndex: int, payloadIndex: int): Type? {
    var owner = "";
    if ctx.enumOwners.has(enumName) { owner = ctx.enumOwners.get(enumName); }
    if owner == "" || owner == ctx.moduleId || !ctx.moduleSummaries.has(owner) { return null; }
    var summary: ModuleSummary = ctx.moduleSummaries.get(owner);
    var layoutIndex = 0;
    loop {
        if layoutIndex >= summary.nominalLayouts.len() { break; }
        var layout: CheckedNominalLayout = summary.nominalLayouts[layoutIndex];
        if layout.kind == "Enum" && layout.name == enumName && layout.moduleId == owner {
            var variantPos = 0;
            loop {
                if variantPos >= layout.variants.len() { break; }
                var variant: CheckedNominalVariant = layout.variants[variantPos];
                if variant.variantIndex == variantIndex && payloadIndex >= 0 && payloadIndex < variant.payloadTypes.len() {
                    return variant.payloadTypes[payloadIndex];
                }
                variantPos = variantPos + 1;
            }
        }
        layoutIndex = layoutIndex + 1;
    }
    return null;
}

func resolveDeclaredPayloadType(ctx: TypecheckContext, enumName: string, variantIndex: int, payloadIndex: int, fallback: TypeExpr): Type {
    var stored = storedEnumPayloadType(ctx, enumName, variantIndex, payloadIndex);
    if stored != null {
        var storedType: Type = stored;
        return storedType;
    }
    return resolveTypeExpr(ctx, fallback, false);
}

func resolveFieldTypeFromModule(ctx: TypecheckContext, moduleId: string, field: StructField, fallbackSpan: int): Type {
    if moduleId == "" || moduleId == ctx.moduleId {
        return resolveTypeTag(ctx, field.typeExpr, field.typeTag, fallbackSpan, false);
    }
    if !ctx.moduleSummaries.has(moduleId) {
        addError(ctx, "field type owner module is unavailable: " + moduleId, fallbackSpan);
        return makeType("Unknown");
    }
    var summary: ModuleSummary = ctx.moduleSummaries.get(moduleId);
    var oldStructs = ctx.structs;
    var oldEnums = ctx.enums;
    var oldStructOwners = ctx.structOwners;
    var oldStructSources = ctx.structSources;
    var oldStructIndices = ctx.structIndices;
    var oldEnumOwners = ctx.enumOwners;
    var oldEnumSources = ctx.enumSources;
    var oldEnumIndices = ctx.enumIndices;
    var oldPath = ctx.sourcePath;
    var oldModule = ctx.moduleId;
    ctx.structs = summary.structs;
    ctx.enums = summary.enums;
    ctx.structOwners = HashMap.new();
    ctx.structSources = HashMap.new();
    ctx.structIndices = summary.structIndices;
    ctx.enumOwners = HashMap.new();
    ctx.enumSources = HashMap.new();
    ctx.enumIndices = summary.enumIndices;
    var i = 0;
    var structKeys = summary.structs.keys();
    loop {
        if i >= structKeys.len() { break; }
        var name = structKeys.get(i);
        ctx.structOwners.set(name, summary.moduleId);
        ctx.structSources.set(name, summary.sourcePath);
        i = i + 1;
    }
    i = 0;
    var enumKeys = summary.enums.keys();
    loop {
        if i >= enumKeys.len() { break; }
        var enumName = enumKeys.get(i);
        ctx.enumOwners.set(enumName, summary.moduleId);
        ctx.enumSources.set(enumName, summary.sourcePath);
        i = i + 1;
    }
    ctx.sourcePath = summary.sourcePath;
    ctx.moduleId = summary.moduleId;
    var result = resolveTypeTag(ctx, field.typeExpr, field.typeTag, fallbackSpan, false);
    ctx.structs = oldStructs;
    ctx.enums = oldEnums;
    ctx.structOwners = oldStructOwners;
    ctx.structSources = oldStructSources;
    ctx.structIndices = oldStructIndices;
    ctx.enumOwners = oldEnumOwners;
    ctx.enumSources = oldEnumSources;
    ctx.enumIndices = oldEnumIndices;
    ctx.sourcePath = oldPath;
    ctx.moduleId = oldModule;
    return result;
}

func findStructFieldInModule(ctx: TypecheckContext, structName: string, moduleId: string, fieldName: string): FieldLookup {
    var decl: StructDeclStmt = StructDeclStmt { name: "", fields: [], methods: [], isPub: false, span: ctx.program.span };
    var structIndex = -1;
    var structSource = "";
    var structModule = moduleId;
    if moduleId == "" || moduleId == ctx.moduleId {
        if !ctx.structs.has(structName) { return FieldLookup { found: false, ty: makeType("Unknown"), isPub: false, fieldIndex: -1, structIndex: -1, sourcePath: "", moduleId: "" }; }
        decl = ctx.structs.get(structName);
        if ctx.structIndices.has(structName) { structIndex = ctx.structIndices.get(structName); }
        if ctx.structSources.has(structName) { structSource = ctx.structSources.get(structName); }
        if ctx.structOwners.has(structName) { structModule = ctx.structOwners.get(structName); }
    } else if ctx.moduleSummaries.has(moduleId) {
        var summary: ModuleSummary = ctx.moduleSummaries.get(moduleId);
        if !summary.structs.has(structName) { return FieldLookup { found: false, ty: makeType("Unknown"), isPub: false, fieldIndex: -1, structIndex: -1, sourcePath: summary.sourcePath, moduleId: moduleId }; }
        decl = summary.structs.get(structName);
        if summary.structIndices.has(structName) { structIndex = summary.structIndices.get(structName); }
        structSource = summary.sourcePath;
    } else {
        return FieldLookup { found: false, ty: makeType("Unknown"), isPub: false, fieldIndex: -1, structIndex: -1, sourcePath: "", moduleId: moduleId };
    }
    var i = 0;
    loop {
        if i >= decl.fields.len() { break; }
        var field = decl.fields[i];
        if field.name == fieldName {
            var ty = makeType("Unknown");
            var haveStored = false;
            if structModule != "" && structModule != ctx.moduleId {
                var storedField = storedStructFieldType(ctx, structModule, structName, i);
                if storedField != null {
                    var storedFieldType: Type = storedField;
                    ty = storedFieldType;
                    haveStored = true;
                }
            }
            if !haveStored { ty = resolveFieldTypeFromModule(ctx, structModule, field, decl.span.start); }
            return FieldLookup { found: true, ty: ty, isPub: field.isPub, fieldIndex: i, structIndex: structIndex, sourcePath: structSource, moduleId: structModule };
        }
        i = i + 1;
    }
    return FieldLookup { found: false, ty: makeType("Unknown"), isPub: false, fieldIndex: -1, structIndex: structIndex, sourcePath: structSource, moduleId: structModule };
}

func methodSignature(ctx: TypecheckContext, receiver: Type, method: string, span: int): FunctionSig {
    if receiver.kind == "Struct" {
        var key = receiver.name + "." + method;
        if ctx.functions.has(key) {
            var localMethod: FunctionSig = ctx.functions.get(key);
            if localMethod.moduleId == "" || receiver.moduleId == "" || localMethod.moduleId == receiver.moduleId || receiver.moduleId == ctx.moduleId { return localMethod; }
        }
        if receiver.moduleId != "" && ctx.moduleSummaries.has(receiver.moduleId) {
            var ownerSummary: ModuleSummary = ctx.moduleSummaries.get(receiver.moduleId);
            if ownerSummary.functions.has(key) {
                var ownedMethod: FunctionSig = ownerSummary.functions.get(key);
                if ownedMethod.isPub { return ownedMethod; }
                addError(ctx, "cannot access private method '" + method + "' on " + receiver.name, span);
                return emptySignature();
            }
        }
        if method == "toString" { return makeSignature([], 0, false, makeType("Any"), makeType("String")); }
        addError(ctx, "unknown method '" + method + "' on " + receiver.name, span);
        return emptySignature();
    }
    var int = makeType("Int");
    var str = makeType("String");
    var bool = makeType("Bool");
    var void = makeType("Void");
    var any = makeType("Any");
    if method == "toString" { return makeSignature([], 0, false, any, str); }
    if receiver.kind == "Any" { return makeSignature([], 0, true, any, any); }
    if receiver.kind == "String" {
        if method == "len" { return makeSignature([], 0, false, any, int); }
        if method == "toString" || method == "toUpper" || method == "toLower" || method == "trim" { return makeSignature([], 0, false, any, str); }
        if method == "contains" || method == "startsWith" || method == "endsWith" { return makeSignature([str], 1, false, any, bool); }
        if method == "indexOf" { return makeSignature([str], 1, false, any, int); }
        if method == "slice" { return makeSignature([int, int], 2, false, any, str); }
        if method == "replace" { return makeSignature([str, str], 2, false, any, str); }
        if method == "repeat" { return makeSignature([int], 1, false, any, str); }
        if method == "split" { return makeSignature([str], 1, false, any, arrayType(str)); }
        if method == "toInt" { return makeSignature([], 0, false, any, int); }
        if method == "toFloat" { return makeSignature([], 0, false, any, makeType("Float")); }
        if method == "hash" { return makeSignature([], 0, false, any, int); }
        if method == "padLeft" || method == "padRight" { return makeSignature([int, str], 2, false, any, str); }
    }
    if receiver.kind == "Int" || receiver.kind == "Float" {
        if method == "toInt" { return makeSignature([], 0, false, any, int); }
        if method == "toFloat" { return makeSignature([], 0, false, any, makeType("Float")); }
    }
    if receiver.kind == "Array" {
        var inner = makeType("Any");
        var maybeInner = receiver.inner;
        if maybeInner != null {
            var resolvedInner: Type = maybeInner;
            inner = resolvedInner;
        }
        if method == "len" { return makeSignature([], 0, false, any, int); }
        if method == "push" { return makeSignature([inner], 1, false, any, void); }
        if method == "get" { return makeSignature([int], 1, false, any, inner); }
        if method == "set" { return makeSignature([int, inner], 2, false, any, void); }
        if method == "pop" { return makeSignature([], 0, false, any, inner); }
        if method == "contains" { return makeSignature([inner], 1, false, any, bool); }
        if method == "indexOf" { return makeSignature([inner], 1, false, any, int); }
        if method == "slice" { return makeSignature([int, int], 2, false, any, receiver); }
        if method == "reverse" || method == "sort" { return makeSignature([], 0, false, any, void); }
        if method == "join" && inner.kind == "String" { return makeSignature([str], 1, false, any, str); }
    }
    if receiver.kind == "Dict" {
        var valueType = makeType("Any");
        var maybeValue = receiver.value;
        if maybeValue != null {
            var resolvedValue: Type = maybeValue;
            valueType = resolvedValue;
        }
        if method == "len" { return makeSignature([], 0, false, any, int); }
        if method == "get" { return makeSignature([str], 1, false, any, valueType); }
        if method == "set" { return makeSignature([str, valueType], 2, false, any, void); }
        if method == "has" { return makeSignature([str], 1, false, any, bool); }
        if method == "delete" { return makeSignature([str], 1, false, any, void); }
        if method == "keys" { return makeSignature([], 0, false, any, arrayType(str)); }
        if method == "values" { return makeSignature([], 0, false, any, arrayType(valueType)); }
        if method == "entries" { return makeSignature([], 0, false, any, arrayType(makeType("Any"))); }
    }
    if receiver.kind == "Option" {
        var innerOption = makeType("Any");
        var maybeOptionInner = receiver.inner;
        if maybeOptionInner != null {
            var resolvedOptionInner: Type = maybeOptionInner;
            innerOption = resolvedOptionInner;
        }
        if method == "isSome" || method == "isNone" { return makeSignature([], 0, false, any, bool); }
        if method == "unwrap" { return makeSignature([], 0, false, any, innerOption); }
        if method == "unwrapOr" { return makeSignature([innerOption], 1, false, any, innerOption); }
    }
    if receiver.kind == "Result" {
        var innerResult = makeType("Any");
        var errorResult = makeType("Any");
        var maybeResultInner = receiver.inner;
        if maybeResultInner != null {
            var resolvedResultInner: Type = maybeResultInner;
            innerResult = resolvedResultInner;
        }
        var maybeResultError = receiver.key;
        if maybeResultError != null {
            var resolvedResultError: Type = maybeResultError;
            errorResult = resolvedResultError;
        }
        if method == "isOk" || method == "isErr" { return makeSignature([], 0, false, any, bool); }
        if method == "unwrap" { return makeSignature([], 0, false, any, innerResult); }
        if method == "unwrapErr" { return makeSignature([], 0, false, any, errorResult); }
        if method == "unwrapOr" { return makeSignature([innerResult], 1, false, any, innerResult); }
    }
    addError(ctx, "unknown method '" + method + "' on " + typeName(receiver), span);
    return emptySignature();
}

func moduleStructCount(ctx: TypecheckContext): int {
    var count = 0;
    var i = 0;
    loop {
        if i >= ctx.program.statements.len() { break; }
        match ctx.program.statements[i] {
            Stmt::StructDecl(_) => { count = count + 1; },
            _ => {},
        }
        i = i + 1;
    }
    return count;
}

func moduleStructCountFor(ctx: TypecheckContext, moduleId: string): int {
    if moduleId == ctx.moduleId { return moduleStructCount(ctx); }
    if ctx.moduleSummaries.has(moduleId) {
        var summary: ModuleSummary = ctx.moduleSummaries.get(moduleId);
        return summary.structCount;
    }
    return 0;
}

func identifierPayload(expr: Expr): IdentExpr? {
    match expr {
        Expr::Error(_) => { return null; },
        Expr::Literal(_) => { return null; },
        Expr::Identifier(payload) => { return payload; },
        Expr::Binary(_) => { return null; },
        Expr::Unary(_) => { return null; },
        Expr::Update(_) => { return null; },
        Expr::Call(_) => { return null; },
        Expr::EnumVariant(_) => { return null; },
        Expr::Index(_) => { return null; },
        Expr::FieldAccess(_) => { return null; },
        Expr::Lambda(_) => { return null; },
        Expr::Match(_) => { return null; },
        Expr::If(_) => { return null; },
        Expr::Tuple(_) => { return null; },
        Expr::Array(_) => { return null; },
        Expr::Dict(_) => { return null; },
        Expr::StructLiteral(_) => { return null; },
    }
    return null;
}

