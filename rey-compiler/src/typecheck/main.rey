    return null;
}

func checkedStaticCreate(ctx: TypecheckContext, env: TypeEnv, targetType: Type, args: Vec<Expr>, span: int, callExpr: Expr): Type {
    if targetType.kind != "Struct" { return makeType("Unknown"); }
    var createFound = false;
    var createSig = emptySignature();
    if ctx.functions.has("create") {
        var localCreate: FunctionSig = ctx.functions.get("create");
        if localCreate.moduleId == targetType.moduleId { createFound = true; createSig = localCreate; }
    }
    if !createFound && ctx.moduleSummaries.has(targetType.moduleId) {
        var targetSummary: ModuleSummary = ctx.moduleSummaries.get(targetType.moduleId);
        if targetSummary.functions.has("create") { createFound = true; createSig = targetSummary.functions.get("create"); }
    }
    if moduleStructCountFor(ctx, targetType.moduleId) != 1 || !createFound {
        addError(ctx, "no qualifying pub func create for static call '" + targetType.name + ".create'", span);
        var ignored = 0;
        loop { if ignored >= args.len() { break; } inferExpr(ctx, env, args[ignored]); ignored = ignored + 1; }
        return makeType("Unknown");
    }
    var sig = createSig;
    if sig.owner != "" || !sig.isPub || sig.moduleId != targetType.moduleId || sig.ret.kind != "Struct" || sig.ret.name != targetType.name || sig.ret.moduleId != targetType.moduleId {
        addError(ctx, "no qualifying pub func create for static call '" + targetType.name + ".create'", span);
        var ignored2 = 0;
        loop { if ignored2 >= args.len() { break; } inferExpr(ctx, env, args[ignored2]); ignored2 = ignored2 + 1; }
        return makeType("Unknown");
    }
    var result = checkCallArguments(ctx, sig, args, env, span);
    var symbol = resolvedCallSymbol(ctx, "create", sig, "StaticCreate", "", targetType);
    recordExprInfo(ctx, callExpr, result, symbol, targetType, -1, -1, -1, -1);
    return result;
}

func vecElementType(receiver: Type): Type {
    var inner = makeType("Any");
    var maybeInner = receiver.inner;
    if maybeInner != null {
        var resolvedInner: Type = maybeInner;
        inner = resolvedInner;
    }
    return inner;
}

func functionResultType(ty: Type): Type {
    var maybeReturn = ty.ret;
    if maybeReturn != null {
        var resolvedReturn: Type = maybeReturn;
        return resolvedReturn;
    }
    return makeType("Void");
}

func mutuallyAssignable(left: Type, right: Type): bool {
    return canAssign(left, right) && canAssign(right, left);
}

func recordBuiltinMethod(ctx: TypecheckContext, callExpr: Expr, result: Type, name: string, receiver: Type) {
    var sig = makeSignature([], 0, false, makeType("Any"), result);
    var symbol = resolvedCallSymbol(ctx, "Vec." + name, sig, "Builtin", "Vec." + name, receiver);
    recordExprInfo(ctx, callExpr, result, symbol, receiver, -1, -1, -1, -1);
}

func inferVecHigherOrder(ctx: TypecheckContext, env: TypeEnv, receiver: Type, name: string, args: Vec<Expr>, span: int, callExpr: Expr): Type {
    var inner = vecElementType(receiver);
    if name == "map" || name == "filter" {
        if args.len() != 1 {
            addError(ctx, "Vec." + name + "() expects 1 argument", span);
            return makeType("Unknown");
        }
        var callback = inferExpr(ctx, env, args[0]);
        if callback.kind == "Any" {
            var anyResult = arrayType(inner);
            if name == "map" { anyResult = arrayType(makeType("Any")); }
            recordBuiltinMethod(ctx, callExpr, anyResult, name, receiver);
            return anyResult;
        }
        if callback.kind != "Function" || callback.params.len() != 1 || !mutuallyAssignable(callback.params[0], inner) {
            addError(ctx, "Vec." + name + "() requires a function accepting " + typeName(inner), span);
            return makeType("Unknown");
        }
        var callbackReturn = functionResultType(callback);
        if name == "filter" {
            if callbackReturn.kind != "Bool" && callbackReturn.kind != "Any" {
                addError(ctx, "Vec.filter() requires a function returning bool", span);
                return makeType("Unknown");
            }
            var filtered = arrayType(inner);
            recordBuiltinMethod(ctx, callExpr, filtered, name, receiver);
            return filtered;
        }
        var mapped = arrayType(callbackReturn);
        recordBuiltinMethod(ctx, callExpr, mapped, name, receiver);
        return mapped;
    }
    if args.len() != 2 {
        addError(ctx, "Vec.reduce() expects 2 arguments", span);
        var skipped = 0;
        loop { if skipped >= args.len() { break; } inferExpr(ctx, env, args[skipped]); skipped = skipped + 1; }
        return makeType("Unknown");
    }
    var reduceCallback = inferExpr(ctx, env, args[0]);
    var initial = inferExpr(ctx, env, args[1]);
    if reduceCallback.kind == "Any" {
        recordBuiltinMethod(ctx, callExpr, initial, name, receiver);
        return initial;
    }
    if reduceCallback.kind != "Function" || reduceCallback.params.len() != 2 {
        addError(ctx, "Vec.reduce() callback must accept the accumulator and element", span);
        return makeType("Unknown");
    }
    var accumulator = reduceCallback.params[0];
    var element = reduceCallback.params[1];
    var reduced = functionResultType(reduceCallback);
    if !mutuallyAssignable(accumulator, initial) || !mutuallyAssignable(element, inner) || !canAssign(initial, reduced) {
        addError(ctx, "Vec.reduce() callback must accept the accumulator and element and return the accumulator", span);
        return makeType("Unknown");
    }
    recordBuiltinMethod(ctx, callExpr, initial, name, receiver);
    return initial;
}

func inferMethodCall(ctx: TypecheckContext, env: TypeEnv, access: FieldAccessExpr, args: Vec<Expr>, span: int, callExpr: Expr): Type {
    var staticIdentifier = identifierPayload(access.object);
    if staticIdentifier != null {
        var staticName = staticIdentifier.name;
        var shadowed = lookupEnv(env, staticName).found;
        var isNamespace = ctx.namespaces.has(staticName);
        if !shadowed && isNamespace {
            var moduleId: string = ctx.namespaces.get(staticName);
            if !ctx.moduleSummaries.has(moduleId) { addError(ctx, "import namespace is unavailable: " + staticName, span); return makeType("Unknown"); }
            var summary: ModuleSummary = ctx.moduleSummaries.get(moduleId);
            if !summary.functions.has(access.name) {
                addError(ctx, "module namespace '" + staticName + "' has no exported function '" + access.name + "'", span);
                var skipped = 0;
                loop { if skipped >= args.len() { break; } inferExpr(ctx, env, args[skipped]); skipped = skipped + 1; }
                return makeType("Unknown");
            }
            var importedSig: FunctionSig = summary.functions.get(access.name);
            if importedSig.owner != "" {
                addError(ctx, "module namespace '" + staticName + "' has no top-level function '" + access.name + "'", span);
                return makeType("Unknown");
            }
            if !importedSig.isPub {
                addError(ctx, "cannot access private function '" + access.name + "' through module '" + staticName + "'", span);
                return makeType("Unknown");
            }
            if !signatureTypesVisible(ctx, importedSig) {
                addError(ctx, "public function '" + access.name + "' exposes a private type", span);
                return makeType("Unknown");
            }
            var importedResult = checkCallArguments(ctx, importedSig, args, env, span);
            var importedSymbol = resolvedCallSymbol(ctx, access.name, importedSig, "Function", "", makeType("Unknown"));
            recordExprInfo(ctx, callExpr, importedResult, importedSymbol, makeType("Unknown"), -1, -1, -1, -1);
            return importedResult;
        }
        if !shadowed && !isNamespace && staticName == "Vec" && access.name == "new" {
            if args.len() != 0 { addError(ctx, "Vec.new expects 0 arguments", span); }
            var resultVec = arrayType(makeType("Any"));
            var vecSig = makeSignature([], 0, false, makeType("Any"), resultVec);
            var vecSymbol = resolvedCallSymbol(ctx, "Vec.new", vecSig, "Builtin", "Vec.new", makeType("Unknown"));
            recordExprInfo(ctx, callExpr, resultVec, vecSymbol, makeType("Unknown"), -1, -1, -1, -1);
            return resultVec;
        }
        if !shadowed && !isNamespace && staticName == "HashMap" && access.name == "new" {
            if args.len() != 0 { addError(ctx, "HashMap.new expects 0 arguments", span); }
            var resultMap = dictType(makeType("Any"));
            var mapSig = makeSignature([], 0, false, makeType("Any"), resultMap);
            var mapSymbol = resolvedCallSymbol(ctx, "HashMap.new", mapSig, "Builtin", "HashMap.new", makeType("Unknown"));
            recordExprInfo(ctx, callExpr, resultMap, mapSymbol, makeType("Unknown"), -1, -1, -1, -1);
            return resultMap;
        }
        if !shadowed && !isNamespace && ((staticName == "Option" && (access.name == "None" || access.name == "Some")) || (staticName == "Result" && (access.name == "Ok" || access.name == "Err"))) {
            var variantExpr = EnumVariantExpr { enumName: staticName, variant: access.name, args: args, span: access.span };
            return inferEnumVariant(ctx, env, variantExpr, callExpr);
        }
        if !shadowed && !isNamespace && ctx.structs.has(staticName) && access.name == "create" {
            return checkedStaticCreate(ctx, env, resolveNamedType(ctx, staticName, span, false), args, span, callExpr);
        }
    }
    var staticAccess = fieldAccessPayload(access.object);
    if staticAccess != null && access.name == "create" {
        var targetType = inferExpr(ctx, env, access.object);
        if targetType.kind == "Struct" { return checkedStaticCreate(ctx, env, targetType, args, span, callExpr); }
    }
    var receiver = inferExpr(ctx, env, access.object);
    if receiver.kind == "Array" && (access.name == "map" || access.name == "filter" || access.name == "reduce") {
        return inferVecHigherOrder(ctx, env, receiver, access.name, args, span, callExpr);
    }
    var sig = methodSignature(ctx, receiver, access.name, span);
    if receiver.kind == "Struct" && receiver.moduleId != "" && receiver.moduleId != ctx.moduleId && !signatureTypesVisible(ctx, sig) {
        addError(ctx, "public method '" + access.name + "' exposes a private type", span);
        return makeType("Unknown");
    }
    var result = checkCallArguments(ctx, sig, args, env, span);
    var kind = "Builtin";
    var intrinsic = "";
    var receiverName = typeName(receiver);
    if receiver.kind == "Array" { receiverName = "Vec"; }
    if receiver.kind == "Dict" { receiverName = "HashMap"; }
    var symbolName = receiverName + "." + access.name;
    if receiver.kind == "Struct" && sig.owner != "" {
        kind = "Method";
        symbolName = receiver.name + "." + access.name;
    } else {
        intrinsic = symbolName;
    }
    var symbol = resolvedCallSymbol(ctx, symbolName, sig, kind, intrinsic, receiver);
    recordExprInfo(ctx, callExpr, result, symbol, receiver, -1, -1, -1, -1);
    return result;
}

func tupleMemberIndex(name: string): int {
    if name.len() == 0 { return -1; }
    var i = 0;
    loop {
        if i >= name.len() { break; }
        var digit = name.slice(i, i + 1);
        if digit < "0" || digit > "9" { return -1; }
        i = i + 1;
    }
    return name.toInt();
}

func uniqueEnumVariant(ctx: TypecheckContext, variantName: string): string {
    var found = "";
    var count = 0;
    var names = ctx.enums.keys();
    var i = 0;
    loop {
        if i >= names.len() { break; }
        var enumName = names[i];
        var decl: EnumDeclStmt = ctx.enums.get(enumName);
        var v = 0;
        loop {
            if v >= decl.variantDecls.len() { break; }
            if decl.variantDecls[v].name == variantName {
                count = count + 1;
                found = enumName;
            }
            v = v + 1;
        }
        i = i + 1;
    }
    if count == 1 { return found; }
    return "";
}

func conversionResult(ctx: TypecheckContext, name: string, source: Type, span: int): Type {
    var allowed = false;
    var result = makeType("Unknown");
    if name == "int" {
        result = makeType("Int");
        allowed = source.kind == "Int" || source.kind == "Char" || source.kind == "Any";
    } else if name == "char" {
        result = makeType("Char");
        allowed = source.kind == "Int" || source.kind == "Char" || source.kind == "Any";
    } else if name == "float" {
        result = makeType("Float");
        allowed = source.kind == "Int" || source.kind == "Float" || source.kind == "Any";
    } else if name == "string" {
        result = makeType("String");
        allowed = true;
    }
    if isUnknown(source) { return result; }
    if !allowed { addError(ctx, name + "() is not supported on " + typeName(source), span); return makeType("Unknown"); }
    return result;
}

func inferCall(ctx: TypecheckContext, env: TypeEnv, expr: CallExpr, original: Expr): Type {
    var calleeIdentifier = identifierPayload(expr.callee);
    if calleeIdentifier != null {
        var name = calleeIdentifier.name;
        var local = lookupEnv(env, name);
        if local.found {
            if local.symbol.ty.kind == "Function" {
                var localSig = functionFromType(local.symbol.ty);
                var localResult = checkCallArguments(ctx, localSig, expr.args, env, expr.span.start);
                var localSymbol = resolvedCallSymbol(ctx, name, localSig, "Local", "", makeType("Unknown"));
                recordExprInfo(ctx, original, localResult, localSymbol, makeType("Unknown"), -1, -1, -1, -1);
                return localResult;
            }
            addError(ctx, "value '" + name + "' is not callable", expr.span.start);
            return makeType("Unknown");
        }
        if ctx.functions.has(name) {
            var sig: FunctionSig = ctx.functions.get(name);
            if name == "print" || name == "println" || name == "eprint" || name == "eprintln" {
                var printIndex = 0;
                loop {
                    if printIndex >= expr.args.len() { break; }
                    var printType = inferExpr(ctx, env, expr.args[printIndex]);
                    if !isUnknown(printType) && !isRenderable(printType) {
                        addError(ctx, "print argument " + (printIndex + 1).toString() + " has non-renderable type " + typeName(printType), expr.span.start);
                    }
                    printIndex = printIndex + 1;
                }
                var printSig = makeSignature([], 0, true, makeType("Any"), makeType("Void"));
                var printSymbol = resolvedCallSymbol(ctx, name, printSig, "Builtin", name, makeType("Unknown"));
                recordExprInfo(ctx, original, makeType("Void"), printSymbol, makeType("Unknown"), -1, -1, -1, -1);
                return makeType("Void");
            }
            if name == "abs" || name == "min" || name == "max" || name == "floor" || name == "ceil" || name == "round" || name == "sqrt" || name == "pow" || name == "log" || name == "sin" || name == "cos" || name == "tan" {
                var numericArgs = [];
                var ai = 0;
                loop {
                    if ai >= expr.args.len() { break; }
                    var argType = inferExpr(ctx, env, expr.args[ai]);
                    if !isNumeric(argType) && argType.kind != "Any" && !isUnknown(argType) { addError(ctx, "numeric builtin '" + name + "' requires numbers", expr.span.start); }
                    numericArgs.push(argType);
                    ai = ai + 1;
                }
                if ((name == "abs" || name == "floor" || name == "ceil" || name == "round" || name == "sqrt" || name == "log" || name == "sin" || name == "cos" || name == "tan") && numericArgs.len() != 1) { addError(ctx, name + " expects 1 argument", expr.span.start); }
                if ((name == "min" || name == "max" || name == "pow") && numericArgs.len() != 2) { addError(ctx, name + " expects 2 arguments", expr.span.start); }
                var numericResult = makeType("Unknown");
                if name == "abs" && numericArgs.len() > 0 { numericResult = numericArgs[0]; }
                if ((name == "min" || name == "max") && numericArgs.len() > 1) { numericResult = joinTypes(numericArgs[0], numericArgs[1]); }
                if name == "floor" || name == "ceil" || name == "round" { numericResult = makeType("Int"); }
                if name == "sqrt" || name == "pow" || name == "log" || name == "sin" || name == "cos" || name == "tan" { numericResult = makeType("Float"); }
                var numericSymbol = resolvedCallSymbol(ctx, name, sig, "Builtin", name, makeType("Unknown"));
                recordExprInfo(ctx, original, numericResult, numericSymbol, makeType("Unknown"), -1, -1, -1, -1);
                return numericResult;
            }
            if name == "int" || name == "char" || name == "float" || name == "string" {
                if expr.args.len() != 1 { addError(ctx, name + " expects 1 argument", expr.span.start); }
                var source = makeType("Unknown");
                if expr.args.len() > 0 { source = inferExpr(ctx, env, expr.args[0]); }
                var converted = conversionResult(ctx, name, source, expr.span.start);
                var convertSymbol = resolvedCallSymbol(ctx, name, sig, "Builtin", name, makeType("Unknown"));
                recordExprInfo(ctx, original, converted, convertSymbol, makeType("Unknown"), -1, -1, -1, -1);
                return converted;
            }
            var callResult = checkCallArguments(ctx, sig, expr.args, env, expr.span.start);
            var symbolKind = "Function";
            var intrinsicId = "";
            if sig.sourcePath == "" { symbolKind = "Builtin"; intrinsicId = name; }
            var callSymbol = resolvedCallSymbol(ctx, name, sig, symbolKind, intrinsicId, makeType("Unknown"));
            recordExprInfo(ctx, original, callResult, callSymbol, makeType("Unknown"), -1, -1, -1, -1);
            return callResult;
        }
        var variantOwner = uniqueEnumVariant(ctx, name);
        if variantOwner != "" {
            var variantExpr = EnumVariantExpr { enumName: variantOwner, variant: name, args: expr.args, span: expr.span };
            return inferEnumVariant(ctx, env, variantExpr, original);
        }
        var foundPrivate = false;
        var nsKeys = ctx.namespaces.keys();
        var nsi = 0;
        loop {
            if nsi >= nsKeys.len() { break; }
            var modId = ctx.namespaces.get(nsKeys[nsi]);
            if ctx.moduleSummaries.has(modId) {
                var modSum: ModuleSummary = ctx.moduleSummaries.get(modId);
                if modSum.functions.has(name) {
                    var fnSig: FunctionSig = modSum.functions.get(name);
                    if !fnSig.isPub {
                        addError(ctx, "cannot access private function '" + name + "' from " + modSum.sourcePath, expr.span.start);
                        foundPrivate = true;
                        break;
                    }
                }
            }
            nsi = nsi + 1;
        }
        if !foundPrivate {
            addError(ctx, "unknown function '" + name + "'", expr.span.start);
        }
        var i = 0;
        loop { if i >= expr.args.len() { break; } inferExpr(ctx, env, expr.args[i]); i = i + 1; }
        return makeType("Unknown");
    }
    var calleeAccess = fieldAccessPayload(expr.callee);
    if calleeAccess != null {
        return inferMethodCall(ctx, env, calleeAccess, expr.args, expr.span.start, original);
    }
    var calleeType = inferExpr(ctx, env, expr.callee);
    if calleeType.kind == "Function" {
        var dynamicSig = functionFromType(calleeType);
        var dynamicResult = checkCallArguments(ctx, dynamicSig, expr.args, env, expr.span.start);
        var dynamicSymbol = resolvedCallSymbol(ctx, "<function>", dynamicSig, "Local", "", makeType("Unknown"));
        recordExprInfo(ctx, original, dynamicResult, dynamicSymbol, makeType("Unknown"), -1, -1, -1, -1);
        return dynamicResult;
    }
    if !isUnknown(calleeType) { addError(ctx, "expression of type " + typeName(calleeType) + " is not callable", expr.span.start); }
    return makeType("Unknown");
}

func inferStructLiteral(ctx: TypecheckContext, env: TypeEnv, expr: StructLiteralExpr, original: Expr): Type {
    if !ctx.structs.has(expr.name) {
        addError(ctx, "unknown struct '" + expr.name + "'", expr.span.start);
        var i0 = 0;
        loop { if i0 >= expr.fields.len() { break; } inferExpr(ctx, env, expr.fields[i0].value); i0 = i0 + 1; }
        return makeType("Unknown");
    }
    var decl: StructDeclStmt = ctx.structs.get(expr.name);
    var seen: HashMap<string, bool> = HashMap.new();
    var i = 0;
    loop {
        if i >= expr.fields.len() { break; }
        var initField = expr.fields[i];
        if seen.has(initField.name) { addError(ctx, "duplicate field '" + initField.name + "' in " + expr.name + " literal", initField.span.start); }
        seen.set(initField.name, true);
        var field = findStructField(ctx, expr.name, initField.name);
        var actual = inferExpr(ctx, env, initField.value);
        if !field.found { addError(ctx, "unknown field '" + initField.name + "' on " + expr.name, initField.span.start); }
        else {
            if field.moduleId != "" && field.moduleId != ctx.moduleId && !field.isPub { addError(ctx, "cannot initialize private field '" + initField.name + "' on " + expr.name, initField.span.start); }
            if field.moduleId != "" && field.moduleId != ctx.moduleId && !typeVisibleToCaller(ctx, field.ty) { addError(ctx, "public field '" + initField.name + "' exposes a private type", initField.span.start); }
            expectType(ctx, field.ty, actual, "field '" + initField.name + "' type mismatch", initField.span.start);
            recordFieldInitializer(ctx, original, expr, initField, field.fieldIndex, actual);
        }
        i = i + 1;
    }
    var j = 0;
    loop {
        if j >= decl.fields.len() { break; }
        if !seen.has(decl.fields[j].name) { addError(ctx, "missing field '" + decl.fields[j].name + "' in " + expr.name + " literal", expr.span.start); }
        j = j + 1;
    }
    var resultType = resolveNamedType(ctx, expr.name, expr.span.start, false);
    var structIndex = -1;
    if ctx.structIndices.has(expr.name) { structIndex = ctx.structIndices.get(expr.name); }
    recordExprInfo(ctx, original, resultType, null, resultType, structIndex, -1, -1, -1);
    return resultType;
}

func enumVariantSymbol(ctx: TypecheckContext, enumName: string, variantName: string, payloads: Vec<Type>, result: Type, isPub: bool, enumIndex: int, variantIndex: int): ResolvedSymbol {
    var symbolName = enumName + "::" + variantName;
    var signature = functionType(payloads, result);
    return ResolvedSymbol {
        sourcePath: ctx.sourcePath,
        moduleId: ctx.moduleId,
        sourceName: symbolName,
        llvmName: "",
        kind: "EnumVariant",
        intrinsicId: "EnumVariant",
        isPub: isPub,
        signature: signature,
        callShape: CallShape { requiredCount: payloads.len(), fixedCount: payloads.len(), variadicIndex: -1 },
        declarationIndex: enumIndex,
        receiverType: result,
        receiverPassing: "None",
    };
}

func inferEnumVariant(ctx: TypecheckContext, env: TypeEnv, expr: EnumVariantExpr, original: Expr): Type {
    if expr.enumName == "Option" {
        if expr.variant == "None" {
            if expr.args.len() != 0 { addError(ctx, "Option::None expects 0 arguments", expr.span.start); }
            var optionNone = optionType(makeType("Any"));
            var noneSymbol = enumVariantSymbol(ctx, "Option", "None", [], optionNone, true, -1, 1);
            recordExprInfo(ctx, original, optionNone, noneSymbol, makeType("Unknown"), -1, -1, -1, 1);
            return optionNone;
        }
        if expr.variant == "Some" {
            if expr.args.len() != 1 { addError(ctx, "Option::Some expects 1 argument", expr.span.start); }
            var someType = makeType("Any");
            if expr.args.len() > 0 { someType = inferExpr(ctx, env, expr.args[0]); }
            var optionSome = optionType(someType);
            var someSymbol = enumVariantSymbol(ctx, "Option", "Some", [someType], optionSome, true, -1, 0);
            recordExprInfo(ctx, original, optionSome, someSymbol, makeType("Unknown"), -1, -1, -1, 0);
            return optionSome;
        }
        addError(ctx, "unknown Option variant '" + expr.variant + "'", expr.span.start);
        return makeType("Unknown");
    }
    if expr.enumName == "Result" {
        if expr.variant == "Ok" || expr.variant == "Err" {
            if expr.args.len() != 1 { addError(ctx, "Result::" + expr.variant + " expects 1 argument", expr.span.start); }
            var payload = makeType("Any");
            if expr.args.len() > 0 { payload = inferExpr(ctx, env, expr.args[0]); }
            var result = makeType("Unknown");
            var payloadTypes = [payload];
            var resultVariantIndex = 0;
            if expr.variant == "Ok" { result = resultType(payload, makeType("Any")); }
            else { result = resultType(makeType("Any"), payload); resultVariantIndex = 1; }
            var resultSymbol = enumVariantSymbol(ctx, "Result", expr.variant, payloadTypes, result, true, -1, resultVariantIndex);
            recordExprInfo(ctx, original, result, resultSymbol, makeType("Unknown"), -1, -1, -1, resultVariantIndex);
            return result;
        }
        addError(ctx, "unknown Result variant '" + expr.variant + "'", expr.span.start);
        return makeType("Unknown");
    }
    if !ctx.enums.has(expr.enumName) {
        addError(ctx, "unknown enum '" + expr.enumName + "'", expr.span.start);
        return makeType("Unknown");
    }
    var decl: EnumDeclStmt = ctx.enums.get(expr.enumName);
    var found = false;
    var enumIndex = -1;
    if ctx.enumIndices.has(expr.enumName) { enumIndex = ctx.enumIndices.get(expr.enumName); }
    var i = 0;
    loop {
        if i >= decl.variantDecls.len() { break; }
        var variant = decl.variantDecls[i];
        if variant.name == expr.variant {
            found = true;
            var payloadTypes: Vec<Type> = [];
            var payloadIndex = 0;
            loop {
                if payloadIndex >= variant.payloadTypes.len() { break; }
                payloadTypes.push(resolveDeclaredPayloadType(ctx, expr.enumName, i, payloadIndex, variant.payloadTypes[payloadIndex]));
                payloadIndex = payloadIndex + 1;
            }
            if expr.args.len() != variant.payloadTypes.len() { addError(ctx, "enum variant '" + expr.enumName + "::" + expr.variant + "' expects " + variant.payloadTypes.len().toString() + " arguments, got " + expr.args.len().toString(), expr.span.start); }
            var p = 0;
            loop {
                if p >= expr.args.len() || p >= variant.payloadTypes.len() { break; }
                var expected = resolveDeclaredPayloadType(ctx, expr.enumName, i, p, variant.payloadTypes[p]);
                expectType(ctx, expected, inferExpr(ctx, env, expr.args[p]), "enum payload type mismatch", expr.span.start);
                p = p + 1;
            }
            var resultType = resolveNamedType(ctx, expr.enumName, expr.span.start, false);
            var enumSymbol = enumVariantSymbol(ctx, expr.enumName, expr.variant, payloadTypes, resultType, decl.isPub, enumIndex, i);
            if ctx.enumSources.has(expr.enumName) { enumSymbol.sourcePath = ctx.enumSources.get(expr.enumName); }
            if ctx.enumOwners.has(expr.enumName) { enumSymbol.moduleId = ctx.enumOwners.get(expr.enumName); }
            recordExprInfo(ctx, original, resultType, enumSymbol, makeType("Unknown"), enumIndex, -1, enumIndex, i);
        }
        i = i + 1;
    }
    if !found { addError(ctx, "unknown enum variant '" + expr.enumName + "::" + expr.variant + "'", expr.span.start); }
    return resolveNamedType(ctx, expr.enumName, expr.span.start, false);
}

func inferIndex(ctx: TypecheckContext, env: TypeEnv, expr: IndexExpr): Type {
    var target = inferExpr(ctx, env, expr.target);
    var index = inferExpr(ctx, env, expr.index);
    if target.kind == "Array" {
        expectType(ctx, makeType("Int"), index, "Vec index must be int", expr.span.start);
        var inner = target.inner;
        if inner != null {
            var elementType: Type = inner;
            return elementType;
        }
        return makeType("Any");
    }
    if target.kind == "Dict" {
        expectType(ctx, makeType("String"), index, "HashMap key must be string", expr.span.start);
        var value = target.value;
        if value != null {
            var valueType: Type = value;
            return valueType;
        }
        return makeType("Any");
    }
    if target.kind == "String" {
        expectType(ctx, makeType("Int"), index, "string index must be int", expr.span.start);
        return makeType("Char");
    }
    if target.kind == "Any" { return makeType("Any"); }
    if !isUnknown(target) { addError(ctx, "value of type " + typeName(target) + " cannot be indexed", expr.span.start); }
    return makeType("Unknown");
}

func inferFieldAccess(ctx: TypecheckContext, env: TypeEnv, expr: FieldAccessExpr, original: Expr): Type {
    var namespacePayload = identifierPayload(expr.object);
    if namespacePayload != null {
        var namespaceIdent: IdentExpr = namespacePayload;
        if !lookupEnv(env, namespaceIdent.name).found && ctx.namespaces.has(namespaceIdent.name) {
            var moduleId: string = ctx.namespaces.get(namespaceIdent.name);
            if !ctx.moduleSummaries.has(moduleId) {
                addError(ctx, "import namespace is unavailable: " + namespaceIdent.name, expr.span.start);
                return makeType("Unknown");
            }
            var summary: ModuleSummary = ctx.moduleSummaries.get(moduleId);
            if summary.structs.has(expr.name) {
                var decl: StructDeclStmt = summary.structs.get(expr.name);
                if !decl.isPub { addError(ctx, "cannot access private struct '" + expr.name + "' through module '" + namespaceIdent.name + "'", expr.span.start); return makeType("Unknown"); }
                var structIndex: int = summary.structIndices.get(expr.name);
                var typeInfo = namedTypeOwned("Struct", expr.name, summary.sourcePath, summary.moduleId);
                var typeSymbol = ResolvedSymbol { sourcePath: summary.sourcePath, moduleId: summary.moduleId, sourceName: expr.name, llvmName: llvmSymbolNameAt(summary.moduleIndex, expr.name, ""), kind: "Struct", intrinsicId: "", isPub: true, signature: typeInfo, callShape: CallShape { requiredCount: 0, fixedCount: 0, variadicIndex: -1 }, declarationIndex: structIndex, receiverType: makeType("Unknown"), receiverPassing: "None" };
                recordExprInfo(ctx, original, typeInfo, typeSymbol, makeType("Unknown"), structIndex, -1, -1, -1);
                return typeInfo;
            }
            if summary.enums.has(expr.name) {
                var enumDecl: EnumDeclStmt = summary.enums.get(expr.name);
                if !enumDecl.isPub { addError(ctx, "cannot access private enum '" + expr.name + "' through module '" + namespaceIdent.name + "'", expr.span.start); return makeType("Unknown"); }
                var enumIndex: int = summary.enumIndices.get(expr.name);
                var enumType = namedTypeOwned("Enum", expr.name, summary.sourcePath, summary.moduleId);
                var enumSymbol = ResolvedSymbol { sourcePath: summary.sourcePath, moduleId: summary.moduleId, sourceName: expr.name, llvmName: llvmSymbolNameAt(summary.moduleIndex, expr.name, ""), kind: "Enum", intrinsicId: "", isPub: true, signature: enumType, callShape: CallShape { requiredCount: 0, fixedCount: 0, variadicIndex: -1 }, declarationIndex: enumIndex, receiverType: makeType("Unknown"), receiverPassing: "None" };
                recordExprInfo(ctx, original, enumType, enumSymbol, makeType("Unknown"), -1, -1, enumIndex, -1);
                return enumType;
            }
            if summary.functions.has(expr.name) {
                var sig: FunctionSig = summary.functions.get(expr.name);
                if sig.owner != "" { addError(ctx, "module namespace member is not a top-level function: " + expr.name, expr.span.start); return makeType("Unknown"); }
                if !sig.isPub { addError(ctx, "cannot access private function '" + expr.name + "' through module '" + namespaceIdent.name + "'", expr.span.start); return makeType("Unknown"); }
                return functionType(sig.params, sig.ret);
            }
            addError(ctx, "module namespace '" + namespaceIdent.name + "' has no public member '" + expr.name + "'", expr.span.start);
            return makeType("Unknown");
        }
    }
    var receiver = inferExpr(ctx, env, expr.object);
    if receiver.kind == "Struct" {
        var field = findStructFieldInModule(ctx, receiver.name, receiver.moduleId, expr.name);
        if field.found {
            if !field.isPub && !canAccessPrivateField(ctx, receiver.name, field.moduleId) {
                addError(ctx, "cannot access private field '" + expr.name + "' on " + receiver.name, expr.span.start);
                return makeType("Unknown");
            }
            if field.moduleId != "" && field.moduleId != ctx.moduleId && !typeVisibleToCaller(ctx, field.ty) {
                addError(ctx, "public field '" + expr.name + "' exposes a private type", expr.span.start);
                return makeType("Unknown");
            }
            var fieldSymbol = ResolvedSymbol {
                sourcePath: field.sourcePath,
                moduleId: field.moduleId,
                sourceName: receiver.name + "." + expr.name,
                llvmName: "",
                kind: "Field",
                intrinsicId: "",
                isPub: field.isPub,
                signature: field.ty,
                callShape: CallShape { requiredCount: 0, fixedCount: 0, variadicIndex: -1 },
                declarationIndex: field.fieldIndex,
                receiverType: receiver,
                receiverPassing: "None",
            };
            recordExprInfo(ctx, original, field.ty, fieldSymbol, receiver, field.structIndex, field.fieldIndex, -1, -1);
            return field.ty;
        }
        addError(ctx, "unknown field '" + expr.name + "' on " + receiver.name, expr.span.start);
        return makeType("Unknown");
    }
    if receiver.kind == "Enum" {
        var variantIndex = enumVariantIndex(ctx, receiver.name, expr.name);
        if variantIndex < 0 {
            addError(ctx, "enum '" + receiver.name + "' has no variant '" + expr.name + "'", expr.span.start);
            return makeType("Unknown");
        }
        var variantDecl = findVariantDecl(ctx, receiver.name, expr.name);
        if variantDecl != null {
            var variant: EnumVariantDecl = variantDecl;
            if variant.payloadTypes.len() > 0 {
                addError(ctx, "enum variant '" + receiver.name + "::" + expr.name + "' requires payload arguments", expr.span.start);
                return makeType("Unknown");
            }
        }
        var enumIndex = -1;
        if ctx.enumIndices.has(receiver.name) { enumIndex = ctx.enumIndices.get(receiver.name); }
        var isPub = true;
        if ctx.enums.has(receiver.name) { isPub = ctx.enums.get(receiver.name).isPub; }
        var emptyPayloads: Vec<Type> = [];
        var enumSymbol = enumVariantSymbol(ctx, receiver.name, expr.name, emptyPayloads, receiver, isPub, enumIndex, variantIndex);
        if ctx.enumSources.has(receiver.name) { enumSymbol.sourcePath = ctx.enumSources.get(receiver.name); }
        if ctx.enumOwners.has(receiver.name) { enumSymbol.moduleId = ctx.enumOwners.get(receiver.name); }
        recordExprInfo(ctx, original, receiver, enumSymbol, receiver, -1, -1, enumIndex, variantIndex);
        return receiver;
    }
    if receiver.kind == "Tuple" {
        var tupleIndex = tupleMemberIndex(expr.name);
        if tupleIndex < 0 {
            addError(ctx, "unknown field '" + expr.name + "' on tuple", expr.span.start);
            return makeType("Unknown");
        }
        if tupleIndex >= receiver.params.len() {
            addError(ctx, "tuple index " + tupleIndex.toString() + " out of bounds for tuple of length " + receiver.params.len().toString(), expr.span.start);
            return makeType("Unknown");
        }
        var elementType: Type = receiver.params[tupleIndex];
        recordExprInfo(ctx, original, elementType, null, receiver, -1, tupleIndex, -1, -1);
        return elementType;
    }
    if receiver.kind == "Any" { return makeType("Any"); }
    if !isUnknown(receiver) { addError(ctx, "unknown field '" + expr.name + "' on " + typeName(receiver), expr.span.start); }
    return makeType("Unknown");
}

func inferUpdateTarget(ctx: TypecheckContext, env: TypeEnv, target: Expr, span: int): Type {
    var identPayload = identifierPayload(target);
    if identPayload != null {
        var ident: IdentExpr = identPayload;
        var found = lookupEnv(env, ident.name);
        if bindingTooEarly(ctx, env, ident.name, ident.span.start) { addError(ctx, "undefined variable '" + ident.name + "'", ident.span.start); return makeType("Unknown"); }
        if !found.found { addError(ctx, "unknown identifier '" + ident.name + "'", ident.span.start); return makeType("Unknown"); }
        if found.symbol.isConst { addError(ctx, "cannot update const '" + ident.name + "'", span); }
        if found.crossedLambda { addError(ctx, "mutable capture of '" + ident.name + "'", span); }
        return found.symbol.ty;
    }
    var fieldPayload = fieldAccessPayload(target);
    if fieldPayload != null { return inferFieldAccess(ctx, env, fieldPayload, target); }
    var indexExpr = indexPayload(target);
    if indexExpr != null { return inferIndex(ctx, env, indexExpr); }
    var actual = inferExpr(ctx, env, target);
    if !isUnknown(actual) { addError(ctx, "increment/decrement target is not an lvalue", span); }
    return makeType("Unknown");
}

func inferArray(ctx: TypecheckContext, env: TypeEnv, expr: ArrayExpr): Type {
    var element = makeType("Unknown");
    var i = 0;
    loop {
        if i >= expr.elements.len() { break; }
        var actual = inferExpr(ctx, env, expr.elements[i]);
        if isUnknown(element) { element = actual; }
        else { element = joinTypes(element, actual); }
        i = i + 1;
    }
    if isUnknown(element) { element = makeType("Any"); }
    return arrayType(element);
}

func inferDict(ctx: TypecheckContext, env: TypeEnv, expr: DictExpr): Type {
    var valueType = makeType("Unknown");
    var i = 0;
    loop {
        if i >= expr.entries.len() { break; }
        var entry = expr.entries[i];
        var keyLiteral = literalPayload(entry.key);
        var keyIdentifier = identifierPayload(entry.key);
        if keyLiteral != null {
            var keyLit: LiteralExpr = keyLiteral;
            if keyLit.kind != LiteralKind::String { addError(ctx, "dictionary keys must be strings", entry.span.start); }
        } else if keyIdentifier == null {
            var keyType = inferExpr(ctx, env, entry.key);
            expectType(ctx, makeType("String"), keyType, "dictionary keys must be strings", entry.span.start);
        }
        var actual = inferExpr(ctx, env, entry.value);
        if isUnknown(valueType) { valueType = actual; }
        else { valueType = joinTypes(valueType, actual); }
        i = i + 1;
    }
    if isUnknown(valueType) { valueType = makeType("Any"); }
    return dictType(valueType);
}

func inferLambda(ctx: TypecheckContext, env: TypeEnv, expr: LambdaExpr, original: Expr): Type {
    var child = newEnv(env, true);
    var paramTypes: Vec<Type> = [];
    var i = 0;
    loop {
        if i >= expr.params.len() { break; }
        var paramType = makeType("Unknown");
        var maybeParamTypeExpr: TypeExpr? = null;
        if i < expr.paramTypeExprs.len() { maybeParamTypeExpr = expr.paramTypeExprs[i]; }
        if maybeParamTypeExpr != null {
            var paramTypeExpr: TypeExpr = maybeParamTypeExpr;
            paramType = resolveTypeExpr(ctx, paramTypeExpr, false);
        } else {
            addError(ctx, "lambda parameter '" + expr.params[i] + "' requires a type", expr.span.start);
        }
        paramTypes.push(paramType);
        defineSymbol(ctx, child, expr.params[i], paramType, false, expr.span.start);
        recordBinding(ctx, original, exprNodeKey(original), expr.params[i], paramType, "LambdaParameter", false, i);
        i = i + 1;
    }
    var oldInFunction = ctx.inFunction;
    var oldReturn = ctx.currentReturn;
    var oldReturns = ctx.returnTypes;
    var oldLoop = ctx.loopDepth;
    ctx.inFunction = true;
    ctx.currentReturn = makeType("Unknown");
    ctx.returnTypes = [];
    ctx.loopDepth = 0;
    var ret = makeType("Unknown");
    var bodyExpr = expr.bodyExpr;
    if bodyExpr != null {
        var lambdaExpr: Expr = bodyExpr;
        ret = inferExpr(ctx, child, lambdaExpr);
    }
    else {
        checkStatements(ctx, child, expr.body);
        ret = joinReturnTypes(ctx.returnTypes);
    }
    ctx.inFunction = oldInFunction;
    ctx.currentReturn = oldReturn;
    ctx.returnTypes = oldReturns;
    ctx.loopDepth = oldLoop;
    if isUnknown(ret) { addError(ctx, "cannot infer lambda return type", expr.span.start); }
    return functionType(paramTypes, ret);
}

func exprVariantName(expr: Expr): string {
    match expr {
        Expr::Error(_) => { return "Error"; },
        Expr::Literal(_) => { return "Literal"; },
        Expr::Identifier(_) => { return "Identifier"; },
        Expr::Binary(_) => { return "Binary"; },
        Expr::Unary(_) => { return "Unary"; },
        Expr::Update(_) => { return "Update"; },
        Expr::Call(_) => { return "Call"; },
        Expr::EnumVariant(_) => { return "EnumVariant"; },
        Expr::Index(_) => { return "Index"; },
        Expr::FieldAccess(_) => { return "FieldAccess"; },
        Expr::Lambda(_) => { return "Lambda"; },
        Expr::Match(_) => { return "Match"; },
        Expr::If(_) => { return "If"; },
        Expr::Tuple(_) => { return "Tuple"; },
        Expr::Array(_) => { return "Array"; },
        Expr::Dict(_) => { return "Dict"; },
        Expr::StructLiteral(_) => { return "StructLiteral"; },
    }
    return "Unknown";
}

func stmtVariantName(stmt: Stmt): string {
    match stmt {
        Stmt::VarDecl(_) => { return "VarDecl"; },
        Stmt::ConstDecl(_) => { return "ConstDecl"; },
        Stmt::FuncDecl(_) => { return "FuncDecl"; },
        Stmt::StructDecl(_) => { return "StructDecl"; },
        Stmt::EnumDecl(_) => { return "EnumDecl"; },
        Stmt::Import(_) => { return "Import"; },
        Stmt::If(_) => { return "If"; },
        Stmt::Assign(_) => { return "Assign"; },
        Stmt::Return(_) => { return "Return"; },
        Stmt::Break(_) => { return "Break"; },
        Stmt::Continue(_) => { return "Continue"; },
        Stmt::While(_) => { return "While"; },
        Stmt::For(_) => { return "For"; },
        Stmt::Loop(_) => { return "Loop"; },
        Stmt::Block(_) => { return "Block"; },
        Stmt::ExprStmt(_) => { return "ExprStmt"; },
        Stmt::Match(_) => { return "Match"; },
    }
    return "Unknown";
}

func exprNodeKey(expr: Expr): string {
    var span = exprSpan(expr);
    return exprVariantName(expr) + ":" + span.start.toString() + ":" + span.end.toString();
}

func metadataKey(sourcePath: string, moduleId: string, identity: string): string {
    return sourcePath.len().toString() + ":" + sourcePath + moduleId.len().toString() + ":" + moduleId + identity.len().toString() + ":" + identity;
}

func bindingIdentityKey(declarationKey: string, name: string, parameterIndex: int): string {
    return declarationKey.len().toString() + ":" + declarationKey + name.len().toString() + ":" + name + ":" + parameterIndex.toString();
}

func stmtNodeKey(stmt: Stmt): string {
    var span = stmtSpan(stmt);
    return stmtVariantName(stmt) + ":" + span.start.toString() + ":" + span.end.toString();
}

func funcDeclNodeKey(decl: FuncDeclStmt): string {
    return "FuncDeclPayload:" + decl.span.start.toString() + ":" + decl.span.end.toString();
}

func recordExprInfo(ctx: TypecheckContext, expr: Expr, ty: Type, symbol: ResolvedSymbol?, receiverType: Type, structIndex: int, fieldIndex: int, enumIndex: int, variantIndex: int) {
    if !ctx.recording { return; }
    var exprKey = exprNodeKey(expr);
    var key = metadataKey(ctx.sourcePath, ctx.moduleId, exprKey);
    if ctx.expressionIndex.has(key) {
        var indices: Vec<int> = ctx.expressionIndex.get(key);
        var candidateIndex = 0;
        loop {
            if candidateIndex >= indices.len() { break; }
            var index: int = indices[candidateIndex];
            var old: CheckedExprInfo = ctx.expressions[index];
            if old.expression == expr {
                old.ty = ty;
                if symbol != null { old.symbol = symbol; }
                if receiverType.kind != "Unknown" { old.receiverType = receiverType; }
                if structIndex >= 0 { old.structIndex = structIndex; }
                if fieldIndex >= 0 { old.fieldIndex = fieldIndex; }
                if enumIndex >= 0 { old.enumIndex = enumIndex; }
                if variantIndex >= 0 { old.variantIndex = variantIndex; }
                ctx.expressions[index] = old;
                return;
            }
            candidateIndex = candidateIndex + 1;
        }
    }
    var nodeId = ctx.nextNodeId;
    ctx.nextNodeId = ctx.nextNodeId + 1;
    ctx.expressions.push(CheckedExprInfo {
        sourcePath: ctx.sourcePath,
        moduleId: ctx.moduleId,
        nodeId: nodeId,
        expression: expr,
        ty: ty,
        symbol: symbol,
        receiverType: receiverType,
        structIndex: structIndex,
        fieldIndex: fieldIndex,
        enumIndex: enumIndex,
        variantIndex: variantIndex,
    });
    var newIndex = ctx.expressions.len() - 1;
    if ctx.expressionIndex.has(key) {
        var indices2: Vec<int> = ctx.expressionIndex.get(key);
        indices2.push(newIndex);
        ctx.expressionIndex.set(key, indices2);
    } else {
        ctx.expressionIndex.set(key, [newIndex]);
    }
}

func recordBinding(ctx: TypecheckContext, declaration, declarationKey: string, name: string, ty: Type, kind: string, isConst: bool, parameterIndex: int) {
    if !ctx.recording { return; }
    var identity = bindingIdentityKey(declarationKey, name, parameterIndex);
    var key = metadataKey(ctx.sourcePath, ctx.moduleId, identity);
    if ctx.bindingIndex.has(key) {
        var indices: Vec<int> = ctx.bindingIndex.get(key);
        var candidateIndex = 0;
        loop {
            if candidateIndex >= indices.len() { break; }
            var index: int = indices[candidateIndex];
            var old: CheckedBindingInfo = ctx.bindings[index];
            if old.declaration == declaration {
                old.ty = ty;
                old.kind = kind;
                old.isConst = isConst;
                ctx.bindings[index] = old;
                return;
            }
            candidateIndex = candidateIndex + 1;
        }
    }
    var nodeId = ctx.nextNodeId;
    ctx.nextNodeId = ctx.nextNodeId + 1;
    ctx.bindings.push(CheckedBindingInfo {
        sourcePath: ctx.sourcePath,
        moduleId: ctx.moduleId,
        nodeId: nodeId,
        declaration: declaration,
        declarationKey: declarationKey,
        name: name,
        ty: ty,
        kind: kind,
        isConst: isConst,
        parameterIndex: parameterIndex,
    });
    var newIndex = ctx.bindings.len() - 1;
    if ctx.bindingIndex.has(key) {
        var indices2: Vec<int> = ctx.bindingIndex.get(key);
        indices2.push(newIndex);
        ctx.bindingIndex.set(key, indices2);
    } else {
        ctx.bindingIndex.set(key, [newIndex]);
    }
}

func recordFieldInitializer(ctx: TypecheckContext, expression: Expr, literal: StructLiteralExpr, initializer: StructInitField, fieldIndex: int, valueType: Type) {
    if !ctx.recording { return; }
    var exprKey = exprNodeKey(expression);
    var initializerKey = bindingIdentityKey(exprKey + ":" + literal.span.start.toString() + ":" + literal.span.end.toString(), initializer.name, initializer.span.start);
    var key = metadataKey(ctx.sourcePath, ctx.moduleId, initializerKey + ":" + initializer.span.end.toString());
    if ctx.fieldInitializerIndex.has(key) {
        var indices: Vec<int> = ctx.fieldInitializerIndex.get(key);
        var candidateIndex = 0;
        loop {
            if candidateIndex >= indices.len() { break; }
            var index: int = indices[candidateIndex];
            var old: CheckedFieldInitInfo = ctx.fieldInitializers[index];
            if old.expression == expression && old.literal == literal && old.initializer == initializer {
                old.fieldIndex = fieldIndex;
                old.valueType = valueType;
                ctx.fieldInitializers[index] = old;
                return;
            }
            candidateIndex = candidateIndex + 1;
        }
    }
    var nodeId = ctx.nextNodeId;
    ctx.nextNodeId = ctx.nextNodeId + 1;
    ctx.fieldInitializers.push(CheckedFieldInitInfo { sourcePath: ctx.sourcePath, moduleId: ctx.moduleId, nodeId: nodeId, expression: expression, literal: literal, initializer: initializer, fieldIndex: fieldIndex, valueType: valueType });
    var newIndex = ctx.fieldInitializers.len() - 1;
    if ctx.fieldInitializerIndex.has(key) {
        var indices2: Vec<int> = ctx.fieldInitializerIndex.get(key);
        indices2.push(newIndex);
        ctx.fieldInitializerIndex.set(key, indices2);
    } else {
        ctx.fieldInitializerIndex.set(key, [newIndex]);
    }
}

func isAssignmentOp(op: string): bool {
    return op == "=" || op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=";
}

func inferAssignExpr(ctx: TypecheckContext, env: TypeEnv, binary: BinaryExpr): Type {
    var targetType = makeType("Unknown");
    var identPayload = identifierPayload(binary.left);
    if identPayload != null {
        var ident: IdentExpr = identPayload;
        var found = lookupEnv(env, ident.name);
        if bindingTooEarly(ctx, env, ident.name, ident.span.start) { addError(ctx, "undefined variable '" + ident.name + "'", ident.span.start); }
        else if !found.found { addError(ctx, "unknown identifier '" + ident.name + "'", ident.span.start); }
        else {
            targetType = found.symbol.ty;
            if found.symbol.isConst { addError(ctx, "cannot assign to const '" + ident.name + "'", binary.span.start); }
            if found.crossedLambda { addError(ctx, "mutable capture of '" + ident.name + "'", binary.span.start); }
        }
    } else {
        var accessPayload = fieldAccessPayload(binary.left);
        var indexed = indexPayload(binary.left);
        if accessPayload == null && indexed == null { addError(ctx, "assignment target is not an lvalue", binary.span.start); }
        else { targetType = inferExpr(ctx, env, binary.left); }
    }
    var valueType = inferExpr(ctx, env, binary.right);
    if binary.op == "=" {
        expectType(ctx, targetType, valueType, "assignment type mismatch", binary.span.start);
        if isUnknown(valueType) { return targetType; }
        return valueType;
    }
    return targetType;
}

func inferExpr(ctx: TypecheckContext, env: TypeEnv, expr: Expr): Type {
    var ty = inferExprCore(ctx, env, expr);
    recordExprInfo(ctx, expr, ty, null, makeType("Unknown"), -1, -1, -1, -1);
    return ty;
}

func inferExprCore(ctx: TypecheckContext, env: TypeEnv, expr: Expr): Type {
    match expr {
        Expr::Error(_) => {
            addError(ctx, "cannot typecheck an error expression", exprSpan(expr).start);
            return makeType("Unknown");
        },
        Expr::Literal(lit) => {
            if lit.kind == LiteralKind::Int { return makeType("Int"); }
            if lit.kind == LiteralKind::Float { return makeType("Float"); }
            if lit.kind == LiteralKind::Bool { return makeType("Bool"); }
            if lit.kind == LiteralKind::String { return makeType("String"); }
            if lit.kind == LiteralKind::Char { return makeType("Char"); }
            if lit.kind == LiteralKind::Null { return makeType("Null"); }
            addError(ctx, "unsupported literal kind", lit.span.start);
            return makeType("Unknown");
        },
        Expr::Identifier(ident) => { return lookupIdentifier(ctx, env, ident.name, ident.span.start); },
        Expr::Binary(binary) => {
            if isAssignmentOp(binary.op) { return inferAssignExpr(ctx, env, binary); }
            if binary.op == "instanceof" {
                var leftType = inferExpr(ctx, env, binary.left);
                var rightPayload = identifierPayload(binary.right);
                if rightPayload != null {
                    var right: IdentExpr = rightPayload;
                    if !isInstanceofTypeName(ctx, right.name) {
                        addError(ctx, "unknown instanceof type '" + right.name + "'", right.span.start);
                    }
                } else {
                    addError(ctx, "instanceof requires a declared type name", binary.span.start);
                }
                if leftType.kind == "Unknown" { return makeType("Bool"); }
                return makeType("Bool");
            }
            var left = inferExpr(ctx, env, binary.left);
            var rightType = inferExpr(ctx, env, binary.right);
            if binary.op == "&&" || binary.op == "||" {
                expectType(ctx, makeType("Bool"), left, "logical operator requires bool operands", binary.span.start);
                expectType(ctx, makeType("Bool"), rightType, "logical operator requires bool operands", binary.span.start);
                return makeType("Bool");
            }
            if left.kind == "Any" || rightType.kind == "Any" {
                if binary.op == "==" || binary.op == "!=" || binary.op == "<" || binary.op == "<=" || binary.op == ">" || binary.op == ">=" { return makeType("Bool"); }
                if binary.op == "+" || binary.op == "-" || binary.op == "*" || binary.op == "/" || binary.op == "%" { return makeType("Any"); }
            }
            if binary.op == "+" {
                if left.kind == "String" || rightType.kind == "String" {
                    if left.kind == "String" && rightType.kind == "String" { return makeType("String"); }
                    addError(ctx, "'+' not defined for " + arithmeticOperandLabel(left) + " and " + arithmeticOperandLabel(rightType) + "; mixed string + is not allowed; convert explicitly or use interpolation", binary.span.start);
                    return makeType("Unknown");
                }
                if isNumeric(left) && isNumeric(rightType) {
                    if left.kind == "Float" || rightType.kind == "Float" { return makeType("Float"); }
                    return makeType("Int");
                }
                if !isUnknown(left) && !isUnknown(rightType) { addError(ctx, "'+' not defined for " + arithmeticOperandLabel(left) + " and " + arithmeticOperandLabel(rightType), binary.span.start); }
                return makeType("Unknown");
            }
            if binary.op == "-" || binary.op == "*" || binary.op == "/" || binary.op == "%" {
                if !isNumeric(left) || !isNumeric(rightType) {
                    if !isUnknown(left) && !isUnknown(rightType) { addError(ctx, "operator '" + binary.op + "' requires numeric operands", binary.span.start); }
                    return makeType("Unknown");
                }
                if left.kind == "Float" || rightType.kind == "Float" { return makeType("Float"); }
                return makeType("Int");
            }
            if binary.op == "<" || binary.op == "<=" || binary.op == ">" || binary.op == ">=" {
                if left.kind == "Char" && rightType.kind == "Char" { return makeType("Bool"); }
                if isNumeric(left) && isNumeric(rightType) { return makeType("Bool"); }
                if left.kind == "String" && rightType.kind == "String" { return makeType("Bool"); }
                if !isUnknown(left) && !isUnknown(rightType) { addError(ctx, "ordering operator not defined for " + diagnosticTypeName(left) + " and " + diagnosticTypeName(rightType), binary.span.start); }
                return makeType("Bool");
            }
            if binary.op == "==" || binary.op == "!=" {
                if !isUnknown(left) && !isUnknown(rightType) && (left.kind == "Function" || rightType.kind == "Function") {
                    addError(ctx, "function values are not comparable", binary.span.start);
                    return makeType("Bool");
                }
                if !isUnknown(left) && !isUnknown(rightType) && !canAssign(left, rightType) && !canAssign(rightType, left) {
                    addError(ctx, "equality operands have incompatible types " + typeName(left) + " and " + typeName(rightType), binary.span.start);
                }
                return makeType("Bool");
            }
            addError(ctx, "unsupported binary operator '" + binary.op + "'", binary.span.start);
            return makeType("Unknown");
        },
        Expr::Unary(unary) => {
            var operand = inferExpr(ctx, env, unary.right);
            if unary.op == "!" {
                expectType(ctx, makeType("Bool"), operand, "'!' requires bool", unary.span.start);
                return makeType("Bool");
            }
            if unary.op == "-" {
                if isNumeric(operand) { return operand; }
                if !isUnknown(operand) { addError(ctx, "unary '-' requires a number", unary.span.start); }
                return makeType("Unknown");
            }
            addError(ctx, "unsupported unary operator '" + unary.op + "'", unary.span.start);
            return makeType("Unknown");
        },
        Expr::Update(update) => {
            var target = inferUpdateTarget(ctx, env, update.target, update.span.start);
            expectType(ctx, makeType("Int"), target, "increment/decrement requires int", update.span.start);
            return makeType("Int");
        },
        Expr::Call(call) => { return inferCall(ctx, env, call, expr); },
        Expr::EnumVariant(variant) => { return inferEnumVariant(ctx, env, variant, expr); },
        Expr::Index(index) => { return inferIndex(ctx, env, index); },
        Expr::FieldAccess(access) => { return inferFieldAccess(ctx, env, access, expr); },
        Expr::Lambda(lambda) => { return inferLambda(ctx, env, lambda, expr); },
        Expr::Match(_) => {
            addError(ctx, "match expressions are unsupported; match is a statement", exprSpan(expr).start);
            return makeType("Unknown");
        },
        Expr::If(ifExpr) => {
            expectType(ctx, makeType("Bool"), inferExpr(ctx, env, ifExpr.condition), "if condition must be bool", ifExpr.span.start);
            var thenType = inferExpr(ctx, newEnv(env, false), ifExpr.thenBranch);
            var elseType = inferExpr(ctx, newEnv(env, false), ifExpr.elseBranch);
            return joinTypes(thenType, elseType);
        },
        Expr::Tuple(tupleExpr) => {
            var tuple = makeType("Tuple");
            var i = 0;
            loop { if i >= tupleExpr.elements.len() { break; } tuple.params.push(inferExpr(ctx, env, tupleExpr.elements[i])); i = i + 1; }
            return tuple;
        },
        Expr::Array(arrayExpr) => { return inferArray(ctx, env, arrayExpr); },
        Expr::Dict(dictExpr) => { return inferDict(ctx, env, dictExpr); },
        Expr::StructLiteral(structLiteral) => { return inferStructLiteral(ctx, env, structLiteral, expr); },
    }
    return makeType("Unknown");
}

func joinReturnTypes(types: Vec<Type>): Type {
    if types.len() == 0 { return makeType("Void"); }
    var result = makeType("Unknown");
    var sawUnknown = false;
    var i = 0;
    loop {
        if i >= types.len() { break; }
        if isUnknown(types[i]) { sawUnknown = true; }
        else if isUnknown(result) { result = types[i]; }
        else { result = joinTypes(result, types[i]); }
        i = i + 1;
    }
    if isUnknown(result) && sawUnknown { return makeType("Unknown"); }
    return result;
}

func isInstanceofTypeName(ctx: TypecheckContext, name: string): bool {
    if name == "int" || name == "float" || name == "string" || name == "bool" || name == "char" || name == "any" { return true; }
    if name == "Vec" || name == "HashMap" || name == "Option" || name == "Result" { return true; }
    return ctx.structs.has(name);
}

func instanceofTestType(ctx: TypecheckContext, name: string): Type {
    if name == "int" { return makeType("Int"); }
    if name == "float" { return makeType("Float"); }
    if name == "string" { return makeType("String"); }
    if name == "bool" { return makeType("Bool"); }
    if name == "char" { return makeType("Char"); }
    if name == "any" { return makeType("Any"); }
    if name == "Vec" { return arrayType(makeType("Any")); }
    if name == "HashMap" { return dictType(makeType("Any")); }
    if name == "Option" { return optionType(makeType("Any")); }
    if name == "Result" { return resultType(makeType("Any"), makeType("Any")); }
    if ctx.structs.has(name) { return resolveNamedType(ctx, name, 0, false); }
    return makeType("Unknown");
}

func typeMatchesInstanceof(member: Type, tested: Type): bool {
    if typeEqual(member, tested) { return true; }
    if member.kind == "Struct" && tested.kind == "Struct" && member.name == tested.name { return true; }
    if member.kind == tested.kind && member.kind != "Struct" && member.kind != "Enum" && member.kind != "Union" && member.kind != "Array" && member.kind != "Dict" && member.kind != "Option" && member.kind != "Result" { return true; }
    return false;
}

func typeWithoutInstanceof(current: Type, tested: Type): Type {
    if current.kind == "Union" {
        var rest: Vec<Type> = [];
        var i = 0;
        loop {
            if i >= current.params.len() { break; }
            if !typeMatchesInstanceof(current.params[i], tested) { rest.push(current.params[i]); }
            i = i + 1;
        }
        if rest.len() == current.params.len() { return current; }
        if rest.len() == 0 { return makeType("Unknown"); }
        if rest.len() == 1 { return rest[0]; }
        var remaining = makeType("Union");
        remaining.params = rest;
        return remaining;
    }
    if typeMatchesInstanceof(current, tested) { return makeType("Unknown"); }
    return current;
}

func checkBooleanCondition(ctx: TypecheckContext, env: TypeEnv, expr: Expr, label: string) {
    var actual = inferExpr(ctx, env, expr);
    expectType(ctx, makeType("Bool"), actual, label + " must be bool", exprSpan(expr).start);
}

func narrowedBinding(ctx: TypecheckContext, env: TypeEnv, condition: Expr, truthy: bool): LookupResult {
    var binaryPayloadValue = binaryPayload(condition);
    if binaryPayloadValue != null {
        var binary: BinaryExpr = binaryPayloadValue;
        var leftIdentifier = identifierPayload(binary.left);
        var rightIdentifier = identifierPayload(binary.right);
        var leftLiteral = literalPayload(binary.left);
        var rightLiteral = literalPayload(binary.right);
        var comparedIdentifier: IdentExpr? = null;
        var comparedLiteral: LiteralExpr? = null;
        if ((binary.op == "!=" || binary.op == "==") && leftIdentifier != null && rightLiteral != null) {
            comparedIdentifier = leftIdentifier;
            comparedLiteral = rightLiteral;
        } else if ((binary.op == "!=" || binary.op == "==") && rightIdentifier != null && leftLiteral != null) {
            comparedIdentifier = rightIdentifier;
            comparedLiteral = leftLiteral;
        }
        if comparedIdentifier != null {
            if comparedLiteral != null {
                var ident: IdentExpr = comparedIdentifier;
                var lit: LiteralExpr = comparedLiteral;
                if lit.kind == LiteralKind::Null {
                    var found = lookupEnv(env, ident.name);
                    if found.found && found.symbol.ty.kind == "Nullable" {
                        var maybeInner = found.symbol.ty.inner;
                        if maybeInner != null {
                            var innerType: Type = maybeInner;
                            var isNonNull = truthy;
                            if binary.op == "==" { isNonNull = !truthy; }
                            var narrowedTy = innerType;
                            if !isNonNull { narrowedTy = makeType("Null"); }
                            var narrowedSymbol = Symbol { name: found.symbol.name, ty: narrowedTy, isConst: found.symbol.isConst };
                            return LookupResult { found: true, symbol: narrowedSymbol, crossedLambda: false };
                        }
                    }
                }
            }
        }
        if binary.op == "instanceof" {
            if leftIdentifier != null {
                if rightIdentifier != null {
                    var leftIdent: IdentExpr = leftIdentifier;
                    var rightIdent: IdentExpr = rightIdentifier;
                    var tested = instanceofTestType(ctx, rightIdent.name);
                    if !isUnknown(tested) {
                        var foundBinding = lookupEnv(env, leftIdent.name);
                        if foundBinding.found {
                            var narrowedTy = tested;
                            if !truthy { narrowedTy = typeWithoutInstanceof(foundBinding.symbol.ty, tested); }
                            var narrowedSymbol = Symbol { name: foundBinding.symbol.name, ty: narrowedTy, isConst: foundBinding.symbol.isConst };
                            return LookupResult { found: true, symbol: narrowedSymbol, crossedLambda: foundBinding.crossedLambda };
                        }
                    }
                }
            }
        }
    }
    return LookupResult { found: false, symbol: Symbol { name: "", ty: makeType("Unknown"), isConst: false }, crossedLambda: false };
}

func checkBlock(ctx: TypecheckContext, parent: TypeEnv, block: BlockStmt) {
    var child = newEnv(parent, false);
    checkStatements(ctx, child, block.statements);
}

func checkBody(ctx: TypecheckContext, parent: TypeEnv, body: Vec<Stmt>) {
    checkStatements(ctx, newEnv(parent, false), body);
}

func checkAssign(ctx: TypecheckContext, env: TypeEnv, stmt: AssignStmt) {
    var targetType = makeType("Unknown");
    var identPayload = identifierPayload(stmt.target);
    if identPayload != null {
        var ident: IdentExpr = identPayload;
        var found = lookupEnv(env, ident.name);
        if bindingTooEarly(ctx, env, ident.name, ident.span.start) { addError(ctx, "undefined variable '" + ident.name + "'", ident.span.start); }
        else if !found.found { addError(ctx, "unknown identifier '" + ident.name + "'", ident.span.start); }
        else {
            targetType = found.symbol.ty;
            if found.symbol.isConst { addError(ctx, "cannot assign to const '" + ident.name + "'", stmt.span.start); }
            if found.crossedLambda { addError(ctx, "mutable capture of '" + ident.name + "'", stmt.span.start); }
        }
    } else {
        var accessPayload = fieldAccessPayload(stmt.target);
        if accessPayload != null {
            var access: FieldAccessExpr = accessPayload;
            targetType = inferFieldAccess(ctx, env, access, stmt.target);
        } else {
            var indexPayloadValue = indexPayload(stmt.target);
            if indexPayloadValue != null {
                var indexExpr: IndexExpr = indexPayloadValue;
                var receiver = inferExpr(ctx, env, indexExpr.target);
                var index = inferExpr(ctx, env, indexExpr.index);
                if receiver.kind == "Array" {
                    expectType(ctx, makeType("Int"), index, "Vec index must be int", stmt.span.start);
                    var inner = receiver.inner;
                    if inner != null {
                        var elementType: Type = inner;
                        targetType = elementType;
                    } else { targetType = makeType("Any"); }
                } else if receiver.kind == "Dict" {
                    expectType(ctx, makeType("String"), index, "HashMap key must be string", stmt.span.start);
                    var value = receiver.value;
                    if value != null {
                        var valueType: Type = value;
                        targetType = valueType;
                    } else { targetType = makeType("Any"); }
                } else if receiver.kind == "String" { addError(ctx, "string indices are not assignable", stmt.span.start); }
                else if !isUnknown(receiver) { addError(ctx, "indexed value is not mutable", stmt.span.start); }
            } else { addError(ctx, "assignment target is not an lvalue", stmt.span.start); }
        }
    }
    var valueType = inferExpr(ctx, env, stmt.value);
    if stmt.op == "=" { expectType(ctx, targetType, valueType, "assignment type mismatch", stmt.span.start); }
    else {
        var op = stmt.op.slice(0, stmt.op.len() - 1);
        if op == "+" && (targetType.kind == "String" || valueType.kind == "String") {
            if targetType.kind != "String" || valueType.kind != "String" { addError(ctx, "'+' not defined for " + arithmeticOperandLabel(targetType) + " and " + arithmeticOperandLabel(valueType) + "; mixed string + is not allowed; convert explicitly or use interpolation", stmt.span.start); }
        } else if !isNumeric(targetType) || !isNumeric(valueType) { addError(ctx, "compound assignment requires compatible numeric operands", stmt.span.start); }
        else { expectType(ctx, targetType, valueType, "compound assignment type mismatch", stmt.span.start); }
    }
}

func enumVariantIndex(ctx: TypecheckContext, enumName: string, variantName: string): int {
    if !ctx.enums.has(enumName) { return -1; }
    var decl: EnumDeclStmt = ctx.enums.get(enumName);
    var variantPos = 0;
    loop {
        if variantPos >= decl.variantDecls.len() { break; }
        if decl.variantDecls[variantPos].name == variantName { return variantPos; }
        variantPos = variantPos + 1;
    }
    return -1;
}

func findVariantDecl(ctx: TypecheckContext, enumName: string, variantName: string): EnumVariantDecl? {
    if !ctx.enums.has(enumName) { return null; }
    var decl: EnumDeclStmt = ctx.enums.get(enumName);
    var i = 0;
    loop {
        if i >= decl.variantDecls.len() { break; }
        if decl.variantDecls[i].name == variantName { return decl.variantDecls[i]; }
        i = i + 1;
    }
    return null;
}

func enumHasSingleVariant(ctx: TypecheckContext, expected: Type, enumName: string): bool {
    if !ctx.enums.has(enumName) { return false; }
    if expected.moduleId != "" && ctx.enumOwners.has(enumName) && ctx.enumOwners.get(enumName) != expected.moduleId { return false; }
    if expected.sourcePath != "" && ctx.enumSources.has(enumName) && ctx.enumSources.get(enumName) != expected.sourcePath { return false; }
    var decl: EnumDeclStmt = ctx.enums.get(enumName);
    return decl.variantDecls.len() == 1;
}

func structPatternMatchesType(ctx: TypecheckContext, expected: Type, structName: string): bool {
    if expected.kind != "Struct" || expected.name != structName { return false; }
    if expected.moduleId != "" && ctx.structOwners.has(structName) && ctx.structOwners.get(structName) != expected.moduleId { return false; }
    if expected.sourcePath != "" && ctx.structSources.has(structName) && ctx.structSources.get(structName) != expected.sourcePath { return false; }
    return true;
}

func enumTypeName(ty: Type): string {
    if ty.kind == "Enum" { return ty.name; }
    if ty.kind == "Nullable" {
        var inner = ty.inner;
        if inner != null {
            var innerType: Type = inner;
            if innerType.kind == "Enum" { return innerType.name; }
        }
    }
    return "";
}

func checkPattern(ctx: TypecheckContext, env: TypeEnv, pattern: Pattern, expected: Type): PatternResult {
    match pattern {
        Pattern::Error(_) => {
            addError(ctx, "cannot typecheck an error pattern", patternSpan(pattern).start);
            return PatternResult { coversAll: false, variant: "", coversVariant: false };
        },
        Pattern::Wildcard(_) => { return PatternResult { coversAll: true, variant: "", coversVariant: false }; },
        Pattern::Literal(literalPattern) => {
            var actual = makeType("Unknown");
            if literalPattern.literal.kind == LiteralKind::Int { actual = makeType("Int"); }
            else if literalPattern.literal.kind == LiteralKind::Float { actual = makeType("Float"); }
            else if literalPattern.literal.kind == LiteralKind::Bool { actual = makeType("Bool"); }
            else if literalPattern.literal.kind == LiteralKind::String { actual = makeType("String"); }
            else if literalPattern.literal.kind == LiteralKind::Char { actual = makeType("Char"); }
            else if literalPattern.literal.kind == LiteralKind::Null { actual = makeType("Null"); }
            expectType(ctx, expected, actual, "pattern type mismatch", patternSpan(pattern).start);
            return PatternResult { coversAll: false, variant: "", coversVariant: false };
        },
        Pattern::Variable(variable) => {
            var knownEnum = enumTypeName(expected);
            if knownEnum != "" {
                var bareVariant = findVariantDecl(ctx, knownEnum, variable.name);
                if bareVariant != null {
                    return PatternResult { coversAll: expected.kind == "Enum" && enumHasSingleVariant(ctx, expected, knownEnum), variant: variable.name, coversVariant: true };
                }
            }
            defineSymbol(ctx, env, variable.name, expected, true, variable.span.start);
            return PatternResult { coversAll: true, variant: "", coversVariant: false };
        },
        Pattern::EnumVariant(enumPattern) => {
            var enumName = enumPattern.enumName;
            var expectedEnum = enumTypeName(expected);
            if enumName == "" && expectedEnum != "" { enumName = expectedEnum; }
            if expectedEnum == "" || enumName != expectedEnum {
                addError(ctx, "enum pattern does not match scrutinee type " + typeName(expected), patternSpan(pattern).start);
                return PatternResult { coversAll: false, variant: "", coversVariant: false };
            }
            var variant = findVariantDecl(ctx, enumName, enumPattern.variant);
            if variant != null {
                var variantDecl: EnumVariantDecl = variant;
                var payloadCountMatches = enumPattern.payloads.len() == 0 || enumPattern.payloads.len() == variantDecl.payloadTypes.len();
                if !payloadCountMatches {
                    addError(ctx, "enum pattern payload count mismatch", patternSpan(pattern).start);
                }
                var coversVariant = payloadCountMatches;
                var payloadVariantIndex = enumVariantIndex(ctx, enumName, enumPattern.variant);
                var i = 0;
                loop {
                    if i >= enumPattern.payloads.len() || i >= variantDecl.payloadTypes.len() { break; }
                    var payloadType = resolveDeclaredPayloadType(ctx, enumName, payloadVariantIndex, i, variantDecl.payloadTypes[i]);
                    var payloadResult = checkPattern(ctx, env, enumPattern.payloads[i], payloadType);
                    if !payloadResult.coversAll { coversVariant = false; }
                    i = i + 1;
                }
                return PatternResult {
                    coversAll: expected.kind == "Enum" && coversVariant && enumHasSingleVariant(ctx, expected, enumName),
                    variant: enumPattern.variant,
                    coversVariant: coversVariant,
                };
            }
            addError(ctx, "unknown enum variant '" + enumName + "::" + enumPattern.variant + "'", patternSpan(pattern).start);
            return PatternResult { coversAll: false, variant: "", coversVariant: false };
        },
        Pattern::Struct(structPattern) => {
            var coversAllFields = structPatternMatchesType(ctx, expected, structPattern.structName);
            if !coversAllFields { addError(ctx, "struct pattern does not match scrutinee type " + typeName(expected), patternSpan(pattern).start); }
            var i2 = 0;
            loop {
                if i2 >= structPattern.fields.len() { break; }
                var field = findStructField(ctx, structPattern.structName, structPattern.fields[i2].name);
                if !field.found {
                    addError(ctx, "unknown field '" + structPattern.fields[i2].name + "' in struct pattern", structPattern.fields[i2].span.start);
                    coversAllFields = false;
                } else if !field.isPub && !canAccessPrivateField(ctx, structPattern.structName, field.moduleId) {
                    addError(ctx, "cannot access private field '" + structPattern.fields[i2].name + "' on " + structPattern.structName, structPattern.fields[i2].span.start);
                    coversAllFields = false;
                } else {
                    var fieldResult = checkPattern(ctx, env, structPattern.fields[i2].pattern, field.ty);
                    if !fieldResult.coversAll { coversAllFields = false; }
                }
                i2 = i2 + 1;
            }
            return PatternResult { coversAll: coversAllFields, variant: "", coversVariant: false };
        },
        Pattern::Or(_) => {
            addError(ctx, "or-pattern checking is not implemented", patternSpan(pattern).start);
            return PatternResult { coversAll: false, variant: "", coversVariant: false };
        },
        Pattern::Range(rangePattern) => {
            if expected.kind != "Int" { addError(ctx, "range pattern requires an int scrutinee", patternSpan(pattern).start); }
            var first = integerLiteralValue(rangePattern.start.text);
            var last = integerLiteralValue(rangePattern.end.text);
            if first > last { addError(ctx, "range pattern start exceeds end", patternSpan(pattern).start); }
            return PatternResult { coversAll: false, variant: "", coversVariant: false };
        },
    }
}

func checkBinding(ctx: TypecheckContext, env: TypeEnv, declaration: Stmt, name: string, tag: string, typeExpr: TypeExpr?, value: Expr, isConst: bool, span: int) {
    var actual = inferExpr(ctx, env, value);
    var declared = actual;
    if typeExpr != null || tag != "" {
        declared = resolveTypeTag(ctx, typeExpr, tag, span, false);
        expectType(ctx, declared, actual, "initializer type mismatch for '" + name + "'", span);
    }
    defineSymbol(ctx, env, name, declared, isConst, span);
    recordBinding(ctx, declaration, stmtNodeKey(declaration), name, declared, "Local", isConst, -1);
}

func inferGlobalBinding(ctx: TypecheckContext, name: string, tag: string, typeExpr: TypeExpr?, value: Expr, isConst: bool, span: int) {
    var actual = inferExpr(ctx, ctx.globals, value);
    var ty = actual;
    if typeExpr != null || tag != "" { ty = resolveTypeTag(ctx, typeExpr, tag, span, false); }
    if !isUnknown(ty) { ctx.globals.symbols.set(name, Symbol { name: name, ty: ty, isConst: isConst }); }
}

func checkGlobalBinding(ctx: TypecheckContext, declaration: Stmt, name: string, tag: string, typeExpr: TypeExpr?, value: Expr, isConst: bool, span: int) {
    var actual = inferExpr(ctx, ctx.globals, value);
    var ty = actual;
    if typeExpr != null || tag != "" {
        ty = resolveTypeTag(ctx, typeExpr, tag, span, false);
        expectType(ctx, ty, actual, "initializer type mismatch for '" + name + "'", span);
    }
    if isUnknown(ty) { addError(ctx, "cannot infer type of '" + name + "'", span); }
    ctx.globals.symbols.set(name, Symbol { name: name, ty: ty, isConst: isConst });
    recordBinding(ctx, declaration, stmtNodeKey(declaration), name, ty, "Global", isConst, -1);
}

func checkMatch(ctx: TypecheckContext, env: TypeEnv, stmt: MatchStmt) {
    var scrutinee = inferExpr(ctx, env, stmt.scrutinee);
    var covered = [];
    var sawTrue = false;
    var sawFalse = false;
    var sawNull = false;
    var wildcard = false;
    var i = 0;
    loop {
        if i >= stmt.arms.len() { break; }
        var arm = stmt.arms[i];
        var armEnv = newEnv(env, false);
        var patResult = checkPattern(ctx, armEnv, arm.pattern, scrutinee);
        if patResult.coversAll { wildcard = true; }
        if patResult.variant != "" && patResult.coversVariant {
            var duplicate = false;
            var j = 0;
            loop { if j >= covered.len() { break; } if covered[j] == patResult.variant { duplicate = true; } j = j + 1; }
            if duplicate { addError(ctx, "duplicate enum match arm for '" + patResult.variant + "'", arm.span.start); }
            else { covered.push(patResult.variant); }
        }
        var litPatPayload = literalPatternPayload(arm.pattern);
        if litPatPayload != null {
            var litPat: LiteralPattern = litPatPayload;
            if litPat.literal.kind == LiteralKind::Bool && litPat.literal.text == "true" { sawTrue = true; }
            if litPat.literal.kind == LiteralKind::Bool && litPat.literal.text == "false" { sawFalse = true; }
            if litPat.literal.kind == LiteralKind::Null { sawNull = true; }
        }
        checkStmt(ctx, armEnv, arm.body);
        i = i + 1;
    }
    if wildcard { return; }
    if scrutinee.kind == "Enum" && ctx.enums.has(scrutinee.name) {
        var decl: EnumDeclStmt = ctx.enums.get(scrutinee.name);
        var v = 0;
        loop {
            if v >= decl.variantDecls.len() { break; }
            var seen = false;
            var j2 = 0;
            loop { if j2 >= covered.len() { break; } if covered[j2] == decl.variantDecls[v].name { seen = true; } j2 = j2 + 1; }
            if !seen { addError(ctx, "non-exhaustive match; missing " + scrutinee.name + "::" + decl.variantDecls[v].name + "; non-exhaustive match for enum", stmt.span.start); }
            v = v + 1;
        }
    } else if scrutinee.kind == "Bool" {
        if !sawTrue { addError(ctx, "non-exhaustive bool match; missing true; non-exhaustive match for bool", stmt.span.start); }
        if !sawFalse { addError(ctx, "non-exhaustive bool match; missing false; non-exhaustive match for bool", stmt.span.start); }
    } else if scrutinee.kind == "Nullable" {
        if !sawNull { addError(ctx, "non-exhaustive nullable match; missing null", stmt.span.start); }
        var nullableHandled = false;
        var nullableInner = scrutinee.inner;
        if nullableInner != null {
            var innerType: Type = nullableInner;
            if innerType.kind == "Bool" {
                nullableHandled = true;
                if !sawTrue { addError(ctx, "non-exhaustive nullable bool match; missing true", stmt.span.start); }
                if !sawFalse { addError(ctx, "non-exhaustive nullable bool match; missing false", stmt.span.start); }
            } else if innerType.kind == "Enum" && ctx.enums.has(innerType.name) {
                nullableHandled = true;
                var innerEnum: EnumDeclStmt = ctx.enums.get(innerType.name);
                var nullableVariant = 0;
                loop {
                    if nullableVariant >= innerEnum.variantDecls.len() { break; }
                    var foundVariant = false;
                    var coveredIndex = 0;
                    loop { if coveredIndex >= covered.len() { break; } if covered[coveredIndex] == innerEnum.variantDecls[nullableVariant].name { foundVariant = true; } coveredIndex = coveredIndex + 1; }
                    if !foundVariant { addError(ctx, "non-exhaustive nullable match; missing " + innerEnum.name + "::" + innerEnum.variantDecls[nullableVariant].name, stmt.span.start); }
                    nullableVariant = nullableVariant + 1;
                }
            }
        }
        if !nullableHandled {
            addError(ctx, "non-exhaustive nullable match; add a binding or wildcard for non-null values", stmt.span.start);
        }
    } else if !isUnknown(scrutinee) {
        addError(ctx, "match over " + typeName(scrutinee) + " requires a wildcard or binding arm", stmt.span.start);
    }
}

func checkStmt(ctx: TypecheckContext, env: TypeEnv, stmt: Stmt) {
    match stmt {
        Stmt::VarDecl(varDecl) => {
            checkBinding(ctx, env, stmt, varDecl.name, varDecl.typeTag, varDecl.typeExpr, varDecl.value, false, varDecl.span.start);
        },
        Stmt::ConstDecl(constDecl) => {
            checkBinding(ctx, env, stmt, constDecl.name, constDecl.typeTag, constDecl.typeExpr, constDecl.value, true, constDecl.span.start);
        },
        Stmt::FuncDecl(decl) => { addError(ctx, "nested function declarations are unsupported", decl.span.start); },
        Stmt::StructDecl(decl) => { addError(ctx, "local type declarations are unsupported", decl.span.start); },
        Stmt::EnumDecl(decl) => { addError(ctx, "local type declarations are unsupported", decl.span.start); },
        Stmt::Import(decl) => { addError(ctx, "imports are only valid at module scope", decl.span.start); },
        Stmt::If(ifStmt) => {
            checkBooleanCondition(ctx, env, ifStmt.condition, "if condition");
            var thenEnv = newEnv(env, false);
            var trueNarrow = narrowedBinding(ctx, env, ifStmt.condition, true);
            if trueNarrow.found { thenEnv.symbols.set(trueNarrow.symbol.name, trueNarrow.symbol); }
            checkBlock(ctx, thenEnv, ifStmt.thenBranch);
            var elseBranch = ifStmt.elseBranch;
            if elseBranch != null {
                var elseEnv = newEnv(env, false);
                var falseNarrow = narrowedBinding(ctx, env, ifStmt.condition, false);
                if falseNarrow.found { elseEnv.symbols.set(falseNarrow.symbol.name, falseNarrow.symbol); }
                var elseBlock: BlockStmt = elseBranch;
                checkBlock(ctx, elseEnv, elseBlock);
            }
        },
        Stmt::Assign(assignStmt) => { checkAssign(ctx, env, assignStmt); },
        Stmt::Return(retStmt) => {
            if !ctx.inFunction { addError(ctx, "return is only valid inside a function", retStmt.span.start); return; }
            var retType = makeType("Void");
            var hasValue = returnedExpressionHasValue(retStmt);
            if hasValue { retType = inferExpr(ctx, env, retStmt.value); }
            ctx.returnTypes.push(retType);
            if !isUnknown(ctx.currentReturn) && !isUnknown(retType) && !canAssign(ctx.currentReturn, retType) {
                addError(ctx, "return type mismatch: expected " + typeName(ctx.currentReturn) + ", got " + typeName(retType) + "; return expected " + diagnosticTypeName(ctx.currentReturn) + " but got " + diagnosticTypeName(retType), retStmt.span.start);
            }
        },
        Stmt::Break(_) => {
            if ctx.loopDepth == 0 { addError(ctx, "break/continue is only valid inside a loop", stmtSpan(stmt).start); }
        },
        Stmt::Continue(_) => {
            if ctx.loopDepth == 0 { addError(ctx, "break/continue is only valid inside a loop", stmtSpan(stmt).start); }
        },
        Stmt::While(whileStmt) => {
            checkBooleanCondition(ctx, env, whileStmt.condition, "while condition");
            ctx.loopDepth = ctx.loopDepth + 1;
            checkBody(ctx, env, whileStmt.body);
            ctx.loopDepth = ctx.loopDepth - 1;
        },
        Stmt::For(forStmt) => {
            var iterable = inferExpr(ctx, env, forStmt.iterable);
            var itemType = makeType("Unknown");
            if iterable.kind == "Array" {
                var maybeItemType = iterable.inner;
                if maybeItemType != null {
                    var resolvedItemType: Type = maybeItemType;
                    itemType = resolvedItemType;
                } else { itemType = makeType("Any"); }
            } else if iterable.kind == "Any" { itemType = makeType("Any"); }
            else if !isUnknown(iterable) { addError(ctx, "for-in requires a Vec or range, got " + typeName(iterable), forStmt.span.start); }
            var loopEnv = newEnv(env, false);
            defineSymbol(ctx, loopEnv, forStmt.variable, itemType, true, forStmt.span.start);
            recordBinding(ctx, stmt, stmtNodeKey(stmt), forStmt.variable, itemType, "LoopVariable", true, -1);
            ctx.loopDepth = ctx.loopDepth + 1;
            checkBody(ctx, loopEnv, forStmt.body);
            ctx.loopDepth = ctx.loopDepth - 1;
        },
        Stmt::Loop(loopStmt) => {
            ctx.loopDepth = ctx.loopDepth + 1;
            checkBody(ctx, env, loopStmt.body);
            ctx.loopDepth = ctx.loopDepth - 1;
        },
        Stmt::Block(block) => { checkBlock(ctx, env, block); },
        Stmt::ExprStmt(exprStmt) => { inferExpr(ctx, env, exprStmt.expr); },
        Stmt::Match(matchStmt) => { checkMatch(ctx, env, matchStmt); },
    }
}

func checkStatements(ctx: TypecheckContext, env: TypeEnv, statements: Vec<Stmt>) {
    var i = 0;
    loop {
        if i >= statements.len() { break; }
        checkStmt(ctx, env, statements[i]);
        i = i + 1;
    }
}

func inferGlobalTypes(ctx: TypecheckContext, program: Program) {
    var oldSuppress = ctx.suppressErrors;
    ctx.suppressErrors = true;
    var pass = 0;
    loop {
        if pass > program.statements.len() { break; }
        var i = 0;
        loop {
            if i >= program.statements.len() { break; }
            var stmt = program.statements[i];
            match stmt {
                Stmt::VarDecl(decl) => { inferGlobalBinding(ctx, decl.name, decl.typeTag, decl.typeExpr, decl.value, false, decl.span.start); },
                Stmt::ConstDecl(decl) => { inferGlobalBinding(ctx, decl.name, decl.typeTag, decl.typeExpr, decl.value, true, decl.span.start); },
                _ => {},
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    ctx.suppressErrors = oldSuppress;
}

func inferFunctionReturn(ctx: TypecheckContext, decl: FuncDeclStmt, owner: string): Type {
    var key = decl.name;
    if owner != "" { key = owner + "." + decl.name; }
    if !ctx.functions.has(key) { return makeType("Unknown"); }
    var sig: FunctionSig = ctx.functions.get(key);
    if !sig.inferReturn { return sig.ret; }
    var oldSuppress = ctx.suppressErrors;
    var oldInFunction = ctx.inFunction;
    var oldReturn = ctx.currentReturn;
    var oldReturns = ctx.returnTypes;
    var oldLoop = ctx.loopDepth;
    var oldStruct = ctx.currentStruct;
    ctx.suppressErrors = true;
    ctx.inFunction = true;
    ctx.currentStruct = owner;
    ctx.currentReturn = makeType("Unknown");
    ctx.returnTypes = [];
    ctx.loopDepth = 0;
    var env = newEnv(ctx.globals, false);
    var i = 0;
    loop {
        if i >= decl.params.len() { break; }
        defineSymbol(ctx, env, decl.params[i].name, sig.params[i], false, decl.span.start);
        i = i + 1;
    }
    if owner != "" {
        var structDecl: StructDeclStmt = ctx.structs.get(owner);
        var f = 0;
        loop {
            if f >= structDecl.fields.len() { break; }
            var field = structDecl.fields[f];
            defineSymbol(ctx, env, field.name, resolveTypeTag(ctx, field.typeExpr, field.typeTag, decl.span.start, false), false, decl.span.start);
            f = f + 1;
        }
        defineSymbol(ctx, env, "self", resolveNamedType(ctx, owner, decl.span.start, false), false, decl.span.start);
    }
    checkBody(ctx, env, decl.body);
    var result = joinReturnTypes(ctx.returnTypes);
    ctx.suppressErrors = oldSuppress;
    ctx.inFunction = oldInFunction;
    ctx.currentReturn = oldReturn;
    ctx.returnTypes = oldReturns;
    ctx.loopDepth = oldLoop;
    ctx.currentStruct = oldStruct;
    return result;
}

func inferFunctionReturns(ctx: TypecheckContext, program: Program) {
    var rounds = 0;
    loop {
        if rounds > program.statements.len() + 1 { break; }
        var changed = false;
        var i = 0;
        loop {
            if i >= program.statements.len() { break; }
            var stmt = program.statements[i];
            match stmt {
            Stmt::FuncDecl(decl) => {
                var sig: FunctionSig = ctx.functions.get(decl.name);
                if sig.inferReturn {
                    var inferred = inferFunctionReturn(ctx, decl, "");
                    if !isUnknown(inferred) && !typeEqual(sig.ret, inferred) { sig.ret = inferred; ctx.functions.set(decl.name, sig); changed = true; }
                }
            },
            Stmt::StructDecl(structDecl) => {
                var m = 0;
                loop {
                    if m >= structDecl.methods.len() { break; }
                    var method = structDecl.methods[m];
                    var key = structDecl.name + "." + method.name;
                    var sigM: FunctionSig = ctx.functions.get(key);
                    if sigM.inferReturn {
                        var inferredM = inferFunctionReturn(ctx, method, structDecl.name);
                        if !isUnknown(inferredM) && !typeEqual(sigM.ret, inferredM) { sigM.ret = inferredM; ctx.functions.set(key, sigM); changed = true; }
                    }
                    m = m + 1;
                }
            },
            _ => {},
            }
            i = i + 1;
        }
        rounds = rounds + 1;
        if !changed { break; }
    }
}

func blockDefinitelyReturns(block: BlockStmt): bool {
    var i = 0;
    loop {
        if i >= block.statements.len() { break; }
        if statementDefinitelyReturns(block.statements[i]) { return true; }
        i = i + 1;
    }
    return false;
}

func statementDefinitelyReturns(stmt: Stmt): bool {
    match stmt {
        Stmt::VarDecl(_) => { return false; },
        Stmt::ConstDecl(_) => { return false; },
        Stmt::FuncDecl(_) => { return false; },
        Stmt::StructDecl(_) => { return false; },
        Stmt::EnumDecl(_) => { return false; },
        Stmt::Import(_) => { return false; },
        Stmt::If(ifStmt) => {
            var elseBranch = ifStmt.elseBranch;
            if elseBranch != null {
                var elseBlock: BlockStmt = elseBranch;
                return blockDefinitelyReturns(ifStmt.thenBranch) && blockDefinitelyReturns(elseBlock);
            }
            return false;
        },
        Stmt::Assign(_) => { return false; },
        Stmt::Return(_) => { return true; },
        Stmt::Break(_) => { return false; },
        Stmt::Continue(_) => { return false; },
        Stmt::While(_) => { return false; },
        Stmt::For(_) => { return false; },
        Stmt::Loop(_) => { return false; },
        Stmt::Block(block) => { return blockDefinitelyReturns(block); },
        Stmt::ExprStmt(_) => { return false; },
        Stmt::Match(matchStmt) => {
            if matchStmt.arms.len() == 0 { return false; }
            var i = 0;
            loop {
                if i >= matchStmt.arms.len() { break; }
                if !statementDefinitelyReturns(matchStmt.arms[i].body) { return false; }
                i = i + 1;
            }
            return true;
        },
    }
    return false;
}

func bodyDefinitelyReturns(body: Vec<Stmt>): bool {
    return statementsDefinitelyReturn(body);
}

func statementsDefinitelyReturn(statements: Vec<Stmt>): bool {
    var i = 0;
    loop {
        if i >= statements.len() { break; }
        if statementDefinitelyReturns(statements[i]) { return true; }
        i = i + 1;
    }
    return false;
}

func checkFunction(ctx: TypecheckContext, decl: FuncDeclStmt, owner: string, declaration, declarationKey: string) {
    var key = decl.name;
    if owner != "" { key = owner + "." + decl.name; }
    if !ctx.functions.has(key) { return; }
    var sig: FunctionSig = ctx.functions.get(key);
    if sig.inferReturn && isUnknown(sig.ret) { addError(ctx, "cannot infer return type of function '" + key + "'", decl.span.start); }
    var oldInFunction = ctx.inFunction;
    var oldReturn = ctx.currentReturn;
    var oldReturns = ctx.returnTypes;
    var oldLoop = ctx.loopDepth;
    var oldStruct = ctx.currentStruct;
    ctx.inFunction = true;
    ctx.currentStruct = owner;
    ctx.currentReturn = sig.ret;
    ctx.returnTypes = [];
    ctx.loopDepth = 0;
    var env = newEnv(ctx.globals, false);
    var i = 0;
    loop {
        if i >= decl.params.len() { break; }
        var param = decl.params[i];
        defineSymbol(ctx, env, param.name, sig.params[i], false, decl.span.start);
        recordBinding(ctx, declaration, declarationKey, param.name, sig.params[i], "Parameter", false, i);
        if param.hasDefault {
            var actualDefault = inferExpr(ctx, env, param.default);
            var expectedDefault = sig.params[i];
            if param.variadic { expectedDefault = sig.variadicType; }
            expectType(ctx, expectedDefault, actualDefault, "default value type mismatch for '" + param.name + "'", exprSpan(param.default).start);
        }
        i = i + 1;
    }
    if owner != "" {
        var structDecl: StructDeclStmt = ctx.structs.get(owner);
        var f = 0;
        loop {
            if f >= structDecl.fields.len() { break; }
            var field = structDecl.fields[f];
            defineSymbol(ctx, env, field.name, resolveTypeTag(ctx, field.typeExpr, field.typeTag, decl.span.start, false), false, decl.span.start);
            f = f + 1;
        }
        defineSymbol(ctx, env, "self", resolveNamedType(ctx, owner, decl.span.start, false), false, decl.span.start);
    }
    checkBody(ctx, env, decl.body);
    var sawVoid = false;
    var sawValue = false;
    var returnIndex = 0;
    loop {
        if returnIndex >= ctx.returnTypes.len() { break; }
        if ctx.returnTypes[returnIndex].kind == "Void" { sawVoid = true; }
        else { sawValue = true; }
        returnIndex = returnIndex + 1;
    }
    if sawVoid && sawValue { addError(ctx, "function '" + key + "' cannot mix value and void returns", decl.span.start); }
    if sig.ret.kind != "Void" && !bodyDefinitelyReturns(decl.body) { addError(ctx, "function '" + key + "' must return " + typeName(sig.ret) + " on all paths; not all code paths return a value", decl.span.start); }
    ctx.inFunction = oldInFunction;
    ctx.currentReturn = oldReturn;
    ctx.returnTypes = oldReturns;
    ctx.loopDepth = oldLoop;
    ctx.currentStruct = oldStruct;
}

func rejectBadEntryMain(ctx: TypecheckContext) {
    if !ctx.isEntry || !ctx.functions.has("main") { return; }
    var sig: FunctionSig = ctx.functions.get("main");
    if sig.owner != "" { return; }
    if sig.params.len() == 0 && !sig.variadic && sig.ret.kind == "Void" { return; }
    var span = 0;
    var i = 0;
    loop {
        if i >= ctx.program.statements.len() { break; }
        match ctx.program.statements[i] {
            Stmt::FuncDecl(decl) => { if decl.name == "main" { span = decl.span.start; } },
            _ => {},
        }
        i = i + 1;
    }
    addError(ctx, "entry main must take no parameters and return void", span);
}

func statementIsExecutable(stmt: Stmt): bool {
    match stmt {
        Stmt::VarDecl(_) => { return true; },
        Stmt::ConstDecl(_) => { return true; },
        Stmt::FuncDecl(_) => { return false; },
        Stmt::StructDecl(_) => { return false; },
        Stmt::EnumDecl(_) => { return false; },
        Stmt::Import(_) => { return false; },
        Stmt::If(_) => { return true; },
        Stmt::Assign(_) => { return true; },
        Stmt::Return(_) => { return true; },
        Stmt::Break(_) => { return true; },
        Stmt::Continue(_) => { return true; },
        Stmt::While(_) => { return true; },
        Stmt::For(_) => { return true; },
        Stmt::Loop(_) => { return true; },
        Stmt::Block(_) => { return true; },
        Stmt::ExprStmt(_) => { return true; },
        Stmt::Match(_) => { return true; },
    }
    return false;
}

func checkGlobals(ctx: TypecheckContext, program: Program) {
    var sawExecutable = false;
    var i = 0;
    loop {
        if i >= program.statements.len() { break; }
        var stmt = program.statements[i];
        match stmt {
            Stmt::VarDecl(decl) => { checkGlobalBinding(ctx, stmt, decl.name, decl.typeTag, decl.typeExpr, decl.value, false, decl.span.start); },
            Stmt::ConstDecl(decl) => { checkGlobalBinding(ctx, stmt, decl.name, decl.typeTag, decl.typeExpr, decl.value, true, decl.span.start); },
            Stmt::FuncDecl(_) => {},
            Stmt::StructDecl(_) => {},
            Stmt::EnumDecl(_) => {},
            Stmt::Import(importDecl) => {
                if sawExecutable { addError(ctx, "imports must appear before executable top-level statements", importDecl.span.start); }
            },
            Stmt::If(_) => { checkStmt(ctx, ctx.globals, stmt); },
            Stmt::Assign(_) => { checkStmt(ctx, ctx.globals, stmt); },
            Stmt::Return(_) => { checkStmt(ctx, ctx.globals, stmt); },
            Stmt::Break(_) => { checkStmt(ctx, ctx.globals, stmt); },
            Stmt::Continue(_) => { checkStmt(ctx, ctx.globals, stmt); },
            Stmt::While(_) => { checkStmt(ctx, ctx.globals, stmt); },
            Stmt::For(_) => { checkStmt(ctx, ctx.globals, stmt); },
            Stmt::Loop(_) => { checkStmt(ctx, ctx.globals, stmt); },
            Stmt::Block(_) => { checkStmt(ctx, ctx.globals, stmt); },
            Stmt::ExprStmt(_) => { checkStmt(ctx, ctx.globals, stmt); },
            Stmt::Match(_) => { checkStmt(ctx, ctx.globals, stmt); },
        }
        if statementIsExecutable(stmt) { sawExecutable = true; }
        i = i + 1;
    }
}

func checkFunctions(ctx: TypecheckContext, program: Program) {
    var i = 0;
    loop {
        if i >= program.statements.len() { break; }
        var stmt = program.statements[i];
        match stmt {
            Stmt::FuncDecl(decl) => { checkFunction(ctx, decl, "", stmt, stmtNodeKey(stmt)); },
            Stmt::StructDecl(decl) => {
                var j = 0;
                loop { if j >= decl.methods.len() { break; } checkFunction(ctx, decl.methods[j], decl.name, decl.methods[j], funcDeclNodeKey(decl.methods[j])); j = j + 1; }
            },
            Stmt::VarDecl(_) => {},
            Stmt::ConstDecl(_) => {},
            Stmt::EnumDecl(_) => {},
            Stmt::Import(_) => {},
            Stmt::If(_) => {},
            Stmt::Assign(_) => {},
            Stmt::Return(_) => {},
            Stmt::Break(_) => {},
            Stmt::Continue(_) => {},
            Stmt::While(_) => {},
            Stmt::For(_) => {},
            Stmt::Loop(_) => {},
            Stmt::Block(_) => {},
            Stmt::ExprStmt(_) => {},
            Stmt::Match(_) => {},
        }
        i = i + 1;
    }
}

func refreshFunctionSymbols(ctx: TypecheckContext) {
    var i = 0;
    loop {
        if i >= ctx.symbols.len() { break; }
        var symbol = ctx.symbols[i];
        if symbol.kind == "Function" && symbol.moduleId == ctx.moduleId && ctx.functions.has(symbol.sourceName) {
            var sig: FunctionSig = ctx.functions.get(symbol.sourceName);
            symbol.signature = functionType(sig.params, sig.ret);
            symbol.isPub = sig.isPub;
            var fixedCount = sig.params.len();
            var variadicIndex = -1;
            if sig.variadic { fixedCount = fixedCount - 1; variadicIndex = fixedCount; }
            symbol.callShape = CallShape { requiredCount: sig.required, fixedCount: fixedCount, variadicIndex: variadicIndex };
            ctx.symbols[i] = symbol;
        }
        i = i + 1;
    }
}

func structLayout(ctx: TypecheckContext, decl: StructDeclStmt, declarationIndex: int): CheckedNominalLayout {
    var fields: Vec<CheckedNominalField> = [];
    var fieldPos = 0;
    loop {
        if fieldPos >= decl.fields.len() { break; }
        var field = decl.fields[fieldPos];
        var fieldType = resolveTypeTag(ctx, field.typeExpr, field.typeTag, decl.span.start, false);
        fields.push(CheckedNominalField { name: field.name, fieldIndex: fieldPos, ty: fieldType, isPub: field.isPub });
        fieldPos = fieldPos + 1;
    }
    var variants: Vec<CheckedNominalVariant> = [];
    return CheckedNominalLayout { kind: "Struct", name: decl.name, sourcePath: ctx.sourcePath, moduleId: ctx.moduleId, declarationIndex: declarationIndex, fields: fields, variants: variants };
}

func enumLayout(ctx: TypecheckContext, decl: EnumDeclStmt, declarationIndex: int): CheckedNominalLayout {
    var variants: Vec<CheckedNominalVariant> = [];
    var variantPos = 0;
    loop {
        if variantPos >= decl.variantDecls.len() { break; }
        var variant = decl.variantDecls[variantPos];
        var payloadTypes: Vec<Type> = [];
        var payloadPos = 0;
        loop {
            if payloadPos >= variant.payloadTypes.len() { break; }
            payloadTypes.push(resolveTypeExpr(ctx, variant.payloadTypes[payloadPos], false));
            payloadPos = payloadPos + 1;
        }
        variants.push(CheckedNominalVariant { name: variant.name, variantIndex: variantPos, payloadTypes: payloadTypes });
        variantPos = variantPos + 1;
    }
    var fields: Vec<CheckedNominalField> = [];
    return CheckedNominalLayout { kind: "Enum", name: decl.name, sourcePath: ctx.sourcePath, moduleId: ctx.moduleId, declarationIndex: declarationIndex, fields: fields, variants: variants };
}

func collectNominalLayouts(ctx: TypecheckContext): Vec<CheckedNominalLayout> {
    var previousSuppress = ctx.suppressErrors;
    ctx.suppressErrors = true;
    var layouts: Vec<CheckedNominalLayout> = [];
    var statementIndex = 0;
    loop {
        if statementIndex >= ctx.program.statements.len() { break; }
        var stmt = ctx.program.statements[statementIndex];
        match stmt {
            Stmt::StructDecl(decl) => {
                if ctx.structs.has(decl.name) && ctx.structIndices.has(decl.name) && ctx.structIndices.get(decl.name) == statementIndex && ctx.structOwners.get(decl.name) == ctx.moduleId {
                    layouts.push(structLayout(ctx, decl, statementIndex));
                }
            },
            Stmt::EnumDecl(decl) => {
                if ctx.enums.has(decl.name) && ctx.enumIndices.has(decl.name) && ctx.enumIndices.get(decl.name) == statementIndex && ctx.enumOwners.get(decl.name) == ctx.moduleId {
                    layouts.push(enumLayout(ctx, decl, statementIndex));
                }
            },
            _ => {},
        }
        statementIndex = statementIndex + 1;
    }
    ctx.suppressErrors = previousSuppress;
    return layouts;
}

func typecheckSingle(unit: SourceUnit, graph: SourceGraph, summaries: HashMap<string, ModuleSummary>, moduleIndex: int): TypecheckResult {
    var program = unit.program;
    var ctx = newContext();
    ctx.sourcePath = unit.sourcePath;
    ctx.moduleId = unit.moduleId;
    ctx.moduleIndex = moduleIndex;
    ctx.isEntry = unit.isEntry;
    ctx.program = program;
    ctx.moduleSummaries = summaries;
    var importIndex = 0;
    loop {
        if importIndex >= program.statements.len() { break; }
        var stmt = program.statements[importIndex];
        match stmt {
            Stmt::VarDecl(_) => {},
            Stmt::ConstDecl(_) => {},
            Stmt::FuncDecl(_) => {},
            Stmt::StructDecl(_) => {},
            Stmt::EnumDecl(_) => {},
            Stmt::Import(importStmt) => {
                var foundEdge = false;
                var edgeIndex = 0;
                loop {
                    if edgeIndex >= graph.edges.len() { break; }
                    if graph.edges[edgeIndex].fromPath == unit.sourcePath && graph.edges[edgeIndex].span.start == importStmt.span.start { foundEdge = true; }
                    edgeIndex = edgeIndex + 1;
                }
                if !foundEdge { addError(ctx, "import is missing from the source graph", importStmt.span.start); }
            },
            Stmt::If(_) => {},
            Stmt::Assign(_) => {},
            Stmt::Return(_) => {},
            Stmt::Break(_) => {},
            Stmt::Continue(_) => {},
            Stmt::While(_) => {},
            Stmt::For(_) => {},
            Stmt::Loop(_) => {},
            Stmt::Block(_) => {},
            Stmt::ExprStmt(_) => {},
            Stmt::Match(_) => {},
        }
        importIndex = importIndex + 1;
    }
    registerBuiltins(ctx);
    installImports(ctx, unit, graph);
    collectDeclarations(ctx, program);
    validateDeclarations(ctx, program);
    var nominalLayouts = collectNominalLayouts(ctx);
    defineGlobalPlaceholders(ctx, program);
    inferGlobalTypes(ctx, program);
    inferFunctionReturns(ctx, program);
    inferGlobalTypes(ctx, program);
    inferFunctionReturns(ctx, program);
    ctx.recording = true;
    checkGlobals(ctx, program);
    checkFunctions(ctx, program);
    rejectBadEntryMain(ctx);
    refreshFunctionSymbols(ctx);
    var unitEdges: Vec<ImportEdge> = [];
    var edgeIndex = 0;
    loop {
        if edgeIndex >= graph.edges.len() { break; }
        if graph.edges[edgeIndex].fromPath == unit.sourcePath { unitEdges.push(graph.edges[edgeIndex]); }
        edgeIndex = edgeIndex + 1;
    }
    var checked = CheckedProgram { entryPath: graph.entryPath, units: [unit], edges: unitEdges, expressions: ctx.expressions, bindings: ctx.bindings, fieldInitializers: ctx.fieldInitializers, symbols: ctx.symbols, nominalLayouts: nominalLayouts };
    return TypecheckResult { ok: ctx.errors.len() == 0, errors: ctx.errors, checkedProgram: checked };
}

func stableModuleIndex(graph: SourceGraph, moduleId: string): int {
    var index = 0;
    var i = 0;
    loop {
        if i >= graph.units.len() { break; }
        if graph.units[i].moduleId < moduleId { index = index + 1; }
        i = i + 1;
    }
    return index;
}

pub func typecheckGraph(graph: SourceGraph): TypecheckResult {
    if graph.errors.len() > 0 {
        var loadErrors: Vec<TypeError> = [];
        var loadIndex = 0;
        loop {
            if loadIndex >= graph.errors.len() { break; }
            loadErrors.push(TypeError { message: graph.errors[loadIndex], span: -1, sourcePath: graph.entryPath, moduleId: graph.entryPath });
            loadIndex = loadIndex + 1;
        }
        var emptyExpressions: Vec<CheckedExprInfo> = [];
        var emptyBindings: Vec<CheckedBindingInfo> = [];
        var emptyFieldInitializers: Vec<CheckedFieldInitInfo> = [];
        var emptySymbols: Vec<ResolvedSymbol> = [];
        var emptyNominalLayouts: Vec<CheckedNominalLayout> = [];
        var failedProgram = CheckedProgram { entryPath: graph.entryPath, units: graph.units, edges: graph.edges, expressions: emptyExpressions, bindings: emptyBindings, fieldInitializers: emptyFieldInitializers, symbols: emptySymbols, nominalLayouts: emptyNominalLayouts };
        return TypecheckResult { ok: false, errors: loadErrors, checkedProgram: failedProgram };
    }
    if graph.units.len() == 0 {
        var emptyErrors: Vec<TypeError> = [TypeError { message: "source graph contains no units", span: -1, sourcePath: graph.entryPath, moduleId: graph.entryPath }];
        var emptyUnits: Vec<SourceUnit> = [];
        var emptyExpressions: Vec<CheckedExprInfo> = [];
        var emptyBindings: Vec<CheckedBindingInfo> = [];
        var emptyFieldInitializers: Vec<CheckedFieldInitInfo> = [];
        var emptySymbols: Vec<ResolvedSymbol> = [];
        var emptyNominalLayouts: Vec<CheckedNominalLayout> = [];
        var emptyChecked = CheckedProgram { entryPath: graph.entryPath, units: emptyUnits, edges: graph.edges, expressions: emptyExpressions, bindings: emptyBindings, fieldInitializers: emptyFieldInitializers, symbols: emptySymbols, nominalLayouts: emptyNominalLayouts };
        return TypecheckResult { ok: false, errors: emptyErrors, checkedProgram: emptyChecked };
    }
    var summaries: HashMap<string, ModuleSummary> = HashMap.new();
    var errors: Vec<TypeError> = [];
    var expressions: Vec<CheckedExprInfo> = [];
    var bindings: Vec<CheckedBindingInfo> = [];
    var fieldInitializers: Vec<CheckedFieldInitInfo> = [];
    var symbols: Vec<ResolvedSymbol> = [];
    var nominalLayouts: Vec<CheckedNominalLayout> = [];
    var unitIndex = 0;
    loop {
        if unitIndex >= graph.units.len() { break; }
        var unit = graph.units[unitIndex];
        var moduleIndex = stableModuleIndex(graph, unit.moduleId);
        var result = typecheckSingle(unit, graph, summaries, moduleIndex);
        var errorIndex = 0;
        loop { if errorIndex >= result.errors.len() { break; } errors.push(result.errors[errorIndex]); errorIndex = errorIndex + 1; }
        var maybeCheckedUnit = result.checkedProgram;
        if maybeCheckedUnit != null {
            var checkedUnit: CheckedProgram = maybeCheckedUnit;
            var expressionIndex = 0;
            loop { if expressionIndex >= checkedUnit.expressions.len() { break; } expressions.push(checkedUnit.expressions[expressionIndex]); expressionIndex = expressionIndex + 1; }
            var bindingIndex = 0;
            loop { if bindingIndex >= checkedUnit.bindings.len() { break; } bindings.push(checkedUnit.bindings[bindingIndex]); bindingIndex = bindingIndex + 1; }
            var fieldInitIndex = 0;
            loop { if fieldInitIndex >= checkedUnit.fieldInitializers.len() { break; } fieldInitializers.push(checkedUnit.fieldInitializers[fieldInitIndex]); fieldInitIndex = fieldInitIndex + 1; }
            var symbolIndex = 0;
            loop { if symbolIndex >= checkedUnit.symbols.len() { break; } symbols.push(checkedUnit.symbols[symbolIndex]); symbolIndex = symbolIndex + 1; }
            var layoutIndex = 0;
            loop { if layoutIndex >= checkedUnit.nominalLayouts.len() { break; } nominalLayouts.push(checkedUnit.nominalLayouts[layoutIndex]); layoutIndex = layoutIndex + 1; }
            summaries.set(unit.moduleId, buildModuleSummary(unit, checkedUnit, moduleIndex));
        }
        unitIndex = unitIndex + 1;
    }
    var checked = CheckedProgram { entryPath: graph.entryPath, units: graph.units, edges: graph.edges, expressions: expressions, bindings: bindings, fieldInitializers: fieldInitializers, symbols: symbols, nominalLayouts: nominalLayouts };
    return TypecheckResult { ok: errors.len() == 0, errors: errors, checkedProgram: checked };
}

pub func typecheckAt(program: Program, sourcePath: string, source: string): TypecheckResult {
    var path = sourcePath;
    if path == "" { path = "<single-file>"; }
    var unit = SourceUnit { sourcePath: path, moduleId: path, source: source, isEntry: true, program: program };
    var graph = SourceGraph { entryPath: path, units: [unit], edges: [], errors: [] };
    return typecheckGraph(graph);
}

pub func typecheck(program: Program): TypecheckResult {
    return typecheckAt(program, "<single-file>", "");
}
