// Rey Compiler - Full Pipeline

import lexer;
import parser;
import typecheck;
import codegen;

struct CompileResult {
    pub ok: bool,
    pub errors: Any,
    pub ir: String,
    pub outputPath: String,
}

func lastSlashIndex(path: String): int {
    var i = path.len() - 1;
    loop {
        if i < 0 { break; }
        if path[i] == "/" { return i; }
        i = i - 1;
    }
    return -1;
}

func dirname(path: String): String {
    var idx = lastSlashIndex(path);
    if idx < 0 { return "."; }
    if idx == 0 { return "/"; }
    return path.slice(0, idx);
}

func projectRootDir(basePath: String): String {
    var srcIdx = basePath.indexOf("/src/");
    if srcIdx >= 0 {
        return basePath.slice(0, srcIdx);
    }
    return dirname(basePath);
}

func resolveImportPath(basePath: String, importPath: String): String {
    var base = dirname(basePath);
    if importPath.startsWith("/") { return importPath; }
    if importPath.startsWith("./") {
        return base + "/" + importPath.slice(2, importPath.len());
    }
    // Module import: search from base dir, then from project root
    // Try direct .rey file in same directory first (matches Rust interpreter behavior)
    var directFile = base + "/" + importPath + ".rey";
    if fileExists(directFile) { return directFile; }
    var srcModPath = base + "/src/" + importPath + "/main.rey";
    if fileExists(srcModPath) { return srcModPath; }
    var modPath = base + "/" + importPath + "/main.rey";
    if fileExists(modPath) { return modPath; }
    var root = projectRootDir(basePath);
    var rootSrcPath = root + "/src/" + importPath + "/main.rey";
    if fileExists(rootSrcPath) { return rootSrcPath; }
    var rootModPath = root + "/" + importPath + "/main.rey";
    if fileExists(rootModPath) { return rootModPath; }
    return base + "/" + importPath;
}

func lastDotIndex(path: String): int {
    var i = path.len() - 1;
    loop {
        if i < 0 { break; }
        if path[i] == "." { return i; }
        if path[i] == "/" { break; }
        i = i - 1;
    }
    return -1;
}

func basenameNoExt(path: String): String {
    var slash = lastSlashIndex(path);
    var start = 0;
    if slash >= 0 { start = slash + 1; }
    var name = path.slice(start, path.len());
    var dot = lastDotIndex(name);
    if dot >= 0 {
        return name.slice(0, dot);
    }
    return name;
}

func defaultOutputPath(srcPath: String): String {
    var out = dirname(srcPath) + "/" + basenameNoExt(srcPath);
    // avoid collisions with existing files/dirs (common in tests, e.g. `imports/`)
    if fileExists(out) {
        return out + ".bin";
    }
    return out;
}

func parseFileToProgram(path: String) {
    var content = readFile(path);
    var lexResult = lexer.tokenize(content, path);
    if lexResult.errors.length() > 0 {
        var e = lexResult.errors[0];
        return Result.Err("lexer error at line " + e.span.line.toString() + ": " + e.message);
    }
    var parseResult = parser.parse(lexResult.tokens, path);
    if parseResult.errors.length() > 0 {
        var pe = parseResult.errors[0];
        var ei = 0;
        loop {
            if ei >= 20 { break; }
            if ei >= parseResult.errors.length() { break; }
            var e2 = parseResult.errors[ei];
            println("  err[" + ei.toString() + "] line " + e2.span.line.toString() + ": " + e2.message);
            ei = ei + 1;
        }
        return Result.Err("parse error at line " + pe.span.line.toString() + ": " + pe.message);
    }
    return Result.Ok(parseResult.program);
}

func loadProgramWithImports(path: String, visited, stack) {
    if visited.has(path) {
        return Result.Ok(Program { statements: [], span: Span { start: 0, end: 0, line: 0, column: 0 } });
    }
    if stack.contains(path) {
        return Result.Err("circular import: " + stack.join(" -> ") + " -> " + path);
    }
    stack.push(path);
    visited.set(path, true);

    var pr = parseFileToProgram(path);
    if pr.isErr() { return pr; }
    var prog = pr.unwrap();

    var merged = [];
    var i = 0;
    loop {
        if i >= prog.statements.length() { break; }
        var st = prog.statements[i];
        if st instanceof ImportStmt {
            var ip = resolveImportPath(path, st.path);
            var sub = loadProgramWithImports(ip, visited, stack);
            if sub.isErr() { return sub; }
            var subProg = sub.unwrap();
            var j = 0;
            loop {
                if j >= subProg.statements.length() { break; }
                merged.push(subProg.statements[j]);
                j = j + 1;
            }
        } else {
            merged.push(st);
        }
        i = i + 1;
    }

    stack.pop();
    return Result.Ok(Program { statements: merged, span: prog.span });
}

func compileSource(source: String, path: String, cmd: String, rtDir: String): CompileResult {
    var errors = Vec.new();

    var lexResult = lexer.tokenize(source, path);
    if lexResult.errors.length() > 0 {
        var e = lexResult.errors[0];
        return CompileResult { ok: false, errors: "lexer error at line " + e.span.line.toString() + ": " + e.message, ir: "", outputPath: "" };
    }

    var parseResult = parser.parse(lexResult.tokens, path);
    if parseResult.errors.length() > 0 {
        var pe = parseResult.errors[0];
        return CompileResult { ok: false, errors: "parse error at line " + pe.span.line.toString() + ": " + pe.message, ir: "", outputPath: "" };
    }

    var typeResult = typecheck.typecheck(parseResult.program);
    if !typeResult.ok {
        if typeResult.errors.length() > 0 {
            var te = typeResult.errors[0];
            return CompileResult { ok: false, errors: "type error: " + te.message, ir: "", outputPath: "" };
        }
        return CompileResult { ok: false, errors: "type error", ir: "", outputPath: "" };
    }

    var ir = codegen.generateIR(parseResult.program);

    if cmd == "build" || cmd == "run" {
        var outputPath = defaultOutputPath(path);
        var compileRes = codegen.compileLLVM(ir, outputPath, false, rtDir);
        if compileRes.isErr() {
            return CompileResult { ok: false, errors: compileRes.unwrapOr("compile failed"), ir: ir, outputPath: "" };
        }
        outputPath = compileRes.unwrap();

        println("Compiled: " + path);
        return CompileResult { ok: true, errors: "ok", ir: ir, outputPath: outputPath };
    }

    return CompileResult { ok: true, errors: "ok", ir: ir, outputPath: "a.out" };
}

func compileFile(entryPath: String, cmd: String, rtDir: String): CompileResult {
    var exists = fileExists(entryPath);
    if !exists {
        return CompileResult { ok: false, errors: "file not found", ir: "", outputPath: "" };
    }

    var visited = HashMap.new();
    var stack = Vec.new();
    var pr = loadProgramWithImports(entryPath, visited, stack);
    if pr.isErr() {
        return CompileResult { ok: false, errors: pr.unwrapOr("import error"), ir: "", outputPath: "" };
    }
    var program = pr.unwrap();

    var typeResult = typecheck.typecheck(program);
    if !typeResult.ok {
        if typeResult.errors.length() > 0 {
            var te = typeResult.errors[0];
            return CompileResult { ok: false, errors: "type error: " + te.message, ir: "", outputPath: "" };
        }
        return CompileResult { ok: false, errors: "type error", ir: "", outputPath: "" };
    }

    var ir = codegen.generateIR(program);

    if cmd == "build" || cmd == "run" {
        var outputPath = defaultOutputPath(entryPath);
        var compileRes = codegen.compileLLVM(ir, outputPath, false, rtDir);
        if compileRes.isErr() {
            return CompileResult { ok: false, errors: compileRes.unwrapOr("compile failed"), ir: ir, outputPath: "" };
        }
        outputPath = compileRes.unwrap();

        println("Compiled: " + entryPath);
        return CompileResult { ok: true, errors: "ok", ir: ir, outputPath: outputPath };
    }

    return CompileResult { ok: true, errors: "ok", ir: ir, outputPath: "a.out" };
}

func main() {
    var cliArgs = args();
    if cliArgs.length() < 4 {
        println("Usage: reyc <build|run|check> <file>");
    } else {
        var cmd = cliArgs[2];
        var path = cliArgs[3];

        // derive runtime dir from compiler script path (args()[1] = rey-compiler/main.rey)
        var compilerPath = cliArgs[1];
        var rtDir = dirname(compilerPath) + "/runtime";

        var result = compileFile(path, cmd, rtDir);

        if result.ok {
            println("Success: " + result.outputPath);
            if cmd == "run" {
                var runRes = exec(result.outputPath);
                if runRes.isOk() {
                    print("" + runRes.unwrap());
                } else {
                    println("run error: " + runRes.unwrapOr("?"));
                }
            }
        } else {
            println("Error: " + result.errors);
        }
    }
}
