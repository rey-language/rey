func main(): void {
    var values = args();
    if values.len() != 10 { exit(2); }
    var size = values[1].toInt();
    if size < 0 || size > 5000000 { exit(2); }
    var checksum = 0;
    var i = 0;
    loop {
        if i >= size { break; }
        checksum += values[(i % 8) + 2].toInt();
        i += 1;
    }
    println("checksum=" + checksum.toString() + " processed=" + size.toString());
}
