func main(): Void {
    var rounds = 64;
    var checksum = 0;
    var round = 0;
    while (round < rounds) {
        var values: [int] = [];
        var index = 0;
        while (index < 32) {
            push(values, (round * 17 + index * 13) % 1009);
            index += 1;
        }
        var item = 0;
        while (item < len(values)) {
            checksum += values[item];
            item += 1;
        }
        round += 1;
    }
    println("checksum=" + checksum.toString() + " processed=" + (rounds * 32).toString());
}
