import std::fmt;

func check(label: string, ok: bool): void {
    if ok {
        println("PASS: " + label);
    } else {
        println("FAIL: " + label);
        assert(false, label);
    }
}

var values: Vec<any> = ["rey", 7, true];
check("format replaces automatic placeholders", fmt.format("{{}}:{{}}:{{}}", values) == "rey:7:true");
check("format replaces indexed placeholders", fmt.format("{{1}}/{{0}}/{{2}}", values) == "7/rey/true");
check("format preserves invalid placeholder", fmt.format("{{x}}", values) == "{{x}}");
check("format preserves missing argument", fmt.format("{{4}}", values) == "{{4}}");
check("padLeft repeats and truncates pad", fmt.padLeft("x", 6, "ab") == "ababax");
check("padRight pads to width", fmt.padRight("x", 4, "0") == "x000");
check("padding leaves long strings unchanged", fmt.padLeft("long", 2, "0") == "long");
check("empty pad leaves input unchanged", fmt.padRight("x", 3, "") == "x");
check("toHex converts positive integer", fmt.toHex(255) == "ff");
check("toHex converts negative integer", fmt.toHex(-42) == "-2a");
check("toHex handles the minimum integer", fmt.toHex(-9223372036854775807 - 1) == "-8000000000000000");
check("toBin converts integer", fmt.toBin(10) == "1010");
check("toOct converts integer", fmt.toOct(64) == "100");
check("radix conversion handles zero", fmt.toHex(0) == "0" && fmt.toBin(0) == "0" && fmt.toOct(0) == "0");

println("fmt: all tests passed");
