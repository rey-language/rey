import std::math;

var PI: float = 3.14159265358979;

func check(label: string, result: any, expected: any): void {
    if result == expected {
        println("PASS: " + label);
    } else {
        println("FAIL: " + label);
        assert(false, label);
    }
}

func checkClose(label: string, result: float, expected: float): void {
    var diff = result - expected;
    if diff < 0.0 {
        diff = diff * -1.0;
    }
    if diff < 0.001 {
        println("PASS: " + label);
    } else {
        println("FAIL: " + label);
        assert(false, label);
    }
}

// clamp
check("clamp in-range", math.clamp(5, 0, 10), 5);
check("clamp below min", math.clamp(-3, 0, 10), 0);
check("clamp above max", math.clamp(15, 0, 10), 10);

// sign
check("sign positive", math.sign(10), 1);
check("sign negative", math.sign(-2), -1);
check("sign zero", math.sign(0), 0);

// floor, ceil, round
check("floor positive", math.floor(3.8), 3);
check("floor negative", math.floor(-3.2), -4);
check("ceil positive", math.ceil(3.2), 4);
check("ceil negative", math.ceil(-3.8), -3);
check("round down", math.round(3.49), 3);
check("round up", math.round(3.5), 4);
check("round negative", math.round(-3.5), -4);

// trig
checkClose("toRadians", math.toRadians(180.0), PI);
checkClose("toDegrees", math.toDegrees(PI), 180.0);
checkClose("sin(0)", math.sin(0.0), 0.0);
checkClose("sin(pi/2)", math.sin(PI / 2.0), 1.0);
checkClose("cos(0)", math.cos(0.0), 1.0);
checkClose("cos(pi)", math.cos(PI), -1.0);
checkClose("tan(0)", math.tan(0.0), 0.0);

// stats
check("sum", math.sum(1, 2, 3, 4), 10);
check("mean", math.mean(1, 2, 3, 4), 2);
check("max", math.max(8, 3), 8);
check("min", math.min(8, 3), 3);
check("abs", math.abs(-42), 42);

// roots, powers, logarithms, and constants
checkClose("sqrt", math.sqrt(81.0), 9.0);
checkClose("pow", math.pow(2.0, 8.0), 256.0);
checkClose("log(e)", math.log(math.e()), 1.0);
checkClose("pi", math.pi(), PI);
checkClose("e", math.e(), 2.718281828459045);
checkClose("tau", math.tau(), 2.0 * PI);
checkClose("lerp", math.lerp(10.0, 20.0, 0.25), 12.5);
checkClose("hypot", math.hypot(3.0, 4.0), 5.0);
var randomValue = math.random();
check("random lower bound", randomValue >= 0.0, true);
check("random upper bound", randomValue < 1.0, true);

// additional statistics
checkClose("median odd", math.median([1, 3, 2]), 2.0);
checkClose("median even", math.median([1, 2, 3, 4]), 2.5);
checkClose("median unsorted input", math.median([9, 1, 5]), 5.0);
checkClose("median duplicates", math.median([2, 2, 2]), 2.0);
checkClose("median even duplicates", math.median([2, 1, 2, 1]), 1.5);
checkClose("median empty", math.median([]), 0.0);
checkClose("population variance", math.variance([1, 2, 3]), 0.6666666667);
checkClose("variance empty", math.variance([]), 0.0);
checkClose("population standard deviation", math.stdDev([1, 2, 3]), 0.8164965809);
checkClose("standard deviation empty", math.stdDev([]), 0.0);

// integer arithmetic utilities
check("gcd", math.gcd(54, 24), 6);
check("gcd negative", math.gcd(-54, 24), 6);
check("gcd zero", math.gcd(0, 9), 9);
check("gcd both zero", math.gcd(0, 0), 0);
check("lcm", math.lcm(12, 18), 36);
check("lcm zero", math.lcm(0, 18), 0);
check("lcm negative", math.lcm(-4, 6), 12);
check("factorial zero", math.factorial(0), 1);
check("factorial", math.factorial(6), 720);

// conversion helpers
checkClose("degToRad", math.degToRad(180.0), PI);
checkClose("radToDeg", math.radToDeg(PI), 180.0);
check("trunc positive", math.trunc(3.9), 3);
check("trunc negative", math.trunc(-3.9), -3);
checkClose("fract positive", math.fract(3.75), 0.75);
checkClose("fract negative", math.fract(-3.75), 0.25);

println("math: all tests passed");
