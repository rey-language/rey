// Test integer division bug
var a = 10;
var b = 3;
var result = a / b;

// Should be 3 for integer division, but might return float
println(result);

// Check if it's a float
if (result == 3.3333333333333335) {
    println("BUG: integer division returned float");
} else {
    println("OK: result is " + result);
}
