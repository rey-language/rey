enum Shape {
    Circle(float),
    Rect(float, float),
    Triangle(float, float),
}

func area(shape: Shape): float {
    match shape {
        Shape::Circle(a) => { return 3.14159 * a * a; },
        Shape::Rect(b, c) => { return b * c; },
        Shape::Triangle(d, e) => { return 0.5 * d * e; },
        _ => { return 0.0; },
    }
}

var c = Shape::Circle(5.0);
var r = Shape::Rect(4.0, 6.0);
var t = Shape::Triangle(3.0, 8.0);

print(area(c));
print(area(r));
print(area(t));
