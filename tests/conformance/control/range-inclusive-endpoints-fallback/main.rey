// OPEN: precedence for overlapping range arms is unspecified; explicit ranges here are disjoint and fallback is last.
var low = 1;
match low {
    1..3 => { println("range"); },
    _ => { println("fallback"); },
}

var high = 3;
match high {
    1..3 => { println("range"); },
    _ => { println("fallback"); },
}

var outside = 4;
match outside {
    1..3 => { println("range"); },
    _ => { println("fallback"); },
}
