// spec 9.2: float values survive vec and hashmap storage.
func main(): void {
    var ratios: Vec<float> = Vec.new();
    ratios.push(1.5);
    ratios.push(2.5);
    println(ratios.get(0) == 1.5);
    println(ratios.get(1) + ratios.get(0) == 4.0);
    var labels: HashMap<string, float> = HashMap.new();
    labels.set("pi-ish", 3.25);
    println(labels.get("pi-ish") == 3.25);
    var literal: Vec<float> = [0.5, 0.5];
    println(literal[0] + literal[1] == 1.0);
}
