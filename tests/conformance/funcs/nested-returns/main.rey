// Charter §2 decision 11: nested conditional branches return values matching the function type.
func classify(n: int): int {
  if n < 0 {
    if n < -10 {
      return -2;
    } else {
      return -1;
    }
  } else {
    if n == 0 {
      return 0;
    } else {
      return 1;
    }
  }
}
println(classify(-12));
println(classify(-2));
println(classify(0));
println(classify(8));
