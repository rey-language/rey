struct Temp {
    pub value: int,
}

func sourcecheck(ok: bool): void {
    if !ok {
        var zero: int = 0;
        var trap: int = 1 / zero;
    }
    return;
}

func makeWithTemp(seed: int): Vec<int> {
    var temp: Temp = Temp { value: seed };
    var values: Vec<int> = [seed, seed + 1];
    values.push(temp.value + 1);
    return values;
}

func makeMapWithTemp(seed: int): HashMap<string, int> {
    var temp: Temp = Temp { value: seed };
    var values: HashMap<string, int> = {"seed": temp.value};
    values.set("next", seed + 1);
    return values;
}

func consume(seed: int): int {
    var temp: Temp = Temp { value: seed };
    var values: Vec<int> = makeWithTemp(temp.value);
    var total: int = values[0] + values[1] + values[2];
    values.push(total);
    sourcecheck(values.len() == 4);
    sourcecheck(values[3] == total);
    return total;
}

func consumeMap(seed: int): int {
    var temp: Temp = Temp { value: seed };
    var values: HashMap<string, int> = makeMapWithTemp(temp.value);
    var total: int = values["seed"] + values["next"];
    values.set("total", total);
    sourcecheck(values.len() == 3);
    return total;
}

func main(): void {
    sourcecheck(consume(7) == 23);
    sourcecheck(consumeMap(3) == 7);
    return;
}
