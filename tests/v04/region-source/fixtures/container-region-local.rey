struct Temp {
    pub value: int,
}

struct Holder {
    pub values: Vec<int>,
    pub counts: HashMap<string, int>,
}

func sourcecheck(ok: bool): void {
    if !ok {
        var zero: int = 0;
        var trap: int = 1 / zero;
    }
    return;
}

func localContainer(seed: int): int {
    var temp: Temp = Temp { value: seed };
    var values: Vec<int> = [seed, seed + 1];
    values.push(temp.value + 1);
    var counts: HashMap<string, int> = {"seed": temp.value};
    counts.set("len", values.len());
    var holder: Holder = Holder { values: values, counts: counts };
    sourcecheck(holder.values.len() == 3);
    sourcecheck(holder.counts["len"] == 3);
    return holder.values[2] + holder.counts["seed"];
}

func loopLocal(count: int): int {
    var index: int = 0;
    var total: int = 0;
    while index < count {
        var temp: Temp = Temp { value: index };
        var values: Vec<int> = [index, index + 1];
        values.push(temp.value + 2);
        total = total + values[2];
        index = index + 1;
    }
    return total;
}

func main(): void {
    sourcecheck(localContainer(7) == 15);
    sourcecheck(loopLocal(4) == 14);
    return;
}
