func contains(values: Vec<string>, wanted: string): bool {
    var index = 0;
    while index < values.len() {
        if values[index] == wanted { return true; }
        index = index + 1;
    }
    return false;
}

func main(): void {
    var path = "build/v04/host-runtime-io.txt";
    writeFile(path, "alpha");
    appendFile(path, "beta");
    if !fileExists(path) { exit(1); }
    var text = readFile(path);
    if text != "alphabeta" { exit(2); }
    var names = listDir("build/v04");
    if !contains(names, "host-runtime-io.txt") { exit(3); }
    var argv = args();
    if argv.len() < 1 { exit(4); }
    deleteFile(path);
    if fileExists(path) { exit(5); }
}
