struct Holder {
    pub name: string,
    pub values: Vec<int>,
    pub counts: HashMap<string, int>,
    pub next: Holder?,
}

func sourcecheck(ok: bool): void {
    if !ok {
        var zero: int = 0;
        var trap: int = 1 / zero;
    }
    return;
}

func makeHolder(seed: int): Holder {
    var values: Vec<int> = [seed, seed + 1];
    var counts: HashMap<string, int> = {"seed": seed};
    return Holder { name: "holder", values: values, counts: counts, next: null };
}

func passHolder(value: Holder): Holder {
    return value;
}

func grow(value: Holder): Holder {
    value.values.push(99);
    value.counts.set("grown", 1);
    return value;
}

func main(): void {
    var holder: Holder = makeHolder(5);
    sourcecheck(holder.name == "holder");
    sourcecheck(holder.values.len() == 2);
    sourcecheck(holder.values[0] == 5);
    sourcecheck(holder.counts["seed"] == 5);
    var alias: Holder = passHolder(holder);
    alias.values[1] = 50;
    sourcecheck(holder.values[1] == 50);
    alias.counts["seed"] = 500;
    sourcecheck(holder.counts["seed"] == 500);
    var grown: Holder = grow(alias);
    sourcecheck(grown.values.len() == 3);
    sourcecheck(grown.values[2] == 99);
    sourcecheck(holder.values.len() == 3);
    sourcecheck(grown.counts["grown"] == 1);
    holder.next = holder;
    sourcecheck(holder.next == holder);
    var next: Holder? = holder.next;
    if next != null {
        sourcecheck(next.values[1] == 50);
    } else {
        sourcecheck(false);
    }
    return;
}
