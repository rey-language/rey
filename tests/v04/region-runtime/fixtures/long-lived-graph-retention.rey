import layout::{layoutRegisterFixed, layoutRegistryCreate, layoutRegistryRelease};
import managed::{managedAllocateProgram, managedCreate, managedDependencyCount, managedDestroy, managedLiveObjects, managedLivePayloadBytes, managedProgramRegion, managedPromotionCount, managedRegionAllocate, managedRegionCreate, managedRegionEnd, managedRegionGroupCount, managedRegionObjectCount, managedRegionRequestedBytes, managedRegionUsedBytes, managedRequestedObjectBytes, managedStoreReference};

func check(ok: bool): void {
    if !ok { __reyRawFail(2299); }
}

func main(): void {
    var registry = layoutRegistryCreate(1);
    var offsets = __reyRawMap(8);
    __reyRawStoreI64(offsets, 0);
    var node = layoutRegisterFixed(registry, 8, offsets, 1);
    __reyRawUnmap(offsets, 8);
    var context = managedCreate(registry);
    var program = managedProgramRegion(context);
    var root = managedAllocateProgram(context, node, 1);
    var child = managedRegionCreate(context);
    var left = managedRegionAllocate(context, child, node, 2);
    var middle = managedRegionAllocate(context, child, node, 2);
    var right = managedRegionAllocate(context, child, node, 3);
    var aliasLeft = left;
    var aliasMiddle = middle;
    var aliasRight = right;
    managedStoreReference(context, left, 0, middle);
    managedStoreReference(context, middle, 0, right);
    managedStoreReference(context, right, 0, left);
    check(managedPromotionCount(context) == 0);
    check(managedDependencyCount(context) == 0);
    managedStoreReference(context, root, 0, left);
    check(__reyRawEqual(__reyRawLoadAddress(__reyRawOffset(root, 16)), left));
    check(managedPromotionCount(context) == 2);
    check(managedDependencyCount(context) == 1);
    check(__reyRawLoadI64(__reyRawOffset(program, 56)) == 4);
    check(__reyRawLoadI64(__reyRawOffset(program, 48)) == 3);
    check(__reyRawLoadI64(__reyRawOffset(child, 56)) == 0);
    check(managedLiveObjects(context) == 4);
    check(managedLivePayloadBytes(context) == 32);
    check(managedRequestedObjectBytes(context) == 128);
    check(managedRegionRequestedBytes(context) == 12288);
    check(managedRegionUsedBytes(context) == 408);
    managedRegionEnd(context, child);
    check(managedDependencyCount(context) == 0);
    check(managedPromotionCount(context) == 2);
    check(managedLiveObjects(context) == 4);
    check(managedRegionObjectCount(context) == 4);
    check(managedRegionGroupCount(context) == 3);
    check(managedLivePayloadBytes(context) == 32);
    check(managedRequestedObjectBytes(context) == 128);
    check(managedRegionRequestedBytes(context) == 12288);
    check(managedRegionUsedBytes(context) == 408);
    check(__reyRawEqual(aliasLeft, left) && __reyRawEqual(aliasMiddle, middle) && __reyRawEqual(aliasRight, right));
    check(__reyRawEqual(__reyRawLoadAddress(__reyRawOffset(root, 16)), left));
    check(__reyRawEqual(__reyRawLoadAddress(__reyRawOffset(left, 16)), middle));
    check(__reyRawEqual(__reyRawLoadAddress(__reyRawOffset(middle, 16)), right));
    check(__reyRawEqual(__reyRawLoadAddress(__reyRawOffset(right, 16)), left));
    check(__reyRawLoadI64(__reyRawOffset(program, 56)) == 4);
    check(__reyRawLoadI64(__reyRawOffset(program, 64)) == 12288);
    managedDestroy(context);
    layoutRegistryRelease(registry);
}
