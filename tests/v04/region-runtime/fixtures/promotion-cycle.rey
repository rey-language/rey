import layout::{layoutRegisterFixed, layoutRegistryCreate, layoutRegistryRelease};
import managed::{managedCreate, managedDependencyCount, managedDestroy, managedLiveObjects, managedProgramRegion, managedPromoteReference, managedPromotionCount, managedRegionAllocate, managedRegionCreate, managedRegionEnd, managedRegionObjectCount, managedRegionRequestedBytes, managedRegionUsedBytes, managedStoreReference};

func check(ok: bool): void {
    if !ok { __reyRawFail(2299); }
}

func main(): void {
    var registry = layoutRegistryCreate(1);
    var offsets = __reyRawMap(8);
    __reyRawStoreI64(offsets, 0);
    var node = layoutRegisterFixed(registry, 8, offsets, 1);
    __reyRawUnmap(offsets, 8);
    var context = managedCreate(registry);
    var program = managedProgramRegion(context);
    var regionA = managedRegionCreate(context);
    var regionB = managedRegionCreate(context);
    var objectA = managedRegionAllocate(context, regionA, node, 1);
    var objectB = managedRegionAllocate(context, regionB, node, 1);
    managedStoreReference(context, objectA, 0, objectB);
    check(managedPromotionCount(context) == 1);
    check(managedDependencyCount(context) == 1);
    check(__reyRawEqual(__reyRawLoadAddress(__reyRawOffset(objectA, 16)), objectB));
    check(__reyRawLoadI64(__reyRawOffset(regionA, 56)) == 2);
    check(__reyRawLoadI64(__reyRawOffset(regionB, 56)) == 0);
    var objectB2 = managedRegionAllocate(context, regionB, node, 1);
    managedStoreReference(context, objectB2, 0, objectA);
    check(managedPromotionCount(context) == 1);
    check(managedDependencyCount(context) == 2);
    check(__reyRawEqual(__reyRawLoadAddress(__reyRawOffset(objectB2, 16)), objectA));
    var aliasA = objectA;
    var aliasB = objectB;
    var aliasB2 = objectB2;
    var promoted = managedPromoteReference(context, objectA, __reyRawNull());
    check(__reyRawEqual(promoted, objectA));
    check(__reyRawEqual(aliasA, objectA) && __reyRawEqual(aliasB, objectB) && __reyRawEqual(aliasB2, objectB2));
    check(managedPromotionCount(context) == 4);
    check(managedDependencyCount(context) == 4);
    check(__reyRawLoadI64(__reyRawOffset(program, 56)) == 3);
    check(__reyRawLoadI64(__reyRawOffset(program, 48)) == 3);
    check(__reyRawLoadI64(__reyRawOffset(regionA, 56)) == 0);
    check(__reyRawLoadI64(__reyRawOffset(regionB, 56)) == 0);
    check(managedRegionObjectCount(context) == 3);
    check(managedRegionRequestedBytes(context) == 12288);
    var again = managedPromoteReference(context, objectA, program);
    check(__reyRawEqual(again, objectA));
    check(managedPromotionCount(context) == 4);
    check(managedDependencyCount(context) == 4);
    managedRegionEnd(context, regionB);
    check(managedDependencyCount(context) == 1);
    check(managedLiveObjects(context) == 3);
    check(managedRegionRequestedBytes(context) == 12288);
    managedRegionEnd(context, regionA);
    check(managedDependencyCount(context) == 0);
    check(managedPromotionCount(context) == 4);
    check(managedLiveObjects(context) == 3);
    check(managedRegionObjectCount(context) == 3);
    check(managedRegionRequestedBytes(context) == 12288);
    check(managedRegionUsedBytes(context) == 312);
    check(__reyRawEqual(__reyRawLoadAddress(__reyRawOffset(objectA, 16)), objectB));
    check(__reyRawEqual(__reyRawLoadAddress(__reyRawOffset(objectB2, 16)), objectA));
    check(__reyRawLoadI64(objectA) == 8589934592 + node);
    managedDestroy(context);
    layoutRegistryRelease(registry);
}
