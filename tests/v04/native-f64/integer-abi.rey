func weighted(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int): int {
    return a + b + c + d + e + f + g + h;
}

func expect(condition: bool): void {
    if !condition {
        var one = 1;
        var zero = 0;
        var trap = one / zero;
    }
}

func main(): void {
    expect(weighted(1, 2, 3, 4, 5, 6, 7, 8) == 36);
}
