func mixed(f0: float, i0: int, f1: float, i1: int, f2: float, i2: int, f3: float, i3: int, f4: float, i4: int, f5: float, i5: int, f6: float, i6: int, f7: float, f8: float): float {
    return f0 + i0 + f1 + i1 + f2 + i2 + f3 + i3 + f4 + i4 + f5 + i5 + f6 + i6 + f7 + f8;
}

func floatRoundTrip(value: float, bias: int): float {
    return value + bias;
}

func expect(condition: bool): void {
    if !condition {
        var one = 1;
        var zero = 0;
        var trap = one / zero;
    }
}

func main(): void {
    var tie: float = 1.00000000000000011102230246251565404236316680908203125;
    expect(tie == 1.0);
    var aboveTie: float = 1.00000000000000011102230246251565404236316680908203126;
    expect(aboveTie == 1.0000000000000002);

    var tiny: float = 1.0;
    var step = 0;
    while step < 1074 {
        tiny = tiny / 2.0;
        step = step + 1;
    }
    expect(tiny != 0.0);
    tiny = tiny / 2.0;
    expect(tiny == 0.0);

    var infinity: float = 1.0;
    step = 0;
    while step < 1024 {
        infinity = infinity * 2.0;
        step = step + 1;
    }
    var nan: float = infinity - infinity;
    expect(nan != nan);
    expect(!(nan < 0.0) && !(nan <= 0.0) && !(nan > 0.0) && !(nan >= 0.0));

    var positiveZero: float = 0.0;
    var negativeZero: float = -0.0;
    expect(positiveZero == negativeZero);

    var a: float = 1.0000000000000002;
    var roundedProduct: float = a * a;
    var separatelyRounded: float = roundedProduct - 1.0000000000000004;
    expect(separatelyRounded == 0.0);

    var remPositive: float = 5.5 % 2.0;
    var remNegative: float = -5.5 % 2.0;
    expect(remPositive == 1.5 && remNegative == -1.5);

    var integer = 42;
    var widened: float = integer.toFloat();
    var explicitWidened: float = float(integer);
    var decimal: float = 123.875;
    var truncated: int = decimal.toInt();
    expect(widened == 42.0 && explicitWidened == 42.0 && truncated == 123);
    expect(floatRoundTrip(3.5, 2) == 5.5);

    var mixedResult = mixed(0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5, 6, 6.5, 7, 7.5, 8.5);
    expect(mixedResult == 68.5);
}
