import frontend::graph::{checkSourceFileGraphWithRuntime};
import ir::managed::link::{linkManagedRuntime};
import ir::managed::placement::{ManagedAllocationPlacement, ManagedPlacement, ManagedStorage};
import ir::managed::roots::{lowerManagedRoots};
import ir::{IRProgram};
import ir::lower::{lowerManagedProgram, lowerProgram, setLowerTargetOS};
import ir::verify::{verifyProgram};
import ir::analysis::{inferEffects};
import native::x64::{emitProgram};
import native::image::x64::{buildElfX64};
import native::bytes::{byteString};
import typecheck::{CheckedProgram};

func require(ok: bool, message: string): void {
    if !ok { eprintln("FAIL checked-allocator driver: " + message); exit(1); }
}

func writeImage(path: string, bytes: Vec<int>): void {
    var encoded = byteString(bytes);
    require(encoded.isOk(), "byte conversion failed");
    writeFile(path, encoded.unwrap());
    require(fileExists(path), "image write failed");
}

func lowerStaticManagedFixture(checked: CheckedProgram, runtimeRoot: string,
                               compilerSourceDirectory: string): Result<IRProgram, string> {
    var input = lowerManagedProgram(checked);
    if input.isErr() { return Result.Err(input.unwrapErr()); }
    var runtimeEntry = runtimeRoot + "/main.rey";
    var runtimeUnits: Vec<string> = [
        runtimeRoot + "/layout/main.rey",
        runtimeRoot + "/heap/main.rey",
        runtimeRoot + "/gc/main.rey",
        runtimeRoot + "/regions/main.rey",
        runtimeRoot + "/managed/main.rey",
        runtimeRoot + "/containers/main.rey",
        runtimeRoot + "/task/main.rey",
        runtimeRoot + "/host/main.rey",
        runtimeEntry,
    ];
    var runtimeChecked = checkSourceFileGraphWithRuntime(runtimeEntry, compilerSourceDirectory, runtimeUnits);
    if runtimeChecked.isErr() { return Result.Err(runtimeChecked.unwrapErr()); }
    var runtimeProgram = lowerProgram(runtimeChecked.unwrap());
    if runtimeProgram.isErr() { return Result.Err(runtimeProgram.unwrapErr()); }
    var linked = linkManagedRuntime(input.unwrap(), runtimeProgram.unwrap(), runtimeRoot);
    if linked.isErr() { return Result.Err(linked.unwrapErr()); }
    var module = linked.unwrap().module;
    var allocations: Vec<ManagedAllocationPlacement> = [];
    var allocationIndex = 0;
    while allocationIndex < module.allocations.len() {
        var item = module.allocations[allocationIndex];
        allocations.push(ManagedAllocationPlacement {
            functionId: item.functionId,
            resultId: item.resultId,
            storage: ManagedStorage::Heap,
        });
        allocationIndex += 1;
    }
    var placements = ManagedPlacement { allocations: allocations, calls: [], regionFunctions: [] };
    return lowerManagedRoots(module, linked.unwrap().bindings, placements, false);
}

func main(): void {
    var argv = args();
    require(argv.len() == 4 || argv.len() == 5,
            "usage: checked-allocator-driver fixture.rey runtimeDir outputBinary [compilerSourceDir]");
    var fixture = argv[1];
    var sourceDirectory = argv[2];
    var outputBinary = argv[3];
    setLowerTargetOS("linux-x64");
    var compilerSourceDirectory = "";
    if argv.len() == 5 { compilerSourceDirectory = argv[4]; }
    var entryPath = sourceDirectory + "/main.rey";
    if argv.len() == 5 {
        entryPath = fixture;
    } else {
        writeFile(entryPath, readFile(fixture));
    }
    var units: Vec<string> = [
        sourceDirectory + "/layout/main.rey",
        sourceDirectory + "/regions/main.rey",
        sourceDirectory + "/managed/main.rey",
        sourceDirectory + "/containers/main.rey",
        sourceDirectory + "/host/main.rey",
        entryPath,
    ];
    var checked = checkSourceFileGraphWithRuntime(entryPath, compilerSourceDirectory, units);
    if checked.isErr() { eprintln(checked.unwrapErr()); exit(1); }
    var lowered: Result<IRProgram, string> = Result.Err("lowering path was not selected");
    if argv.len() == 5 {
        lowered = lowerStaticManagedFixture(checked.unwrap(), sourceDirectory, compilerSourceDirectory);
    } else {
        lowered = lowerProgram(checked.unwrap());
    }
    if lowered.isErr() { eprintln(lowered.unwrapErr()); exit(1); }
    var program = lowered.unwrap();
    var verified = verifyProgram(program);
    if !verified.ok { eprintln(verified.errors.join("\n")); exit(1); }
    program = inferEffects(program);
    var x64 = emitProgram(program, "linux-x64");
    if x64.isErr() { eprintln(x64.unwrapErr()); exit(1); }
    var elf = buildElfX64(x64.unwrap());
    if elf.isErr() { eprintln(elf.unwrapErr()); exit(1); }
    writeImage(outputBinary, elf.unwrap());
    println("checked-allocator-driver-emitted " + outputBinary);
}
