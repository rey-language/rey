func main(): void {
    var text = "\x00\x01\x7f\x80\xff\x22\x5c\x80\xff\xfe\xfd\xfc\xfb\xfa\xf9\xff\x80\x00";
    var expected: Vec<int> = [0, 1, 127, 128, 255, 34, 92, 128, 255, 254, 253, 252, 251, 250, 249, 255, 128, 0];
    if text.len() != expected.len() { exit(1); }
    var i = 0;
    while i < expected.len() {
        if int(text[i]) != expected[i] { exit(1); }
        i = i + 1;
    }
}
