import frontend::graph::{checkSourceFileGraph, checkSourceFileGraphWithRuntime};
import ir::{IRProgram, printIR};
import ir::lower::{lowerProgram};
import ir::verify::{verifyProgram};
import ir::analysis::{inferEffects};
import ir::eval::{evaluateProgram};
import native::x64::{X64Code, emitProgram};
import native::image::x64::{buildElfX64};
import native::bytes::{byteString};

func require(ok: bool, message: string): void {
    if !ok { eprintln("FAIL " + message); exit(1); }
}

func expectedCode(name: string): int {
    if name == "region-basic" || name == "program-region" || name == "group-separation" || name == "promotion-address-identity" || name == "promotion-older-source" || name == "promotion-null" || name == "promotion-dependency-chain" || name == "promotion-cycle" || name == "store-promotes-younger" || name == "store-records-older" || name == "destination-construction" || name == "container-current-region" || name == "repeated-request-plateau" || name == "long-lived-graph-retention" || name == "task-lifecycle" || name == "host-write" { return 0; }
    if name == "region-end-lifo" || name == "region-end-program" { return 2203; }
    if name == "double-end" || name == "context-handle-aba" || name == "program-handle-aba" { return 2204; }
    return -1;
}

func expectedReclamation(name: string): bool {
    return name == "reclaim-three-slabs" || name == "direct-mapping-metrics" || name == "opaque-handle-reuse" || name == "active-context-destroy" || name == "teardown-many-direct-chunks";
}

func writeImage(path: string, bytes: Vec<int>, label: string): void {
    var encoded = byteString(bytes);
    require(encoded.isOk(), label + ": byte conversion failed");
    writeFile(path, encoded.unwrap());
    require(fileExists(path) && readFile(path) == encoded.unwrap(), label + ": exact image write failed");
}

func emitImage(program: IRProgram, path: string, label: string): void {
    var x64: Result<X64Code, string> = emitProgram(program, "linux-x64");
    if x64.isErr() { eprintln(label + ": Linux x64 emission failed: " + x64.unwrapErr()); exit(1); }
    var elf = buildElfX64(x64.unwrap());
    if elf.isErr() { eprintln(label + ": Linux x64 ELF build failed: " + elf.unwrapErr()); exit(1); }
    writeImage(path, elf.unwrap(), label);
}

func compileRuntimeProgram(entryPath: string, sourceDirectory: string, task: bool): IRProgram {
    var units: Vec<string> = [sourceDirectory + "/layout/main.rey", sourceDirectory + "/regions/main.rey", sourceDirectory + "/managed/main.rey", sourceDirectory + "/containers/main.rey", sourceDirectory + "/host/main.rey", entryPath];
    if task { units.push(sourceDirectory + "/task/main.rey"); }
    var checked = checkSourceFileGraphWithRuntime(entryPath, "", units);
    if checked.isErr() { eprintln(entryPath + ": " + checked.unwrapErr()); exit(1); }
    var lowered = lowerProgram(checked.unwrap());
    if lowered.isErr() { eprintln(entryPath + ": " + lowered.unwrapErr()); exit(1); }
    var program = lowered.unwrap();
    var verified = verifyProgram(program);
    if !verified.ok { eprintln(entryPath + ": " + verified.errors.join("\n")); exit(1); }
    return inferEffects(program);
}

func evaluateRuntimeProgram(program: IRProgram, name: string, expected: int, outputDirectory: string): void {
    if name == "host-write" || name == "context-handle-aba" || name == "program-handle-aba" {
        writeFile(outputDirectory + "/" + name + ".steps", "native-only");
        return;
    }
    var evaluated = evaluateProgram(program, 12000000, 128);
    writeFile(outputDirectory + "/" + name + ".evaluator.stderr", evaluated.error);
    writeFile(outputDirectory + "/" + name + ".steps", evaluated.steps.toString());
    if expected == 0 {
        require(evaluated.ok && evaluated.isVoid, name + ": evaluator failed: " + evaluated.error);
    } else {
        require(!evaluated.ok, name + ": fixture should fail through RawFail");
        require(evaluated.error.contains("trusted runtime failure code " + expected.toString()), name + ": expected RawFail " + expected.toString() + ", got " + evaluated.error);
    }
}

func runtimeFixture(originalDirectory: string, stagedDirectory: string, sourceDirectory: string, outputDirectory: string, name: string): void {
    var expected = expectedCode(name);
    require(expected >= 0, "unknown region fixture name: " + name);
    var entryPath = sourceDirectory + "/main.rey";
    var originalPath = originalDirectory + "/" + name + ".rey";
    var stagedPath = stagedDirectory + "/" + name + ".rey";
    require(fileExists(originalPath) && fileExists(stagedPath), "missing source or instrumented fixture: " + name);

    writeFile(entryPath, readFile(originalPath));
    var ordinary = checkSourceFileGraph(entryPath, "");
    require(ordinary.isErr(), name + ": ordinary source checking must reject raw runtime intrinsics");
    writeFile(outputDirectory + "/" + name + ".ordinary-source.stderr", ordinary.unwrapErr());

    var program = compileRuntimeProgram(entryPath, sourceDirectory, name == "task-lifecycle");
    evaluateRuntimeProgram(program, name, expected, outputDirectory);
    writeFile(outputDirectory + "/" + name + ".evaluator.ir", printIR(program));

    var stagedSource = readFile(stagedPath);
    if stagedSource != readFile(originalPath) {
        writeFile(entryPath, stagedSource);
        program = compileRuntimeProgram(entryPath, sourceDirectory, name == "task-lifecycle");
    }
    writeFile(outputDirectory + "/" + name + ".native.ir", printIR(program));
    emitImage(program, outputDirectory + "/linux-x64-" + name, name);
    println("region-runtime-case " + name + " " + expected.toString());
}

func reclamationFixture(fixtureDirectory: string, sourceDirectory: string, outputDirectory: string, name: string): void {
    require(expectedReclamation(name), "unknown reclamation fixture name: " + name);
    var entryPath = sourceDirectory + "/main.rey";
    writeFile(entryPath, readFile(fixtureDirectory + "/" + name + ".rey"));
    var ordinary = checkSourceFileGraph(entryPath, "");
    require(ordinary.isErr(), name + ": ordinary source checking must reject raw runtime intrinsics");
    var program = compileRuntimeProgram(entryPath, sourceDirectory, false);
    var nativeOnly = name == "reclaim-three-slabs" || name == "active-context-destroy" || name == "teardown-many-direct-chunks";
    var steps = "native-only";
    if !nativeOnly {
        var evaluated = evaluateProgram(program, 12000000, 128);
        require(evaluated.ok && evaluated.isVoid, name + ": evaluator failed: " + evaluated.error);
        steps = evaluated.steps.toString();
        writeFile(outputDirectory + "/" + name + ".evaluator.stderr", evaluated.error);
        writeFile(outputDirectory + "/" + name + ".evaluator.ir", printIR(program));
    }
    writeFile(outputDirectory + "/" + name + ".ordinary-source.stderr", ordinary.unwrapErr());
    writeFile(outputDirectory + "/" + name + ".steps", steps);
    writeFile(outputDirectory + "/" + name + ".native.ir", printIR(program));
    emitImage(program, outputDirectory + "/linux-x64-" + name, name);
    println("region-runtime-reclamation-case " + name + " emitted steps=" + steps);
}

func main(): void {
    var argv = args();
    require(argv.len() == 7, "expected mode, original fixtures, staged fixtures, runtime sources, output directory, and case");
    var mode = argv[1];
    if mode == "region" { runtimeFixture(argv[2], argv[3], argv[4], argv[5], argv[6]); }
    else if mode == "reclamation" { reclamationFixture(argv[3], argv[4], argv[5], argv[6]); }
    else { eprintln("unknown driver mode: " + mode); exit(2); }
}
