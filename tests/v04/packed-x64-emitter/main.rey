import ir;
import ir::{BasicBlock, Escape, EffectSummary, IRFunction, IRProgram, IRType, IRValue, Instruction, SourceRef};
import ir::storage::registers::{RegisterLocationKind, planRegisters};
import native::image::x64::{buildElfX64HeaderForLength};
import native::packed::{packedBufferLength, packedBufferReadBytes};
import native::x64::{PackedX64Code, X64Code, X64FunctionOffset, emitProgram, emitProgramPacked, emitProgramPackedWithReuse, emitProgramPackedVerified, emitProgramPackedVerifiedWithReuse, emitProgramVerified, emitProgramVerifiedWithReuse, emitProgramWithReuse};

func require(ok: bool, message: string): void {
    if !ok { eprintln("FAIL " + message); exit(1); }
}

func source(): SourceRef { return ir.sourceRef("packed-x64-emitter", 0, 1); }

func effects(parameterCount: int): EffectSummary {
    var escapes: Vec<Escape> = [];
    var index = 0;
    while index < parameterCount {
        escapes.push(ir.escapeUnknown());
        index = index + 1;
    }
    return ir.effectSummary(ir.factUnknown(), ir.factUnknown(), ir.factUnknown(), ir.factUnknown(), ir.factUnknown(), ir.factUnknown(), escapes, ir.escapeUnknown());
}

func function(id: int, name: string, parameters: Vec<IRValue>, parameterTypes: Vec<IRType>, returnType: IRType, blocks: Vec<BasicBlock>): IRFunction {
    return ir.irFunction(id, ir.functionKey("packed-x64-emitter", "", name), ir.functionSignature(parameterTypes, returnType), parameters, blocks, effects(parameters.len()));
}

func controlProgram(padding: int): IRProgram {
    var instructions: Vec<Instruction> = [ir.constI64(0, -9223372036854775807 - 1, source()), ir.constBool(1, true, source())];
    var index = 0;
    while index < padding {
        instructions.push(ir.constI64(10 + index, -1 - index, source()));
        index = index + 1;
    }
    instructions.push(ir.constI64(2, 7, source()));
    instructions.push(ir.call(3, ir.irI64(), 1, [2], source()));
    instructions.push(ir.addCheckedI64(4, 0, 3, source()));
    instructions.push(ir.subCheckedI64(5, 4, 3, source()));
    instructions.push(ir.mulCheckedI64(6, 5, 3, source()));
    instructions.push(ir.divCheckedI64(7, 6, 3, source()));
    instructions.push(ir.remCheckedI64(8, 7, 3, source()));

    var entry = function(0, "entry", [], [], ir.irI64(), [
        ir.basicBlock(0, [], instructions, ir.branch(1, 1, [], 3, [], source())),
        ir.basicBlock(1, [], [], ir.jump(2, [], source())),
        ir.basicBlock(2, [], [], ir.branch(1, 1, [], 3, [], source())),
        ir.basicBlock(3, [], [], ir.returnValue(8, source()))
    ]);
    var helperParameters: Vec<IRValue> = [ir.irValue(100, ir.irI64())];
    var helperTypes: Vec<IRType> = [ir.irI64()];
    var helper = function(1, "recursiveHelper", helperParameters, helperTypes, ir.irI64(), [
        ir.basicBlock(0, [], [ir.call(101, ir.irI64(), 1, [100], source())], ir.returnValue(101, source()))
    ]);
    return ir.irProgram(0, [entry, helper]);
}

func rawProgram(): IRProgram {
    var instructions: Vec<Instruction> = [
        ir.constI64(0, 8, source()),
        ir.rawMap(1, 0, source()),
        ir.constI64(2, 4, source()),
        ir.rawOffset(3, 1, 2, source()),
        ir.constI64(4, 255, source()),
        ir.rawStoreByte(3, 4, source()),
        ir.rawLoadByte(5, 3, source()),
        ir.rawArgCount(6, source()),
        ir.rawArg(7, 2, source()),
        ir.rawFail(4, source()),
        ir.rawUnmap(1, 0, source())
    ];
    var mainFunction = function(0, "rawFixups", [], [], ir.irVoid(), [ir.basicBlock(0, [], instructions, ir.returnVoid(source()))]);
    return ir.irProgram(0, [mainFunction]);
}

func sparseFunctionProgram(functionId: int): IRProgram {
    var entry = function(0, "entry", [], [], ir.irI64(), [
        ir.basicBlock(0, [], [ir.call(1, ir.irI64(), functionId, [], source())], ir.returnValue(1, source()))
    ]);
    var helper = function(functionId, "sparseHelper", [], [], ir.irI64(), [
        ir.basicBlock(0, [], [ir.constI64(100, 19, source())], ir.returnValue(100, source()))
    ]);
    return ir.irProgram(0, [entry, helper]);
}

func sparseValueBlockProgram(): IRProgram {
    var maximum = 9223372036854775807;
    var entry = function(0, "sparseValuesAndBlocks", [], [], ir.irI64(), [
        ir.basicBlock(maximum, [], [ir.constBool(maximum, true, source()), ir.constI64(maximum - 1, 19, source())], ir.branch(maximum, 10000000, [], 1, [], source())),
        ir.basicBlock(10000000, [], [], ir.jump(1, [], source())),
        ir.basicBlock(1, [], [], ir.returnValue(maximum - 1, source()))
    ]);
    return ir.irProgram(0, [entry]);
}

func sparseValueUsesRegister(program: IRProgram): bool {
    var planned = planRegisters(program, true);
    if planned.isErr() { return false; }
    var functions = planned.unwrap().functions;
    var functionIndex = 0;
    while functionIndex < functions.len() {
        if functions[functionIndex].functionId == 0 {
            var locations = functions[functionIndex].locations;
            var valueIndex = 0;
            while valueIndex < locations.len() {
                if locations[valueIndex].valueId == 9223372036854775806 && locations[valueIndex].location.kind == RegisterLocationKind::Register { return true; }
                valueIndex = valueIndex + 1;
            }
        }
        functionIndex = functionIndex + 1;
    }
    return false;
}

func compareCode(plain: X64Code, packed: PackedX64Code, label: string): void {
    require(plain.entryOffset == packed.entryOffset, label + ": entry offsets differ");
    require(plain.functions.len() == packed.functions.len(), label + ": function counts differ");
    var index = 0;
    while index < plain.functions.len() {
        require(plain.functions[index].functionId == packed.functions[index].functionId, label + ": function IDs differ");
        require(plain.functions[index].offset == packed.functions[index].offset, label + ": function offsets differ");
        index = index + 1;
    }
    var packedLength = packedBufferLength(packed.bytes);
    require(packedLength.isOk() && packedLength.unwrap() == plain.bytes.len(), label + ": packed code length differs");
    require(packedLength.unwrap() <= 65536, label + ": fixture exceeds bounded byte read");
    var packedText = packedBufferReadBytes(packed.bytes, 0, packedLength.unwrap());
    require(packedText.isOk() && packedText.unwrap().len() == plain.bytes.len(), label + ": packed byte read failed");
    var actual = packedText.unwrap();
    index = 0;
    while index < plain.bytes.len() {
        if int(actual[index]) != plain.bytes[index] {
            require(false, label + ": code byte differs at offset " + index.toString());
        }
        index = index + 1;
    }
}

func compareMode(program: IRProgram, mode: int, label: string): void {
    var plain: Result<X64Code, string> = Result.Err("not emitted");
    var packed: Result<PackedX64Code, string> = Result.Err("not emitted");
    if mode == 0 { plain = emitProgram(program, "linux-x64"); packed = emitProgramPacked(program, "linux-x64"); }
    else if mode == 1 { plain = emitProgramWithReuse(program, "linux-x64"); packed = emitProgramPackedWithReuse(program, "linux-x64"); }
    else if mode == 2 { plain = emitProgramVerified(program, "linux-x64"); packed = emitProgramPackedVerified(program, "linux-x64"); }
    else { plain = emitProgramVerifiedWithReuse(program, "linux-x64"); packed = emitProgramPackedVerifiedWithReuse(program, "linux-x64"); }
    if plain.isErr() { eprintln(label + ": Vec emission failed: " + plain.unwrapErr()); exit(1); }
    if packed.isErr() { eprintln(label + ": packed emission failed: " + packed.unwrapErr()); exit(1); }
    compareCode(plain.unwrap(), packed.unwrap(), label);
}

func main(): void {
    var padding = 0;
    while padding < 7 {
        var program = controlProgram(padding);
        compareMode(program, 0, "control padding=" + padding.toString());
        if padding == 0 || padding == 3 || padding == 6 {
            compareMode(program, 1, "control reuse padding=" + padding.toString());
            compareMode(program, 2, "control verified padding=" + padding.toString());
            compareMode(program, 3, "control verified reuse padding=" + padding.toString());
        }
        padding = padding + 1;
    }

    var raw = rawProgram();
    compareMode(raw, 0, "raw fixups");
    compareMode(raw, 1, "raw fixups reuse");
    compareMode(raw, 2, "raw fixups verified");
    compareMode(raw, 3, "raw fixups verified reuse");
    require(emitProgramPacked(controlProgram(0), "darwin-x64").isErr(), "packed emission rejects non-Linux targets");
    require(emitProgramPackedVerified(controlProgram(0), "windows-x64").isErr(), "verified packed emission rejects non-Linux targets");
    require(emitProgramPacked(ir.irProgram(99, []), "linux-x64").isErr(), "non-verified packed emission rejects malformed IR");
    compareMode(sparseFunctionProgram(10000000), 0, "sparse function ID");
    compareMode(sparseFunctionProgram(9223372036854775807), 0, "maximum function ID");
    var sparseValuesAndBlocks = sparseValueBlockProgram();
    require(sparseValueUsesRegister(sparseValuesAndBlocks), "maximum SSA value is assigned a register in reuse mode");
    compareMode(sparseValuesAndBlocks, 0, "maximum SSA and sparse block IDs");
    compareMode(sparseValuesAndBlocks, 1, "maximum SSA and sparse block IDs reuse");
    var duplicateIds: Vec<X64FunctionOffset> = [
        X64FunctionOffset { functionId: 9223372036854775807, offset: 0 },
        X64FunctionOffset { functionId: 9223372036854775807, offset: 1 }
    ];
    require(buildElfX64HeaderForLength(16, 0, duplicateIds).isErr(), "ELF header rejects duplicate sparse function IDs");
    println("packed x64 emitter differential fixtures passed");
}
