import ir;

func main(): void {
    var emptyProgram = ir.irProgram(1, []);
    assert(ir.nextFunctionId(emptyProgram) == 0, "first function ID must be zero");

    var helperBlock = ir.basicBlock(0, [], [], ir.returnValue(0, ir.sourceRef("math.rey", 1, 7)));
    var helper = ir.irFunction(
        0,
        ir.functionKey("lib", "math", "identity"),
        ir.functionSignature([ir.irI64()], ir.irI64()),
        [ir.irValue(0, ir.irI64())],
        [helperBlock],
        ir.effectSummary(ir.factNo(), ir.factNo(), ir.factNo(), ir.factNo(), ir.factNo(), ir.factNo(), [ir.escapeNoEscape()], ir.escapeNoEscape())
    );
    var program = ir.withFunction(emptyProgram, helper);
    assert(ir.nextFunctionId(program) == 1, "function IDs must be program-wide and insertion ordered");

    var entryInstructions = [
        ir.constI64(2, 5, ir.sourceRef("main.rey", 1, 2)),
        ir.addCheckedI64(3, 1, 2, ir.sourceRef("main.rey", 2, 5)),
        ir.compareI64(4, ir.compareSlt(), 3, 2, ir.sourceRef("main.rey", 5, 8)),
        ir.call(5, ir.irI64(), 0, [3], ir.sourceRef("main.rey", 8, 12))
    ];
    var entry = ir.basicBlock(
        0,
        [],
        entryInstructions,
        ir.branch(4, 1, [3], 2, [5], ir.sourceRef("main.rey", 12, 20))
    );
    var trueBlock = ir.basicBlock(1, [ir.irValue(6, ir.irI64())], [], ir.returnValue(6, ir.sourceRef("main.rey", 20, 22)));
    var falseBlock = ir.basicBlock(2, [ir.irValue(7, ir.irI64())], [], ir.returnValue(7, ir.sourceRef("main.rey", 22, 24)));
    var blocks = [entry, trueBlock, falseBlock];
    var mainFunction = ir.irFunction(
        1,
        ir.functionKey("demo", "", "choose"),
        ir.functionSignature([ir.irBool(), ir.irI64()], ir.irI64()),
        [ir.irValue(0, ir.irBool()), ir.irValue(1, ir.irI64())],
        blocks,
        ir.effectSummary(ir.factNo(), ir.factNo(), ir.factNo(), ir.factNo(), ir.factNo(), ir.factNo(), [ir.escapeNoEscape(), ir.escapeNoEscape()], ir.escapeNoEscape())
    );
    assert(ir.nextBlockId(mainFunction) == 3, "block IDs must be function local");
    program = ir.withFunction(program, mainFunction);

    var expected = "program entry=%f1\n";
    expected = expected + "func %f0 lib::math::identity (%v0:i64) -> i64 effects(read=no, write=no, alloc=no, block=no, sync=no, unresolved=no, args=[noescape], result=noescape)\n";
    expected = expected + "  bb0():\n";
    expected = expected + "    return %v0 @math.rey:1..7\n";
    expected = expected + "func %f1 demo::choose (%v0:bool, %v1:i64) -> i64 effects(read=no, write=no, alloc=no, block=no, sync=no, unresolved=no, args=[noescape, noescape], result=noescape)\n";
    expected = expected + "  bb0():\n";
    expected = expected + "    %v2:i64 = const.i64 5 @main.rey:1..2\n";
    expected = expected + "    %v3:i64 = add.checked.i64 %v1, %v2 @main.rey:2..5\n";
    expected = expected + "    %v4:bool = compare.i64 slt %v3, %v2 @main.rey:5..8\n";
    expected = expected + "    %v5:i64 = call %f0(%v3) @main.rey:8..12\n";
    expected = expected + "    branch %v4, bb1(%v3), bb2(%v5) @main.rey:12..20\n";
    expected = expected + "  bb1(%v6:i64):\n";
    expected = expected + "    return %v6 @main.rey:20..22\n";
    expected = expected + "  bb2(%v7:i64):\n";
    expected = expected + "    return %v7 @main.rey:22..24\n";

    var printed = ir.printIR(program);
    assert(printed == expected, "IR printer output, function IDs, block parameters, or source spans changed");
    assert(ir.printIR(program) == printed, "IR printer must be deterministic");
    var sparse = ir.irFunction(9, ir.functionKey("sparse", "", "test"), ir.functionSignature([], ir.irVoid()), [], [ir.basicBlock(12, [], [], ir.returnVoid(ir.sourceRef("sparse.rey", 0, 0)))], ir.noEffects());
    assert(ir.nextFunctionId(ir.irProgram(9, [sparse])) == 10, "function ID allocation must handle sparse IDs");
    assert(ir.nextBlockId(sparse) == 13, "block ID allocation must handle sparse IDs");
    var exhausted = ir.irFunction(9223372036854775807, sparse.key, sparse.signature, [], [ir.basicBlock(9223372036854775807, [], [], ir.returnVoid(ir.sourceRef("sparse.rey", 0, 0)))], sparse.effects);
    assert(ir.nextFunctionId(ir.irProgram(exhausted.id, [exhausted])) == -1, "function ID exhaustion must not overflow");
    assert(ir.nextBlockId(exhausted) == -1, "block ID exhaustion must not overflow");
    print(printed);
}
