import layout;
import heap;

func expect(ok: bool, code: int): void {
    if !ok { __reyRawFail(code); }
}

func at(base: __rey_raw_address, offset: int): __rey_raw_address {
    return __reyRawOffset(base, offset);
}

func registryFor(payloadBytes: int, first: int, second: int, third: int, referenceCount: int): __rey_raw_address {
    var registry = layout.layoutRegistryCreate(1);
    var offsets = __reyRawNull();
    if referenceCount > 0 {
        offsets = __reyRawMap(referenceCount * 8);
        __reyRawStoreI64(offsets, first);
        if referenceCount > 1 { __reyRawStoreI64(at(offsets, 8), second); }
        if referenceCount > 2 { __reyRawStoreI64(at(offsets, 16), third); }
    }
    layout.layoutRegisterFixed(registry, payloadBytes, offsets, referenceCount);
    if referenceCount > 0 { __reyRawUnmap(offsets, referenceCount * 8); }
    return registry;
}

func main(): void {
var registry = layout.layoutRegistryCreate(2);
var lower = layout.layoutRegisterFixed(registry, 48, __reyRawNull(), 0);
var next = layout.layoutRegisterFixed(registry, 49, __reyRawNull(), 0);
var value = heap.heapCreate(registry);
var first = heap.heapAllocate(value, lower);
var second = heap.heapAllocate(value, next);
expect(__reyRawLoadI64(first) == lower && __reyRawLoadI64(second) == next, 401);
expect(heap.heapLiveObjects(value) == 2, 402);
expect(heap.heapLivePayloadBytes(value) == 97, 403);
expect(heap.heapRequestedObjectBytes(value) == 131072, 404);
expect(heap.heapSweep(value) == 2, 405);
expect(heap.heapRequestedObjectBytes(value) == 0 && heap.heapLiveObjects(value) == 0, 406);
heap.heapDestroy(value);
layout.layoutRegistryRelease(registry);
}
