import layout;
import heap;

func expect(ok: bool, code: int): void {
    if !ok { __reyRawFail(code); }
}

func at(base: __rey_raw_address, offset: int): __rey_raw_address {
    return __reyRawOffset(base, offset);
}

func registryFor(payloadBytes: int, first: int, second: int, third: int, referenceCount: int): __rey_raw_address {
    var registry = layout.layoutRegistryCreate(1);
    var offsets = __reyRawNull();
    if referenceCount > 0 {
        offsets = __reyRawMap(referenceCount * 8);
        __reyRawStoreI64(offsets, first);
        if referenceCount > 1 { __reyRawStoreI64(at(offsets, 8), second); }
        if referenceCount > 2 { __reyRawStoreI64(at(offsets, 16), third); }
    }
    layout.layoutRegisterFixed(registry, payloadBytes, offsets, referenceCount);
    if referenceCount > 0 { __reyRawUnmap(offsets, referenceCount * 8); }
    return registry;
}

func main(): void {
var registry = registryFor(8, 0, 0, 0, 0);
var value = heap.heapCreate(registry);
var first = heap.heapAllocate(value, 1);
var second = heap.heapAllocate(value, 1);
__reyRawStoreI64(at(first, 16), 77);
__reyRawStoreI64(at(second, 16), 88);
expect(!heap.heapMark(value, __reyRawNull()), 801);
expect(heap.heapMark(value, first), 802);
expect(!heap.heapMark(value, first), 803);
expect(heap.heapSweep(value) == 1, 804);
expect(heap.heapLiveObjects(value) == 1 && heap.heapLivePayloadBytes(value) == 8, 805);
expect(heap.heapRequestedObjectBytes(value) == 65536, 806);
expect(heap.heapCollectionCount(value) == 1 && heap.heapLastReclaimedObjects(value) == 1, 807);
expect(__reyRawLoadI64(first) == 1 && __reyRawLoadI64(at(first, 16)) == 77, 808);
expect(heap.heapSweep(value) == 1, 809);
expect(heap.heapLiveObjects(value) == 0 && heap.heapLivePayloadBytes(value) == 0, 810);
expect(heap.heapRequestedObjectBytes(value) == 0 && heap.heapCollectionCount(value) == 2, 811);
expect(heap.heapLastReclaimedObjects(value) == 1, 812);
heap.heapDestroy(value);
layout.layoutRegistryRelease(registry);
}
