func sum(limit: int): int {
    var total = 0;
    var i = 0;
    while i < limit {
        if i < 5 { total = total + i; }
        else { total = total + i + 1; }
        i = i + 1;
    }
    return total;
}
func increment(value: int): int { return value + 1; }
func main(): void {
    if sum(10) != 50 { var failure = increment(9223372036854775807); }
    if sum(0) != 0 { var failure = increment(9223372036854775807); }
}
