import frontend::graph::{checkSourceFileGraph, checkSourceFileGraphWithRuntime};
import ir::{IRProgram, printIR};
import ir::lower::{lowerProgram};
import ir::verify::{verifyProgram};
import ir::analysis::{inferEffects};
import ir::eval::{evaluateProgram};
import native::arm64::{Arm64Code, emitArm64, emitArm64WithReuse};
import native::image::{buildMachOArm64, buildElfArm64};
import native::bytes::{byteString};

func require(ok: bool, message: string): void {
    if !ok { eprintln("FAIL " + message); exit(1); }
}

func expectedCode(name: string): int {
    if name == "core-strings" || name == "refvec-gc" || name == "refvec-gc-small" || name == "map-cycles" || name == "map-cycles-small" { return 0; }
    if name == "reject-region-value" { return 2203; }
    if name == "missing-map-key" || name == "malformed-string-to-int" || name == "out-of-range-string-to-int" || name == "intmax-string-to-int" { return 2205; }
    return -1;
}

func writeImage(path: string, bytes: Vec<int>, label: string): void {
    var encoded = byteString(bytes);
    require(encoded.isOk(), label + ": byte conversion failed");
    writeFile(path, encoded.unwrap());
    require(fileExists(path) && readFile(path) == encoded.unwrap(), label + ": exact image write failed");
}

func emitImages(program: IRProgram, name: string, outputDirectory: string, reuseSlots: bool): void {
    var darwin: Result<Arm64Code, string> = emitArm64(program, "darwin");
    if reuseSlots { darwin = emitArm64WithReuse(program, "darwin"); }
    if darwin.isErr() { eprintln(name + ": Darwin ARM64 emission failed: " + darwin.unwrapErr()); exit(1); }
    var macho = buildMachOArm64(darwin.unwrap());
    if macho.isErr() { eprintln(name + ": Mach-O build failed: " + macho.unwrapErr()); exit(1); }
    writeImage(outputDirectory + "/darwin-" + name, macho.unwrap(), name + " Darwin");
    var linux: Result<Arm64Code, string> = emitArm64(program, "linux");
    if reuseSlots { linux = emitArm64WithReuse(program, "linux"); }
    if linux.isErr() { eprintln(name + ": Linux ARM64 emission failed: " + linux.unwrapErr()); exit(1); }
    var elf = buildElfArm64(linux.unwrap());
    if elf.isErr() { eprintln(name + ": ELF build failed: " + elf.unwrapErr()); exit(1); }
    writeImage(outputDirectory + "/linux-" + name, elf.unwrap(), name + " Linux");
}

func exercise(fixtures: string, sourceDirectory: string, outputDirectory: string, name: string, reuseSlots: bool): void {
    var expected = expectedCode(name);
    require(expected >= 0, "unknown fixture name: " + name);
    var entryPath = sourceDirectory + "/main.rey";
    var layoutPath = sourceDirectory + "/layout/main.rey";
    var heapPath = sourceDirectory + "/heap/main.rey";
    var gcPath = sourceDirectory + "/gc/main.rey";
    var managedPath = sourceDirectory + "/managed/main.rey";
    var containersPath = sourceDirectory + "/containers/main.rey";
    writeFile(entryPath, readFile(fixtures + "/" + name + ".rey"));
    require(checkSourceFileGraph(entryPath, "").isErr(), name + ": ordinary source checking must not authorize raw runtime units");
    var checked = checkSourceFileGraphWithRuntime(entryPath, "", [layoutPath, heapPath, gcPath, managedPath, containersPath, entryPath]);
    if checked.isErr() { eprintln(name + ": " + checked.unwrapErr()); exit(1); }
    var lowered = lowerProgram(checked.unwrap());
    if lowered.isErr() { eprintln(name + ": " + lowered.unwrapErr()); exit(1); }
    var program = lowered.unwrap();
    var verified = verifyProgram(program);
    if !verified.ok { eprintln(name + ": " + verified.errors.join("\n")); exit(1); }
    program = inferEffects(program);
    var nativeOnly = name == "refvec-gc" || name == "map-cycles";
    if nativeOnly {
        writeFile(outputDirectory + "/" + name + ".evaluation", "native-only\n");
        writeFile(outputDirectory + "/" + name + ".steps", "0\n");
    } else {
        var evaluated = evaluateProgram(program, 4000000, 64);
        writeFile(outputDirectory + "/" + name + ".steps", evaluated.steps.toString());
        if expected == 0 {
            require(evaluated.ok && evaluated.isVoid, name + ": evaluator failed: " + evaluated.error);
        } else {
            require(!evaluated.ok, name + ": fixture should fail through RawFail");
            require(evaluated.error.contains("trusted runtime failure code " + expected.toString()), name + ": expected RawFail " + expected.toString() + ", got " + evaluated.error);
        }
    }
    writeFile(outputDirectory + "/" + name + ".ir", printIR(program));
    emitImages(program, name, outputDirectory, reuseSlots);
    println("managed-containers-case " + name + " " + expected.toString());
}

func main(): void {
    var argv = args();
    require(argv.len() == 5 || argv.len() == 6, "expected fixture directory, staged source directory, output directory, case, and optional --reuse-slots");
    if argv.len() == 6 { require(argv[5] == "--reuse-slots", "optional final argument must be --reuse-slots"); }
    var fixtures = argv[1];
    var sourceDirectory = argv[2];
    var outputDirectory = argv[3];
    var caseName = argv[4];
    require(expectedCode(caseName) >= 0, "unknown fixture name: " + caseName);
    exercise(fixtures, sourceDirectory, outputDirectory, caseName, argv.len() == 6);
}
