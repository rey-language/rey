struct Temp {
    pub value: int,
}

func trap(): void {
    var zero: int = 0;
    var crash: int = 1 / zero;
    return;
}

func iterationRegion(limit: int): int {
    var index: int = 0;
    var total: int = 0;
    while index < limit {
        var temp: Temp = Temp { value: index };
        total = total + temp.value;
        index = index + 1;
    }
    return total;
}

func main(): void {
    var limit: int = 2000;
    var total: int = iterationRegion(limit);
    if total < 0 { trap(); }
    return;
}
