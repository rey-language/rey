func trap(): void {
    var zero: int = 0;
    var crash: int = 1 / zero;
    return;
}

func makeValues(seed: int): Vec<int> {
    var values: Vec<int> = [seed, seed + 1];
    values.push(seed + 2);
    return values;
}

func main(): void {
    var limit: int = 2000;
    var index: int = 0;
    var total: int = 0;
    while index < limit {
        var values: Vec<int> = makeValues(index);
        total = total + values[2];
        index = index + 1;
    }
    if total < 0 { trap(); }
    return;
}
