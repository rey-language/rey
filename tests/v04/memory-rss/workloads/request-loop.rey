func trap(): void {
    var zero: int = 0;
    var crash: int = 1 / zero;
    return;
}

func handleRequest(seed: int): int {
    var values: Vec<int> = [seed, seed + 1, seed + 2];
    var counts: HashMap<string, int> = {"seed": seed};
    counts.set("len", values.len());
    return values[2] + counts["seed"];
}

func main(): void {
    var limit: int = 2000;
    var index: int = 0;
    var total: int = 0;
    while index < limit {
        total = total + handleRequest(index);
        index = index + 1;
    }
    if total < 0 { trap(); }
    return;
}
