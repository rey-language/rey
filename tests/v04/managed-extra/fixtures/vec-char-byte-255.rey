func sourcecheck(ok: bool): void {
    if !ok {
        var zero: int = 0;
        var fail: int = 1 / zero;
    }
    return;
}

func main(): void {
    var values: Vec<char> = Vec.new();
    values.push('A');
    values.push(char(255));
    var last: char = values.pop();
    var first: char = values.get(0);
    sourcecheck(int(last) == 255 && int(first) == 65 && values.len() == 1);
    sourcecheck(values.pop() == 'A' && values.len() == 0);
    return;
}
