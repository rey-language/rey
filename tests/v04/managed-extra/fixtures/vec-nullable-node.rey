struct Node {
    pub value: int,
}

func sourcecheck(ok: bool): void {
    if !ok {
        var zero: int = 0;
        var fail: int = 1 / zero;
    }
    return;
}

func main(): void {
    var values: Vec<Node?> = Vec.new();
    values.push(null);
    var node: Node = Node { value: 55 };
    values.push(node);
    var first: Node? = values.get(0);
    var second: Node? = values.get(1);
    sourcecheck(first == null && second == node);
    sourcecheck(values.pop() == node && values.pop() == null && values.len() == 0);
    return;
}
