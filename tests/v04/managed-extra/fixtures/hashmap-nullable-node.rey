struct Node {
    pub value: int,
}

func sourcecheck(ok: bool): void {
    if !ok {
        var zero: int = 0;
        var fail: int = 1 / zero;
    }
    return;
}

func main(): void {
    var values: HashMap<string, Node?> = HashMap.new();
    values.set("empty", null);
    var later: Node = Node { value: 7 };
    var loaded: Node? = values.get("empty");
    sourcecheck(values.has("empty"));
    sourcecheck(loaded == null && later.value == 7);
    return;
}
