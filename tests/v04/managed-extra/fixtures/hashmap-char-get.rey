func sourcecheck(ok: bool): void {
    if !ok {
        var zero: int = 0;
        var fail: int = 1 / zero;
    }
    return;
}

func main(): void {
    var values: HashMap<string, char> = HashMap.new();
    values.set("byte", char(255));
    var loaded: char = values.get("byte");
    sourcecheck(values.has("byte"));
    sourcecheck(int(loaded) == 255);
    return;
}
